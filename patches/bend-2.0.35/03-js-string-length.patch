+// String
+// ======
+
+function string_length(s) {
+  let n = 0;
+  for (let i = 0; i < s.length; n++) {
+    const hi = s.charCodeAt(i++);
+    if (hi >= 0xD800 && hi <= 0xDBFF && i < s.length) {
+      const lo = s.charCodeAt(i);
+      if (lo >= 0xDC00 && lo <= 0xDFFF) i++;
+    }
+  }
+  return n;
+}
