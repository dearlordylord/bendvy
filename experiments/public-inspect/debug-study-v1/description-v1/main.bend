def case7() -> String:
  R.output("initialNameDedupAndUnknownAppend",evaluate([M.System{"All",[],[M.Query{"q",["Unknown"],[],[],[],[],[],[],[]}],M.Access{[],[]},M.Access{[],[]},M.MachineAccess{[],[],[],[]},[],False{},[],[],[]}],["A", "A"],[],[],[M.ResolvedSchedule{"main",[M.ResolvedSystem{M.System{"All",[],[M.Query{"q",["Unknown"],[],[],[],[],[],[],[]}],M.Access{[],[]},M.Access{[],[]},M.MachineAccess{[],[],[],[]},[],False{},[],[],[]}}]}]))
def case8() -> String:
  R.output("duplicateNextSlotRetained",evaluate([M.System{"Writer",["main#0"],[],M.Access{[],[]},M.Access{[],[]},M.MachineAccess{[],["Play","Play"],[],[]},[],False{},[],[],[]}],[],[],[],[M.ResolvedSchedule{"main",[M.ResolvedSystem{M.System{"Writer",["main#0"],[],M.Access{[],[]},M.Access{[],[]},M.MachineAccess{[],["Play","Play"],[],[]},[],False{},[],[],[]}}]}]))
def main() -> IO(Unit):
  IO.print(String.join([case0(),case1(),case2(),case3(),case4(),case5(),case6(),case7(),case8()],"\n"))
