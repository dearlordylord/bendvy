import Base
import metadata.bend as M
import index.bend as I
import lints.bend as L
import render-fixture.bend as R
def observed(+indexes:M.Indexes,systems:List<&2,M.System>,schedules:List<&2,M.ResolvedSchedule>) -> M.Indexes & List<&2,M.Lint>:
  (indexes,L.assemble(schedules,systems,indexes))
def evaluate(+systems:List<&2,M.System>,cs:List<&2,String>,rs:List<&2,String>,es:List<&2,String>,schedules:List<&2,M.ResolvedSchedule>) -> M.Indexes & List<&2,M.Lint>:
  observed(I.build(systems,M.Indexes{I.blank(cs),I.blank(rs),I.blank(es)}),systems,schedules)
def case0() -> String:
  R.output("emptySchedules",evaluate([],["A"],["R"],["E"],[]))
def case1() -> String:
  R.output("indexCategories",evaluate([M.System{"All",["main#0"],[M.Query{"q",["read"],["write"],["optional"],["with"],["without"],["added"],["changed"],[]}],M.Access{["RR"],["RW"]},M.Access{["ER"],["EW"]},M.MachineAccess{[],[],[],[]},["removed"],False{},[],[],[]}],["read", "write", "optional", "with", "without", "added", "changed", "removed", "unused"],["RR", "RW"],["ER", "EW"],[M.ResolvedSchedule{"main",[M.ResolvedSystem{M.System{"All",["main#0"],[M.Query{"q",["read"],["write"],["optional"],["with"],["without"],["added"],["changed"],[]}],M.Access{["RR"],["RW"]},M.Access{["ER"],["EW"]},M.MachineAccess{[],[],[],[]},["removed"],False{},[],[],[]}}]}]))
def case2() -> String:
  R.output("allFiveLintFamilies",evaluate([M.System{"Reader",["main#0"],[M.Query{"q",["A"],[],[],[],[],[],[],[]}],M.Access{["R"],[]},M.Access{["Read", "Flow"],[]},M.MachineAccess{[],[],[],[]},[],False{},[],[],[]},M.System{"Writer",["main#2"],[M.Query{"q",[],["A", "B"],[],[],[],[],[],[]}],M.Access{[],["R"]},M.Access{[],["Emit", "Flow"]},M.MachineAccess{[],["Play"],[],[]},[],False{},[],[],[]}],["A", "B", "Unused"],["R"],["Emit", "Read", "Flow"],[M.ResolvedSchedule{"main",[M.ResolvedSystem{M.System{"Reader",["main#0"],[M.Query{"q",["A"],[],[],[],[],[],[],[]}],M.Access{["R"],[]},M.Access{["Read", "Flow"],[]},M.MachineAccess{[],[],[],[]},[],False{},[],[],[]}},M.ResolvedDeferred{},M.ResolvedSystem{M.System{"Writer",["main#2"],[M.Query{"q",[],["A", "B"],[],[],[],[],[],[]}],M.Access{[],["R"]},M.Access{[],["Emit", "Flow"]},M.MachineAccess{[],["Play"],[],[]},[],False{},[],[],[]}}]}]))
def case3() -> String:
  R.output("markerAnywhere",evaluate([M.System{"Reader",["main#0"],[M.Query{"q",["A"],[],[],[],[],[],[],[]}],M.Access{["R"],[]},M.Access{["Read", "Flow"],[]},M.MachineAccess{[],[],[],[]},[],False{},[],[],[]},M.System{"Writer",["main#2"],[M.Query{"q",[],["A", "B"],[],[],[],[],[],[]}],M.Access{[],["R"]},M.Access{[],["Emit", "Flow"]},M.MachineAccess{[],["Play"],[],[]},[],False{},[],[],[]}],["A", "B", "Unused"],["R"],["Emit", "Read", "Flow"],[M.ResolvedSchedule{"main",[M.ResolvedSystem{M.System{"Reader",["main#0"],[M.Query{"q",["A"],[],[],[],[],[],[],[]}],M.Access{["R"],[]},M.Access{["Read", "Flow"],[]},M.MachineAccess{[],[],[],[]},[],False{},[],[],[]}},M.ResolvedDeferred{},M.ResolvedSystem{M.System{"Writer",["main#2"],[M.Query{"q",[],["A", "B"],[],[],[],[],[],[]}],M.Access{[],["R"]},M.Access{[],["Emit", "Flow"]},M.MachineAccess{[],["Play"],[],[]},[],False{},[],[],[]}}]},M.ResolvedSchedule{"other",[M.ResolvedTransitions{[]}]}]))
def case4() -> String:
  R.output("presenceIsIndexedNotReadBeforeWrite",evaluate([M.System{"Reader",[],[M.Query{"q",[],[],[],["A"],["Absent"],[],[],[]}],M.Access{[],[]},M.Access{[],[]},M.MachineAccess{[],[],[],[]},[],False{},[],[],[]},M.System{"Writer",[],[M.Query{"q",[],["A"],[],[],[],[],[],[]}],M.Access{[],[]},M.Access{[],[]},M.MachineAccess{[],[],[],[]},[],False{},[],[],[]}],["A", "Absent"],[],[],[M.ResolvedSchedule{"main",[M.ResolvedSystem{M.System{"Reader",[],[M.Query{"q",[],[],[],["A"],["Absent"],[],[],[]}],M.Access{[],[]},M.Access{[],[]},M.MachineAccess{[],[],[],[]},[],False{},[],[],[]}},M.ResolvedSystem{M.System{"Writer",[],[M.Query{"q",[],["A"],[],[],[],[],[],[]}],M.Access{[],[]},M.Access{[],[]},M.MachineAccess{[],[],[],[]},[],False{},[],[],[]}}]}]))
