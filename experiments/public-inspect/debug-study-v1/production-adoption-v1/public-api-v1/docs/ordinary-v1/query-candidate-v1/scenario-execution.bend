def outcome_then(~C:Type,~Ops:Type -> Type,~slot:Query.Declaration<S.Schema,Q.Frame<S.Schema,C,Unit,Unit>,Ops(Q.Frame<S.Schema,C,Unit,Unit>)>,~body:@-H:Type -> @-caps:Ops(H) -> Bool -> H -> H & (T.Outcome<Unit> & DTO.RowValues),~Out:Type,next:W.World<S.Schema,C,Unit,Unit> -> System.Owner<S.Schema,Systems.registry(~C,~Ops,~slot,~body)> -> DTO.Operation -> Out,owner:System.Owner<S.Schema,Systems.registry(~C,~Ops,~slot,~body)>,outcome:Sys.Outcome<W.World<S.Schema,C,Unit,Unit>,Q.Error<Unit>,List<&2,DTO.RowValues>>) -> Out:
  match outcome:
    case Sys.Succeeded{world,output}:next(world,owner,DTO.Run{Done{output}})
    case Sys.Failed{world,error}:next(world,owner,DTO.Run{Fail{error}})
def refused_world(~C:Type,~Ops:Type -> Type,~slot:Query.Declaration<S.Schema,Q.Frame<S.Schema,C,Unit,Unit>,Ops(Q.Frame<S.Schema,C,Unit,Unit>)>,~body:@-H:Type -> @-caps:Ops(H) -> Bool -> H -> H & (T.Outcome<Unit> & DTO.RowValues),~Out:Type,next:W.World<S.Schema,C,Unit,Unit> -> System.Owner<S.Schema,Systems.registry(~C,~Ops,~slot,~body)> -> DTO.Operation -> Out,owner:System.Owner<S.Schema,Systems.registry(~C,~Ops,~slot,~body)>,registry:DTO.RegistrySnapshot,args:DTO.RejectedArgs,observed:W.World<S.Schema,C,Unit,Unit> & DTO.WorldSnapshot) -> Out:
  match observed:
    case (world,snapshot):next(world,owner,DTO.RefusedRegistration{args,snapshot,registry})
def refused_owner(~C:Type,~Ops:Type -> Type,~slot:Query.Declaration<S.Schema,Q.Frame<S.Schema,C,Unit,Unit>,Ops(Q.Frame<S.Schema,C,Unit,Unit>)>,~body:@-H:Type -> @-caps:Ops(H) -> Bool -> H -> H & (T.Outcome<Unit> & DTO.RowValues),~observeWorld:W.World<S.Schema,C,Unit,Unit> -> W.World<S.Schema,C,Unit,Unit> & DTO.WorldSnapshot,~Out:Type,next:W.World<S.Schema,C,Unit,Unit> -> System.Owner<S.Schema,Systems.registry(~C,~Ops,~slot,~body)> -> DTO.Operation -> Out,world:W.World<S.Schema,C,Unit,Unit>,args:Bool & U32,observed:System.Owner<S.Schema,Systems.registry(~C,~Ops,~slot,~body)> & DTO.RegistrySnapshot) -> Out:
  (fail,cursor) = args
  match observed:
    case (owner,snapshot):refused_world(~C,~Ops,~slot,~body,~Out,next,owner,snapshot,DTO.RejectedArgs{fail,cursor},observeWorld(world))
def run_then(~C:Type,~Ops:Type -> Type,~slot:Query.Declaration<S.Schema,Q.Frame<S.Schema,C,Unit,Unit>,Ops(Q.Frame<S.Schema,C,Unit,Unit>)>,~body:@-H:Type -> @-caps:Ops(H) -> Bool -> H -> H & (T.Outcome<Unit> & DTO.RowValues),~observeWorld:W.World<S.Schema,C,Unit,Unit> -> W.World<S.Schema,C,Unit,Unit> & DTO.WorldSnapshot,~Out:Type,next:W.World<S.Schema,C,Unit,Unit> -> System.Owner<S.Schema,Systems.registry(~C,~Ops,~slot,~body)> -> DTO.Operation -> Out,observed:Sys.RunResult<S.Schema,C,Unit,Unit,Bool & U32,Q.Error<Unit>,List<&2,DTO.RowValues>,System.runner(~S.Schema,~C,~Unit,~Unit,~Ops,~Bool,~Unit,~DTO.RowValues,~slot,~body)> & (String & List<&2,Query.Clause<S.Schema>>)) -> Out:
  match observed:
    case (Sys.Completed{registry,outcome},(nameSlot,clauses)):outcome_then(~C,~Ops,~slot,~body,~Out,next,System.Owner{registry,nameSlot,clauses},outcome)
    case (Sys.RegistrationRejected{registry,world,args},(nameSlot,clauses)):refused_owner(~C,~Ops,~slot,~body,~observeWorld,~Out,next,world,args,Systems.observe(~C,~Ops,~slot,~body,System.Owner{registry,nameSlot,clauses}))

def plain_world(world:W.World<S.Schema,S.plain_store(),Unit,Unit>) -> W.World<S.Schema,S.plain_store(),Unit,Unit> & DTO.WorldSnapshot:
  Observation.world(~S.plain_position(),~Recipe.Plain<S.Schema,Array<U32>,S.identity("Position")>,~(owner => S.plain_take(~"Position",owner)),~(recipe => column => S.plain_put(~"Position",recipe,column)),~(recipe => Observation.plain(~"Position",recipe)),~S.plain_velocity(),~Recipe.Plain<S.Schema,Array<U32>,S.identity("Velocity")>,~(owner => S.plain_take(~"Velocity",owner)),~(recipe => column => S.plain_put(~"Velocity",recipe,column)),~(recipe => Observation.plain(~"Velocity",recipe)),~S.plain_health(),~Recipe.Plain<S.Schema,Array<U32>,S.identity("Health")>,~(owner => S.plain_take(~"Health",owner)),~(recipe => column => S.plain_put(~"Health",recipe,column)),~(recipe => Observation.plain(~"Health",recipe)),world)
def plain_main_run_then(~Out:Type,next:W.World<S.Schema,S.plain_store(),Unit,Unit> -> Systems.plain_main_owner() -> DTO.Operation -> Out,owner:Systems.plain_main_owner(),world:W.World<S.Schema,S.plain_store(),Unit,Unit>,fail:Bool) -> Out:
  run_then(~S.plain_store(),~Body.Ops,~Queries.plain_base(),~(H => caps => fail => owner => Body.body(~H,~caps,fail,owner)),~plain_world,~Out,next,Systems.run(~S.plain_store(),~Body.Ops,~Queries.plain_base(),~(H => caps => fail => owner => Body.body(~H,~caps,fail,owner)),owner,world,fail))
