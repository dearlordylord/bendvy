  "controlSource": "const setup=\"  const BVY_PD_SEEN = new Set(roots);\\n  const queue = [...BVY_PD_SEEN];\\n  const BVY_PD_ENQUEUE = (xs) => {\\n    for (const x of xs) {\\n      if (!BVY_PD_SEEN.has(x)) {\\n        BVY_PD_SEEN.add(x);\\n        queue.push(x);\\n      }\\n    }\\n  };\";\nconst cases=[\n {name:\"duplicate-roots-self-and-cycle-all-three-appends\",roots:[\"a\",\"a\",\"b\"],edges:{a:[[\"a\",\"c\",\"c\"],[\"b\",\"a\"],[\"d\",\"b\"]],b:[[\"a\"],[\"d\",\"d\"],[\"b\"]],c:[[\"a\"],[\"c\"],[\"d\"]],d:[[\"b\"],[],[\"a\"]]},expected:[\"a\",\"b\",\"c\",\"d\"]},\n {name:\"first-root-order-and-later-discovery\",roots:[\"b\",\"a\",\"b\"],edges:{b:[[\"d\",\"d\"],[\"b\"],[\"c\",\"a\"]],a:[[\"c\"],[\"a\",\"d\"],[\"b\"]],d:[[\"a\"],[],[\"c\"]],c:[[],[\"d\"],[\"b\"]]},expected:[\"b\",\"a\",\"d\",\"c\"]},\n {name:\"empty-roots\",roots:[],edges:{},expected:[]},\n {name:\"inactive-type-only-and-cycle\",roots:[\"a\",\"a\"],inactive:[\"a\"],edges:{a:[[\"b\",\"b\"],[\"never\"],[\"never\"]],b:[[\"a\"],[\"b\"],[\"c\",\"c\"]],c:[[],[],[\"a\"]]},expected:[\"a\",\"b\",\"c\"]}\n];\nfunction run(c,dedupe){let queue,enqueue;if(dedupe){({queue,enqueue}=Function(\"roots\",setup+\"\\nreturn {queue,enqueue:BVY_PD_ENQUEUE};\")(c.roots));}else{queue=c.roots.slice();enqueue=xs=>queue.push(...xs);}const visited=new Set,trace=[];for(const d of queue){if(visited.has(d))continue;visited.add(d);trace.push([d,\"memo_gc\",\"lookup\",\"set\"]);const groups=c.edges[d]||[[],[],[]];trace.push([d,\"type_adts\",groups[0]]);enqueue(groups[0]);if(c.inactive?.includes(d))continue;trace.push([d,\"fun_of\",\"term_any\",groups[1],groups[2]]);enqueue(groups[1]);enqueue(new Set(groups[2]));}return {firstVisits:[...visited],trace,queueLength:queue.length,uniqueQueue:new Set(queue).size};}\nconst rows=cases.map(c=>{const baseline=run(c,false),candidate=run(c,true);if(JSON.stringify(baseline.trace)!==JSON.stringify(candidate.trace)||JSON.stringify(candidate.firstVisits)!==JSON.stringify(c.expected)||candidate.queueLength!==candidate.uniqueQueue||candidate.queueLength!==candidate.firstVisits.length)throw Error(c.name);return {name:c.name,input:c,baseline,candidate,status:\"PASS\"};});console.log(JSON.stringify({scope:\"Finite first-visit structural controls; no universal compiler proof\",literalSetup:setup,cases:rows,status:\"PASS\"}));",
