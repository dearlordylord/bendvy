"""Complete composed public consumer model derived from source, no stdout inputs."""
from pathlib import Path
import os,json
TOP=Path('/workspace/formal-proofs/bendvy-worktrees/ordinary-custom-store-v1/experiments/public-inspect/ordinary-declaration-v1/ordinary-composed-debug-v1/mixed-notice-v1/public-v1')
CORE=Path('/workspace/formal-proofs/bendvy/src/ecs')
class Term:
    def __init__(self,name,*fields):self.name=name;self.fields=fields

def ctor(module,name,*fields):
    path=(CORE/module) if module.endswith('.bend') else TOP/(module+'.bend')
    ns=os.path.relpath(path,TOP).removesuffix('.bend')
    return Term(ns+'.'+name,*fields)
def base(name,*fields):return Term(name,*fields)
def show(x):
    if isinstance(x,Term):return x.name+'{'+', '.join(show(y) for y in x.fields)+'}'
    if isinstance(x,str):return json.dumps(x,ensure_ascii=False)
    if isinstance(x,list):return '['+', '.join(show(y) for y in x)+']'
    if isinstance(x,bool):return 'True{}' if x else 'False{}'
    return str(x)
def some(x):return base('Some',x)
def product(a,b):return ctor('ordinary-app-observation-data.bend','Product',a,b)
def arr(a,b):return f'node(leaf:{a},leaf:{b})'

class Nat:
    def __init__(self,value):self.value=value
    def __str__(self):return str(self.value)+'n'
def nat(x):return Nat(x)
def descriptor():return ctor('relation-types.bend','Descriptor',2,'Parent','Children',ctor('relation-types.bend','Hierarchy'))
def key():return ctor('internal/relation-failures/domains.bend','DeclaredKey',2)
def failure_notice():
    failure=ctor('relation-types.bend','Failure',descriptor(),ctor('relation-types.bend','Relate'),1,1,ctor('relation-types.bend','SelfRelationNotAllowed',1,'Parent'))
    return ctor('relation-commands.bend','RelationFailed',failure)
def publication(first=None,second=None):
    pair=ctor('event-publication.bend','Publication',[ctor('state','FirstEvent',first)] if first is not None else [],[ctor('state','SecondEvent',second)] if second is not None else [])
    return ctor('event-publication.bend','Publication',[pair],[])
def original(p):return ctor('relation-commands.bend','Original',p)
def passthrough(id):return [ctor('relation-commands.bend','ComponentRemoved',id),ctor('relation-commands.bend','CleanupPaused',[])]
def mixed_records(id,first,second):
    removed,paused=passthrough(id)
    return [original(publication(first=first)),removed,original(publication(second=second)),paused]
def batch(tick,values):return ctor('event-runtime.bend','Batch',nat(tick),values)
def description():
    handle=ctor('world.bend','Handle',1,1)
    cells=[ctor('relation-query.bend','Cell','Parent',ctor('relation-query.bend','Outgoing'),ctor('relation-query.bend','Missing')),ctor('relation-query.bend','Cell','Children',ctor('relation-query.bend','Incoming'),ctor('relation-query.bend','Missing'))]
    row=ctor('inspector-query.bend','ProjectedRow',handle,ctor('inspector-query-projection.bend','Product',base_unit(),cells))
    view=ctor('ordinary-app-relation.bend','View',descriptor(),[row])
    observed=ctor('ordinary-app-observation-data.bend','Observation',product(base_unit(),view),['Relation{key=2|name=Parent|inverse=Children|kind=Hierarchy}','1:1:[Parent:Outgoing:Missing, Children:Incoming:Missing]'])
    return ctor('ordinary-app-schema.bend','Description',[],product([],observed))
def base_unit():return base('Unit')
def reader(cursor):return ctor('consumer','ReaderView',1,1,'ParentFailures',['Parent:read'],cursor,[key()])
def stream(kind,batches,frameStart,boundary,dropped):
    return ctor('event-stream.bend','Stream',ctor('ordinary-event-declaration.bend','Domain','Source.UnusedEvent' if kind=='Unused' else 'Signal'),batches,[],1,nat(frameStart),nat(boundary),nat(2),nat(dropped))
def failure_domain(phase):
    if phase<2:return []
    retained=phase<10
    values=[failure_notice()]
    qb=ctor('internal/relation-failures/queue.bend','Batch',nat(1),nat(1),values)
    # Publication puts new batches on back; first descriptor frame normalizes to front.
    front=[qb] if phase==9 else []
    back=[qb] if phase<9 else []
    queue=ctor('internal/relation-failures/queue.bend','Queue',front,back,nat(1 if retained else 0),nat(0 if retained else 1))
    return [ctor('internal/relation-failures/domains.bend','Domain',key(),queue,[1] if phase>=3 else [])]
def physical(phase):
    before=phase==0;published=phase>=1;afterpub=phase>=4;typedFrame=phase>=7;typedDropped=phase>=8
    clock=0 if phase<2 else (1 if phase==2 else 2)
    typedTick=0 if before else (1 if phase<4 else 2)
    events=[] if before else mixed_records(1,7,True)
    if afterpub:events+=mixed_records(2,8,False)
    if typedDropped:events=passthrough(1)+passthrough(2)
    pending=1 if phase==1 or phase>=4 else 0
    world=ctor('physical','WorldView',1,2,1,'node(leaf:False,leaf:True)',2,nat(1),'node(leaf:11,leaf:12)',ctor('relation-types.bend','Graph',[],[]),'node(leaf:81,leaf:82)',events,nat(pending),[ctor('world.bend','RegistrationMeta',1,'ParentFailures',['Parent:read'])],2,clock)
    first=[];second=[];journal=[]
    if published and not typedDropped:
        first=[batch(1,[ctor('state','FirstEvent',7)])];second=[batch(1,[ctor('state','SecondEvent',True)])]
        journal=[batch(1,[publication(first=7),publication(second=True)])]
        if afterpub:
            first+=[batch(2,[ctor('state','FirstEvent',8)])];second+=[batch(2,[ctor('state','SecondEvent',False)])]
            journal+=[batch(2,[publication(first=8),publication(second=False)])]
    fs=2 if typedFrame else 0;bound=2 if typedDropped else 0;drop=2 if typedDropped else 0
    failures=ctor('event-notice-runtime.bend','Failures',failure_domain(phase),[ctor('event-runtime.bend','Position',1,nat(2),nat(1))] if phase>=3 else [],nat(clock),nat(2 if phase>=9 else 0),nat(2 if phase>=10 else 0),nat(65536))
    return ctor('physical','View',world,stream('First',first,fs,bound,drop),stream('Second',second,fs,bound,drop),stream('Unused',[],fs,bound,0),'node(leaf:31,leaf:32)',journal,nat(fs),failures,nat(typedTick))
def full_output():
    checkpoints=[]
    for phase in range(11):
        enabled=phase!=6
        checkpoints.append(ctor('consumer','Checkpoint',some(description()) if enabled else base('None'),some(['Signal','Signal','Source.UnusedEvent']) if enabled else base('None'),physical(phase),reader(2 if phase>=3 else 0),'node(leaf:101,leaf:102)'))
    delivery=ctor('internal/relation-failures/readings.bend','KeyReading',key(),[failure_notice()],False)
    return (show(some(ctor('consumer','Report',2,ctor('world.bend','Handle',1,1),ctor('world.bend','Accepted'),ctor('relation-commands.bend','Queued'),checkpoints,[[delivery]])))+'\n').encode()
if __name__=='__main__':
    import sys
    sys.stdout.buffer.write(full_output())
