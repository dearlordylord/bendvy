from pathlib import Path
import runpy,gzip,hashlib,json
HERE=Path(__file__).resolve().parent
D=runpy.run_path(str(HERE.parent/'model.py.source'))
def derive():
 scenes=[D['scenario'](i) for i in (1,2,3)]
 return ('consumer-public-pruned.Report{'+', '.join(D['quote'](x[0]) for x in scenes)+'}\n').encode()
if __name__=='__main__':
 raw=derive();(HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0));print(len(raw),hashlib.sha256(raw).hexdigest())
