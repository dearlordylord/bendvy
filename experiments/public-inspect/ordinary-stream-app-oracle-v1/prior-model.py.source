"""Independent source-derived wire model; no runtime-output inputs."""
from pathlib import Path
import os,json
ROOT=Path('/workspace/formal-proofs/bendvy-worktrees/graph-stream-public-bridge-v1/experiments/public-inspect/graph-stream-public-bridge-v1')
CORE=Path('/workspace/formal-proofs/bendvy/src/ecs')
def named(module,constructor):
    return os.path.relpath(CORE/(module+'.bend'),ROOT)[:-5]+'.'+constructor
def ctr(name,*fields):return name+'{'+', '.join(fields)+'}'
def ls(items):return '['+', '.join(items)+']'
def text(value):return json.dumps(value,ensure_ascii=False)
def world(ns,base):
    link='1:Link:LinkedBy:ordinary';parent='2:Parent:Children:hierarchy'
    graph=ls([link+':1>2',link+':3>2',parent+':1>2',parent+':3>2'])+';'+ls([link+':2:[3, 1]',parent+':2:[1, 3]'])
    notices=['user:17','relationFailed:'+parent+':relate:2:3:hierarchyCycle:2:3:Parent','componentRemoved:23','cleanupPaused:'+ls(['enter:3','descriptors:3:'+ls([link,parent]),'children:3:'+parent+':'+ls([link])+':[1, 3]','finish:3'])]
    resources=f'N(L({base}),L({base+1}));slot(7,next(9,False),4,True);slot(11,next(12,True),10,False);ran=0;stream([2:[4>7], 3:[7>8, 8>7]],[5:1:1],0,2);stream([],[],0,0)'
    return f'world({ns},4,3,N(N(L(False),L(True)),N(L(True),L(True))),4,2,N(L({base}),L({base+2}));graph={graph},{resources},events={ls(notices)},pending=1,regs=[1:Existing:[Flow, Link]],nextSystem=2,clock=13)'
def handle(ns,i):return ctr(named('world','Handle'),str(ns),str(i))
def observation(ns):
    rows=[]
    for i in [1,2,3]:
        cells=[]
        for key,end,incoming,children in [('link','Outgoing',False,False),('linkedBy','Incoming',True,False),('parent','Outgoing',False,True),('children','Incoming',True,True)]:
            if not incoming and i in [1,3]:value=ctr(named('relation-query','Target'),handle(ns,2))
            elif incoming and i==2:value=ctr(named('relation-query','Sources'),ls([handle(ns,j) for j in ([1,3] if children else [3,1])]))
            else:value=ctr(named('relation-query','Missing'))
            cells.append(ctr(named('relation-query','Cell'),text(key),ctr(named('relation-query',end)),value))
        rows.append(ctr(named('inspector-query','ProjectedRow'),handle(ns,i),ctr(named('inspector-query-projection','Product'),ctr('Unit'),ls(cells))))
    return ctr('consumer.Observation','19',ctr(named('machine','Current'),'7'),ctr(named('machine','Current'),'11'),ls(rows))
def report(ns,base):
    w=text(world(ns,base));o=observation(ns)
    return ctr('consumer.Report',w,o,w,o,w,ctr('Done',ctr('True')),w)+'\n'
if __name__=='__main__':
    here=Path(__file__).resolve().parent
    for name,ns,base in [('workshop',31,100),('garden',47,200)]:
        (here/(name+'-normal.stdout')).write_text(report(ns,base))
