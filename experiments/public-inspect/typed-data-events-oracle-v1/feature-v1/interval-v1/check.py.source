from pathlib import Path
import json,runpy,hashlib,re,gzip
p=Path('/workspace/formal-proofs/bendvy-worktrees/native54-matching-tree-v1/experiments/public-inspect/typed-data-events-oracle-v1');old=p/'feature-v1';o=old/'interval-v1';o.mkdir(exist_ok=True)
r=Path('/workspace/formal-proofs/bendvy-worktrees/ordinary-schedule-debug-v1/experiments/public-inspect/ordinary-declaration-v1/compact-schedule-recipe-v1/ordinary-event-family-feasibility-v1/feature-trace-v1');a=r/'interval-v1';joins=json.loads((a/'SOURCE-JOINS.json').read_text());plan=json.loads((a/'PLAN.json').read_text())
sha=lambda f:hashlib.sha256(Path(f).read_bytes()).hexdigest()
assert sha(r/'trace.bend')==joins['traceSHA256'];assert sha(r/'reference.mjs')==joins['referenceSHA256']
# Exact removal of harness-only TS additions.
ts=(a/'reference.mjs').read_text();original=(r/'reference.mjs').read_text()
ts=ts.replace("import {reset,begin,end,capture,finish} from './ts-timing.mjs';\n",'',1).replace('begin(label);const result=','const result=',1).replace(')));end();if(!system)', ')));if(!system)',1).replace("reset();observe('initial',true);","observe('initial',true);",1).replace('capture(JSON.stringify({format:1,rows}));finish();','console.log(JSON.stringify({format:1,rows}));',1)
assert ts==original,'TS inverse differs'
bm=runpy.run_path(str(old/'bend-model.py.source'));records,states=bm['sequence']();assert len(records)==72
# Interpret the frozen finite renderer grammar independently of compiler QName.
render=(a/'render.bend').read_text()
reading_prefix=re.search(r'case Ev.Reading\{values,lagged\}:"([^"]+)"',render)[1]
q=lambda text:'"'+text+'"'
ls=lambda vals:'['+', '.join(vals)+']'
booltext=lambda v:'True{}' if v else 'False{}'
def complete(c):
 if c is None:return 'None{}'
 if c['kind'] in ('FirstRead','SecondRead'):
  first=c['kind']=='FirstRead';tag='First' if first else 'Second'
  vals=ls('types.'+tag+'{'+(str(v) if first else booltext(v))+'}' for v in c['values'])
  body=reading_prefix+vals+', '+booltext(c['lagged'])+'}'
  return 'Some{consumer.'+c['kind']+'{'+body+', '+booltext(c['failed'])+'}}'
 if c['kind']=='Published':return 'Some{consumer.Published{'+booltext(c['failed'])+'}}'
 return 'Some{consumer.'+c['kind']+'{}}'
for row in records:
 assert not any(c in row['physical'] for c in ['"','\\','\n','\r']), 'Finite quoted() grammar needs escaping'
 if row['inventory']:assert all(not any(c in s for c in ['"','\\','\n','\r']) for s in row['inventory'])
raw=(ls('trace.Row{'+booltext(row['enabled'])+', '+('None{}' if row['inventory'] is None else 'Some{'+ls(q(x) for x in row['inventory'])+'}')+', '+complete(row['completion'])+', '+q(row['physical'])+'}' for row in records)+'\n').encode()
cat=json.loads((old/'ORACLES.json').read_text());assert raw==gzip.decompress(Path(cat['bend']['gzip']).read_bytes())
tr,_=runpy.run_path(str(old/'ts-model.py.source'))['derive']();assert tr==gzip.decompress(Path(cat['ts']['gzip']).read_bytes())
# Exact source sequencing, not generated evaluation claim.
main=(a/'main.bend').read_text();assert 'sequence(T.actions(),0,fixture)' in main and 'T.ticked(action,fixture)' in main and 'T.observe(Some{completion},fixture)' in main
assert 'case (fixture,completion):IO.bind(Unit,C.Fixture & List<&2,T.Row>,Clock.end()' in main
pins={}
for f in [a/'main.bend',a/'render.bend',a/'reference.mjs',a/'SOURCE-JOINS.json',a/'PLAN.json',a/'evaluation-check.py.source',a/'timing.bend',a/'timing.js',a/'timing.c',a/'ts-timing.mjs',r/'trace.bend',r/'reference.mjs',r/'consumer.bend',r/'setup.bend',r/'observer.bend',r/'types.bend',old/'bend-model.py.source',old/'ts-model.py.source',old/'common.py.source',p/'tree-v1/model.py.source',p/'leaf-v1/model.py.source',Path(cat['bend']['gzip']),Path(cat['ts']['gzip'])]:pins[str(f)]=sha(f)
# Add exact admitted plan source bindings; do not execute any command.
changed=[]
for path,digest in plan['pins'].items():
 if sha(path)!=digest:changed.append(path)
assert not changed,changed
(o/'SOURCE-BASIS.json').write_text(json.dumps({'producerCommit':'d793ea5da','sourcePins':pins,'planSHA256':sha(a/'PLAN.json'),'planPinsCurrent':len(plan['pins']),'executionDependencies':[str(old/f) for f in ['bend-model.py.source','ts-model.py.source','common.py.source']]+[str(p/'tree-v1/model.py.source'),str(p/'leaf-v1/model.py.source')],'scope':'Conditional complete semantic stdout applicability, no current compiled/source-positive/actual runtime or timing qualification.'},indent=2)+'\n')
(o/'ORACLES.json').write_text(json.dumps(cat,indent=2)+'\n')
(o/'CHECKS.json').write_text(json.dumps({'TSExactInverse':True,'BendFiniteRendererBytesEqual':True,'finiteStringsNeedNoEscaping':True,'snapshots':72,'operationIntervals':17,'systemRuns':15,'frameOnlyOperations':2,'bendBytes':len(raw),'bendSHA256':hashlib.sha256(raw).hexdigest(),'TSBytes':len(tr),'TSSHA256':hashlib.sha256(tr).hexdigest(),'planPinsCurrent':len(plan['pins']),'generatedEvaluationCheckNotExecuted':True},indent=2)+'\n')
print({'bendBytes':len(raw),'TSBytes':len(tr),'planPins':len(plan['pins'])})
