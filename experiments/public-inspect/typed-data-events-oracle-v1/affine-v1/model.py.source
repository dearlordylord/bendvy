"""Complete source-only affine Args/Out callback witness, forty snapshots.

Application-owned Array identity transfers to Output on success or Resource on
raw Sys failure; extraction retries that same owner. No engine Args-recovery or
World rollback policy is assumed. Only detached observations are represented.
"""
from pathlib import Path
from dataclasses import replace,asdict
import runpy,json,os,gzip,hashlib
HERE=Path(__file__).resolve().parent
m=runpy.run_path(str(HERE.parent/'tree-v1/model.py.source'))
Tree,Record,Leaf=m['Tree'],m['Record'],m['Leaf']
A,B,U=(0,0),(0,1),(1,)
ls=lambda xs:'['+', '.join(xs)+']'
booltext=lambda b:'True' if b else 'False'

def event(record):
    a=ls('A:'+str(v) for v in record.selected(A))
    b=ls('B:'+booltext(v) for v in record.selected(B))
    u=ls('Unused:'+str(v) for v in record.selected(U))
    inner=ls(['pair('+a+','+b+')']) if record.selected(A) or record.selected(B) else '[]'
    return 'record('+inner+','+u+')'

def batches(bs,show):return ls(str(b.tick)+':'+ls(show(v) for v in b.values) for b in bs)
def stream(s,key,show):
    return ('domain='+key+'|batches='+batches(s.batches,show)
        +'|positions='+ls(f'{p.id}:{p.cursor}:{p.registered_at}' for p in s.positions)
        +f'|nextReader={s.next_reader}|frame={s.frame_start}|boundary={s.boundary}|capacity={s.capacity}|dropped={s.dropped_through}')
def physical(tree):
    regs='[4:second:[Signal:read], 3:slow:[Signal:read], 2:first:[Signal:read], 1:publisher:[Signal:write, Signal:write]]'
    world=('ns=1|next=1|high=0|live=leaf:False|capacity=1|depth=0|store=leaf:41|resource=leaf:51'
           +'|events='+ls(event(r) for r in tree.log)+'|pending=0|registrations='+regs+'|nextSystem=5|clock=0')
    state=('first{'+stream(tree.leaf(A),'Signal',lambda v:'A:'+str(v))+'}|second{'
        +stream(tree.leaf(B),'Signal',lambda v:'B:'+booltext(v))+'}|unused{'
        +stream(tree.leaf(U),'Unused',lambda v:'Unused:'+str(v))+'}|sibling=leaf:61|journal='
        +batches(tree.journal,event)+f'|frameStart={tree.frame_start}')
    owners='|publisher=1:1:publisher:[Signal:write, Signal:write]:0|firstReader=1:1:2:1:2:first:[Signal:read]:0|slowReader=1:2:3:1:3:slow:[Signal:read]:0|secondReader=1:1:4:1:4:second:[Signal:read]:0'
    return f'factory=2|tick={tree.tick}|'+world+'|'+state+owners


def physical_affine(tree,parked):
    # observer-affine resource_view; all other observer source fields retained.
    resource='base=leaf:51;retained='+ls('leaf:'+str(x) for x in parked)
    return physical(tree).replace('|resource=leaf:51|','|resource='+resource+'|')

def derive():
    tree=Tree(tuple((p,Leaf(1,2)) for p in (A,B,U)))
    tree,first=tree.register(A,2);tree,slow=tree.register(A,3);tree,second=tree.register(B,4)
    # Symbolic identity 71 denotes the single source-created affine Array owner.
    args=71;parked=();reading=None;status='Initial';rows=[];states=[]
    def capture():
        assert (args is not None)+len(parked)==1
        assert args in (None,71) and all(x==71 for x in parked)
        current={'tree':asdict(tree),'argumentOwner':args,'parkedOwners':parked,
                 'lastReading':None if reading is None else asdict(reading),'status':status,
                 'unchangedOwners':{'base':51,'store':41,'sibling':61,'factoryNext':2}}
        for flag in (False,True,True,False):
            inventory='Some([Signal, Signal, Unused])' if flag else 'None'
            arg='None' if args is None else 'Some(leaf:'+str(args)+')'
            last='None' if reading is None else ls('A:'+str(x) for x in reading.values)+':'+booltext(reading.lagged)
            rows.append('enabled='+booltext(flag)+'|inventory='+inventory+'|args='+arg+'|reading='+last+'|status='+status+'|'+physical_affine(tree,parked))
        states.append(current)
    capture()
    actions=[('publish',),('read',False),('publish',),('read',True),('retry',),('read',False),('frame',),('frame',),('read',False)]
    for action in actions:
        if action[0]=='publish':
            tree=replace(tree,tick=tree.tick+1)
            emitted=tuple(Record.emission(p,v) for p,v in ((A,7),(B,True),(A,8)))
            tree=tree.sync(tree.log+emitted);status='Published'
        elif action[0]=='frame':tree=tree.frame();status='Framed'
        else:
            fail=action[1] if action[0]=='read' else False
            if action[0]=='retry':
                assert args is None and parked==(71,)
                args,parked=parked[0],parked[1:]
            assert args==71
            reading=tree.reading(A,first.id)
            if fail:
                parked=(args,)+parked;args=None
                status='FailedParked'
            else:status='Succeeded'  # callback returns the same Array through Output
            tree=tree.complete(A,first,first.registry_id,'failed' if fail else 'succeeded')
        capture()
    assert len(rows)==40 and len(states)==10 and tree.tick==7
    assert states[4]['argumentOwner'] is None and states[4]['parkedOwners']==(71,)
    assert states[5]['argumentOwner']==71 and states[5]['parkedOwners']==()
    assert states[4]['tree']['leaves'][0][1]['positions'][0]['cursor']==2
    assert states[5]['tree']['leaves'][0][1]['positions'][0]['cursor']==5
    assert states[-1]['tree']['log']==()
    assert not tree.leaf(B).positions and not tree.leaf(U).positions
    return (ls(json.dumps(row) for row in rows)+'\n').encode(),states

if __name__=='__main__':
    raw,states=derive();print(len(raw),hashlib.sha256(raw).hexdigest())
