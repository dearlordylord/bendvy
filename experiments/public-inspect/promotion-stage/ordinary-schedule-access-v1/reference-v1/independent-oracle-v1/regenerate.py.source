from pathlib import Path
import gzip,hashlib,json
HERE=Path(__file__).resolve().parent
sha=lambda path:hashlib.sha256(Path(path).read_bytes()).hexdigest()
def main():
    basis=json.loads((HERE/'INDEPENDENT-SOURCE-BASIS.json').read_text())
    for path,digest in basis['sourcePins'].items():
        assert sha(path)==digest,path
    reference=Path(basis['reference']).read_text()
    assert 'const selected=G.Schedule(resource,G.Schedule.applyDeferred(),component)' in reference
    assert 'runtime.debug.nameSchedules({All:G.Schedule(unrelated,resource,component)})' in reference
    assert 'runtime.debug.nameSchedules({Selected:selected})' in reference
    assert 'const before=view(),repeat=view()' in reference
    model={'__name__':'source_model'}
    exec(compile((HERE/'model.py.source').read_text(),'model.py.source','exec'),model)
    model['selftest']()
    raw=model['expected']()
    (HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    (HERE/'ORACLES.json').write_text(json.dumps({'normal':{'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisSHA256':sha(HERE/'INDEPENDENT-SOURCE-BASIS.json')}},indent=2)+'\n')
    print(len(raw),hashlib.sha256(raw).hexdigest())
if __name__=='__main__':
    main()
