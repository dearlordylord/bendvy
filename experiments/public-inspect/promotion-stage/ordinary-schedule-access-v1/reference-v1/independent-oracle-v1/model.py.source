"""Finite source-derived public TS named-schedule access projection; no runtime input."""
import json

def entry(name, readers=(), writers=()):
    # internal/debug Index.list literal property order and Set iteration order.
    return {'name':name,'readers':list(readers),'writers':list(writers)}

def view(schema, selected=False, executed=False):
    names={name:schema+'/'+name for name in ('Unrelated','Resource','Component','First','Unused','Inventory','Hidden')}
    operative=['Resource','Component'] if selected else ['Unrelated','Resource','Component']
    indices=[0,2] if selected else [0,1,2]
    schedule='Selected' if selected else 'All'
    systems=[{'name':names[system],'placements':[schedule+'#'+str(index)]}
             for system,index in zip(operative,indices)]
    unrelated=() if selected else (names['Unrelated'],)
    access={'components':[entry(names['First'],(names['Component'],)),
                          entry(names['Unused'],unrelated,unrelated)],
            'resources':[entry(names['Inventory'],(names['Resource'],)),
                         entry(names['Hidden'],(),unrelated)],
            'events':[]}
    calls=['U'] + (['R:41,42','C'] if executed else [])
    return {'systems':systems,'access':access,'calls':calls}

def scenario(schema):
    return {'schema':schema,'all':view(schema),'before':view(schema,True),
            'repeat':view(schema,True),'after':view(schema,True,True)}

def expected():
    return (json.dumps([scenario('Alpha'),scenario('Beta')],separators=(',',':'))+'\n').encode()

def selftest():
    for schema in ('Alpha','Beta'):
        value=scenario(schema)
        assert value['before']==value['repeat']
        assert value['before']['systems']==value['after']['systems']
        assert value['before']['access']==value['after']['access']
        assert value['after']['calls']==['U','R:41,42','C']
        assert value['before']['systems'][1]['placements']==['Selected#2']
        assert value['before']['access']['components'][1]==entry(schema+'/Unused')
        assert value['before']['access']['resources'][1]==entry(schema+'/Hidden')
        assert value['all']['access']['components'][1]==entry(schema+'/Unused',(schema+'/Unrelated',),(schema+'/Unrelated',))
        assert value['all']['access']['resources'][1]==entry(schema+'/Hidden',(),(schema+'/Unrelated',))
        assert list(value['before'])==['systems','access','calls']
        assert list(value['before']['access'])==['components','resources','events']
