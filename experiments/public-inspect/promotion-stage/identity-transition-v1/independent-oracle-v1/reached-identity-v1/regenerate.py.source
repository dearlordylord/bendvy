from pathlib import Path
import gzip, hashlib, json
HERE = Path(__file__).resolve().parent
NORMAL = HERE.parent / "implicit-printer-v2"
sha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()
def load(path):
    result = {"__name__": "source_model"}
    exec(compile(path.read_text(), str(path), "exec"), result)
    result["selftest"]()
    return result

def main():
    basis = json.loads((HERE / "SOURCE-BASIS.json").read_text())
    assert basis["status"] == "PREPARED_NOT_APPLIED"
    for path, digest in basis["sourcePins"].items():
        assert sha(path) == digest, path
    context = json.loads(Path(basis["preparedContext"]).read_text())
    normal_target = Path(basis["normalTargetCopy"]).read_text()
    prepared = Path(context["preparedTarget"]).read_text()
    assert normal_target.count(context["replacement"]["old"]) == 1
    assert prepared == normal_target.replace(context["replacement"]["old"], context["replacement"]["new"])
    assert sha(Path(context["target"])) == context["beforeSHA256"]
    original = load(NORMAL / "model.py.source")
    changed = load(HERE / "model.py.source")
    differences = [i for i, (a, b) in enumerate(zip(original["rows"](), changed["rows"]())) if a != b]
    assert differences == [4,5,6,7,8,10,12,13,14,15,16,17,18]
    assert changed["rows"]()[17] == "operational:[]:lagged=False"
    assert all("stream([],[1:0:0]" in changed["rows"]()[i] for i in (5,7,13,15))
    normal_raw = original["expected"]()
    raw = changed["expected"]()
    (HERE / "normal-baseline.stdout.gz").write_bytes(gzip.compress(normal_raw, mtime=0))
    (HERE / "mutant.stdout.gz").write_bytes(gzip.compress(raw, mtime=0))
    record = {"stdout": str(HERE / "mutant.stdout.gz"), "bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest(), "normalBaseline": str(HERE / "normal-baseline.stdout.gz"), "normalBaselineBytes": len(normal_raw), "normalBaselineSHA256": hashlib.sha256(normal_raw).hexdigest(), "sourceBasisSHA256": sha(HERE / "SOURCE-BASIS.json")}
    assert normal_raw != raw and len(normal_raw) == 6473
    (HERE / "ORACLES.json").write_text(json.dumps({"mutant": record}, indent=2) + "\n")
    print(len(raw), record["sha256"])

if __name__ == "__main__":
    main()
