"""Independent finite public TS identity scene, no JavaScript evaluation."""
import copy
import json

class Scene:
    def __init__(self, name):
        self.name = name
        self.tick = 0
        self.frame = 0
        self.frame_start = 0
        self.boundary = 0
        self.reader_cursor = 0
        self.peek_cursor = 0
        self.next_id = 1
        self.entities = []
        self.commands = []
        self.transition_tick = None
        self.previous = False
        self.machine_pending = False
        self.reader_values = []
        self.points = []

    def advance(self):
        self.tick += 1
        return self.tick

    def start_frame(self):
        self.frame += 1
        if self.frame_start > 0:
            self.boundary = self.frame_start
        self.frame_start = self.tick
        # Held operational reader prevents aging out the one published batch.
        assert self.transition_tick is None or self.reader_cursor < self.transition_tick

    def spawn(self, values, system):
        identity = self.next_id
        self.next_id += 1
        self.commands.append((identity, values, system))
        return {"kind": "EntityId", "value": identity}

    def apply_deferred(self):
        self.advance()
        for identity, values, _ in self.commands:
            self.entities.append({"id": identity, "components": {self.name + "/Cells": values}, "relations": {}})
        self.commands = []

    def projection(self, cursor):
        values = [{"from": 7, "to": 7}] if self.transition_tick is not None and self.transition_tick > cursor else []
        return {"flow": 7, "level": 11, "flowTransitions": values, "levelTransitions": [], "flowLagged": False, "levelLagged": False}

    def reader(self):
        self.start_frame()
        this_run = self.advance()
        self.reader_values.append(self.projection(self.reader_cursor))
        self.reader_cursor = this_run

    def inspect(self):
        value = self.projection(self.peek_cursor)
        self.peek_cursor = self.advance()
        return value

    def queue(self):
        self.start_frame()
        self.advance()
        self.machine_pending = True
        return {"ok": True}

    def marker(self, skip):
        self.start_frame()
        self.apply_deferred()
        self.machine_pending = False
        if not skip:
            self.previous = True
            self.transition_tick = self.advance()
        return {"ok": True}

    def point(self, label):
        flow = {"current": 7}
        if self.machine_pending:
            flow["pending"] = 7
        if self.previous:
            flow["previous"] = 7
        world = {"version": 1, "frame": self.frame, "tick": self.tick, "entityCount": len(self.entities), "entities": self.entities, "resources": {self.name + "/Owned": [11, 12]}, "machines": {self.name + "/Flow": flow, self.name + "/Level": {"current": 11}}, "pendingCommands": [{"tag": "spawn", "system": system} for _, _, system in self.commands]}
        streams = []
        for family in ("Flow", "Level"):
            present = family == "Flow" and self.transition_tick is not None
            unread = int(present and self.reader_cursor < self.transition_tick)
            entry = {"kind": "transitionEvent", "stream": self.name + "/" + family, "size": int(present), "capacity": 65536, "readers": [{"system": self.name + "/Reader", "unread": unread, "lagged": False}]}
            if present and self.transition_tick <= self.boundary and unread:
                entry["heldBy"] = self.name + "/Reader"
            streams.append(entry)
        self.points.append(copy.deepcopy({"label": label, "world": world, "streams": streams, "readerValues": self.reader_values}))

    def run(self):
        self.reader()
        self.start_frame()
        self.advance()
        identity = self.spawn([31, 32], self.name + "/Seed")
        self.apply_deferred()
        self.start_frame()
        self.advance()
        self.spawn([99, 100], self.name + "/Pending")
        self.point("before")
        false_queue = self.queue(); self.point("false-queued")
        false_marker = self.marker(False); self.point("false-before-inspect")
        false_first = self.inspect(); self.point("false-after-first")
        false_second = self.inspect(); self.point("false-after-second")
        true_queue = self.queue(); self.point("true-queued")
        true_marker = self.marker(True); self.point("true-before-inspect")
        true_first = self.inspect(); self.point("true-after-first")
        true_second = self.inspect(); self.point("true-after-second")
        self.reader(); self.point("after-operational")
        return {"schema": self.name, "ids": [identity], "falseQueue": false_queue, "falseMarker": false_marker, "falseFirst": false_first, "falseSecond": false_second, "trueQueue": true_queue, "trueMarker": true_marker, "trueFirst": true_first, "trueSecond": true_second, "readResult": {"ok": True}, "points": self.points}

def output():
    return (json.dumps([Scene(name).run() for name in ("Workshop", "Garden")], separators=(",", ":"), ensure_ascii=False) + "\n").encode()

def selftest():
    for name in ("Workshop", "Garden"):
        value = Scene(name).run()
        points = value["points"]
        assert [(p["world"]["frame"], p["world"]["tick"]) for p in points] == [(3,4),(4,5),(5,7),(5,8),(5,9),(6,10),(7,11),(7,12),(7,13),(8,14)]
        assert value["falseFirst"]["flowTransitions"] == [{"from":7,"to":7}]
        assert all(value[k]["flowTransitions"] == [] for k in ("falseSecond","trueFirst","trueSecond"))
        assert points[-1]["readerValues"] == [value["falseSecond"],value["falseFirst"]]
        assert points[0]["world"]["pendingCommands"] == [{"tag":"spawn","system":name+"/Pending"}]
        assert points[2]["world"]["entityCount"] == 2 and points[2]["world"]["pendingCommands"] == []
        assert points[6]["streams"][0]["heldBy"] == name+"/Reader"
        assert "heldBy" not in points[-1]["streams"][0] and points[-1]["streams"][0]["size"] == 1
        assert points[-1]["streams"][0]["readers"][0]["unread"] == 0

if __name__ == "__main__":
    import sys
    selftest()
    sys.stdout.buffer.write(output())
