from pathlib import Path
import gzip, hashlib, json
HERE = Path(__file__).resolve().parent
sha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()
def main():
    basis = json.loads((HERE / "INDEPENDENT-SOURCE-BASIS.json").read_text())
    for path, digest in basis["sourcePins"].items():
        assert sha(path) == digest, path
    model = {"__name__": "source_model"}
    exec(compile((HERE / "model.py.source").read_text(), "model.py.source", "exec"), model)
    model["selftest"]()
    raw = model["output"]()
    previous = {"__name__": "historical_source_model"}
    exec(compile((HERE.parent / "model.py.source").read_text(), "historical-model", "exec"), previous)
    assert raw == previous["output"]()
    assert len(raw) == 17484
    repair = json.loads(Path(basis["repairContext"]).read_text())
    repaired = Path(basis["reference"]).read_text()
    assert repaired.count(repair["replacement"]["new"]) == 1
    inverse = repaired.replace(repair["replacement"]["new"], repair["replacement"]["old"])
    assert hashlib.sha256(inverse.encode()).hexdigest() == repair["beforeSHA256"]
    (HERE / "expected.stdout.gz").write_bytes(gzip.compress(raw, mtime=0))
    (HERE / "ORACLES.json").write_text(json.dumps({"normal": {"stdout": str(HERE / "expected.stdout.gz"), "bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest(), "sourceBasisSHA256": sha(HERE / "INDEPENDENT-SOURCE-BASIS.json")}}, indent=2) + "\n")
    print(len(raw), hashlib.sha256(raw).hexdigest())
if __name__ == "__main__":
    main()
