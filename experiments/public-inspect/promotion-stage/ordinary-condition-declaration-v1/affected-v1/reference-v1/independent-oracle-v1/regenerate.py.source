"""Regenerate finite reference oracle without evaluating JavaScript."""
from pathlib import Path
import gzip, hashlib, json
HERE = Path(__file__).resolve().parent
FIXTURE = Path('/workspace/formal-proofs/bendvy-worktrees/hierarchy44-public-traversal-v1/experiments/public-inspect/promotion-stage/ordinary-condition-declaration-v1/affected-v1/reference-v1')
sha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()

def main():
    basis = json.loads((HERE / "INDEPENDENT-SOURCE-BASIS.json").read_text())
    for path, digest in basis["sourcePins"].items():
        assert sha(path) == digest, path
    namespace = {"__name__": "source_model"}
    exec(compile((HERE / "model.py.source").read_text(), "model.py.source", "exec"), namespace)
    namespace["selftest"]()
    raw = namespace["output"]()
    (HERE / "expected.stdout").write_bytes(raw)
    (HERE / "expected.stdout.gz").write_bytes(gzip.compress(raw, mtime=0))
    catalogue = {"normal": {"stdout": str(HERE / "expected.stdout.gz"), "bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest(), "sourceBasisSHA256": sha(HERE / "INDEPENDENT-SOURCE-BASIS.json")}}
    (HERE / "ORACLES.json").write_text(json.dumps(catalogue, indent=2) + "\n")
    print(len(raw), hashlib.sha256(raw).hexdigest())

if __name__ == "__main__":
    main()
