from pathlib import Path
import json,hashlib,gzip,runpy
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def main():
    b=json.loads((HERE/'SOURCE-BASIS.json').read_text())
    for p,h in b['inputs'].items():assert sha(p)==h,p
    src=Path(b['consumer']).read_text();m=runpy.run_path(str(HERE/'model.py.source'))
    report=m['report']().fields[0]
    if b['kind']=='structural':
        assert 'Dispatch.identified(owners)' in src and 'app,A.Ids{1,2,3}' not in src
        assert 'Nat.add(width,1n)' in src and 'D.Program{width,build,[],evaluate}' in src and 'build(ids),99)' in src
        flags,cps=report.fields;assert flags==[True,True,True] and len(cps)==4
        assert all(m['show'](cp)==m['show'](cps[0]) for cp in cps)
        assert '|cursor' not in cps[0].fields[-1] # cursor retained in Fields DTO
        assert 'pending=1;' in cps[0].fields[-1] and 'barriers=0}' in cps[0].fields[-1]
    else:
        factory,before,after,completion=report.fields
        assert factory==3 and completion.name.endswith('application.Rejected')
        assert len(before)==len(after)==2
        assert [cp.fields[2] for cp in before]==[1,2]
        assert [m['show'](cp) for cp in before]==[m['show'](cp) for cp in after]
        assert 'Build.Registered{world2,owners1,recipe1,debug1}' in src
        assert 'Build.Registered{world1,owners2,recipe2,debug2}' in src
        assert 'A.run(first)' in src
        assert src.count('W.enqueue(~F.S,~F.Store,~F.Resources,~F.Events(),')==2
        assert src.count(',C.barrier)')==2
        cps=before+after
        for cp in cps:
            assert 'next=1;high=0;live=leaf:False;capacity=1;depth=0' in cp.fields[-1]
            assert 'pending=1;' in cp.fields[-1] and 'barriers=0}' in cp.fields[-1]
            assert 'leaf:some' not in cp.fields[-1]
            assert cp.fields[6][0].fields[0]==cp.fields[2]
    for cp in cps:
        assert len(cp.fields[6])==3
        assert all(f.fields[4]==0 for f in cp.fields[6])
        assert 'Ready:node(leaf:11,leaf:12)' in cp.fields[-1]
        assert 'clock=0}' in cp.fields[-1]
    raw=m['full_output']();assert raw.count(b'consumer.Checkpoint{')==4
    assert raw.count(b'ConditionPlacement{')==12
    (HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    o={'normal':{'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(HERE/'SOURCE-BASIS.json'),'sourceBasisSHA256':sha(HERE/'SOURCE-BASIS.json')}}
    (HERE/'ORACLES.json').write_text(json.dumps(o,indent=2)+'\n')
    (HERE/'CHECKS.json').write_text(json.dumps({'status':'SOURCE_DERIVED_COMPLETE_ORACLE_PASS','kind':b['kind'],'sourcePins':b['sourcePins'],'basisPins':len(b['inputs']),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'checks':['Current immutable source closure and actual-ID consumer','Four complete checkpoints/Arrayowners/Registryfields/family/recipe/physical state','Exact affected-entry nominal printer geometry','Refusal preserves all snapshots; no schedule predicate/dispatch/barrier work'],'limits':['No runtime output inputs','Structural trustedsetup validation only; not arbitrary public Program confinement proof','Foreign provision reads services before namespace rejection','No statefulcondition/full56 claim']},indent=2)+'\n')
    print(b['kind'],len(raw),hashlib.sha256(raw).hexdigest())
if __name__=='__main__':main()
