from pathlib import Path
import json,hashlib,runpy,gzip
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def main():
 b=json.loads((HERE/'SOURCE-BASIS.json').read_text())
 for p,h in b['inputs'].items():assert sha(p)==h,p
 c=json.loads(Path(b['context']).read_text());assert c['state']=='PREPARED_NOT_APPLIED' and sha(c['target'])==c['normalSHA256']
 a=Path(b['normalSource']).read_text();z=Path(b['mutantSource']).read_text();assert a.replace(c['before'],c['after'],1)==z
 normal=runpy.run_path(b['normalModel']);m=runpy.run_path(str(HERE/'model.py.source'))
 before=normal['scenario']().splitlines();after=m['scenario']().splitlines();assert len(before)==len(after)==14
 changed=[]
 for i,(x,y) in enumerate(zip(before,after)):
  assert x.split('|owners=Unit|')[1]==y.split('|owners=Unit|')[1]
  if x!=y:
   assert x.startswith('Dump{Flow|') and y.startswith('Dump:Disabled|');changed.append(i)
 assert changed==[1,2,5,7,9,11,12]
 assert all(before[i]==after[i] for i in [0,3,4,6,8,10,13])
 raw=m['full_output']();baseline=normal['full_output']();assert len(baseline)==7287 and hashlib.sha256(baseline).hexdigest()=='516aff8a81918fdc3b91d0615861ad773bedd88dfbacf2c2f1737dcdd5440f6e'
 assert json.loads(raw)==[m['scenario'](),m['scenario']()] and raw!=baseline
 (HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0));(HERE/'normal.stdout.gz').write_bytes(gzip.compress(baseline,mtime=0))
 def entry(data,path):return {'stdout':str(HERE/path),'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest(),'sourceBasisPath':str(HERE/'SOURCE-BASIS.json'),'sourceBasisSHA256':sha(HERE/'SOURCE-BASIS.json')}
 (HERE/'ORACLES.json').write_text(json.dumps({'prepared-mutant':entry(raw,'expected.stdout.gz'),'normalBaseline':entry(baseline,'normal.stdout.gz')},indent=2)+'\n')
 (HERE/'CHECKS.json').write_text(json.dumps({'status':'PREPARED_NOT_APPLIED_SOURCE_MODEL_PASS','sourcePins':55,'basisPins':len(b['inputs']),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'changedEnabledDumps':14,'checks':['Unique exact SomeView-to-None source delta','All28physicalstates identical inclslot/owners/queue/flush/marker','Oldsnapshot+disabled+operation outputs unchanged','Complete normal baseline independentlyreproduced'],'limits':['No runtime output inputs','Actual appliedsourcefreeze required before runtimequalification','No full56/universalpurity/performance claim']},indent=2)+'\n');print(len(raw),hashlib.sha256(raw).hexdigest())
if __name__=='__main__':main()
