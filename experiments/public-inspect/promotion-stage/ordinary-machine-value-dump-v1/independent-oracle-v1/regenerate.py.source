from pathlib import Path
import runpy,json,gzip,hashlib
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def main():
 b=json.loads((HERE/'SOURCE-BASIS.json').read_text())
 for p,h in b['inputs'].items():assert sha(p)==h,p
 src=Path(b['consumer']).read_text();entry=Path(b['entry']).read_text();m=runpy.run_path(str(HERE/'model.py.source'))
 assert '[C.scenario(~Alpha,2n,True{}),C.scenario(~Beta,2n,True{})]' in entry
 assert 'M.Present{7,M.NoPending{},Some{6},True{}}' in src and '[7,8,42,6]' in src
 assert 'queue(~S,~False{},8)' in src and 'queue(~S,~True{},9)' in src
 assert 'M.apply_snapshot' in src and 'MW.structural_flush' in src
 assert 'M.Applied{slot,_}' in src and 'W.event_publish' in src
 module=Path(b['dumpSource']).read_text()
 assert 'case app:(app,None{})' in module and 'Some{View{OD.name' in module
 lines=m['scenario']().splitlines();assert len(lines)==14
 assert lines[1]==lines[2] and lines[11]==lines[12]
 assert lines[3].startswith('Dump:Disabled') and lines[13].startswith('Dump:Disabled')
 body=lambda s:s.split('|owners=Unit|')[1]
 assert body(lines[4])==body(lines[5])==body(lines[6])==body(lines[7])
 assert 'Present:7:Queued:8:False:Some:6:True' in lines[4]
 assert 'Present:7:Queued:8:False:Some:6:True' in lines[8] and '[91, 92, 99]|pending=0' in lines[8]
 assert 'Present:8:NoPending:Some:7:True' in lines[10] and '[91, 92, 99]' in lines[10]
 assert all('|clock=0}' in s and '|registrations=[]|nextSystem=1' in s for s in lines)
 raw=m['full_output']();parsed=json.loads(raw);assert len(parsed)==2 and parsed[0]==parsed[1]==m['scenario']()
 (HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0));digest=hashlib.sha256(raw).hexdigest()
 (HERE/'ORACLES.json').write_text(json.dumps({'normal':{'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':digest,'sourceBasisPath':str(HERE/'SOURCE-BASIS.json'),'sourceBasisSHA256':sha(HERE/'SOURCE-BASIS.json')}},indent=2)+'\n')
 (HERE/'CHECKS.json').write_text(json.dumps({'status':'SOURCE_DERIVED_COMPLETE_ORACLE_PASS','sourcePins':55,'basisPins':len(b['inputs']),'bytes':len(raw),'sha256':digest,'checks':['Two nominal schemas all14actions/fullStringprinterroundtrip','Full current/pending/skipSame/previous/changed with owner-returning DataSlot','Successqueue8/Failurequeue9 exactrollback and unchangedclock','Structuralflush event99 separate explicitmarker8/previous7','Full C/R arrays/live/meta/commands/Registry and disabledobservations'],'limits':['No runtime output inputs','Finite existing consumer; no universal arbitrary presenter purity','No full56/performance claim']},indent=2)+'\n');print(len(raw),digest)
if __name__=='__main__':main()
