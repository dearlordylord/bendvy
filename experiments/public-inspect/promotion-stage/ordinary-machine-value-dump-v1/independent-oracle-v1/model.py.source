"""Source-only machine value dump model; no observed output inputs or checks yet."""
import json
ACTIONS=['snapshot','dump','repeatdump','disabled','queue8','dump','fail9','dump','flush','dump','marker','dump','repeatdump','disabled']
def scenario():
 current=7;pending=None;previous=6;changed=True;commands=1;events=[91,92];lines=[]
 for action in ACTIONS:
  if action=='queue8':pending=(8,False)
  # failed queue9 restores exact old slot via transaction undo; clock untouched.
  if action=='flush':commands=0;events.append(99)
  if action=='marker':
   if pending is not None:
    value,skip=pending
    if not(skip and current==value):previous,current,changed=current,value,True
    pending=None
  p='NoPending' if pending is None else 'Queued:'+str(pending[0])+':'+str(pending[1])
  slot='Present:'+str(current)+':'+p+':Some:'+str(previous)+':'+str(changed)
  world='world{1|3|2|node(node(leaf:False,leaf:True),node(leaf:True,leaf:False))|4|2|node(leaf:21,leaf:22)|'+slot+'|node(leaf:41,leaf:42)|['+', '.join(map(str,events))+']|pending='+str(commands)+'|registrations=[]|nextSystem=1|clock=0}'
  if action=='snapshot':head='Debug{bindings=0|machines=[Flow:Current:'+str(current)+', Flow:Vocabulary=[7, 8, 42, 6]]}'
  elif action=='disabled':head='Dump:Disabled'
  elif action=='queue8':head='Success'
  elif action=='fail9':head='Failure:Unit'
  elif action=='flush':head='StructuralFlush'
  elif action=='marker':head='Marker'
  else:head='Dump{Flow|'+slot+'}'
  lines.append(head+'|owners=Unit|'+world)
 return '\n'.join(lines)+'\n'
def full_output():
 return ('['+', '.join(json.dumps(scenario(),ensure_ascii=False) for _ in ['Alpha','Beta'])+']\n').encode()
if __name__=='__main__':
 import sys
 sys.stdout.buffer.write(full_output())
