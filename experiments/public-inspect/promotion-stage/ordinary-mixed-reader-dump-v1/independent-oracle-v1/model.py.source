from pathlib import Path
import os,json
TOP=Path('/workspace/formal-proofs/bendvy-worktrees/hierarchy44-public-traversal-v1/experiments/public-inspect/promotion-stage/ordinary-mixed-reader-dump-v1')
LOCAL='alpha'
# Source-derived successor bound to producer bbc997100; no output inputs.
CORE=Path('/workspace/formal-proofs/bendvy/src/ecs')
class Term:
    def __init__(self,name,*fields):self.name=name;self.fields=fields

def ctor(module,name,*fields):
    path=(CORE/module) if module.endswith('.bend') else TOP/LOCAL/(module+'.bend')
    ns=os.path.relpath(path,TOP).removesuffix('.bend')
    return Term(ns+'.'+name,*fields)
def base(name,*fields):return Term(name,*fields)
def show(x):
    if isinstance(x,Term):return x.name+'{'+', '.join(show(y) for y in x.fields)+'}'
    if isinstance(x,str):return json.dumps(x,ensure_ascii=False)
    if isinstance(x,list):return '['+', '.join(show(y) for y in x)+']'
    if isinstance(x,bool):return 'True{}' if x else 'False{}'
    return str(x)
def some(x):return base('Some',x)
def product(a,b):return ctor('ordinary-app-observation-data.bend','Product',a,b)
def arr(a,b):return f'node(leaf:{a},leaf:{b})'

class Nat:
    def __init__(self,value):self.value=value
    def __str__(self):return str(self.value)+'n'
def nat(x):return Nat(x)
def descriptor():return ctor('relation-types.bend','Descriptor',2,'Parent','Children',ctor('relation-types.bend','Hierarchy'))
def key():return ctor('internal/relation-failures/domains.bend','DeclaredKey',2)
def failure_notice():
    failure=ctor('relation-types.bend','Failure',descriptor(),ctor('relation-types.bend','Relate'),1,1,ctor('relation-types.bend','SelfRelationNotAllowed',1,'Parent'))
    return ctor('relation-commands.bend','RelationFailed',failure)
def publication(first=None,second=None):
    pair=ctor('event-publication.bend','Publication',[ctor('state','FirstEvent',first)] if first is not None else [],[ctor('state','SecondEvent',second)] if second is not None else [])
    return ctor('event-publication.bend','Publication',[pair],[])
def original(p):return ctor('relation-commands.bend','Original',p)
def passthrough(id):return [ctor('relation-commands.bend','ComponentRemoved',id),ctor('relation-commands.bend','CleanupPaused',[])]
def mixed_records(id,first,second):
    removed,paused=passthrough(id)
    return [original(publication(first=first)),removed,original(publication(second=second)),paused]
def batch(tick,values):return ctor('event-runtime.bend','Batch',nat(tick),values)
def unit():return base('Unit')
def description(phase):
    cells=[ctor('relation-query.bend','Cell','Parent',ctor('relation-query.bend','Outgoing'),ctor('relation-query.bend','Missing')),ctor('relation-query.bend','Cell','Children',ctor('relation-query.bend','Incoming'),ctor('relation-query.bend','Missing'))]
    row=ctor('inspector-query.bend','ProjectedRow',ctor('world.bend','Handle',1,1),ctor('inspector-query-projection.bend','Product',unit(),cells))
    rows=product(unit(),ctor('ordinary-app-relation.bend','View',descriptor(),[row]))
    for _ in range(4):rows=product(rows,unit())
    bindings=[]
    for id in range(1,5):
        slot='Signal' if id<4 else 'Parent'; name='SignalReader' if id<4 else 'ParentFailures'
        bindings.append(ctor('ordinary-app-observation-data.bend','Binding',1,id,name,[slot+':read'],2 if id==4 and phase>=3 else 0,slot,[ctor('ordinary-query-declaration.bend','Clause',slot,ctor('ordinary-query-declaration.bend','Read'))]))
    obs=ctor('ordinary-app-observation-data.bend','Observation',rows,['Relation{key=2|name=Parent|inverse=Children|kind=Hierarchy}','1:1:[Parent:Outgoing:Missing, Children:Incoming:Missing]'])
    schema=[ctor('schema-fragments.bend','Entry',ctor('schema-fragments.bend','Component'),'Payload','Payload'),ctor('schema-fragments.bend','Entry',ctor('schema-fragments.bend','Resource'),'Resources','Resources')]
    return ctor('ordinary-app-schema.bend','Description',schema,product(bindings,obs))
def reader_views(phase):
    typed=[]
    for id,local in ((1,1),(2,2),(3,1)):
        typed.append(ctor('reader-observer','TypedView','Signal',ctor('ordinary-event-declaration.bend','Read'),1,local,id,1,id,'SignalReader',['Signal:read'],0))
    failure=ctor('reader-observer','FailureView',descriptor(),1,4,'ParentFailures',['Parent:read'],2 if phase>=3 else 0,[key()])
    return ctor('reader-observer','View',*typed,failure)
def positions(kind,phase):
    if kind=='First':
        result=[]
        if phase>=4:result=[ctor('event-runtime.bend','Position',1,nat(2),nat(1))]
        if phase>=5:result=[ctor('event-runtime.bend','Position',2,nat(3),nat(2))]+result
        return result
    if kind=='Second' and phase>=6:return [ctor('event-runtime.bend','Position',1,nat(4),nat(3))]
    return []
def stream(kind,batches,phase):
    return ctor('event-stream.bend','Stream',ctor('ordinary-event-declaration.bend','Domain','Source.UnusedEvent' if kind=='Unused' else 'Signal'),batches,positions(kind,phase),3 if kind=='First' else (2 if kind=='Second' else 1),nat(5 if phase>=10 else 0),nat(5 if phase>=11 else 0),nat(2),nat(1 if phase>=11 and kind!='Unused' else 0))
def failure_domain(phase):
    if phase<2:return []
    retained=phase<13
    qb=ctor('internal/relation-failures/queue.bend','Batch',nat(1),nat(1),[failure_notice()])
    q=ctor('internal/relation-failures/queue.bend','Queue',[qb] if phase==12 else [],[qb] if phase<12 else [],nat(1 if retained else 0),nat(0 if retained else 1))
    return [ctor('internal/relation-failures/domains.bend','Domain',key(),q,[4] if phase>=3 else [])]
def physical(phase):
    clock=0 if phase<2 else (1 if phase==2 else 2)
    typed_tick=0 if phase==0 else (1 if phase<4 else (2 if phase==4 else (3 if phase==5 else (4 if phase==6 else 5))))
    events=[] if phase==0 else mixed_records(1,7,True)
    if phase>=7:events+=mixed_records(2,8,False)
    if phase>=11:events=passthrough(1)+mixed_records(2,8,False)
    regs=[ctor('world.bend','RegistrationMeta',id,'SignalReader' if id<4 else 'ParentFailures',['Signal:read' if id<4 else 'Parent:read']) for id in (4,3,2,1)]
    world=ctor('physical','WorldView',1,2,1,'node(leaf:False,leaf:True)',2,nat(1),'Column{values=node(leaf:none,leaf:some(node(leaf:41,leaf:42)));stamps=[]};sibling=node(leaf:11,leaf:12)',ctor('relation-types.bend','Graph',[],[]),'node(leaf:81,leaf:82)',events,nat(1 if phase==1 or phase>=7 else 0),regs,5,clock)
    first=[];second=[];journal=[]
    if phase>=1 and phase<11:
        first=[batch(1,[ctor('state','FirstEvent',7)])];second=[batch(1,[ctor('state','SecondEvent',True)])];journal=[batch(1,[publication(first=7),publication(second=True)])]
    if phase>=7:
        first+=[batch(5,[ctor('state','FirstEvent',8)])];second+=[batch(5,[ctor('state','SecondEvent',False)])];journal+=[batch(5,[publication(first=8),publication(second=False)])]
    failures=ctor('event-notice-runtime.bend','Failures',failure_domain(phase),[ctor('event-runtime.bend','Position',4,nat(2),nat(1))] if phase>=3 else [],nat(clock),nat(2 if phase>=12 else 0),nat(2 if phase>=13 else 0),nat(65536))
    return ctor('physical','View',world,stream('First',first,phase),stream('Second',second,phase),stream('Unused',[],phase),'node(leaf:31,leaf:32)',journal,nat(5 if phase>=10 else 0),failures,nat(typed_tick))
def dump():
