    row=ctor('ordinary-dump-filter.bend','Row',ctor('world.bend','Handle',1,1),[value('Payload','node(leaf:41,leaf:42)')])
    return ctor('ordinary-app-dump.bend','Dump',1,[row],[value('Resources','node(leaf:81,leaf:82)')])
def report():
    cps=[]
    for phase in range(14):
        enabled=phase!=9
        cps.append(ctor('consumer','Checkpoint',some(dump()) if enabled else base('None'),some(description(phase)) if enabled else base('None'),some(['Signal','Signal','Source.UnusedEvent']) if enabled else base('None'),physical(phase),reader_views(phase),'node(leaf:101,leaf:102)'))
    metadata=ctor('consumer','Metadata',2,ctor('world.bend','Handle',1,1),ctor('world.bend','Accepted'),some(ctor('relation-commands.bend','Queued')))
    first=[ctor('event-runtime.bend','Reading',[ctor('state','FirstEvent',7)],False) for _ in range(2)]
    second=[ctor('event-runtime.bend','Reading',[ctor('state','SecondEvent',True)],False)]
    failure=ctor('internal/relation-failures/readings.bend','KeyReading',key(),[failure_notice()],False)
    return some(ctor('consumer','Report',metadata,cps,first,second,[[failure]]))
def full_output():
