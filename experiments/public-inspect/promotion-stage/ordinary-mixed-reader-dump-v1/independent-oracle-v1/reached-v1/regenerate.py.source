from pathlib import Path
import json,hashlib,runpy,gzip
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def main():
 b=json.loads((HERE/'SOURCE-BASIS.json').read_text())
 for p,h in b['inputs'].items():assert sha(p)==h,p
 context=json.loads(Path(b['context']).read_text());assert context['status']=='PREPARED_NOT_APPLIED'
 assert sha(context['target'])==context['normalSHA256']
 source=Path(b['mutantSource']).read_text();assert 'Filter.Filter{entities,required,_}:Filter.Filter{entities,required,Some{0n}}' in source and 'forced_zero(~S,criteria)' in source
 assert 'case _ Some{0n}:(store,[])' in Path(b['eligibilitySource']).read_text()
 m=runpy.run_path(str(HERE/'model.py.source'));normal=runpy.run_path(b['normalModel'])
 assert (HERE/'model.py.source').read_text().split('CORE=',1)[1].replace('FILTER_LIMIT=0','FILTER_LIMIT=1')==Path(b['normalModel']).read_text().split('CORE=',1)[1]
 changed=0
 for local in ['alpha','beta']:
  m['report'].__globals__['LOCAL']=local;normal['report'].__globals__['LOCAL']=local
  a=m['report']().fields[0];z=normal['report']().fields[0]
  assert m['show'](a.fields[0])==normal['show'](z.fields[0])
  assert [m['show'](x) for x in a.fields[2:]]==[normal['show'](x) for x in z.fields[2:]]
  for cp,np in zip(a.fields[1],z.fields[1]):
   assert [m['show'](x) for x in cp.fields[1:]]==[normal['show'](x) for x in np.fields[1:]]
   if cp.fields[0].name=='None':assert np.fields[0].name=='None'
   else:
    d=cp.fields[0].fields[0];nd=np.fields[0].fields[0]
    assert d.fields[1]==[] and len(nd.fields[1])==1 and d.fields[0]==nd.fields[0]
    assert m['show'](d.fields[2])==normal['show'](nd.fields[2]);changed+=1
 assert changed==26
 raw=m['full_output']();baseline=normal['full_output']();assert raw!=baseline
 assert len(baseline)==212540 and hashlib.sha256(baseline).hexdigest()=='01ee4af7f37a4bcfa549a9ebccb724da48d208034d868e3960b83b878b22f529'
 (HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0));(HERE/'normal.stdout.gz').write_bytes(gzip.compress(baseline,mtime=0))
 def entry(data,path):return {'stdout':str(HERE/path),'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest(),'sourceBasisPath':str(HERE/'SOURCE-BASIS.json'),'sourceBasisSHA256':sha(HERE/'SOURCE-BASIS.json')}
 (HERE/'ORACLES.json').write_text(json.dumps({'prepared-mutant':entry(raw,'expected.stdout.gz'),'normalBaseline':entry(baseline,'normal.stdout.gz')},indent=2)+'\n')
 (HERE/'CHECKS.json').write_text(json.dumps({'status':'PREPARED_NOT_APPLIED_SOURCE_MODEL_PASS','sourcePins':107,'basisPins':len(b['inputs']),'changedEnabledRows':26,'disabledNone':2,'counterBytes':len(raw),'counterSHA256':hashlib.sha256(raw).hexdigest(),'checks':['Exact source criteria limit-zero; eligibility early stop before componentcount','Full26emptyrowlists only; alive/resources/remainingcheckpoint/metadata/readings exact','Full normal baseline reproduced independently'],'limits':['No runtime output inputs','Actual applied-source freeze required before runtime credit','No universalpurity/full56/performance claim']},indent=2)+'\n')
 print(len(raw),hashlib.sha256(raw).hexdigest())
if __name__=='__main__':main()
