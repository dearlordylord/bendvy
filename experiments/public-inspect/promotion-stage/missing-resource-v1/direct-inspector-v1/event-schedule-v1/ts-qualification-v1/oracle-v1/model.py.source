"""Independent source model for the fixed public-inspect TypeScript app.

The model is deliberately a small replay of the operations written in the
pinned reference.mjs.  It does not import, execute, or read output from the
TypeScript runtime.  Values below come from the public source operation order
and the pinned Runtime/World/Query/Streams contracts.
"""

from __future__ import annotations

import json
from typing import Any


SCHEMAS = ("Workshop", "Garden")
ABSENT = {"$symbol": "Symbol(bevy-ts/absent)"}


def score(cells: list[int]) -> dict[str, list[int]]:
    return {"cells": cells}


def rows(stock1: list[int] | None, stock2: list[int] | None) -> list[dict[str, Any]]:
    result: list[dict[str, Any]] = []
    if stock1 is not None:
        result.append({"id": 1, "cells": stock1})
    if stock2 is not None:
        result.append({"id": 2, "cells": stock2})
    return result


def project(
    stock1: list[int] | None,
    stock2: list[int] | None,
    added: list[int],
    changed: list[int],
    score_value: list[int],
    events: list[dict[str, list[int]]],
    removed: list[int],
    despawned: list[int],
    event_lag: bool = False,
) -> dict[str, Any]:
    """Match reference.mjs's Inspector projection key-for-key."""
    return {
        "rows": rows(stock1, stock2),
        "added": added,
        "changed": changed,
        "score": score(score_value),
        "events": events,
        "eventLag": event_lag,
        "removed": removed,
        "despawned": despawned,
    }


def system_reader(
    stock1: list[int] | None,
    stock2: list[int] | None,
    added: list[int],
    changed: list[int],
    score_value: list[int],
    events: list[dict[str, list[int]]],
    removed: list[int],
    despawned: list[int],
) -> dict[str, Any]:
    return project(stock1, stock2, added, changed, score_value, events, removed, despawned)


def obs(schema: str, label: str, value: Any) -> dict[str, Any]:
    return {"schema": schema, "label": label, "value": value}


def one_schema(schema: str) -> list[dict[str, Any]]:
    """Replay one nominal schema's 29 source-defined observations.

    Runtime ticks are retained in the comments because they determine the
    reader cursors.  Inspector calls advance the world's visibility tick only
    after their projection returns; schedule systems advance it at their run
    boundary, event publication adds one tick, and applyDeferred adds one.
    """
    out: list[dict[str, Any]] = []
    empty = project(None, None, [], [], [7, 8], [], [], [])

    # tick 0 -> 1 -> 2: the first Inspector reader sees an empty world twice.
    out.append(obs(schema, "empty-first", empty))
    out.append(obs(schema, "empty-repeat", empty))

    # The first Reader system runs before Seed has queued anything (system tick 3).
    out.append(obs(schema, "system-reader", system_reader(None, None, [], [], [7, 8], [], [], [])))

    # Seed commits its Ping at a fresh publication tick, while both spawns stay
    # pending until the explicit applyDeferred marker.
    seed_event = [{"cells": [31, 32]}]
    out.append(obs(schema, "pending-first", project(None, None, [], [], [7, 8], seed_event, [], [])))
    out.append(obs(schema, "pending-repeat", empty))

    # Stock is added by the deferred flush immediately before this inspect;
    # both lifecycle filters therefore see IDs 1 and 2 from their prior cursors.
    out.append(obs(schema, "live-first", project([11, 12], [21, 22], [1, 2], [1, 2], [7, 8], [], [], [])))
    out.append(obs(schema, "live-repeat", project([11, 12], [21, 22], [], [], [7, 8], [], [], [])))

    # The held Inspector returns live cells/resource values and a successful
    # query lookup for the first spawned entity.
    out.append(
        obs(
            schema,
            "held-before",
            {
                "cells": {"cells": [11, 12]},
                "resource": {"cells": [7, 8]},
                "lookup": True,
            },
        )
    )

    # The Reader's second run is after the deferred spawn: its cursor is still
    # before the add/change tick and it consumes the queued seed event.
    out.append(obs(schema, "system-reader", system_reader([11, 12], [21, 22], [1, 2], [1, 2], [7, 8], seed_event, [], [])))

    update_event = [{"cells": [41, 42]}]
    out.append(obs(schema, "after-reader", project([11, 12], [21, 22], [], [], [7, 8], [], [], [])))
    out.append(obs(schema, "changed-first", project([111, 112], [121, 122], [], [1, 2], [70, 80], update_event, [], [])))
    out.append(obs(schema, "changed-repeat", project([111, 112], [121, 122], [], [], [70, 80], [], [], [])))
    out.append(
        obs(
            schema,
            "held-after-write",
            {
                "cell": {"ok": True, "value": {"cells": [111, 112]}},
                "resource": {"ok": True, "value": {"cells": [70, 80]}},
            },
        )
    )

    check_value = {"count": 2, "score": {"cells": [70, 80]}}
    # Schedule.when evaluates the same cursor-free check once for Reader and
    # once for AfterCheck, so the source emits two check observations.
    out.append(obs(schema, "check", check_value))
    out.append(obs(schema, "system-reader", system_reader([111, 112], [121, 122], [], [1, 2], [70, 80], update_event, [], [])))
    out.append(obs(schema, "check", check_value))
    out.append(obs(schema, "gated-second", True))

    # Cleanup queues remove(entity 1, Stock) and despawn(entity 2).  The
    # pending view remains live until applyDeferred, so it still has both rows.
    out.append(obs(schema, "cleanup-pending", project([111, 112], [121, 122], [], [], [70, 80], [], [], [])))
    out.append(obs(schema, "cleanup-first", project(None, None, [], [], [70, 80], [], [1, 2], [2])))
    out.append(obs(schema, "cleanup-repeat", project(None, None, [], [], [70, 80], [], [], [])))
    out.append(
        obs(
            schema,
            "held-after-removal",
            {
                "cell": {"ok": True, "value": ABSENT},
                "lookupLiveMismatch": {"ok": False, "error": {"_tag": "QueryMismatch", "entityId": 1}},
                "lookupDead": {"ok": False, "error": {"_tag": "MissingEntity", "entityId": 2}},
            },
        )
    )
    out.append(obs(schema, "system-reader", system_reader(None, None, [], [], [70, 80], [], [1, 2], [2])))

    # A thrown Inspector defect does not advance its reader; retry succeeds and
    # returns the still-present Score resource.
    out.append(obs(schema, "throw", {"ok": False, "name": "Error", "message": "projection failed"}))
    out.append(obs(schema, "throw-retry", {"cells": [70, 80]}))

    # Missing resource reads are ordinary undefined values for inspect, while
    # tryTick reports the dynamic schedule requirement as a Result failure.
    out.append(obs(schema, "missing-inspect", {"ok": True, "value": {"$undefined": True}}))
    out.append(
        obs(
            schema,
            "missing-check",
            {
                "ok": False,
                "error": {
                    "kind": "MissingRuntimeRequirements",
                    "requirements": [{"kind": "resource", "name": f"{schema}/Score"}],
                },
            },
        )
    )
    out.append(
        obs(
            schema,
            "requirements",
            [
                {
                    "kind": "resource",
                    "name": f"{schema}/Score",
                    "key": {"$symbol": f"Symbol(bevy-ts/resource/{schema}/Score)"},
                }
            ],
        )
    )

    # The separate lag runtime emits one event, then two empty frames trim it;
    # the unregistered Inspector reader reports lagged=true after the drop.
    out.append(obs(schema, "lag-start", {"events": [], "lagged": False}))
    out.append(obs(schema, "lag-no-retention", {"events": [], "lagged": True}))
    assert len(out) == 29, (schema, len(out))
    return out


def expected_value() -> dict[str, Any]:
    observations: list[dict[str, Any]] = []
    for schema in SCHEMAS:
        observations.extend(one_schema(schema))
    assert len(observations) == 58
    return {"format": 1, "application": "PublicInspect", "observations": observations}


def stdout_bytes() -> bytes:
    # JSON.stringify emits compact UTF-8 JSON; the reference uses console.log,
    # which appends one LF after the canonical JSON string.
    return (json.dumps(expected_value(), ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")


if __name__ == "__main__":
    print(stdout_bytes().decode("utf-8"), end="")
