"""Regenerate the source-only public-inspect TypeScript oracle.

This script validates the frozen source closure and the independent Python
model, then writes the parsed JSON, canonical JSON+LF, deterministic gzip, and
small provenance records. It never invokes Node, Bend, or a candidate binary.
"""

from __future__ import annotations

import gzip
import hashlib
import json
import runpy
from pathlib import Path


HERE = Path(__file__).resolve().parent
LEAF = HERE.parent
PARENT_SOURCE = LEAF / "SOURCE.json"
PARENT_SOURCE_SHA256 = "70022fef818d8121860f0c585b2c3b3662fc1c82f5e29e1174b366f0ac16b7f5"
REFERENCE = Path("/workspace/formal-proofs/bendvy/experiments/public-inspect/reference.mjs")
REFERENCE_SHA256 = "282daa36fd382d29348bce8bc31fedfdd7eca769ac7dda34bf8ce5fabe028a6c"
TS_COMMIT = "3040a3b2a3f28fa8554d856f9ccb6bf5433fa334"
MODEL = HERE / "model.py.source"
REGENERATOR = HERE / "regenerate.py.source"


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


assert sha256(PARENT_SOURCE) == PARENT_SOURCE_SHA256, "parent source basis changed"
assert sha256(REFERENCE) == REFERENCE_SHA256, "pinned public-inspect reference changed"
parent = json.loads(PARENT_SOURCE.read_text())
assert parent["consumerSHA256"] == REFERENCE_SHA256
assert parent["referenceCommit"] == TS_COMMIT
inventory = parent["referenceSourceInventory"]
assert len(inventory) == 33
for source_path, expected_hash in inventory.items():
    path = Path(source_path)
    assert sha256(path) == expected_hash, f"pinned TS source changed: {path}"

model_hash = sha256(MODEL)
regenerator_hash = sha256(REGENERATOR)
basis = {
    "state": "SOURCE_DERIVED_MODEL_ONLY",
    "scope": "Fixed public-inspect reference; 58 ordered observations, 29 per Workshop/Garden.",
    "parentSource": {"path": str(PARENT_SOURCE), "sha256": PARENT_SOURCE_SHA256},
    "consumer": {"path": str(REFERENCE), "sha256": REFERENCE_SHA256},
    "referenceCommit": TS_COMMIT,
    "referenceSourceCount": len(inventory),
    "referenceSourceInventory": inventory,
    "model": {"path": str(MODEL), "sha256": model_hash},
    "regenerator": {"path": str(REGENERATOR), "sha256": regenerator_hash},
    "runtimeOutputInputs": [],
    "derivation": [
        "The loop creates independent Workshop and Garden schemas with Stock, Tag, Score, and Ping descriptors whose names are schema-prefixed.",
        "The first Inspector reads plain/added/changed queries, Score, Ping, removed Stock, and despawned entities; its reader cursor advances only after each successful projection.",
        "Seed queues entity IDs 1 and 2 and one Ping batch; the explicit applyDeferred schedule makes the rows visible, while event publication occurs at the system commit tick.",
        "The held Inspector retains live component/resource cells and a query handle; component removal leaves the cell's source-defined ABSENT symbol observable, while lookup returns QueryMismatch for the live entity and MissingEntity for the despawned entity.",
        "Update writes both Stock rows, Score, and a second Ping batch. The Reader and the cursor-free condition observe their respective event/change windows; Schedule.when evaluates the check separately for each gated system.",
        "Cleanup queues remove(entity 1, Stock) and despawn(entity 2); the deferred boundary records removed IDs [1,2] and despawned ID [2] for readers whose cursors have not advanced.",
        "The throwing Inspector's first attempt is an Error defect and does not advance its reader; the retry returns the live Score value.",
        "Inspecting a missing resource returns undefined as data, while tryTick reports MissingRuntimeRequirements and the Inspector exposes the descriptor requirement including its global Symbol key.",
        "The separate lag runtime emits one Ping, then two empty frames trim the unregistered Inspector stream; the final lag read is empty with lagged=true.",
        "Canonical bytes are JSON.stringify's compact UTF-8 object followed by the reference console.log newline; no historical or candidate output is an input.",
    ],
    "limits": [
        "Finite source-derived trace for the two nominal schemas; no universal ECS or TypeScript semantic proof.",
        "No Node/Bend/native execution and no runtime stdout is read by this model or regenerator.",
        "The model covers the exact public-inspect operations in the pinned reference and does not claim equivalence to the Bend physical-owner representation.",
    ],
}
(HERE / "SOURCE-BASIS.json").write_text(json.dumps(basis, indent=2) + "\n")

model = runpy.run_path(str(MODEL))
expected = model["expected_value"]()
raw = model["stdout_bytes"]()
assert len(expected["observations"]) == 58
assert [sum(1 for item in expected["observations"] if item["schema"] == schema) for schema in ("Workshop", "Garden")] == [29, 29]
assert raw.endswith(b"\n")
assert json.loads(raw.decode("utf-8")) == expected
assert sum(1 for item in expected["observations"] if item["label"] == "check") == 4
assert sum(1 for item in expected["observations"] if item["label"] == "system-reader") == 8
assert expected["observations"][54]["value"]["error"]["requirements"][0]["name"] == "Garden/Score"
assert expected["observations"][57]["value"]["lagged"] is True

expected_path = HERE / "expected.json"
stdout_path = HERE / "expected.stdout"
gzip_path = HERE / "expected.stdout.gz"
expected_path.write_text(json.dumps(expected, indent=2, ensure_ascii=False) + "\n")
stdout_path.write_bytes(raw)
gzip_bytes = gzip.compress(raw, mtime=0)
assert gzip.decompress(gzip_bytes) == raw
gzip_path.write_bytes(gzip_bytes)

basis_path = HERE / "SOURCE-BASIS.json"
basis_hash = sha256(basis_path)
raw_hash = hashlib.sha256(raw).hexdigest()
gzip_hash = hashlib.sha256(gzip_bytes).hexdigest()
oracles = {
    "state": "SOURCE_DERIVED_NO_RUNTIME_INPUTS",
    "normal": {
        "json": str(expected_path),
        "stdout": str(stdout_path),
        "stdoutGzip": str(gzip_path),
        "observations": 58,
        "bytes": len(raw),
        "sha256": raw_hash,
        "gzipBytes": len(gzip_bytes),
        "gzipSHA256": gzip_hash,
        "sourceBasisPath": str(basis_path),
        "sourceBasisSHA256": basis_hash,
        "runtimeOutputInputs": [],
    },
}
(HERE / "ORACLES.json").write_text(json.dumps(oracles, indent=2) + "\n")

checks = {
    "status": "PASS_SOURCE_MODEL_ONLY",
    "parentSourceSHA256": PARENT_SOURCE_SHA256,
    "referenceSHA256": REFERENCE_SHA256,
    "referenceCommit": TS_COMMIT,
    "referenceSourceCount": len(inventory),
    "observationCount": len(expected["observations"]),
    "observationsPerSchema": {schema: sum(1 for item in expected["observations"] if item["schema"] == schema) for schema in ("Workshop", "Garden")},
    "modelSHA256": model_hash,
    "regeneratorSHA256": regenerator_hash,
    "sourceBasisSHA256": basis_hash,
    "stdoutBytes": len(raw),
    "stdoutSHA256": raw_hash,
    "gzipBytes": len(gzip_bytes),
    "gzipSHA256": gzip_hash,
    "runtimeOutputInputs": [],
    "assertions": [
        "all 33 pinned bevy-ts source hashes and the fixed reference hash match",
        "the Python model produces exactly 29 ordered observations per nominal schema",
        "Schedule.when evaluates the check twice, preserving both check observations",
        "held cells, lookup mismatch/missing errors, undefined resource read, and resource requirement Symbol are source-defined values",
        "the lag runtime drops its event batch after two empty frames and reports lagged=true",
        "canonical JSON parses to the model value and has exactly one terminal LF",
        "deterministic gzip round-trips the canonical bytes",
        "no historical, candidate, or runtime output is read",
    ],
}
(HERE / "CHECKS.json").write_text(json.dumps(checks, indent=2) + "\n")
print(json.dumps({"observations": len(expected["observations"]), "stdoutBytes": len(raw), "stdoutSHA256": raw_hash}, sort_keys=True))
