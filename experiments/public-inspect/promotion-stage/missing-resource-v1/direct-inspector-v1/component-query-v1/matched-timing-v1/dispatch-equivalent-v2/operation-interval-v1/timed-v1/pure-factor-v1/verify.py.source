"""Verify retained private source factor and bounded outcomes without rerunning tools."""
from pathlib import Path
import hashlib,json,zipfile,re
HERE=Path(__file__).resolve().parent
sha=lambda raw:hashlib.sha256(raw).hexdigest()
def end(text,start):
 depth=0
 for i in range(start,len(text)):
  if text[i]=='(':depth+=1
  elif text[i]==')':
   depth-=1
   if depth==0:return i+1
 raise AssertionError('unclosed call')
def main():
 d=json.loads((HERE/'DELIVERY.json').read_text());assert sha((HERE/'EVIDENCE.zip').read_bytes())==d['archiveSHA256']
 with zipfile.ZipFile(HERE/'EVIDENCE.zip') as z:
  assert z.testzip() is None
  for row in d['members']:assert sha(z.read(row['path']))==row['sha256']
  old=z.read('candidate/original-runtime-declarations.bend.source').decode();new=z.read('candidate/bend/runtime-declarations.bend').decode()
  helper=re.search(r'^def inspect_finish_optional_four[^\n]*\n  ([^\n]*)\n',new,re.M);assert helper is not None
  body=helper.group(1);expanded=new[:helper.start()]+new[helper.end():];count=0
  while 'inspect_finish_optional_four(' in expanded:
   start=expanded.index('inspect_finish_optional_four(');stop=end(expanded,start+len('inspect_finish_optional_four'))
   call=expanded[start:stop];prefix='inspect_finish_optional_four(~S,~Resource,';assert call.startswith(prefix)
   head=call[len(prefix):-1];expanded=expanded[:start]+body.replace('~head',head,1)+expanded[stop:];count+=1
  assert count==3 and expanded==old
  source=json.loads(z.read('candidate/source-check01/receipt.json'));assert source['exit']==0 and source['failure'] is None
  raw=z.read('candidate/runtime01/js/consumer.stdout');assert len(raw)==226096 and sha(raw)=='fea8df01c26bf7141798bd2b45b4e4139e5bbe2b54af9c53674117be662245a9'
  native=json.loads(z.read('candidate/runtime01/native-emit/receipt.json'));assert native['status']=='INCOMPLETE' and native['commands'][0]['failure']=='child deadline'
 print(json.dumps({'status':'PASS_RETAINED_SOURCE_JS_ONLY','members':len(d['members']),'expandedCalls':3,'Native':'INCOMPLETE'}))
if __name__=='__main__':main()
