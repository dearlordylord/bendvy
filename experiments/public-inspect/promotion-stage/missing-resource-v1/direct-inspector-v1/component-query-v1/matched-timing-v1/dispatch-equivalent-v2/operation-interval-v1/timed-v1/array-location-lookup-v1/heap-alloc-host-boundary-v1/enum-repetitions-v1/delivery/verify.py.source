"""Verify retained enum failure; never execute tools or runtime."""
from pathlib import Path
import hashlib
import json
import zipfile

HERE = Path(__file__).resolve().parent

def sha(raw):
    return hashlib.sha256(raw).hexdigest()

def main():
    d = json.loads((HERE / "DELIVERY.json").read_text())
    assert sha((HERE / "EVIDENCE.zip").read_bytes()) == d["archiveSHA256"]
    with zipfile.ZipFile(HERE / "EVIDENCE.zip") as z:
        assert set(z.namelist()) == {r["path"] for r in d["members"]}
        for row in d["members"]:
            raw = z.read(row["path"])
            assert len(raw) == row["bytes"] and sha(raw) == row["sha256"]
        get = lambda p: z.read("candidate/" + p)
        launch = json.loads(get("LAUNCH.json"))
        assert sha(get("FREEZE.json")) == launch["freezeSHA256"]
        assert sha(get("PLAN.json")) == launch["planSHA256"]
        p = json.loads(get("PLAN.json"))
        t = json.loads(get("terminal.json"))
        r = json.loads(get("runtime01/receipt.json"))
        assert t["planSHA256"] == launch["planSHA256"]
        assert t["status"] == r["status"] == "INCOMPLETE"
        assert not t["drift"] and not t["guardFailures"] and t["harnessPostguard"] == "UNCHANGED"
        assert not r["guardFailures"] and r["ordinarySemantics"] == []
        assert len(r["commands"]) == 19
        assert all(c["exit"] == 0 and c["failure"] is None for c in r["commands"][:-1])
        last = r["commands"][-1]
        assert last["label"] == "inspectors-runtime-compile" and last["failure"] == "child deadline"
        assert last["cap"] == 120 and last["exit"] is None
        assert get("runtime01/inspectors-runtime-compile.stdout") == get("runtime01/inspectors-runtime-compile.stderr") == b""
        for name, digest in dict(r["artifacts"], **r["logs"]).items():
            assert sha(get("runtime01/" + name)) == digest
        expected = {"one": b"1:20\n", "two": b"2:40\n", "four": b"4:80\n", "invalid": b"INVALID\n", "missing": b"INVALID\n", "extra": b"INVALID\n"}
        for backend in ["JS", "Native"]:
            for label, raw in expected.items():
                assert get("runtime01/selector-" + backend + "-" + label + ".stdout") == raw
                assert get("runtime01/selector-" + backend + "-" + label + ".stderr") == b""
        assert "candidate/runtime01/inspectors-runtime" not in z.namelist()
        assert sha(z.read("dependencies/" + p["compiler"].lstrip("/"))) == "f1a2288f512f3bed37199bd463a8bc57126377a65b2e9e2924a3110f4156e28f"
        assert sha(get("RESULT.json")) == d["resultSHA256"]
    print(json.dumps({"status": "PASS_RETAINED_ENUM_BUILD_INCOMPLETE", "members": len(d["members"])}))

if __name__ == "__main__":
    main()
