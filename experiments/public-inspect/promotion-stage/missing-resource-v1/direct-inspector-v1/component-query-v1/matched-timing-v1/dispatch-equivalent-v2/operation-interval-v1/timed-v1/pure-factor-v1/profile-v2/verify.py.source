"""Verify retained bounded emitter profile, without compiler execution."""
from pathlib import Path
import hashlib,json,zipfile
HERE=Path(__file__).resolve().parent
sha=lambda raw:hashlib.sha256(raw).hexdigest()
def main():
 d=json.loads((HERE/'DELIVERY.json').read_text());assert sha((HERE/'EVIDENCE.zip').read_bytes())==d['archiveSHA256']
 with zipfile.ZipFile(HERE/'EVIDENCE.zip') as z:
  assert z.testzip() is None and set(z.namelist())=={r['path'] for r in d['members']}
  for row in d['members']:assert sha(z.read(row['path']))==row['sha256']
  outer=json.loads(z.read('profile-v2/outer01/receipt.json'));role=json.loads(z.read('profile-v2/native-output/receipt.json'))
  assert outer['status']=='INCOMPLETE' and outer['sourceInputsUnchanged'] and role['status']=='INCOMPLETE'
  assert role['commands'][0]['exit']==77 and role['commands'][0]['failure'] is None
  p=json.loads(z.read('profile-v2/native-output/emitter.cpuprofile'));ids={n['id'] for n in p['nodes']}
  assert len(ids)==len(p['nodes']) and len(p['samples'])==len(p['timeDeltas'])==1469
  assert all(n in ids for n in p['samples']) and all(d>=0 for d in p['timeDeltas'])
  assert sum(p['timeDeltas'])==20079010
  raw=z.read('profile-v2/native-output/emit.stderr');assert b'DIAGNOSTIC_PROFILE_STOP' in raw and b'"pass":2' in raw
  assert not any(n.endswith('scenario.c') for n in z.namelist())
 print(json.dumps({'status':'PASS_RETAINED_DIAGNOSTIC_ONLY','members':len(d['members']),'samples':1469,'Native':'INCOMPLETE'}))
if __name__=='__main__':main()
