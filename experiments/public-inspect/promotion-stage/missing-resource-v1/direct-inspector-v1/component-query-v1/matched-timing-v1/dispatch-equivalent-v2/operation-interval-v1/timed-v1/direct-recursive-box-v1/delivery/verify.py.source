"""Verify retained direct-self witness evidence; never rerun compiler or consumer."""
from pathlib import Path
import gzip,hashlib,json,zipfile
HERE=Path(__file__).resolve().parent
sha=lambda b:hashlib.sha256(b).hexdigest()
def main():
 d=json.loads((HERE/'DELIVERY.json').read_text())
 assert sha((HERE/'EVIDENCE.zip').read_bytes())==d['archiveSHA256']
 with zipfile.ZipFile(HERE/'EVIDENCE.zip') as z:
  assert z.testzip() is None
  assert set(z.namelist())=={r['path'] for r in d['members']}
  for r in d['members']:
   raw=z.read(r['path']);assert len(raw)==r['bytes'] and sha(raw)==r['sha256']
  freeze=json.loads(z.read('candidate/FREEZE.json'));launch=json.loads(z.read('candidate/LAUNCH.json'))
  assert sha(z.read('candidate/FREEZE.json'))==launch['freezeSHA256']
  assert sha(z.read('candidate/compiler/candidate.mjs'))==freeze['candidateSHA256']
  for role in ['js','native']:
   p=json.loads(z.read('candidate/runtime01/'+role+'/plan.json'))
   receipt=json.loads(z.read('candidate/runtime01/'+role+'/receipt.json'))
   assert receipt['planSHA256']==sha(z.read('candidate/runtime01/'+role+'/plan.json'))
   assert not receipt.get('guardFailures',[])
   for path,expected in p['sourceInventory'].items():assert sha(z.read('dependencies/'+path.lstrip('/')))==expected
   assert len(p['sourceInventory'])==63
   oracle=gzip.decompress(z.read('dependencies/'+p['oracle'].lstrip('/')))
   assert len(oracle)==p['oracleBytes']==226096 and sha(oracle)==p['oracleSHA256']
   for row in receipt['commands']:
    for stream in ['stdout','stderr']:
     raw=z.read('candidate/runtime01/'+role+'/'+row['label']+'.'+stream)
     assert len(raw)==row[stream]['bytes'] and sha(raw)==row[stream]['sha256']
  js=json.loads(z.read('candidate/runtime01/js/receipt.json'))
  native=json.loads(z.read('candidate/runtime01/native/receipt.json'))
  assert js['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS'
  assert z.read('candidate/runtime01/js/consumer.stdout')==oracle
  assert native['status']=='INCOMPLETE'
  assert native['commands'][0]['exit']==0 and native['commands'][0]['failure'] is None
  assert native['commands'][1]['exit'] is None and native['commands'][1]['failure']=='child deadline'
  assert len(native['commands'])==2 and 'candidate/runtime01/native/scenario.native' not in z.namelist()
  assert sha(z.read('candidate/runtime01/native/scenario.c'))==native['emitArtifactSHA256']
  assert json.loads(z.read('candidate/controls.stdout'))['status']=='PASS'
  assert json.loads(z.read('candidate/bendvy-direct-box-independent.json'))['status']=='PASS'
 print(json.dumps({'status':'PASS_RETAINED_PARTIAL_EVIDENCE','members':len(d['members']),'JS':'full226096 PASS','Native':'emit PASS, O3build INCOMPLETE'}))
if __name__=='__main__':main()
