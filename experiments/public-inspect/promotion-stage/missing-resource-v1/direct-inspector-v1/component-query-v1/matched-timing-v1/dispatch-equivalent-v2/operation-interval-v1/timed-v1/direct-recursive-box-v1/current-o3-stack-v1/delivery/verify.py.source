"""Verify retained current-C diagnostic without executing its subject."""
from pathlib import Path
import hashlib,json,zipfile
HERE=Path(__file__).resolve().parent
sha=lambda b:hashlib.sha256(b).hexdigest()
def main():
 d=json.loads((HERE/'DELIVERY.json').read_text());assert sha((HERE/'EVIDENCE.zip').read_bytes())==d['archiveSHA256']
 with zipfile.ZipFile(HERE/'EVIDENCE.zip') as z:
  assert z.testzip() is None and set(z.namelist())=={r['path'] for r in d['members']}
  for row in d['members']:
   raw=z.read(row['path']);assert len(raw)==row['bytes'] and sha(raw)==row['sha256']
  p=json.loads(z.read('diagnostic/plan.json'));f=json.loads(z.read('diagnostic/FREEZE.json'));l=json.loads(z.read('diagnostic/LAUNCH.json'));r=json.loads(z.read('diagnostic/receipt.json'))
  assert sha(z.read('diagnostic/plan.json'))==f['planSHA256']==l['planSHA256']==r['planSHA256']
  assert sha(z.read('diagnostic/FREEZE.json'))==l['freezeSHA256']
  assert r['status']=='INCOMPLETE' and not r['guardFailures']
  c=r['commands'][0];assert c['exit']==-9 and c['failure']=='child left owned descendants; no passing result'
  assert sha(z.read('dependencies/'+p['generated'].lstrip('/')))==f['currentCSHA256']==p['provenance']['currentCSHA256']
  for path,expected in p['sourceInventory'].items():assert sha(z.read('dependencies/'+path.lstrip('/')))==expected
  assert len(p['sourceInventory'])==63
  raw=z.read('diagnostic/source-clang-standard-o3-stack.stderr');assert sha(raw)==c['stderr']['sha256']
  assert b'Per-file LLVM IR generation' in raw and b'CodeGenTypes::ConvertType' in raw and b'INSPECTOR_QUERY_COMPOSED_LOOKUP_MATCHED_30_C8560' in raw
  assert 'diagnostic/snapshot.native' not in z.namelist()
 print(json.dumps({'status':'PASS_RETAINED_DIAGNOSTIC_ONLY','members':len(d['members']),'Native':'INCOMPLETE','sample':'frontend IRgen'}))
if __name__=='__main__':main()
