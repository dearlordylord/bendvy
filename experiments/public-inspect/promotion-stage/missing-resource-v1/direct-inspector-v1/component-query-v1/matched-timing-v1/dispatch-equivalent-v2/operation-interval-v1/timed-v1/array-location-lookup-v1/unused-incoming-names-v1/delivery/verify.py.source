"""Verify retained ABI controls and unexecuted full plans; no tool execution."""
from pathlib import Path
import hashlib
import json
import re
import zipfile

HERE = Path(__file__).resolve().parent

def sha(raw):
    return hashlib.sha256(raw).hexdigest()

def main():
    delivery = json.loads((HERE / "DELIVERY.json").read_text())
    assert sha((HERE / "EVIDENCE.zip").read_bytes()) == delivery["archiveSHA256"]
    with zipfile.ZipFile(HERE / "EVIDENCE.zip") as z:
        assert set(z.namelist()) == {r["path"] for r in delivery["members"]}
        for row in delivery["members"]:
            raw = z.read(row["path"])
            assert len(raw) == row["bytes"] and sha(raw) == row["sha256"]
        get = lambda name: z.read("candidate/" + name)
        derivation = json.loads(get("DERIVATION.json"))
        raw = get("derived.c")
        assert sha(raw) == derivation["derivedCSHA256"]
        anchor = "#define WL_SPIN     for (;;) { if (err_spun(e.mem, &wpoll)) { return 0; }\n"
        extra = "#if DEVICE\n#define WL_CASE_SIG(F, ...) WL_CASE(F)\n#else\n#define WL_CASE_SIG(F, ...) WL_FN WL_##F(__VA_ARGS__)\n#endif\n"
        text = raw.decode().replace(extra + anchor, anchor)
        rows = derivation["rows"]
        assert len(rows) == derivation["changedCases"] == 9552
        reverse = {r["new"]: r["old"] for r in rows}
        text = "".join(reverse.get(line.rstrip("\n"), line.rstrip("\n")) + ("\n" if line.endswith("\n") else "") for line in text.splitlines(True))
        baseline = z.read("dependencies/baseline.c")
        assert text.encode() == baseline and sha(baseline) == derivation["baselineCSHA256"]
        signature = re.search(r"^#define WL_SIG (.*)$", baseline.decode(), re.M).group(1)
        types = [re.sub(r" r\d+$", "", a) for a in signature.split(", ")]
        assert len(types) == 46
        for row in rows:
            args = row["new"].split(", ", 1)[1][:-1].split(", ")
            assert [re.sub(r" r\d+$", "", a) for a in args] == types
        extension = "#define WL_CASE_SIG(F, ...) __extension__ WL_FN WL_##F(__VA_ARGS__)"
        ordinary = "#define WL_CASE_SIG(F, ...) WL_FN WL_##F(__VA_ARGS__)"
        assert get("warning-suppression-v2/derived.c").replace(extension.encode(), ordinary.encode()) == raw
        assert get("warning-suppression-v2/compiler/candidate.mjs").replace(extension.encode(), ordinary.encode()) == get("compiler/candidate.mjs")
        for prefix in ["", "warning-suppression-v2/"]:
            launch = json.loads(get(prefix + "LAUNCH.json"))
            assert sha(get(prefix + "FREEZE.json")) == launch["freezeSHA256"]
            for item in launch["order"]:
                role = item["role"] + "01/plan.json"
                assert sha(get(prefix + role)) == item["sha256"]
        for prefix, role in [("", "control-host01"), ("", "control-device01"), ("warning-suppression-v2/", "control-host01")]:
            base = prefix + role + "/"
            receipt = json.loads(get(base + "receipt.json"))
            assert receipt["status"] == "COMPLETE_CONSUMER_DEVELOPMENT_PASS"
            assert all(c["exit"] == 0 and c["failure"] is None for c in receipt["commands"])
            assert get(base + "consumer.stdout") == b"PASS ABI\n"
            if role == "control-device01":
                assert get(base + "build.stderr") == b""
            else:
                assert b"[-Wc23-extensions]" in get(base + "build.stderr")
            for guard in receipt["guards"]:
                assert sha(get(base + Path(guard["path"]).name)) == guard["sha256"]
        for name in ["full-native01/receipt.json", "warning-suppression-v2/full-native01/receipt.json"]:
            assert "candidate/" + name not in z.namelist()
        result = json.loads(get("RESULT.json"))
        assert result["status"] == "MICRO_ABI_PASS_FULL_NOT_RUN_WARNING_GATE"
        assert not result["nativeAcceptance"]
    print(json.dumps({"status": "PASS_RETAINED_ABI_MICRO_FULL_NOT_RUN", "members": len(delivery["members"]), "exactReversal": True}))

if __name__ == "__main__":
    main()
