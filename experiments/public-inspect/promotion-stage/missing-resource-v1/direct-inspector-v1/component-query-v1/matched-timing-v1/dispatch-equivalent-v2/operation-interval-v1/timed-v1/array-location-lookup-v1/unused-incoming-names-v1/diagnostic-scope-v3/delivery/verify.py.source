"""Retained scoped pragma ABI/deadline evidence; no compiler execution."""
from pathlib import Path
import hashlib
import json
import re
import zipfile

HERE = Path(__file__).resolve().parent

def sha(raw):
    return hashlib.sha256(raw).hexdigest()

def main():
    delivery = json.loads((HERE / "DELIVERY.json").read_text())
    assert sha((HERE / "EVIDENCE.zip").read_bytes()) == delivery["archiveSHA256"]
    with zipfile.ZipFile(HERE / "EVIDENCE.zip") as z:
        assert set(z.namelist()) == {r["path"] for r in delivery["members"]}
        for row in delivery["members"]:
            raw = z.read(row["path"])
            assert len(raw) == row["bytes"] and sha(raw) == row["sha256"]
        get = lambda name: z.read("candidate/" + name)
        freeze = json.loads(get("FREEZE.json"))
        launch = json.loads(get("LAUNCH.json"))
        assert sha(get("FREEZE.json")) == launch["freezeSHA256"]
        assert sha(get("compiler/candidate.mjs")) == freeze["candidateSHA256"]
        assert sha(get("derived.c")) == freeze["derivedCSHA256"]
        text = get("derived.c").decode()
        block = re.search(r"#if DEVICE\n#define WL_UNNAMED_PUSH\n.*?#endif\n", text, re.S).group(0)
        assert text.count(block) == 1
        assert text.count("  WL_UNNAMED_PUSH\n") == text.count("  WL_UNNAMED_POP\n") == 9552
        restored = text.replace(block, "").replace("  WL_UNNAMED_PUSH\n", "").replace("  WL_UNNAMED_POP\n", "")
        assert restored.encode() == z.read("dependencies/baseline.c")
        compiler = get("compiler/candidate.mjs").decode()
        compiler = compiler.replace(block, "").replace('      "  WL_UNNAMED_PUSH",\n', "")
        compiler = compiler.replace('      "  }}",\n      "  WL_UNNAMED_POP"', '      "  }}"')
        assert compiler.encode() == z.read("dependencies/baseline-compiler.mjs")
        for item in launch["order"]:
            base = item["role"] + "01/"
            assert sha(get(base + "plan.json")) == item["sha256"]
            receipt = json.loads(get(base + "receipt.json"))
            assert receipt["planSHA256"] == item["sha256"]
            assert not receipt.get("guardFailures", [])
            for guard in receipt["guards"]:
                assert sha(get(base + Path(guard["path"]).name)) == guard["sha256"]
        host = json.loads(get("control-host01/receipt.json"))
        assert host["status"] == "COMPLETE_CONSUMER_DEVELOPMENT_PASS"
        assert all(c["exit"] == 0 and c["failure"] is None for c in host["commands"])
        assert get("control-host01/build.stderr") == b""
        assert get("control-host01/consumer.stdout") == b"PASS ABI\n"
        full = json.loads(get("full-native01/receipt.json"))
        assert full["status"] == "INCOMPLETE" and len(full["commands"]) == 1
        command = full["commands"][0]
        assert command["exit"] is None and command["failure"] == "child deadline"
        assert command["capSeconds"] == 120
        assert get("full-native01/build.stderr") == get("full-native01/build.stdout") == b""
        assert "candidate/full-native01/scenario.native" not in z.namelist()
        assert json.loads(get("RESULT.json"))["fullConsumer"] == "NOT_RUN"
    print(json.dumps({"status": "PASS_RETAINED_WARNINGFREE_ABI_NATIVE_INCOMPLETE", "members": len(delivery["members"]), "exactReversal": True}))

if __name__ == "__main__":
    main()
