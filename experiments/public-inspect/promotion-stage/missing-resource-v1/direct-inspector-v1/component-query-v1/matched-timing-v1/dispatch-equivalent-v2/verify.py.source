"""Verify every portable archive member and complete successful output."""
import hashlib
import json
import pathlib
import zipfile

HERE = pathlib.Path(__file__).resolve().parent


def sha(data):
    return hashlib.sha256(data).hexdigest()


def main():
    delivery = json.loads((HERE / 'DELIVERY.json').read_text())
    assert sha((HERE / 'EVIDENCE.zip').read_bytes()) == delivery['archiveSHA256']
    with zipfile.ZipFile(HERE / 'EVIDENCE.zip') as archive:
        rows = {row['path']: row for row in delivery['members']}
        assert len(rows) == len(delivery['members'])
        assert set(archive.namelist()) == set(rows)
        for name, row in rows.items():
            data = archive.read(name)
            assert len(data) == row['bytes'] and sha(data) == row['sha256'], name
        result = json.loads(archive.read('RESULT.json'))
        for role in result['roles']:
            receipt = archive.read(role['receipt'])
            assert sha(receipt) == role['receiptSHA256']
            observed = json.loads(receipt)
            assert observed['status'] == role['status']
            if role['role'] == 'node':
                assert observed['exit'] == 0 and observed['failure'] is None
                output = archive.read('ctr-take-outline-v1/node/stdout.raw')
                expected = result['oracle']['TS']
            else:
                assert all(c['exit'] == 0 and c['failure'] is None for c in observed['commands'])
                output = archive.read('ctr-take-outline-v1/' + role['role'] + '/consumer.stdout')
                expected = result['oracle']['numeric' if role['role'].startswith('controls/') else 'Bend']
            assert len(output) == expected['bytes'] and sha(output) == expected['sha256']
    report = {'status': 'PASS', 'archiveSHA256': delivery['archiveSHA256'],
              'exactMembers': len(rows), 'completeSuccessfulRoles': len(result['roles']),
              'scope': 'Archive/receipt/full-output joins only; no runtime rerun or general proof.'}
    (HERE / 'VERIFICATION.json').write_text(json.dumps(report, indent=2) + '\n')
    print(json.dumps(report))


if __name__ == '__main__':
    main()
