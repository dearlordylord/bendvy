"""Verify retained regenerated Native evidence without execution."""
from pathlib import Path
import gzip
import hashlib
import json
import zipfile

HERE = Path(__file__).resolve().parent

def sha(raw):
    return hashlib.sha256(raw).hexdigest()

def main():
    d = json.loads((HERE / "DELIVERY.json").read_text())
    assert sha((HERE / "EVIDENCE.zip").read_bytes()) == d["archiveSHA256"]
    with zipfile.ZipFile(HERE / "EVIDENCE.zip") as z:
        assert set(z.namelist()) == {r["path"] for r in d["members"]}
        for row in d["members"]:
            raw = z.read(row["path"])
            assert len(raw) == row["bytes"] and sha(raw) == row["sha256"]
        get = lambda p: z.read("candidate/" + p)
        launch = json.loads(get("LAUNCH.json"))
        assert sha(get("FREEZE.json")) == launch["freezeSHA256"]
        assert sha(get("native01/plan.json")) == launch["order"][0]["sha256"]
        p = json.loads(get("native01/plan.json"))
        r = json.loads(get("native01/receipt.json"))
        assert r["planSHA256"] == launch["order"][0]["sha256"]
        assert not r.get("guardFailures", [])
        assert [c["label"] for c in r["commands"]] == ["emit", "build", "consumer"]
        assert all(c["exit"] == 0 and c["failure"] is None for c in r["commands"])
        for guard in r["guards"]:
            assert sha(get("native01/" + Path(guard["path"]).name)) == guard["sha256"]
        reference = p["provenance"]["derivedCReference"]
        assert get("native01/scenario.c") == z.read("dependencies/" + reference.lstrip("/"))
        assert sha(get("native01/scenario.c")) == p["provenance"]["derivedCSHA256"]
        raw = get("native01/consumer.stdout")
        assert raw == gzip.decompress(z.read("dependencies/" + p["oracle"].lstrip("/")))
        result = json.loads(get("RESULT.json"))
        assert len(raw) == 226096 and sha(raw) == result["fullOutputSHA256"]
        assert sha(get("native01/scenario.native")) == result["binarySHA256"]
        assert sha(get("RESULT.json")) == d["resultSHA256"]
        assert get("native01/build.stderr") == get("native01/consumer.stderr") == b""
    print(json.dumps({"status": "PASS_RETAINED_REGENERATED_SOURCE_NATIVE", "members": len(d["members"])}))

if __name__ == "__main__":
    main()
