"""Verify tiny frontend pair and recompute comparison without compiler."""
from pathlib import Path
import hashlib
import json
import subprocess
import sys
import tempfile
import zipfile

HERE = Path(__file__).resolve().parent

def sha(raw):
    return hashlib.sha256(raw).hexdigest()

def main():
    delivery = json.loads((HERE / "DELIVERY.json").read_text())
    assert sha((HERE / "EVIDENCE.zip").read_bytes()) == delivery["archiveSHA256"]
    with zipfile.ZipFile(HERE / "EVIDENCE.zip") as z:
        assert set(z.namelist()) == {r["path"] for r in delivery["members"]}
        for row in delivery["members"]:
            raw = z.read(row["path"])
            assert len(raw) == row["bytes"] and sha(raw) == row["sha256"]
        get = lambda name: z.read("candidate/" + name)
        launch = json.loads(get("LAUNCH.json"))
        freeze = json.loads(get("FREEZE.json"))
        assert sha(get("FREEZE.json")) == launch["freezeSHA256"]
        assert sha(get("compare-ir.py.source")) == freeze["comparisonScriptSHA256"]
        for item in launch["order"]:
            base = item["role"] + "01/"
            assert sha(get(base + "plan.json")) == item["sha256"]
            r = json.loads(get(base + "receipt.json"))
            assert r["planSHA256"] == item["sha256"]
            assert len(r["commands"]) == 1 and r["commands"][0]["label"] == "build"
            assert r["commands"][0]["exit"] == 0 and r["commands"][0]["failure"] is None
            assert r["commands"][0]["capSeconds"] == 5
            for guard in r["guards"]:
                assert sha(get(base + Path(guard["path"]).name)) == guard["sha256"]
            assert b"linker' input unused" in get(base + "build.stderr")
        with tempfile.TemporaryDirectory(prefix="bendvy-ir-retained-") as directory:
            temp = Path(directory)
            (temp / "compare-ir.py.source").write_bytes(get("compare-ir.py.source"))
            for role in ["named", "unnamed"]:
                (temp / (role + "01")).mkdir()
                (temp / (role + "01") / "frontend.ll").write_bytes(get(role + "01/frontend.ll"))
            subprocess.run([sys.executable, str(temp / "compare-ir.py.source")], check=True, capture_output=True, timeout=5)
            comparison = json.loads((temp / "COMPARISON.json").read_text())
            assert comparison == json.loads(get("COMPARISON.json"))
            assert comparison["status"] == "NO_PROLOGUE_REDUCTION_OBSERVED"
        assert json.loads(get("RESULT.json"))["status"] == "FRONTEND_PAIR_COMPLETE_NO_PROLOGUE_REDUCTION"
    print(json.dumps({"status": "PASS_RETAINED_FRONTEND_PAIR_MECHANISM_REJECTED", "members": len(delivery["members"]), "comparisonRecomputed": True}))

if __name__ == "__main__":
    main()
