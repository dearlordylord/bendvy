#!/usr/bin/python3.11
"""Project-local stock-check/f1a-emission selector; acceptance runner stays unchanged."""
from pathlib import Path
import hashlib
import json
import os
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent

def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def selection():
    config = json.loads((ROOT / "selection.json").read_text())
    for key in ["checker", "bun"]:
        path = Path(config[key])
        if not path.is_file() or sha(path) != config[key + "SHA256"]:
            raise ValueError("Selected tool bytes changed: " + key)
    compiler = ROOT / "compiler"
    actual = {str(p.relative_to(compiler)): sha(p) for p in compiler.rglob("*") if p.is_file()}
    if actual != config["compilerResources"]:
        raise ValueError("Project-local compiler resource membership/bytes changed")
    installed = Path(config["installedBendRoot"])
    actual = {str(p.relative_to(installed)): sha(p) for p in installed.rglob("*") if p.is_file()}
    if actual != config["installedBendResources"]:
        raise ValueError("Installed checker Base/effects resource scope changed")
    relative = Path(config["emitterRelative"])
    if relative != Path("compiler/candidate.mjs"):
        raise ValueError("Emitter must use the recovered project-relative path")
    emitter = ROOT / relative
    if sha(emitter) != config["emitterSHA256"]:
        raise ValueError("Emitter bytes changed")
    return config, emitter

def main():
    config, emitter = selection()
    args = sys.argv[1:]
    if args == ["version"]:
        result = subprocess.run([config["checker"], "version"], capture_output=True)
        sys.stdout.buffer.write(result.stdout)
        sys.stderr.buffer.write(result.stderr)
        if result.returncode:
            return result.returncode
        if result.stdout and not result.stdout.endswith(b"\n"):
            print()
        print("PROJECT_LOCAL_TOOL_SELECTION " + json.dumps({"checkerSHA256": config["checkerSHA256"], "emitterSHA256": config["emitterSHA256"], "bunSHA256": config["bunSHA256"]}, sort_keys=True))
        return 0
    command = [config["checker"], *args] if "--check-only" in args else [config["bun"], str(emitter), *args]
    os.execv(command[0], command)

if __name__ == "__main__":
    raise SystemExit(main())
