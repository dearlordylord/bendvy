"""Verify retained private layout-name candidate evidence without execution."""
from pathlib import Path
import hashlib,json,zipfile
HERE=Path(__file__).resolve().parent
sha=lambda b:hashlib.sha256(b).hexdigest()
def main():
 d=json.loads((HERE/'DELIVERY.json').read_text())
 assert sha((HERE/'EVIDENCE.zip').read_bytes())==d['archiveSHA256']
 with zipfile.ZipFile(HERE/'EVIDENCE.zip') as z:
  assert z.testzip() is None and set(z.namelist())=={r['path'] for r in d['members']}
  for row in d['members']:
   b=z.read(row['path']);assert len(b)==row['bytes'] and sha(b)==row['sha256']
  f=json.loads(z.read('candidate/FREEZE.json'));l=json.loads(z.read('candidate/LAUNCH.json'))
  assert sha(z.read('candidate/FREEZE.json'))==l['freezeSHA256']
  assert f['compilerSHA256']=='f686d14a08a7f1b6621c7d10184f0f9f53bd5e934855272f90a28596d5454a41'
  for item in l['order']:
   rel='candidate/runtime01/'+item['role']+'/plan.json';p=json.loads(z.read(rel));assert sha(z.read(rel))==item['sha256']
   for path,v in p['sourceInventory'].items():
    marker='/world-observer-staged-v1/'
    member='candidate/'+path.split(marker,1)[1] if marker in path else 'dependencies/'+path.lstrip('/')
    assert sha(z.read(member))==v
  j=json.loads(z.read('candidate/runtime01/js/receipt.json'));n=json.loads(z.read('candidate/runtime01/native/receipt.json'))
  assert j['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS'
  assert sha(z.read('candidate/runtime01/js/consumer.stdout'))==j['wholeOracleSHA256']=='fea8df01c26bf7141798bd2b45b4e4139e5bbe2b54af9c53674117be662245a9'
  assert len(z.read('candidate/runtime01/js/consumer.stdout'))==226096
  assert n['status']=='INCOMPLETE' and not n['guardFailures']
  assert n['commands'][0]['exit'] is None and n['commands'][0]['failure']=='child deadline'
  assert 'candidate/runtime01/native/scenario.c' not in z.namelist()
  c=json.loads(z.read('candidate/source-check03/receipt.json'));assert c['exit']==0 and not c['inputDrift']
  i=json.loads(z.read('candidate/IDENTITY.json'));assert i['renderExpressionByteIdentical'] and i['changedFiles']==['world-observer.bend']
 print(json.dumps({'status':'PASS_RETAINED_PARTIAL_CANDIDATE','members':len(d['members']),'JS':'PASS','Native':'INCOMPLETE'}))
if __name__=='__main__':main()
