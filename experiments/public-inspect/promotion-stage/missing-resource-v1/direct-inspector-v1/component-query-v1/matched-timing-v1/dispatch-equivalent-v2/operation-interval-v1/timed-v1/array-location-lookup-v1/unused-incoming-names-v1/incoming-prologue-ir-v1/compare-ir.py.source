"""Compare tiny retained frontend IR; instruction counts are not timings."""
from collections import Counter
from pathlib import Path
import hashlib
import json
import re

HERE = Path(__file__).resolve().parent

def inspect(path):
    functions = {}
    active = None
    for line in path.read_text().splitlines():
        if line.startswith("define "):
            name = re.search(r"@([A-Za-z_][A-Za-z_0-9]*)\(", line).group(1)
            active = {"opcodes": Counter(), "scalarArgumentStores": 0, "instructions": []}
            args = set(re.findall(r"%([A-Za-z_0-9.]+)", line.split("(", 1)[1].split(")", 1)[0]))
            functions[name] = active
        elif active is not None and line == "}":
            active["instructionSHA256"] = hashlib.sha256("\n".join(active.pop("instructions")).encode()).hexdigest()
            active["opcodes"] = dict(sorted(active["opcodes"].items()))
            active = None
        elif active is not None:
            text = line.strip()
            text = re.sub(r"^%[^ ]+ = ", "", text)
            match = re.match(r"(?:musttail |tail |notail )?([a-z][a-z0-9_]*)\b", text)
            if not match:
                continue
            active["opcodes"][match.group(1)] += 1
            active["instructions"].append(line)
            store = re.match(r"store (?:i\d+|ptr|float|double) %([A-Za-z_0-9.]+),", text)
            if store and store.group(1) in args:
                active["scalarArgumentStores"] += 1
    for name in ["direct", "frame", "bridge"]:
        assert name in functions
    return {name: functions[name] for name in ["direct", "frame", "bridge"]}

def main():
    rows = {role: inspect(HERE / (role + "01") / "frontend.ll") for role in ["named", "unnamed"]}
    equal = all(rows["named"][name]["opcodes"].get("alloca", 0) == rows["unnamed"][name]["opcodes"].get("alloca", 0)
                and rows["named"][name]["scalarArgumentStores"] == rows["unnamed"][name]["scalarArgumentStores"]
                for name in ["direct", "frame"])
    result = {"status": "NO_PROLOGUE_REDUCTION_OBSERVED" if equal else "PROLOGUE_DIFFERENCE_OBSERVED",
              "functions": rows, "scope": "Finite tiny frontend noLLVMpasses pair; no full-world equivalence, cause, CPU timing, speed or Native acceptance claim."}
    (HERE / "COMPARISON.json").write_text(json.dumps(result, indent=2) + "\n")
    print(json.dumps(result))

if __name__ == "__main__":
    main()
