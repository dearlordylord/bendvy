const fs=require('fs'),vm=require('vm'),assert=require('assert'),crypto=require('crypto');
const prefix='/workspace/formal-proofs/bendvy-worktrees/observable-query-boundaries/experiments/public-inspect/promotion-stage/missing-resource-v1/direct-inspector-v1/component-query-v1/matched-timing-v1/dispatch-equivalent-v2/';
function load(file){let s=fs.readFileSync(file,'utf8'); const hash=crypto.createHash('sha256').update(s).digest('hex');s=s.replace(/^#!.*\n/,'').replace(/^import \* as (\w+) from "([^"]+)";$/gm,(_,n,m)=>`var ${n}=require(${JSON.stringify(m)});`).replaceAll('import.meta.url',JSON.stringify('file://'+file)).replaceAll('import.meta.require','require');const end=s.lastIndexOf('\nif (true) {');assert(end>0);s=s.slice(0,end);const c=vm.createContext({require,process,console,Buffer,URL,setTimeout,clearTimeout});vm.runInContext(s,c,{timeout:2000});return{c,hash};}
const results=[];
for(const width of [1,15,16,31]){const runs=[];for(const kind of ['old','new']){const file=prefix+'operation-interval-v1/timed-v1/'+(kind==='old'?'direct-recursive-box-v1':'inline-layout-15-v1')+'/compiler/candidate.mjs';const {c,hash}=load(file);const value=vm.runInContext(`(()=>{TELES.clear();LAYS.clear();const T={};const book={tlds:{Tuple:{$:'ADT',c:[{T,n:${width},k:'Tuple.make'}]}},ctrs:{}};TELES.set(T,{doms:Array.from({length:${width}},(_,i)=>[{$:'Many'},'f'+i,ADT('U32',[])])});const lay=lay_of(book,ADT('Tuple',[]));return{box:lay===BOX,width:lay.ks.length,word:lay_of(book,ADT('U32',[]))===W32,fn:lay_of(book,All({$:'Many'},'x',0,Typ(0),()=>Typ(0)))===BOX};})()`,c,{timeout:1000});assert(value.word&&value.fn);assert.equal(value.box,kind==='new'&&width>15);assert.equal(value.width,kind==='new'&&width>15?1:width);runs.push({kind,hash,...value});}results.push({width,runs});}
const old=fs.readFileSync(prefix+'operation-interval-v1/timed-v1/direct-recursive-box-v1/compiler/candidate.mjs','utf8');const next=fs.readFileSync(prefix+'operation-interval-v1/timed-v1/inline-layout-15-v1/compiler/candidate.mjs','utf8');assert.equal(next.replace('var INLINE_LAYOUT_LIMIT = 15;','var INLINE_LAYOUT_LIMIT = 31;'),old);
console.log(JSON.stringify({status:'PASS',scope:'Actual compiler lay_of/layout boundary and exact single-literal reversal, not semantic consumer proof',cases:results},null,2));
