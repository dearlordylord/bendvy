"""Verify retained ordinary-wrapper pipeline; no compiler or consumer execution."""
from pathlib import Path
import gzip
import hashlib
import json
import zipfile
HERE = Path(__file__).resolve().parent
sha = lambda data: hashlib.sha256(data).hexdigest()
def main():
    d = json.loads((HERE / "DELIVERY.json").read_text())
    assert sha((HERE / "EVIDENCE.zip").read_bytes()) == d["archiveSHA256"]
    with zipfile.ZipFile(HERE / "EVIDENCE.zip") as z:
        assert set(z.namelist()) == {row["path"] for row in d["members"]}
        for row in d["members"]:
            raw = z.read(row["path"])
            assert len(raw) == row["bytes"] and sha(raw) == row["sha256"]
        get = lambda name: z.read("candidate/" + name)
        p = json.loads(get("full-js/plan.json"))
        r = json.loads(get("full-js/receipt.json"))
        launch = json.loads(get("LAUNCH.json"))
        assert sha(get("FREEZE.json")) == launch["freezeSHA256"]
        assert sha(get("full-js/plan.json")) == launch["planSHA256"] == r["planSHA256"]
        assert r["status"] == "COMPLETE_CONSUMER_DEVELOPMENT_PASS" and not r.get("guardFailures", [])
        assert len(r["commands"]) == len(p["commands"]) == 4 and len(p["sourceInventory"]) == 63
        for actual, expected in zip(r["commands"], p["commands"]):
            assert actual["argv"] == expected["argv"] and actual["exit"] == 0 and actual["failure"] is None
            for stream in ["stdout", "stderr"]:
                raw = get("full-js/" + actual["label"] + "." + stream)
                assert len(raw) == actual[stream]["bytes"] and sha(raw) == actual[stream]["sha256"]
            assert get("full-js/" + actual["label"] + ".stderr") == b""
        config = json.loads(get("project/selection.json"))
        lines = get("full-js/source-wrapper-version.stdout").decode().splitlines()
        assert lines[0] == "bend 2.0.35"
        assert json.loads(lines[1].removeprefix("PROJECT_LOCAL_TOOL_SELECTION ")) == {key: config[key] for key in ["checkerSHA256", "emitterSHA256", "bunSHA256"]}
        raw = get("full-js/consumer.stdout")
        assert len(raw) == p["oracleBytes"] == 226096 and sha(raw) == p["oracleSHA256"] == r["wholeOracleSHA256"]
        assert raw == gzip.decompress(z.read("dependencies/" + p["oracle"].lstrip("/")))
        for guard in r["guards"]:
            raw = get("full-js/" + Path(guard["path"]).name)
            assert sha(raw) == guard["sha256"] and json.loads(raw)["unchanged"]
        for relative, digest in config["compilerResources"].items():
            assert sha(get("project/compiler/" + relative)) == digest
        assert z.getinfo("candidate/project/bin/bend").external_attr >> 16 == 0o100755
        assert sha(get("RESULT.json")) == d["resultSHA256"]
    print(json.dumps({"status": "PASS_RETAINED_ORDINARY_WRAPPER_FULL_JS", "members": len(d["members"])}))
if __name__ == "__main__":
    main()
