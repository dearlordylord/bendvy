import os,json,time,pathlib
root=pathlib.Path('/proc'); target='/direct-recursive-box-v1/runtime01/native/scenario.c'; hz=os.sysconf('SC_CLK_TCK');uptime=float((root/'uptime').read_text().split()[0]);rows=[]
for p in root.iterdir():
 if not p.name.isdigit():continue
 try:
  comm=(p/'comm').read_text().strip()
  if not comm.startswith('clang'):continue
  args=(p/'cmdline').read_bytes().split(b'\0')
  if not any(target in a.decode(errors='replace') for a in args):continue
  raw=(p/'stat').read_text();fields=raw[raw.rindex(')')+2:].split();rows.append({'pid':int(p.name),'ppid':int(fields[1]),'comm':comm,'state':fields[0],'startTicks':int(fields[19]),'userSeconds':int(fields[11])/hz,'systemSeconds':int(fields[12])/hz,'elapsedSeconds':uptime-int(fields[19])/hz})
 except (FileNotFoundError,ProcessLookupError,PermissionError):continue
r={'observedUtc':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime()),'clockTicksPerSecond':hz,'scope':'live process CPU observation only; not complete compilation CPU or hotspot attribution','processes':rows}
p=pathlib.Path('/tmp/bendvy54-clang-cpu-observations.jsonl')
with p.open('a') as f:f.write(json.dumps(r)+'\n')
print(json.dumps(r))
