"""Verify retained dispatch metadata only; executes no selected tool."""
from pathlib import Path
import gzip
import hashlib
import json
import zipfile
HERE = Path(__file__).resolve().parent
sha = lambda data: hashlib.sha256(data).hexdigest()
def main():
    d = json.loads((HERE / "DELIVERY.json").read_text())
    assert sha((HERE / "EVIDENCE.zip").read_bytes()) == d["archiveSHA256"]
    with zipfile.ZipFile(HERE / "EVIDENCE.zip") as z:
        assert set(z.namelist()) == {row["path"] for row in d["members"]}
        for row in d["members"]:
            raw = z.read(row["path"])
            assert len(raw) == row["bytes"] and sha(raw) == row["sha256"]
        get = lambda name: z.read("candidate/" + name)
        p = json.loads(get("proposal01/plan.json"))
        r = json.loads(get("control01/receipt.json"))
        assert r["planSHA256"] == sha(get("proposal01/plan.json"))
        assert r["status"] == "COMPLETE_CONSUMER_DEVELOPMENT_PASS" and not r.get("guardFailures", [])
        assert len(r["commands"]) == 1
        row = r["commands"][0]
        assert row["exit"] == 0 and row["failure"] is None
        raw = get("control01/wrapper-selection-control.stdout")
        assert raw == gzip.decompress(get("expected.txt.gz")) and len(raw) == p["oracleBytes"] == 344
        assert sha(raw) == p["oracleSHA256"] == row["stdout"]["sha256"]
        assert json.loads(raw)["actualToolExecutions"] == 0
        assert get("control01/wrapper-selection-control.stderr") == b""
        for guard in r["guards"]:
            raw = get("control01/" + Path(guard["path"]).name)
            assert sha(raw) == guard["sha256"] and json.loads(raw)["unchanged"]
        for path, digest in p["pins"].items():
            name = "dependencies/" + path.lstrip("/")
            if name in z.namelist():
                assert sha(z.read(name)) == digest
        assert sha(get("RESULT.json")) == d["resultSHA256"]
    print(json.dumps({"status": "PASS_RETAINED_DISPATCH_METADATA_ONLY", "members": len(d["members"])}))
if __name__ == "__main__":
    main()
