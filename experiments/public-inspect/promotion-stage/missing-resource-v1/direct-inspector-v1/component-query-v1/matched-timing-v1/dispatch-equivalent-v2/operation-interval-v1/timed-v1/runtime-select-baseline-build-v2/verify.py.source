"""Verify the retained bounded diagnostics without rebuilding anything."""
from pathlib import Path
import hashlib,json,zipfile
HERE=Path(__file__).resolve().parent
sha=lambda raw:hashlib.sha256(raw).hexdigest()
def main():
 delivery=json.loads((HERE/'DELIVERY.json').read_text())
 assert sha((HERE/'EVIDENCE.zip').read_bytes())==delivery['archiveSHA256']
 with zipfile.ZipFile(HERE/'EVIDENCE.zip') as archive:
  assert archive.testzip() is None
  assert sorted(archive.namelist())==sorted(row['path'] for row in delivery['members'])
  for row in delivery['members']:
   raw=archive.read(row['path']);assert len(raw)==row['bytes'] and sha(raw)==row['sha256']
  result=json.loads(archive.read('baseline/RESULT.json'))
  assert result['status']=='INCOMPLETE_BASELINE_BUILD_DEADLINE'
  assert result['child']['failure']=='child deadline' and result['child']['exit'] is None
  assert not result['freshBinaryExists'] and not result['guardFailures']
  assert all(row['matches'] for row in result['guards'])
  receipt=json.loads(archive.read('baseline/receipt.json'))
  assert receipt['status']=='INCOMPLETE' and len(receipt['commands'])==1
  stack=json.loads(archive.read('current-o3/RESULT.json'))
  assert stack['status']=='INCOMPLETE_DIAGNOSTIC_TRACE_RETAINED' and stack['sampledFunction'] is None
  assert stack['failure']=='child left owned descendants; no passing result'
  assert 'llvm::BasicAAResult::invalidate' in archive.read('current-o3/source-clang-standard-o3-stack.stderr').decode()
 print(json.dumps({'status':'PASS','members':len(delivery['members']),'scope':'Retained evidence only;no Native/consumer acceptance.'}))
if __name__=='__main__':main()
