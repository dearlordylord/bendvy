"""Verify retained LLVM pass-log diagnostic without executing its subject."""
from pathlib import Path
import hashlib,json,zipfile
HERE=Path(__file__).resolve().parent
sha=lambda b:hashlib.sha256(b).hexdigest()
def main():
 d=json.loads((HERE/'DELIVERY.json').read_text());assert sha((HERE/'EVIDENCE.zip').read_bytes())==d['archiveSHA256']
 with zipfile.ZipFile(HERE/'EVIDENCE.zip') as z:
  assert set(z.namelist())=={r['path'] for r in d['members']}
  for row in d['members']:
   h=hashlib.sha256();count=0
   with z.open(row['path']) as stream:
    while chunk:=stream.read(1024*1024):h.update(chunk);count+=len(chunk)
   assert count==row['bytes'] and h.hexdigest()==row['sha256']
  p=json.loads(z.read('diagnostic/plan.json'));f=json.loads(z.read('diagnostic/FREEZE.json'));l=json.loads(z.read('diagnostic/LAUNCH.json'));r=json.loads(z.read('diagnostic/receipt.json'))
  assert sha(z.read('diagnostic/plan.json'))==f['planSHA256']==l['planSHA256']==r['planSHA256']
  assert sha(z.read('diagnostic/FREEZE.json'))==l['freezeSHA256']
  assert len(p['commands'])==len(r['commands'])==1 and p['commands'][0]['label']=='build'
  assert '-fdebug-pass-manager' in p['commands'][0]['argv']
  assert r['status']=='INCOMPLETE' and not r['guardFailures']
  assert r['commands'][0]['exit'] is None and r['commands'][0]['failure']=='child deadline'
  raw=z.read('diagnostic/build.stderr');assert len(raw)==70136619 and sha(raw)==r['commands'][0]['stderr']['sha256']
  assert raw.rstrip().endswith(b'INSPECTOR_QUERY_EACH_COMPOSED_41_K11539 (178 instructions)')
  assert b'Running pass: MemCpyOptPass' in raw[-1000:]
  assert sha(z.read('dependencies/'+p['entrypoint'].lstrip('/')))==p['provenance']['currentCSHA256']=='728e8ab7f81998ce383aa5827a8a4deae4394d4c50509bbe628170acf7fd59f9'
  assert 'diagnostic/diagnostic.native' not in z.namelist()
 print(json.dumps({'status':'PASS_RETAINED_PASS_TRACE_ONLY','members':len(d['members']),'Native':'INCOMPLETE'}))
if __name__=='__main__':main()
