"""Verify private lookup candidate evidence without compiler execution."""
from pathlib import Path
import hashlib,json,re,zipfile
HERE=Path(__file__).resolve().parent
sha=lambda b:hashlib.sha256(b).hexdigest()
def main():
 d=json.loads((HERE/'DELIVERY.json').read_text());assert sha((HERE/'EVIDENCE.zip').read_bytes())==d['archiveSHA256']
 with zipfile.ZipFile(HERE/'EVIDENCE.zip') as z:
  assert set(z.namelist())=={r['path'] for r in d['members']}
  for row in d['members']:
   b=z.read(row['path']);assert len(b)==row['bytes'] and sha(b)==row['sha256']
  f=json.loads(z.read('candidate/FREEZE.json'));l=json.loads(z.read('candidate/LAUNCH.json'));assert sha(z.read('candidate/FREEZE.json'))==l['freezeSHA256']
  assert sha(z.read('candidate/compiler/candidate.mjs'))==f['candidateSHA256']
  for item in l['order']:
   rel='candidate/'+str(Path(item['plan']).parent).split('/array-location-lookup-v1/',1)[1]+'/plan.json'
   assert sha(z.read(rel))==item['sha256']
  for role in ['control-host01','control-device01']:
   r=json.loads(z.read('candidate/'+role+'/receipt.json'));assert all(c['exit']==0 and c['failure'] is None for c in r['commands'])
   assert z.read('candidate/'+role+'/consumer.stdout')==b'PASS 48\n'
  r=json.loads(z.read('candidate/runtime01/receipt.json'));assert r['status']=='INCOMPLETE' and not r['guardFailures']
  assert len(r['commands'])==1 and r['commands'][0]['exit'] is None and r['commands'][0]['failure']=='child deadline'
  assert 'candidate/runtime01/scenario.native' not in z.namelist()
  derv=json.loads(z.read('candidate/DERIVATION.json'));raw=z.read('candidate/runtime01/derived.c');assert sha(raw)==derv['derivedSHA256']==f['derivedCSHA256']
  text=raw.decode();helper=z.read('candidate/helper.c.source').decode();assert text.count(helper)==1;text=text.replace(helper,'',1)
  pattern=re.compile(r'WL_ARRAY_LOCATION\((?P<a>[A-Za-z_][A-Za-z0-9_]*), \(\(Term\[\]\)\{[^}]*\}\), \(\(u64\[\]\)\{[^}]*\}\), \d+, \((?P<old>[^()]+blk_loc\(e.mem, (?P=a)\))\)\)')
  original,count=pattern.subn(lambda m:m.group('old'),text);assert count==6114 and sha(original.encode())==derv['originalSHA256']=='47860766951e7f10329e7512dc40b06d8de1aeb16a4539d09ebace652564f2f9'
 print(json.dumps({'status':'PASS_RETAINED_HELPER_CONTROLS_NATIVE_INCOMPLETE','members':len(d['members']),'reversibleC':True}))
if __name__=='__main__':main()
