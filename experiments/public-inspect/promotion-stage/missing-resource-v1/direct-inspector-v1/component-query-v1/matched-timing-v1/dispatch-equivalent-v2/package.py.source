"""Retain this completed correctness chain using the existing ZIP/member convention."""
import hashlib
import json
import pathlib
import subprocess
import zipfile

HERE = pathlib.Path(__file__).resolve().parent
ROOT = pathlib.Path('/workspace/formal-proofs/bendvy')


def sha(data):
    return hashlib.sha256(data).hexdigest()


def main():
    contents = {}
    excluded = {'EVIDENCE.zip', 'DELIVERY.json', 'VERIFICATION.json', 'OWNED-MANIFEST.json'}
    for path in sorted(HERE.rglob('*')):
        if not path.is_file() or path.name in excluded:
            continue
        if '__pycache__' in path.parts or '.private.' in path.name:
            continue
        contents[path.relative_to(HERE).as_posix()] = path.read_bytes()

    freeze = json.loads((HERE / 'FREEZE.json').read_text())
    for field in ('sourceInventory', 'tsApplicationInputs', 'tsPublicReferenceInventory'):
        for name, expected in freeze[field].items():
            path = pathlib.Path(name)
            data = path.read_bytes()
            assert sha(data) == expected, name
            contents['dependencies/source/' + name.lstrip('/')] = data

    numeric = HERE.parent / 'word-match-repair-v1' / 'controls'
    for name in ('main.bend', 'derive.py.source', 'EXPECTED.json', 'expected.stdout.gz'):
        contents['dependencies/numeric/' + name] = (numeric / name).read_bytes()

    tool_paths = [
        ROOT / 'scripts/task_runner.py',
        ROOT / 'scripts/evidence_boundary.py',
        ROOT / 'experiments/public-inspect/ordinary-declaration-v1/canonical-full-consumer-v1/development-v2.py',
        ROOT / 'experiments/public-inspect/promotion-stage/component-query-v1/reference-runner.py',
        ROOT / 'experiments/public-inspect/promotion-stage/component-query-v1/evidence-boundary.py',
        ROOT / 'experiments/public-decode/public-seam-v1/construction-v1/qualification-v1/application32-v1/timing-alignment-v1/native-resume-v1/current-source-plan-v1/guarded-run-v2/guarded-collector.py',
    ]
    for path in tool_paths:
        contents['dependencies/tools/' + path.relative_to(ROOT).as_posix()] = path.read_bytes()

    # Preserve governing prose at each plan's actual hash, including historical bindings.
    unresolved = []
    revisions = ('83a6593bc', '1d947c55f', 'd808b0944', 'a13d06f12', '5ee30213c')
    for path in sorted(HERE.rglob('*.json')):
        if path.name in excluded or '.private.' in path.name:
            continue
        value = json.loads(path.read_text())
        for field in ('pins', 'inputs'):
            for name, expected in value.get(field, {}).items():
                source = pathlib.Path(name)
                if not isinstance(expected, str) or source.suffix != '.md':
                    continue
                data = source.read_bytes() if source.is_file() else b''
                if sha(data) != expected and source.is_relative_to(ROOT):
                    relative = source.relative_to(ROOT).as_posix()
                    for revision in revisions:
                        found = subprocess.run(['git', '-C', str(ROOT), 'show', revision + ':' + relative],
                                               capture_output=True, check=False)
                        if found.returncode == 0 and sha(found.stdout) == expected:
                            data = found.stdout
                            break
                if sha(data) == expected:
                    contents['dependencies/governing/' + expected + '/' + source.name] = data
                else:
                    unresolved.append({'path': name, 'sha256': expected})
    assert not unresolved, unresolved

    # These are the already source-reviewed primary bodies, not newly fetched revisions.
    old = HERE.parent.parent / 'compiler-candidate-v1/layout-equality-v1/graph-index-v1/native-backend-stack-diagnostic-v1'
    for name in ('InitLLVM.cpp.source', 'Signals.inc.source', 'CrashRecoveryContext.cpp.source',
                 'clang-driver-CMakeLists.txt.source', 'llvm-driver-template.cpp.in.source',
                 'timeout.c.source', 'timeout-help.stdout.source'):
        contents['dependencies/signal-audit/' + name] = (old / name).read_bytes()

    members = []
    with zipfile.ZipFile(HERE / 'EVIDENCE.zip', 'w', zipfile.ZIP_DEFLATED, compresslevel=6) as archive:
        for name, data in sorted(contents.items()):
            archive.writestr(name, data)
            members.append({'path': name, 'bytes': len(data), 'sha256': sha(data)})
    delivery = {
        'status': 'COMPLETE_DISPATCH_EQUIVALENT_APPLICATION_JS_NATIVE_TS_AND_NUMERIC_CONTROLS_PASS',
        'archiveSHA256': sha((HERE / 'EVIDENCE.zip').read_bytes()),
        'members': members,
        'verification': 'Run python3 verify.py.source; inspect RESULT.json and each whole-output receipt. Private environment bytes and installed tool binaries are excluded; their exact hashes/resource maps remain in frozen plans.',
    }
    (HERE / 'DELIVERY.json').write_text(json.dumps(delivery, indent=2) + '\n')
    print(json.dumps({'archiveSHA256': delivery['archiveSHA256'], 'members': len(members)}))


if __name__ == '__main__':
    main()
