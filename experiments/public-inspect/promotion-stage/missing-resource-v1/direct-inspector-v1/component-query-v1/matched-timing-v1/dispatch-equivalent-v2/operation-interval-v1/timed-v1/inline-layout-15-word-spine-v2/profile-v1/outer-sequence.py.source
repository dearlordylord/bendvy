"""Existing profile outer orchestration adapted to read-only current source; collector owns Native child."""
from pathlib import Path
import fcntl,hashlib,json,subprocess,sys,time,signal,importlib.util
sys.dont_write_bytecode=True
HERE=Path(__file__).resolve().parent
ROOT=Path('/workspace/formal-proofs/bendvy')
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
CONFIG=HERE/'OUTER-PLAN.json'
def main():
 config=json.loads(CONFIG.read_text())
 actual_python=Path(sys.executable).resolve(strict=True)
 assert str(actual_python)==config['python'] and sha(actual_python)==config['pins'][str(actual_python)], 'executing interpreter differs'
 spec=importlib.util.spec_from_file_location('profile_boundary',ROOT/'scripts/evidence_boundary.py');boundary=importlib.util.module_from_spec(spec);spec.loader.exec_module(boundary)
 record={'planSHA256':sha(CONFIG),'commands':[],'status':'INCOMPLETE','scope':'CPU sampling only, no Native acceptance or performance claim; no source activation.'}
 out=HERE/'outer01';out.mkdir(exist_ok=False)
 def guard():
  assert all(sha(p)==h for p,h in config['pins'].items()), 'frozen input changed'
 def command(label,argv):
  started=time.monotonic()
  with (out/(label+'.stdout')).open('xb') as stdout,(out/(label+'.stderr')).open('xb') as stderr:
   result=subprocess.run(argv,stdout=stdout,stderr=stderr)
  row={'label':label,'argv':argv,'exit':result.returncode,'elapsedSeconds':time.monotonic()-started}
  for key in ['stdout','stderr']:
   q=out/(label+'.'+key);row[key]={'path':str(q),'sha256':sha(q),'bytes':q.stat().st_size}
  record['commands'].append(row);return result.returncode
 def stop(signum,frame):raise RuntimeError('outer interrupted by signal '+str(signum))
 signal.signal(signal.SIGTERM,stop)
 with open(config['outerLock'],'a') as lock:
  fcntl.flock(lock,fcntl.LOCK_EX)
  with boundary.ReceiptBoundary(record,out/'receipt.json',[('source/tool/plan immutability',guard)]):
   try:
    guard()
    role=config['role'];role_plan=json.loads(Path(role['plan']).read_text());profile=role_plan['diagnosticCPUProfile'];profile_path=Path(profile['path'])
    assert not profile_path.exists() and not profile_path.is_symlink(), 'CPU profile output already exists'
    record['profileFreshness']={'path':str(profile_path),'allAbsentBeforeExecution':True}
    record['collectorExit']=command('native-collector',role['execute'])
    receipt_path=Path(role_plan['output'])/'receipt.json'
    if receipt_path.is_file():
     receipt=json.loads(receipt_path.read_text());record['roleReceipt']={'path':str(receipt_path),'sha256':sha(receipt_path),'status':receipt['status'],'commands':receipt['commands']}
   except BaseException as error:
    record['error']=type(error).__name__+': '+str(error)
   finally:
    # Read-only source: postguard first, then retained profile validation; no restoration required.
    try:guard();record['sourceInputsUnchanged']=True
    except BaseException as error:record['sourceInputsUnchanged']=False;record['postguardError']=type(error).__name__+': '+str(error)
    result={'role':'native','status':'PROFILE_INVALID'}
    try:
     role_plan=json.loads(Path(config['role']['plan']).read_text());profile=role_plan['diagnosticCPUProfile'];profile_path=Path(profile['path'])
     result.update(path=str(profile_path),status='PROFILE_MISSING')
     if profile_path.exists() or profile_path.is_symlink():
      assert profile_path.is_file() and not profile_path.is_symlink(), 'profile must be regular nonsymlink file'
      raw=profile_path.read_bytes()
      result.update(bytes=len(raw),profileSHA256=hashlib.sha256(raw).hexdigest())
      data=json.loads(raw)
      nodes=data['nodes'];samples=data['samples'];deltas=data['timeDeltas']
      assert isinstance(nodes,list) and isinstance(samples,list) and isinstance(deltas,list)
      assert len(nodes)>0 and len(samples)>0 and len(samples)==len(deltas), 'nonempty matching samples/timeDeltas required'
      ids={node['id'] for node in nodes}
      assert len(ids)==len(nodes) and all(sample in ids for sample in samples), 'sample node IDs invalid'
      assert all(isinstance(delta,(int,float)) and delta>=0 for delta in deltas), 'sample deltas invalid'
      result.update(status='PROFILE_RETAINED_VALID',nodeCount=len(nodes),sampleCount=len(samples),timeDeltaCount=len(deltas),sampledMicroseconds=sum(deltas),startTime=data.get('startTime'),endTime=data.get('endTime'))
    except Exception as error:
     result.update(status='PROFILE_INVALID',error=type(error).__name__+': '+str(error))
    record['diagnosticCPUProfiles']=[result]
    record['diagnosticOutcome']=result['status']
    record['status']='INCOMPLETE'  # Cooperative exit77/deadline is never a compiler or consumer PASS.
 print(json.dumps(record,indent=2))
 return 1
if __name__=='__main__':sys.exit(main())
