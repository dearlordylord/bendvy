"""Verify retained canonical refusals and preflight history without execution."""
from pathlib import Path
import hashlib
import json
import zipfile

HERE = Path(__file__).resolve().parent

def sha(raw):
    return hashlib.sha256(raw).hexdigest()

def main():
    d = json.loads((HERE / "DELIVERY.json").read_text())
    assert sha((HERE / "EVIDENCE.zip").read_bytes()) == d["archiveSHA256"]
    with zipfile.ZipFile(HERE / "EVIDENCE.zip") as z:
        assert set(z.namelist()) == {r["path"] for r in d["members"]}
        for row in d["members"]:
            raw = z.read(row["path"])
            assert len(raw) == row["bytes"] and sha(raw) == row["sha256"]
        get = lambda p: z.read("candidate/" + p)
        old = json.loads(get("source01/receipt.json"))
        assert old["status"] == "INCOMPLETE" and old["commands"] == []
        launch = json.loads(get("import-inventory-v2/LAUNCH.json"))
        assert sha(get("import-inventory-v2/FREEZE.json")) == launch["freezeSHA256"]
        assert sha(get("import-inventory-v2/source02/plan.json")) == launch["planSHA256"]
        p = json.loads(get("import-inventory-v2/source02/plan.json"))
        r = json.loads(get("import-inventory-v2/source02/receipt.json"))
        assert len(p["sourceInventory"]) == 19
        assert r["status"] == "COMPLETE_SOURCE_CONTROL_PASS" and not r.get("guardFailures", [])
        assert len(r["commands"]) == 2
        for a, e in zip(r["commands"], p["commands"]):
            assert a["exit"] == e["expectedExit"] == 1 and a["failure"] is None
            stderr = get("import-inventory-v2/source02/" + a["label"] + ".stderr").decode()
            assert all(pattern in stderr for pattern in e["stderrContains"])
            for stream in ["stdout", "stderr"]:
                assert sha(get("import-inventory-v2/source02/" + a["label"] + "." + stream)) == a[stream]["sha256"]
        for guard in r["guards"]:
            assert sha(get("import-inventory-v2/source02/" + Path(guard["path"]).name)) == guard["sha256"]
        assert sha(get("RESULT.json")) == d["resultSHA256"]
    print(json.dumps({"status": "PASS_RETAINED_TWO_CANONICAL_F1A_REFUSALS", "members": len(d["members"])}))

if __name__ == "__main__":
    main()
