"""Verify the portable cohort, complete retained outputs and unchanged statistics."""
import gzip
import hashlib
import json
from pathlib import Path
import zipfile

HERE = Path(__file__).resolve().parent


def sha(data):
    return hashlib.sha256(data).hexdigest()


def main():
    delivery = json.loads((HERE / 'DELIVERY.json').read_text())
    assert sha((HERE / 'EVIDENCE.zip').read_bytes()) == delivery['archiveSHA256']
    with zipfile.ZipFile(HERE / 'EVIDENCE.zip') as archive:
        rows = {row['path']: row for row in delivery['members']}
        assert len(rows) == len(delivery['members']) and set(archive.namelist()) == set(rows)
        for name, row in rows.items():
            data = archive.read(name)
            assert len(data) == row['bytes'] and sha(data) == row['sha256'], name
        outer = json.loads(archive.read('receipt.json'))
        cohort_bytes = archive.read('cohort/receipt.json')
        cohort = json.loads(cohort_bytes)
        assert sha(cohort_bytes) == outer['benchmarkReceiptSHA256']
        assert outer['status'] == 'UNCHANGED_BENCHMARK_NO_CONFIRMED_REGRESSION'
        assert cohort['status'] == 'NO_CONFIRMED_REGRESSION'
        assert cohort['contract']['pairs'] == 20 and cohort['contract']['alpha'] == 0.05
        assert all(command['exit'] == 0 for command in cohort['commands'])
        assert len(cohort['timings']) == 20
        for backend in ('JS', 'Native'):
            assert sum(pair['backend'] == backend for pair in cohort['pairs']) == 20
            assert not cohort['endpoints'][backend]['confirmedRegression']
        # Every gzip stream is decompressed, including warmups and timed full output.
        compressed = [name for name in rows if name.startswith('cohort/') and name.endswith('.gz')]
        expected = json.loads(archive.read('cohort/baseline/examples/query-composition/expected.json'))
        expected['checkpoints'] = [row for row in expected['checkpoints']
                                   if row['label'] != 'foreign-collision-reference']
        observed_applications = 0
        for name in compressed:
            raw = gzip.decompress(archive.read(name))
            if '/pair-' in name or '/warmup-' in name:
                lines = raw.decode('utf8').splitlines()
                assert len(lines) == cohort['contract']['iterations']
                assert all(json.loads(line) == expected for line in lines), name
                observed_applications += len(lines)
    report = {'status': 'PASS', 'archiveSHA256': delivery['archiveSHA256'],
              'exactMembers': len(rows), 'pairsPerBackend': 20,
              'decompressedStreams': len(compressed),
              'completeApplicationsCompared': observed_applications,
              'scope': 'Archive/statistical receipt joins only; no new criterion or runtime rerun.'}
    (HERE / 'VERIFICATION.json').write_text(json.dumps(report, indent=2) + '\n')
    print(json.dumps(report))


if __name__ == '__main__':
    main()
