#!/usr/bin/python3.11
"""Finite selector controls: no Bend/Bun/compiler subprocess is executed."""
import contextlib
import hashlib
import importlib.machinery
import importlib.util
import io
import json
from pathlib import Path
import shutil
import sys
import tempfile
from types import SimpleNamespace
from unittest.mock import patch
import zipfile

wrapper, selection_path = map(Path, sys.argv[1:])
config = json.loads(selection_path.read_text())
sha = lambda data: hashlib.sha256(data).hexdigest()
archive = Path(config["materializationArchive"])
assert sha(archive.read_bytes()) == config["materializationArchiveSHA256"]
results = []
with tempfile.TemporaryDirectory(prefix="bendvy-dispatch-control-") as temporary:
    root = Path(temporary)
    (root / "bin").mkdir()
    shutil.copyfile(wrapper, root / "bin/bend")
    with zipfile.ZipFile(archive) as bundle:
        prefix = config["materializationCompilerPrefix"]
        selected = {n[len(prefix):]: n for n in bundle.namelist() if n.startswith(prefix) and not n.endswith("/")}
        assert set(selected) == set(config["compilerResources"])
        for relative, member in selected.items():
            data = bundle.read(member)
            assert sha(data) == config["compilerResources"][relative]
            target = root / "compiler" / relative
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(data)
    (root / "selection.json").write_text(json.dumps(config))
    loader = importlib.machinery.SourceFileLoader("dispatch_controlled", str(root / "bin/bend"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    checked, emitter = module.selection()
    assert emitter == root / "compiler/candidate.mjs"
    results.append("exact archive/member/resource recovery and project-relative emitter")
    for args, expected in [
        (["source with spaces.bend", "--check-only"], [config["checker"], "source with spaces.bend", "--check-only"]),
        (["source.bend", "-o", "output.js"], [config["bun"], str(emitter), "source.bend", "-o", "output.js"]),
        (["source.bend", "-o", "output.c"], [config["bun"], str(emitter), "source.bend", "-o", "output.c"]),
    ]:
        calls = []
        with patch.object(module.sys, "argv", ["bend", *args]), patch.object(module.os, "execv", side_effect=lambda executable, argv: calls.append((executable, argv))):
            module.main()
        assert calls == [(expected[0], expected)]
    results.append("stock checker and JS/Native emitter routing preserve exact argv")
    for exit_code in [0, 7]:
        stdout_buffer, stderr_buffer = io.BytesIO(), io.BytesIO()
        stdout = io.TextIOWrapper(stdout_buffer, encoding="utf-8", write_through=True)
        stderr = io.TextIOWrapper(stderr_buffer, encoding="utf-8", write_through=True)
        with patch.object(module.sys, "argv", ["bend", "version"]), patch.object(module.subprocess, "run", return_value=SimpleNamespace(stdout=b"Bend 2.0.35\n", stderr=b"stock stderr\n", returncode=exit_code)) as version, patch.object(module.sys, "stdout", stdout), patch.object(module.sys, "stderr", stderr):
            actual_exit = module.main()
        version.assert_called_once_with([config["checker"], "version"], capture_output=True)
        assert actual_exit == exit_code and stderr_buffer.getvalue() == b"stock stderr\n"
        output = stdout_buffer.getvalue()
        if exit_code:
            assert output == b"Bend 2.0.35\n"
        else:
            first, identity = output.decode().splitlines()
            assert first == "Bend 2.0.35"
            assert json.loads(identity.removeprefix("PROJECT_LOCAL_TOOL_SELECTION ")) == {key: config[key] for key in ["checkerSHA256", "emitterSHA256", "bunSHA256"]}
    results.append("stock version bytes/exit/stderr plus both selected identities")
    emitter.write_bytes(emitter.read_bytes() + b"\n")
    try:
        module.selection()
    except ValueError as error:
        assert "resource membership/bytes changed" in str(error)
    else:
        raise AssertionError("changed emitter accepted")
    results.append("changed recovered compiler fails closed before routing")
print(json.dumps({"status": "PASS_WRAPPER_SELECTION_ONLY", "controls": results, "actualToolExecutions": 0}, sort_keys=True))
