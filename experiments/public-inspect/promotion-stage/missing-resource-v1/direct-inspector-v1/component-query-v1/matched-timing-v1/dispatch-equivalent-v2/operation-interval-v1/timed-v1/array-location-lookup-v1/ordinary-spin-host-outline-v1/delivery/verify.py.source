"""Verify retained host-spin factor; never execute compiler or consumer."""
from pathlib import Path
import hashlib
import json
import re
import zipfile

HERE = Path(__file__).resolve().parent

def sha(raw):
    return hashlib.sha256(raw).hexdigest()

def main():
    delivery = json.loads((HERE / "DELIVERY.json").read_text())
    assert sha((HERE / "EVIDENCE.zip").read_bytes()) == delivery["archiveSHA256"]
    with zipfile.ZipFile(HERE / "EVIDENCE.zip") as archive:
        assert set(archive.namelist()) == {row["path"] for row in delivery["members"]}
        for row in delivery["members"]:
            raw = archive.read(row["path"])
            assert len(raw) == row["bytes"] and sha(raw) == row["sha256"]
        get = lambda name: archive.read("candidate/" + name)
        freeze = json.loads(get("FREEZE.json"))
        launch = json.loads(get("LAUNCH.json"))
        assert sha(get("FREEZE.json")) == launch["freezeSHA256"]
        assert len(launch["order"]) == 1
        assert sha(get("plan.json")) == launch["order"][0]["sha256"]
        assert sha(get("compiler/candidate.mjs")) == freeze["candidateSHA256"]
        assert sha(get("derived.c")) == freeze["derivedCSHA256"]
        derivation = json.loads(get("DERIVATION.json"))
        baseline = archive.read("dependencies/" + derivation["sourceC"].lstrip("/"))
        assert sha(baseline) == derivation["sourceCSHA256"]
        anchor = "#define FAR static __attribute__((noinline))\n"
        extra = "\n#if DEVICE\n#define SPIN_INLINE INLINE\n#else\n#define SPIN_INLINE FAR\n#endif\n"
        compiler = get("compiler/candidate.mjs").decode()
        compiler = compiler.replace(anchor + extra, anchor).replace(
            '${seg.lines.length < SPIN_FAR ? "SPIN_INLINE" : "FAR"} Term ${name}',
            '${seg.lines.length < SPIN_FAR ? "INLINE" : "FAR"} Term ${name}')
        baseline_compiler = archive.read("dependencies/baseline-compiler.mjs")
        assert sha(baseline_compiler) == derivation["compilerBaseline"]
        assert compiler.encode() == baseline_compiler
        source = get("derived.c").decode()
        assert source.count(extra) == 1
        source = source.replace(anchor + extra, anchor)
        source, count = re.subn(r"^SPIN_INLINE(?= Term spin_\d+\(Env e, THR Term\* o)", "INLINE", source, flags=re.M)
        assert count == derivation["replacedSmallSpinDefinitions"] == 1778
        assert source.encode() == baseline
        receipt = json.loads(get("receipt.json"))
        assert receipt["status"] == "INCOMPLETE" and not receipt["guardFailures"]
        assert receipt["planSHA256"] == launch["order"][0]["sha256"]
        assert len(receipt["commands"]) == 1
        command = receipt["commands"][0]
        assert command["label"] == "build" and command["exit"] is None
        assert command["failure"] == "child deadline" and command["capSeconds"] == 120
        for stream in ["stdout", "stderr"]:
            assert get("build." + stream) == b""
            assert command[stream]["sha256"] == sha(b"")
        for guard in receipt["guards"]:
            assert sha(get(Path(guard["path"]).name)) == guard["sha256"]
        assert "candidate/scenario.native" not in archive.namelist()
        assert json.loads(get("RESULT.json"))["consumer"] == "NOT_RUN"
    print(json.dumps({"status": "PASS_RETAINED_HOST_SPIN_FACTOR_NATIVE_INCOMPLETE", "members": len(delivery["members"]), "reversalExact": True}))

if __name__ == "__main__":
    main()
