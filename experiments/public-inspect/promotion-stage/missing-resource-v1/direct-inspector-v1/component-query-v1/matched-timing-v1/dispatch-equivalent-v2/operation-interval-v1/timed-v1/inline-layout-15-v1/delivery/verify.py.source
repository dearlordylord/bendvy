"""Verify retained rejected threshold candidate without executing compiler."""
from pathlib import Path
import gzip,hashlib,json,zipfile
HERE=Path(__file__).resolve().parent
sha=lambda b:hashlib.sha256(b).hexdigest()
def main():
 d=json.loads((HERE/'DELIVERY.json').read_text());assert sha((HERE/'EVIDENCE.zip').read_bytes())==d['archiveSHA256']
 with zipfile.ZipFile(HERE/'EVIDENCE.zip') as z:
  assert z.testzip() is None and set(z.namelist())=={r['path'] for r in d['members']}
  for row in d['members']:
   raw=z.read(row['path']);assert len(raw)==row['bytes'] and sha(raw)==row['sha256']
  f=json.loads(z.read('candidate/FREEZE.json'));l=json.loads(z.read('candidate/LAUNCH.json'));assert sha(z.read('candidate/FREEZE.json'))==l['freezeSHA256']
  assert sha(z.read('candidate/compiler/candidate.mjs'))==f['candidateSHA256']
  for role in ['js','native']:
   p=json.loads(z.read('candidate/runtime01/full/'+role+'/plan.json'));r=json.loads(z.read('candidate/runtime01/full/'+role+'/receipt.json'))
   assert sha(z.read('candidate/runtime01/full/'+role+'/plan.json'))==r['planSHA256'] and not r.get('guardFailures',[])
   for path,expected in p['sourceInventory'].items():assert sha(z.read('dependencies/'+path.lstrip('/')))==expected
   assert len(p['sourceInventory'])==63
   oracle=gzip.decompress(z.read('dependencies/'+p['oracle'].lstrip('/')));assert len(oracle)==226096 and sha(oracle)==p['oracleSHA256']
   if role=='js':assert r['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS' and z.read('candidate/runtime01/full/js/consumer.stdout')==oracle
   else:
    assert r['status']=='INCOMPLETE' and len(r['commands'])==1
    assert r['commands'][0]['exit']==1 and r['commands'][0]['failure'] is None
    raw=z.read('candidate/runtime01/full/native/emit.stderr');assert b'Object.keys(v.lay.arms)' in raw and sha(raw)==r['commands'][0]['stderr']['sha256']
  assert json.loads(z.read('candidate/controls.stdout'))['status']=='PASS'
  assert 'candidate/runtime01/full/native/scenario.c' not in z.namelist()
  assert not any(k.startswith('candidate/runtime01/numeric/') and k.endswith('receipt.json') for k in z.namelist())
 print(json.dumps({'status':'PASS_RETAINED_REJECTED_CANDIDATE','members':len(d['members']),'JS':'fulloracle PASS','Native':'emit TypeError/noC','numeric':'NOT_RUN'}))
if __name__=='__main__':main()
