"""Pure guarded source activation/restoration; invokes no compiler or runner."""
from pathlib import Path
import hashlib,json,sys,zipfile
HERE=Path(__file__).resolve().parent
CONFIG=HERE/'SOURCE-ACTIVATION.json'
def sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def main():
 config=json.loads(CONFIG.read_text()); mode=sys.argv[1]; assert mode in ['activate','restore']
 assert sha(config['freeze'])==config['freezeSHA256']
 assert sha(config['sourceArchive'])==config['sourceArchiveSHA256']
 for path,row in config['changed'].items():assert sha(row['backup'])==row['current']
 if mode=='activate':
  for path,digest in config['inventory'].items():
   if path not in config['changed']:assert sha(path)==digest,path
  assert all(sha(path)==row['current'] for path,row in config['changed'].items())
  with zipfile.ZipFile(config['sourceArchive']) as archive:
   bodies={path:archive.read(path.lstrip('/')) for path in config['changed']}
  assert all(hashlib.sha256(body).hexdigest()==config['changed'][path]['frozen'] for path,body in bodies.items())
  try:
   for path,body in bodies.items():Path(path).write_bytes(body)
   assert all(sha(path)==digest for path,digest in config['inventory'].items())
  except BaseException:
   for path,row in config['changed'].items():Path(path).write_bytes(Path(row['backup']).read_bytes())
   raise
 else:
  # Restore every preserved body, including when emission/runner/preflight failed.
  for path,row in config['changed'].items():Path(path).write_bytes(Path(row['backup']).read_bytes())
  assert all(sha(path)==row['current'] for path,row in config['changed'].items())
 print(json.dumps({'mode':mode,'inventory':{path:sha(path) for path in config['inventory']},'configurationSHA256':sha(CONFIG)},indent=2))
if __name__=='__main__':main()
