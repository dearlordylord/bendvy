"""Invoke the existing exact source/resource boundary checks; no backend."""
from pathlib import Path
import hashlib,json,types,sys
plan_path=Path(sys.argv[1]);expected=sys.argv[2]
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
assert sha(plan_path)==expected
plan=json.loads(plan_path.read_text())
assert all(not Path(p).is_symlink() and Path(p).is_file() and sha(p)==h for p,h in plan['pins'].items())
assert all(sha(p)==h for p,h in plan['sourceInventory'].items())
root=Path('/workspace/formal-proofs/bendvy')
def load(name,path):
 source=Path(path).read_bytes();assert hashlib.sha256(source).hexdigest()==plan['pins'][str(path)]
 module=types.ModuleType(name);module.__file__=str(path);exec(compile(source,str(path),'exec'),module.__dict__);return module
collector=load('candidate_preflight_collector',root/'experiments/public-inspect/ordinary-declaration-v1/canonical-full-consumer-v1/development-v2.py')
runner=load('candidate_preflight_runner',root/'scripts/task_runner.py')
assert collector.validate_imports(plan['stage'],plan['sourceInventory'],plan['sourceEntries'])==plan['importClosure']
assert runner.Inputs(directories=plan['resourceRoots']).expected==plan['resourceRoots']
print(json.dumps({'planSHA256':expected,'pins':len(plan['pins']),'sources':len(plan['sourceInventory']),'sourceEntries':plan['sourceEntries'],'exactPinsResourcesImportCoverage':True},indent=2))
