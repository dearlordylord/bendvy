from pathlib import Path
import runpy,json,hashlib,gzip
P=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
b=json.loads((P/'SOURCE-BASIS.json').read_text())
for p,h in b['inputs'].items():assert sha(p)==h,p
normal=runpy.run_path(str(P.parent/'model.py.source'));mutant=runpy.run_path(str(P/'model.py.source'))
n=normal['complete']([(1,2),(1,2)]);m=mutant['complete']([(1,2),(1,2)])
changes=[]
for si,(ns,ms) in enumerate(zip(n.fields,m.fields)):
    for ri,(nr,mr) in enumerate(zip(ns,ms)):
        for fi,(nf,mf) in enumerate(zip(nr.fields,mr.fields)):
            a=normal['show'](nf);z=mutant['show'](mf)
            if a!=z:
                changes.append((si,ri,fi))
                assert ri==0 and fi in [6,7,8]
                if fi==6:assert mf.name.endswith('.Succeeded') and mf.fields[0].name=='None'
                else:assert a.replace('counter=L(1)','counter=L(2)')==z
assert changes==[(0,0,6),(0,0,7),(0,0,8),(1,0,6),(1,0,7),(1,0,8)]
raw=mutant['expected']();baseline=normal['expected']();assert len(baseline)==35700
assert hashlib.sha256(baseline).hexdigest()=='6b66eebd1eb59d24bf0689327ac8d788c2f27e7790c7674c92d4bfa1047dce66'
assert raw!=baseline
for name,data in [('expected.stdout.gz',raw),('normal.stdout.gz',baseline)]:
    (P/name).write_bytes(gzip.compress(data,mtime=0));assert gzip.decompress((P/name).read_bytes())==data
catalogue={}
for key,name,data in [('mutant','expected.stdout.gz',raw),('normalBaseline','normal.stdout.gz',baseline)]:
    catalogue[key]={'stdout':str(P/name),'bytes':len(data),'sha256':hashlib.sha256(data).hexdigest(),'sourceBasisPath':str(P/'SOURCE-BASIS.json'),'sourceBasisSHA256':sha(P/'SOURCE-BASIS.json')}
(P/'ORACLES.json').write_text(json.dumps(catalogue,indent=2)+'\n')
(P/'CHECKS.json').write_text(json.dumps({'status':'PASS','state':'PREPARED_NOT_APPLIED','sourceCount':59,'basisPins':len(b['inputs']),'changedReportFields':changes,'scope':'Two required Missing statuses and four full physical counter observations only; all other fields equal','runtimeOutputInputs':[]},indent=2)+'\n')
print(len(raw),hashlib.sha256(raw).hexdigest())
