"""UNBOUND PREPARED required-preflight omission model; no runtime-output inputs.
Bound source08 factory allocation and implicit nominal printer geometry.
"""
import json, os
from pathlib import Path
TOP=Path('/workspace/formal-proofs/bendvy-worktrees/observable-query-boundaries/experiments/public-inspect/promotion-stage/missing-resource-v1/consumer-source-v1')
CORE=Path('/workspace/formal-proofs/bendvy/src/ecs')
class Term:
    def __init__(self,name,*fields):self.name,self.fields=name,fields
def ctor(module,name,*fields):
    path=CORE/module if module.endswith('.bend') else TOP/(module+'.bend')
    return Term(os.path.relpath(path,TOP).removesuffix('.bend')+'.'+name,*fields)
def base(name,*fields):return Term(name,*fields)
def show(x):
    if isinstance(x,Term):return x.name+'{'+', '.join(map(show,x.fields))+'}'
    if isinstance(x,str):return json.dumps(x,ensure_ascii=False)
    if isinstance(x,list):return '['+', '.join(map(show,x))+']'
    return str(x)
def product(a,b):return ctor('ordinary-app-observation-data.bend','Product',a,b)
def value(present):return base('Some',[17,18]) if present else base('None')
def clauses():return [ctor('ordinary-query-declaration.bend','Clause','Payload',ctor('ordinary-query-declaration.bend','Read')),ctor('ordinary-query-declaration.bend','Clause','CallbackCounter',ctor('ordinary-query-declaration.bend','Write'))]
def physical(ns,present,registered,counter):
    regs='['+', '.join(str(i)+':'+name+':[Payload, CallbackCounter]' for i,name in reversed(list(enumerate(['OptionalPayload','RequiredPayload'][:registered],1))))+']'
    payload='Present(N(L(17),L(18)))' if present else 'Missing'
    return f'world({ns},1,0,live=L(False),capacity=1,depth=0,store=N(L(31),L(32)),payload={payload},counter=L({counter}),sibling=N(L(27),L(28)),owners=N(L(901),L(902)),events=[],pending=1,regs={regs},nextSystem={registered+1},clock=0)'
def snapshot(ns,present,registered,counter):
    bindings=[ctor('ordinary-app-observation-data.bend','Binding',ns,i,name,['Payload','CallbackCounter'],0,name,clauses()) for i,name in enumerate(['OptionalPayload','RequiredPayload'][:registered],1)]
    rows=base('Unit')
    for _ in range(registered):rows=product(rows,value(present))
    rendered=['Payload,CallbackCounter='+('[17, 18]' if present else 'Unavailable')]*registered
    observation=ctor('ordinary-app-observation-data.bend','Observation',rows,rendered)
    return product(physical(ns,present,registered,counter),base('Some',product(bindings,observation)))
def report(ns,present):
    initial=physical(ns,present,0,0)
    optional_registered=snapshot(ns,present,1,0)
    optional_status=ctor('ordinary-app-optional-resource-run.bend','Succeeded',value(present))
    optional_after=snapshot(ns,present,1,1)
    required_registered=snapshot(ns,present,2,1)
    required_status=ctor('ordinary-app-optional-resource-run.bend','Succeeded',value(present))
    required_after=snapshot(ns,present,2,2)
    return ctor('consumer','Report',initial,optional_registered,optional_status,optional_after,optional_after,required_registered,required_status,required_after,required_after)
def complete(schema_namespaces):
    """Explicit final allocation pairs, supplied only after source freeze audit."""
    return product(*[[report(missing,False),report(present,True)] for missing,present in schema_namespaces])

def expected():
    return (show(complete([(1,2),(1,2)]))+"\n").encode()
