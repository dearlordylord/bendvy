from pathlib import Path
import hashlib,json,gzip,runpy
P=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
b=json.loads((P/'SOURCE-BASIS.json').read_text())
for p,h in b['inputs'].items():assert sha(p)==h,p
m=runpy.run_path(str(P/'model.py.source'));root=m['complete']()
for schema in root.fields:
    for present,report in enumerate(schema):
        initial,optional,os,required,rs,hosts=report.fields
        assert len(optional)==len(required)==len(hosts)==4
        for snap,clock in zip(optional+required,[0,2,2,4,4,6,6,8]):
            assert f'clock={clock})' in snap.fields[0] and 'pending=1' in snap.fields[0]
        for hi,host in enumerate(hosts):
            first,fi,second,si,check=host.fields
            assert fi==f'Active:{hi*2+1}:0' and si==f'Active:{hi*2+2}:0'
            assert first.name==second.name=='Done'
            assert first.fields[0].fields[1]==second.fields[0].fields[1]==[0 if hi==0 else (2 if hi==3 and present else 1)]
            assert check.name==('Done' if present else 'Fail')
        for snap in optional[2:]+required:
            assert snap.fields[1].fields[0].fields[0][0].fields[4]==2
        assert required[-1].fields[1].fields[0].fields[0][1].fields[4]==(6 if present else 0)
        assert os.name.endswith('.Succeeded') and rs.name.endswith('.Succeeded' if present else '.Failed')
raw=m['expected']();(P/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0));assert gzip.decompress((P/'expected.stdout.gz').read_bytes())==raw
(P/'ORACLES.json').write_text(json.dumps({'normal':{'stdout':str(P/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(P/'SOURCE-BASIS.json'),'sourceBasisSHA256':sha(P/'SOURCE-BASIS.json')}},indent=2)+'\n')
(P/'CHECKS.json').write_text(json.dumps({'status':'PASS','sourceCount':b['sourceCount'],'basisPins':len(b['inputs']),'reports':4,'snapshots':32,'inspectorResults':32,'checkResults':16,'runtimeOutputInputs':[],'assertions':['source hash exact','clock sequence0,2,2,4,4,6,6,8','continuous Inspector cursor1..8 registeredAt0','operative Registry cursors optional2 and requiredPresent6/Missing0','retained detached pre/post counter and payload Data','full output gzip roundtrip']},indent=2)+'\n')
print(len(raw),hashlib.sha256(raw).hexdigest())
