"""Rebuild and audit the source-derived Done-cursor omission counteroracle."""

from pathlib import Path
import gzip
import hashlib
import json
import runpy
import zipfile

HERE = Path(__file__).resolve().parent
PARENT = HERE.parent
SOURCE = Path(
    "/workspace/formal-proofs/bendvy-worktrees/observable-query-boundaries/"
    "experiments/public-inspect/promotion-stage/missing-resource-v1/"
    "direct-inspector-v1/component-query-v1/done-cursor-omission-v1"
)
FREEZE = SOURCE / "FREEZE.json"
ARCHIVE = SOURCE / "SOURCE.zip"
REBINDINGS = SOURCE / "REBINDINGS.json"
FREEZE_SHA256 = "7f33c0c5823b3eb4e03133f0e9f080ca12a6840e40355d993eac275c5621e2b2"
ARCHIVE_SHA256 = "44fc4995e6343f3b7b612b2f76d1b775fe647574bd46e8b5be1f98e287091a81"
REBINDINGS_SHA256 = "07e5f575046af28a490fec80f4b6c16755cff097bba0ec7ed5fe1f4ab2ff084b"
MUTANT_INSPECTOR_SHA256 = "8dde6a746ccc47b6023094ec6f713d82ff4e09d858d43c656e8fe2e9dca4a83d"
NORMAL_PRIVATE_INSPECTOR_SHA256 = "1130f921c3dd7713bad1018f682266b4579b7676fa7966b765a314cbce367ff1"

NORMAL_SOURCE = SOURCE.parent
NORMAL_FREEZE = NORMAL_SOURCE / "FREEZE03.json"
NORMAL_ARCHIVE = NORMAL_SOURCE / "SOURCE03.zip"
NORMAL_FREEZE_SHA256 = "61a41beac48858fee0fbb88e3bb3575114160a23c479410334c9921fd268d31f"
NORMAL_ARCHIVE_SHA256 = "1bad45b47df384360c494e8e0ebe1ca8f587282bd3d3981bad93f4289e3185ef"
NORMAL_MODEL = PARENT / "successor-v3" / "model.py.source"
NORMAL_EXPECTED = PARENT / "successor-v3" / "expected.stdout.gz"
NORMAL_BASIS = PARENT / "successor-v3" / "SOURCE-BASIS.json"
NORMAL_BYTES = 207834
NORMAL_SHA256 = "14565a3635124edb3ba8ef53b76e2030c3b3698e5d7c4a31989bc3ca9fb54a2d"

PRINTER = Path(
    "/workspace/formal-proofs/bendvy/experiments/public-decode/public-seam-v1/"
    "construction-v1/qualification-v1/application32-v1/timing-alignment-v1/"
    "native-resume-v1/phase-copy-v1/compiler/installed-cli-unmodified.mjs"
)
PRINTER_SHA256 = "015d68644efcd3ed53a5dbf17f5672c3f4fcb70c8c64cd2c895b4955e1f78e62"
MODEL = HERE / "model.py.source"
GENERATOR = HERE / "regenerate.py.source"
COUNTER_GZIP = HERE / "counter.stdout.gz"


def sha_bytes(data):
    return hashlib.sha256(data).hexdigest()


def sha_path(path):
    return sha_bytes(Path(path).read_bytes())


def archived_sources(path):
    with zipfile.ZipFile(path) as archive:
        return {name: archive.read(name) for name in archive.namelist()}


def differing_offset(left, right):
    limit = min(len(left), len(right))
    for offset in range(limit):
        if left[offset] != right[offset]:
            return offset
    return limit if len(left) != len(right) else None


assert sha_path(FREEZE) == FREEZE_SHA256
assert sha_path(ARCHIVE) == ARCHIVE_SHA256
assert sha_path(REBINDINGS) == REBINDINGS_SHA256
assert sha_path(NORMAL_FREEZE) == NORMAL_FREEZE_SHA256
assert sha_path(NORMAL_ARCHIVE) == NORMAL_ARCHIVE_SHA256
assert sha_path(PRINTER) == PRINTER_SHA256
assert sha_path(NORMAL_MODEL) == "998b31ecf464408fa15c23243bb49afaae4ffb2d78f057f11efb992ad96e0aa0"
assert sha_path(NORMAL_BASIS) == "75a997b86e7e2e79c4d4984a570c882d53ae6e25ff1bbbae0afde0abe7d1c3ec"

freeze = json.loads(FREEZE.read_text())
normal_freeze = json.loads(NORMAL_FREEZE.read_text())
rebindings = json.loads(REBINDINGS.read_text())
inventory = freeze["sourceInventory"]
normal_inventory = normal_freeze["sourceInventory"]
assert len(inventory) == len(normal_inventory) == len(rebindings["sources"]) == 53
assert rebindings["status"] == "PRIVATE_NORMAL_BEFORE_ROOT_MUTATION"
assert freeze["sourceArchiveSHA256"] == ARCHIVE_SHA256
assert freeze["rebindingsSHA256"] == REBINDINGS_SHA256
assert len(freeze["changedVsPrivateNormal"]) == 1
mutant_path = freeze["changedVsPrivateNormal"][0]
assert mutant_path.endswith("/source/core/inspector.bend")
assert freeze["entrypoint"].endswith("/source/consumer/main.bend")
assert freeze["sourceOnlyEntrypoint"].endswith("/source/consumer/source.bend")

# Bind the candidate closure back to the already audited current consumer:
# original source paths/hashes match SOURCE03, while private files are identical
# to their pre-mutation copies except for the frozen Inspector body.
mapping_by_original = {row["original"]: row for row in rebindings["sources"]}
assert len(mapping_by_original) == 53
assert set(mapping_by_original) == set(normal_inventory)
for original, original_sha in normal_inventory.items():
    assert mapping_by_original[original]["originalSHA256"] == original_sha

mutant_archive = archived_sources(ARCHIVE)
normal_archive = archived_sources(NORMAL_ARCHIVE)
assert set(mutant_archive) == {
    path.split("/done-cursor-omission-v1/", 1)[1] for path in inventory
}
assert set(normal_archive) == {
    path.lstrip("/") for path in normal_inventory
}
for path, expected in inventory.items():
    member = path.split("/done-cursor-omission-v1/", 1)[1]
    assert sha_bytes(mutant_archive[member]) == expected, member
    assert sha_path(path) == expected, f"live candidate source changed: {path}"

pre_mutation_mismatches = []
for row in rebindings["sources"]:
    private_path = row["private"]
    member = private_path.split("/done-cursor-omission-v1/", 1)[1]
    actual = sha_bytes(mutant_archive[member])
    expected = row["privateNormalSHA256"]
    if actual != expected:
        pre_mutation_mismatches.append((private_path, expected, actual))
    if private_path != mutant_path:
        assert actual == expected, f"unlisted private-body mutation: {private_path}"
assert pre_mutation_mismatches == [
    (mutant_path, NORMAL_PRIVATE_INSPECTOR_SHA256, MUTANT_INSPECTOR_SHA256)
]

inspector_text = mutant_archive["source/core/inspector.bend"].decode()
assert "Observed{world,Active{cursor,registeredAt},Done{value}}" in inspector_text
assert "case Frame{world,_} Done{value}:succeeded(" in inspector_text
assert "registeredAt,value,W.advance_clock(" in inspector_text
assert "case Frame{world,_} Fail{error}:Observed{world,Active{cursor,registeredAt},Fail{error}}" in inspector_text
assert "Active{worldClock,registeredAt}" not in inspector_text

normal_model = runpy.run_path(str(NORMAL_MODEL))
normal_stdout = normal_model["stdout_bytes"]()
assert len(normal_stdout) == NORMAL_BYTES
assert sha_bytes(normal_stdout) == NORMAL_SHA256
assert gzip.decompress(NORMAL_EXPECTED.read_bytes()) == normal_stdout

# This second invocation uses only the independent Python state model. The
# source/runtime outputs are not inputs to the generated mutant bytes.
counter_model = runpy.run_path(str(MODEL))
counter_stdout = counter_model["stdout_bytes"]()
counter_sha256 = sha_bytes(counter_stdout)
assert len(counter_stdout) == 230664
assert counter_sha256 == "dcf16bb44f656a232bad4c162c4397cc47a1a5fdf47a7f4e74543f2d5a1172ee"
assert counter_stdout != normal_stdout
first_diff = differing_offset(normal_stdout, counter_stdout)
assert first_diff == 5437
assert counter_stdout.count(b"|factory=2|physical=") == 22
assert counter_stdout.count(b"schedule=Finished|observations=[Ran{1}]") == 4
assert counter_stdout.count(b"|checks=[True,True,True,True,True,True,True,True,False]") == 20
assert counter_stdout.count(b"Active:0:") > normal_stdout.count(b"Active:0:")
compressed = gzip.compress(counter_stdout, mtime=0)
assert gzip.decompress(compressed) == counter_stdout
COUNTER_GZIP.write_bytes(compressed)

normal_slice = normal_stdout[max(0, first_diff - 72):first_diff + 144]
counter_slice = counter_stdout[max(0, first_diff - 72):first_diff + 144]
model_sha = sha_path(MODEL)
generator_sha = sha_path(GENERATOR)
inputs = dict(inventory)
inputs.update({
    str(FREEZE): FREEZE_SHA256,
    str(ARCHIVE): ARCHIVE_SHA256,
    str(REBINDINGS): REBINDINGS_SHA256,
    str(NORMAL_FREEZE): NORMAL_FREEZE_SHA256,
    str(NORMAL_ARCHIVE): NORMAL_ARCHIVE_SHA256,
    str(NORMAL_MODEL): sha_path(NORMAL_MODEL),
    str(NORMAL_EXPECTED): sha_path(NORMAL_EXPECTED),
    str(NORMAL_BASIS): sha_path(NORMAL_BASIS),
    str(PRINTER): PRINTER_SHA256,
    str(MODEL): model_sha,
    str(GENERATOR): generator_sha,
})

basis = {
    "state": "INDEPENDENT_SOURCE_DERIVED_DONE_CURSOR_COUNTERMODEL",
    "sourceCount": len(inventory),
    "mutantFreeze": {
        "path": str(FREEZE),
        "sha256": FREEZE_SHA256,
        "entrypoint": freeze["entrypoint"],
        "sourceOnlyEntrypoint": freeze["sourceOnlyEntrypoint"],
        "scope": freeze["scope"],
        "changedVsPrivateNormal": freeze["changedVsPrivateNormal"],
    },
    "mutantArchive": {"path": str(ARCHIVE), "sha256": ARCHIVE_SHA256},
    "rebindings": {
        "path": str(REBINDINGS),
        "sha256": REBINDINGS_SHA256,
        "status": rebindings["status"],
        "sourceCount": len(rebindings["sources"]),
        "originalInventoryMatchesNormalFreeze03": True,
        "privateFilesMatchingPreMutation": 52,
        "solePrivateBodyChange": {
            "path": mutant_path,
            "preMutationSHA256": NORMAL_PRIVATE_INSPECTOR_SHA256,
            "mutantSHA256": MUTANT_INSPECTOR_SHA256,
        },
    },
    "normalConsumerBasis": {
        "freezePath": str(NORMAL_FREEZE),
        "freezeSHA256": NORMAL_FREEZE_SHA256,
        "archivePath": str(NORMAL_ARCHIVE),
        "archiveSHA256": NORMAL_ARCHIVE_SHA256,
        "queryKinds": len(normal_freeze["queryKinds"]),
        "checkKinds": len(normal_freeze["checkKinds"]),
        "physicalCheckpoints": len(normal_freeze["checkpoints"]),
        "actionAndOutputBodies": "private pre-mutation copies are byte-pinned by REBINDINGS.json",
    },
    "sourceSemantics": {
        "DoneTransition": "succeeded returns Active{cursor,registeredAt} using its input cursor",
        "Clock": "finished still supplies W.advance_clock(world) to succeeded on Done",
        "RegisteredAt": "the same registeredAt value is retained on Done",
        "Fail": "Fail returns Active with its prior cursor and registeredAt",
        "Fixture": "all ordinary Inspector bodies in this trace return Done; retry has one Fail followed by two Done results",
        "effectOnTrace": "all 14 continuously returned instances retain cursor 0; each Done still advances World.clock",
    },
    "canonicalPrinter": {
        "path": str(PRINTER),
        "sha256": PRINTER_SHA256,
        "behavior": "top-level pure String is quoted and escaped; IO appends one newline",
    },
    "normalOracle": {
        "modelPath": str(NORMAL_MODEL),
        "modelSHA256": sha_path(NORMAL_MODEL),
        "oraclePath": str(NORMAL_EXPECTED),
        "oracleGzipSHA256": sha_path(NORMAL_EXPECTED),
        "stdoutBytes": len(normal_stdout),
        "stdoutSHA256": sha_bytes(normal_stdout),
        "candidateNormalGeometryBytesMatch": True,
    },
    "counterDerivation": [
        "The independent state model applies the sole frozen transition change to every public Inspector read; it does not consume runtime output.",
        "The model preserves all factory/owner arrays, component stamps and payloads, writer registry state, pending retention, query/check ordering, failure barriers, and schedule actions from the source-derived normal model.",
        "Done advances the world clock but leaves the instance cursor unchanged. All 14 ordinary instances therefore remain at cursor 0 across bootstrap, repeat, and post-writer rounds.",
        "The retry's Fresh failure retains cursor 0 at registeredAt 61; both Done retries retain cursor 0 while clocks advance 61 to 62 to 63, so addedBoth continues to select the same four entities.",
        "The full two-schema stdout is rendered independently and compared to the source-derived normal oracle only to report the counterexample difference.",
    ],
    "runtimeOutputInputs": [],
    "inputs": inputs,
    "executionDependencies": [
        {"path": str(MODEL), "sha256": model_sha},
        {"path": str(GENERATOR), "sha256": generator_sha},
    ],
    "limits": [
        "This is a complete finite trace for the frozen two-schema consumer, not a universal claim about all Inspectors or worlds.",
        "The normal and mutant outputs are source-derived models; no runtime stdout was used as a model input.",
    ],
}
basis_path = HERE / "SOURCE-BASIS.json"
basis_path.write_text(json.dumps(basis, indent=2) + "\n")

oracles = {
    "countermodel": {
        "stdout": str(COUNTER_GZIP),
        "bytes": len(counter_stdout),
        "sha256": counter_sha256,
        "gzipBytes": len(compressed),
        "gzipSHA256": sha_bytes(compressed),
        "sourceBasisPath": str(basis_path),
        "sourceBasisSHA256": sha_path(basis_path),
        "normalFirstDifference": {
            "offset": first_diff,
            "normalContext": repr(normal_slice),
            "counterContext": repr(counter_slice),
        },
    },
    "normal": {
        "stdout": str(NORMAL_EXPECTED),
        "bytes": len(normal_stdout),
        "sha256": sha_bytes(normal_stdout),
        "gzipBytes": len(NORMAL_EXPECTED.read_bytes()),
        "gzipSHA256": sha_path(NORMAL_EXPECTED),
        "sourceBasisPath": str(NORMAL_BASIS),
        "sourceBasisSHA256": sha_path(NORMAL_BASIS),
    },
}
(HERE / "ORACLES.json").write_text(json.dumps(oracles, indent=2) + "\n")

checks = {
    "status": "PASS",
    "mutantFreezeSHA256": FREEZE_SHA256,
    "mutantArchiveSHA256": ARCHIVE_SHA256,
    "rebindingsSHA256": REBINDINGS_SHA256,
    "sourceCount": len(inventory),
    "privateNormalBodiesMatching": 52,
    "soleChangedPrivateBody": {
        "path": mutant_path,
        "normalSHA256": NORMAL_PRIVATE_INSPECTOR_SHA256,
        "mutantSHA256": MUTANT_INSPECTOR_SHA256,
    },
    "queryKinds": len(normal_freeze["queryKinds"]),
    "checkKinds": len(normal_freeze["checkKinds"]),
    "physicalCheckpointsPerSchema": len(normal_freeze["checkpoints"]),
    "worldClocks": {
        "setup": 33,
        "bootstrap": 47,
        "repeat": 61,
        "retrySuccess": 62,
        "retryRepeat": 63,
        "firstWriter": 71,
        "changed": 85,
        "changedRepeat": 99,
        "secondWriter": 107,
        "final": 121,
    },
    "cursorEffects": {
        "ordinaryInstancesAfterEachDone": [0] * 14,
        "retryAfterFreshFailAndBothDones": [0, 0, 0],
        "retryAddedBothRowsOnEachAttempt": [4, 8, 12, 16],
    },
    "physicalSnapshots": counter_stdout.count(b"|factory=2|physical="),
    "scheduleObservations": counter_stdout.count(b"schedule=Finished|observations=[Ran{1}]"),
    "checkTuples": counter_stdout.count(b"|checks=[True,True,True,True,True,True,True,True,False]"),
    "runtimeOutputInputs": [],
    "normal": {"bytes": len(normal_stdout), "sha256": sha_bytes(normal_stdout)},
    "countermodel": {
        "bytes": len(counter_stdout),
        "sha256": counter_sha256,
        "gzipBytes": len(compressed),
        "gzipSHA256": sha_bytes(compressed),
        "firstDifferenceOffset": first_diff,
    },
    "assertions": [
        "all 53 candidate source files match FREEZE.json, the archive, live paths and REBINDINGS hashes",
        "the candidate's only private-normal source mismatch is the exact Inspector body named by FREEZE.changedVsPrivateNormal",
        "Inspector Done retains the input cursor while the Done path still advances World.clock; Fail retains the cursor",
        "all 14 queries, nine checks, 11 checkpoints per schema and source-defined schedule actions are retained",
        "the source-derived normal model equals its archived 207834-byte normal oracle exactly",
        "the complete two-schema countermodel differs from normal at the recorded first byte",
        "counter stdout has 22 physical snapshots, four schedule observations and 20 populated check tuples",
        "deterministic gzip decompresses byte-for-byte to the generated counter stdout",
    ],
}
(HERE / "CHECKS.json").write_text(json.dumps(checks, indent=2) + "\n")

print(json.dumps({
    "status": "PASS",
    "counterBytes": len(counter_stdout),
    "counterSHA256": counter_sha256,
    "gzipBytes": len(compressed),
    "gzipSHA256": sha_bytes(compressed),
    "normalFirstDifference": first_diff,
}, sort_keys=True))
