"""Regenerate and validate the source-only component-query oracle."""
from pathlib import Path
import gzip
import hashlib
import json
import runpy


HERE = Path(__file__).resolve().parent
SOURCE = Path(
    "/workspace/formal-proofs/bendvy-worktrees/observable-query-boundaries/"
    "experiments/public-inspect/promotion-stage/missing-resource-v1/"
    "direct-inspector-v1/component-query-v1"
)
FREEZE_SHA256 = "f0fafb872d77965062ce940fa18fabaec20821c03378f071f6bf74a5fcc8fd76"
ARCHIVE_SHA256 = "49ad8c9cc0e12395a7bcca22af222723c5c461693e0be34a5f67581c3060d216"
PRINTER = Path(
    "/workspace/formal-proofs/bendvy/experiments/public-decode/public-seam-v1/"
    "construction-v1/qualification-v1/application32-v1/timing-alignment-v1/"
    "native-resume-v1/phase-copy-v1/compiler/installed-cli-unmodified.mjs"
)
PRINTER_SHA256 = "015d68644efcd3ed53a5dbf17f5672c3f4fcb70c8c64cd2c895b4955e1f78e62"


def sha256(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


freeze_path = SOURCE / "FREEZE.json"
archive_path = SOURCE / "SOURCE.zip"
assert sha256(freeze_path) == FREEZE_SHA256, "frozen source manifest changed"
assert sha256(archive_path) == ARCHIVE_SHA256, "frozen source archive changed"
freeze = json.loads(freeze_path.read_text())
source_inputs = freeze["sourceInventory"]
assert len(source_inputs) == 53, "unexpected frozen source closure size"
for path, expected_hash in source_inputs.items():
    assert sha256(path) == expected_hash, f"frozen source hash changed: {path}"
assert sha256(PRINTER) == PRINTER_SHA256, "pinned canonical printer changed"

model_path = HERE / "model.py.source"
generator_path = HERE / "regenerate.py.source"
inputs = dict(source_inputs)
inputs[str(freeze_path)] = FREEZE_SHA256
inputs[str(archive_path)] = ARCHIVE_SHA256
inputs[str(PRINTER)] = PRINTER_SHA256
inputs[str(model_path)] = sha256(model_path)
inputs[str(generator_path)] = sha256(generator_path)

basis = {
    "state": "SOURCE_FROZEN_MODEL_ONLY",
    "sourceCount": len(source_inputs),
    "sourceFreeze": {
        "path": str(freeze_path),
        "sha256": FREEZE_SHA256,
        "entrypoint": freeze["entrypoint"],
        "sourceOnlyEntrypoint": freeze["sourceOnlyEntrypoint"],
    },
    "sourceArchive": {"path": str(archive_path), "sha256": ARCHIVE_SHA256},
    "canonicalPrinter": {
        "path": str(PRINTER),
        "sha256": PRINTER_SHA256,
        "behavior": "top-level pure String is quoted and escaped; IO appends one newline",
        "implementationLines": "installed-cli-unmodified.mjs:show_chr/show_val/io_exit",
    },
    "inputs": inputs,
    "executionDependencies": [
        {"path": str(model_path), "sha256": sha256(model_path)},
        {"path": str(generator_path), "sha256": sha256(generator_path)},
    ],
    "runtimeOutputInputs": [],
    "derivation": [
        "The fixture creates one World, advances its initial clock once, then performs accepted present-component replacements in entity order and stock/title/active/count order; absent cells remain empty.",
        "The sixteen live rows occupy entity IDs 1 through 16, a seventeenth reservation is deactivated, and the retained World arrays are rendered as their full balanced physical trees.",
        "All fourteen public Inspector selections are evaluated independently over the frozen component values and lifecycle stamps; Fresh uses cursor zero, while returned Active instances retain their cursor/registeredAt pair across rounds.",
        "A failed addedBoth body returns Fail and therefore preserves the Fresh retry's cursor and World.clock; the two following successful reads return the same instance through Inspector's Done transition.",
        "Each Check uses the source Check query and its matching prior canonical record; it is cursorless and does not advance World.clock. Its nonempty test makes only the contradictory selection false.",
        "Each actual Schedule dispatch derives ID 1 from the World registration catalog and writes the constant input value to Stock and input-plus-one to Title for each matching entity in ascending handle order.",
        "Successful writes advance the component stamps and World.clock; the registry cursor is set to the final World.clock. There is no Barrier step, so the one queued clock-plus-100 command remains pending.",
        "World, all four Column value trees and lifecycle stamps, resource owners, writer registry, all inspector instances, all rows/checks, per-query boundaries, retry boundaries, and the two schedule observations are rendered at all eleven source checkpoints.",
        "The output consists of ASCII. Python JSON string quoting matches the pinned show_chr quote/backslash behavior for this value, and the direct executable printer appends exactly one newline.",
    ],
    "limits": [
        "Finite source-derived trace for the frozen Workshop and Garden nominal schema copies; it is not a universal proof over worlds or arbitrary schemas.",
        "No Bend JavaScript or native runtime output is read by the model or regenerator.",
        "The pending closure is represented by its exact retained count and source-defined +100 clock action; this trace has no barrier that applies it.",
    ],
}
(HERE / "SOURCE-BASIS.json").write_text(json.dumps(basis, indent=2) + "\n")

model = runpy.run_path(str(model_path))
expected = model["stdout_bytes"]()
assert expected.endswith(b"\n")
assert expected.count(b"schedule=Finished|observations=[Ran{1}]") == 4
assert expected.count(b"|factory=2|physical=") == 22
assert expected.count(b"|checks=[True,True,True,True,True,True,True,True,False]") == 20
assert b"clock=33->47" not in expected  # boundaries are per-call, not aggregated
compressed = gzip.compress(expected, mtime=0)
assert gzip.decompress(compressed) == expected

oracle_path = HERE / "expected.stdout.gz"
oracle_path.write_bytes(compressed)
basis_path = HERE / "SOURCE-BASIS.json"
basis_hash = sha256(basis_path)
raw_hash = hashlib.sha256(expected).hexdigest()
oracles = {
    "normal": {
        "stdout": str(oracle_path),
        "bytes": len(expected),
        "sha256": raw_hash,
        "sourceBasisPath": str(basis_path),
        "sourceBasisSHA256": basis_hash,
    }
}
(HERE / "ORACLES.json").write_text(json.dumps(oracles, indent=2) + "\n")

checks = {
    "status": "PASS",
    "sourceFreezeSHA256": FREEZE_SHA256,
    "sourceArchiveSHA256": ARCHIVE_SHA256,
    "sourceCount": len(source_inputs),
    "basisPins": len(inputs),
    "nominalSchemas": ["Workshop", "Garden"],
    "checkpointsPerSchema": 11,
    "checkpoints": 22,
    "inspectorQueriesPerRound": 14,
    "successfulInspectorRounds": 10,
    "successfulInspectorQueryRuns": 140,
    "failedRetryReads": 2,
    "successfulRetryReads": 4,
    "cursorlessChecks": 90,
    "successfulScheduleRuns": 4,
    "componentWrites": 96,
    "finalWorldClock": 121,
    "finalRegistryCursor": 107,
    "runtimeOutputInputs": [],
    "stdoutBytes": len(expected),
    "stdoutSHA256": raw_hash,
    "assertions": [
        "all 53 sourceInventory hashes, exact FREEZE digest, and SOURCE.zip digest match",
        "the canonical printer path and SHA-256 match the statically pinned CLI source",
        "the independent model and regenerator are included as hash-pinned execution dependencies",
        "both nominal schema copies produce eleven complete source checkpoints",
        "each of five Inspector rounds contains fourteen rows records and fourteen before/after clock+instance boundaries per schema",
        "the Fresh bootstrap captures registeredAt values 33 through 46 and returns cursors 34 through 47",
        "the independent retry fails without a clock/cursor advance, then returns cursor 62 and 63 on its two successful calls",
        "the paired registered writer derives System ID 1, writes eight components per run, and records registry cursors 71 and 107",
        "only changedBoth matches post-writer changes in the later rounds; Added stamps remain the original fixture ticks",
        "the pending +100 command remains queued because neither schedule contains a Barrier step",
        "each phase runs all nine cursorless Check variants; the nonempty contradictory check is the sole false result",
        "all physical World fields, all four component owner trees/stamps, resource arrays, instances, rows, checks and observation strings appear in each full checkpoint",
        "complete canonical stdout is gzip-compressed with deterministic metadata and round-trips byte-for-byte",
    ],
}
(HERE / "CHECKS.json").write_text(json.dumps(checks, indent=2) + "\n")
print(f"{len(expected)} {raw_hash}")
