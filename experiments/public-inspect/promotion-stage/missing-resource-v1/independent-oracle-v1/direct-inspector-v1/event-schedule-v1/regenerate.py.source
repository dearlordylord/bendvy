"""Regenerate the source-only oracle for the frozen event/Schedule consumer."""
from pathlib import Path
import gzip
import hashlib
import json
import runpy


HERE = Path(__file__).resolve().parent
SOURCE = Path(
    "/workspace/formal-proofs/bendvy-worktrees/observable-query-boundaries/"
    "experiments/public-inspect/promotion-stage/missing-resource-v1/"
    "direct-inspector-v1/event-schedule-v1"
)
FREEZE_SHA256 = "bdc06cebb0351f83f243e24d4adb3372b17f790b2698f1349603aad010bec786"


def sha256(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


freeze_path = SOURCE / "FREEZE.json"
assert sha256(freeze_path) == FREEZE_SHA256, "frozen source manifest changed"
freeze = json.loads(freeze_path.read_text())
source_inputs = freeze["sourceInventory"]
assert len(source_inputs) == 105, "unexpected frozen source closure size"
for path, expected_hash in source_inputs.items():
    assert sha256(path) == expected_hash, f"frozen source hash changed: {path}"

model_path = HERE / "model.py.source"
generator_path = HERE / "regenerate.py.source"
archive_path = SOURCE / "SOURCE.zip"
inputs = dict(source_inputs)
inputs[str(freeze_path)] = FREEZE_SHA256
inputs[str(archive_path)] = sha256(archive_path)
inputs[str(model_path)] = sha256(model_path)
inputs[str(generator_path)] = sha256(generator_path)

basis = {
    "state": "SOURCE_FROZEN_MODEL_ONLY",
    "sourceCount": len(source_inputs),
    "sourceFreeze": {
        "path": str(freeze_path),
        "sha256": FREEZE_SHA256,
        "entrypoint": freeze["entrypoint"],
        "sourceOnlyEntrypoint": freeze["sourceOnlyEntrypoint"],
    },
    "sourceArchive": {"path": str(archive_path), "sha256": sha256(archive_path)},
    "inputs": inputs,
    "executionDependencies": [
        {"path": str(model_path), "sha256": sha256(model_path)},
        {"path": str(generator_path), "sha256": sha256(generator_path)},
    ],
    "runtimeOutputInputs": [],
    "limits": [
        "Finite source-derived two-schema, fourteen-checkpoint consumer trace; no runtime stdout is an input.",
        "Inspector reads are the pure public Cap.value_read path; their values are the retained typed leaf extent.",
        "Typed reader Stream.Position changes are distinct from Sys.Registry.cursor; the typed route uses Sys.run and leaves those registry cursors at zero.",
        "The relation-failure barrier and failure reader each advance World.clock once; the failure reader uses the tracked system path.",
        "Schedule observations cover the three successful registered-system dispatches in this fixture only.",
    ],
}
(HERE / "SOURCE-BASIS.json").write_text(json.dumps(basis, indent=2) + "\n")

model = runpy.run_path(str(model_path))
root = model["complete"]()
show = model["show"]
expected = model["expected"]()


def expect_position(position, ident, cursor, registered):
    assert position.name.endswith("event-runtime.Position")
    assert position.fields[0] == ident
    assert position.fields[1].value == cursor
    assert position.fields[2].value == registered


def expect_batch(batch, tick, values_count):
    assert batch.name.endswith("event-runtime.Batch")
    assert batch.fields[0].value == tick
    assert len(batch.fields[1]) == values_count


assert len(root.fields) == 2
reports = []
for schema, wrapped in zip(("workshop", "garden"), root.fields):
    assert wrapped.name == "Some"
    (report,) = wrapped.fields
    assert report.name == f"{schema}/consumer.Report"
    metadata, checkpoints, first_readings, second_readings, failures, schedules = report.fields
    assert metadata.name == f"{schema}/consumer.Metadata"
    assert len(checkpoints) == 14
    assert len(first_readings) == 2
    assert len(second_readings) == 1
    assert len(failures) == 1 and len(failures[0]) == 1
    assert len(schedules) == 3

    for phase, checkpoint in enumerate(checkpoints):
        assert checkpoint.name == f"{schema}/consumer.Checkpoint"
        description, inventory, physical, readers, args, inspected = checkpoint.fields
        first_inspection, second_inspection = inspected.fields
        assert show(first_inspection) == show(second_inspection), (schema, phase)
        if phase == 9:
            assert description.name == "None" and inventory.name == "None"
        else:
            assert description.name == "Some" and inventory.name == "Some"
        world, first_stream, second_stream, unused_stream, owners, journal, frame_start, failure_state, typed_tick = physical.fields
        expected_world_clock = 0 if phase < 2 else (1 if phase == 2 else 2)
        assert world.fields[13] == expected_world_clock, (schema, phase, "world clock")
        assert world.fields[0:3] == (1, 2, 1)
        assert world.fields[3] == "node(leaf:False,leaf:True)"
        assert world.fields[6] == "node(leaf:11,leaf:12)"
        assert world.fields[8] == "node(leaf:81,leaf:82)"
        assert world.fields[10].value == (1 if phase == 1 or phase >= 7 else 0)
        assert [entry.fields[0] for entry in world.fields[11]] == [4, 3, 2, 1]
        assert world.fields[12] == 5
        assert owners == "node(leaf:31,leaf:32)"
        assert args == "node(leaf:101,leaf:102)"
        expected_typed_tick = 0 if phase == 0 else (
            1 if phase < 4 else (
                2 if phase == 4 else (
                    3 if phase == 5 else (4 if phase == 6 else 5)
                )
            )
        )
        assert typed_tick.value == expected_typed_tick, (schema, phase, "typed tick")

        first_batches, first_positions = first_stream.fields[1:3]
        second_batches, second_positions = second_stream.fields[1:3]
        if phase == 0:
            assert first_batches == second_batches == []
            assert first_positions == second_positions == []
        if 1 <= phase < 11:
            assert len(first_batches) == len(second_batches) == (2 if phase >= 7 else 1)
            expect_batch(first_batches[0], 1, 1)
            expect_batch(second_batches[0], 1, 1)
        if phase >= 11:
            assert len(first_batches) == len(second_batches) == 1
            expect_batch(first_batches[0], 5, 1)
            expect_batch(second_batches[0], 5, 1)
            assert first_stream.fields[5].value == second_stream.fields[5].value == 5
            assert first_stream.fields[7].value == second_stream.fields[7].value == 1
        if phase == 4:
            expect_position(first_positions[0], 1, 2, 1)
        if phase == 5:
            expect_position(first_positions[0], 2, 3, 2)
            expect_position(first_positions[1], 1, 2, 1)
        if phase >= 6:
            expect_position(first_positions[0], 2, 3, 2)
            expect_position(first_positions[1], 1, 2, 1)
            expect_position(second_positions[0], 1, 4, 3)
        if phase >= 1:
            assert len(journal) == (1 if phase < 7 or phase >= 11 else 2)
        if phase == 10:
            assert len(first_batches) == len(second_batches) == 2
            assert first_stream.fields[5].value == second_stream.fields[5].value == 0
            assert first_stream.fields[7].value == second_stream.fields[7].value == 0

        failure_domains, failure_positions, failure_tick, failure_frame, failure_boundary, failure_capacity = failure_state.fields
        assert failure_tick.value == expected_world_clock
        assert failure_capacity.value == 65536
        if phase < 2:
            assert failure_domains == [] and failure_positions == []
        else:
            assert len(failure_domains) == 1
            domain = failure_domains[0]
            queue = domain.fields[1]
            front, back, size, dropped = queue.fields
            if phase < 12:
                assert front == [] and len(back) == 1 and size.value == 1 and dropped.value == 0
            elif phase == 12:
                assert len(front) == 1 and back == [] and size.value == 1 and dropped.value == 0
            else:
                assert front == back == [] and size.value == 0 and dropped.value == 1
            assert domain.fields[2] == ([] if phase < 3 else [4])
            if phase < 3:
                assert failure_positions == []
            else:
                expect_position(failure_positions[0], 4, 2, 1)
        assert failure_frame.value == (2 if phase >= 12 else 0)
        assert failure_boundary.value == (2 if phase >= 13 else 0)

        first, slow, second, failure = readers.fields
        assert [first.fields[9], slow.fields[9], second.fields[9]] == [0, 0, 0]
        assert failure.fields[5] == (0 if phase < 3 else 2), (schema, phase, "failure registry cursor")

        first_value, second_value = inspected.fields
        assert first_value.name == second_value.name == "Some"
        inspected_values = first_value.fields[0]
        if phase == 0:
            assert inspected_values == []
        if 1 <= phase < 7:
            assert len(inspected_values) == 1 and inspected_values[0].fields[0] == 7
        if 7 <= phase < 11:
            assert [item.fields[0] for item in inspected_values] == [7, 8]
        if phase >= 11:
            assert len(inspected_values) == 1 and inspected_values[0].fields[0] == 8

    expected_schedules = [[model["core"]("schedule", "Ran", i)] for i in (1, 2, 3)]
    assert show(schedules) == show(expected_schedules), (schema, "schedule observations")
    reports.append(report)

assert len(expected) > 0 and expected.endswith(b"\n")
compressed = gzip.compress(expected, mtime=0)
assert gzip.decompress(compressed) == expected
oracle_path = HERE / "expected.stdout.gz"
oracle_path.write_bytes(compressed)
basis_path = HERE / "SOURCE-BASIS.json"
basis_hash = sha256(basis_path)
raw_hash = hashlib.sha256(expected).hexdigest()
oracles = {
    "normal": {
        "stdout": str(oracle_path),
        "bytes": len(expected),
        "sha256": raw_hash,
        "sourceBasisPath": str(basis_path),
        "sourceBasisSHA256": basis_hash,
    }
}
(HERE / "ORACLES.json").write_text(json.dumps(oracles, indent=2) + "\n")

checks = {
    "status": "PASS",
    "sourceFreezeSHA256": FREEZE_SHA256,
    "sourceCount": len(source_inputs),
    "basisPins": len(inputs),
    "nominalSchemas": ["workshop", "garden"],
    "reports": len(reports),
    "checkpointsPerReport": 14,
    "checkpoints": sum(len(report.fields[1]) for report in reports),
    "inspectorReadPairs": 28,
    "inspectorReads": 56,
    "successfulScheduleRuns": 6,
    "runtimeOutputInputs": [],
    "stdoutBytes": len(expected),
    "stdoutSHA256": raw_hash,
    "assertions": [
        "all 105 sourceInventory hashes and exact FREEZE digest match",
        "source archive, independent model and regenerator are pinned",
        "each nominal source copy yields a complete Report with fourteen checkpoints",
        "each checkpoint carries two equal public Inspector values and phase-nine snapshot suppression",
        "World.clock is 0 before the barrier, 1 after the barrier, then 2 after the failure reader",
        "typed Stream.Position state is modeled independently of unchanged typed Sys.Registry.cursor fields",
        "failure Sys.Registry.cursor advances to World.clock 2 through the tracked failure-reader path",
        "each report retains actual Schedule observations Ran{1}, Ran{2}, Ran{3}",
        "complete canonical stdout is gzip-compressed with deterministic metadata and round-trips exactly",
    ],
}
(HERE / "CHECKS.json").write_text(json.dumps(checks, indent=2) + "\n")
print(f"{len(expected)} {raw_hash}")
