"""Independent getter-consumption countermodel for the frozen event/Schedule consumer.

The candidate public getter returns the retained typed leaf extent and then
advances reader 1 to the current route tick.  Both Inspector reads at every
checkpoint carry that owner update forward.  The two nominal schema copies run
the same fourteen-operation sequence; this model renders the complete reports
and physical state directly, with no runtime stdout as input.
"""
import json
import os
from pathlib import Path

SOURCE = Path(
    "/workspace/formal-proofs/bendvy-worktrees/observable-query-boundaries/"
    "experiments/public-inspect/promotion-stage/missing-resource-v1/"
    "direct-inspector-v1/event-schedule-v1"
)
CORE = Path("/workspace/formal-proofs/bendvy/src/ecs")


class Term:
    def __init__(self, name, *fields):
        self.name = name
        self.fields = fields


class Nat:
    def __init__(self, value):
        self.value = value

    def __str__(self):
        return f"{self.value}n"


def ctor(path, name, *fields):
    """Name a constructor by its source module path, as Bend's printer does."""
    path = Path(path)
    if path.is_absolute():
        module_path = path
    elif path.suffix == ".bend":
        module_path = CORE / path
    else:
        module_path = SOURCE / (str(path) + ".bend")
    module = os.path.relpath(module_path, SOURCE).removesuffix(".bend")
    return Term(module + "." + name, *fields)


def local(scene, file, name, *fields):
    return ctor(SOURCE / scene / f"{file}.bend", name, *fields)


def core(file, name, *fields):
    return ctor(f"{file}.bend", name, *fields)


def base(name, *fields):
    return Term(name, *fields)


def show(value):
    if isinstance(value, Term):
        return value.name + "{" + ", ".join(show(x) for x in value.fields) + "}"
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, list):
        return "[" + ", ".join(show(x) for x in value) + "]"
    if isinstance(value, bool):
        return "True{}" if value else "False{}"
    return str(value)


def some(value):
    return base("Some", value)


def product(left, right):
    return core("ordinary-app-observation-data", "Product", left, right)


def nat(value):
    return Nat(value)


def key():
    return core("internal/relation-failures/domains", "DeclaredKey", 2)


def descriptor():
    return core(
        "relation-types",
        "Descriptor",
        2,
        "Parent",
        "Children",
        core("relation-types", "Hierarchy"),
    )


def failure_notice():
    failure = core(
        "relation-types",
        "Failure",
        descriptor(),
        core("relation-types", "Relate"),
        1,
        1,
        core("relation-types", "SelfRelationNotAllowed", 1, "Parent"),
    )
    return core("relation-commands", "RelationFailed", failure)


def publication(scene, first=None, second=None):
    pair = core(
        "event-publication",
        "Publication",
        [local(scene, "fixture-1", "FirstEvent", first)] if first is not None else [],
        [local(scene, "fixture-1", "SecondEvent", second)] if second is not None else [],
    )
    return core("event-publication", "Publication", [pair], [])


def mixed_records(scene, entity, first, second):
    return [
        core("relation-commands", "Original", publication(scene, first=first)),
        core("relation-commands", "ComponentRemoved", entity),
        core("relation-commands", "Original", publication(scene, second=second)),
        core("relation-commands", "CleanupPaused", []),
    ]


def passthrough(entity):
    return [core("relation-commands", "ComponentRemoved", entity),
            core("relation-commands", "CleanupPaused", [])]


def batch(tick, values):
    return core("event-runtime", "Batch", nat(tick), values)


def unit():
    return base("Unit")


def description(scene, phase):
    cells = [
        core("relation-query", "Cell", "Parent",
             core("relation-query", "Outgoing"), core("relation-query", "Missing")),
        core("relation-query", "Cell", "Children",
             core("relation-query", "Incoming"), core("relation-query", "Missing")),
    ]
    row = core(
        "inspector-query",
        "ProjectedRow",
        core("world", "Handle", 1, 1),
        core("inspector-query-projection", "Product", unit(), cells),
    )
    rows = product(unit(), core("ordinary-app-relation", "View", descriptor(), [row]))
    for _ in range(4):
        rows = product(rows, unit())

    bindings = []
    for ident in range(1, 5):
        slot = "Signal" if ident < 4 else "Parent"
        name = "SignalReader" if ident < 4 else "ParentFailures"
        bindings.append(
            core(
                "ordinary-app-observation-data",
                "Binding",
                1,
                ident,
                name,
                [slot + ":read"],
                2 if ident == 4 and phase >= 3 else 0,
                slot,
                [core("ordinary-query-declaration", "Clause", slot,
                      core("ordinary-query-declaration", "Read"))],
            )
        )
    observation = core(
        "ordinary-app-observation-data",
        "Observation",
        rows,
        [
            "Relation{key=2|name=Parent|inverse=Children|kind=Hierarchy}",
            "1:1:[Parent:Outgoing:Missing, Children:Incoming:Missing]",
        ],
    )
    return core(
        "ordinary-app-schema",
        "Description",
        [],
        product(bindings, observation),
    )


def reader_views(scene, phase):
    typed = []
    for system_id, reader_id in ((1, 1), (2, 2), (3, 1)):
        typed.append(
            local(
                scene,
                "fixture-9",
                "TypedView",
                "Signal",
                core("ordinary-event-declaration", "Read"),
                1,
                reader_id,
                system_id,
                1,
                system_id,
                "SignalReader",
                ["Signal:read"],
                0,
            )
        )
    failure = local(
        scene,
        "fixture-9",
        "FailureView",
        descriptor(),
        1,
        4,
        "ParentFailures",
        ["Parent:read"],
        2 if phase >= 3 else 0,
        [key()],
    )
    return local(scene, "fixture-9", "View", *typed, failure)


def failure_domain(phase):
    if phase < 2:
        return []
    retained = phase < 13
    queued = core(
        "internal/relation-failures/queue",
        "Batch",
        nat(1),
        nat(1),
        [failure_notice()],
    )
    front = [queued] if phase == 12 else []
    back = [queued] if phase < 12 else []
    queue = core(
        "internal/relation-failures/queue",
        "Queue",
        front,
        back,
        nat(1 if retained else 0),
        nat(0 if retained else 1),
    )
    return [core("internal/relation-failures/domains", "Domain", key(), queue,
                 [4] if phase >= 3 else [])]


def route_tick(phase):
    """Route.Runtime.tick at each source checkpoint."""
    if phase == 0:
        return 0
    if phase < 4:
        return 1
    if phase == 4:
        return 2
    if phase == 5:
        return 3
    if phase == 6:
        return 4
    return 5


def stream(scene, kind, batches, phase):
    domain_name = "Source.UnusedEvent" if kind == "Unused" else "Signal"
    positions = []
    if kind == "First":
        # Candidate inspector-event-value.get calls Leaf.advance(reader 1,
        # tick) after selecting the pre-advance full retained values.  The
        # first checkpoint therefore activates id 1 at tick 0; each later
        # checkpoint leaves its cursor at the current Route.Runtime.tick.
        positions = [core("event-runtime", "Position", 1,
                           nat(route_tick(phase)), nat(0))]
        # The ordinary slow reader is first activated by scheduled read 2 at
        # route tick 2, then completes at tick 3. Its id 2 entry is prepended.
        if phase >= 5:
            positions = [core("event-runtime", "Position", 2,
                              nat(3), nat(2))] + positions
    elif kind == "Second" and phase >= 6:
        positions = [core("event-runtime", "Position", 1, nat(4), nat(3))]
    return core(
        "event-stream",
        "Stream",
        core("ordinary-event-declaration", "Domain", domain_name),
        batches,
        positions,
        3 if kind == "First" else (2 if kind == "Second" else 1),
        nat(5 if phase >= 10 else 0),
        nat(5 if phase >= 11 else 0),
        nat(2),
        nat(1 if phase >= 11 and kind != "Unused" else 0),
    )


def physical(scene, phase):
    """Full Physical.View, including arrays, queues, positions and retention."""
    clock = 0 if phase < 2 else (1 if phase == 2 else 2)
    typed_tick = route_tick(phase)

    world_events = [] if phase == 0 else mixed_records(scene, 1, 7, True)
    if phase >= 7:
        world_events += mixed_records(scene, 2, 8, False)
    if phase >= 11:
        world_events = passthrough(1) + mixed_records(scene, 2, 8, False)

    registrations = [
        core(
            "world",
            "RegistrationMeta",
            ident,
            "SignalReader" if ident < 4 else "ParentFailures",
            ["Signal:read" if ident < 4 else "Parent:read"],
        )
        for ident in (4, 3, 2, 1)
    ]
    world = local(
        scene,
        "fixture-7",
        "WorldView",
        1,
        2,
        1,
        "node(leaf:False,leaf:True)",
        2,
        nat(1),
        "node(leaf:11,leaf:12)",
        core("relation-types", "Graph", [], []),
        "node(leaf:81,leaf:82)",
        world_events,
        nat(1 if phase == 1 or phase >= 7 else 0),
        registrations,
        5,
        clock,
    )

    first_batches = []
    second_batches = []
    journal = []
    if 1 <= phase < 11:
        first_batches = [batch(1, [local(scene, "fixture-1", "FirstEvent", 7)])]
        second_batches = [batch(1, [local(scene, "fixture-1", "SecondEvent", True)])]
        journal = [batch(1, [publication(scene, first=7), publication(scene, second=True)])]
    if 7 <= phase < 11:
        first_batches += [batch(5, [local(scene, "fixture-1", "FirstEvent", 8)])]
        second_batches += [batch(5, [local(scene, "fixture-1", "SecondEvent", False)])]
        journal += [batch(5, [publication(scene, first=8), publication(scene, second=False)])]
    if phase >= 11:
        first_batches = [batch(5, [local(scene, "fixture-1", "FirstEvent", 8)])]
        second_batches = [batch(5, [local(scene, "fixture-1", "SecondEvent", False)])]
        journal = [batch(5, [publication(scene, first=8), publication(scene, second=False)])]

    failures = core(
        "event-notice-runtime",
        "Failures",
        failure_domain(phase),
        [core("event-runtime", "Position", 4, nat(2), nat(1))] if phase >= 3 else [],
        nat(clock),
        nat(2 if phase >= 12 else 0),
        nat(2 if phase >= 13 else 0),
        nat(65536),
    )
    return local(
        scene,
        "fixture-7",
        "View",
        world,
        stream(scene, "First", first_batches, phase),
        stream(scene, "Second", second_batches, phase),
        stream(scene, "Unused", [], phase),
        "node(leaf:31,leaf:32)",
        journal,
        nat(5 if phase >= 10 else 0),
        failures,
        nat(typed_tick),
    )


def inspector(scene, phase):
    """Two consecutive pure Cap.value_read calls over the full retained leaf."""
    values = []
    if 1 <= phase < 11:
        values.append(local(scene, "fixture-1", "FirstEvent", 7))
    if phase >= 7:
        values.append(local(scene, "fixture-1", "FirstEvent", 8))
    values = some(values)
    return local(scene, "consumer", "Inspection", values, values)


def checkpoint(scene, phase):
    enabled = phase != 9  # The source's repeated checkpoint passes False once.
    description_value = some(description(scene, phase)) if enabled else base("None")
    inventory = some(["Signal", "Signal", "Source.UnusedEvent"]) if enabled else base("None")
    return local(
        scene,
        "consumer",
        "Checkpoint",
        description_value,
        inventory,
        physical(scene, phase),
        reader_views(scene, phase),
        "node(leaf:101,leaf:102)",
        inspector(scene, phase),
    )


def report(scene):
    checkpoints = [checkpoint(scene, phase) for phase in range(14)]
    metadata = local(
        scene,
        "consumer",
        "Metadata",
        2,
        core("world", "Handle", 1, 1),
        core("world", "Accepted"),
        some(core("relation-commands", "Queued")),
    )
    # Reader 1 already advanced through tick 1 during the public Inspector
    # checkpoints before Scheduled.run dispatches the fast reader, so that
    # first actual read has no visible batch.  Reader 2 remains independent and
    # still observes the retained tick-1 event in the later slow dispatch.
    fast_first_reading = core("event-runtime", "Reading", [], False)
    slow_first_reading = core(
        "event-runtime",
        "Reading",
        [local(scene, "fixture-1", "FirstEvent", 7)],
        False,
    )
    second_reading = core(
        "event-runtime",
        "Reading",
        [local(scene, "fixture-1", "SecondEvent", True)],
        False,
    )
    failure_reading = core(
        "internal/relation-failures/readings",
        "KeyReading",
        key(),
        [failure_notice()],
        False,
    )
    schedules = [
        [core("schedule", "Ran", 1)],
        [core("schedule", "Ran", 2)],
        [core("schedule", "Ran", 3)],
    ]
    return some(
        local(
            scene,
            "consumer",
            "Report",
            metadata,
            checkpoints,
            [fast_first_reading, slow_first_reading],
            [second_reading],
            [[failure_reading]],
            schedules,
        )
    )


def complete():
    return product(report("workshop"), report("garden"))


def expected():
    return (show(complete()) + "\n").encode("utf-8")
