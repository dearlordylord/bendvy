"""UNBOUND host counter projection n+1 model; no runtime-output inputs.
Bound source08 factory allocation and implicit nominal printer geometry.
"""
import json, os
from pathlib import Path
TOP=Path('/workspace/formal-proofs/bendvy-worktrees/observable-query-boundaries/experiments/public-inspect/promotion-stage/missing-resource-v1/direct-inspector-v1/reached-v1/candidate')
CORE=Path('/workspace/formal-proofs/bendvy/src/ecs')
class Term:
    def __init__(self,name,*fields):self.name,self.fields=name,fields
def ctor(module,name,*fields):
    path=CORE/module if module.endswith('.bend') else TOP/(module+'.bend')
    return Term(os.path.relpath(path,TOP).removesuffix('.bend')+'.'+name,*fields)
def base(name,*fields):return Term(name,*fields)
def show(x):
    if isinstance(x,Term):return x.name+'{'+', '.join(map(show,x.fields))+'}'
    if isinstance(x,str):return json.dumps(x,ensure_ascii=False)
    if isinstance(x,list):return '['+', '.join(map(show,x))+']'
    return str(x)
def product(a,b):return ctor('ordinary-app-observation-data.bend','Product',a,b)
def value(present):return base('Some',[17,18]) if present else base('None')
def clauses():return [ctor('ordinary-query-declaration.bend','Clause','Payload',ctor('ordinary-query-declaration.bend','Read')),ctor('ordinary-query-declaration.bend','Clause','CallbackCounter',ctor('ordinary-query-declaration.bend','Write'))]
def physical(ns,present,registered,counter,clock=0):
    regs='['+', '.join(str(i)+':'+name+':[Payload, CallbackCounter]' for i,name in reversed(list(enumerate(['OptionalPayload','RequiredPayload'][:registered],1))))+']'
    payload='Present(N(L(17),L(18)))' if present else 'Missing'
    return f'world({ns},1,0,live=L(False),capacity=1,depth=0,store=N(L(31),L(32)),payload={payload},counter=L({counter}),sibling=N(L(27),L(28)),owners=N(L(901),L(902)),events=[],pending=1,regs={regs},nextSystem={registered+1},clock={clock})'
def snapshot(ns,present,registered,counter,clock=0,cursors=(0,0)):
    bindings=[ctor('ordinary-app-observation-data.bend','Binding',ns,i,name,['Payload','CallbackCounter'],cursors[i-1],name,clauses()) for i,name in enumerate(['OptionalPayload','RequiredPayload'][:registered],1)]
    rows=base('Unit')
    for _ in range(registered):rows=product(rows,value(present))
    rendered=['Payload,CallbackCounter='+('[17, 18]' if present else 'Unavailable')]*registered
    observation=ctor('ordinary-app-observation-data.bend','Observation',rows,rendered)
    return product(physical(ns,present,registered,counter,clock),base('Some',product(bindings,observation)))

def probe(present,counter,start):
    first=base('Done',product(value(present),[counter+1]))
    second=base('Done',product(value(present),[counter+1]))
    checked=base('Done',base('True')) if present else base('Fail',ctor('check.bend','MissingRuntimeRequirements',['Payload']))
    return ctor('host','Observation',first,f'Active:{start+1}:0',second,f'Active:{start+2}:0',checked)
def report(ns,present):
    optional=[snapshot(ns,present,1,0,0),snapshot(ns,present,1,0,2),snapshot(ns,present,1,1,2,(2,0)),snapshot(ns,present,1,1,4,(2,0))]
    required=[snapshot(ns,present,2,1,4,(2,0)),snapshot(ns,present,2,1,6,(2,0)),snapshot(ns,present,2,2 if present else 1,6,(2,6 if present else 0)),snapshot(ns,present,2,2 if present else 1,8,(2,6 if present else 0))]
    os=ctor('ordinary-app-optional-resource-run.bend','Succeeded',value(present))
    rs=ctor('ordinary-app-optional-resource-run.bend','Succeeded',value(present)) if present else ctor('ordinary-app-optional-resource-run.bend','Failed',ctor('check.bend','MissingRuntimeRequirements',['Payload']))
    hosts=[probe(present,0,0),probe(present,1,2),probe(present,1,4),probe(present,2 if present else 1,6)]
    return ctor('consumer','Report',physical(ns,present,0,0),optional,os,required,rs,hosts)
def complete():return product([report(1,False),report(2,True)],[report(1,False),report(2,True)])
def expected():return (show(complete())+'\n').encode()
