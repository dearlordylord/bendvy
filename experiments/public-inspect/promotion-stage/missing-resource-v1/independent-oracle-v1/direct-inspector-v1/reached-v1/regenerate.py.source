from pathlib import Path
import runpy,json,hashlib,gzip
P=Path(__file__).resolve().parent;sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest();b=json.loads((P/'SOURCE-BASIS.json').read_text())
for p,h in b['inputs'].items():assert sha(p)==h,p
m=runpy.run_path(str(P/'model.py.source'));n=runpy.run_path(str(P.parent/'model.py.source'));n['ctor'].__globals__['TOP']=m['TOP']
normal=n['expected']();mutant=m['expected']();old=runpy.run_path(str(P.parent/'model.py.source'))['expected']();assert len(old)==51702
changed=0
for ns,ms in zip(n['complete']().fields,m['complete']().fields):
 for nr,mr in zip(ns,ms):
  for fi,(nf,mf) in enumerate(zip(nr.fields,mr.fields)):
   if fi!=5:assert n['show'](nf)==m['show'](mf)
   else:
    for nh,mh in zip(nf,mf):
     for oi,(nv,mv) in enumerate(zip(nh.fields,mh.fields)):
      if oi in [0,2]:
       assert n['show'](nv.fields[0].fields[0])==m['show'](mv.fields[0].fields[0]);assert mv.fields[0].fields[1]==[nv.fields[0].fields[1][0]+1];changed+=1
      else:assert n['show'](nv)==m['show'](mv)
assert changed==32 and normal!=mutant
catalogue={}
for key,name,raw in [('mutant','expected.stdout.gz',mutant),('normalBaseline','normal.stdout.gz',normal),('historicalNormal','historical-normal.stdout.gz',old)]:
 (P/name).write_bytes(gzip.compress(raw,mtime=0));catalogue[key]={'stdout':str(P/name),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(P/'SOURCE-BASIS.json'),'sourceBasisSHA256':sha(P/'SOURCE-BASIS.json')}
(P/'ORACLES.json').write_text(json.dumps(catalogue,indent=2)+'\n');(P/'CHECKS.json').write_text(json.dumps({'status':'PASS','changedInspectorCounterResults':32,'sourceCount':b['sourceCount'],'basisPins':len(b['inputs']),'candidateQNameRebind':True,'runtimeOutputInputs':[]},indent=2)+'\n');print(json.dumps(catalogue))
