from pathlib import Path
import hashlib,json,gzip,runpy
P=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
b=json.loads((P/'SOURCE-BASIS.json').read_text())
for p,h in b['inputs'].items():assert sha(p)==h,p
m=runpy.run_path(str(P/'model.py.source')); reports=m['complete']([(1,2),(1,2)])
assert len(reports.fields)==2
for schema in reports.fields:
    assert len(schema)==2
    for present,r in enumerate(schema):
        initial,oreg,ostatus,oafter,orepeat,rreg,rstatus,rafter,rrepeat=r.fields
        assert ostatus.name.endswith('.Succeeded')
        assert rstatus.name.endswith('.Succeeded' if present else '.Failed')
        assert oafter is orepeat and rafter is rrepeat
        assert 'counter=L(0)' in initial
        assert 'counter=L(1)' in oafter.fields[0]
        assert 'counter=L('+str(2 if present else 1)+')' in rafter.fields[0]
        for snap in [oreg,oafter,orepeat,rreg,rafter,rrepeat]:
            assert 'pending=1' in snap.fields[0] and 'clock=0)' in snap.fields[0]
            assert 'sibling=N(L(27),L(28)),owners=N(L(901),L(902))' in snap.fields[0]
        assert len(oreg.fields[1].fields[0].fields[0])==1
        assert len(rreg.fields[1].fields[0].fields[0])==2
raw=m['expected']();(P/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
assert gzip.decompress((P/'expected.stdout.gz').read_bytes())==raw
basis=P/'SOURCE-BASIS.json'
(P/'ORACLES.json').write_text(json.dumps({'normal':{'stdout':str(P/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(basis),'sourceBasisSHA256':sha(basis)}},indent=2)+'\n')
(P/'CHECKS.json').write_text(json.dumps({'status':'PASS','sourceCount':b['sourceCount'],'basisPins':len(b['inputs']),'reports':4,'completeSnapshots':24,'assertions':['exact current source hashes','factory ns1/ns2 per nominal schema','optional succeeds with None/Some','required missing fails before callback','counter 0→1→1 missing / 0→1→2 present','all pending1 clock0 owners and repeated snapshots preserved','full output gzip roundtrip'],'runtimeOutputInputs':[]},indent=2)+'\n')
print(len(raw),hashlib.sha256(raw).hexdigest())
