   if t!='Base':visit(f.parent/t)
 visit(entry);oldinv=set(j['sourceInventory']);oldout=str(Path(j['generated']).parent);oldentry=j['entrypoint']
 def r(v):
  if isinstance(v,str):return v.replace(oldout,str(out)).replace(oldentry,str(entry))
  if isinstance(v,list):return [r(x)for x in v]
  if isinstance(v,dict):return {r(k):r(x)for k,x in v.items()}
  return v
 j=r(j);j.update(entrypoint=str(entry),stage=str(p),sourceInventory=inv,importClosure=c.validate_imports(entry,inv),cwd=str(p),scope='Current public stream modules ordinary Workshop complete whole18219 oracle; no new contract/performance/full55 claim')
 pins=dict(inv)
 for f in list(j['pins']):
