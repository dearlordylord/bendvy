 j['oracle']=str(p/'workshop-normal-expected.stdout.gz');j['normalOracle']=j['oracle'];pins[j['oracle']]=sha(j['oracle']);j['pins']=pins
 s=importlib.util.spec_from_file_location('guard',c.PLAN_GUARD);g=importlib.util.module_from_spec(s);s.loader.exec_module(g);g.validate(j,output_dir=out)
 raw=(json.dumps(j,indent=2)+'\n').encode();(out/'plan.json').write_bytes(raw);(p/('workshop-'+role+'-plan.json')).write_bytes(raw);cases.append({'role':role,'path':str(out/'plan.json'),'sha256':hashlib.sha256(raw).hexdigest(),'pins':len(pins),'sources':len(inv)})
(p/'WORKSHOP-SEQUENCE.json').write_text(json.dumps(cases,indent=2)+'\n');print(json.dumps(cases))
