# Affine invocation input and output, in addition to affine resource state.
type Args is Type:
  Args{flags:Array<Bool>}
def body_flag(~H:Type,~caps:D.write_ops(~C.Counter,~U32,H),owner:H,result:Array<Bool> & Bool) -> H & (T.Outcome<C.Error> & C.Output):
  match result:
    case (_,fail):C.body(~H,~caps,fail,owner)
def body(~H:Type,~caps:D.write_ops(~C.Counter,~U32,H),args:Args,owner:H) -> H & (T.Outcome<C.Error> & C.Output):
  match args:
    case Args{flags}:body_flag(~H,~caps,owner,Array.get(Bool,flags,0))
def declaration(~S:Data) -> D.Declaration<S,Col.Column<S,Unit>,C.Counter,U32,D.write_ops(~C.Counter,~U32),U32>:
  D.write(~S,~Col.Column<S,Unit>,~C.Counter,~U32,~U32,~C.view,~U32.show,Schema.resource(~S,~C.Counter,"Counter"))
def mode(value:Query.Mode) -> String:
  match value:
    case Query.Read{}:"Read"
    case Query.Write{}:"Write"
    case _:"OTHER"
def clause(~S:Data,value:Query.Clause<S>) -> String:
  match value:
    case Query.Clause{name,kind}:name ++ ":" ++ mode(kind)
def binding(~S:Data,value:App.Binding<S>) -> String:
  match value:
    case App.Binding{namespace,id,name,access,cursor,slot,clauses}:U32.show(namespace) ++ ":" ++ U32.show(id) ++ ":" ++ name ++ ":access=" ++ List.show(&2,String,(s=>s),access) ++ ":cursor=" ++ U32.show(cursor) ++ ":slot=" ++ slot ++ ":clauses=" ++ List.show(&2,Query.Clause<S>,clause(~S),clauses)
def debug(~S:Data,~Rows:Data,value:Maybe<&2,App.Product<List<&2,App.Binding<S>>,App.Observation<Rows>>>) -> String:
  match value:
    case None{}:"Disabled"
    case Some{App.Product{bindings,App.Observation{_,rendered}}}:"Debug{bindings=" ++ List.show(&2,App.Binding<S>,binding(~S),bindings) ++ "|resources=" ++ List.show(&2,String,(s=>s),rendered) ++ "}"
def args_value(result:Array<Bool> & Bool) -> String:
  match result:
    case (_,value):"RegistrationRejected{arg=" ++ Bool.show(value) ++ "}"
def rejected_args(args:Args) -> String:
  match args:
    case Args{flags}:args_value(Array.get(Bool,flags,0))
def world_observed(~S:Data,~H:Type,~Rows:Data,~kind:Query.Mode,~runFn:W.World<S,Col.Column<S,Unit>,C.Counter,U32> -> Args -> Sys.Outcome<W.World<S,Col.Column<S,Unit>,C.Counter,U32>,C.Error,C.Output>,~fold:W.World<S,Col.Column<S,Unit>,C.Counter,U32> -> W.World<S,Col.Column<S,Unit>,C.Counter,U32> & App.Observation<Rows>,~describe:(H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>) -> (H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>) & List<&2,App.Binding<S>>,owners:H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>,enabled:Bool,result:W.World<S,Col.Column<S,Unit>,C.Counter,U32> & String,label:String) -> App.ApplicationType<S,Col.Column<S,Unit>,C.Counter,U32,H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>,Rows,fold,describe> & String:
  match result:
    case (world,text):(App.Application{world,owners,enabled},label ++ "|world{" ++ text ++ "}")
def app_observed(~S:Data,~H:Type,~Rows:Data,~kind:Query.Mode,~runFn:W.World<S,Col.Column<S,Unit>,C.Counter,U32> -> Args -> Sys.Outcome<W.World<S,Col.Column<S,Unit>,C.Counter,U32>,C.Error,C.Output>,~fold:W.World<S,Col.Column<S,Unit>,C.Counter,U32> -> W.World<S,Col.Column<S,Unit>,C.Counter,U32> & App.Observation<Rows>,~describe:(H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>) -> (H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>) & List<&2,App.Binding<S>>,app:App.ApplicationType<S,Col.Column<S,Unit>,C.Counter,U32,H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>,Rows,fold,describe>,label:String) -> App.ApplicationType<S,Col.Column<S,Unit>,C.Counter,U32,H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>,Rows,fold,describe> & String:
  match app:
    case App.Application{world,owners,enabled}:world_observed(~S,~H,~Rows,~kind,~runFn,~fold,~describe,owners,enabled,C.world(~S,world),label)
def snapshot_observed(~S:Data,~H:Type,~Rows:Data,~kind:Query.Mode,~runFn:W.World<S,Col.Column<S,Unit>,C.Counter,U32> -> Args -> Sys.Outcome<W.World<S,Col.Column<S,Unit>,C.Counter,U32>,C.Error,C.Output>,~fold:W.World<S,Col.Column<S,Unit>,C.Counter,U32> -> W.World<S,Col.Column<S,Unit>,C.Counter,U32> & App.Observation<Rows>,~describe:(H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>) -> (H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>) & List<&2,App.Binding<S>>,result:App.ApplicationType<S,Col.Column<S,Unit>,C.Counter,U32,H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>,Rows,fold,describe> & Maybe<&2,App.Product<List<&2,App.Binding<S>>,App.Observation<Rows>>>) -> App.ApplicationType<S,Col.Column<S,Unit>,C.Counter,U32,H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>,Rows,fold,describe> & String:
  match result:
    case (app,value):app_observed(~S,~H,~Rows,~kind,~runFn,~fold,~describe,app,debug(~S,~Rows,value))
def snapshot(~S:Data,~H:Type,~Rows:Data,~kind:Query.Mode,~runFn:W.World<S,Col.Column<S,Unit>,C.Counter,U32> -> Args -> Sys.Outcome<W.World<S,Col.Column<S,Unit>,C.Counter,U32>,C.Error,C.Output>,~fold:W.World<S,Col.Column<S,Unit>,C.Counter,U32> -> W.World<S,Col.Column<S,Unit>,C.Counter,U32> & App.Observation<Rows>,~describe:(H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>) -> (H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>) & List<&2,App.Binding<S>>,app:App.ApplicationType<S,Col.Column<S,Unit>,C.Counter,U32,H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>,Rows,fold,describe>) -> App.ApplicationType<S,Col.Column<S,Unit>,C.Counter,U32,H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>,Rows,fold,describe> & String:
  snapshot_observed(~S,~H,~Rows,~kind,~runFn,~fold,~describe,App.snapshot(~S,~Col.Column<S,Unit>,~C.Counter,~U32,~(H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>),~Rows,~fold,~describe,app))
def outcome(~S:Data,~H:Type,~Rows:Data,~kind:Query.Mode,~runFn:W.World<S,Col.Column<S,Unit>,C.Counter,U32> -> Args -> Sys.Outcome<W.World<S,Col.Column<S,Unit>,C.Counter,U32>,C.Error,C.Output>,~fold:W.World<S,Col.Column<S,Unit>,C.Counter,U32> -> W.World<S,Col.Column<S,Unit>,C.Counter,U32> & App.Observation<Rows>,~describe:(H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>) -> (H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>) & List<&2,App.Binding<S>>,app:App.ApplicationType<S,Col.Column<S,Unit>,C.Counter,U32,H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>,Rows,fold,describe>,value:Sys.Outcome<Unit,C.Error,C.Output>) -> App.ApplicationType<S,Col.Column<S,Unit>,C.Counter,U32,H & P.Owner<S,Sys.Registry<S,Col.Column<S,Unit>,C.Counter,U32,Args,C.Error,C.Output,runFn>,kind>,Rows,fold,describe> & String:
