"""Read-only attribution of exact matched diagnostic profiles; no timer verdict."""
from pathlib import Path
from collections import Counter,defaultdict
import hashlib,json,re
HERE=Path(__file__).resolve().parent
OUT=Path("/tmp/bendvy-typed-data-events-capacity-count-needed02")
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def decode(name):
 value=re.sub(r"\$(\d{3})",lambda m:chr(int(m[1])),name).strip("$")
 return re.sub(r"~\d+$","",value)
def operation(path):return any("/trace:ticked" in decode(f.get("functionName","")) for f in path)
def owner(path):
 for f in reversed(path):
  if "$058" in f.get("functionName",""):return decode(f["functionName"]),f
 return "compiler/runtime under operation",path[-1]
def main():
 result={"scope":"Matched source geometry/fresh32 lifecycles/2304outside observations/544operations. Whole-process CPU100 and sampled allocation32768/includeGC. Operational ancestor=qualified-regular trace:ticked. Counts/estimated bytes are diagnostic, not elapsed speed or exact allocation/RSS.","subjects":{}}
 for role in ["before","after"]:
  base=OUT/role;js=base/"typed-events-32.js";text=js.read_text().splitlines();cpu=base/"cpu100.cpuprofile";heap=base/"allocation.heapprofile";data=json.loads(cpu.read_text());nodes={n["id"]:n for n in data["nodes"]};parents={c:n["id"] for n in data["nodes"] for c in n.get("children",[])}
  def chain(n):
   ids=[]
   while True:
    ids.append(n)
    if n not in parents:break
    n=parents[n]
   return [nodes[k]["callFrame"] for k in reversed(ids)]
  groups=Counter();targets=Counter();op=0
  for sample in data.get("samples",[]):
   path=chain(sample)
   if operation(path):
    op+=1;groups[owner(path)[0]]+=1
    for target in ["at_capacity","capacity_counted","capacity_loop","size","size_loop","count","count_loop","retained_one","synchronize_world","frame"]:
     if any(decode(f.get("functionName","")).endswith(":"+target) for f in path):targets[target]+=1
  grouped=defaultdict(lambda:{"sampledSelfSize":0,"sites":[]});total=0;sites=[]
  def walk(node,path):
   nonlocal total
   path=path+[node["callFrame"]];size=node.get("selfSize",0)
   if size and operation(path):
    total+=size;definition,frame=owner(path);line=frame.get("lineNumber",-1);entry={"selfSize":size,"owner":frame,"leaf":path[-1],"retainedPath":path,"generatedLine":text[line] if 0<=line<len(text) and Path(frame.get("url","")).name==js.name else None};sites.append(entry);grouped[definition]["sampledSelfSize"]+=size;grouped[definition]["sites"].append(entry)
   for child in node.get("children",[]):walk(child,path)
  walk(json.loads(heap.read_text())["head"],[])
  result["subjects"][role]={"generatedArtifact":{"path":str(js),"sha256":sha(js)},"CPU":{"path":str(cpu),"sha256":sha(cpu),"totalSamples":len(data.get("samples",[])),"operationalSamples":op,"groups":groups.most_common(),"overlappingTargetAncestorSamples":dict(targets)},"allocation":{"path":str(heap),"sha256":sha(heap),"operationalSampledSelfSize":total,"operationalSites":len(sites),"groups":[{"sourceDefinition":name,**value} for name,value in sorted(grouped.items(),key=lambda pair:-pair[1]["sampledSelfSize"])]}}
 (HERE/"needed-actual02/ATTRIBUTION.json").write_text(json.dumps(result,indent=2)+"\n")
 for role,item in result["subjects"].items():
  print(role,"CPU",item["CPU"]["operationalSamples"],"/",item["CPU"]["totalSamples"],"operational heap estimated",item["allocation"]["operationalSampledSelfSize"],"sites",item["allocation"]["operationalSites"])
  print("capacity owner",[(g["sourceDefinition"],g["sampledSelfSize"]) for g in item["allocation"]["groups"] if any(g["sourceDefinition"].endswith(":"+n) for n in ["at_capacity","capacity_checked","capacity_loop","capacity_counted"])])
if __name__=="__main__":main()
