"""Whole-process CPU/sample-allocation diagnostics on exact qualified artifacts; review required.
Uses unchanged Harness supervision, guards, telemetry, contract orders and validator.
"""
from pathlib import Path
import argparse,hashlib,importlib.util,importlib.machinery,json,random,shutil,statistics,sys
ROOT=Path('/workspace/formal-proofs/bendvy');sys.path.insert(0,str(ROOT/'benchmarks/parity-features'))
import execute,preflight,run as feature_loop
HERE=Path(__file__).resolve().parent
spec=importlib.util.spec_from_loader('interval_validator',importlib.machinery.SourceFileLoader('interval_validator',str(HERE.parent/'validate.py.source')));validator=importlib.util.module_from_spec(spec);spec.loader.exec_module(validator)
def main():
 parser=argparse.ArgumentParser();parser.add_argument('--plan',type=Path,required=True);parser.add_argument('--plan-sha',required=True);parser.add_argument('--quiet-window',required=True);args=parser.parse_args()
 sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
 assert sha(args.plan)==args.plan_sha,'Literal plan drift'
 plan=json.loads(args.plan.read_text());stage=Path(plan['stage']);output=Path(plan['output']);terminal=Path(plan['terminalRecord']);assert not terminal.exists(),'Fresh terminal record'
 h=None
 def binding():return {'planSHA256':sha(args.plan),'drift':[p for p,v in plan['pins'].items() if not Path(p).is_file() or sha(p)!=v]}
 try:
  initial=binding();assert not initial['drift'] and initial['planSHA256']==args.plan_sha;assert not output.exists()
  record=json.loads((stage/'stage.json').read_text())
  preflight.snapshot=lambda:{k:preflight.digest(ROOT/k) for k in record['sources']}
  def external():
   for directory,members in record['externalMembership'].items():
    d=Path(directory);assert sorted(str(p.relative_to(d)) for p in d.rglob('*') if p.is_file())==members,'Reference/Base membership drift'
   return {k:preflight.digest(Path(k)) for k in record['external']}
  preflight.external=external
  h=execute.Harness(stage,output)
  semantic=json.loads(Path(plan['semanticReceipt']).read_text());assert semantic['status']=='COMPLETE_TYPED_EVENT_INTERVAL_SEMANTICS';assert semantic['stageReceiptSHA']==h.receipt['stageReceiptSHA'];assert semantic['terminalPostguard']['harnessPostguard']=='UNCHANGED' and not semantic['terminalPostguard']['drift']
  # Reuse exact qualified artifacts, preserving their explicit source/receipt joins.
  artifacts={}
  for name,source in plan['qualifiedArtifacts'].items():
   target=output/name;shutil.copy2(source,target);h.pin(target);artifacts[name]=target
  commands={'TS':[h.tools['node'],h.stage/'feature-harness/typed-events-1.mjs'],'JS':[h.tools['node'],artifacts['typed-events-1.js']],'Native':[artifacts['typed-events-1'],'--threads','1','--gpu','off']}
  h.receipt.update(admissionContext=args.quiet_window,scope='Whole-process CPU and sampled allocation profiles including setup,17 operations,72 observations/render and shutdown; not interval-only allocation/CPU totals',semanticReceiptSHA=sha(plan['semanticReceipt']))
  wrapper=output/'allocate.mjs';shutil.copy2(HERE/'allocate.mjs',wrapper);h.pin(wrapper)
  for backend in ['JS','TS']:
   program=artifacts['typed-events-1.js'] if backend=='JS' else h.stage/'feature-harness/typed-events-1.mjs'
   for kind in ['cpu','allocation']:
    label=backend+'-'+kind;profile=output/(label+('.cpuprofile' if kind=='cpu' else '.heapprofile'));assert not profile.exists()
    command=[h.tools['node'],'--cpu-prof','--cpu-prof-dir='+str(output),'--cpu-prof-name='+profile.name,program] if kind=='cpu' else [h.tools['node'],wrapper,program,profile]
    current=binding();assert not current['drift'] and current['planSHA256']==args.plan_sha
    result=h.run(label,[h.tools['taskset'],'-c',str(plan['cpu']),*command],5)
    validator.validate(backend,result.stdout,result.stderr)
    assert profile.is_file();json.loads(profile.read_text());h.pin(profile)
  h.guard();h.receipt.update(status='COMPLETE_TYPED_EVENT_PROFILES_FULLY_VALIDATED',qualification='Descriptive whole-process profiles only; attribution must distinguish operation functions from observations/formatting/IO. No interval-exclusive profile totals or comparative performance verdict.')

 finally:
  primary=sys.exc_info()[1]
  try:post=binding()
  except Exception as error:post={'planSHA256':None,'drift':None,'bindingError':repr(error)}
  post['primaryError']=repr(primary) if primary else None
  if h:
   try:h.guard();post['harnessPostguard']='UNCHANGED'
   except Exception as error:post['harnessPostguard']={'error':repr(error)}
   h.receipt['terminalPostguard']=post;h.save()
  terminal.write_text(json.dumps(post,indent=2)+'\n')
  if primary is None:assert 'bindingError' not in post and not post['drift'] and post['planSHA256']==args.plan_sha and post.get('harnessPostguard')=='UNCHANGED','Terminal drift'
 print(h.receipt['status'])
if __name__=='__main__':main()
