"""Existing Harness registration: matched JS32 diagnostics and complete capacity controls.
Preparation only until exact changed-subject launch review and root admission.
"""
from pathlib import Path
import argparse,gzip,hashlib,importlib.machinery,importlib.util,json,shutil,sys
ROOT=Path("/workspace/formal-proofs/bendvy")
sys.path.insert(0,str(ROOT/"benchmarks/parity-features"))
import execute,preflight
HERE=Path(__file__).resolve().parent
INTERVAL=HERE.parent.parent.parent
def sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def load(name,path):
 spec=importlib.util.spec_from_loader(name,importlib.machinery.SourceFileLoader(name,str(path)))
 module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module);return module
def validate(catalogue,key,result):
 item=json.loads(Path(catalogue).read_text())[key];expected=gzip.decompress(Path(item["gzip"]).read_bytes())
 assert len(expected)==item["bytes"] and hashlib.sha256(expected).hexdigest()==item["sha256"]
 assert result.stdout==expected,"Complete independent observation mismatch"
def configure(stage):
 record=json.loads((stage/"stage.json").read_text())
 preflight.snapshot=lambda:{k:preflight.digest(ROOT/k) for k in record["sources"]}
 def external():
  for directory,members in record["externalMembership"].items():
   d=Path(directory);assert sorted(str(p.relative_to(d)) for p in d.rglob("*") if p.is_file())==members,"External membership drift"
  return {k:preflight.digest(Path(k)) for k in record["external"]}
 preflight.external=external
def pure(h,label,entry,catalogue,key):
 h.run(label+"-check",[h.tools["bend"],entry,"--check-only"],5)
 js=h.output/(label+".js");c=h.output/(label+".c");binary=h.output/label
 for p in [js,c,binary]:assert not p.exists()
 h.run(label+"-emit-JS",[h.tools["bend"],entry,"-o",js],30);h.pin(js)
 h.run(label+"-emit-Native",[h.tools["bend"],entry,"-o",c],30);h.pin(c)
 h.run(label+"-compile",[h.tools["clang"],"-O3",c,"-o",binary,"-pthread","-lm"],120);h.pin(binary)
 for backend,command in [("JS",[h.tools["node"],js]),("Native",[binary,"--threads","1","--gpu","off"])]:
  result=h.run(label+"-"+backend,[h.tools["taskset"],"-c","11",*command],5);validate(catalogue,key,result)
def main():
 parser=argparse.ArgumentParser();parser.add_argument("--plan",type=Path,required=True);parser.add_argument("--plan-sha",required=True);args=parser.parse_args()
 assert sha(args.plan)==args.plan_sha,"Literal plan drift"
 plan=json.loads(args.plan.read_text());output=Path(plan["output"]);terminal=Path(plan["terminalRecord"]);assert not terminal.exists();h=None;harnesses=[]
 def binding():return {"planSHA256":sha(args.plan),"drift":[p for p,v in plan["pins"].items() if not Path(p).is_file() or sha(p)!=v]}
 try:
  initial=binding();assert initial["planSHA256"]==args.plan_sha and not initial["drift"];assert not output.exists();output.mkdir()
  # Complete pure boundary controls on both exact bodies, then the actual full
  # capacity/rollback workload on the candidate before diagnostic profiles.
  for role in ["before","after"]:
   stage=Path(plan[role+"Stage"]);configure(stage);h=execute.Harness(stage,output/role);harnesses.append((role,h))
   pure(h,"boundary",h.stage/"feature-harness/capacity-boundary.bend",plan["catalogue"],"boundary")
   if role=="after":pure(h,"capacity",h.stage/"qualified-capacity/main.bend",plan["catalogue"],"capacity")
   h.receipt.update(status="COMPLETE_CAPACITY_CONTROLS",scope="Actual complete inputs and outputs; no universal proof or performance claim");h.save()
  evaluation=load("capacity_count_evaluation",INTERVAL/"evaluation-check.py.source")
  repeated=load("capacity_count_repeat",HERE.parent/"validate.py.source")
  for role,h in harnesses:
   configure(Path(plan[role+"Stage"]));entry=h.stage/"feature-harness/typed-events-32.bend"
   checked=h.run("repeat-check",[h.tools["bend"],entry,"--check-only"],5,False)
   assert b"defs rely on unsafe or foreign code" in checked.stderr and b"timing.capture" in checked.stderr
   js=h.output/"typed-events-32.js";assert not js.exists()
   h.run("repeat-emit-JS",[h.tools["bend"],entry,"-o",js],30);h.pin(js)
   finding=evaluation.check(js,Path(plan["qualifiedNative1C"]))
   finding["NativeScope"]="Previously qualified candidate regular1 C barrier only; no Native32 rebuild/qualification"
   (h.output/"evaluation.json").write_text(json.dumps(finding,indent=2)+"\n");h.pin(h.output/"evaluation.json")
   h.run("timer-protocol",[h.tools["taskset"],"-c","11",h.tools["node"],INTERVAL/"controls.mjs"],5)
   result=h.run("repeat-correctness",[h.tools["taskset"],"-c","11",h.tools["node"],js],5);repeated.validate("JS",result.stdout,result.stderr)
  # Both complete32 subjects must match before any profiled diagnostic.
  for role,h in harnesses:
   configure(Path(plan[role+"Stage"]));js=h.output/"typed-events-32.js"
   wrapper=h.output/"allocate.mjs";shutil.copy2(HERE.parent.parent/"allocate.mjs",wrapper);h.pin(wrapper)
   for kind in ["cpu100","allocation"]:
    profile=h.output/(kind+(".cpuprofile" if kind=="cpu100" else ".heapprofile"));assert not profile.exists()
    command=[h.tools["node"],"--cpu-prof","--cpu-prof-interval=100","--cpu-prof-dir="+str(h.output),"--cpu-prof-name="+profile.name,js] if kind=="cpu100" else [h.tools["node"],wrapper,js,profile]
    result=h.run(kind,[h.tools["taskset"],"-c","11",*command],5);repeated.validate("JS",result.stdout,result.stderr);assert profile.is_file();json.loads(profile.read_text());h.pin(profile)
   h.guard();h.receipt.update(status="COMPLETE_MATCHED_JS32_DIAGNOSTICS",scope="Same32 fresh lifecycles, full2304 rows and544 operations; whole-process CPU100 and sampled allocation32768; no comparative speed verdict");h.save()
 finally:
  primary=sys.exc_info()[1]
  try:post=binding()
  except Exception as error:post={"planSHA256":None,"drift":None,"bindingError":repr(error)}
  post["primaryError"]=repr(primary) if primary else None;post["harnessPostguards"]={}
  for role,owned in harnesses:
   try:configure(Path(plan[role+"Stage"]));owned.guard();post["harnessPostguards"][role]="UNCHANGED"
   except Exception as error:post["harnessPostguards"][role]={"error":repr(error)}
   owned.receipt["terminalPostguard"]=post;owned.save()
  terminal.write_text(json.dumps(post,indent=2)+"\n")
  if primary is None:assert "bindingError" not in post and not post["drift"] and post["planSHA256"]==args.plan_sha and len(harnesses)==2 and all(v=="UNCHANGED" for v in post["harnessPostguards"].values())
 print("COMPLETE_MATCHED_CAPACITY_CONTROLS_AND_JS32_DIAGNOSTICS")
if __name__=="__main__":main()
