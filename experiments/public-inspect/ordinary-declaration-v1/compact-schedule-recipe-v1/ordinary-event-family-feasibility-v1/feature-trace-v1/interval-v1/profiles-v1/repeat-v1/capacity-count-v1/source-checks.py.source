import hashlib, json, os, subprocess, time
from pathlib import Path
BASE=Path(__file__).resolve().parent
TOOL=Path("/home/node/.bend/bin/bend-2.0.35")
subjects=[("after-boundary",Path("/tmp/bendvy-typed-data-events-capacity-count-after-stage02/stage/feature-harness/capacity-boundary.bend")),("after-capacity",Path("/tmp/bendvy-typed-data-events-capacity-count-after-stage02/stage/qualified-capacity/main.bend")),("before-boundary",Path("/tmp/bendvy-typed-data-events-capacity-count-before-stage02/stage/feature-harness/capacity-boundary.bend"))]
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def closure(p,seen=None):
 seen={} if seen is None else seen
 p=p.resolve()
 if str(p) in seen:return seen
 seen[str(p)]=sha(p)
 for line in p.read_text().splitlines():
  if line.startswith("import "):
   rel=line.split()[1]
   if rel=="Base":seen["/home/node/.bend/bend2/base.bend"]=sha(Path("/home/node/.bend/bend2/base.bend"))
   else:closure(p.parent/rel,seen)
 return seen
for label,subject in subjects:
 out=BASE/"checks"/"needed-source02"/label
 out.mkdir(parents=True,exist_ok=False)
 pins=closure(subject);pins[str(TOOL)]=sha(TOOL)
 command=["flock","/tmp/bendvy-parity-heavy.lock","timeout","-s","KILL","5",str(TOOL),"--check-only",str(subject)]
 start=time.time();env=os.environ.copy();env["BEND_NO_TELEMETRY"]="1"
 with (out/"stdout").open("wb") as stdout,(out/"stderr").open("wb") as stderr:
  result=subprocess.run(command,stdout=stdout,stderr=stderr,env=env)
 post={p:sha(Path(p)) for p in pins}
 record={"command":command,"exitCode":result.returncode,"elapsedSeconds":time.time()-start,"sourcePins":pins,"postPins":post,"unchanged":post==pins,"scope":"stock5 source-only; no backend or performance qualification"}
 (out/"SOURCE.json").write_text(json.dumps(record,indent=2)+"\n")
 print(label,result.returncode,"unchanged",post==pins,flush=True)
 if result.returncode!=0 or post!=pins:raise SystemExit(1)
