"""Prepare exact qualified stage plus literal complete-lifecycle wrappers, no child."""
from pathlib import Path
import argparse,json,hashlib,shutil
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def main():
 a=argparse.ArgumentParser();a.add_argument('--output',type=Path,required=True);args=a.parse_args();assert not args.output.exists()
 old=Path('/tmp/bendvy-typed-data-events-interval-stage09');record=json.loads((old/'stage.json').read_text())
 assert all(sha(old/'stage'/p)==v for p,v in record['stageInventory'].items())
 args.output.mkdir();stage=args.output/'stage';shutil.copytree(old/'stage',stage)
 target=stage/'qualified-regular/interval-v1/profiles-v1/repeat-v1';target.mkdir(parents=True)
 for p in HERE.iterdir():
  if p.is_file() and p.name!='PLAN.json':shutil.copy2(p,target/p.name);record['external'][str(p)]=sha(p)
 wrapper=HERE.parent/'allocate.mjs';dest=target.parent/'allocate.mjs';shutil.copy2(wrapper,dest);record['external'][str(wrapper)]=sha(wrapper)
 (stage/'feature-harness/typed-events-32.bend').write_text('import Base\nimport ../qualified-regular/interval-v1/profiles-v1/repeat-v1/main.bend as I\ndef main() -> IO(Unit):I.main()\n')
 (stage/'feature-harness/typed-events-32.mjs').write_text("import '../qualified-regular/interval-v1/profiles-v1/repeat-v1/reference.mjs';\n")
 catalogue=Path('/workspace/formal-proofs/bendvy-worktrees/native54-matching-tree-v1/experiments/public-inspect/typed-data-events-oracle-v1/feature-v1/interval-v1/repeat-v1')
 assert (catalogue/'ORACLES.json').is_file(),'Independent repeat catalogue required before plan freeze'
 for p in catalogue.rglob('*'):
  if p.is_file():record['external'][str(p)]=sha(p)
 record['stageInventory']={str(p.relative_to(stage)):sha(p) for p in sorted(stage.rglob('*')) if p.is_file()};record.update(features=['typed-events'],scales=[32],lifecycles=32,timingScope='Fixed32fullfreshlifecycles;544publicoperations/2304observations,notcomparativescaling')
 (args.output/'stage.json').write_text(json.dumps(record,indent=2)+'\n');print(args.output/'stage.json')
if __name__=='__main__':main()
