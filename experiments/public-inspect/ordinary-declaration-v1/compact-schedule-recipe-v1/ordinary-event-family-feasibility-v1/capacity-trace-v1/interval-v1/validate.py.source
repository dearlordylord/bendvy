"""Complete platform oracle and interval protocol; no timing criterion."""
import gzip,hashlib,json
from pathlib import Path
CATALOGUE=Path('/workspace/formal-proofs/bendvy-worktrees/native54-matching-tree-v1/experiments/public-inspect/typed-data-events-oracle-v1/capacity-v1/ORACLES.json')
def validate(backend,stdout,stderr):
 key='ts' if backend=='TS' else 'bend';selected=json.loads(CATALOGUE.read_text())[key];expected=gzip.decompress(Path(selected['gzip']).read_bytes())
 assert len(expected)==selected['bytes'] and hashlib.sha256(expected).hexdigest()==selected['sha256']
 assert stdout==expected,'Complete12row platform observation mismatch'
 region=json.loads(stderr);assert region['intervals']==11 and int(region['elapsedNs'])>=0
 digest=2166136261
 for b in stdout:digest=((digest^b)*16777619)&0xffffffff
 assert region['bytes']==len(stdout) and region['digest']==digest
 return region
