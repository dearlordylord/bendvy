# The same ordinary resource declaration drives registration, observation and metadata.
def defined(~S:Data,~C:Type,~R:Type,~E:Data,~Owners:Type,~Rows:Data,~observe:W.World<S,C,R,E> -> W.World<S,C,R,E> & DTO.Observation<Rows>,~describe:Owners -> Owners & List<&2,DTO.Binding<S>>,~Ops:Type -> Type,~Args:Type,~Error:Data,~Out:Type,~Value:Data,~declaration:D.Declaration<S,C,R,E,Ops,Value>,~body:@-H:Type -> @-caps:Ops(H) -> Args -> H -> H & (T.Outcome<Error> & Out),~Output:Type,~done:@-NextOwners:Type -> @-NextRows:Data -> @-nextObserve:(W.World<S,C,R,E> -> W.World<S,C,R,E> & DTO.Observation<NextRows>) -> @-nextDescribe:(NextOwners -> NextOwners & List<&2,DTO.Binding<S>>) -> Build.Registered<S,W.World<S,C,R,E>,NextOwners,NextRows,nextObserve,nextDescribe> -> Output,failed:Build.Registered<S,W.World<S,C,R,E>,Owners,Rows,observe,describe> -> Output,owners:Owners,recipe:Tree.Recipe<W.World<S,C,R,E>,Rows,observe>,debug:Bool,result:P.Defined<S,W.World<S,C,R,E>,Sys.Registry<S,C,R,E,Args,Error,Out,P.runner(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~D.ordinary(~S,~C,~R,~E,~Ops,~Value,declaration),~body)>,P.mode(~S,~R,~T.Tx<W.World<S,C,R,E>,E>,~Ops(T.Tx<W.World<S,C,R,E>,E>),D.ordinary(~S,~C,~R,~E,~Ops,~Value,declaration))>) -> Output:
  match result:
    case P.Rejected{world}:failed(Build.Registered{world,owners,recipe,debug})
    case P.Defined{world,owner}:done(Owners & P.Owner<S,Sys.Registry<S,C,R,E,Args,Error,Out,P.runner(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~D.ordinary(~S,~C,~R,~E,~Ops,~Value,declaration),~body)>,P.mode(~S,~R,~T.Tx<W.World<S,C,R,E>,E>,~Ops(T.Tx<W.World<S,C,R,E>,E>),D.ordinary(~S,~C,~R,~E,~Ops,~Value,declaration))>,DTO.Product<Rows,Value>,Tree.observe_pair(~W.World<S,C,R,E>,~Rows,~Value,~observe,~Leaves.resource_observe(~S,~C,~R,~E,~Ops,~Value,~declaration)),Tree.describe_pair(~S,~Owners,~P.Owner<S,Sys.Registry<S,C,R,E,Args,Error,Out,P.runner(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~D.ordinary(~S,~C,~R,~E,~Ops,~Value,declaration),~body)>,P.mode(~S,~R,~T.Tx<W.World<S,C,R,E>,E>,~Ops(T.Tx<W.World<S,C,R,E>,E>),D.ordinary(~S,~C,~R,~E,~Ops,~Value,declaration))>,~describe,~Leaves.resource_describe(~S,~C,~R,~E,~Args,~Error,~Out,~P.runner(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~D.ordinary(~S,~C,~R,~E,~Ops,~Value,declaration),~body),~P.mode(~S,~R,~T.Tx<W.World<S,C,R,E>,E>,~Ops(T.Tx<W.World<S,C,R,E>,E>),D.ordinary(~S,~C,~R,~E,~Ops,~Value,declaration)))),Build.appended(~S,~W.World<S,C,R,E>,~Owners,~Rows,~observe,~describe,~P.Owner<S,Sys.Registry<S,C,R,E,Args,Error,Out,P.runner(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~D.ordinary(~S,~C,~R,~E,~Ops,~Value,declaration),~body)>,P.mode(~S,~R,~T.Tx<W.World<S,C,R,E>,E>,~Ops(T.Tx<W.World<S,C,R,E>,E>),D.ordinary(~S,~C,~R,~E,~Ops,~Value,declaration))>,~Value,~Leaves.resource_observe(~S,~C,~R,~E,~Ops,~Value,~declaration),~Leaves.resource_describe(~S,~C,~R,~E,~Args,~Error,~Out,~P.runner(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~D.ordinary(~S,~C,~R,~E,~Ops,~Value,declaration),~body),~P.mode(~S,~R,~T.Tx<W.World<S,C,R,E>,E>,~Ops(T.Tx<W.World<S,C,R,E>,E>),D.ordinary(~S,~C,~R,~E,~Ops,~Value,declaration))),world,owners,owner,debug))
def register(~S:Data,~C:Type,~R:Type,~E:Data,~Owners:Type,~Rows:Data,~observe:W.World<S,C,R,E> -> W.World<S,C,R,E> & DTO.Observation<Rows>,~describe:Owners -> Owners & List<&2,DTO.Binding<S>>,~Ops:Type -> Type,~Args:Type,~Error:Data,~Out:Type,~Value:Data,~declaration:D.Declaration<S,C,R,E,Ops,Value>,~body:@-H:Type -> @-caps:Ops(H) -> Args -> H -> H & (T.Outcome<Error> & Out),~Output:Type,~done:@-NextOwners:Type -> @-NextRows:Data -> @-nextObserve:(W.World<S,C,R,E> -> W.World<S,C,R,E> & DTO.Observation<NextRows>) -> @-nextDescribe:(NextOwners -> NextOwners & List<&2,DTO.Binding<S>>) -> Build.Registered<S,W.World<S,C,R,E>,NextOwners,NextRows,nextObserve,nextDescribe> -> Output,failed:Build.Registered<S,W.World<S,C,R,E>,Owners,Rows,observe,describe> -> Output,app:Build.Registered<S,W.World<S,C,R,E>,Owners,Rows,observe,describe>,name:String,slot:String) -> Output:
  match app:
    case Build.Registered{world,owners,recipe,debug}:defined(~S,~C,~R,~E,~Owners,~Rows,~observe,~describe,~Ops,~Args,~Error,~Out,~Value,~declaration,~body,~Output,~done,failed,owners,recipe,debug,P.define(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~D.ordinary(~S,~C,~R,~E,~Ops,~Value,declaration),~body,world,name,slot))
