def unit_argument(unit:Unit) -> Unit:
  unit
def adapted(~S:Data,~C:Type,~R:Type,~E:Data,~CE:Data,~RE:Data,~kind:Query.Mode,~crun:W.World<S,C,R,E> -> (Unit & U32) -> Sys.Outcome<W.World<S,C,R,E>,CE,List<&2,Unit>>,~rrun:W.World<S,C,R,E> -> Unit -> Sys.Outcome<W.World<S,C,R,E>,RE,Unit>,needs:List<&2,SP.Requirement<S>>,result:Sch.RunResult<S,C,R,E,(Ord.Owner<S,Sys.Registry<S,C,R,E,Unit & U32,CE,List<&2,Unit>,crun>> & Res.Owner<S,Sys.Registry<S,C,R,E,Unit,RE,Unit,rrun>,kind>),D.Error<CE,RE>> & Maybe<D.Arguments<Unit,Unit>>) -> SP.ProvisionResult<S,C,R,E,(Ord.Owner<S,Sys.Registry<S,C,R,E,Unit & U32,CE,List<&2,Unit>,crun>> & Res.Owner<S,Sys.Registry<S,C,R,E,Unit,RE,Unit,rrun>,kind>),D.Error<CE,RE>> & Maybe<D.Arguments<Unit,Unit>>:
  match result:
    case (result,refused):(SP.Executed{result,needs},refused)
def allowed(~S:Data,~C:Type,~R:Type,~E:Data,~CE:Data,~RE:Data,~kind:Query.Mode,~crun:W.World<S,C,R,E> -> (Unit & U32) -> Sys.Outcome<W.World<S,C,R,E>,CE,List<&2,Unit>>,~rrun:W.World<S,C,R,E> -> Unit -> Sys.Outcome<W.World<S,C,R,E>,RE,Unit>,~condition:W.World<S,C,R,E> -> U32 -> W.World<S,C,R,E> & Bool,~available:W.World<S,C,R,E> -> W.World<S,C,R,E> & List<&2,SP.Requirement<S>>,matches:Bool,owners:(Ord.Owner<S,Sys.Registry<S,C,R,E,Unit & U32,CE,List<&2,Unit>,crun>> & Res.Owner<S,Sys.Registry<S,C,R,E,Unit,RE,Unit,rrun>,kind>),world:W.World<S,C,R,E>,namespace:U32,name:String,steps:List<&2,Sch.Step>,needs:List<&2,SP.Requirement<S>>) -> SP.ProvisionResult<S,C,R,E,(Ord.Owner<S,Sys.Registry<S,C,R,E,Unit & U32,CE,List<&2,Unit>,crun>> & Res.Owner<S,Sys.Registry<S,C,R,E,Unit,RE,Unit,rrun>,kind>),D.Error<CE,RE>> & Maybe<D.Arguments<Unit,Unit>>:
  match matches:
    case False{}:(SP.Executed{Sch.Rejected{Sch.Schedule{namespace,name,steps,owners},world},needs},None{})
    case True{}:adapted(~S,~C,~R,~E,~CE,~RE,~kind,~crun,~rrun,needs,Adapter.run(~S,~C,~R,~E,~(Ord.Owner<S,Sys.Registry<S,C,R,E,Unit & U32,CE,List<&2,Unit>,crun>> & Res.Owner<S,Sys.Registry<S,C,R,E,Unit,RE,Unit,rrun>,kind>),~CE,~RE,~condition,[owners=>world=>id=>Dispatch.dispatch(~S,~C,~R,~E,~Unit,~CE,~Unit,~Unit,~RE,~Unit,~kind,~crun,~rrun,~unit_argument,~unit_argument,owners,world,id),owners=>world=>id=>Dispatch.dispatch(~S,~C,~R,~E,~Unit,~CE,~Unit,~Unit,~RE,~Unit,~kind,~crun,~rrun,~unit_argument,~unit_argument,owners,world,id)],Sch.Schedule{namespace,name,steps,owners},world))
def validated(~S:Data,~C:Type,~R:Type,~E:Data,~CE:Data,~RE:Data,~kind:Query.Mode,~crun:W.World<S,C,R,E> -> (Unit & U32) -> Sys.Outcome<W.World<S,C,R,E>,CE,List<&2,Unit>>,~rrun:W.World<S,C,R,E> -> Unit -> Sys.Outcome<W.World<S,C,R,E>,RE,Unit>,~condition:W.World<S,C,R,E> -> U32 -> W.World<S,C,R,E> & Bool,~available:W.World<S,C,R,E> -> W.World<S,C,R,E> & List<&2,SP.Requirement<S>>,namespace:U32,name:String,steps:List<&2,Sch.Step>,needs:List<&2,SP.Requirement<S>>,result:(Ord.Owner<S,Sys.Registry<S,C,R,E,Unit & U32,CE,List<&2,Unit>,crun>> & Res.Owner<S,Sys.Registry<S,C,R,E,Unit,RE,Unit,rrun>,kind>) & (W.World<S,C,R,E> & Bool)) -> SP.ProvisionResult<S,C,R,E,(Ord.Owner<S,Sys.Registry<S,C,R,E,Unit & U32,CE,List<&2,Unit>,crun>> & Res.Owner<S,Sys.Registry<S,C,R,E,Unit,RE,Unit,rrun>,kind>),D.Error<CE,RE>> & Maybe<D.Arguments<Unit,Unit>>:
  match result:
    case (owners,(world,matches)):allowed(~S,~C,~R,~E,~CE,~RE,~kind,~crun,~rrun,~condition,~available,matches,owners,world,namespace,name,steps,needs)
def schedule_validated(~S:Data,~C:Type,~R:Type,~E:Data,~CE:Data,~RE:Data,~kind:Query.Mode,~crun:W.World<S,C,R,E> -> (Unit & U32) -> Sys.Outcome<W.World<S,C,R,E>,CE,List<&2,Unit>>,~rrun:W.World<S,C,R,E> -> Unit -> Sys.Outcome<W.World<S,C,R,E>,RE,Unit>,~condition:W.World<S,C,R,E> -> U32 -> W.World<S,C,R,E> & Bool,~available:W.World<S,C,R,E> -> W.World<S,C,R,E> & List<&2,SP.Requirement<S>>,needs:List<&2,SP.Requirement<S>>,world:W.World<S,C,R,E>,schedule:Sch.Schedule<S,C,R,E,(Ord.Owner<S,Sys.Registry<S,C,R,E,Unit & U32,CE,List<&2,Unit>,crun>> & Res.Owner<S,Sys.Registry<S,C,R,E,Unit,RE,Unit,rrun>,kind>)>) -> SP.ProvisionResult<S,C,R,E,(Ord.Owner<S,Sys.Registry<S,C,R,E,Unit & U32,CE,List<&2,Unit>,crun>> & Res.Owner<S,Sys.Registry<S,C,R,E,Unit,RE,Unit,rrun>,kind>),D.Error<CE,RE>> & Maybe<D.Arguments<Unit,Unit>>:
  match schedule:
    case Sch.Schedule{namespace,name,steps,owners}:validated(~S,~C,~R,~E,~CE,~RE,~kind,~crun,~rrun,~condition,~available,namespace,name,steps,needs,Validation.validate(~S,~C,~R,~E,~Unit,~CE,~Unit,~Unit,~RE,~Unit,~kind,~crun,~rrun,owners,world))
def provision_checked(~S:Data,~C:Type,~R:Type,~E:Data,~CE:Data,~RE:Data,~kind:Query.Mode,~crun:W.World<S,C,R,E> -> (Unit & U32) -> Sys.Outcome<W.World<S,C,R,E>,CE,List<&2,Unit>>,~rrun:W.World<S,C,R,E> -> Unit -> Sys.Outcome<W.World<S,C,R,E>,RE,Unit>,~condition:W.World<S,C,R,E> -> U32 -> W.World<S,C,R,E> & Bool,~available:W.World<S,C,R,E> -> W.World<S,C,R,E> & List<&2,SP.Requirement<S>>,missing:List<&2,SP.Requirement<S>>,schedule:Sch.Schedule<S,C,R,E,(Ord.Owner<S,Sys.Registry<S,C,R,E,Unit & U32,CE,List<&2,Unit>,crun>> & Res.Owner<S,Sys.Registry<S,C,R,E,Unit,RE,Unit,rrun>,kind>)>,world:W.World<S,C,R,E>,needs:List<&2,SP.Requirement<S>>) -> SP.ProvisionResult<S,C,R,E,(Ord.Owner<S,Sys.Registry<S,C,R,E,Unit & U32,CE,List<&2,Unit>,crun>> & Res.Owner<S,Sys.Registry<S,C,R,E,Unit,RE,Unit,rrun>,kind>),D.Error<CE,RE>> & Maybe<D.Arguments<Unit,Unit>>:
  match missing:
    case first <> rest:(SP.Missing{SP.Provisioned{schedule,needs},world,first <> rest},None{})
    case []:schedule_validated(~S,~C,~R,~E,~CE,~RE,~kind,~crun,~rrun,~condition,~available,needs,world,schedule)
def provision_returned(~S:Data,~C:Type,~R:Type,~E:Data,~CE:Data,~RE:Data,~kind:Query.Mode,~crun:W.World<S,C,R,E> -> (Unit & U32) -> Sys.Outcome<W.World<S,C,R,E>,CE,List<&2,Unit>>,~rrun:W.World<S,C,R,E> -> Unit -> Sys.Outcome<W.World<S,C,R,E>,RE,Unit>,~condition:W.World<S,C,R,E> -> U32 -> W.World<S,C,R,E> & Bool,~available:W.World<S,C,R,E> -> W.World<S,C,R,E> & List<&2,SP.Requirement<S>>,schedule:Sch.Schedule<S,C,R,E,(Ord.Owner<S,Sys.Registry<S,C,R,E,Unit & U32,CE,List<&2,Unit>,crun>> & Res.Owner<S,Sys.Registry<S,C,R,E,Unit,RE,Unit,rrun>,kind>)>,+needs:List<&2,SP.Requirement<S>>,result:W.World<S,C,R,E> & List<&2,SP.Requirement<S>>) -> SP.ProvisionResult<S,C,R,E,(Ord.Owner<S,Sys.Registry<S,C,R,E,Unit & U32,CE,List<&2,Unit>,crun>> & Res.Owner<S,Sys.Registry<S,C,R,E,Unit,RE,Unit,rrun>,kind>),D.Error<CE,RE>> & Maybe<D.Arguments<Unit,Unit>>:
  match result:
    case (world,provided):provision_checked(~S,~C,~R,~E,~CE,~RE,~kind,~crun,~rrun,~condition,~available,SP.missing_requirements(~S,needs,provided),schedule,world,needs)
def run(~S:Data,~C:Type,~R:Type,~E:Data,~CE:Data,~RE:Data,~kind:Query.Mode,~crun:W.World<S,C,R,E> -> (Unit & U32) -> Sys.Outcome<W.World<S,C,R,E>,CE,List<&2,Unit>>,~rrun:W.World<S,C,R,E> -> Unit -> Sys.Outcome<W.World<S,C,R,E>,RE,Unit>,~condition:W.World<S,C,R,E> -> U32 -> W.World<S,C,R,E> & Bool,~available:W.World<S,C,R,E> -> W.World<S,C,R,E> & List<&2,SP.Requirement<S>>,schedule:SP.Provisioned<S,C,R,E,(Ord.Owner<S,Sys.Registry<S,C,R,E,Unit & U32,CE,List<&2,Unit>,crun>> & Res.Owner<S,Sys.Registry<S,C,R,E,Unit,RE,Unit,rrun>,kind>)>,world:W.World<S,C,R,E>) -> SP.ProvisionResult<S,C,R,E,(Ord.Owner<S,Sys.Registry<S,C,R,E,Unit & U32,CE,List<&2,Unit>,crun>> & Res.Owner<S,Sys.Registry<S,C,R,E,Unit,RE,Unit,rrun>,kind>),D.Error<CE,RE>> & Maybe<D.Arguments<Unit,Unit>>:
  match schedule:
    case SP.Provisioned{schedule,needs}:provision_returned(~S,~C,~R,~E,~CE,~RE,~kind,~crun,~rrun,~condition,~available,schedule,needs,available(world))
