from pathlib import Path
import json,hashlib,gzip,os
wt=Path('/workspace/formal-proofs/bendvy-worktrees/native54-matching-tree-v1');base=wt/'experiments/public-inspect/ordinary-declaration-v1/native54-matching-tree-v1/native-runtime-boundary-study-v1';p=base/'dependency-order-diagnostic-v1';p.mkdir();c=p/'compiler';c.mkdir();sha=lambda b:hashlib.sha256(b).hexdigest()
elf=Path('/home/node/.bend/bin/bend-2.0.35');raw=elf.read_bytes();original=raw[82378778:82711943];assert len(original)==333165 and sha(original)=='015d68644efcd3ed53a5dbf17f5672c3f4fcb70c8c64cd2c895b4955e1f78e62';(c/'installed-cli-unmodified.mjs').write_bytes(original)
helper='''function BVY_N54_ORDER_KEYS(keys, deps) {
  const seen = new Set;
  const output = [];
  for (const root of keys) {
    if (seen.has(root)) continue;
    seen.add(root);
    const stack = [[root, 0]];
    while (stack.length) {
      const frame = stack[stack.length - 1];
      const children = deps.get(frame[0]) ?? [];
      if (frame[1] < children.length) {
        const child = children[frame[1]++];
        if (!seen.has(child)) {
          seen.add(child);
          stack.push([child, 0]);
        }
      } else {
        output.push(frame[0]);
        stack.pop();
      }
    }
  }
  return output;
}
function BVY_N54_NATIVE_ORDER(fl) {
  const rows = done_defs(fl).reverse();
  const byKey = new Map(rows);
  const keys = rows.map(([k]) => k);
  const deps = new Map;
  for (const k of keys) {
    const found = new Set;
    term_any(fl, fun_of(fl, k).h, (s) => {
      if (s.$ === "Ref" && s.k !== k && byKey.has(s.k)) found.add(s.k);
      return false;
    });
    deps.set(k, [...found]);
  }
  return BVY_N54_ORDER_KEYS(keys, deps).map((k) => [k, byKey.get(k)]);
}
'''
s=original.decode();patches=[]
def patch(old,new):
 global s
 assert s.count(old)==1;s=s.replace(old,new);patches.append({'original':old,'replacement':new})
patch('function compile_book(book) {',helper+'function compile_book(book) {')
patch('  let reqs;\n  do {','  let reqs;\n  const nativeOrder = BVY_N54_NATIVE_ORDER(fl);\n  do {')
patch('    for (const [k, tld] of done_defs(fl).reverse()) {','    for (const [k, tld] of nativeOrder) {')
inv=s
for x in reversed(patches):assert inv.count(x['replacement'])==1;inv=inv.replace(x['replacement'],x['original'])
assert inv.encode()==original;(c/'installed-cli-order.mjs').write_text(s)
for name in ['base.bend','bendtt.lean','effs']:(c/name).symlink_to(Path('/home/node/.bend/bend2')/name)
(p/'PATCHES.json').write_text(json.dumps({'scope':'Native done_defs traversal order only; no cache/facts/body/kernel/termination mutation','inverseExact':True,'unmodifiedBytes':len(original),'unmodifiedSHA256':sha(original),'patches':patches},indent=2)+'\n')
control='''const fs=require('fs'),vm=require('vm'),assert=require('assert');
const src=fs.readFileSync(process.argv[2],'utf8');
const block=src.slice(src.indexOf('function BVY_N54_ORDER_KEYS('),src.indexOf('function compile_book(book) {'));
function qualify(keys,edges,expected){
 const state={keys,edges,done_defs:()=>keys.slice().reverse().map(k=>[k,{h:k}]),fun_of:(_,k)=>({h:k}),term_any:(_,k,f)=>{for(const dep of edges[k]??[])f({$:"Ref",k:dep});}};
 vm.createContext(state);vm.runInContext(block,state);const got=state.BVY_N54_NATIVE_ORDER({}).map(x=>x[0]);
 assert.deepStrictEqual(Array.from(got),expected);assert.strictEqual(new Set(got).size,keys.length);assert.deepStrictEqual([...got].sort(),[...keys].sort());
 assert.deepStrictEqual(Array.from(state.BVY_N54_NATIVE_ORDER({}).map(x=>x[0])),expected);
}
qualify(['caller','leaf'],{caller:['leaf']},['leaf','caller']);
qualify(['root','shared','deep'],{root:['shared','deep'],deep:['shared']},['shared','deep','root']);
qualify(['a','b','tail'],{a:['b'],b:['a','tail']},['tail','b','a']);
qualify(['a','b'],{a:['a','foreign','b','b']},['b','a']);
qualify([],{},[]);
const keys=Array.from({length:6000},(_,i)=>'k'+i),edges=Object.fromEntries(keys.map((k,i)=>[k,i+1<keys.length?[keys[i+1]]:[]]));qualify(keys,edges,keys.slice().reverse());
console.log('NATIVE_DEPENDENCY_ORDER_CONTROL_PASS');
'''
(p/'control.cjs').write_text(control)
(p/'README.md').write_text('''# One Native dependency-order discriminator

Unchanged full47 scan-projector source/sourcePASS/fullJSwhole5077477 oracle reused. Exact installed ELF333165B embedded CLI015d extracted/provenance pinned. Three inverse patches add bounded-stack dependency postorder from existing done_defs keys, compute it once after file_book, and replace only compile_book outer reverse-discovery traversal. All original emission/fact additions/BRWS clears/lending closure/finalization/cardinality termination/kernel/runtime code remain unchanged. For cycles deterministic first-discovery DFS order is a heuristic, not a cyclic borrow solution. Every key occurs exactly once; all dependencies are filtered to the same existing done_defs set. Existing term_any and fun_of inspect lowered Ref graph only; source read may warm existing FUNS cache and adds prep work. No mutation of SRCS/refbook/maps beyond ordinary existing memo reads, no new compiler/dependency/core adoption.

Source rationale: file_book builds SRCS in root BFS discovery order, whereas reverse discovery is not dependency postorder for shared/cross-depth references. brw_of caches first per-pass slot choices; val_own consumption acquired after that lookup only informs later passes. Dependency order can make callee facts available earlier for caller emission. Existing emit_fuse still invokes emit_args; nested fusion/late unresolved-borrow finalization remain and may prevent fewer passes. No claim this resolves stock90 deadline or changes safe runtime semantics. Segment/constant allocation order changes require full actual independent oracle, not byteequal C proof.

Node5 exact extracted ordering-helper controls cover chain/shared/cycle/self/unknown/empty/6000-depth/permutation/determinism. Then ONE copied compiler emit30→conditionalClang19-O3 build120→runtime5/full5077477 oracle, CPU11/internalsharedlock unchanged. Filemode BUN_BE_BUN only; no profiler/instrumentation/cutoff/capraise. Original stockfailures preserved. Private compiler pipeline never establishes stock packaged acceptance or compiler equivalence; no speed/convergence/universalproof/performance/full54 claim. Both control and compiler UNEXECUTED pending independent whole compiler-experiment review/root queue routing.
''')
