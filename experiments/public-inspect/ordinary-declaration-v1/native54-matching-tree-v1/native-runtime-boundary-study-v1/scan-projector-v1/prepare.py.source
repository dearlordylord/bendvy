from pathlib import Path
import json,hashlib,shutil,subprocess,gzip
wt=Path('/workspace/formal-proofs/bendvy-worktrees/native54-matching-tree-v1');parent=wt/'experiments/public-inspect/ordinary-declaration-v1/native54-matching-tree-v1/native-runtime-boundary-study-v1';p=parent/'scan-projector-v1';p.mkdir(exist_ok=True);sha=lambda b:hashlib.sha256(b).hexdigest()
old='def pair_scan(~H:Type,~S:Data,~V:Data,~selection:Q.DeclaredSelection<H,S,V>,targets:List<&2,W.Handle<S>>,owner:H,rows:List<&2,ProjectedRow<S,V>>) -> H & List<&2,ProjectedRow<S,V>>:\n  match targets:\n    case []:(owner,List.reverse(&2,ProjectedRow<S,V>,rows))\n    case +target <> rest:pair_scan_matched(~H,~S,~V,~selection,target,rows,(owner => rows => pair_scan(~H,~S,~V,~selection,rest,owner,rows)),Q.matches_field(~H,~S,~V,selection)(owner,target))\n'
new='def pair_scan_runtime_matched(~H:Type,~S:Data,~V:Data,project:H -> H & V,+target:W.Handle<S>,rows:List<&2,ProjectedRow<S,V>>,continue:H -> List<&2,ProjectedRow<S,V>> -> H & List<&2,ProjectedRow<S,V>>,observed:H & Bool) -> H & List<&2,ProjectedRow<S,V>>:\n  match observed:\n    case (owner,False{}):continue(owner,rows)\n    case (owner,True{}):pair_scan_projected(~H,~S,~V,target,rows,continue,project(owner))\ndef pair_scan(~H:Type,~S:Data,~V:Data,~selection:Q.DeclaredSelection<H,S,V>,targets:List<&2,W.Handle<S>>,owner:H,rows:List<&2,ProjectedRow<S,V>>) -> H & List<&2,ProjectedRow<S,V>>:\n  match targets:\n    case []:(owner,List.reverse(&2,ProjectedRow<S,V>,rows))\n    case +target <> rest:pair_scan_runtime_matched(~H,~S,~V,(owner => Q.project_field(~H,~S,~V,selection)(owner,target)),target,rows,(owner => rows => pair_scan(~H,~S,~V,~selection,rest,owner,rows)),Q.matches_field(~H,~S,~V,selection)(owner,target))\n'
rows=[]
for f in sorted((parent/'stage').rglob('*.bend')):
 rel=f.relative_to(parent);raw=f.read_bytes();committed=subprocess.check_output(['git','show','4d8223cd7:'+str(f.relative_to(wt))],cwd=wt);assert raw==committed
 current=raw
 if str(rel)=='stage/core/inspector-query.bend':
  text=raw.decode();assert text.count(old)==1;current=text.replace(old,new).encode();assert current.decode().replace(new,old).encode()==raw
 out=p/rel;out.parent.mkdir(parents=True,exist_ok=True);out.write_bytes(current);rows.append({'relative':str(rel),'parentSHA256':sha(raw),'candidateSHA256':sha(current),'equal':raw==current})
assert len(rows)==47 and sum(not x['equal'] for x in rows)==1
(p/'DELTA.json').write_text(json.dumps({'parentCommit':'4d8223cd7223a62275b38d8eed41bda017418d1b','parent':str(parent),'old':old,'new':new,'inverseExact':True,'joins':rows},indent=2)+'\n')
(p/'README.md').write_text('# Fresh scan projector discriminator\n\nParent exact4d8223cd7 full47 pair-scan/runtime-consumer stage. One literal replacement adds pair_scan_runtime_matched and redirects only the recursive worker nonempty branch to it. Original pair_scan_matched compatibility definition remains. The new nonrecursive helper has erased H/S/V only and accepts fresh runtime project:H->H&V. False consumes owner through continue and discards project; True consumes owner through project exactly once then the unchanged row/continue helper. The recursive worker still specializes on selection, shrinks targets and creates a new projector for each iteration; no reusable affine callback loop or owner duplication. Matching precedes projection; original row reversal, short circuit, target borrow, selection/Value fields, generic9Check, lookup/public API and all full scenarios remain unchanged.\n\nDELTA literal inverse reconstructs all47 parent sources byte-exact. No constructor/formatter/import/relative defining QName changes, so the independent complete5077477 oracle810259 remains applicable. No measured Native cost, serialization-cause, or qualification claim. This isolates the scan staging boundary rather than the failed four-pair callback extraction or lookup-runtime-v2. Default source5 first; only after sourcePASS and independent whole plan review fullJS30/runtime5 then conditionalNative30/build120/runtime5. Existing collector/tools/internal lock, no new compiler/caps/core/runner/contracts/dependencies. Current reader/authority controls remain unexecuted.\n')
plans=[]
for name,role in [('source-plan.json','source'),('normal-js-plan.json','js'),('normal-native-plan.json','native')]:
 j=json.loads((parent/name).read_text());temp=Path('/tmp/bendvy54-scan-projector-'+role+'01');temp.mkdir(exist_ok=True);oldtemp=str(Path(j['generated']).parent)
 def repl(v):
  if isinstance(v,str):return v.replace(str(parent),str(p)).replace(oldtemp,str(temp))
  if isinstance(v,list):return [repl(x) for x in v]
  if isinstance(v,dict):return {repl(k):repl(x) for k,x in v.items()}
  return v
 j=repl(j);j['scope']='Full47 fresh runtime scan projector; complete independent oracle; source5 then conditional wholeJSNative; no compiler cause/performance claim'
 for key in ['sourceInventory','pins']:
  for path in j[key]:j[key][path]=sha(Path(path).read_bytes())
 for d,fs in j['resourceRoots'].items():
  for path,h in fs.items():assert sha((Path(d)/path).read_bytes())==h
 if 'oracle' in j:
  b=gzip.decompress(Path(j['oracle']).read_bytes());assert len(b)==j['oracleBytes'] and sha(b)==j['oracleSHA256']
 for key in ['generated','native']:
  if j.get(key):assert not Path(j[key]).exists()
 raw=(json.dumps(j,indent=2)+'\n').encode();(temp/'plan.json').write_bytes(raw);(p/name).write_bytes(raw);plans.append({'role':role,'path':str(temp/'plan.json'),'sha256':sha(raw),'pins':len(j['pins']),'sources':len(j['sourceInventory'])})
(p/'SEQUENCE.json').write_text(json.dumps({'collector':'/workspace/formal-proofs/bendvy/experiments/public-inspect/ordinary-declaration-v1/canonical-full-consumer-v1/development-v2.py','cases':plans,'condition':'SourcePASS then wholeJSPASS then Native; direct collector internal shared lock, failstop/noretry'},indent=2)+'\n');print(json.dumps(plans));print('SEQUENCE',sha((p/'SEQUENCE.json').read_bytes()))
