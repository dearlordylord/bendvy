wt=Path('/workspace/formal-proofs/bendvy-worktrees/native54-matching-tree-v1');parent=wt/'experiments/public-inspect/ordinary-declaration-v1/native54-matching-tree-v1/native-runtime-boundary-study-v1';d=parent/'native-cost-probe-v1';comp=d/'compiler';comp.mkdir(exist_ok=True);sha=lambda b:hashlib.sha256(b).hexdigest();elf=Path('/home/node/.bend/bin/bend-2.0.35');packed=elf.read_bytes();original=packed[82378778:82711943];assert sha(packed)=='f77417474ded314ad5d1a68fa3ebbe214c2124bf04d56a59b05bc17be6b0327a';assert sha(original)=='015d68644efcd3ed53a5dbf17f5672c3f4fcb70c8c64cd2c895b4955e1f78e62';text=original.decode();assert 'BVY_N54C_' not in text
patches=[]
def patch(label,a,b):
 global text
 assert text.count(a)==1,(label,text.count(a));text=text.replace(a,b);patches.append({'label':label,'original':a,'replacement':b})
helpers=r'''
function BVY_N54C_STATE() {
  return BVY_N54C_STATE.state ??= {start:performance.now(),cpu:process.cpuUsage(),inst:{calls:0,hits:0,misses:0,teleInclusiveMs:0,keyMs:0,keyChars:0,maxKeyChars:0},pass:0,ordinal:0,gcMs:0,openMs:0,bodyMs:0,bodyCpuUs:0,settleMs:0,tops:new Map(),logMs:0,events:0};
}
function BVY_N54C_LOG(event,extra={}) {
  const s=BVY_N54C_STATE(),t=performance.now(),cpu=process.cpuUsage(s.cpu);
  const top=[...s.tops].sort((a,b)=>b[1].ms-a[1].ms).slice(0,32).map(([key,v])=>({label:key.slice(-256),labelLength:key.length,...v}));
  const bytes=Buffer.from('BENDVY_NATIVE_COST '+JSON.stringify({event,wallMs:t-s.start,cpuUs:cpu.user+cpu.system,pass:s.pass,ordinal:s.ordinal,inst:{...s.inst},gcMs:s.gcMs,openMs:s.openMs,bodyMs:s.bodyMs,bodyCpuUs:s.bodyCpuUs,settleMs:s.settleMs,priorLogMs:s.logMs,priorEvents:s.events,top,...extra})+'\n');
  for(let offset=0;offset<bytes.length;){const n=fs4.writeSync(2,bytes,offset,bytes.length-offset);if(!(n>0))throw new Error('diagnostic stderr made no progress');offset+=n;}
  s.logMs+=performance.now()-t;s.events++;
}
function BVY_N54C_DONE(key,start,cpu) {
  const s=BVY_N54C_STATE(),ms=performance.now()-start,u=process.cpuUsage(cpu),cpuUs=u.user+u.system;
  s.bodyMs+=ms;s.bodyCpuUs+=cpuUs;s.ordinal++;
  const v=s.tops.get(key)??{calls:0,ms:0,cpuUs:0};v.calls++;v.ms+=ms;v.cpuUs+=cpuUs;s.tops.set(key,v);
  if(s.ordinal%128===0)BVY_N54C_LOG('completed-checkpoint');
}
'''.replace("+'\\n'","+'\n'")
# JSON transport newline is a literal JS escape, not source line break.
helpers=helpers.replace("+'\n');","+'\\n');")
helpers=helpers.replace(r'\\n',r'\n')
