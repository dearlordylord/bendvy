patch('outer-open-end','      fl.segs.push(dl.seg);\n      emit_body(dl, fun_of(fl, k).h, tld.T, [], vals, null);','      fl.segs.push(dl.seg);\n      BVY_N54C_STATE().openMs+=performance.now()-BVY_N54C_OPEN_START;\n      const BVY_N54C_BODY_START=performance.now(),BVY_N54C_BODY_CPU=process.cpuUsage();\n      emit_body(dl, fun_of(fl, k).h, tld.T, [], vals, null);\n      BVY_N54C_DONE(k,BVY_N54C_BODY_START,BVY_N54C_BODY_CPU);')
patch('settle-entry','    reqs = effect_srcs(fl, ".c", "no .c import: ").join("");','    const BVY_N54C_SETTLE_START=performance.now();\n    reqs = effect_srcs(fl, ".c", "no .c import: ").join("");')
