helpers += r"""
function BVY_N54F_RESET() {
  return {own:{attempts:0,newKeys:0,producers:{},samples:[]},hot:{attempts:0,newKeys:0,producers:{},samples:[]},stat:{attempts:0,newKeys:0,producers:{},samples:[]}};
}
function BVY_N54F_ADD(fl,name,key,producer,definition=fl.def) {
  const set=fl[name],had=set.has(key),result=set.add(key),s=BVY_N54C_STATE();
  const facts=s.factOrigins??=BVY_N54F_RESET(),group=facts[name];
  group.attempts++;const counts=group.producers[producer]??={attempts:0,newKeys:0};counts.attempts++;
  if(!had){group.newKeys++;counts.newKeys++;if(group.samples.length<16){const label=String(key),active=String(definition);group.samples.push({key:label.slice(-256),keyLength:label.length,producer,definition:active.slice(-256),definitionLength:active.length});}}
  return result;
}
"""
