patch('tele-end-key-start','    throw e;\n  }\n  const key = xs.map((a) => term_key(term_lower(a))).join(`\n`);','    throw e;\n  } finally {\n    BVY_N54C_INST.teleInclusiveMs += performance.now()-BVY_N54C_TELE_START;\n  }\n  const BVY_N54C_KEY_START = performance.now();\n  const key = xs.map((a) => term_key(term_lower(a))).join(`\n`);\n  BVY_N54C_INST.keyMs += performance.now()-BVY_N54C_KEY_START;\n  BVY_N54C_INST.keyChars += key.length;\n  BVY_N54C_INST.maxKeyChars = Math.max(BVY_N54C_INST.maxKeyChars,key.length);')
patch('cache-count','  let o = is.get(key);','  let o = is.get(key);\n  if(o===undefined)BVY_N54C_INST.misses++;else BVY_N54C_INST.hits++;')
patch('native-entry','function compile_book(book) {','function compile_book(book) {\n  BVY_N54C_LOG("compile-book-entry");')
patch('file-book','  const fl = file_book(book, ["main", ...RUNTIME_ADTS, ...fams], false);','  const BVY_N54C_FILE_START = performance.now();\n  const fl = file_book(book, ["main", ...RUNTIME_ADTS, ...fams], false);\n  BVY_N54C_LOG("file-book-exit",{fileBookMs:performance.now()-BVY_N54C_FILE_START});')
patch('pass-entry','  do {\n    was = facts();','  do {\n    const BVY_N54C_S=BVY_N54C_STATE();\n    BVY_N54C_S.pass++;BVY_N54C_S.ordinal=0;BVY_N54C_S.tops=new Map();BVY_N54C_S.gcMs=0;BVY_N54C_S.openMs=0;BVY_N54C_S.bodyMs=0;BVY_N54C_S.bodyCpuUs=0;BVY_N54C_S.settleMs=0;BVY_N54C_S.factOrigins=BVY_N54F_RESET();\n    BVY_N54C_LOG("pass-entry",{own:fl.own.size,hot:fl.hot.size,stat:fl.stat.size});\n    was = facts();')
patch('outer-gc-start','    for (const [k, tld] of done_defs(fl).reverse()) {\n      memo_gc();','    for (const [k, tld] of done_defs(fl).reverse()) {\n      const BVY_N54C_GC_START=performance.now();\n      memo_gc();\n      BVY_N54C_STATE().gcMs+=performance.now()-BVY_N54C_GC_START;\n      const BVY_N54C_OPEN_START=performance.now();')
patch('outer-open-end','      fl.segs.push(dl.seg);\n      emit_body(dl, fun_of(fl, k).h, tld.T, [], vals, null);','      fl.segs.push(dl.seg);\n      BVY_N54C_STATE().openMs+=performance.now()-BVY_N54C_OPEN_START;\n      const BVY_N54C_BODY_START=performance.now(),BVY_N54C_BODY_CPU=process.cpuUsage();\n      emit_body(dl, fun_of(fl, k).h, tld.T, [], vals, null);\n      BVY_N54C_DONE(k,BVY_N54C_BODY_START,BVY_N54C_BODY_CPU);')
