"""Source-only finite model for the ordinary composed-query scene.

No runtime outputs are inputs. Binding is supplied by SOURCE-BASIS.json; this model is not a universal proof.
"""
import json
import runpy
from pathlib import Path

DEPENDENCY = (Path(__file__).resolve().parents[2] /
              'removal-inspection-v1/public-relocation-v1/policy-free-v2/'
              'independent-oracle-v1/model.py.source')


def composed_queries(removed):
    present = 'Row{1,1,Found{42},Found{43}}'
    missing_left = 'Row{1,1,ComponentAbsent{},Found{43}}'
    left_each = '[]' if removed else '[' + present + ']'
    left_get = 'Fail{QueryMismatch{1}}' if removed else 'Done{' + present + '}'
    right_row = missing_left if removed else present
    return ('requiredLeftOptionalRightEach=' + left_each +
            '|requiredLeftOptionalRightGet=' + left_get +
            '|optionalLeftRequiredRightEach=[' + right_row + ']' +
            '|optionalLeftRequiredRightGet=Done{' + right_row + '}' +
            '|queryFrameCursor=0')


def expected():
    physical = json.loads(runpy.run_path(str(DEPENDENCY))['expected']())
    augmented = []
    snapshot_index = 0
    for line in physical.split('\n'):
        # Both schema labels prefix snapshot1; all six state strings are retained.
        snapshot_index = snapshot_index % 6
        augmented.append(line + '|composedQueries{' +
                         composed_queries(snapshot_index >= 2) + '}')
        snapshot_index += 1
    return (json.dumps('\n'.join(augmented), separators=(',', ':')) + '\n').encode()


if __name__ == '__main__':
    import sys
    sys.stdout.buffer.write(expected())
