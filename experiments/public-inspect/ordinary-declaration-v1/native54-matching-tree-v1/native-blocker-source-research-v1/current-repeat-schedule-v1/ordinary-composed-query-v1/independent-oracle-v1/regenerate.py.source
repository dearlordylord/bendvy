"""Regenerate whole composed-query oracle solely from frozen sources."""
import gzip, hashlib, json, runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent
P=HERE.parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def regenerate():
    complete=json.loads((P/'SOURCE-COMPLETE.json').read_text())
    pins=complete['sourceInventory'].copy()
    for path,digest in pins.items():assert sha(path)==digest,path
    module=runpy.run_path(str(HERE/'model.py.source'))
    dep=module['DEPENDENCY']
    dependencies=[]
    while True:
        dependencies.append(dep)
        imported=runpy.run_path(str(dep))
        if 'DEPENDENCY' not in imported:break
        dep=imported['DEPENDENCY']
    raw=module['expected']()
    physical=json.loads(runpy.run_path(str(module['DEPENDENCY']))['expected']())
    full=json.loads(raw)
    assert len(full.split('\n'))==12
    assert '\n'.join(x.split('|composedQueries{',1)[0] for x in full.split('\n'))==physical
    assert full.count('queryFrameCursor=0')==12
    assert full.count('requiredLeftOptionalRightGet=Fail{QueryMismatch{1}}')==8
    assert full.count('optionalLeftRequiredRightGet=Done{Row{1,1,ComponentAbsent{},Found{43}}}')==8
    queries=(P/'queries.bend').read_text()
    assert 'first(~S:Data,+target:W.Handle<S>' in queries
    assert 'Select.pair(' in queries and '~Families.Required{}' in queries and '~Families.Optional{}' in queries
    entry=(P/'entry.bend').read_text()
    assert entry.count('C.remove(')==1 and entry.count('C.read(')==1
    for path in [*dependencies,HERE/'model.py.source',HERE/'regenerate.py.source',P/'SOURCE-COMPLETE.json']:
        pins[str(path)]=sha(path)
    prior=json.loads((module['DEPENDENCY'].parent/'SOURCE-BASIS.json').read_text())
    for path,digest in prior['sourcePins'].items():
        if Path(path).name=='Base.bend':
            assert sha(path)==digest
            pins[path]=digest
    (HERE/'expected.stdout').write_bytes(raw)
    (HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    basis={'producerCommit':'2ea1b0351','sourcePins':pins,'dependencies':[str(x) for x in dependencies],'entry':str(P/'entry.bend'),'derivation':'Same operational bindings create Required/Optional selections. Pair membership is conjunctive; Required rejects absent left after observed removal, Optional retains ComponentAbsent. Both each/get preserve Frame cursor0 and return identical World. All twelve physical observations source-generated by pinned qualified removal model and preserved exactly. No runtime output input.','limits':'Finite two-schema one-live-handle scene, retained affine arrays42/43/resource17 and actual removal/read. No universal composition proof, missing resource, TS or performance qualification.'}
    b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
    oracle={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
    (HERE/'ORACLES.json').write_text(json.dumps({'normal':oracle},indent=2)+'\n')
    result={'sourcePins':len(pins),'physicalPreserved':True,'snapshots':12,**oracle}
    (HERE/'SELFTEST.json').write_text(json.dumps(result,indent=2)+'\n')
    print(json.dumps(result))
if __name__=='__main__':regenerate()
