"""Bind direct St.Queued lowering without transferring rejected-policy claims."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent;P=HERE.parent;PUBLIC=P.parent;OLD=PUBLIC.parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def body(p):return '\n'.join(x for x in Path(p).read_text().splitlines() if not x.startswith('import '))
def regenerate():
    complete=json.loads((P/'SOURCE-COMPLETE.json').read_text());pins=complete['sourcePins'].copy()
    for path,digest in pins.items():assert sha(path)==digest,path
    operation=Path('/workspace/formal-proofs/bendvy/src/ecs/ordinary-component-removal.bend')
    op=operation.read_text()
    assert 'SelectionRejected' not in op and '~selection:' not in op and '~select:' not in op
    assert '-> St.Queued<' in op and 'St.tx_remove_observed(' in op
    assert 'inject(Binding.identity(' in op and 'Binding.family(' in op
    consumer=body(P/'consumer-public.bend');old=body(PUBLIC/'consumer-public.bend')
    assert consumer.split('def removed(',1)[0]==old.split('def removed(',1)[0]
    assert consumer.split('def remove(~S:',1)[1]==old.split('def remove(~S:',1)[1]
    assert 'case St.Queued{tx}:committed(' in consumer
    assert 'case St.QueueRejected{' in consumer and 'SelectionRejected' not in consumer
    for name in ('entry','observer'):assert body(P/(name+'-public.bend'))==body(PUBLIC/(name+'-public.bend'))
    oldbasis=json.loads((PUBLIC/'independent-oracle-v1/SOURCE-BASIS.json').read_text())
    for path,digest in oldbasis['sourcePins'].items():
        if path==str(operation):continue
        assert sha(path)==digest,path
        pins[path]=digest
    for path in (PUBLIC/'independent-oracle-v1/model.py.source',OLD/'independent-oracle-v1/model.py.source',P/'SOURCE-COMPLETE.json'):pins[str(path)]=sha(path)
    raw=runpy.run_path(str(HERE/'model.py.source'))['expected']()
    assert raw==(PUBLIC/'independent-oracle-v1/expected.stdout').read_bytes()
    assert len(raw)==6405
    (HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    basis={'producerCommit':'af37d3f22','sourcePins':pins,'modelPins':{str(HERE/'model.py.source'):sha(HERE/'model.py.source')},'entry':str(P/'entry-public.bend'),'derivation':'Direct public remove uses same Binding.identity injected into record and same Binding.family in actual St.tx_remove_observed. Old qualified valid scene compared identical Position keys and forwarded this same call. New consumer unwraps direct St.Queued and QueueRejected, commit/barrier/read/inspect and all serializer/owner paths retained. Full independent twelve-snapshot model source-derived unchanged. No runtime output input or artifact transfer.','scope':'Valid scene only. Historical SelectionRejected frontend removed and no applicability/approval claim for that policy. Actual getter authority unchanged; despawn/dynamic selection/general resource absence/full54 remain unqualified.'}
    b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
    oracle={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
    (HERE/'ORACLES.json').write_text(json.dumps({'normal':oracle},indent=2)+'\n')
    print(json.dumps({'sourcePins':len(pins),**oracle},indent=2))
if __name__=='__main__':regenerate()
