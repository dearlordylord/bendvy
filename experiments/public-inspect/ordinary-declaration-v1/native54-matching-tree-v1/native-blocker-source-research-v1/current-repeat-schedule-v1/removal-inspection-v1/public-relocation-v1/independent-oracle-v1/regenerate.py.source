"""Verify public closure and serializer applicability, never runtime outputs."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent;P=HERE.parent;OLD=P.parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def body(p):return '\n'.join(x for x in Path(p).read_text().splitlines() if not x.startswith('import '))
def regenerate(producer):
    complete=json.loads((P/'PUBLIC-SOURCE-COMPLETE.json').read_text())
    assert complete['status']=='COMPLETE_SOURCE_CONTROL_PASS'
    pins=complete['sourcePins'].copy()
    for path,digest in pins.items():assert sha(path)==digest,path
    manifest=json.loads((P/'PUBLIC-MANIFEST.json').read_text())
    for row in manifest['targets']:
        assert sha(row['source'])==row['sourceSHA256']
        assert sha(row['target'])==row['sha256']
        assert Path(row['prepared']).read_bytes()==Path(row['target']).read_bytes()
        assert body(row['source'])==body(row['target'])
        pins[row['source']]=row['sourceSHA256']
    for name in ('consumer','entry','observer'):
        assert body(P/(name+'-public.bend'))==body(OLD/(name+'.bend'))
    observer=(P/'observer-public.bend').read_text()
    assert 'src/ecs/ordinary-removal-provision.bend as Provision' in observer
    assert 'import ./removal-provision' not in observer
    assert 'def main() -> String:' in (P/'entry-public.bend').read_text()
    oldbasis=json.loads((OLD/'independent-oracle-v1/SOURCE-BASIS.json').read_text())
    for path,digest in oldbasis['sourcePins'].items():
        assert sha(path)==digest,path
        pins[path]=digest
    for path in (OLD/'independent-oracle-v1/model.py.source',P/'PUBLIC-MANIFEST.json',P/'PUBLIC-SOURCE-COMPLETE.json'):pins[str(path)]=sha(path)
    raw=runpy.run_path(str(HERE/'model.py.source'))['expected']()
    assert raw==(OLD/'independent-oracle-v1/expected.stdout').read_bytes()
    assert len(raw)==6405 and raw.count(b'resource=ALeaf{17}')==12
    (HERE/'expected.stdout').write_bytes(raw)
    (HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    basis={'producerCommit':producer,'sourcePins':pins,'modelPins':{str(HERE/'model.py.source'):sha(HERE/'model.py.source')},'entry':str(P/'entry-public.bend'),'derivation':'Three actual public library modules have literal nonimport body inverses to qualified private modules; public consumer/observer/entry same nonimport bodies. Captured closure consumes actual public Provision/Access/Operation, including corrected public observer. Manual source String formatter has no constructor QName transport. Full independent twelve-snapshot 6405-byte state model applies unchanged; no old generated artifact/output transfer and no runtime output inputs.','scope':'Static public source-only applicability for two nominal schemas and actual Removed scene. Despawn execution, dynamic selection, cleanup, reader disposal, general resource absence and full54 acceptance remain unqualified.'}
    b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
    oracle={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
    (HERE/'ORACLES.json').write_text(json.dumps({'normal':oracle},indent=2)+'\n')
    print(json.dumps({'sourcePins':len(pins),**oracle},indent=2))
if __name__=='__main__':
    import sys
    regenerate(sys.argv[1])
