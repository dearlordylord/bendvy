"""Bind foreign refusal source and complete physical serializer interpretation."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent;P=HERE.parent;PUBLIC=P.parents[1];PRIVATE=PUBLIC.parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def regenerate():
    complete=json.loads((P/'SOURCE-COMPLETE.json').read_text());pins=complete['sourcePins'].copy()
    for path,digest in pins.items():assert sha(path)==digest,path
    consumer=(P/'consumer.bend').read_text()
    assert '~C.empty(~S),factory,Array.new(U32,0n,17)' in consumer
    assert 'C.activated(~S,factory,handle,True{}' in consumer
    assert 'Clear.despawn(' in consumer and 'Cmd.tx_finish(' in consumer
    assert '";undo="' in consumer and '";commands="' in consumer and '";events="' in consumer
    prior=json.loads((PUBLIC/'independent-oracle-v1/SOURCE-BASIS.json').read_text())
    for path,digest in prior['sourcePins'].items():
        assert sha(path)==digest,path
        pins[path]=digest
    for path in (PRIVATE/'independent-oracle-v1/model.py.source',PRIVATE.parent/'independent-oracle-v1/model.py.source',P/'SOURCE-COMPLETE.json'):pins[str(path)]=sha(path)
    raw=runpy.run_path(str(HERE/'model.py.source'))['expected']()
    assert raw.count(b'Rejected{MissingEntity};undo=0;commands=0;events=0')==2
    assert raw.count(b'foreignHandle=Handle{2,1}')==4
    assert raw.count(b'factory=3')==4 and raw.count(b'clock=2')==8
    assert b'Aggregate{' not in raw and b'Stamp{0,0}' in raw
    (HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    basis={'producerCommit':'8caef945e','sourcePins':pins,'modelPins':{str(HERE/'model.py.source'):sha(HERE/'model.py.source')},'entry':str(P/'entry.bend'),'derivation':'First actual World consumes factory1, second actual creation consumes returned factory2 yielding namespace2 and finalfactory3; actual namespace2/id1 reservation activated and seeded42/43. First target remainsnamespace1 liveid1, rejects foreign handle before queue/clear/deactivation. Empty Tx lists preserved then successful finish changes nothing. Both World owners and static Inspector projections retained before/after. First Other scene has absent43 but successful None setup tick2. Explicit manual String serialization source-derived, no runtime outputs.','scope':'Two nominal schemas/genuine foreign same-schema handle refusal and retained affine owners. No forged handle/cleanup execution/foreign precedence/general allocation/error recovery/full54 claim.'}
    b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
    oracle={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
    (HERE/'ORACLES.json').write_text(json.dumps({'normal':oracle},indent=2)+'\n')
    print(json.dumps({'sourcePins':len(pins),**oracle},indent=2))
if __name__=='__main__':regenerate()
