"""Finite actual observed despawn; source-only physical owner interpretation."""
import json,runpy
from pathlib import Path
DEPENDENCY=Path(__file__).resolve().parents[2]/'independent-oracle-v1/model.py.source'
base=runpy.run_path(str(DEPENDENCY))
def snapshot(stage,present):
    removed=stage>0;read=stage==2
    row=base['snapshot'](0)
    if not present:row=row.replace(base['column'](43,2),base['column'](None,0))
    if removed:
        row=row.replace('ANode{ALeaf{False},ALeaf{True}}','ANode{ALeaf{False},ALeaf{False}}')
        row=row.replace(base['column'](42,1),'Column{ALeaf{None{}},[]}')
        row=row.replace(base['column'](43,2) if present else base['column'](None,0),'Column{ALeaf{None{}},[]}')
        records=['Components{Left{'+base['record']+'}}']
        if present:records.append('Components{Right{Removed{Handle{1,1},Declaration{OtherPosition}}}}')
        records.append('Aggregate{Despawned{Handle{1,1}}}')
        row=row.replace('events=[]','events=['+', '.join(records)+']')
        row=row.replace('projection=Some{[]}','projection=Some{['+base['record']+']}')
        row=row.replace('status=Ready','status='+('ReadSucceeded' if read else 'Despawned'))
    if read:
        row=row.replace('Reader{1,1,PositionRemovals,0}','Reader{1,1,PositionRemovals,'+('3' if present else '2')+'}')
        row=row.replace('output=}','output=[Removed{1,1,Position}]}')
    return row
def expected():
    def scene(present):return '\n'.join('snapshot'+str(i+1)+'='+snapshot(i//2,present) for i in range(6))
    return (json.dumps('A='+scene(True)+'\nOther='+scene(False),separators=(',',':'))+'\n').encode()
if __name__=='__main__':
    import sys
    sys.stdout.buffer.write(expected())
