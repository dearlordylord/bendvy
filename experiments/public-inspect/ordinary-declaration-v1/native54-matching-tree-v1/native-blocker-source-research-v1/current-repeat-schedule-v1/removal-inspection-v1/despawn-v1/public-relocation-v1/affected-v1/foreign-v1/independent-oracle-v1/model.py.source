"""Two genuine same-schema Worlds and owner-preserving foreign despawn refusal."""
import json,runpy
from pathlib import Path
DEPENDENCY=Path(__file__).resolve().parents[4]/'independent-oracle-v1/model.py.source'
base=runpy.run_path(str(DEPENDENCY))
def scene(present):
    first=base['snapshot'](0,present)
    world=first.split('Fixture{factory=2,',1)[1].split(',Reader{',1)[0]
    second=base['snapshot'](0,True).replace('factory=2','factory=3').replace('namespace=1','namespace=2').replace('Reader{1,1','Reader{2,1')
    def observed(status):return 'foreignHandle=Handle{2,1}\ntarget='+world+';reader=1,1,PositionRemovals,0;projection=Some{[]};status='+status+';output=\nforeignOwner='+second
    return 'before='+observed('Ready')+'\nafter='+observed('Rejected{MissingEntity};undo=0;commands=0;events=0')
def expected():return (json.dumps('A='+scene(True)+'\nOther='+scene(False),separators=(',',':'))+'\n').encode()
if __name__=='__main__':
    import sys
    sys.stdout.buffer.write(expected())
