"""Full static source binding and independent actual-Schedule expectation."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent;P=HERE.parent;ROOT=Path('/workspace/formal-proofs/bendvy')
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
complete=json.loads((P/'SOURCE-COMPLETE.json').read_text());assert complete['status']=='COMPLETE_SOURCE_CONTROL_PASS'
pins=complete['sourcePins'].copy()
for path,digest in pins.items():assert sha(path)==digest,path
consumer=(P/'consumer.bend').read_text();schedule=(ROOT/'src/ecs/schedule.bend').read_text()
assert '[Sch.Phase{"Update"},Sch.System{id,1}],[id],Owners{' in consumer
assert 'Selections.check_slot(' in consumer and '~Families.Required{}' in consumer
assert 'Query.grant_composed(' in consumer and '~QueryWorld.check_world(' in consumer
assert 'check_rows(~H,~S,Query.each_composed(' in consumer
assert 'case (owner,Query.ProjectedRow{_,C.Found{value}} <> _):(owner,U32.is_eq(value,99))' in consumer
assert 'condition_checked(~S,K.run(' in consumer
assert 'CheckedSchedule.run_with_skip(' in consumer
assert 'case (world,Fail{error}): Sch.Failed{' in (ROOT/'src/ecs/schedule-checked.bend').read_text()
assert 'case (world,[]):completed(' in (ROOT/'src/ecs/check.bend').read_text()

positive=P.parent/'condition-v1/consumer.bend'
assert consumer==positive.read_text().replace('case (owner,_ <> _):(owner,True{})','case (owner,Query.ProjectedRow{_,C.Found{value}} <> _):(owner,U32.is_eq(value,99))\n    case (owner,_ <> _):(owner,False{})')
pins[str(positive)]=sha(positive)
assert 'case False{}:' in (ROOT/'src/ecs/schedule.bend').read_text()
assert 'Sys.run_tracked(' in consumer
assert 'case Sch.Finished{Sch.Schedule{_,_,_,Owners{registry,_,output}},world,observations}' in consumer
assert 'List.append(&2,Observation,observations,[Entered{phase}])' in schedule
assert 'List.append(&2,Observation,observations,[Ran{id}])' in schedule
assert 'def main() -> String:' in consumer
# Repeated observation/physical serialization suffix exactly reused.
a=consumer.split('def fourth(',1)[1];b=(P.parent/'consumer.bend').read_text().split('def fourth(',1)[1];assert a==b
for extra in (P.parent/'independent-oracle-v1/model.py.source',Path('/home/node/.bend/bend2/base.bend'),ROOT/'.references/sources.json',Path('/workspace/formal-proofs/bendvy-worktrees/native54-matching-tree-v1/experiments/public-inspect/ordinary-declaration-v1/native54-matching-tree-v1/native-blocker-source-research-v1/ownership-preseed-v1/compiler/installed-cli-unmodified.mjs')):pins[str(extra)]=sha(extra)
model=runpy.run_path(str(HERE/'model.py.source'));raw=model['expected']()
old=runpy.run_path(str(P.parent/'independent-oracle-v1/model.py.source'))['expected']()
assert raw!=old
assert raw.count(b'Registry{1,1,ReadPosition,[Position],0}')==8
assert raw.count(b'output=None{}')==8
assert raw.count(b'status=Registered')==4 and raw.count(b'Finished:[Entered{Update}, Skipped{1}]')==4
(HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
basis={'producerCommit':'4206ee448','sourcePins':pins,'modelPins':{str(HERE/'model.py.source'):sha(HERE/'model.py.source')},'entry':str(P/'consumer.bend'),'derivation':'Actual required Position query scans liveHandle1/projectedFound42 through cursor-free granted Check Frame, body returnsTrue from nonempty projected rows, required-listempty. Same physical caller model and owner-returning observers; Sch.build valid catalog1, Phase Update then System1 conditionTrue. False invokes owner-preserving skip, not dispatch; registrycursor0/outputNone remain. Schedule records EnteredUpdate then Skipped1. Complete unchanged World. No runtime output inputs.','scope':'Two nominal schemas/four complete snapshots each; explicit String grammar, no QName. Finite successful actualCheck plus schedule only; missing/error branches unqualified; actual projected false qualified by model; no performance/general failure or full54 qualification.'}
b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
entry={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
(HERE/'ORACLES.json').write_text(json.dumps({'normal':entry},indent=2)+'\n');print(json.dumps({'sourcePins':len(pins),**entry},indent=2))
