"""Full static source binding and independent actual-Schedule expectation."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent;P=HERE.parent;ROOT=Path('/workspace/formal-proofs/bendvy')
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
complete=json.loads((P/'SOURCE-COMPLETE.json').read_text());assert complete['actualStatus']=='COMPLETE_SOURCE_CONTROL_PASS'
pins=complete['sourcePins'].copy()
for path,digest in pins.items():assert sha(path)==digest,path
consumer=(P/'consumer.bend').read_text();schedule=(ROOT/'src/ecs/schedule.bend').read_text()
assert '[Sch.Phase{"Update"},Sch.System{id,1}],[id],Owners{' in consumer
assert 'condition(~S:Data' in consumer and '& Bool:(world,True{})' in consumer
assert 'Sys.run_tracked(' in consumer
assert 'case Sch.Finished{Sch.Schedule{_,_,_,Owners{registry,_,output}},world,observations}' in consumer
assert 'List.append(&2,Observation,observations,[Entered{phase}])' in schedule
assert 'List.append(&2,Observation,observations,[Ran{id}])' in schedule
assert 'def main() -> String:' in consumer
# Repeated observation/physical serialization suffix exactly reused.
a=consumer.split('def fourth(',1)[1];b=(P.parent/'consumer.bend').read_text().split('def fourth(',1)[1];assert a==b
for extra in (P.parent/'model.py.source',Path('/home/node/.bend/bend2/base.bend'),ROOT/'.references/sources.json',Path('/workspace/formal-proofs/bendvy-worktrees/native54-matching-tree-v1/experiments/public-inspect/ordinary-declaration-v1/native54-matching-tree-v1/native-blocker-source-research-v1/ownership-preseed-v1/compiler/installed-cli-unmodified.mjs')):pins[str(extra)]=sha(extra)
model=runpy.run_path(str(HERE/'model.py.source'));raw=model['expected']()
old=runpy.run_path(str(P.parent/'model.py.source'))['expected']()
assert raw==old.replace(b'status=Succeeded',b'status=Finished:[Entered{Update}, Ran{1}]')
assert raw.count(b'status=Registered')==4 and raw.count(b'Finished:[Entered{Update}, Ran{1}]')==4
(HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
basis={'producerCommit':'484f4770a','sourcePins':pins,'modelPins':{str(HERE/'model.py.source'):sha(HERE/'model.py.source')},'entry':str(P/'consumer.bend'),'derivation':'Same source-derived physical caller model and repeated owner-returning observers; Sch.build valid catalog1, Phase Update then System1 conditionTrue. Actual dispatch executes Sys.run_tracked, returns Found42/registrycursor1 and complete unchanged World. Schedule records EnteredUpdate then Ran1. No runtime output inputs.','scope':'Two nominal schemas/four complete snapshots each; explicit String grammar, no QName. Finite successful schedule only; no performance/general failure or full54 qualification.'}
b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
entry={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
(HERE/'ORACLES.json').write_text(json.dumps({'normal':entry},indent=2)+'\n');print(json.dumps({'sourcePins':len(pins),**entry},indent=2))
