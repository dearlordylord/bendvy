"""Regenerate finite source-only expectation and verify frozen input hashes."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def main():
    basis=json.loads((HERE/"INDEPENDENT-SOURCE-BASIS.json").read_text())
    for path,digest in basis["sourcePins"].items():assert sha(path)==digest,path
    raw=runpy.run_path(str(HERE/"model.py"))["expected"]()
    data=json.loads(raw)
    assert [x["schema"] for x in data]==["A","Other"]
    for x in data:
        assert [s["dump"]["tick"] for s in x["observations"]]==[3,4,5,6]
        assert all(s["dump"]["frame"]==1 and s["projection"]["sameFirst"] and s["projection"]["sameSecond"] and s["projection"]["distinctResources"] for s in x["observations"])
    (HERE/"expected.stdout").write_bytes(raw)
    (HERE/"expected.stdout.gz").write_bytes(gzip.compress(raw,mtime=0))
    record={"stdout":str(HERE/"expected.stdout.gz"),"bytes":len(raw),"sha256":hashlib.sha256(raw).hexdigest(),"sourceBasisPath":str(HERE/"INDEPENDENT-SOURCE-BASIS.json"),"sourceBasisSHA256":sha(HERE/"INDEPENDENT-SOURCE-BASIS.json")}
    (HERE/"ORACLES.json").write_text(json.dumps({"normal":record},indent=2)+"\n")
    (HERE/"SELFTEST.json").write_text(json.dumps({"status":"PASS","sourcePins":len(basis["sourcePins"]),"completeObservations":8,"runtimeOutputInputs":False,"bytes":len(raw),"sha256":record["sha256"]},indent=2)+"\n")
    print(json.dumps(record))
if __name__=="__main__":main()
