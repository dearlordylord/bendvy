"""Verify applied source and regenerate finite whole countermodel and baseline."""
import gzip, hashlib, json, runpy
from pathlib import Path
HERE = Path(__file__).resolve().parent
sha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()
def main():
    basis = json.loads((HERE / "SOURCE-BASIS.json").read_text())
    for path, digest in basis["sourcePins"].items():
        assert sha(path) == digest, path
    normal_source = (HERE.parent / "normal-public.bend.source").read_text()
    mutant_source = (HERE.parent / "mutant-public.bend.source").read_text()
    old = "Schema.resource_key(~S,~P,identity),Query.Read{}"
    new = "Schema.resource_key(~S,~P,identity),Query.Write{}"
    assert normal_source.count(old) == 1
    assert normal_source.replace(old, new) == mutant_source
    model = runpy.run_path(str(HERE / "model.py.source"))
    normal, mutant = model["expected"](False), model["expected"](True)
    assert len(normal) == 4523
    assert hashlib.sha256(normal).hexdigest() == "aef2a7ebc7e5478e93cc362fa41c81cf7f9bf83f44347d7948ef8ab86b0a30df"
    assert mutant != normal
    for name in ("FirstResource", "SecondResource"):
        assert normal.count(("Clause{" + name + ",Read{}}").encode()) == 8
        assert mutant.count(("Clause{" + name + ",Write{}}").encode()) == 8
        mutant = mutant.replace(("Clause{" + name + ",Write{}}").encode(), ("Clause{" + name + ",Read{}}").encode())
    assert mutant == normal
    mutant = model["expected"](True)
    records = {}
    for key, raw in (("normal", normal), ("mutant", mutant)):
        path = HERE / (key + ".stdout.gz")
        path.write_bytes(gzip.compress(raw, mtime=0))
        (HERE / (key + ".stdout")).write_bytes(raw)
        records[key] = {"stdout": str(path), "bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest(),
                        "sourceBasisPath": str(HERE / "SOURCE-BASIS.json"), "sourceBasisSHA256": sha(HERE / "SOURCE-BASIS.json")}
    records["mutant"].update(normalBaseline=records["normal"]["stdout"], normalBaselineBytes=records["normal"]["bytes"], normalBaselineSHA256=records["normal"]["sha256"])
    (HERE / "ORACLES.json").write_text(json.dumps(records, indent=2) + "\n")
    first = next(i for i, (a, b) in enumerate(zip(normal, mutant)) if a != b)
    (HERE / "SELFTEST.json").write_text(json.dumps({"status": "PASS", "pins": len(basis["sourcePins"]), "metadataSites": 16, "unchangedPhysicalOutput": True, "firstDivergence": first, "fullNormalRejected": True, "runtimeOutputInputs": False}, indent=2) + "\n")
    print(json.dumps(records))
if __name__ == "__main__": main()
