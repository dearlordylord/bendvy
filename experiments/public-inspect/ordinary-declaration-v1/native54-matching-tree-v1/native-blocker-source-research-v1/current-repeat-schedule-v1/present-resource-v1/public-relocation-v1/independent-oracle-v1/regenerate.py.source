"""Regenerate only from pinned source model; never reads producer output."""
import gzip, hashlib, json, runpy
from pathlib import Path
HERE = Path(__file__).resolve().parent
sha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()
def main():
    basis = json.loads((HERE / "SOURCE-BASIS.json").read_text())
    for path, digest in basis["sourcePins"].items():
        assert sha(path) == digest, path
    raw = runpy.run_path(str(HERE / "model.py.source"))["expected"]()
    assert raw.count(b"Frame{cursor=0,") == 8
    assert raw.count(b"resource=Owner{ALeaf{17},ALeaf{18}}") == 8
    assert raw.count(b"resourceRead=Some{17,18}") == 4
    assert raw.count(b"resourceRead=None{}") == 4
    (HERE / "expected.stdout").write_bytes(raw)
    (HERE / "expected.stdout.gz").write_bytes(gzip.compress(raw, mtime=0))
    record = {"stdout": str(HERE / "expected.stdout.gz"), "bytes": len(raw),
              "sha256": hashlib.sha256(raw).hexdigest(),
              "sourceBasisPath": str(HERE / "SOURCE-BASIS.json"),
              "sourceBasisSHA256": sha(HERE / "SOURCE-BASIS.json")}
    (HERE / "ORACLES.json").write_text(json.dumps({"normal": record}, indent=2) + "\n")
    (HERE / "SELFTEST.json").write_text(json.dumps({"status": "PASS", "pins": len(basis["sourcePins"]),
        "fullObservations": 8, "readAttempts": 4, "bytes": len(raw), "sha256": record["sha256"],
        "runtimeOutputInputs": False}, indent=2) + "\n")
    print(json.dumps(record))
if __name__ == "__main__": main()
