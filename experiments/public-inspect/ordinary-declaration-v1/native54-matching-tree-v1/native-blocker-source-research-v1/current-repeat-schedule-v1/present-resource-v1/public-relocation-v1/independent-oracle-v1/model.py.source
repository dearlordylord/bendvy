"""Finite source-derived public present-resource scene; no runtime output inputs."""
import json

def delivery():
    # create/reserve/activate/replace: namespace1, live1, replacement tick1.
    world = ("World{namespace=1,nextId=2,highWater=1,live=ANode{ALeaf{False},ALeaf{True}},capacity=2,depth=1,"
             "store=Column{ALeaf{Some{Payload{ALeaf{42}}}},[Entry{1,Stamp{1,1}}]},"
             "resource=Owner{ALeaf{17},ALeaf{18}},events=[],pending=0,registrations=[],nextSystemId=1,clock=1}")
    # Compose read is cursor-free; Inspector each preserves its supplied Frame0.
    return ("Delivered{factory=2,Frame{cursor=0," + world + "},"
            "rows=[Row{Handle{1,1},Value{Found{42},True,True}}],clauses=[Clause{Position,Read{}}],"
            "access=Found{42},previous=None{},undo=0,commands=0,events=[]}")

def observation(value):
    return (delivery() + "|resourceRead=" + value +
            "|firstClauses=[Clause{FirstResource,Read{}}]|secondClauses=[Clause{SecondResource,Read{}}]")

def expected():
    # The consumer observes twice before read, then reads before each after observation.
    scene = "\n".join(label + "=" + observation(value) for label, value in
                      [("before1", "None{}"), ("before2", "None{}"),
                       ("after1", "Some{17,18}"), ("after2", "Some{17,18}")])
    return (json.dumps("A\n" + scene + "\nOther\n" + scene, ensure_ascii=False) + "\n").encode()

if __name__ == "__main__":
    import sys
    sys.stdout.buffer.write(expected())
