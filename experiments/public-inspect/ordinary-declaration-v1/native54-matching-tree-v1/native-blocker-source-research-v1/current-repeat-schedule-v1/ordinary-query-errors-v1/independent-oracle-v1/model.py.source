"""Independent ordinary query errors plus retained App physical observations."""
import json,runpy
from pathlib import Path
PRIOR=Path(__file__).resolve().parents[2]/"ordinary-app-v1/independent-oracle-v1/model.py.source"
m=runpy.run_path(str(PRIOR))
def snapshot(w):
    # handles tail scan prepends into [1,2]; repaired consumer selects second live2.
    # Required matches only live1; optional matches both live1/live2.
    result="requiredGet=Fail{QueryMismatch{2}}|requiredSingle=Done{Row{1,1,Found{42},True,True}}|optionalSingle=Fail{MultipleEntities{2}}|optionalSingleOptional=Fail{MultipleEntities{2}}|queryFrameCursor=0"
    return m["snapshot"](w)+"|queryErrors{"+result+"}"
def scenario():
    w=m["m"]["World"](True)
    rows=[snapshot(w),snapshot(w)]
    for _ in range(2):
        w.c1=w.clock
        rows.append("Finished:[Entered{Update}, Ran{1}]")
        rows.extend([snapshot(w),snapshot(w)])
    return "\n".join(rows)+"\n"
def expected():
    return (json.dumps("A\n"+scenario()+"Other\n"+scenario(),separators=(",",":"))+"\n").encode()
if __name__=="__main__":
    import sys
    sys.stdout.buffer.write(expected())
