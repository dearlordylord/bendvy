"""Finite source-only caller model; never reads runtime output."""
import json
world="World{namespace=1,nextId=2,highWater=1,live=ANode{ALeaf{False},ALeaf{True}},capacity=2,depth=1,store=Column{ALeaf{Some{Payload{ALeaf{42}}}},[Entry{1,Stamp{1,1}}]},resource=ALeaf{17},events=[],pending=0,registrations=[],nextSystemId=1,clock=1}"
delivery="Delivered{factory=2,Frame{cursor=0,"+world+"},rows=[Row{Handle{1,1},Value{Found{42},True,True}}],clauses=[Clause{Position,Read{}}],access=Found{42},previous=None{},undo=0,commands=0,events=[]}"
world=world.replace("registrations=[],nextSystemId=1", "registrations=[Registration{1,ReadPosition,[Position]}],nextSystemId=2")
delivery="Delivered{factory=2,Frame{cursor=0,"+world+"},rows=[Row{Handle{1,1},Value{Found{42},True,True}}],clauses=[Clause{Position,Read{}}],access=Found{42},previous=None{},undo=0,commands=0,events=[]}"
def observation(cursor,status,output):
    return delivery+"|Registry{1,1,ReadPosition,[Position],"+str(cursor)+"}|status="+status+"|output="+output
def expected():
    before=observation(0,"Registered","None{}")
    after=observation(1,"Succeeded","Some{Found{42}}")
    scene="before1="+before+"\nbefore2="+before+"\nafter1="+after+"\nafter2="+after
    return (json.dumps("A\n"+scene+"\nOther\n"+scene,separators=(",",":"))+"\n").encode()
if __name__=="__main__":
    import sys
    sys.stdout.buffer.write(expected())
