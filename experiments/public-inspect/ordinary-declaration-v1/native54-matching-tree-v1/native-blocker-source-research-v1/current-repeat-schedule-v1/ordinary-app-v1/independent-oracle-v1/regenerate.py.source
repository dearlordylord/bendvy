"""Pin actual ordinary App source and full manual String serializer."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent;P=HERE.parent;ROOT=Path('/workspace/formal-proofs/bendvy')
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
c=json.loads((P/'SOURCE-COMPLETE.json').read_text());assert c['status']=='COMPLETE_SOURCE_CONTROL_PASS'
pins=c['sourcePins'].copy()
for path,digest in pins.items():assert sha(path)==digest,path
consumer=(P/'consumer.bend').read_text();observer=(P/'observation.bend').read_text()
assert '[snapshot(~S),snapshot(~S),run(~S),snapshot(~S),snapshot(~S),run(~S),snapshot(~S),snapshot(~S)]' in consumer
for x in ('Scheduled.run(', 'Scheduled.attach(', 'Run.run(', 'Ord.observable_runner(', 'Old.entities(~S,2n,True{},world)', 'Old.pending(~S)', 'Array.new(U32,0n,10)'):assert x in consumer,x
assert 'Old.described(~S,True{},app)' in consumer
assert 'Array.new(U32,0n,42)' in observer and 'W.event_publish(' in observer and '[99]' in observer
assert 'Fragment.bare_entry(~S,value)' in observer
model=runpy.run_path(str(HERE/'model.py.source'))
extras=[model['PRIOR'],Path('/home/node/.bend/bend2/base.bend'),ROOT/'.references/sources.json',P.parent.parent/'ownership-preseed-v1/compiler/installed-cli-unmodified.mjs',P/'OBSERVATION-JOIN.json']
for extra in extras:pins[str(extra)]=sha(extra)
core=(ROOT/'src/ecs/system.bend').read_text();assert 'output,W.clock(' in core
assert 'Sys.run_tracked(' in (ROOT/'src/ecs/ordinary-app-registration-run.bend').read_text()
assert 'W.advance_clock' not in (ROOT/'src/ecs/ordinary-system.bend').read_text()
raw=model['expected']()
assert raw.count(b'Finished:[Entered{Update}, Ran{1}]')==4
assert raw.count(b'pendingCount=1|pendingEmpty=False')==12
assert raw.count(b'Counter=10')==12 and raw.count(b'|clock=1}')==12
assert raw.count(b':cursor=1:[Position, Position]')==16
(HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
basis={'producerCommit':'8a9ff51d9','sourcePins':pins,'modelPins':{str(HERE/'model.py.source'):sha(HERE/'model.py.source')},'entry':str(P/'consumer.bend'),'derivation':'Exact independent population World model reused for two separately created schema worlds: live ids1/2, Position ownerArray42 at id1 Stamp1,1, Unqueried empty, CounterArray10, pending event callback99 unflushed, registrations prepended2/1. Actual App.snapshot observes declaration-derived schema Position/Unqueried/Counter, duplicate Position read query matching onlyid1, Counter projection10, and both registration fields. No snapshot mutation. Scheduled.attach phase Update/System1; dispatch actual component Run transport invokes opaque ordinary observable read, no writes/commands/events. Sys.run_tracked sets first cursor to World.clock1; repeated run retains1. Resource owner cursor0 unchanged. Each nominal schema has six complete descriptions/physical states and two Finished observations. Manual String grammar no QName output.','scope':'Finite ordinary retained App two-schema component scheduled reads and exact metadata/affine physical owners only. Resource registry provided/observed but not executed; pending callback remains pending. No arbitraryApp/resourceMissing/full54/performance claims; no runtime outputs used.'}
b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
e={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
(HERE/'ORACLES.json').write_text(json.dumps({'normal':e},indent=2)+'\n');print(json.dumps({'sourcePins':len(pins),**e},indent=2))
