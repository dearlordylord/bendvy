"""Independent finite retained ordinary App interpretation; no runtime inputs."""
import json,runpy
from pathlib import Path
PRIOR=Path('/workspace/formal-proofs/bendvy-worktrees/native54-matching-tree-v1/experiments/public-inspect/ordinary-population-oracle-v1/model.py.source')
m=runpy.run_path(str(PRIOR))
def snapshot(w):
    bindings=m['fields'](w.c1,w.c2).replace(':Component,',',').replace(':Field]',']')
    debug='Debug{schema=[Component:Position:Position, Component:Unqueried:Unqueried, Resource:Counter:Counter]|bindings='+bindings+'|rendered=[[1:1:Found:42:Found:42], Counter=10]}'
    return w.complete(debug,'snapshot')
def scenario():
    w=m['World'](True)
    rows=[snapshot(w),snapshot(w)]
    # Two actual component reads are transaction success with no writes/barrier.
    for _ in range(2):
        w.c1=w.clock
        rows.append('Finished:[Entered{Update}, Ran{1}]')
        rows.extend([snapshot(w),snapshot(w)])
    return '\n'.join(rows)+'\n'
def expected():
    return (json.dumps('A\n'+scenario()+'Other\n'+scenario(),separators=(',',':'))+'\n').encode()
if __name__=='__main__':
    import sys
    sys.stdout.buffer.write(expected())
