(d/'PATCHES.json').write_text(json.dumps({'patches':patches,'inverseBytes':len(original),'inverseSHA256':sha(original),'instrumentedSHA256':sha(text.encode()),'inversePASS':True},indent=2)+'\n')
control=r'''import fs from 'node:fs';
import assert from 'node:assert/strict';
import {start,finish,due,writeAll} from './sample-helper.mjs';
const path=process.argv[2];assert(path.startsWith('/'));
assert.equal(due(true,100,15099),false);assert.equal(due(true,100,15100),true);assert.equal(due(false,100,99999),false);
const buffer=Buffer.from('λ😀'.repeat(60000));
for(const chunk of [1,7,131072,buffer.length]) {
 const captures=[];writeAll(buffer,(b,o,n)=>{const count=Math.min(n,chunk);captures.push(b.subarray(o,o+count));return count;});
 assert.deepEqual(Buffer.concat(captures),buffer);
}
for(const invalid of [0,-1,NaN,0.5,buffer.length+1])assert.throws(()=>writeAll(buffer,()=>invalid));
start(path);assert.throws(()=>start(path));
const until=performance.now()+20;let value=0;while(performance.now()<until)value=(value*1664525+1013904223)>>>0;
const meta=finish('api-control');assert(meta&&meta.reason==='api-control');
const profile=JSON.parse(fs.readFileSync(path,'utf8'));assert(profile.samples.length>0);
assert.equal(profile.samples.length,profile.timeDeltas.length);assert.equal(finish('second-finish'),undefined);
assert.equal(JSON.parse(fs.readFileSync(path+'.metadata.json','utf8')).sha256,meta.sha256);
console.log(JSON.stringify({status:'SAME_ELF_PROFILE_CONTROL_PASS',samples:profile.samples.length,transportBytes:buffer.length,shortWrites:[1,7,131072,buffer.length],zeroProgressRejected:true,secondStartRejected:true,synchronousResult:true}));
'''
(d/'check-api.mjs').write_text(control)
validator=r'''from pathlib import Path
import os,json,hashlib,math,stat,sys
p=Path(sys.argv[1]);m=json.loads(Path(str(p)+'.metadata.json').read_bytes())
fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW)
try:
 a=os.fstat(fd);assert stat.S_ISREG(a.st_mode)
 with os.fdopen(os.dup(fd),'rb') as f:raw=f.read()
 z=os.fstat(fd);assert (a.st_dev,a.st_ino,a.st_size)==(z.st_dev,z.st_ino,z.st_size)
 assert (a.st_dev,a.st_ino,len(raw))==(m['device'],m['inode'],m['bytes'])
 digest=hashlib.sha256(raw).hexdigest();assert digest==m['sha256']
finally:os.close(fd)
j=json.loads(raw);nodes=j['nodes'];samples=j['samples'];deltas=j['timeDeltas'];assert nodes and len(samples)==len(deltas)
ids=[n['id'] for n in nodes];assert len(ids)==len(set(ids)) and all(type(x) is int and x>0 for x in ids);known=set(ids)
assert all(type(x) is int and x in known for x in samples)
for n in nodes:
 assert type(n['callFrame']['functionName']) is str
 assert all(type(x) is int and x in known for x in n.get('children',[]))
assert all(type(x) in (int,float) and math.isfinite(x) and x>=0 for x in deltas)
assert all(type(j[k]) in (int,float) and math.isfinite(j[k]) for k in ['startTime','endTime']);assert j['endTime']>=j['startTime']
assert m['reason'] in ['completed-definition-after-15s','normal-compile-exit'] and m['intervalMicroseconds']==1000
print(json.dumps({'status':'COMPLETE_PROFILE_SCHEMA_PASS','sha256':digest,'bytes':len(raw),'samples':len(samples),'nodes':len(nodes),'scope':'Copied compiler sample; profile timestamps are not stock phase anchors'}))
'''
(d/'validate-profile.py.source').write_text(validator)
(d/'README.md').write_text('''# One sampled copied-CLI diagnostic (not launched)\n\nSame installed ELF f774/raw333165B015d, four literal profile-only patches. Compile entry starts node:inspector Session sampler interval1000us. First completed definition boundary after15s flushes one full profile; normal .c compile exit is the fallback. No timer, asynchronous callback, early cutoff, profiler restart, per-term hook, definition/fact/cache change or reduced source/output. Catch preserves original compiler exception; observation failure is explicit stderr. Sampler/stop/serialization/transport all perturb JIT, GC and scheduling and count against emit30; active interrupted/later interval is unmeasured. One profile maximum. Absence under external deadline is inconclusive.\n\nFirst command same-ELF file-mode cap5 API control imports only exact helper; tests synchronous stop, threshold boundary, double-start/finish and Unicode positive-shortwrite transport1/7/131072/full plus invalid progress. No compiler loads. Failure stops all later commands. Copied emit30 then conditional schema5/build120/runtime5; whole5077477/810259 and empty runtime stderr mandatory. Source/JS59721 positives and stock Native22214 deadline remain separate controls, not rerun. On emit deadline the collector does not run later validator; raw checkpoint remains for bounded archival schema review, without claiming a validator command. BUN_OPTIONS absent; BUN_BE_BUN1 runs the copied CLI via same ELF. Existing collector/guards/internal lock/resource aliases unchanged. No stock qualification/performance/cause/compiler adoption follows even if copied whole runtime succeeds. Independent exact launch review required.\n''')
