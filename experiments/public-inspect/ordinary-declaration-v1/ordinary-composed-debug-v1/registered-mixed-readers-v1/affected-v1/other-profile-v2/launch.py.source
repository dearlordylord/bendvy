import json,subprocess,sys
from pathlib import Path
plan=Path(sys.argv[1]).resolve();digest=sys.argv[2];p=json.loads(plan.read_text());out=Path(p['stage']);collector='/workspace/formal-proofs/bendvy/experiments/public-inspect/ordinary-declaration-v1/canonical-full-consumer-v1/development-v2.py'
code=1
try:
 code=subprocess.call([p['tools']['python'],collector,'run',str(plan),digest])
finally:
 # Always attempted after collector terminal, including emit30 deadline.
 with (out/'host-terminal.stdout').open('xb') as stdout,(out/'host-terminal.stderr').open('xb') as stderr:
  try:
   terminal=subprocess.run([p['tools']['python'],str(plan.parent/'host-observation.py.source')],stdout=stdout,stderr=stderr,timeout=5)
   status={'exit':terminal.returncode,'failure':None}
  except subprocess.TimeoutExpired:status={'exit':None,'failure':'host observation deadline5'}
 (out/'host-terminal.json').write_text(json.dumps(status)+'\n')
raise SystemExit(code)
