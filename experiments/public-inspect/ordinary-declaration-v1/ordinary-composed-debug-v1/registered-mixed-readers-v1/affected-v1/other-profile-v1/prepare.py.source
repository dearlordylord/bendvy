from pathlib import Path
import json,hashlib,shutil,importlib.util
wt=Path('/workspace/formal-proofs/bendvy-worktrees/ordinary-custom-store-v1');root=Path('/workspace/formal-proofs/bendvy')
d=wt/'experiments/public-inspect/ordinary-declaration-v1/ordinary-composed-debug-v1/registered-mixed-readers-v1/affected-v1/other-profile-v1';d.mkdir(exist_ok=True)
old=root/'experiments/public-bundles/owned-public-result-v1/common20-timing-v1/current-ordinary-v1/sampled-cli-v1'
for name in ['sample-helper.mjs','check-api.mjs','validate-profile.py.source','PATCHES.json']:
 shutil.copyfile(old/name,d/name)
(d/'compiler').mkdir(exist_ok=True)
for name in ['installed-cli-unmodified.mjs','installed-cli-sampled.mjs']:shutil.copyfile(old/'compiler'/name,d/'compiler'/name)
for name in ['base.bend','bendtt.lean','effs']:
 (d/'compiler'/name).symlink_to(Path('/home/node/.bend/bend2')/name,target_is_directory=name=='effs')
h=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
patch=json.loads((d/'PATCHES.json').read_text());s=(d/'compiler/installed-cli-sampled.mjs').read_text()
for x in reversed(patch['patches']):assert s.count(x['replacement'])==1;s=s.replace(x['replacement'],x['original'])
assert s.encode()==(d/'compiler/installed-cli-unmodified.mjs').read_bytes()
(d/'host-observation.py.source').write_text('''import json,os,time\nfrom pathlib import Path\nrows=[]\nfor p in Path('/proc').iterdir():\n if p.name.isdigit():\n  try:\n   cmd=(p/'cmdline').read_bytes().replace(bytes([0]),b' ').decode(errors='replace')\n   if any(x in cmd for x in ['bend','clang','taskset','development.py','development-v2.py']):rows.append({'pid':int(p.name),'command':cmd,'stat':(p/'stat').read_text(),'status':(p/'status').read_text()})\n  except (OSError,ProcessLookupError):pass\nprint(json.dumps({'timeNs':time.time_ns(),'affinity':sorted(os.sched_getaffinity(0)),'cpuStat':Path('/proc/stat').read_text(),'loadavg':Path('/proc/loadavg').read_text(),'processes':rows}))\n''')
plan=json.loads(Path('/tmp/bendvy-composed-registered-mixed-affected-other-runtime01/a-normal-native/plan.json').read_text())
out=Path('/tmp/bendvy-composed-registered-mixed-other-profile01');assert not out.exists();out.mkdir()
collector=root/'experiments/public-inspect/ordinary-declaration-v1/canonical-full-consumer-v1/development-v2.py'
plan.update(scope='ONE copied-CLI observation-only diagnostic of unchanged Other full fourteen checkpoints; not stock Native/runtime qualification or performance/cause attribution',stage=str(out),cwd=str(d),generated=str(out/'scenario.c'),native=str(out/'scenario.native'),postConsumer='No build or runtime requested; generic COMPLETE_CONSUMER label does not qualify consumer. Copied sampled CLI only.')
plan['environment'].update(BUN_BE_BUN='1',BENDVY_CPU_PROFILE_PATH=str(out/'compiler.cpuprofile'));plan['environment'].pop('BUN_OPTIONS',None)
t=plan['tools'];prefix=[t['taskset'],'-c','11'];elf=t['bend']
plan['commands']=[{'label':'source-host-before','argv':prefix+[t['python'],str(d/'host-observation.py.source')],'capSeconds':5,'expectedExit':0},{'label':'source-profile-api-control','argv':prefix+[elf,str(d/'check-api.mjs'),str(out/'api-control.cpuprofile')],'capSeconds':5,'expectedExit':0},{'label':'emit','argv':prefix+[elf,str(d/'compiler/installed-cli-sampled.mjs'),plan['entrypoint'],'-o',plan['generated']],'capSeconds':30},{'label':'source-profile-schema','argv':prefix+[t['python'],str(d/'validate-profile.py.source'),str(out/'compiler.cpuprofile')],'capSeconds':5,'expectedExit':0},{'label':'source-host-after','argv':prefix+[t['python'],str(d/'host-observation.py.source')],'capSeconds':5,'expectedExit':0}]
(d/'PROVENANCE.json').write_text(json.dumps({'originalOtherFailure':89401,'originalSource':'6977fb4c7','fullSourceUnchanged':True,'nativeSampler':'perf unavailable PATH; perf_event_paranoid2; no dependency installed','copiedWorkflow':str(old),'copiedHelpersByteExact':True,'literalPatchInverse':True,'scope':'Copied same-ELF CLI source profiling can perturb timing and cannot attribute stock deadline; interrupted sample inconclusive; no build/runtime'},indent=2)+'\n')
for p in d.rglob('*'):
 if p.is_file() and not p.is_symlink():plan['pins'][str(p)]=h(p)
plan['pins'][str(collector)]=h(collector)
sp=importlib.util.spec_from_file_location('runner',root/'scripts/task_runner.py');m=importlib.util.module_from_spec(sp);sp.loader.exec_module(m)
plan['resourceRoots'].update(m.Inputs(directories=[str(d/'compiler')]).expected)
for p,v in plan['pins'].items():assert h(p)==v,p
(d/'plan.json').write_text(json.dumps(plan,indent=2)+'\n')
(d/'PREPARED.json').write_text(json.dumps({'plan':str(d/'plan.json'),'sha256':h(d/'plan.json'),'collector':str(collector),'commands':5,'sourcePins':len(plan['sourceInventory']),'fullOtherSourceUnchanged':True,'patchInverse':True,'nativeQualification':False,'executed':False},indent=2)+'\n')
print(d,h(d/'plan.json'))
