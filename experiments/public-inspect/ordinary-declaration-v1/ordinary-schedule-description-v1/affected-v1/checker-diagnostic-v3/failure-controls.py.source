"""No-child synthetic controls for exact production launch finally paths."""
import ast,hashlib,json,tempfile,types,sys
from pathlib import Path
HERE=Path(__file__).resolve().parent
source=(HERE/'launch.py.source').read_text()
reports=[]
with tempfile.TemporaryDirectory(prefix='bendvy-checker-terminal-controls-') as raw:
 root=Path(raw)
 for scenario in ['removed-input','removed-resource','host-failure','observation-failure','save-failure','terminal-save-failure']:
  case=root/scenario;case.mkdir();out=case/'actual';pinned=case/'pinned';pinned.write_text('original');resource=case/'resources';resource.mkdir();(resource/'one').write_text('one')
  h=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
  p={'stage':str(out),'taskRunner':'fake-runner','sourceCapture':'fake-capture','lock':str(case/'lock'),'pins':{str(pinned):h(pinned)},'resourceRoots':{str(resource):{'one':h(resource/'one')}},'environment':{},'argv':['DO_NOT_LAUNCH'],'boundaryOutput':str(case/'marker')}
  plan=case/'plan.json';plan.write_text(json.dumps(p));digest=h(plan)
  def mock_capture(output,argv,execute):
   assert argv==['DO_NOT_LAUNCH']
   if scenario=='removed-input':pinned.unlink()
   if scenario=='removed-resource':(resource/'one').unlink();resource.rmdir()
   if scenario=='observation-failure':(case/'marker').mkdir()
   raise RuntimeError('PRIMARY_SENTINEL')
  class Inputs:
   def __init__(self,**kwargs):pass
   def guard(self):pass
  runner=types.SimpleNamespace(Inputs=Inputs,execute_result=lambda *a,**k:(_ for _ in ()).throw(AssertionError('No command allowed')))
  capture=types.SimpleNamespace(prepare_attempt=lambda output,paths:output.mkdir(),capture=mock_capture)
  tree=ast.parse(source);transformed=[]
  for node in tree.body:
   if isinstance(node,ast.FunctionDef) and node.name=='load':
    node=ast.parse('def load(path):\n return MOCK_RUNNER if path=="fake-runner" else MOCK_CAPTURE').body[0]
   if isinstance(node,ast.FunctionDef) and node.name=='host':
    node=ast.parse('def host():\n '+('raise OSError("HOST_SENTINEL")' if scenario=='host-failure' else 'return {"mock":True}')).body[0]
   transformed.append(node)
  tree.body=transformed;ast.fix_missing_locations(tree)
  oldargv=sys.argv;sys.argv=['launch',str(plan),digest];ns={'MOCK_RUNNER':runner,'MOCK_CAPTURE':capture}
  original_write=Path.write_text
  def write(path,*args,**kwargs):
   if scenario=='save-failure' and path.name=='post.json':raise OSError('SAVE_SENTINEL')
   if scenario=='terminal-save-failure' and path.name=='TERMINAL.json':raise OSError('TERMINAL_SAVE_SENTINEL')
   return original_write(path,*args,**kwargs)
  from io import StringIO
  fallback=StringIO();original_stderr=sys.stderr;sys.stderr=fallback;Path.write_text=write
  try:
   try:exec(compile(tree,'production-launch-with-no-child-doubles','exec'),ns)
   except SystemExit as e:assert e.code==1
  finally:sys.argv=oldargv;sys.stderr=original_stderr;Path.write_text=original_write
  terminal=json.loads((out/'TERMINAL.json').read_text()) if (out/'TERMINAL.json').exists() else json.loads(fallback.getvalue())
  assert terminal['primaryError']=={'type':'RuntimeError','message':'PRIMARY_SENTINEL'}
  assert (out/'host-after.json').exists() or scenario=='host-failure'
  if scenario in ['removed-input','removed-resource','host-failure','observation-failure','save-failure','terminal-save-failure']:assert terminal['captureErrors']
  reports.append({'scenario':scenario,'status':'PASS','primaryPreserved':True,'terminalOrFallbackRetained':True,'children':0})
print(json.dumps({'launchSHA256':hashlib.sha256(source.encode()).hexdigest(),'controls':reports,'scope':'AST replaces ONLY loader/host and fake source capture; production finally/save/post control flow executed, no checker or subprocess.'},indent=2))
