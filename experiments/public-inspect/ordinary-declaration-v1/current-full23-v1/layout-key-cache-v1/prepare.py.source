from pathlib import Path
import json,hashlib,copy,shutil
S=Path('/tmp/bendvy-inspector54-current/experiments/public-inspect/ordinary-declaration-v1/current-full23-v1');L=S/'layout-key-cache-v1';O=Path('/tmp/bendvy54-current-layout-key-actual01');sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest();assert not L.exists() and not O.exists();(L/'compiler').mkdir(parents=True);O.mkdir();a=json.load(open(S/'graph-lookup-candidate-v1/LINEAGE.json'));src=Path(a['candidate']).read_text();patches=[{'name':'cache-storage','original':'var LAYS = new Map;','replacement':'var LAYS = new Map;\nvar LAY_KEYS = new WeakMap;'}, {'name':'normalization-invalidation','original':'                fr.l.v = fr.a === undefined ? tm : Ann(tm, term_cell(fr.a.T), fr.a.s);','replacement':'                LAY_KEYS = new WeakMap;\n                fr.l.v = fr.a === undefined ? tm : Ann(tm, term_cell(fr.a.T), fr.a.s);'}, {'name':'equality-invalidation','original':'      rhs.v = lhs.v;','replacement':'      LAY_KEYS = new WeakMap;\n      rhs.v = lhs.v;'}, {'name':'key-helper','original':'function lay_of(book, A) {','replacement':'function lay_key(t) {\n  return memo(LAY_KEYS, t, () => term_key(term_lower(t)));\n}\nfunction lay_of(book, A) {'}, {'name':'key-use','original':'memo(LAYS, term_key(term_lower(t)), (key) => {','replacement':'memo(LAYS, lay_key(t), (key) => {'}, {'name':'per-book-reset','original':'function file_book(book, roots, js) {','replacement':'function file_book(book, roots, js) {\n  LAY_KEYS = new WeakMap;'}]
text=src
for p in patches:assert text.count(p['original'])==1;text=text.replace(p['original'],p['replacement'])
back=text
for p in reversed(patches):assert back.count(p['replacement'])==1;back=back.replace(p['replacement'],p['original'])
assert back==src;(L/'compiler/candidate.mjs').write_text(text)
