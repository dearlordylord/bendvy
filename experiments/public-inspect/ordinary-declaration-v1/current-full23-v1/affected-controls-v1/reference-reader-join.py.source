def block(source,name):
 lines=source.splitlines();i=next(i for i,l in enumerate(lines) if l.startswith('def '+name+'('));j=i+1
 while j<len(lines) and (not lines[j] or lines[j].startswith('  ')):j+=1
 return '\n'.join(lines[i:j]).rstrip()
for r in join['sourceComparisons']:
 p=C/r['path'];text=p.read_text();row={'path':str(p),'currentWholeSHA256':sha(p)}
 if r['path']!='src/ecs/event-notice-runtime.bend':assert sha(p)==r.get('currentSHA256',r.get('currentModuleSHA256'));row['sameAsQualifiedJoinedModule']=True
 checks=[]
 for f in r.get('functions',[]):
  h=hashlib.sha256(block(text,f['name']).encode()).hexdigest();assert h==f['currentSHA256'];checks.append({'name':f['name'],'sha256':h,'exactQualifiedJoinedBody':True})
 row['functions']=checks;rows.append(row)
