ROOT=Path('/workspace/formal-proofs/bendvy');targets={'inspector-query-projection.bend':['matched_right','pair_matches_target','pair_matches','projected_left','pair_project_target','pair_project','predicate_right','predicate_both_target','predicate_both','constrained_target','constrained','mapped','map_project'],'inspector-query.bend':['composed_lookup_matched','composed_lookup_valid','composed_scan_matched']};importers=[];hits=[]
for rel in subprocess.check_output(['git','ls-files','-z','*.bend'],cwd=ROOT).decode().split('\0'):
 if not rel:continue
 p=ROOT/rel
 if not p.is_file():continue
 text=p.read_text()
 for imp,alias in re.findall(r'^import\s+(\S+)\s+as\s+(\w+)',text,re.M):
  name=Path(imp).name
  if name not in targets:continue
  resolved=(Path(imp) if Path(imp).is_absolute() else p.parent/imp).resolve()
  if resolved != ROOT/'src/ecs'/name:continue
  importers.append({'path':rel,'sha256':sha(p),'module':name,'alias':alias})
  for helper in targets[name]:
   if re.search(r'\b'+re.escape(alias)+r'\.'+helper+r'\b',text):hits.append({'path':rel,'helper':helper})
assert not hits
