 for before,after in adapter['REPLACEMENTS'].get(name,()):assert body.decode().count(before)==1;body=body.decode().replace(before,after).encode()
 target=legacy/'examples/query-composition'/name;assert target.read_bytes()==body;work.append({'path':name,'oldStageSHA256':sha(target),'currentMigratedSHA256':hashlib.sha256(body).hexdigest()})
