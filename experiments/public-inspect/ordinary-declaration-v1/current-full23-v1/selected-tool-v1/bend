#!/bin/sh
set -eu
selection_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
unset BUN_OPTIONS BUN_BE_BUN
case "${1-}" in
  version|--version) exec /home/node/.bend/bin/bend-2.0.35 "$@" ;;
esac
cli="$selection_dir/prepared/compiler/cli.mjs"
[ -f "$cli" ] || { echo 'selected Bend CLI is not prepared; run selected-tool-v1/prepare.py' >&2; exit 2; }
export BUN_BE_BUN=1
exec /home/node/.bend/bin/bend-2.0.35 "$cli" "$@"
