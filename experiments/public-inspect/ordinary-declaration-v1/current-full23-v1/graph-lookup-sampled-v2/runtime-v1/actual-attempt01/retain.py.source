from pathlib import Path
import json,gzip,hashlib,shutil
R=Path('/tmp/bendvy54-current-graph-lookup-sampled02');L=Path('/tmp/bendvy-inspector54-current/experiments/public-inspect/ordinary-declaration-v1/current-full23-v1/graph-lookup-sampled-v2/runtime-v1/actual-attempt01');assert not L.exists();L.mkdir(parents=True);sha=lambda b:hashlib.sha256(b).hexdigest();rows=[]
for f in sorted(R.iterdir()):
 if not f.is_file():continue
 raw=f.read_bytes();name=f.name+'.gz' if f.name.endswith('.cpuprofile') else f.name;dest=L/name
 if name.endswith('.gz'):dest.write_bytes(gzip.compress(raw,mtime=0));assert gzip.decompress(dest.read_bytes())==raw
 else:dest.write_bytes(raw)
 rows.append({'actualPath':str(f),'retainedPath':name,'actualBytes':len(raw),'actualSHA256':sha(raw),'retainedBytes':dest.stat().st_size,'retainedSHA256':sha(dest.read_bytes()),'encoding':'gzip' if name.endswith('.gz') else 'exact'})
plan=json.loads((R/'plan.json').read_text());receipt=json.loads((R/'receipt.json').read_text());assert plan['commands'][2]['label']=='emit';assert receipt['commands'][2]['failure']=='child deadline'
meta=json.loads((R/'compiler.cpuprofile.metadata.json').read_text());validation=json.loads((R/'ROOT-PROFILE-VALIDATION.json').read_text());assert meta['sha256']==validation['profileSHA256']==sha((R/'compiler.cpuprofile').read_bytes());assert validation['exit']==0
record={'scope':'Exact diagnostic output payload retention only. Original absolute receipts and input provenance unchanged; not a whole source/resources portable join. Source/candidate/model bindings remain frozen in parent leaf. No Native qualification.','actualDirectory':str(R),'planSHA256':sha((R/'plan.json').read_bytes()),'receiptSHA256':sha((R/'receipt.json').read_bytes()),'files':rows,'validationScope':'Collector schema child unexecuted after emitdeadline; ROOT-PROFILE-VALIDATION.json separately records actual root validator exit0.','actualResult':'Lineage/API passed; emit30deadline; profile published at first completed-definition checkpoint after15s; no C/build/runtime.'};(L/'RETENTION.json').write_text(json.dumps(record,indent=2)+'\n');shutil.copy2(__file__,L/'retain.py.source');print(len(rows))
