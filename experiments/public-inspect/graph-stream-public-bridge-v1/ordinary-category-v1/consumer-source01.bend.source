def inspect_body(~S:Data,~H:Type,~caps:Ops<S,H>,_:Unit,owner:H) -> H & Result<&2,&2,Unit,String>:
  observe_link_required_out(~S,~H,~caps,"",IQ.each_composed(~H,~S,~Q.Product<Unit,List<&2,RQ.Cell<S>>>,~cap_link_required_out(~S,~H,caps),owner))
def check_parent_absent_in(~S:Data,~H:Type,~caps:Ops<S,H>,accepted:Bool,result:H & Rows(~S)) -> H & Bool:
  (owner,rows)=result
  matches=Nat.is_eq(List.length(&2,Relation.Row(~S),rows),2n)
  (owner,Bool.and(accepted,matches))
