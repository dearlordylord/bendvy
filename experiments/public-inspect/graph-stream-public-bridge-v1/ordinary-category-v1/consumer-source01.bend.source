def condition_body(~S:Data,~H:Type,~caps:Ops<S,H>,_:Unit,owner:H) -> H & Bool:
  check_link_required_out(~S,~H,~caps,True{},IQ.each_composed(~H,~S,~Q.Product<Unit,List<&2,RQ.Cell<S>>>,~cap_link_required_out(~S,~H,caps),owner))
def required(~S:Data,world:World(~S)) -> World(~S) & List<&2,String>:
  (world,[])
def inspect_plan(~S:Data) -> I.Plan<S,A.Store<S,State.Components<S>>,State.Resources<S>,A.Notice<S,U32>,H => Ops<S,H>>:
  I.Plan{inspect_caps(~S)}
def condition_plan(~S:Data) -> K.Plan<S,A.Store<S,State.Components<S>>,State.Resources<S>,A.Notice<S,U32>,H => Ops<S,H>>:
  K.Plan{required(~S),condition_caps(~S)}
def result(value:Result<&2,&2,Unit,String>) -> String:
  match value:
    case Done{text}:text
    case Fail{_}:"InspectorFailure"
def cursor(~S:Data,value:I.Instance<S>) -> String:
  match value:
    case I.Fresh{}:"Fresh"
    case I.Active{cursor,registeredAt}:"Active:" ++ U32.show(cursor) ++ ":" ++ U32.show(registeredAt)
def instance_text(~S:Data,value:I.Instance<S>) -> I.Instance<S> & String:
  match value:
    case I.Fresh{}:(I.Fresh{},"Fresh")
    case I.Active{+cursor,+registeredAt}:(I.Active{cursor,registeredAt},"Active:" ++ U32.show(cursor) ++ ":" ++ U32.show(registeredAt))
def condition_result(value:Result<&2,&2,K.Error,Bool>) -> String:
  match value:
    case Done{flag}:Bool.show(flag)
    case Fail{_}:"ConditionFailure"
def finish(~S:Data,prefix:String,observed:World(~S) & String) -> String:
  (world,text)=observed
  prefix ++ text
def check_after(~S:Data,prefix:String,checked:K.Checked<S,A.Store<S,State.Components<S>>,State.Resources<S>,A.Notice<S,U32>>) -> String:
  match checked:
    case K.Checked{world,flag}:finish(~S,prefix ++ "Check=" ++ condition_result(flag) ++ "\n",Dump.world(~S,world))
def repeated_checked(~S:Data,prefix:String,checked:K.Checked<S,A.Store<S,State.Components<S>>,State.Resources<S>,A.Notice<S,U32>>) -> String:
  match checked:
    case K.Checked{world,flag}:check_after(~S,prefix ++ "CheckFirst=" ++ condition_result(flag) ++ "\n",K.run(~S,~A.Store<S,State.Components<S>>,~State.Resources<S>,~A.Notice<S,U32>,~(H => Ops<S,H>),~Unit,~condition_body(~S),~condition_plan(~S),Unit{},world))
def second_dumped(~S:Data,prefix:String,observed:World(~S) & String) -> String:
  (world,text)=observed
  repeated_checked(~S,prefix ++ text ++ "\n",K.run(~S,~A.Store<S,State.Components<S>>,~State.Resources<S>,~A.Notice<S,U32>,~(H => Ops<S,H>),~Unit,~condition_body(~S),~condition_plan(~S),Unit{},world))
def second(~S:Data,prefix:String,observed:I.Observed<S,A.Store<S,State.Components<S>>,State.Resources<S>,A.Notice<S,U32>,Unit,String>) -> String:
  match observed:
    case I.Observed{world,instance,value}:second_dumped(~S,prefix ++ "Second=" ++ cursor(~S,instance) ++ "\n" ++ result(value),Dump.world(~S,world))
def first_dumped(~S:Data,prefix:String,instance:I.Instance<S>,observed:World(~S) & String) -> String:
  (world,text)=observed
  second(~S,prefix ++ text ++ "\n",I.run(~S,~A.Store<S,State.Components<S>>,~State.Resources<S>,~A.Notice<S,U32>,~(H => Ops<S,H>),~Unit,~Unit,~String,~inspect_plan(~S),~inspect_body(~S),instance,Unit{},world))
def first_metadata(~S:Data,prefix:String,world:World(~S),observed:I.Instance<S> & String) -> String:
  (instance,text)=observed
  first_dumped(~S,prefix ++ "First=" ++ text ++ "\n",instance,Dump.world(~S,world))
def first(~S:Data,prefix:String,observed:I.Observed<S,A.Store<S,State.Components<S>>,State.Resources<S>,A.Notice<S,U32>,Unit,String>) -> String:
  match observed:
    case I.Observed{world,instance,value}:first_metadata(~S,prefix ++ result(value),world,instance_text(~S,instance))
def before(~S:Data,observed:World(~S) & String) -> String:
  (world,text)=observed
  first(~S,"Before=" ++ text ++ "\n",I.run(~S,~A.Store<S,State.Components<S>>,~State.Resources<S>,~A.Notice<S,U32>,~(H => Ops<S,H>),~Unit,~Unit,~String,~inspect_plan(~S),~inspect_body(~S),I.Fresh{},Unit{},world))
def Application(~S:Data) -> Type:
  Relation.Application(~S,~State.Components<S>,~State.Resources<S>,~U32,~D.declared_link(~S),~Unit,~Unit,~Build.empty_observe(~World(~S)),~Leaf.empty(~S))
def installed(~S:Data,app:Application(~S)) -> String:
  match app:
    case Build.Registered{world,_,_,_}:before(~S,Dump.world(~S,world))
def scenario(~S:Data,namespace:U32,base:U32) -> String:
  installed(~S,Relation.install(~S,~State.Components<S>,~State.Resources<S>,~U32,~D.declared_link(~S),~Unit,~Unit,~Build.empty_observe(~World(~S)),~Leaf.empty(~S),Build.empty(~S,~World(~S),Fixture.world(~S,namespace,base))))
