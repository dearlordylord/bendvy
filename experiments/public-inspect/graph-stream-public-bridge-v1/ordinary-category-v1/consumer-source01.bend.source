def observe_parent_absent_in(~S:Data,~H:Type,~caps:Ops<S,H>,prefix:String,result:H & Rows(~S)) -> H & Result<&2,&2,Unit,String>:
  (owner,rows)=result
  text="parent_absent_in=" ++ List.show(&2,Relation.Row(~S),Relation.builtin_row(~S),rows) ++ "\n"
  (owner,Done{prefix ++ text})
def observe_parent_present_in(~S:Data,~H:Type,~caps:Ops<S,H>,prefix:String,result:H & Rows(~S)) -> H & Result<&2,&2,Unit,String>:
  (owner,rows)=result
  text="parent_present_in=" ++ List.show(&2,Relation.Row(~S),Relation.builtin_row(~S),rows) ++ "\n"
  observe_parent_absent_in(~S,~H,~caps,prefix ++ text,IQ.each_composed(~H,~S,~Q.Product<Unit,List<&2,RQ.Cell<S>>>,~cap_parent_absent_in(~S,~H,caps),owner))
