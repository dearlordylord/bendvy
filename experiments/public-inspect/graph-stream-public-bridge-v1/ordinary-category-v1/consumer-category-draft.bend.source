import Base
import /workspace/formal-proofs/bendvy/src/ecs/world.bend as W
import /workspace/formal-proofs/bendvy/src/ecs/relation-commands.bend as A
import /workspace/formal-proofs/bendvy/src/ecs/relation-query.bend as RQ
import /workspace/formal-proofs/bendvy/src/ecs/inspector.bend as I
import /workspace/formal-proofs/bendvy/src/ecs/check.bend as K
import /workspace/formal-proofs/bendvy/src/ecs/inspector-query.bend as IQ
import /workspace/formal-proofs/bendvy/src/ecs/inspector-query-projection.bend as Q
import /workspace/formal-proofs/bendvy/src/ecs/ordinary-app-relation.bend as Relation
import /workspace/formal-proofs/bendvy/src/ecs/ordinary-inspector-relation.bend as Decl
import /workspace/formal-proofs/bendvy/src/ecs/ordinary-app-composer.bend as Build
import /workspace/formal-proofs/bendvy/src/ecs/ordinary-app-records.bend as Leaf
import state.bend as State
import declarations.bend as D
import fixture.bend as Fixture
import dump.bend as Dump

def World(~S:Data) -> Type:
  W.World<S,A.Store<S,State.Components<S>>,State.Resources<S>,A.Notice<S,U32>>
def Rows(~S:Data) -> Data:
  List<&2,Relation.Row(~S)>
def Query(~S:Data,~H:Type) -> Type:
  IQ.ComposedReadQuery<H,S,Q.Product<Unit,List<&2,RQ.Cell<S>>>>
def link_required_out(~S:Data) -> Decl.Declaration<S>:
  Decl.required_out(~S,"link_required_out",D.declared_link(~S))
def link_optional_out(~S:Data) -> Decl.Declaration<S>:
  Decl.optional_out(~S,"link_optional_out",D.declared_link(~S))
def link_present_out(~S:Data) -> Decl.Declaration<S>:
  Decl.present_out(~S,D.declared_link(~S))
def link_absent_out(~S:Data) -> Decl.Declaration<S>:
  Decl.absent_out(~S,D.declared_link(~S))
def link_required_in(~S:Data) -> Decl.Declaration<S>:
  Decl.required_in(~S,"link_required_in",D.declared_link(~S))
def link_optional_in(~S:Data) -> Decl.Declaration<S>:
  Decl.optional_in(~S,"link_optional_in",D.declared_link(~S))
def link_present_in(~S:Data) -> Decl.Declaration<S>:
  Decl.present_in(~S,D.declared_link(~S))
def link_absent_in(~S:Data) -> Decl.Declaration<S>:
  Decl.absent_in(~S,D.declared_link(~S))
def parent_required_out(~S:Data) -> Decl.Declaration<S>:
  Decl.required_out(~S,"parent_required_out",D.declared_parent(~S))
def parent_optional_out(~S:Data) -> Decl.Declaration<S>:
  Decl.optional_out(~S,"parent_optional_out",D.declared_parent(~S))
def parent_present_out(~S:Data) -> Decl.Declaration<S>:
  Decl.present_out(~S,D.declared_parent(~S))
def parent_absent_out(~S:Data) -> Decl.Declaration<S>:
  Decl.absent_out(~S,D.declared_parent(~S))
def parent_required_in(~S:Data) -> Decl.Declaration<S>:
  Decl.required_in(~S,"parent_required_in",D.declared_parent(~S))
def parent_optional_in(~S:Data) -> Decl.Declaration<S>:
  Decl.optional_in(~S,"parent_optional_in",D.declared_parent(~S))
def parent_present_in(~S:Data) -> Decl.Declaration<S>:
  Decl.present_in(~S,D.declared_parent(~S))
def parent_absent_in(~S:Data) -> Decl.Declaration<S>:
  Decl.absent_in(~S,D.declared_parent(~S))
type Context<S:Data> is Type:
  Context{world:World(~S),instance:I.Instance<S>}
def inspect_rows(~S:Data,~H:Type,result:H & Rows(~S)) -> H & Result<&2,&2,Unit,String>:
  (owner,rows)=result
  (owner,Done{List.show(&2,Relation.Row(~S),Relation.builtin_row(~S),rows)})
def inspect_body(~S:Data,~H:Type,~caps:Query(~S,~H),_:Unit,owner:H) -> H & Result<&2,&2,Unit,String>:
  inspect_rows(~S,~H,IQ.each_composed(~H,~S,~Q.Product<Unit,List<&2,RQ.Cell<S>>>,~caps,owner))
def condition_rows(~S:Data,~H:Type,expected:Nat,result:H & Rows(~S)) -> H & Bool:
  (owner,rows)=result
  (owner,Nat.is_eq(List.length(&2,Relation.Row(~S),rows),expected))
def condition_body(~S:Data,~H:Type,~caps:Query(~S,~H),expected:Nat,owner:H) -> H & Bool:
  condition_rows(~S,~H,expected,IQ.each_composed(~H,~S,~Q.Product<Unit,List<&2,RQ.Cell<S>>>,~caps,owner))
def required(~S:Data,world:World(~S)) -> World(~S) & List<&2,String>:
  (world,[])
def inspect_plan(~S:Data,~declaration:Decl.Declaration<S>) -> I.Plan<S,A.Store<S,State.Components<S>>,State.Resources<S>,A.Notice<S,U32>,H => Query(~S,~H)>:
  I.Plan{Decl.inspect(~S,~State.Components<S>,~State.Resources<S>,~U32,~Unit,~Q.empty(~I.Frame<S,A.Store<S,State.Components<S>>,State.Resources<S>,A.Notice<S,U32>>,~S),~declaration)}
def condition_plan(~S:Data,~declaration:Decl.Declaration<S>) -> K.Plan<S,A.Store<S,State.Components<S>>,State.Resources<S>,A.Notice<S,U32>,H => Query(~S,~H)>:
  K.Plan{required(~S),Decl.condition(~S,~State.Components<S>,~State.Resources<S>,~U32,~Unit,~Q.empty(~K.Frame<S,A.Store<S,State.Components<S>>,State.Resources<S>,A.Notice<S,U32>>,~S),~declaration)}
def inspected(value:Result<&2,&2,Unit,String>) -> String:
  match value:
    case Done{text}:text
    case Fail{_}:"InspectorFailure"
def checked(value:Result<&2,&2,K.Error,Bool>) -> String:
  match value:
    case Done{value}:Bool.show(value)
    case Fail{_}:"CheckFailure"
def instance_text(~S:Data,value:I.Instance<S>) -> I.Instance<S> & String:
  match value:
    case I.Fresh{}:(I.Fresh{},"Fresh")
    case I.Active{+cursor,+registeredAt}:(I.Active{cursor,registeredAt},"Active:" ++ U32.show(cursor) ++ ":" ++ U32.show(registeredAt))
def complete(~S:Data,prefix:String,instance:I.Instance<S>,observed:World(~S) & String) -> Context<S> & String:
  (world,text)=observed
  (Context{world,instance},prefix ++ text)
def second_check(~S:Data,prefix:String,instance:I.Instance<S>,result:K.Checked<S,A.Store<S,State.Components<S>>,State.Resources<S>,A.Notice<S,U32>>) -> Context<S> & String:
  match result:
    case K.Checked{world,value}:complete(~S,prefix ++ "CheckSecond=" ++ checked(value) ++ "\n",instance,Dump.world(~S,world))
def first_check(~S:Data,~declaration:Decl.Declaration<S>,expected:Nat,prefix:String,instance:I.Instance<S>,result:K.Checked<S,A.Store<S,State.Components<S>>,State.Resources<S>,A.Notice<S,U32>>) -> Context<S> & String:
  match result:
    case K.Checked{world,value}:second_check(~S,prefix ++ "CheckFirst=" ++ checked(value) ++ "\n",instance,K.run(~S,~A.Store<S,State.Components<S>>,~State.Resources<S>,~A.Notice<S,U32>,~(H => Query(~S,~H)),~Nat,~condition_body(~S),~condition_plan(~S,~declaration),expected,world))
def after_second(~S:Data,~declaration:Decl.Declaration<S>,+expected:Nat,prefix:String,instance:I.Instance<S>,observed:World(~S) & String) -> Context<S> & String:
  (world,text)=observed
  first_check(~S,~declaration,expected,prefix ++ text ++ "\n",instance,K.run(~S,~A.Store<S,State.Components<S>>,~State.Resources<S>,~A.Notice<S,U32>,~(H => Query(~S,~H)),~Nat,~condition_body(~S),~condition_plan(~S,~declaration),expected,world))
def second_instance(~S:Data,~declaration:Decl.Declaration<S>,expected:Nat,prefix:String,world:World(~S),observed:I.Instance<S> & String) -> Context<S> & String:
  (instance,text)=observed
  after_second(~S,~declaration,expected,prefix ++ "SecondCursor=" ++ text ++ "\n",instance,Dump.world(~S,world))
def second(~S:Data,~declaration:Decl.Declaration<S>,expected:Nat,prefix:String,observed:I.Observed<S,A.Store<S,State.Components<S>>,State.Resources<S>,A.Notice<S,U32>,Unit,String>) -> Context<S> & String:
  match observed:
    case I.Observed{world,instance,value}:second_instance(~S,~declaration,expected,prefix ++ "SecondRows=" ++ inspected(value) ++ "\n",world,instance_text(~S,instance))
def after_first(~S:Data,~declaration:Decl.Declaration<S>,expected:Nat,prefix:String,instance:I.Instance<S>,observed:World(~S) & String) -> Context<S> & String:
  (world,text)=observed
  second(~S,~declaration,expected,prefix ++ text ++ "\n",I.run(~S,~A.Store<S,State.Components<S>>,~State.Resources<S>,~A.Notice<S,U32>,~(H => Query(~S,~H)),~Unit,~Unit,~String,~inspect_plan(~S,~declaration),~inspect_body(~S),instance,Unit{},world))
def first_instance(~S:Data,~declaration:Decl.Declaration<S>,expected:Nat,prefix:String,world:World(~S),observed:I.Instance<S> & String) -> Context<S> & String:
  (instance,text)=observed
  after_first(~S,~declaration,expected,prefix ++ "FirstCursor=" ++ text ++ "\n",instance,Dump.world(~S,world))
def first(~S:Data,~declaration:Decl.Declaration<S>,expected:Nat,prefix:String,observed:I.Observed<S,A.Store<S,State.Components<S>>,State.Resources<S>,A.Notice<S,U32>,Unit,String>) -> Context<S> & String:
  match observed:
    case I.Observed{world,instance,value}:first_instance(~S,~declaration,expected,prefix ++ "FirstRows=" ++ inspected(value) ++ "\n",world,instance_text(~S,instance))
def before(~S:Data,~declaration:Decl.Declaration<S>,expected:Nat,name:String,instance:I.Instance<S>,observed:World(~S) & String) -> Context<S> & String:
  (world,text)=observed
  first(~S,~declaration,expected,name ++ "\nBefore=" ++ text ++ "\n",I.run(~S,~A.Store<S,State.Components<S>>,~State.Resources<S>,~A.Notice<S,U32>,~(H => Query(~S,~H)),~Unit,~Unit,~String,~inspect_plan(~S,~declaration),~inspect_body(~S),instance,Unit{},world))
def action(~S:Data,~declaration:Decl.Declaration<S>,expected:Nat,name:String,context:Context<S>) -> Context<S> & String:
  match context:
    case Context{world,instance}:before(~S,~declaration,expected,name,instance,Dump.world(~S,world))
def joined(~S:Data,next:Context<S> -> String -> String,result:Context<S> & String) -> String:
  match result:
    case (context,text):next(context,text)
def sequence(~S:Data,actions:List<Context<S> -> Context<S> & String>,prefix:String,context:Context<S>) -> String:
  match actions:
    case []:prefix
    case first <> rest:joined(~S,next=>text=>sequence(~S,rest,prefix ++ text ++ "\n",next),first(context))
def Application(~S:Data) -> Type:
  Relation.Application(~S,~State.Components<S>,~State.Resources<S>,~U32,~D.declared_link(~S),~Unit,~Unit,~Build.empty_observe(~World(~S)),~Leaf.empty(~S))
def installed(~S:Data,app:Application(~S)) -> String:
  match app:
    case Build.Registered{world,_,_,_}:sequence(~S,[action(~S,~link_required_out(~S),2n,"link_required_out"),action(~S,~link_optional_out(~S),3n,"link_optional_out"),action(~S,~link_present_out(~S),2n,"link_present_out"),action(~S,~link_absent_out(~S),1n,"link_absent_out"),action(~S,~link_required_in(~S),1n,"link_required_in"),action(~S,~link_optional_in(~S),3n,"link_optional_in"),action(~S,~link_present_in(~S),1n,"link_present_in"),action(~S,~link_absent_in(~S),2n,"link_absent_in"),action(~S,~parent_required_out(~S),2n,"parent_required_out"),action(~S,~parent_optional_out(~S),3n,"parent_optional_out"),action(~S,~parent_present_out(~S),2n,"parent_present_out"),action(~S,~parent_absent_out(~S),1n,"parent_absent_out"),action(~S,~parent_required_in(~S),1n,"parent_required_in"),action(~S,~parent_optional_in(~S),3n,"parent_optional_in"),action(~S,~parent_present_in(~S),1n,"parent_present_in"),action(~S,~parent_absent_in(~S),2n,"parent_absent_in")],"",Context{world,I.Fresh{}})
def scenario(~S:Data,namespace:U32,base:U32) -> String:
  installed(~S,Relation.install(~S,~State.Components<S>,~State.Resources<S>,~U32,~D.declared_link(~S),~Unit,~Unit,~Build.empty_observe(~World(~S)),~Leaf.empty(~S),Build.empty(~S,~World(~S),Fixture.world(~S,namespace,base))))
