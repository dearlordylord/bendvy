"""Independent finite TS ordinary category model; draft pending frozen checks."""
import json
MODES=('required_out','optional_out','required_in','optional_in','present_out','absent_out','present_in','absent_in')
SCOPE='Readonly ordinary relation categories and Check; complete TS public dump/stream observations, pending work retained, two nominal schemas; TS physical clock/observer vocabulary differs from Bend'
def rows(relation,mode):
    kind,direction=mode.split('_');result=[]
    for entity in (1,2,3):
        present=entity in (1,3) if direction=='out' else entity==2
        if kind in ('required','present') and not present:continue
        if kind=='absent' and present:continue
        cells=[]
        if kind in ('required','optional'):
            if not present:cells=[{'missing':True}]
            elif direction=='out':cells=[{'target':2}]
            else:cells=[{'sources':[3,1] if relation=='Link' else [1,3]}]
        result.append({'id':entity,'cells':cells})
    return result
def point(name,frame,tick):
    entities=[]
    for i in (1,2,3):
        relations={name+'/Link':2,name+'/Parent':2} if i in (1,3) else {}
        entities.append({'id':i,'components':{name+'/Cells':[i,i+10],name+'/Sibling':[i+20,i+30]},'relations':relations})
    world={'version':1,'frame':frame,'tick':tick,'entityCount':3,'entities':entities,'resources':{name+'/Owned':[11,12],name+'/SiblingOwner':[21,22]},'machines':{},'pendingCommands':[{'tag':'spawn','system':name+'/Pending'}]}
    # Pulse publication tick3 remains held by operational Reader completed at1.
    streams=[{'kind':'event','stream':name+'/Pulse','size':1,'capacity':65536,'readers':[{'system':name+'/Reader','unread':1,'lagged':False}],'heldBy':name+'/Reader'}]
    return {'world':world,'streams':streams,'readerValues':[[]]}
def expected():
    observations=[]
    for name in ('Workshop','Garden'):
        # Reader1, Seed2+publication3, deferred4, Edges5, deferred6, Pending7.
        frame,tick=6,7
        for relation in ('Link','Parent'):
            for mode in MODES:
                record={'schema':name,'relation':relation,'mode':mode,'before':point(name,frame,tick),'firstRows':rows(relation,mode)}
                tick+=1;record['afterFirst']=point(name,frame,tick)
                record['secondRows']=rows(relation,mode)
                tick+=1;record['afterSecond']=point(name,frame,tick)
                # Each true check gates one Noop; check itself advances no tick.
                frame+=2;tick+=2;record['checks']=[True,True]
                record['afterChecks']=point(name,frame,tick);observations.append(record)
    return (json.dumps({'scope':SCOPE,'observations':observations},ensure_ascii=False,separators=(',',':'))+'\n').encode()
