"""Draft source-derived RequiredIn routing countermodel; await applied-source binding."""
import json
def ls(values):return '['+', '.join(values)+']'
def descriptor(key):return ['','1:Link:LinkedBy:ordinary','2:Parent:Children:hierarchy'][key]
def world(ns,base,clock):
    edges=ls([descriptor(k)+f':{source}>2' for k,source in [(1,1),(1,3),(2,1),(2,3)]])
    inverse=ls([descriptor(1)+':2:[3, 1]',descriptor(2)+':2:[1, 3]'])
    store=f'N(L({base}),L({base+2}));graph='+edges+';'+inverse
    resources=f'N(L({base}),L({base+1}));slot(7,next(9,False),4,True);slot(11,next(12,True),10,False);ran=0;stream([2:[4>7], 3:[7>8, 8>7]],[5:1:1],0,2);stream([],[],0,0)'
    cleanup=ls(['enter:3','descriptors:3:'+ls([descriptor(1),descriptor(2)]),'children:3:'+descriptor(2)+':'+ls([descriptor(1)])+':[1, 3]','finish:3'])
    events=ls(['user:17','relationFailed:'+descriptor(2)+':relate:2:3:hierarchyCycle:2:3:Parent','componentRemoved:23','cleanupPaused:'+cleanup])
    return f'world({ns},4,3,N(N(L(False),L(True)),N(L(True),L(True))),4,2,{store},{resources},events={events},pending=1,regs=[1:Existing:[Flow, Link]],nextSystem=2,clock={clock})'
def rows(ns,key):
    relation,mode,direction=key.split('_',2)
    # Mutant dispatch retains key but requests Required Outgoing.
    if mode == 'required' and direction == 'in': direction='out'
    projected=mode in ('required','optional')
    values=[]
    for entity in (1,2,3):
        present=entity in (1,3) if direction=='out' else entity==2
        if mode in ('required','present') and not present:continue
        if mode=='absent' and present:continue
        if not projected:cells=[]
        else:
            if not present:value='Missing'
            elif direction=='out':value=f'Target:{ns}:2'
            else:
                sources=(3,1) if relation=='link' else (1,3)
                value='Sources:'+ls([f'{ns}:{i}' for i in sources])
            cells=[key+':'+('Outgoing' if direction=='out' else 'Incoming')+':'+value]
        values.append(f'{ns}:{entity}:'+ls(cells))
    return ls(values)
def scenario(ns,base,mode):
    clock=13;registered=13;parts=[]
    for key in ('link_'+mode,'parent_'+mode):
        text=key+'\nBefore='+world(ns,base,clock)+'\n'
        clock+=1;text+='FirstRows='+rows(ns,key)+'\nFirstCursor=Active:'+str(clock)+':'+str(registered)+'\n'+world(ns,base,clock)+'\n'
        clock+=1;text+='SecondRows='+rows(ns,key)+'\nSecondCursor=Active:'+str(clock)+':'+str(registered)+'\n'+world(ns,base,clock)+'\n'
        # Both K.run are read-only, with no clock change or command barrier.
        text+='CheckFirst=False\nCheckSecond=False\n'+world(ns,base,clock)
        parts.append(text+'\n')
    return ''.join(parts)
def expected(mode):
    # Installed show_main Tuple kind2 prints (a, b); String show escapes quotes/newlines.
    values=[scenario(31,100,mode),scenario(47,200,mode)]
    return ('('+', '.join(json.dumps(v,ensure_ascii=False) for v in values)+')\n').encode()
