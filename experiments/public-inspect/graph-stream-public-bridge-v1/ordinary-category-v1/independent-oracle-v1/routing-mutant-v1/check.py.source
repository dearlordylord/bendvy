from pathlib import Path
import json,hashlib,gzip,runpy
p=Path(__file__).resolve().parent;b=json.loads((p/'SOURCE-BASIS.json').read_text())
for group in ('sourcePins','inputs','modelPins'):
 for path,digest in b[group].items():assert hashlib.sha256(Path(path).read_bytes()).hexdigest()==digest,path
applied=json.loads(Path(next(x for x in b['inputs'] if x.endswith('ROOT-APPLIED.json'))).read_text())
mutant=Path(applied['target']).read_text();normal=Path(applied['backup']).read_text()
assert mutant.count(applied['newArm'])==1
assert mutant.replace(applied['newArm'],applied['oldArm'])==normal
m=runpy.run_path(str(p/'model.py.source'));prior=runpy.run_path(str(p.parent/'categories-v2/model.py.source'))
a=m['expected']('required_in');z=prior['expected']('required_in');catalogue=json.loads((p/'ORACLES.json').read_text())
for key,raw in (('mutant',a),('normalBaseline',z)):
 v=catalogue[key];assert gzip.decompress(Path(v['stdout']).read_bytes())==raw
 assert len(raw)==v['bytes'] and hashlib.sha256(raw).hexdigest()==v['sha256']
assert a!=z
for ns in (31,47):
 for rel in ('link','parent'):
  rows=m['rows'](ns,rel+'_required_in')
  assert rows=='['+', '.join(f'{ns}:{i}:[{rel}_required_in:Outgoing:Target:{ns}:2]' for i in (1,3))+']'
  assert m['world'](ns,100 if ns==31 else 200,17)==prior['world'](ns,100 if ns==31 else 200,17)
# Tuple printer is identical; compare every explicit fullworld/cursor line.
def lines(raw):
 text=raw.decode().strip();values=json.loads('['+text[1:-1]+']')
 return [line for value in values for line in value.splitlines()]
x,y=lines(a),lines(z)
assert len(x)==len(y)
changes=[(old,new) for old,new in zip(y,x) if old!=new]
assert len(changes)==16
assert all(('Rows=' in old and 'Rows=' in new) or (old.startswith('Check') and old.endswith('True') and new.endswith('False')) for old,new in changes)
print('PASS:77currentpins/unique literal routing inverse/fullmutant+normal bytes/16 reached row-check lines/all physical owner-cursor lines equal')
