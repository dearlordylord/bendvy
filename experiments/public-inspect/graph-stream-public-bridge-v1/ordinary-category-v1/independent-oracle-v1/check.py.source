from pathlib import Path
import json,gzip,hashlib,runpy
here=Path(__file__).resolve().parent;b=json.loads((here/'SOURCE-BASIS.json').read_text())
for group in ('sourcePins','inputs'):
 for p,h in b[group].items():assert hashlib.sha256(Path(p).read_bytes()).hexdigest()==h,p
m=runpy.run_path(str(here/'model.py.source'));raw=m['expected']();v=json.loads((here/'ORACLES.json').read_text())['normal']
assert raw==gzip.decompress(Path(v['stdout']).read_bytes())
assert len(raw)==v['bytes'] and hashlib.sha256(raw).hexdigest()==v['sha256']
values=json.loads('['+raw.decode()[1:-2]+']');assert len(values)==2
for ns,base,text in zip((31,47),(100,200),values):
 assert text==m['scenario'](ns,base)
 assert text.count('world(')==8 and text.count('pending=1')==8
 assert text.count('CheckFirst=True')==2 and text.count('CheckSecond=True')==2
 assert text.count('stream([2:[4>7], 3:[7>8, 8>7]],[5:1:1],0,2)')==8
 for cursor in (14,15,16,17):assert 'Cursor=Active:'+str(cursor)+':13' in text
 assert text.count(f'{ns}:1:[link_required_out:Outgoing:Target:{ns}:2]')==2
 assert text.count(f'{ns}:3:[parent_required_out:Outgoing:Target:{ns}:2]')==2
print('PASS:77currentpins/tuple printer/full2schemas/owners/pending/clock/required-out rows')
