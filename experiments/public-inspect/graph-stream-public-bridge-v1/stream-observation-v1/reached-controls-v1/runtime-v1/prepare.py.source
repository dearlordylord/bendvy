from pathlib import Path
import hashlib,json,gzip,re,sys,importlib.util
ROOT=Path('/workspace/formal-proofs/bendvy');HERE=Path('/workspace/formal-proofs/bendvy-worktrees/graph-stream-public-bridge-v1/experiments/public-inspect/graph-stream-public-bridge-v1');OUT=Path('/tmp/bendvy-graph-stream-stream-observation-controls-runtime01')
RUNNER=ROOT/'experiments/public-inspect/ordinary-declaration-v1/canonical-adoption-v1/detached-v2/development.py'
def sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()
def load(name,p):
 s=importlib.util.spec_from_file_location(name,p);m=importlib.util.module_from_spec(s);s.loader.exec_module(m);return m
configuration=load('cfg',ROOT/'experiments/public-simulation/delivery-v1/installed-config.py');helper=load('runner',ROOT/'scripts/task_runner.py')
collector=load('collector',RUNNER)
# No child launches: this script prepares exact guarded plans only.
ORACLES=Path('/workspace/formal-proofs/bendvy-worktrees/ordinary-app-generated-observation-v1/experiments/public-inspect/ordinary-declaration-v1/graph-stream-observation-controls-oracle-v1/ORACLES.json');BASIS=ORACLES.parent/'SOURCE-BASIS.json';cat=json.loads(ORACLES.read_text());sequence=[]
for case in ('namespace-normal','stream-consumption','failure-order'):
 for role in ('js','native'):
  subject='normal' if case=='namespace-normal' else 'mutant'
  entry=HERE/('stream-observation-v1/reached-controls-v1/'+case+'/entry-workshop.bend');inventory={}
  def visit(p):
   p=p.resolve(strict=True)
   if str(p) in inventory:return
   inventory[str(p)]=sha(p)
   for target in re.findall(r'^import\s+(\S+)',p.read_text(),re.M):
    if target!='Base':visit(p.parent/target)
  visit(entry);closure=collector.validate_imports(entry,inventory)
  selection=cat['cases'][case];normal_selection=cat['cases']['namespace-normal'];oracle=ORACLES.parent/selection['path'];baseline=ORACLES.parent/normal_selection['path']
  expected=gzip.decompress(oracle.read_bytes());normal=gzip.decompress(baseline.read_bytes())
  assert len(expected)==selection['bytes'] and hashlib.sha256(expected).hexdigest()==selection['sha256']
  assert len(normal)==normal_selection['bytes'] and hashlib.sha256(normal).hexdigest()==normal_selection['sha256']
  if subject=='mutant':assert expected!=normal
  out=OUT/(case+'-'+role);out.mkdir(parents=True,exist_ok=False)
  tools={'bend':'/home/node/.bend/bin/bend-2.0.35','node':'/home/node/.local/share/mise/installs/node/24.20.0/bin/node','python':str(Path(sys.executable).resolve()),'taskset':'/usr/bin/taskset','clangWrapper':'/tmp/bendvy-clang19-diagnostic/clang19','clangBinary':'/tmp/bendvy-clang19-diagnostic/root/usr/lib/llvm-19/bin/clang'}
  extra=[RUNNER,ROOT/'scripts/task_runner.py',ROOT/'scripts/evidence_boundary.py',ROOT/'experiments/public-simulation/delivery-v1/installed-config.py',ORACLES,BASIS,ORACLES.parent/'model.py',ORACLES.parent/'README.md',HERE/'stream-observation-v1/source-evidence-v1/manifest.json',collector.PLAN_GUARD,HERE/'stream-observation-v1/reached-controls-v1/runtime-v1/prepare.py.source',HERE/'stream-observation-v1/reached-controls-v1/SOURCE-JOIN.json',HERE/'stream-observation-v1/control-source-evidence-v1/manifest.json',ORACLES.parent/'PRINTING-BASIS.json',HERE/'stream-observation-v1/runtime-v1/actual-attempt01/manifest.json',oracle,baseline,*map(Path,tools.values()),Path('/home/node/.bend/bend2/base.bend')]
  check=Path('/tmp/bendvy-graph-stream-stream-control-'+case+'-source01')
  result=json.loads((check/'result.json').read_text());source=json.loads((check/'SOURCE.json').read_text());assert result['exit']==0 and result['failure'] is None and json.loads((check/'post.json').read_text())['unchanged']
  assert all(source['pins'].get(p)==h for p,h in inventory.items())
  extra += [check/n for n in ('result.json','SOURCE.json','post.json','stdout','stderr')]
  pins=inventory|{str(p.resolve(strict=True)):sha(p) for p in extra};generated=out/('scenario.c' if role=='native' else 'scenario.js');native=out/'scenario.native'
  commands=[{'label':'emit','argv':[tools['taskset'],'-c','11',tools['bend'],str(entry),'-o',str(generated)],'capSeconds':30}]
  if role=='native':commands += [{'label':'build','argv':[tools['taskset'],'-c','11',tools['clangWrapper'],'-O3',str(generated),'-o',str(native),'-pthread','-lm'],'capSeconds':120},{'label':'consumer','argv':[tools['taskset'],'-c','11',str(native),'--threads','1','--gpu','off'],'capSeconds':5}]
  else:commands += [{'label':'consumer','argv':[tools['taskset'],'-c','11',tools['node'],str(generated)],'capSeconds':5}]
  plan={'scope':'Reached complete namespace-matched stream position consumption/failure order controls with full World/runtime and actual affine reader/registry owners '+subject+' '+role+'; no reader projection/full55/proof/performance acceptance','role':role,'subject':subject,'entrypoint':str(entry),'stage':str(entry.parent),'sourceInventory':inventory,'importClosure':closure,'pins':pins,'resourceRoots':helper.Inputs(directories=configuration.RESOURCE_ROOTS).expected,'environment':configuration.environment(),'cwd':str(HERE),'tools':tools,'commands':commands,'oracle':str(oracle),'oracleSHA256':selection['sha256'],'oracleBytes':selection['bytes'],'normalOracle':str(baseline),'normalOracleSHA256':normal_selection['sha256'],'normalOracleBytes':normal_selection['bytes'],'generated':str(generated),'native':str(native),'postConsumer':'Whole independent complete term byte equality; mutant rejects namespace-matched normal term; empty runtime stderr'}
  load('plan_guard',collector.PLAN_GUARD).validate(plan,output_dir=out)
  path=out/'plan.json';path.write_text(json.dumps(plan,indent=2)+'\n');sequence.append({'role':role,'subject':subject,'case':case,'path':str(path),'sha256':sha(path),'sources':len(inventory),'command':[tools['python'],str(RUNNER),'run',str(path),sha(path)]})
proposal={'runner':str(RUNNER),'runnerSHA256':sha(RUNNER),'plans':sequence,'sequence':'Namespace-normal JS→Native wholePASS then stream-consumption JS→Native then failure-order JS→Native; each mutant matches its independent complete model and rejects namespace-normal whole oracle; stop any failure/deadline/guard failure; no retry','sourcePrerequisite':'Exact source5 actual PASS for both frozen consuming closures; raw source evidence preserved','scope':'Finite reached stream controls only; source-current authority checked separately; no Type-reader ownership/full55/proof/performance acceptance'}
(HERE/'stream-observation-v1/reached-controls-v1/runtime-v1/BATCH.json').write_text(json.dumps(proposal,indent=2)+'\n')
for row in sequence:
 target=HERE/'stream-observation-v1/reached-controls-v1/runtime-v1/prepared-attempt01'/ (row['case']+'-'+row['role']);target.mkdir(parents=True);(target/'plan.json').write_bytes(Path(row['path']).read_bytes())
print(json.dumps(proposal,indent=2))
