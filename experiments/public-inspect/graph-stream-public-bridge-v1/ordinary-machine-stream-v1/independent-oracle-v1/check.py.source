from pathlib import Path
import json,gzip,hashlib,runpy
p=Path(__file__).resolve().parent;b=json.loads((p/'SOURCE-BASIS.json').read_text())
for group in ('sourcePins','inputs','modelPins'):
 for path,digest in b[group].items():assert hashlib.sha256(Path(path).read_bytes()).hexdigest()==digest,path
m=runpy.run_path(str(p/'model.py.source'));raw=m['expected']();v=json.loads((p/'ORACLES.json').read_text())['normal']
assert raw==gzip.decompress(Path(v['stdout']).read_bytes())
assert len(raw)==v['bytes'] and hashlib.sha256(raw).hexdigest()==v['sha256']
s=Path('/workspace/formal-proofs/bendvy-worktrees/graph-stream-public-bridge-v1/experiments/public-inspect/graph-stream-public-bridge-v1/ordinary-machine-stream-v1')
projection=(s/'projections.bend').read_text();consumer=(s/'consumer.bend').read_text();main=(s/'main.bend').read_text()
assert '"Flow",[4,7,8,9]' in projection and '"Level",[10,11,12]' in projection
assert 'I.Frame{world,19}' in projection and 'Sys.run_tracked(' in consumer
assert 'Some{Done{value}}' in consumer and 'namespace,2' in consumer
assert 'Fixture.world(~State.Workshop,31,100)' in main and 'Fixture.world(~State.Garden,47,200)' in main
for ns,seed in ((31,100),(47,200)):
 observation=m['observation'](ns);report=m['report'](ns,seed)
 assert report.count(observation)==2
 assert report.count('clock=13)')==4 and report.count('pending=1')==4
 assert report.count('nextSystem=3')==4
 assert 'consumer.Observed{0, projections.Observation{19,' in report
 assert 'Some{Done{True{}}}, 13,' in report
 assert observation.count('ProjectedRow{')==3 and observation.count('.Cell{')==12
 assert '.Current{7}' in observation and '.Current{11}' in observation
 assert '.Sources{[' in observation
 assert report.count('CommittedFlowAndRelations')==5
assert raw.startswith(b'(Some{consumer.Report{') and raw.endswith(b'}})\n')
print('PASS:42currentpins/installedprinter/two nominal reports/24projected Cells/eight fullworlds/currentVocabulary/registration and Check cursor/full20671bytes')
