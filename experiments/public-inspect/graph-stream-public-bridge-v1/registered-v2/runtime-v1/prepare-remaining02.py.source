  expected=gzip.decompress(oracle.read_bytes());normal=gzip.decompress(baseline.read_bytes())
  assert len(expected)==selection['bytes'] and hashlib.sha256(expected).hexdigest()==selection['sha256']
  assert len(normal)==selection.get('normalOracleBytes',selection['bytes']) and hashlib.sha256(normal).hexdigest()==selection.get('normalOracleSHA256',selection['sha256'])
  if subject=='mutant':assert expected!=normal
  out=OUT/(case+'-'+role);out.mkdir(parents=True,exist_ok=False)
  tools={'bend':'/home/node/.bend/bin/bend-2.0.35','node':'/home/node/.local/share/mise/installs/node/24.20.0/bin/node','python':str(Path(sys.executable).resolve()),'taskset':'/usr/bin/taskset','clangWrapper':'/tmp/bendvy-clang19-diagnostic/clang19','clangBinary':'/tmp/bendvy-clang19-diagnostic/root/usr/lib/llvm-19/bin/clang'}
  extra=[RUNNER,ROOT/'scripts/task_runner.py',ROOT/'scripts/evidence_boundary.py',ROOT/'experiments/public-simulation/delivery-v1/installed-config.py',ORACLES,BASIS,ORACLES.parent/'model.py',ORACLES.parent/'README.md',HERE/'registered-v2/SOURCE.json',collector.PLAN_GUARD,HERE/'registered-v2/runtime-v1/prepare-remaining02.py.source',oracle,baseline,*map(Path,tools.values()),*map(Path,json.loads(BASIS.read_text())['subjects'][case]['sourceInventory'])]
  check=Path({'garden-registered':'/tmp/bendvy-graph-stream-registered-v2-garden-source01','namespace-normal':'/tmp/bendvy-graph-stream-reached-source03/namespace-normal','noninterference-mutant':'/tmp/bendvy-graph-stream-reached-source03/noninterference-mutant','routing-swap-mutant':'/tmp/bendvy-graph-stream-reached-source03/routing-swap-mutant','workshop-foreign':'/tmp/bendvy-graph-stream-foreign-v2-workshop-source01','garden-foreign':'/tmp/bendvy-graph-stream-foreign-v2-garden-source01'}[case])
  result=json.loads((check/'result.json').read_text());source=json.loads((check/'SOURCE.json').read_text());assert result['exit']==0 and result['failure'] is None and json.loads((check/'post.json').read_text())['unchanged']
  assert all(source['pins'].get(p)==h for p,h in inventory.items())
  extra += [check/n for n in ('result.json','SOURCE.json','post.json','stdout','stderr')]
  pins=inventory|{str(p.resolve(strict=True)):sha(p) for p in extra};generated=out/('scenario.c' if role=='native' else 'scenario.js');native=out/'scenario.native'
  commands=[{'label':'emit','argv':[tools['taskset'],'-c','11',tools['bend'],str(entry),'-o',str(generated)],'capSeconds':30}]
  if role=='native':commands += [{'label':'build','argv':[tools['taskset'],'-c','11',tools['clangWrapper'],'-O3',str(generated),'-o',str(native),'-pthread','-lm'],'capSeconds':120},{'label':'consumer','argv':[tools['taskset'],'-c','11',str(native),'--threads','1','--gpu','off'],'capSeconds':5}]
  else:commands += [{'label':'consumer','argv':[tools['taskset'],'-c','11',tools['node'],str(generated)],'capSeconds':5}]
  plan={'scope':'Finite complete '+case+' '+role+' machine/relation bridge and exact affine-owner state; registered execution in registered cases, typed foreign refusal in foreign cases, reached mutation countermodels in mutant cases; no reader/full55/proof/performance acceptance','role':role,'subject':subject,'entrypoint':str(entry),'stage':str(entry.parent),'sourceInventory':inventory,'importClosure':closure,'pins':pins,'resourceRoots':helper.Inputs(directories=configuration.RESOURCE_ROOTS).expected,'environment':configuration.environment(),'cwd':str(HERE),'tools':tools,'commands':commands,'oracle':str(oracle),'oracleSHA256':selection['sha256'],'oracleBytes':selection['bytes'],'normalOracle':str(baseline),'normalOracleSHA256':selection.get('normalOracleSHA256',selection['sha256']),'normalOracleBytes':selection.get('normalOracleBytes',selection['bytes']),'generated':str(generated),'native':str(native),'postConsumer':'Whole independent complete term byte equality; mutant rejects namespace-matched normal term; empty runtime stderr'}
  load('plan_guard',collector.PLAN_GUARD).validate(plan,output_dir=out)
  path=out/'plan.json';path.write_text(json.dumps(plan,indent=2)+'\n');sequence.append({'role':role,'subject':subject,'case':case,'path':str(path),'sha256':sha(path),'sources':len(inventory),'command':[tools['python'],str(RUNNER),'run',str(path),sha(path)]})
proposal={'runner':str(RUNNER),'runnerSHA256':sha(RUNNER),'plans':sequence,'sequence':'After first Workshop registered JS+Native wholePASS: Garden registered JS+Native -> namespace-positive JS+Native -> clock mutant JS+Native -> routing mutant JS+Native -> Workshop foreign JS+Native -> Garden foreign JS+Native; each prior wholePASS, mutations reject full namespace-positive baseline; stop any failure/deadline/guard failure; no retry','sourcePrerequisite':'Exact source5 actual PASS for both frozen consuming closures; raw source evidence preserved','scope':'Finite source-bound Garden registered, namespace-positive, reached mutation and foreign-handle qualification; no reader/full55/universal/performance acceptance'}
