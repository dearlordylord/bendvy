for case in ('garden-registered','namespace-normal','noninterference-mutant','routing-swap-mutant','workshop-foreign','garden-foreign'):
 for role in ('js','native'):
  subject='mutant' if cat[case]['countermodelRejectsNormal'] else 'normal'
