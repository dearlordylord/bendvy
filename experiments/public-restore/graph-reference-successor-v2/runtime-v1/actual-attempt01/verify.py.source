from pathlib import Path
import ast,gzip,hashlib,json,runpy,shutil,tempfile
WT=Path('/tmp/bendvy60-graph-ts-reference');LEAF=WT/'experiments/public-restore/graph-reference-successor-v2';OUT=LEAF/'runtime-v1/actual-attempt01'
sha=lambda b:hashlib.sha256(b).hexdigest();m=json.loads((OUT/'manifest.json').read_text());rows=m['members']
with tempfile.TemporaryDirectory()as tmp:
 q=Path(tmp)/'packet';shutil.copytree(OUT,q);data={};external=[]
 for row in rows:
  if 'object'in row:
   packed=(q/row['object']).read_bytes();assert sha(packed)==row['compressedSHA256'];b=gzip.decompress(packed)
  else:b=Path(row['path']).read_bytes();external.append(row['path'])
  assert sha(b)==row['sha256']and len(b)==row['bytes'];data[row['path']]=b
 def configuration(value):
  if value['kind']=='file':assert sha(data[value['resolvedPath']])==value['sha256']
  elif value['kind']=='symlink':configuration(value['resolved'])
  elif value['kind']=='directory':
   for child in value['inventory'].values():configuration(child)
 counts=[];configs=[]
 for attempt in m['attempts']:
  p=Path(attempt['receipt']);r=json.loads(data[str(p)]);assert r['status']==attempt['status'];assert not r.get('guardFailures')
  count=0
  for path,value in r['inputs'].items():
   if isinstance(value,dict):
    for rel,h in value.items():assert sha(data[str(Path(path)/rel)])==h;count+=1
   else:assert sha(data[path])==value;count+=1
  for value in r['configuration'].values():configuration(value)
  for name,h in r['rawHashes'].items():assert sha(data[str(p.parent/name)])==h
  assert sha(json.dumps(r['environment'],sort_keys=True,separators=(',',':'),ensure_ascii=True).encode())==r['environmentSha256']
  counts.append(count);configs.append(len(r['configuration']))
  if r['status']=='DEVELOPMENT_PASS':assert r['command']['exit']==0 and r['command']['failure']is None
  else:assert r['command']['exit']==1 and data[str(p.parent/'restore-reference.stdout')]==b'' and b'Duplicate system step in schedule: fast'in data[str(p.parent/'restore-reference.stderr')]
 old=LEAF.with_name('graph-reference-v1');new=LEAF
 before=b'runtime.tick(G.Schedule(...steps))';after=b'runtime.tick(...steps.map(step => G.Schedule(step)))'
 assert data[str(old/'reference.mjs')].count(before)==1
 assert data[str(old/'reference.mjs')].replace(before,after)==data[str(new/'reference.mjs')]
 for name in ['run.py','oracle.py','expected.json']:assert data[str(old/name)]==data[str(new/name)]
 expected=data[str(new/'expected.json')]
 for base in [old,new]:
  dest=Path(tmp)/base.name;dest.mkdir();(dest/'oracle.py').write_bytes(data[str(base/'oracle.py')]);model=runpy.run_path(str(dest/'oracle.py'));model['selftest']();render=(json.dumps([model['expected']('Workshop'),model['expected']('Garden')],separators=(',',':'))+'\n').encode();assert render==expected
  plan=json.loads(data[str(base/'plan.json')]);basis=json.loads(data[str(base/'SOURCE-BASIS.json')]);assert sha(data[str(base/'SOURCE-BASIS.json')])==plan['sourceBasisSHA256']
  for section in ['sourceInventory','sourcePins']:
   for p,h in basis[section].items():assert sha(data[p])==h
  actualReceipt=json.loads(data['/tmp/bendvy60-graph-reference-actual'+('01'if base==old else'02')+'/receipt.json']);assert plan['inputs']==actualReceipt['inputs']and plan['configuration']==actualReceipt['configuration']and plan['environment']==actualReceipt['environment']
 source=data[str(new/'run.py')].decode();tree=ast.parse(source);strict=next(n for n in tree.body if isinstance(n,ast.FunctionDef)and n.name=='strict');namespace={};exec(compile(ast.Module(body=[strict],type_ignores=[]),'retained-strict','exec'),namespace)
 actual=data['/tmp/bendvy60-graph-reference-actual02/restore-reference.stdout'];namespace['strict'](json.loads(actual),json.loads(expected));assert actual==expected
 assert data['/tmp/bendvy60-graph-reference-actual02/restore-reference.stderr']==b''
 runtime=data['/workspace/formal-proofs/bendvy/.references/bevy-ts/packages/core/src/Runtime.ts'];tick=runtime[runtime.index(b'  const tickUnsafe ='):runtime.index(b'  const hasRequirement =')];assert tick.count(b'advanceFrame()')==1 and b'for (const schedule of schedules)'in tick
 result=dict(status='PASS',isolatedRelocation=True,bindings=len(rows),objects=len(set(r['object']for r in rows if 'object'in r)),externalIdentities=len(external),inputHashJoinsPerAttempt=counts,configurationRecordsPerAttempt=configs,pinnedTSModules=33,preExecutionModelReproduction=True,sameFrameSchedulingRepair=True,unchangedModelExpectedAdapter=True,actualBytes=len(actual),actualSHA256=sha(actual),wholeTypeSensitiveEquality=True,wholeRawEquality=True,priorAttemptStatus='INCOMPLETE',currentAttemptStatus='DEVELOPMENT_PASS',subjectReplay=False,scope=m['scope'])
 (OUT/'FULL-JOIN-VERIFICATION.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
