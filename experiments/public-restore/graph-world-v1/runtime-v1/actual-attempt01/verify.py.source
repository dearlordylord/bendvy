from pathlib import Path
import json,gzip,hashlib,tempfile,shutil,subprocess,re
sha=lambda b:hashlib.sha256(b).hexdigest()
OUT=Path('/tmp/bendvy60-graph-observer/experiments/public-restore/graph-world-v1/runtime-v1/actual-attempt01')
m=json.loads((OUT/'manifest.json').read_text());rows=m['members'];roles=m['roles'];external={r['path'] for r in rows if 'object' not in r};histories=[Path(p).parent for p in m['historyReceipts']];base=Path('/tmp/bendvy60-graph-oracle/experiments/public-restore/graph-world-oracle-v1')
with tempfile.TemporaryDirectory() as tmp:
 q=Path(tmp)/'packet';shutil.copytree(OUT,q);data={}
 for row in rows:
  p=row['path']
  if 'object' in row:
   packed=(q/row['object']).read_bytes();assert sha(packed)==row['compressedSHA256'];b=gzip.decompress(packed)
  else:b=Path(p).read_bytes()
  assert sha(b)==row['sha256'] and len(b)==row['bytes'];data[p]=b
 count=0;models={}
 for role in roles:
  plan=json.loads(data[role['plan']]);r=json.loads(data[role['receipt']]);seen=set()
  for g in r['guards']:
   v=json.loads(data[g['path']]);assert v['unchanged']
   for p,h in v['actualPins'].items():assert sha(data[p])==h;count+=1
  def visit(p):
   if p in seen:return
   seen.add(p);assert sha(data[p])==plan['sourceInventory'][p]
   for imp in re.findall(r'^import\s+(\S+)',data[p].decode(),re.M):
    if imp!='Base':visit(str((Path(p).parent/imp).resolve()))
  visit(plan['entrypoint']);assert seen==set(plan['sourceInventory'])
  for p in plan['pins']:
   if ('SOURCE-FREEZE' in Path(p).name and p.endswith('.json')):
    f=json.loads(data[p])
    for section in ['sourceInventory','sourcePins']:
     for x,h in f.get(section,{}).items():assert sha(data[x])==h
  for c in r['commands']:
   for stream in ['stdout','stderr']:
    x=c[stream];assert sha(data[x['path']])==x['sha256'] and len(data[x['path']])==x['bytes']
  oracle=Path(plan['oracle']);model=next(p for p in plan['pins'] if p.endswith('/graph-world-oracle-v1/model.py'));dest=Path(tmp)/'oracle/model.py';dest.parent.mkdir(exist_ok=True);dest.write_bytes(data[model]);dest.with_name('base_model.py.source').write_bytes(data[str(base/'base_model.py.source')]);rmodel=subprocess.run(['/usr/bin/python3.11',str(dest),'--schema',role['schema']],capture_output=True,check=True);assert not rmodel.stderr;assert rmodel.stdout==gzip.decompress(data[plan['oracle']]);models[role['schema']+'/'+role['role']]=dict(bytes=len(rmodel.stdout),sha256=sha(rmodel.stdout))
 historyJoins=0
 for history in histories:
  hr=json.loads(data[str(history/'receipt.json')]);hp=json.loads(data[str(history/'plan.json')]);assert hr['planSHA256']==sha(data[str(history/'plan.json')])
  for g in hr['guards']:
   assert sha(data[g['path']])==g['sha256'];guard=json.loads(data[g['path']])
   for p,h in guard['actualPins'].items():assert sha(data[p])==h;historyJoins+=1
  for c in hr['commands']:
   for stream in ['stdout','stderr']:
    x=c[stream];assert sha(data[x['path']])==x['sha256'] and len(data[x['path']])==x['bytes']
 generatedNative=[];counterRejected=[]
 for role in roles:
  plan=json.loads(data[role['plan']]);receipt=json.loads(data[role['receipt']])
  if role['role']=='native':assert plan['native'] in data and plan['native'] not in external;generatedNative.append(plan['native'])
  if plan.get('subject')=='mutant':
   output=next(c['stdout']['path'] for c in receipt['commands'] if c['label']=='consumer');assert data[output]!=gzip.decompress(data[plan['normalOracle']]);counterRejected.append(role['role'])
 basisPath='/tmp/bendvy-restore60-erased/experiments/public-restore/graph-world-v1/ERASED-WITNESS-BASIS.json';basis=json.loads(data[basisPath]);assert sha(data[basis['diagnosticReceipt']])==basis['diagnosticReceiptSHA256'];assert sha(data[basis['diagnosticStderr']])==basis['diagnosticStderrSHA256']
 diagnostics=[json.loads(line)for line in data[basis['diagnosticStderr']].splitlines()if line.startswith(b'{')];entered=[x for x in diagnostics if x.get('name')=='native-target-def-enter' and x.get('key')==basis['locatedDef']];assert len(entered)==1 and entered[0]['count']==1072 and entered[0]['wallMs']==basis['enterWallMs'];assert not any(x.get('name')=='native-target-def-exit' and x.get('key')==basis['locatedDef'] for x in diagnostics)
 old=data['/tmp/bendvy-restore60/src/ecs/restore-graph-machine.bend'];new=data['/tmp/bendvy-restore60-erased/src/ecs/restore-graph-machine.bend'];assert sha(old)==basis['oldBodySHA256'] and sha(new)==basis['newBodySHA256'];assert new.count(b',-left:Schema<')==new.count(b',-right:Schema<')==1;assert new.replace(b',-left:Schema<',b',left:Schema<').replace(b',-right:Schema<',b',right:Schema<')==old
 assert '/tmp/bendvy60-pass-native-diagnostic-v1/actual01/receipt.json' not in data
 result=dict(status='PASS',isolatedRelocation=True,historyEvolvingPinJoins=historyJoins,generatedNativeELFObjects=generatedNative,emptySchemaWitnessInverse=True,diagnosticProduct1072RawJoin=True,originalWrongLauncherUnexecuted=True,bindings=len(rows),objects=len(set(x['object'] for x in rows if 'object'in x)),externalELFs=len(external),successfulCommands=sum(x['commands'] for x in roles),guards=sum(x['guards'] for x in roles),evolvingPinJoins=count,importsPerRole=[len(json.loads(data[r['plan']])['sourceInventory']) for r in roles],retainedModels=models,backendReplay=False,historyStatuses={str(h):json.loads(data[str(h/'receipt.json')])['status'] for h in histories},scope=m['scope'])
 (OUT/'FULL-JOIN-VERIFICATION.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
