 assert data[str(authority/'checks/positive.stdout')].startswith(b'ALL PROOFS CHECK\n')
 assert b'consumed more than once'in data[str(authority/'checks/owner-duplicate.stderr')]
 assert b'Owner<Factory.Garden'in data[str(authority/'checks/cross-schema.stderr')] and b'Owner<Factory.Workshop'in data[str(authority/'checks/cross-schema.stderr')]
 assert b'observed : wrong~H'in data[str(authority/'checks/abstract-owner.stderr')]
 reuse=json.loads(data['/tmp/bendvy60-basic-current-reuse.json']);basic=Path(m['basicPacket']);bm=json.loads(data[str(basic/'manifest.json')]);assert sha(data[str(basic/'manifest.json')])==reuse['portablePacketSHA256'];bd={}
 for row in bm['members']:
