  for guard in hr['guards']:assert sha(data[guard['path']])==guard['sha256'] and json.loads(data[guard['path']])['unchanged']
 authority=Path('/tmp/bendvy-restore60-controls/experiments/public-restore/graph-runtime-controls-v1/authority-v1');a=json.loads(data[str(authority/'SOURCE-CHECK.json')])
 for p,h in a['sourceInventory'].items():assert sha(data[p])==h
 for case,result in a['results'].items():
