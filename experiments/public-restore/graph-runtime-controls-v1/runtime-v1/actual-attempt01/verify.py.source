  assert sha(b)==row['sha256'] and len(b)==row['bytes'];bd[row['path']]=b
 assert sha(bd[reuse['qualifiedPlan']])==reuse['qualifiedPlanSHA256']
 for row in reuse['qualifiedReceipts']:assert sha(bd[row['path']])==row['sha256'] and json.loads(bd[row['path']])['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS'
 for row in reuse['sourceJoins']:assert sha(bd[row['qualifiedPath']])==row['sha256']==sha(data[row['currentPath']])
 result=dict(status='PASS',isolatedRelocation=True,bindings=len(rows),objects=len(set(x['object']for x in rows if 'object'in x)),externalELFs=len(external),commands=sum(x['commands']for x in roles),guards=sum(x['guards']for x in roles),evolvingPinJoins=count,importsPerRole=[len(json.loads(data[r['plan']])['sourceInventory'])for r in roles],models=reproduced,actuals=actuals,generatedNativeELFObjects=generated,inconclusiveHistoryReceipts=len(m['historyReceipts']),authorityCases=len(a['results']),unchangedBasicImportJoins=len(reuse['sourceJoins']),backendReplay=False,scope=m['scope'])
 (OUT/'FULL-JOIN-VERIFICATION.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
