from pathlib import Path
import json,gzip,hashlib
WT=Path('/tmp/bendvy-restore60-controls');OUT=WT/'experiments/public-restore/graph-runtime-controls-v1/runtime-v1/actual-attempt01';MODEL=Path('/tmp/bendvy-restore59-oracle/experiments/public-restore/graph-runtime-controls-oracle-v1');BASIC=Path('/workspace/formal-proofs/bendvy/experiments/public-restore/opaque-token-v1/integrated-trace-runtime-v1/actual-attempt01')
sha=lambda b:hashlib.sha256(b).hexdigest();files={};external=set();roles=[]
def add(path,digest=None,tool=False):
 p=Path(path);b=p.read_bytes();h=sha(b);assert digest is None or h==digest,str(p);assert str(p) not in files or files[str(p)]==b,str(p);files[str(p)]=b
 if tool and b.startswith(b'\x7fELF'):external.add(str(p))
configs=[('room-false','normal','/tmp/bendvy60-room-first-actual01')]+[(x,'mutant','/tmp/bendvy60-'+x+'-first-actual01')for x in ['graph-order','cycle','queue-clear']]
for case,subject,root in configs:
 for role in ['js','native']:
  d=Path(root.replace('actual01','actual02')if case=='cycle' and role=='native'else root)/subject/role;p=d/'plan.json';r=json.loads((d/'receipt.json').read_text());plan=json.loads(p.read_text());assert r['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS';assert r['planSHA256']==sha(p.read_bytes())
  for x,h in plan['pins'].items():add(x,h,True)
  for directory,entries in plan['resourceRoots'].items():
   for x,h in entries.items():add(Path(directory)/x,h,True)
  for f in d.iterdir():
   if f.is_file():add(f)
  for c in r['commands']:
   assert c['exit']==0 and c['failure'] is None
   for stream in ['stdout','stderr']:
    x=c[stream];add(x['path'],x['sha256']);assert len(files[x['path']])==x['bytes']
  for g in r['guards']:
   add(g['path'],g['sha256']);v=json.loads(files[g['path']]);assert v['unchanged']
   for x,h in v['actualPins'].items():add(x,h,True)
  consumer=next(c for c in r['commands']if c['label']=='consumer');actual=files[consumer['stdout']['path']];assert actual==gzip.decompress(files[plan['oracle']]);assert not files[consumer['stderr']['path']]
  if subject=='mutant':assert r['completeNormalBaselineRejected'] and actual!=gzip.decompress(files[plan['normalOracle']])
  roles.append(dict(case=case,role=role,plan=str(p),receipt=str(d/'receipt.json'),commands=len(r['commands']),guards=len(r['guards']),expected=plan['oracle'],normal=plan['normalOracle'],qualification='stock COMPLETE_CONSUMER_DEVELOPMENT_PASS'))
  external.discard(plan.get('native',''))
history=Path('/tmp/bendvy60-cycle-first-actual01/mutant/native');hr=json.loads((history/'receipt.json').read_text());assert hr['status']=='INCOMPLETE'
for p in history.iterdir():
 if p.is_file():add(p)
add('/tmp/bendvy60-cycle-native-resource-observation.json')
for directory in [MODEL,WT/'experiments/public-restore/graph-runtime-controls-v1/authority-v1',BASIC]:
