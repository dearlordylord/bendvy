for field in ['source','stdout','stderr','oldSourceCheck','currentCapabilities']:add(legacy[field])
add('/tmp/bendvy60-readwrite-reuse.json')
for entry in json.loads(Path('/tmp/bendvy60-basic-current-reuse.json').read_text())['sourceJoins']:add(entry['currentPath'],entry['sha256'])
for p in ['/tmp/bendvy60-selected-livefiles.json','/tmp/bendvy60-integration-handoff.json','/tmp/bendvy60-basic-current-reuse.json','/tmp/retain60-controls-packet.py','/tmp/verify60-controls-packet.py']:add(p)
OUT.mkdir(parents=True,exist_ok=True);(OUT/'objects').mkdir(exist_ok=True);rows=[]
for p,b in sorted(files.items()):
 h=sha(b);row=dict(path=p,bytes=len(b),sha256=h)
 if p in external:row['retention']='external installed ELF identity only'
 else:
  packed=gzip.compress(b,mtime=0);obj='objects/'+h+'.gz';(OUT/obj).write_bytes(packed);row.update(object=obj,compressedSHA256=sha(packed))
 rows.append(row)
m=dict(scope='One genuine post-staging room refusal and three reached graph-order/cycle/queue-clear mutants, complete observations. Eight stock roles; exact current graph authority diagnostics and unchanged basic128-import qualification join retained. Finite issue60 controls, not universal proof or final integrated acceptance.',sourceCommit='52310dcfc',authorityCommit='a844ea996',oracleCommits=['df9546151','b188071bd'],roles=roles,basicPacket=str(BASIC),historyReceipts=[str(history/'receipt.json')],members=rows)
(OUT/'manifest.json').write_text(json.dumps(m,indent=2)+'\n');print(json.dumps(dict(bindings=len(rows),objects=len(set(x.get('object')for x in rows if 'object'in x)),roles=len(roles))))
