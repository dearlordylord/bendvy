type Outcome<S:Data,Custom:Data> is Data:
  Restored{bindings:List<&2,R.Binding<S>>}
  Rejected{input:GraphData.Snapshot,error:Public.Error<Custom>}
  MissingBinding{saved:Key.Key}
type Returned<S:Data,Runtime:Type,Owner:Type,Recovery:Type,Receipt:Type,Custom:Data> is Type:
  Returned{runtime:Runtime,owner:Owner,recovery:Recovery,receipt:Maybe<&1,Receipt>,outcome:Outcome<S,Custom>}
def pack(~S:Data,~Runtime:Type,~Owner:Type,~Recovery:Type,~Receipt:Type,~Custom:Data,runtime:Runtime,owner:Owner,recovery:Recovery,receipt:Maybe<&1,Receipt>,outcome:Outcome<S,Custom>) -> Returned<S,Runtime,Owner,Recovery,Receipt,Custom>:Returned{runtime,owner,recovery,receipt,outcome}

