from pathlib import Path
import json,gzip,hashlib,tempfile,shutil,subprocess,re
WT=Path('/tmp/bendvy57-integrated-query-evidence'); OUT=WT/'experiments/public-restore/opaque-token-v1/integrated-trace-runtime-v1/actual-attempt01';OUT.mkdir(parents=True,exist_ok=True);(OUT/'objects').mkdir(exist_ok=True)
sha=lambda b:hashlib.sha256(b).hexdigest()
files={};external=set();roles=[]
def add(p,h=None,tool=False):
 p=Path(p);b=p.read_bytes();s=sha(b);assert h is None or h==s,str(p);files[str(p)]=b
 if tool and b.startswith(b'\x7fELF'):external.add(str(p))
config=json.loads(Path('/tmp/bendvy57-integrated-restore-retention-roles.json').read_text())
for item in config:
 schema,role=item['schema'],item['role'];d=Path(item['directory']);p=d/'plan.json';plan=json.loads(p.read_text());r=json.loads((d/'receipt.json').read_text());assert r['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS';assert r['planSHA256']==sha(p.read_bytes())
 for x,h in plan['pins'].items():add(x,h,True)
 for root,entries in plan['resourceRoots'].items():
  for x,h in entries.items():add(Path(root)/x,h,True)
 for f in d.iterdir():
  if f.is_file():add(f)
 for c in r['commands']:
  assert c['exit']==0 and c['failure'] is None
  for stream in ['stdout','stderr']:
   x=c[stream];add(x['path'],x['sha256']);assert len(files[x['path']])==x['bytes']
  if c['label']=='consumer':assert files[c['stdout']['path']]==gzip.decompress(files[plan['oracle']])
 for g in r['guards']:
  add(g['path'],g['sha256']);v=json.loads(files[g['path']]);assert v['unchanged']
  for x,h in v['actualPins'].items():add(x,h,True)
 roles.append(dict(schema=schema,role=role,plan=str(p),receipt=str(d/'receipt.json'),commands=len(r['commands']),guards=len(r['guards'])))
# Preserve original deadline attempts independently of successful roles.
histories=[Path(x) for x in json.loads(Path('/tmp/bendvy57-integrated-restore-retention-empty-history.json').read_text())]
for history in histories:
 for f in history.iterdir():
  if f.is_file():add(f)
 hp=json.loads((history/'plan.json').read_text());hr=json.loads((history/'receipt.json').read_text());assert hr['planSHA256']==sha((history/'plan.json').read_bytes())
 for x,h in hp['pins'].items():add(x,h,True)
 for root,entries in hp['resourceRoots'].items():
  for x,h in entries.items():add(Path(root)/x,h,True)
 for g in hr['guards']:
  add(g['path'],g['sha256']);v=json.loads(files[g['path']])
  for x,h in v['actualPins'].items():add(x,h,True)
 for c in hr['commands']:
  for stream in ['stdout','stderr']:
   x=c[stream];add(x['path'],x['sha256']);assert len(files[x['path']])==x['bytes']

base=Path('/tmp/bendvy-restore59-oracle/experiments/public-restore/basic-world-oracle-v1')
for leaf in ['','raw-world-v1','acceptance-boundaries-v1','opaque-token-v1']:
 for f in (base/leaf).iterdir():
  if f.is_file():add(f)
for item in config:
 plan=json.loads((Path(item['directory'])/'plan.json').read_text())
 external.discard(plan['native'])
for history in histories:
 hp=json.loads((history/'plan.json').read_text());external.discard(hp.get('native',''))
for path,body in list(files.items()):
 if 'SOURCE-FREEZE' in Path(path).name and path.endswith('.json'):
  frozen=json.loads(body)
  for section in ['sourceInventory','sourcePins']:
   for x,h in frozen.get(section,{}).items():add(x,h)
# Preserve source diagnostics and unexecuted planning history without inventing guards.
add('/tmp/bendvy57-integrated-restore-retention-history.json')
for number in range(1,6):
 for stream in ['stdout','stderr']:add('/tmp/bendvy57-integrated-restore-source'+str(number).zfill(2)+'.'+stream)
for role in ['js','native']:
 plan=Path('/tmp/bendvy57-integrated-restore-workshop-first-actual01/normal')/role/'plan.json'
 if plan.is_file():add(plan)
rows=[]
for p,b in sorted(files.items()):
 h=sha(b);row=dict(path=p,bytes=len(b),sha256=h)
 if p in external:row['retention']='external installed ELF identity only'
 else:
  packed=gzip.compress(b,mtime=0);obj='objects/'+h+'.gz';(OUT/obj).write_bytes(packed);row.update(object=obj,compressedSHA256=sha(packed))
 rows.append(row)
m=dict(scope='Affected basic-restore Workshop28 stock JS+Native pair on integrated trace carrier. Current actual02 only; actual01 plan never executed. Source01 type failure and02-04 parser repairs retained separately from source05 PASS. Unchanged complete independent oracle, no full59 requalification/full57/performance claim',integrationMaster='947ad64a7',integrationQuery='73596bd6f',sourceIdentity='Per-role exact SOURCE-FREEZE and sourceInventory hashes, uncommitted integrated candidate',oracleIdentity='Original source-derived basic-world/opaque-token model ancestry, exact archived bytes',roles=roles,historyReceipts=[str(h/'receipt.json') for h in histories],members=rows)
(OUT/'manifest.json').write_text(json.dumps(m,indent=2)+'\n')
