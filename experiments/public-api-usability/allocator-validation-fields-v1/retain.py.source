from pathlib import Path
import json,hashlib,zipfile,subprocess
W=Path('/tmp/bendvy73-allocator-validation');D=W/'experiments/public-api-usability/allocator-validation-fields-v1';sha=lambda b:hashlib.sha256(b).hexdigest();members={};cases=[];tools=set()
def add(name,h=None):
 name=str(name);raw=Path(name).read_bytes()
 if h and sha(raw)!=h:
  assert name=='/workspace/formal-proofs/bendvy/benchmarks/run.py';raw=subprocess.check_output(['git','-C',str(W),'show','1336e5fdc:benchmarks/run.py']);assert sha(raw)==h
 key=(name,sha(raw));members[key]=raw
for kind,folder in [('workshop','/tmp/bendvy73-allocator-validation-actual02'),('identity','/tmp/bendvy73-allocator-identity-actual01')]:
 for role in ['js','native']:
  q=Path(folder)/role;p=json.loads((q/'plan.json').read_text());r=json.loads((q/'receipt.json').read_text());assert r['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS';cases.append({'kind':kind,'role':role,'directory':str(q)})
  tools.update(p['tools'].values())
  for n,h in p['pins'].items():add(n,h)
  for root,files in p['resourceRoots'].items():
   for rel,h in files.items():add(Path(root)/rel,h);tools.add(str(Path(root)/rel))
  for f in q.iterdir():
   if f.is_file():add(f)
for folder in ['/tmp/bendvy73-allocator-validation-actual02','/tmp/bendvy73-allocator-identity-actual01']:
 for f in Path(folder).rglob('*'):
  if f.is_file()and'__pycache__'not in f.parts:add(f)
for f in [Path('/workspace/formal-proofs/bendvy/.artifacts/regression73-20261018-world-fields03/candidate/workshop.js'),Path('/workspace/formal-proofs/bendvy/.artifacts/regression73-20261018-world-fields03/receipt.json'),Path('/workspace/formal-proofs/bendvy/.artifacts/regression73-20261018-world-fields03/candidate/src/ecs/entity-allocator.bend')]:add(f)
for f in D.rglob('*'):
 if f.is_file()and f.name not in ['EVIDENCE.zip','MANIFEST.json','VERIFY.json']:add(f)
for f in [Path(__file__),Path('/tmp/verify73-allocator.py')]:add(f)
rows=[];written=set()
with zipfile.ZipFile(D/'EVIDENCE.zip','w',zipfile.ZIP_DEFLATED,compresslevel=6)as z:
 for (origin,h),value in sorted(members.items()):
  row={'origin':origin,'sha256':h,'bytes':len(value)}
  if value.startswith(b'\x7fELF')and origin in tools:row['hashOnly']='Installed ELF tool/shared-library identity, not redistributed'
  else:
   name='objects/'+h
   if name not in written:z.writestr(name,value);written.add(name)
   row['member']=name
  rows.append(row)
manifest={'scope':'ALLOCATOR-only field passing; four full correctness streams and one allocation sample per before/after; failed/unexecuted preparation history retained, no #28 acceptance or timing claim','cases':cases,'members':rows,'zipSHA256':sha((D/'EVIDENCE.zip').read_bytes())};(D/'MANIFEST.json').write_text(json.dumps(manifest,indent=2)+'\n');print(json.dumps({'members':len(rows),'zipSHA256':manifest['zipSHA256'],'manifestSHA256':sha((D/'MANIFEST.json').read_bytes())}))
