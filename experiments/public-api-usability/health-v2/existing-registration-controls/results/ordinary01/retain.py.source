from pathlib import Path
import json,gzip,hashlib,shutil,os
D=Path('/tmp/bendvy-ordinary-existing-entry/experiments/public-api-usability/health-v2/existing-registration-controls');L=D/'results/ordinary01';assert not L.exists();(L/'objects').mkdir(parents=True);sha=lambda b:hashlib.sha256(b).hexdigest();versions={};tools=set();cases=[]
oldhelper=(D/'history/prepare-attempt01.py.source').read_bytes()
def pin(name,h):
 p=Path(name);raw=p.read_bytes()
 if sha(raw)!=h:
  assert name=='/tmp/prepare21-existing-registration-controls.py';raw=oldhelper;assert sha(raw)==h
 versions[(name,h)]=raw
for attempt,kind,role in [('02',kind,role) for kind in ['normal','mutant'] for role in ['js','native']]+[('01','normal','js')]:
 q=Path('/tmp/bendvy21-existing-registration-controls-actual'+attempt)/kind/role;p=json.loads((q/'plan.json').read_text());r=json.loads((q/'receipt.json').read_text());assert r['planSHA256']==sha((q/'plan.json').read_bytes());cases.append({'directory':str(q),'current':attempt=='02','kind':kind,'role':role,'planSHA256':r['planSHA256'],'receiptSHA256':sha((q/'receipt.json').read_bytes())})
 for name,h in p['pins'].items():pin(name,h)
 for root,files in p['resourceRoots'].items():
  for name,h in files.items():path=str(Path(root)/name);pin(path,h);tools.add(path)
 tools.update(p['tools'].values())
 for g in r['guards']:
  pin(g['path'],g['sha256']);guard=json.loads(Path(g['path']).read_text());assert guard['unchanged']
  for name,h in guard['actualPins'].items():pin(name,h)
 for c in r['commands']:
  for key in ['stdout','stderr']:v=c[key];pin(v['path'],v['sha256']);assert Path(v['path']).stat().st_size==v['bytes']
 for f in q.iterdir():
  if f.is_file():pin(str(f),sha(f.read_bytes()))
for f in [Path(__file__),Path('/tmp/verify21-existing-registration-controls.py'),D/'PLAN-FREEZE.json',D/'history/prepare-attempt01.py.source']:pin(str(f),sha(f.read_bytes()))
rows=[]
for (name,h),raw in sorted(versions.items()):
 p=Path(name);row={'actualPath':name,'actualRealpath':str(p.resolve()),'bytes':len(raw),'sha256':h}
 if raw.startswith(b'\x7fELF') and name in tools:row['hashOnly']='Installed tool/shared library identity only; not redistributed'
 else:
  obj=L/'objects'/(h+'.gz')
  if not obj.exists():obj.write_bytes(gzip.compress(raw,mtime=0))
  row.update(object=os.path.relpath(obj,L),objectSHA256=sha(obj.read_bytes()))
 rows.append(row)
record={'scope':'Ordinary existing-registration affine/authority controls: four current complete JS/Native normal+source-route-mutant runs; explicit mutant rejects normal oracle. Historical helper missing expectedExit failed after successful source check before emission. No performance/full-core claim.','cases':cases,'members':rows,'objects':len(list((L/'objects').iterdir()))};(L/'RETENTION.json').write_text(json.dumps(record,indent=2)+'\n');shutil.copyfile(__file__,L/'retain.py.source');shutil.copyfile('/tmp/verify21-existing-registration-controls.py',L/'verify.py');print(len(rows),record['objects'])
