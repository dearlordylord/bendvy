W=Path('/tmp/bendvy73-world-validation');R=Path('/workspace/formal-proofs/bendvy');D=W/'experiments/public-api-usability/world-validation-fields-v1';O=Path('/tmp/bendvy73-world-validation-actual02');assert not O.exists();O.mkdir();stage=O/'source';oldstage=R/'.artifacts/regression73-20261018-pinned02/candidate';shutil.copytree(oldstage/'src',stage/'src');shutil.copytree(oldstage/'examples',stage/'examples');shutil.copyfile(W/'src/ecs/world.bend',stage/'src/ecs/world.bend');sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
