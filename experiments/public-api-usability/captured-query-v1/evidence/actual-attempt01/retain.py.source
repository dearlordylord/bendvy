W=Path('/tmp/bendvy-captured-query-app');D=W/'experiments/public-api-usability/captured-query-v1';L=D/'evidence/actual-attempt01';assert not L.exists();(L/'objects').mkdir(parents=True);sha=lambda b:hashlib.sha256(b).hexdigest();versions={};tools=set();cases=[]
def pin(name,h):
 if(name,h)in versions:return
 raw=Path(name).read_bytes()
 if sha(raw)!=h:
  matches=[r for r in history if r['originalPath']==name and r['sha256']==h];assert len(matches)==1,(name,h);raw=Path(matches[0]['historicalCopy']).read_bytes()
 assert sha(raw)==h,(name,h);versions[name,h]=raw
history=json.loads((D/'HISTORICAL-PREPARERS.json').read_text())['versions']
selected=[('workshop',r,Path('/tmp/bendvy73-captured-query-workshop-actual02/normal')/r)for r in ['js','native']]+[('garden',r,Path('/tmp/bendvy73-captured-query-garden-actual01/normal')/r)for r in ['js','native']]+[('authority','source',Path('/tmp/bendvy73-captured-query-controls-actual01/source'))]+[('refusal',r,Path('/tmp/bendvy73-captured-query-controls-actual01')/r)for r in ['js','native']]
for kind,role,q in selected:
 p=json.loads((q/'plan.json').read_text());r=json.loads((q/'receipt.json').read_text());assert r['status']==('COMPLETE_SOURCE_CONTROL_PASS'if kind=='authority'else'COMPLETE_CONSUMER_DEVELOPMENT_PASS');assert r['planSHA256']==sha((q/'plan.json').read_bytes())
 cases.append({'kind':kind,'role':role,'directory':str(q),'planSHA256':r['planSHA256'],'receiptSHA256':sha((q/'receipt.json').read_bytes())})
 for name,h in p['pins'].items():pin(name,h)
 for root,files in p['resourceRoots'].items():
  for rel,h in files.items():name=str(Path(root)/rel);pin(name,h);tools.add(name)
 tools.update(p['tools'].values())
 for g in r['guards']:
  pin(g['path'],g['sha256']);guard=json.loads(Path(g['path']).read_text());assert guard['unchanged']
  for name,h in guard['actualPins'].items():pin(name,h)
 for command in r['commands']:
  for key in ['stdout','stderr']:v=command[key];pin(v['path'],v['sha256']);assert len(versions[v['path'],v['sha256']])==v['bytes']
 for f in q.iterdir():
  if f.is_file():pin(str(f),sha(f.read_bytes()))
for f in D.rglob('*'):
 if f.is_file()and'evidence'not in f.parts and'__pycache__'not in f.parts:pin(str(f),sha(f.read_bytes()))
for f in [Path(__file__),Path('/tmp/verify73-captured-query.py')]:pin(str(f),sha(f.read_bytes()))
# Preserve the failed original oracle comparison and unexecuted Native plan.
for q in [Path('/tmp/bendvy73-captured-query-workshop-actual01/normal')/r for r in ['js','native']]:
 for f in q.iterdir():
