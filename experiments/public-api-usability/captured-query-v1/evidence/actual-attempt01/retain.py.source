record={'scope':'Ordinary captured-query public helper: two nominal schemas, heterogeneous Component composition, full Type capture, typed callback errors and complete output lists, failure/same-owner retry and repeat; finite trusted MAX registration refusal; three authority refusals. No benchmark or all22 acceptance.','cases':cases,'history':'Workshop01 JS INCOMPLETE due independent oracle registration ordering error; Native01 UNEXECUTED. Four source-backed registration fields corrected; no helper behavior change.','members':rows,'objects':len(list((L/'objects').iterdir()))};(L/'RETENTION.json').write_text(json.dumps(record,indent=2)+'\n');shutil.copyfile(__file__,L/'retain.py.source');shutil.copyfile('/tmp/verify73-captured-query.py',L/'verify.py');print(json.dumps({'members':len(rows),'objects':record['objects'],'manifestSHA256':sha((L/'RETENTION.json').read_bytes())}))
