def component_uses(~S:Data,clauses:List<&2,Decl.Clause<S>>) -> List<&2,Records.DeclaredUse>:
  match clauses:
    case []:[]
    case Decl.Clause{key,mode} <> rest:Records.DeclaredUse{Records.ComponentUse{},Records.MessageSource{},key,mode} <> component_uses(~S,rest)
