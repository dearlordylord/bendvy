  Phase.apply_with(~S,~K,~V,~C,~R,~E,~runner,~Ctx.Context<W.World<S,C,R,E>>,~Handler.invoke(~S,~C,~R,~E,~V,~runner,~observed),~Handler.initial(~S,~C,~R,~E,~V,~runner,~observed),~Handler.context_take(~S,~C,~R,~E,~V,~runner,~K,~take),~Handler.context_put(~S,~C,~R,~E,~V,~runner,~K,~put),~Handler.context_publish(~S,~C,~R,~E,~V,~runner,~publish,~name),~same,~framed(~S,~C,~R,~E,~frame),owners,world)
