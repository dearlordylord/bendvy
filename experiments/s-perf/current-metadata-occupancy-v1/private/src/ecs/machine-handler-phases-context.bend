def framed(~S:Data,~C:Type,~R:Type,~E:Data,~frame:W.World<S,C,R,E> -> W.World<S,C,R,E>,context:Ctx.Context<W.World<S,C,R,E>>) -> Ctx.Context<W.World<S,C,R,E>>:
  match context:
    case Ctx.Context{world,trace}:Ctx.Context{frame(world),trace}
