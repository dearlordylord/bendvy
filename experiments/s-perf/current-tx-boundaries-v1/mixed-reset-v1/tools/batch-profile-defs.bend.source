def committed(~S:Data,~Store:Type,~R:Type,~E:Data,~P:Type,~Error:Data,before:Sampler.Sample,after:Sampler.Sample,observed:T.Returned<W.World<S,Store,R,E>,Error>) -> Finished<S,Store,R,E,P,Error>:
  match observed:
    case T.Returned{world,+outcome}:Committed{world,[before,Sampler.finished(after,T.committed(~Error,outcome))]}
def failed(~S:Data,~Store:Type,~R:Type,~E:Data,~P:Type,~Error:Data,payloads:List<P>,error:Error,sample:Sampler.Sample,observed:T.Returned<W.World<S,Store,R,E>,Error>) -> Finished<S,Store,R,E,P,Error>:
  match observed:
    case T.Returned{world,+outcome}:Failed{world,payloads,error,[Sampler.finished(sample,T.committed(~Error,outcome))]}
def finish_staged(~S:Data,~Store:Type,~R:Type,~E:Data,~P:Type,~Error:Data,before:Sampler.Sample,observed:T.Tx<W.World<S,Store,R,E>,E> & Sampler.Sample) -> Finished<S,Store,R,E,P,Error>:
  match observed:
    case (tx,after):committed(~S,~Store,~R,~E,~P,~Error,before,after,Cmd.tx_finish(~S,~Store,~R,~E,~Error,tx,T.Success{}))
def finish_before(~S:Data,~Store:Type,~R:Type,~E:Data,~P:Type,~Error:Data,~attempt:W.World<S,Store,R,E> -> W.Handle<S> -> P -> B.Delivery<W.World<S,Store,R,E>,P>,~recover:W.World<S,Store,R,E> -> P -> W.WorldError -> W.World<S,Store,R,E>,prepared:List<Prepared<S,P>>,outcome:T.Outcome<Error>,observed:T.Tx<W.World<S,Store,R,E>,E> & Sampler.Sample) -> Finished<S,Store,R,E,P,Error>:
  match outcome observed:
    case T.Success{},(tx,before):finish_staged(~S,~Store,~R,~E,~P,~Error,before,Sampler.observe_world(~S,~Store,~R,~E,"before-finish",stage(~S,~Store,~R,~E,~P,~attempt,~recover,List.reverse(&1,Prepared<S,P>,prepared),tx)))
    case T.Failure{+error},(tx,before):failed(~S,~Store,~R,~E,~P,~Error,originals(~S,~P,List.reverse(&1,Prepared<S,P>,prepared)),error,before,Cmd.tx_finish(~S,~Store,~R,~E,~Error,tx,T.Failure{error}))
def finish(~S:Data,~Store:Type,~R:Type,~E:Data,~P:Type,~Error:Data,~attempt:W.World<S,Store,R,E> -> W.Handle<S> -> P -> B.Delivery<W.World<S,Store,R,E>,P>,~recover:W.World<S,Store,R,E> -> P -> W.WorldError -> W.World<S,Store,R,E>,batch:Batch<S,Store,R,E,P>,outcome:T.Outcome<Error>) -> Finished<S,Store,R,E,P,Error>:
  match batch:
    case Batch{tx,prepared}:finish_before(~S,~Store,~R,~E,~P,~Error,~attempt,~recover,prepared,outcome,Sampler.observe_world(~S,~Store,~R,~E,"before-stage-or-discard",tx))
