from pathlib import Path
import json,gzip,hashlib,subprocess,os,shutil
W=Path('/tmp/bendvy-current-tx-boundaries');D=W/'experiments/s-perf/current-tx-boundaries-v1';L=D/'results/dense64-first01';assert not L.exists();(L/'objects').mkdir(parents=True);sha=lambda b:hashlib.sha256(b).hexdigest();versions={};tools=set();cases=[];history='8e0b70348'
def pin(path,h):
 path=str(path);p=Path(path);raw=p.read_bytes()
 if sha(raw)==h:versions[path,h]=None;return
 assert p.is_relative_to(W),path
 raw=subprocess.check_output(['git','show',history+':'+str(p.relative_to(W))],cwd=W);assert sha(raw)==h,(path,h)
 versions[path,h]=raw
roots=[('original-js-rejected','/tmp/bendvy21-current-tx-boundaries-dense-motion64-actual01/normal/js'),('normal-native','/tmp/bendvy21-current-tx-boundaries-dense-motion64-actual02/normal/native'),('missing-hook-js','/tmp/bendvy21-current-tx-boundaries-missing-resource-actual01/js'),('missing-hook-native','/tmp/bendvy21-current-tx-boundaries-missing-resource-actual01/native')]
for kind,path in roots:
 q=Path(path);p=json.load(open(q/'plan.json'));r=json.load(open(q/'receipt.json'));assert r['planSHA256']==sha((q/'plan.json').read_bytes());cases.append({'kind':kind,'directory':path,'planSHA256':r['planSHA256'],'receiptSHA256':sha((q/'receipt.json').read_bytes())})
 for f,h in p['pins'].items():pin(f,h)
 for root,files in p['resourceRoots'].items():
  for f,h in files.items():name=str(Path(root)/f);pin(name,h);tools.add(name)
 tools.update(p['tools'].values())
 for g in r['guards']:
  pin(g['path'],g['sha256']);guard=json.load(open(g['path']));assert guard['unchanged']
  for f,h in guard['actualPins'].items():pin(f,h)
 for c in r['commands']:
  for k in ['stdout','stderr']:v=c[k];pin(v['path'],v['sha256'])
 for f in q.iterdir():
  if f.is_file():pin(f,sha(f.read_bytes()))
J=Path('/tmp/bendvy21-current-tx-boundaries-dense-motion64-js-revalidation01');jp=json.load(open(J/'plan.json'))
for f,h in jp['pins'].items():pin(f,h)
for f in J.iterdir():
 if f.is_file():pin(f,sha(f.read_bytes()))
# Original Native plan was frozen but never launched; preserve as such, not a failed attempt.
N=Path('/tmp/bendvy21-current-tx-boundaries-dense-motion64-actual01/normal/native/plan.json');assert not (N.parent/'receipt.json').exists();pin(N,sha(N.read_bytes()))
for f in [Path(__file__),Path('/tmp/verify21-current-boundaries-first.py')]:pin(f,sha(f.read_bytes()))
rows=[]
for (name,h),saved in sorted(versions.items()):
 raw=saved if saved is not None else Path(name).read_bytes();assert sha(raw)==h;row={'actualPath':name,'sha256':h,'bytes':len(raw)}
 if saved is not None:row['historicalGitSource']=history+':'+str(Path(name).relative_to(W))
 if raw.startswith(b'\x7fELF') and name in tools:row['hashOnly']='Installed tool/shared library identity only; not redistributed'
 else:
  obj=L/'objects'/(h+'.gz')
  if not obj.exists():obj.write_bytes(gzip.compress(raw,mtime=0))
  row.update(object=os.path.relpath(obj,L),objectSHA256=sha(obj.read_bytes()))
 rows.append(row)
record={'scope':'Bounded actual DenseMotion64 seed/query append boundaries: actual65Tx reports, cached counters independently traversed prefinish, actual begin/end tick and completion. Original JS collector metric rejection retained; same immutable JS output revalidated against source-backed corrected oracle, Native02 PASS, two exact missing-hook defects detected. No mixed/reset/raw-discard/fivefamily/stamp/marks/RSS/allocation universal qualification.','cases':cases,'jsRevalidation':str(J),'unexecutedNativePlan':str(N),'members':rows,'objects':len(list((L/'objects').iterdir()))};(L/'RETENTION.json').write_text(json.dumps(record,indent=2)+'\n');shutil.copyfile(__file__,L/'retain.py.source');shutil.copyfile('/tmp/verify21-current-boundaries-first.py',L/'verify.py');print(len(rows),record['objects'])
