from pathlib import Path
import json,gzip,hashlib,subprocess,os,shutil
W=Path('/tmp/bendvy-workload-lifecycle-boundaries');D=W/'experiments/s-perf/current-tx-boundaries-v1/workload-boundaries-v1/lifecycle-v1';L=D/'results/motion64-first01';assert not L.exists();(L/'objects').mkdir(parents=True);sha=lambda b:hashlib.sha256(b).hexdigest();versions={};tools=set();cases=[];history='0b4db52e1'
def pin(path,h):
 path=str(path);p=Path(path);raw=p.read_bytes()
 if sha(raw)==h:versions[path,h]=None;return
 assert p.is_relative_to(W),path
 raw=subprocess.check_output(['git','show',history+':'+str(p.relative_to(W))],cwd=W);assert sha(raw)==h,(path,h)
 versions[path,h]=raw
roots=[('normal-'+r,'/tmp/bendvy21-lifecycle-workload-boundaries-motion64-actual01/normal/'+r) for r in ['js','native']]
roots += [('null-control-'+r,'/tmp/bendvy21-lifecycle-boundary-null-control-actual01/'+r) for r in ['js','native']]
for kind,path in roots:
 q=Path(path);p=json.load(open(q/'plan.json'));r=json.load(open(q/'receipt.json'));assert r['planSHA256']==sha((q/'plan.json').read_bytes());cases.append({'kind':kind,'directory':path,'planSHA256':r['planSHA256'],'receiptSHA256':sha((q/'receipt.json').read_bytes())})
 for f,h in p['pins'].items():pin(f,h)
 for root,files in p['resourceRoots'].items():
  for f,h in files.items():name=str(Path(root)/f);pin(name,h);tools.add(name)
 tools.update(p['tools'].values())
 for g in r['guards']:
  pin(g['path'],g['sha256']);guard=json.load(open(g['path']));assert guard['unchanged']
  for f,h in guard['actualPins'].items():pin(f,h)
 for c in r['commands']:
  for k in ['stdout','stderr']:v=c[k];pin(v['path'],v['sha256'])
 for f in q.iterdir():
  if f.is_file():pin(f,sha(f.read_bytes()))
for f in [Path(__file__),Path('/tmp/verify21-lifecycle-boundary-first.py'),D/'checks/GENERIC-CONTROL-APPLICABILITY.json']:pin(f,sha(f.read_bytes()))
rows=[]
for (name,h),saved in sorted(versions.items()):
 raw=saved if saved is not None else Path(name).read_bytes();assert sha(raw)==h;row={'actualPath':name,'sha256':h,'bytes':len(raw)}
 if saved is not None:row['historicalGitSource']=history+':'+str(Path(name).relative_to(W))
 if raw.startswith(b'\x7fELF') and name in tools:row['hashOnly']='Installed tool/shared library identity only; not redistributed'
 else:
  obj=L/'objects'/(h+'.gz')
  if not obj.exists():obj.write_bytes(gzip.compress(raw,mtime=0))
  row.update(object=os.path.relpath(obj,L),objectSHA256=sha(obj.read_bytes()))
 rows.append(row)
record={'scope':'Actual ordinary LifecycleMotion64 single primary/foreign run:4226 grouped actual reports including4096 read-onlyzero-journal unselect rawdiscards with null outcome and returnedWorld witness,2seed and128Local finish reports. NormalJSNative full unchanged LC2; null-to-false reached reporting defect bothbackends. Not global chronology/nonemptydiscard/fullfiveworkload qualification, separate journals/stamppeaks/marks/RSS/allocation/timing.','cases':cases,'members':rows,'objects':len(list((L/'objects').iterdir()))};(L/'RETENTION.json').write_text(json.dumps(record,indent=2)+'\n');shutil.copyfile(__file__,L/'retain.py.source');shutil.copyfile('/tmp/verify21-lifecycle-boundary-first.py',L/'verify.py');print(len(rows),record['objects'])
