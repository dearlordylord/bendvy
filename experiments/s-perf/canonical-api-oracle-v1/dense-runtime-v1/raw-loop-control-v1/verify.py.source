import ast
import gzip
import hashlib
import json
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

here = Path(__file__).resolve().parent
sha = lambda data: hashlib.sha256(data).hexdigest()
basis = json.loads((here / 'SOURCE-BASIS.json').read_text())
assert sha(Path(basis['sourceFreeze']).read_bytes()) == basis['sourceFreezeSHA256']
for group in ('sourceInventory', 'sourcePins', 'formatResources'):
    for path, digest in basis[group].items():
        assert sha(Path(path).read_bytes()) == digest, path
for path, digest in basis['modelPins'].items():
    assert sha((here / path).read_bytes()) == digest
collector = Path('/workspace/formal-proofs/bendvy/experiments/public-inspect/ordinary-declaration-v1/canonical-full-consumer-v1/development-v2.py')
tree = ast.parse(collector.read_text())
fn = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == 'validate_imports')
env = {'Path': Path, 're': re}
exec(compile(ast.Module(body=[fn], type_ignores=[]), str(collector), 'exec'), env)
bends = {p: h for p, h in basis['sourceInventory'].items() if p.endswith('.bend')}
assert len(env['validate_imports']('.', bends, [basis['entrypoint']])) == 59
raw = (here / 'expected.stdout').read_bytes()
zipped = (here / 'expected.stdout.gz').read_bytes()
assert len(raw) == basis['expectedBytes'] and sha(raw) == basis['expectedSHA256']
assert sha(zipped) == basis['expectedGzipSHA256'] and gzip.decompress(zipped) == raw
with tempfile.TemporaryDirectory(prefix='raw-loop-independent-') as tmp:
    for name in ('model.py', 'state.py'):
        shutil.copyfile(here / name, Path(tmp) / name)
    subprocess.run([sys.executable, str(Path(tmp) / 'model.py'), '--self-test'], cwd=tmp,
                   check=True, capture_output=True)
    assert subprocess.check_output([sys.executable, str(Path(tmp) / 'model.py')], cwd=tmp) == raw
print('PASS', len(raw), sha(raw))
