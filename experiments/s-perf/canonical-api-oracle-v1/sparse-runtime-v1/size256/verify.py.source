import gzip
import hashlib
import importlib
import json
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile

here = Path(__file__).resolve().parent
root = here.parent
sha = lambda raw: hashlib.sha256(raw).hexdigest()
for schema in ['Motion', 'Health']:
    leaf = here / schema.lower()
    basis = json.loads((leaf / 'SOURCE-BASIS.json').read_text())
    count, iterations = map(int, basis['runtimeArguments'])
    assert iterations == 64 and count in [256, 1024]
    for group in ['sourceInventory', 'sourcePins', 'formatResources', 'historicalAndTSInputs']:
        for path, expected in basis[group].items():
            assert sha(Path(path).read_bytes()) == expected, path
    assert sha(Path(basis['sourceFreeze']).read_bytes()) == basis['sourceFreezeSHA256']
    for path, binding in basis['retainedBodies'].items():
        assert sha((root / binding['retained']).read_bytes()) == binding['sha256'], path
    raw = (leaf / 'expected.stdout').read_bytes()
    compressed = (leaf / 'expected.stdout.gz').read_bytes()
    assert len(raw) == basis['expectedBytes'] and sha(raw) == basis['expectedSHA256']
    assert len(compressed) == basis['expectedGzipBytes'] and sha(compressed) == basis['expectedGzipSHA256']
    assert gzip.decompress(compressed) == raw
    with tempfile.TemporaryDirectory(prefix='sparse-sized-model-') as tmp:
        for relative, expected in basis['modelPins'].items():
            path = here / relative
            assert sha(path.read_bytes()) == expected
            shutil.copyfile(path, Path(tmp) / path.name)
        model_name = 'model' if schema == 'Motion' else 'health_model'
        shared_name = 'shared' if schema == 'Motion' else 'health_shared'
        reproduced = subprocess.check_output([sys.executable, str(Path(tmp) / (model_name + '.py')),
                                               str(count), str(iterations)], cwd=tmp)
        assert reproduced == raw
        sys.path.insert(0, tmp)
        for name in ['model', 'base_state', 'health_model', 'shared', 'health_shared']:
            sys.modules.pop(name, None)
        model = importlib.import_module(model_name)
        shared = importlib.import_module(shared_name)
        _, world = model.report(count, iterations)
        assert world.clock == world.cursor == count // 8 + (count + 2) // 3 + (count + 1) // 3 + count // 8 * 64
        assert world.ledger == [count // 8 * 64, 101, 102, 103]
        assert len(world.phases) == count * 2 and world.phases.count('Live') == count
        assert [len(col.stamps) for col in world.columns] == [count // 8, (count + 2) // 3, (count + 1) // 3]
        expected_cumulative = 0
        for iteration in range(iterations):
            assert world.audit[iteration] == [4 * j + 6 + iteration for j in range(0, count, 8)]
            rows = {j: 5 * j + (16 if schema == 'Motion' else 20) + iteration
                    + ((12 if schema == 'Motion' else 14) if j % 3 == 0 else 0)
                    + (9 if j % 3 == 1 else 0) for j in range(0, count, 8)}
            subsets = [list(rows), [j for j in rows if j % 3 == 0], [j for j in rows if j % 3 != 0]]
            scores = [sum(rank * rows[j] for rank, j in enumerate(subset, 1)) + len(subset) + 1
                      for subset in subsets]
            weighted = sum(weight * score for weight, score in zip([1, 3, 5], scores)) & ((1 << 32) - 1)
            assert world.scan_audits[iteration].endswith(';weighted=' + str(weighted))
            expected_cumulative = (expected_cumulative + sum(world.audit[iteration]) + weighted) & ((1 << 32) - 1)
        assert world.cumulative == expected_cumulative == basis['facts']['cumulative']
        final, audits = shared.derived(count, iterations)
        reference = basis['sharedTS']['result']
        assert shared.digest(final) == reference['finalSha256'] == reference['oracleSha256']
        assert shared.digest(audits) == reference['auditSha256']
        sys.path.pop(0)
    assert raw.endswith(b'\n\n') and b'UNSUPPORTED' not in raw
    print('PASS', schema, count, len(raw), sha(raw), 'isolated/full-rows/closed-form/TS hash joins')
