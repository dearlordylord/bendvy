import ast
import gzip
import hashlib
import json
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

here = Path(__file__).resolve().parent
sha = lambda data: hashlib.sha256(data).hexdigest()
collector = Path('/workspace/formal-proofs/bendvy/experiments/public-inspect/ordinary-declaration-v1/canonical-full-consumer-v1/development-v2.py')
tree = ast.parse(collector.read_text())
fn = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == 'validate_imports')
namespace = {'Path': Path, 're': re}
exec(compile(ast.Module(body=[fn], type_ignores=[]), str(collector), 'exec'), namespace)
with tempfile.TemporaryDirectory(prefix='dense64-independent-model-') as tmp:
    for name in ['model.py', 'shared.py']:
        shutil.copyfile(here / name, Path(tmp) / name)
    subprocess.run([sys.executable, str(Path(tmp) / 'model.py'), '--self-test'], check=True, capture_output=True)
    for schema in ['Motion', 'Health']:
        leaf = here / schema.lower()
        basis = json.loads((leaf / 'SOURCE-BASIS.json').read_text())
        assert sha(Path(basis['sourceFreeze']).read_bytes()) == basis['sourceFreezeSHA256']
        for group in ['sourceInventory', 'sourcePins', 'formatResources']:
            for path, expected in basis[group].items():
                assert sha(Path(path).read_bytes()) == expected, path
        for path, expected in basis['modelPins'].items():
            assert sha((here / path).read_bytes()) == expected
        bends = {p: h for p, h in basis['sourceInventory'].items() if p.endswith('.bend')}
        assert len(namespace['validate_imports']('.', bends, [basis['entrypoint']])) == 58
        raw = (leaf / 'expected.stdout').read_bytes()
        compressed = (leaf / 'expected.stdout.gz').read_bytes()
        assert len(raw) == basis['expectedBytes'] and sha(raw) == basis['expectedSHA256']
        assert sha(compressed) == basis['expectedGzipSHA256'] and gzip.decompress(compressed) == raw
        reproduced = subprocess.check_output([sys.executable, str(Path(tmp) / 'model.py'), schema], cwd=tmp)
        assert reproduced == raw
        assert raw.endswith(b'\n\n') and b'UNSUPPORTED' not in raw
        print(schema, 'PASS', len(raw), sha(raw))
