roots=set()
for pattern in ['bendvy21-canonical-lifecycle-*actual*','bendvy21-lifecycle-*-actual*','bendvy21-lifecycle-*diagnostic*']:
 roots.update(p for p in Path('/tmp').glob(pattern) if p.is_dir())
for root in sorted(roots):
 for f in root.glob('*'):
  if f.is_file():paths.add(str(f))
 for p in sorted(root.rglob('plan.json')):
  if any(x['planPath']==str(p) for x in current+incomplete+controls+history):continue
  capture(p.parent,False)
# PC custom runner stores plans in the delivery leaf rather than actual output.
# Match exact receipt.planSHA256, including corrected v5-current-oracle;
