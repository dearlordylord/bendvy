for source in sorted((D/'diagnostics').glob('native-pc-sampling-v*')):
 p=source/'plan.json'
 if not p.exists():continue
 metadata=json.loads(p.read_text());actual=Path(metadata['output'])
 if actual.exists():capture(actual,False,p)
for p in Path('/tmp').glob('bendvy21*lifecycle*root-summary.json'):paths.add(str(p))
for sourceWT in [Path('/tmp/bendvy-lifecycle-array-buffer'),Path('/tmp/bendvy-lifecycle-health-array-buffer'),Path('/tmp/bendvy-lifecycle-health-single-counter'),Path('/tmp/bendvy-lifecycle-motion-single-counter'),Path('/tmp/bendvy-lifecycle-health-materialize')]:
 sourceLeaf=sourceWT/'experiments/s-perf/canonical-api-v1/lifecycle-runtime-v1'
 for f in sourceLeaf.rglob('*'):
  if f.is_file() and '__pycache__' not in f.parts:paths.add(str(f))
OR=Path('/tmp/bendvy-canonical-lifecycle-oracle');prefix='experiments/s-perf/canonical-api-oracle-v1/lifecycle-runtime-v1'
for name in subprocess.check_output(['git','-C',str(OR),'ls-files',prefix],text=True).splitlines():
 if '__pycache__' not in Path(name).parts and not name.endswith('.pyc'):paths.add(str(OR/name))
for p in Path('/tmp').glob('analyze-lifecycle-pc*.py'):paths.add(str(p))
# Include all reviewed diagnostic helper/preparer/source-lineage metadata, including
