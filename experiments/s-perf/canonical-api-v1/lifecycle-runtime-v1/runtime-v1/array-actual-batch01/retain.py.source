WT=Path('/tmp/bendvy-canonical-lifecycle-delivery');D=WT/'experiments/s-perf/canonical-api-v1/lifecycle-runtime-v1';L=D/'runtime-v1/array-actual-batch01';assert not L.exists();(L/'objects').mkdir(parents=True)
sha=lambda b:hashlib.sha256(b).hexdigest();paths=set();toolOnly=set();current=[];incomplete=[];controls=[];history=[]
hashCache={}
def file_hash(p):
 p=Path(p);st=p.stat();identity=(st.st_dev,st.st_ino,st.st_size,st.st_mtime_ns,st.st_ctime_ns)
 prior=hashCache.get(str(p))
 if prior is None or prior[0]!=identity:hashCache[str(p)]=(identity,sha(p.read_bytes()))
 return hashCache[str(p)][1]
def pin(path,h):
 p=Path(path);assert file_hash(p)==h,path;paths.add(str(p))
def capture(d,isCurrent,planPath=None,category=None):
 planPath=planPath or d/'plan.json'
 p=json.loads(planPath.read_text());rp=d/'receipt.json'
 # A preserved unlaunched metadata predecessor may name an output later used by its successor.
 foreignReceipt=None
 if rp.exists() and json.loads(rp.read_text())['planSHA256']!=sha(planPath.read_bytes()):
  foreignReceipt=json.loads(rp.read_text())['planSHA256'];rp=d/'__NO_RECEIPT_FOR_THIS_PLAN__'
 if isCurrent or category=='selected-incomplete':assert rp.exists(),('Selected role requires its exact receipt',str(d),foreignReceipt)
 paths.add(str(planPath));historicalDifferences=[]
 for name,h in p['pins'].items():
  if isCurrent or rp.exists():pin(name,h)
  else:
   actual=file_hash(name)
   if actual==h:pin(name,h)
   else:historicalDifferences.append({'path':name,'plannedSHA256':h,'currentSHA256':actual,'scope':'Unexecuted plan current-path difference; no claim these bytes executed.'});paths.add(name)
 for root,files in p['resourceRoots'].items():
  for name,h in files.items():q=str(Path(root)/name);pin(q,h);toolOnly.add(q)
 toolOnly.update(x for x in p['tools'].values() if not x.endswith('.native') and not x.startswith('/tmp/bendvy21-'))
 record={'category':category or ('current' if isCurrent else 'history'),'actualDirectory':str(d),'planPath':str(planPath),'planSHA256':sha(planPath.read_bytes()),'status':'UNEXECUTED','unexecutedPinDifferences':historicalDifferences}
 if foreignReceipt is not None:record.update(status='UNEXECUTED_METADATA_PREDECESSOR',outputReceiptBelongsToPlanSHA256=foreignReceipt)
 if not rp.exists() and not isCurrent and foreignReceipt is None:

  classification=d.parent.parent/'ROOT-CLASSIFICATION.json'
  if classification.exists():
   paths.add(str(classification)); matched=[x for x in json.loads(classification.read_text())['plans'] if x['plan']==str(d/'plan.json')];assert len(matched)==1
   record.update(status=matched[0]['status'],coordinatorClassification=str(classification),childCommands=matched[0]['childCommands'],observedPinDifference=matched[0]['observedPinDifference'])
 if rp.exists():
  r=json.loads(rp.read_text());assert r['planSHA256']==record['planSHA256'];record.update(status=r['status'],receiptSHA256=sha(rp.read_bytes()),guardFailures=r.get('guardFailures'),error=r.get('error'),commands=[])
  for g in r.get('guards',[]):
   pin(g['path'],g['sha256']);guard=json.loads(Path(g['path']).read_text());assert guard['unchanged']
   for name,h in guard['actualPins'].items():pin(name,h)
  expected={x['label']:x for x in p['commands']}
  for c in r['commands']:
   e=expected.get(c['label'])
   if e is not None:
    for k in ['label','argv','capSeconds']:assert c[k]==e[k]
   else:assert c['label'].startswith('library-probe-'),c['label']
   for k in ['stdout','stderr']:
    v=c[k];pin(v['path'],v['sha256']);assert Path(v['path']).stat().st_size==v['bytes']
   record['commands'].append({k:c[k] for k in ['label','exit','failure']})
  if isCurrent:
   assert r['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS';assert len(r['commands'])==len(p['commands']);assert all(c['exit']==0 and c['failure'] is None for c in r['commands'])
   raw=(d/'consumer.stdout').read_bytes();assert raw==gzip.decompress(Path(p['oracle']).read_bytes());assert (d/'consumer.stderr').read_bytes()==b'';record.update(bytes=len(raw),sha256=sha(raw))
  if category=='selected-incomplete':
   assert r['status']=='INCOMPLETE' and r.get('guardFailures')==[],record
   assert len(r['commands'])==len(p['commands'])==1,record
   child=r['commands'][0]
   assert child['label']=='consumer' and child['capSeconds']==5 and child['exit'] is None and child['failure']=='child deadline',child
   raw=Path(child['stdout']['path']).read_bytes();oracle=gzip.decompress(Path(p['oracle']).read_bytes())
   assert 0<len(raw)<len(oracle) and raw==oracle[:len(raw)]
   assert Path(child['stderr']['path']).read_bytes()==b''
   record.update(bytes=len(raw),sha256=sha(raw),expectedBytes=len(oracle),exactIncompletePrefix=True,acceptance='INCOMPLETE: five-second ordinary gate remains open')
 for f in d.rglob('*'):
  if f.is_file():paths.add(str(f))
 (incomplete if category=='selected-incomplete' else controls if category=='primitive-control' else current if isCurrent else history).append(record)
for schema in ['motion','health']:
 for size in [64,256,1024]:
  for role in ['js','native']:
   attempt='01'
   selected=Path(f'/tmp/bendvy21-canonical-lifecycle-array-buffer-{schema}{size}-actual{attempt}/normal/{role}')
   if (schema,size,role)==('health',1024,'js'):capture(selected,False,category='selected-incomplete')
   else:capture(selected,True)
assert len(current)==11 and len(incomplete)==1
# Separate actual encoder controls: previous string-U3272, direct-buffer8279,
# selected Array-buffer8288 (includes empty write and finite Unicode text).
for prefix in ['bendvy21-u32-primitive-actual01','bendvy21-buffer-u32-primitive-actual01','bendvy21-array-buffer-primitive-actual01']:
 for role in ['js','native']:
  capture(Path('/tmp')/prefix/'normal'/role,True,category='primitive-control')
# Preserve all earlier source attempts, timeout/engine diagnostics and complete controls.
