for f in (D/'diagnostics').rglob('*'):
 if f.is_file() and '__pycache__' not in f.parts and f.suffix!='.pyc':paths.add(str(f))
# Rejected writer source/control attempts and exact root forensic helpers remain history.
for f in Path('/tmp/bendvy21-single-counter-primitive-root').rglob('*'):
 if f.is_file() and '__pycache__' not in f.parts:paths.add(str(f))
for name in ['/tmp/prepare21-lifecycle-array-health-v8-prof.py','/tmp/bendvy21-prepare-lifecycle-single-counter-reuse.py','/tmp/bendvy21-prepare-lifecycle-materialize-reuse.py','/tmp/bendvy21-materialize-generated-js-review.json','/tmp/bendvy21-lifecycle-array-health-v8-prof-diagnostic01/V8-SOURCE-ANALYSIS.json']:
 assert Path(name).is_file(),name
 paths.add(name)
paths.add('/tmp/lifecycle-array-protected-affinity.json')
paths.add('/tmp/probe-retain21-lifecycle-selected-receipts.py')
paths.add(str(Path(__file__)));rows=[]
for name in sorted(paths):
 f=Path(name);raw=f.read_bytes();h=sha(raw);row={'actualPath':name,'actualRealpath':str(f.resolve()),'mode':oct(f.lstat().st_mode&0o7777),'symlinkTarget':str(f.readlink()) if f.is_symlink() else None,'bytes':len(raw),'sha256':h}
 if raw.startswith(b'\x7fELF') and name in toolOnly:row['hashOnly']='Installed tool/shared library identity only; not redistributed'
 else:
  obj=L/'objects'/(h+'.gz')
  if not obj.exists():obj.write_bytes(gzip.compress(raw,mtime=0))
  assert gzip.decompress(obj.read_bytes())==raw;row.update(object='objects/'+obj.name,objectSHA256=sha(obj.read_bytes()))
 rows.append(row)
record={'scope':'Runtime Lifecycle LC2 Array-buffer lossless correctness only; eleven selected current PASS roles, one selected Health1024JS INCOMPLETE five-second ordinary role, six separately scoped primitive-control roles and separately status-aware historical attempts/diagnostics. Complete selected outputs retain full independent LC2 oracles; incomplete Health1024JS retains exact partial prefix and both original actual01/actual02 timeouts. Full15second profile completion is diagnostic-only, not acceptance. Whole strict LC2/LC1/verbose evidence is separately retained, not normalization. Parent21 qualification remains open. No timing/numeric qualification. GeneratedJS/ELF64 producers reused unchanged at256/1024; actual worktree paths retained.','protectedGateReuse':json.loads(Path('/tmp/lifecycle-array-protected-affinity.json').read_text()),'selectedSources':{'motion':'c790b0e900e25e107a3f7fdd5e230786375de1bb','health':'a7ad536c46cb3c620644795a36aaf50c458bcf95'},'current':current,'selectedIncomplete':incomplete,'controls':controls,'history':history,'members':rows,'objects':len(list((L/'objects').iterdir())),'coreBodies':{'compose':'9aa35fb6205b3b75a0ee5f97497d8ee6b7472e249266820c93d53928790520e0','lifecycle':'bb2f17e628995ce1c5f33ce734a2627f98b5c31a016e3ee2a686bab6ed84ccc5'}}
(L/'RETENTION.json').write_text(json.dumps(record,indent=2)+'\n');shutil.copyfile(__file__,L/'retain.py.source');print(len(current),len(incomplete),len(controls),len(history),len(rows),record['objects'])
