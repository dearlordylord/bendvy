from pathlib import Path
import json,gzip,hashlib,shutil,os
D=Path('/tmp/bendvy-lifecycle-tx-peaks/experiments/s-perf/canonical-api-v1/lifecycle-runtime-v1/diagnostics/tx-peaks-v1');L=D/'results/family01';assert not L.exists();(L/'objects').mkdir(parents=True);sha=lambda b:hashlib.sha256(b).hexdigest();versions={};tools=set();cases=[]
def pin(name,h):
 p=Path(name);raw=p.read_bytes()
 assert sha(raw)==h,(name,h)
 versions[(name,h)]=None
for kind,schema,count in [('normal',s,n) for s in ['motion','health'] for n in [64,256,1024]]+[('mutant','motion',64)]:
 for role in ['js','native']:
  q=(Path(f'/tmp/bendvy21-lifecycle-tx-peaks-{schema}{count}-actual01/normal')/role if kind=='normal' else Path('/tmp/bendvy21-lifecycle-tx-peaks-counter-mutant-actual01')/role);p=json.loads((q/'plan.json').read_text());r=json.loads((q/'receipt.json').read_text());assert r['planSHA256']==sha((q/'plan.json').read_bytes());cases.append({'directory':str(q),'kind':kind,'schema':schema,'count':count,'role':role,'planSHA256':r['planSHA256'],'receiptSHA256':sha((q/'receipt.json').read_bytes())})
  for name,h in p['pins'].items():pin(name,h)
  for root,files in p['resourceRoots'].items():
   for name,h in files.items():path=str(Path(root)/name);pin(path,h);tools.add(path)
  tools.update(p['tools'].values())
  for g in r['guards']:
   pin(g['path'],g['sha256']);guard=json.loads(Path(g['path']).read_text());assert guard['unchanged']
   for name,h in guard['actualPins'].items():pin(name,h)
  for c in r['commands']:
   for key in ['stdout','stderr']:v=c[key];pin(v['path'],v['sha256']);assert Path(v['path']).stat().st_size==v['bytes']
  for f in q.iterdir():
   if f.is_file():pin(str(f),sha(f.read_bytes()))
for f in [D/'checks/verify-counter-exact.py',D/'checks/COUNTER-EXACT.json']:pin(str(f),sha(f.read_bytes()))
for f in [Path(__file__),Path('/tmp/verify21-lifecycle-tx-family.py')]:pin(str(f),sha(f.read_bytes()))
rows=[]
for (name,h) in sorted(versions):
 raw=Path(name).read_bytes();assert sha(raw)==h
 p=Path(name);row={'actualPath':name,'actualRealpath':str(p.resolve()),'bytes':len(raw),'sha256':h}
 if raw.startswith(b'\x7fELF') and name in tools:row['hashOnly']='Installed tool/shared library identity only; not redistributed'
 else:
  obj=L/'objects'/(h+'.gz')
  if not obj.exists():obj.write_bytes(gzip.compress(raw,mtime=0))
  row.update(object=os.path.relpath(obj,L),objectSHA256=sha(obj.read_bytes()))
 rows.append(row)
record={'scope':'Lifecycle finite grouped terminal Tx counts: twelve normal full LC2+actual130metric PASS cases and two fresh compiling reporter defects retaining full normal LC2 while metric oracle rejects. Bootstrap then Local-owner grouped order is not chronological. Select creates real read-only Tx; no NoTx or full after-every-append occupancy-method qualification claim. No allocation/RSS/timing/lifecycle stamps/universal claim.','cases':cases,'members':rows,'objects':len(list((L/'objects').iterdir()))};(L/'RETENTION.json').write_text(json.dumps(record,indent=2)+'\n');shutil.copyfile(__file__,L/'retain.py.source');shutil.copyfile('/tmp/verify21-lifecycle-tx-family.py',L/'verify.py');print(len(rows),record['objects'])
