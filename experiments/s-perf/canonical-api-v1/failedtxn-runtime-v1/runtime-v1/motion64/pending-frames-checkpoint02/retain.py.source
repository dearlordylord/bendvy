# Adapted existing FailedTxn stream/Health retention pattern; same content-addressed gzip objects.
from pathlib import Path
import json,gzip,hashlib,shutil,subprocess

def main():
    WT=Path('/tmp/bendvy-failedtxn-pending-frames');REL=Path('experiments/s-perf/canonical-api-v1/failedtxn-runtime-v1');D=WT/REL;L=D/'runtime-v1/motion64/pending-frames-checkpoint02';assert not L.exists();(L/'objects').mkdir(parents=True)
    sha=lambda b:hashlib.sha256(b).hexdigest();paths=set();versions={};digests={};toolOnly=set();current=[];history=[];diagnostics=[];seenPlans=set()
    def digest(p):
     p=Path(p)
     if str(p) not in digests:digests[str(p)]=sha(p.read_bytes())
     return digests[str(p)]
    def pin(path,h):
     path=str(path);p=Path(path);assert p.exists(),path;paths.add(path)
     if digest(p)==h:return
     key=(path,h)
     if key in versions:return
     repo=Path(subprocess.check_output(['git','-c','gc.auto=0','-C',str(p.parent),'rev-parse','--show-toplevel'],text=True).strip());rel=str(p.relative_to(repo));found=None
     for commit in subprocess.check_output(['git','-c','gc.auto=0','-C',str(repo),'log','--all','--format=%H','--',rel],text=True).splitlines():
      raw=subprocess.check_output(['git','-c','gc.auto=0','-C',str(repo),'show',commit+':'+rel])
      if sha(raw)==h:found=raw;break
     assert found is not None,('unrecoverable historical pin',path,h)
     versions[key]=found

    def capture(d,category='history',planPath=None):
     d=Path(d);planPath=Path(planPath or d/'plan.json')
     if str(planPath) in seenPlans:return
     seenPlans.add(str(planPath));paths.add(str(planPath));p=json.loads(planPath.read_text());rp=d/'receipt.json'
     if category in ['ordinary64','ordinary256','control']:assert rp.exists(),'selected receipt required'
     for n,h in p['pins'].items():pin(n,h)
     for root,files in p['resourceRoots'].items():
      for n,h in files.items():q=str(Path(root)/n);pin(q,h);toolOnly.add(q)
     toolOnly.update(x for x in p['tools'].values() if not x.endswith('.native') and not x.startswith('/tmp/bendvy21-'))
     rec={'actualDirectory':str(d),'planPath':str(planPath),'planSHA256':digest(planPath),'category':category,'status':'UNEXECUTED'}
     if rp.exists():
      r=json.loads(rp.read_text());assert r['planSHA256']==rec['planSHA256'],(rp,'mismatchedreceipt');rec.update(status=r['status'],receiptSHA256=digest(rp),commands=[],guardFailures=r.get('guardFailures'),error=r.get('error'))
      for g in r.get('guards',[]):
       pin(g['path'],g['sha256']);guard=json.loads(Path(g['path']).read_text());assert guard['unchanged']
       for n,h in guard['actualPins'].items():pin(n,h)
      expected={c['label']:c for c in p['commands']}
      for c in r['commands']:
       e=expected.get(c['label'])
       if e:
        for k in ['label','argv','capSeconds']:assert c[k]==e[k]
       else:assert c['label'].startswith('library-probe-'),c['label']
       for k in ['stdout','stderr']:
        v=c[k];pin(v['path'],v['sha256']);assert Path(v['path']).stat().st_size==v['bytes']
       rec['commands'].append({k:c[k] for k in ['label','exit','failure']})
      if category in ['ordinary64','ordinary256','control']:
       assert r['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS';assert len(r['commands'])==len(p['commands']);assert all(c['exit']==0 and c['failure'] is None for c in r['commands']);raw=(d/'consumer.stdout').read_bytes();assert raw==gzip.decompress(Path(p['oracle']).read_bytes());assert (d/'consumer.stderr').read_bytes()==b'';rec.update(bytes=len(raw),sha256=sha(raw))
      if category=='ordinary256-incomplete':assert r['status']=='INCOMPLETE' and r['commands'][-1]['failure']=='child deadline' and p['commands'][-1]['capSeconds']==5
      if category=='diagnostic-full15':
       assert p['diagnostic']['acceptanceCapSeconds']==5 and p['diagnostic']['diagnosticCapSeconds']==15;assert r['commands'][-1]['exit']==0 and r['commands'][-1]['failure'] is None;raw=Path(r['commands'][-1]['stdout']['path']).read_bytes();assert raw==gzip.decompress(Path(p['oracle']).read_bytes());assert Path(r['commands'][-1]['stderr']['path']).read_bytes()==b'';rec.update(bytes=len(raw),sha256=sha(raw),qualification='DIAGNOSTIC_ONLY; acceptance5 UNMET')
      if category in ['diagnostic-heap','semantic-mutant']:
       assert len(r['commands'])==len(p['commands']) and all(c['exit']==0 and c['failure'] is None for c in r['commands'])
       c=r['commands'][0] if category=='diagnostic-heap' else r['commands'][-1]
       subject=Path(c['stdout']['path']).read_bytes();oracle=gzip.decompress(Path(p['oracle']).read_bytes())
       assert Path(c['stderr']['path']).read_bytes()==b''
       if category=='diagnostic-heap':assert subject==oracle and p['commands'][0]['capSeconds']==15
       else:assert subject!=oracle and r['status']=='INCOMPLETE'
       rec.update(bytes=len(subject),sha256=sha(subject),qualification='DIAGNOSTIC_ONLY' if category=='diagnostic-heap' else 'INTENDED_ORACLE_MISMATCH; child succeeded')
     for f in d.rglob('*'):
      if f.is_file():paths.add(str(f))
     (current if category in ['ordinary64','ordinary256','control'] else diagnostics if category.startswith('diagnostic') else history).append(rec)
     print('captured',category,str(d),rec['status'],flush=True)
    for role in ['js','native']:
     capture(Path('/tmp/bendvy21-canonical-failedtxn-pending-frames-motion64-actual01/normal')/role,'ordinary64')
     for name in ['text','affine']:
      capture(Path('/tmp/bendvy21-failedtxn-pending-frames-'+name+'-control-actual01/normal')/role,'control')
    capture(Path('/tmp/bendvy21-canonical-failedtxn-pending-frames-motion256-actual01/normal/js'),'ordinary256-incomplete')
    capture(Path('/tmp/bendvy21-canonical-failedtxn-pending-frames-motion256-actual01/normal/native'),'ordinary256')
    for wt,prefix in [('/tmp/bendvy-failedtxn-indexed-type-observation','indexed-type-observation'),(str(WT),'pending-frames')]:
     base=Path(wt)/REL/'diagnostics'
     capture(base/('full-coverage-'+prefix+'-js-v1'),'diagnostic-full15')
     capture(base/('allocation-sampling-'+prefix+'-v1')/'subject','diagnostic-heap')
     for suffix in ['full-coverage-js','allocation']:
      q=Path('/tmp/bendvy21-failedtxn-'+prefix+'-'+suffix+'-diagnostic01')
      for f in q.rglob('*'):
       if f.is_file():paths.add(str(f))
    for prefix in ['whole-fit','stream-chunks','direct-drain','leaf-fusion','concat-identity','field-writer','query-lazy','current-doc','direct-show','indexed-observation','indexed-type-observation']:
     for root in sorted(Path('/tmp').glob('bendvy21-canonical-failedtxn-'+prefix+'-*actual*')):
      for q in root.rglob('plan.json'):capture(q.parent)
    for root in [Path('/tmp/bendvy21-failedtxn-indexed-maybe-affine-control-actual01')]:
     for q in root.rglob('plan.json'):capture(q.parent)
    # Both reached semantic controls retain their successful child/oracle-mismatch records.
    mutant1=Path('/tmp/bendvy-query-lazy-inspection-control')/REL/'controls/lazy-inspection-family-control-v1'
    capture(mutant1,planPath=mutant1/'ordinary-motion64-js-plan.json')
    capture(mutant1/'attempt02','semantic-mutant',mutant1/'attempt02/ordinary-motion64-js-plan.json')
    mutant2=Path('/tmp/bendvy-failedtxn-optional-scan-mutant')/REL/'controls/indexed-maybe-affine-v1/control-plans/optional-scan-mutant02/normal/js'
    capture(mutant2,'semantic-mutant')
    # The existing public authority controls are source/type checks, not runtime qualification.
    for label in ['01','02','03']:
     q=Path('/tmp/bendvy21-query-lazy-authority-current'+label)
     if q.exists():
      for f in q.rglob('*'):
       if f.is_file():paths.add(str(f))
    authority=Path('/tmp/bendvy21-query-lazy-authority-current03')
    pre=json.loads((authority/'SOURCE-PRE.json').read_text());post=json.loads((authority/'SOURCE-POST.json').read_text());assert pre==post
    for n,h in pre.items():
     pin(n,h)
     if n.startswith(('/bin/','/usr/bin/','/home/node/.bend/bin/')):toolOnly.add(n)
    intended=Path('/workspace/formal-proofs/bendvy/experiments/public-inspect/debug-study-v1/production-adoption-v1/canonical-observable-api-v1/source-final-01/intended-diagnostics.json');paths.add(str(intended))
    for name in ['src/ecs/ordinary-query-observable.bend','experiments/public-inspect/ordinary-declaration-v1/caller.bend','experiments/public-inspect/ordinary-declaration-v1/automatic-app-observation-v1/app-filter-mutant.bend']:
     f=WT/name;assert f.exists();paths.add(str(f))
    # Existing portable predecessor packets linked by immutable manifest identity, not recopied.
    links=[]
    for wt,suffix,commit in [('/workspace/formal-proofs/bendvy','runtime-v1/motion64/known-length-checkpoint01/RETENTION.json','588275b95d0240735998f8e46a86b75a248ccbdf')]:
     p=Path(wt)/REL/suffix;assert p.exists();paths.add(str(p));links.append({'commit':commit,'manifest':str(p),'sha256':digest(p),'scope':'Already delivered portable predecessor; content not duplicated here'})

    paths.update(str(f) for f in (D/'runtime-v1/motion64/pending-frames-checkpoint01').rglob('*') if f.is_file());paths.add(str(Path(__file__)));rows=[]
    for name in sorted(paths):
     f=Path(name);raw=f.read_bytes();h=sha(raw);row={'actualPath':name,'actualRealpath':str(f.resolve()),'mode':oct(f.lstat().st_mode&0o7777),'symlinkTarget':str(f.readlink()) if f.is_symlink() else None,'bytes':len(raw),'sha256':h}
     if raw.startswith(b'\x7fELF') and name in toolOnly:row['hashOnly']='Installed tool/sharedlibrary identity only; not redistributed'
     else:
      obj=L/'objects'/(h+'.gz')
      if not obj.exists():obj.write_bytes(gzip.compress(raw,compresslevel=6,mtime=0))
      assert gzip.decompress(obj.read_bytes())==raw;row.update(object='objects/'+obj.name,objectSHA256=sha(obj.read_bytes()))
     rows.append(row)
    for (name,h),raw in versions.items():
     obj=L/'objects'/(h+'.gz')
     if not obj.exists():obj.write_bytes(gzip.compress(raw,compresslevel=6,mtime=0))
     assert gzip.decompress(obj.read_bytes())==raw;rows.append({'actualPath':name,'sha256':h,'bytes':len(raw),'historicalGitRecovered':True,'object':'objects/'+obj.name,'objectSHA256':sha(obj.read_bytes())})
    rec={'scope':'Selected PendingFrames correctness checkpoint: ordinary64both, text/affine controlsboth and Native256 PASS; JS256 five-second INCOMPLETE. Full CPU/heap fifteen-second diagnostics and Type-before comparison retained separately. Public lazy query Type/authority checks and reached mutants retained. Not full #21, JS deadline qualification, comparative speed or final numeric acceptance.','sourceCommit':'7011ec9ee43eb3f5d730ec871429d525d82c9eef','current':current,'history':history,'diagnostics':diagnostics,'predecessorPackets':links,'members':rows,'objects':len(list((L/'objects').iterdir())),'historicalMetadataVersions':len(versions)}
    (L/'RETENTION.json').write_text(json.dumps(rec,indent=2)+'\n');shutil.copyfile(__file__,L/'retain.py.source');print('SEALED',len(current),len(history),len(diagnostics),len(rows),rec['objects'],sha((L/'RETENTION.json').read_bytes()),flush=True)

if __name__ == "__main__":
    main()
