from pathlib import Path
import json,gzip,hashlib,shutil,subprocess
WT=Path('/tmp/bendvy-failedtxn-row-json');D=WT/'experiments/s-perf/canonical-api-v1/failedtxn-runtime-v1';L=D/'runtime-v1/motion64/row-json-actual01';assert not L.exists();(L/'objects').mkdir(parents=True)
sha=lambda b:hashlib.sha256(b).hexdigest();paths=set();toolOnly=set();current=[];history=[]
def pin(path,h):
 p=Path(path);assert sha(p.read_bytes())==h,path;paths.add(str(p))
def capture(d,isCurrent):
 p=json.loads((d/'plan.json').read_text());rp=d/'receipt.json'
 if isCurrent:assert rp.exists(), 'selected receipt required'
 for name,h in p['pins'].items():pin(name,h)
 for root,files in p['resourceRoots'].items():
  for name,h in files.items():q=str(Path(root)/name);pin(q,h);toolOnly.add(q)
 toolOnly.update(p['tools'].values())
 record={'actualDirectory':str(d),'planSHA256':sha((d/'plan.json').read_bytes()),'status':'UNEXECUTED'}
 if rp.exists():
  r=json.loads(rp.read_text());assert r['planSHA256']==record['planSHA256'];record.update(status=r['status'],receiptSHA256=sha(rp.read_bytes()),commands=[])
  for g in r['guards']:
   pin(g['path'],g['sha256']);guard=json.loads(Path(g['path']).read_text());assert guard['unchanged']
   for name,h in guard['actualPins'].items():pin(name,h)
  for c,e in zip(r['commands'],p['commands']):
   for k in ['label','argv','capSeconds']:assert c[k]==e[k]
   for k in ['stdout','stderr']:
    v=c[k];pin(v['path'],v['sha256']);assert Path(v['path']).stat().st_size==v['bytes']
   record['commands'].append({k:c[k] for k in ['label','exit','failure']})
  if isCurrent:
   assert r['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS';assert len(r['commands'])==len(p['commands']);assert all(c['exit']==0 and c['failure'] is None for c in r['commands'])
   raw=(d/'consumer.stdout').read_bytes();assert raw==gzip.decompress(Path(p['oracle']).read_bytes());assert (d/'consumer.stderr').read_bytes()==b'';record.update(bytes=len(raw),sha256=sha(raw))
 for f in d.rglob('*'):
  if f.is_file():paths.add(str(f))
 (current if isCurrent else history).append(record)
for count in ['64','256']:
 for role in ['js','native']:capture(Path(f'/tmp/bendvy21-canonical-failedtxn-row-json-motion{count}-actual01/normal/{role}'),True)
paths.add(str(Path(__file__)));paths.add('/tmp/verify21-row-json-selected.py');rows=[]
for name in sorted(paths):
 f=Path(name);raw=f.read_bytes();h=sha(raw);row={'actualPath':name,'actualRealpath':str(f.resolve()),'mode':oct(f.lstat().st_mode&0o7777),'symlinkTarget':str(f.readlink()) if f.is_symlink() else None,'bytes':len(raw),'sha256':h}
 if raw.startswith(b'\x7fELF') and name in toolOnly:row['hashOnly']='Installed tool/shared library identity only; not redistributed'
 else:
  obj=L/'objects'/(h+'.gz')
  if not obj.exists():obj.write_bytes(gzip.compress(raw,mtime=0))
  assert gzip.decompress(obj.read_bytes())==raw;row.update(object='objects/'+obj.name,objectSHA256=sha(obj.read_bytes()))
 rows.append(row)
record={'scope':'Selected RowJSON Motion64 and Motion256 complete stock JS/Native correctness roles under unchanged five-second consumer caps; all commands exit0/full independent bytes and emptyerrors. Minimal current evidence only; predecessor history/profiles remain in prior packets and source-bound originals. No1024 result or comparative timing claim.','current':current,'history':history,'members':rows,'objects':len(list((L/'objects').iterdir())),'coreBodies':{'compose':'9aa35fb6205b3b75a0ee5f97497d8ee6b7472e249266820c93d53928790520e0','lifecycle':'bb2f17e628995ce1c5f33ce734a2627f98b5c31a016e3ee2a686bab6ed84ccc5'}}
(L/'RETENTION.json').write_text(json.dumps(record,indent=2)+'\n');shutil.copyfile(__file__,L/'retain.py.source');print(len(current),len(history),len(rows),record['objects'])
