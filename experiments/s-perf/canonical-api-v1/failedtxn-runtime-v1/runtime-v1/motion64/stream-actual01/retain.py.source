from pathlib import Path
import json,gzip,hashlib,shutil,subprocess
WT=Path('/tmp/bendvy-failedtxn-stream-records');D=WT/'experiments/s-perf/canonical-api-v1/failedtxn-runtime-v1';L=D/'runtime-v1/motion64/stream-actual01';assert not L.exists();(L/'objects').mkdir(parents=True)
sha=lambda b:hashlib.sha256(b).hexdigest();paths=set();toolOnly=set();current=[];history=[];recovered={};expectedPins={}
def pin(path,h):
 p=Path(path);expectedPins[path]=h
 if sha(p.read_bytes())!=h:
  repo=Path(subprocess.check_output(['git','-C',str(p.parent),'rev-parse','--show-toplevel'],text=True).strip());rel=str(p.relative_to(repo));found=None
  for commit in subprocess.check_output(['git','-C',str(repo),'log','--all','--format=%H','--',rel],text=True).splitlines():
   raw=subprocess.check_output(['git','-C',str(repo),'show',commit+':'+rel])
   if sha(raw)==h:found=raw;break
  assert found is not None,('unrecoverable historical pin',path,h)
  recovered[path]=found
 paths.add(str(p))
def capture(d,isCurrent):
 p=json.loads((d/'plan.json').read_text());rp=d/'receipt.json'
 if isCurrent:assert rp.exists(), 'selected receipt required'
 for name,h in p['pins'].items():pin(name,h)
 for root,files in p['resourceRoots'].items():
  for name,h in files.items():q=str(Path(root)/name);pin(q,h);toolOnly.add(q)
 toolOnly.update(p['tools'].values())
 record={'actualDirectory':str(d),'planSHA256':sha((d/'plan.json').read_bytes()),'status':'UNEXECUTED'}
 if rp.exists():
  r=json.loads(rp.read_text());assert r['planSHA256']==record['planSHA256'];record.update(status=r['status'],receiptSHA256=sha(rp.read_bytes()),commands=[])
  for g in r['guards']:
   pin(g['path'],g['sha256']);guard=json.loads(Path(g['path']).read_text());assert guard['unchanged']
   for name,h in guard['actualPins'].items():pin(name,h)
  for c,e in zip(r['commands'],p['commands']):
   for k in ['label','argv','capSeconds']:assert c[k]==e[k]
   for k in ['stdout','stderr']:
    v=c[k];pin(v['path'],v['sha256']);assert Path(v['path']).stat().st_size==v['bytes']
   record['commands'].append({k:c[k] for k in ['label','exit','failure']})
  if isCurrent:
   assert r['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS';assert len(r['commands'])==len(p['commands']);assert all(c['exit']==0 and c['failure'] is None for c in r['commands'])
   raw=(d/'consumer.stdout').read_bytes();assert raw==gzip.decompress(Path(p['oracle']).read_bytes());assert (d/'consumer.stderr').read_bytes()==b'';record.update(bytes=len(raw),sha256=sha(raw))
 for f in d.rglob('*'):
  if f.is_file():paths.add(str(f))
 (current if isCurrent else history).append(record)
for role in ['js','native']:capture(Path(f'/tmp/bendvy21-canonical-failedtxn-stream-motion64-actual01/normal/{role}'),True)
for attempt in ['actual01','actual02']:
 for role in ['js','native']:capture(Path(f'/tmp/bendvy21-canonical-failedtxn-motion64-{attempt}/normal/{role}'),False)
paths.add('/tmp/bendvy21-canonical-failedtxn-motion64-actual01/preflight-rejection.json')
comparison=Path('/tmp/bendvy21-canonical-failedtxn-motion64-actual02/normal/js/source-corrected-oracle-comparison.json');paths.add(str(comparison))
small=Path('/tmp/bendvy-canonical-failedtxn/experiments/s-perf/canonical-api-v1/failedtxn-runtime-v1/controls/service-request-v1/runtime-v1/actual-attempt01/RETENTION.json');paths.add(str(small))
paths.add(str(Path(__file__)));rows=[]
for name in sorted(paths):
 f=Path(name);raw=recovered.get(name,f.read_bytes());h=sha(raw);row={'actualPath':name,'actualRealpath':str(f.resolve()),'mode':oct(f.lstat().st_mode&0o7777),'symlinkTarget':str(f.readlink()) if f.is_symlink() else None,'bytes':len(raw),'sha256':h}
 if name in recovered:row['historicalGitRecovered']=True;row['currentPathSHA256']=sha(f.read_bytes())
 if raw.startswith(b'\x7fELF') and name in toolOnly:row['hashOnly']='Installed tool/shared library identity only; not redistributed'
 else:
  obj=L/'objects'/(h+'.gz')
  if not obj.exists():obj.write_bytes(gzip.compress(raw,mtime=0))
  assert gzip.decompress(obj.read_bytes())==raw;row.update(object='objects/'+obj.name,objectSHA256=sha(obj.read_bytes()))
 rows.append(row)
record={'scope':'First Motion64 FailedTxn streamed pair full PASS. Original actual01 was preflight metadata rejection with zero child commands; original actual02 JS completed output mismatched incorrect model, later exact source-corrected comparison retained; Native original childdeadline incomplete. Historical receipt statuses unchanged. Small service control linked by retained RETENTION manifest; no wider or numeric qualification.','current':current,'history':history,'members':rows,'objects':len(list((L/'objects').iterdir())),'serviceControlBinding':{'commit':'8c72e5a647345f5c682147185e86a10613110368','manifest':str(small),'sha256':sha(small.read_bytes())},'historicalMetadataRecoveryCount':len(recovered),'coreBodies':{'compose':'9aa35fb6205b3b75a0ee5f97497d8ee6b7472e249266820c93d53928790520e0','lifecycle':'bb2f17e628995ce1c5f33ce734a2627f98b5c31a016e3ee2a686bab6ed84ccc5'}}
(L/'RETENTION.json').write_text(json.dumps(record,indent=2)+'\n');shutil.copyfile(__file__,L/'retain.py.source');print(len(current),len(history),len(rows),record['objects'])
