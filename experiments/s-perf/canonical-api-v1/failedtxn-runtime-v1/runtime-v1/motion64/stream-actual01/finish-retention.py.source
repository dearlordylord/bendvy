from pathlib import Path
import json,gzip,hashlib
b=Path('/tmp/bendvy-failedtxn-stream-records/experiments/s-perf/canonical-api-v1/failedtxn-runtime-v1/runtime-v1/motion64/stream-actual01');p=b/'RETENTION.json';d=json.loads(p.read_text());sha=lambda x:hashlib.sha256(x).hexdigest()
for row in list(d['members']):
 if row.get('historicalGitRecovered'):
  f=Path(row['actualPath']);raw=f.read_bytes();h=sha(raw);obj=b/'objects'/(h+'.gz')
  if not obj.exists():obj.write_bytes(gzip.compress(raw,mtime=0))
  r={k:v for k,v in row.items() if k not in ['historicalGitRecovered','currentPathSHA256']};r.update(bytes=len(raw),sha256=h,object='objects/'+obj.name,objectSHA256=sha(obj.read_bytes()),versionScope='Current successor metadata; historical Git bytes retained as separate same-path member')
  d['members'].append(r)
for r in d['history']:
 if 'actual01/' in r['actualDirectory']:r['classification']='Preflight metadata rejection, zero child commands; Native plan unexecuted'
 elif r['actualDirectory'].endswith('/js'):r['classification']='Original incorrect-oracle INCOMPLETE; actual zero-exit full JS later matches independent corrected model; comparison retained'
 else:r['classification']='Ordinary Native childdeadline5 INCOMPLETE; partial exact prefix only'
