from pathlib import Path
import json,gzip,hashlib
b=Path('/tmp/bendvy-failedtxn-stream-records/experiments/s-perf/canonical-api-v1/failedtxn-runtime-v1/runtime-v1/motion64/stream-actual01');d=json.loads((b/'RETENTION.json').read_text());sha=lambda x:hashlib.sha256(x).hexdigest();pairs={(r['actualPath'],r['sha256']) for r in d['members']};seen=set();loss=0
for r in d['members']:
 if 'object' not in r:assert sha(Path(r['actualPath']).read_bytes())==r['sha256'];continue
 loss+=1
 if r['object'] in seen:continue
 seen.add(r['object']);p=b/r['object'];assert sha(p.read_bytes())==r['objectSHA256'];h=hashlib.sha256();n=0
 with gzip.open(p,'rb') as f:
  while data:=f.read(1048576):h.update(data);n+=len(data)
 assert h.hexdigest()==r['sha256'] and n==r['bytes'],r['actualPath']
for actual in d['current']+d['history']:
 q=Path(actual['actualDirectory']);p=json.loads((q/'plan.json').read_text());assert all((k,v) in pairs for k,v in p['pins'].items())
 if (q/'receipt.json').exists():
  r=json.loads((q/'receipt.json').read_text());assert r['planSHA256']==sha((q/'plan.json').read_bytes())
  for g in r['guards']:
   v=json.loads(Path(g['path']).read_text());assert v['unchanged'];assert all((k,h) in pairs for k,h in v['actualPins'].items())
for r in d['current']:assert r['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS' and r['bytes']==38459780
print('PASS',len(d['members']),loss,len(seen),'objects',d['objects'],'current',len(d['current']),'history',len(d['history']),'manifest',sha((b/'RETENTION.json').read_bytes()))
