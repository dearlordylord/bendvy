from pathlib import Path
import sys,io,gzip,json,hashlib
w=Path('/tmp/bendvy-failedtxn-matched-method');d=w/'experiments/s-perf/canonical-api-v1/failedtxn-runtime-v1/diagnostics/matched-timing-v1/model';sys.path.insert(0,str(d));import common_model as C
M=C.M;M.Model=C.Observer;tmp=d/'observer-tmp';tmp.mkdir(exist_ok=True);realPath=Path;M.Path=lambda v:tmp/realPath(v).name if str(v).startswith('/tmp/failedtxn-oracle-ns-')else realPath(v)
chunks=[];fixtures=[]
for label,ns in [('warmup',1),('measured',2)]:
 stream=io.StringIO();stream.write(label+'={');m,spool=M.setup_output(M.World(ns),64,64,stream)
 for i in range(64):M.do_iteration(m,i)
 M.write_state('',m,stream,boundaries=spool);stream.write('}\n');spool.unlink();chunks.append(stream.getvalue().encode());records=m.completed();cells=C.tuple_records(records);fold=0
 for v in cells:fold=(fold*33+v)%2**32
 fixtures.append({'role':label,'namespace':ns,'records':records,'rawActorMap':m.raw_map(),'tuple':cells,'fold':fold,'callbacks':len(m.callback_records),'publications':len(m.publication_records),'boundaries':len(m.boundary_records),'phases':len(m.phase_records)})
raw=b''.join(chunks);old=gzip.decompress((w/'experiments/s-perf/canonical-api-oracle-v1/failedtxn-runtime-v1/motion64/expected.stdout.gz').read_bytes());assert raw==old
assert fixtures[0]['tuple']==fixtures[1]['tuple']
(d/'observer-fixtures.json.gz').write_bytes(gzip.compress(json.dumps(fixtures,separators=(',',':')).encode(),mtime=0));print(json.dumps({'canonicalBytes':len(raw),'canonicalSHA256':hashlib.sha256(raw).hexdigest(),'records':len(fixtures[0]['records']),'tupleValues':len(fixtures[0]['tuple']),'fold':fixtures[0]['fold'],'callbacks':fixtures[0]['callbacks'],'publications':fixtures[0]['publications'],'boundaries':fixtures[0]['boundaries'],'phases':fixtures[0]['phases'],'actorCount':len(fixtures[0]['rawActorMap'])}))
