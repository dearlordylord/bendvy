from pathlib import Path
import json,gzip,hashlib,shutil,subprocess,os
WT=Path('/tmp/bendvy-readers-ordinary-app');D=WT/'experiments/s-perf/canonical-api-v1/readers-runtime-v1';L=D/'runtime-v1/ordinary-family-attempt01';PREVIOUS=D/'runtime-v1/motion64/row-json-actual01';SECOND=D/'runtime-v1/motion1024/row-json-attempt01';assert not L.exists();(L/'objects').mkdir(parents=True)
sha=lambda b:hashlib.sha256(b).hexdigest();paths=set();toolOnly=set();current=[];history=[];reused=[]
def pin(path,h):
 p=Path(path);assert sha(p.read_bytes())==h,path;paths.add(str(p))
def capture(d,isCurrent,reuse=False):
 drift=json.loads((D/"checks/ordinary-app-v1/CONTROL-APPLICABILITY.json").read_text())["records"][0]["policyDrift"][0]
 def sourcepin(path,h):
  if reuse and path==drift["path"]:
   assert h==drift["expectedHistoricalSHA256"];pin(drift["historicalSourceSnapshot"],h)
  else:pin(path,h)
 p=json.loads((d/'plan.json').read_text());rp=d/'receipt.json'
 if isCurrent:assert rp.exists(), 'selected receipt required'
 for name,h in p['pins'].items():sourcepin(name,h)
 for root,files in p['resourceRoots'].items():
  for name,h in files.items():q=str(Path(root)/name);pin(q,h);toolOnly.add(q)
 toolOnly.update(p['tools'].values())
 record={'actualDirectory':str(d),'planSHA256':sha((d/'plan.json').read_bytes()),'status':'UNEXECUTED'}
 if rp.exists():
  r=json.loads(rp.read_text());assert r['planSHA256']==record['planSHA256'];record.update(status=r['status'],receiptSHA256=sha(rp.read_bytes()),commands=[])
  for g in r['guards']:
   pin(g['path'],g['sha256']);guard=json.loads(Path(g['path']).read_text());assert guard['unchanged']
   for name,h in guard['actualPins'].items():sourcepin(name,h)
  for c,e in zip(r['commands'],p['commands']):
   for k in ['label','argv','capSeconds']:assert c[k]==e[k]
   for k in ['stdout','stderr']:
    v=c[k];pin(v['path'],v['sha256']);assert Path(v['path']).stat().st_size==v['bytes']
   record['commands'].append({k:c[k] for k in ['label','exit','failure']})
  if isCurrent or reuse:
   assert r['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS';assert len(r['commands'])==len(p['commands']);assert all(c['exit']==0 and c['failure'] is None for c in r['commands'])
   raw=(d/'consumer.stdout').read_bytes();assert raw==gzip.decompress(Path(p['oracle']).read_bytes());assert (d/'consumer.stderr').read_bytes()==b'';record.update(bytes=len(raw),sha256=sha(raw))
 for f in d.rglob('*'):
  if f.is_file():paths.add(str(f))
 (reused if reuse else current if isCurrent else history).append(record)
for schema in ['motion','health']:
 for count in [64,256,1024]:
  for role in ['js','native']:
   attempt='02' if schema=='motion' and count==64 and role=='native' else '01'
   capture(Path(f'/tmp/bendvy21-canonical-readers-ordinary-app-{schema}{count}-actual{attempt}/normal')/role,True)
capture(Path('/tmp/bendvy21-canonical-readers-ordinary-app-motion64-actual01/normal/native'),False)
for a in json.loads((D/'checks/ordinary-app-v1/CONTROL-APPLICABILITY.json').read_text())['records']:
 capture(Path(a['plan']).parent,False,True)
 for name,h in a['sourceInventory'].items():pin(name,h)
for helper in ['prepare21-readers-ordinary-motion64-01.py','prepare21-readers-ordinary-motion64-native02.py','prepare21-readers-ordinary-health64-01.py','prepare21-readers-ordinary-largers01.py','readers-controls-applicability.py']:paths.add('/tmp/'+helper)
for name,h in json.loads((D/'checks/ordinary-app-v1/MODEL-CONTROL-APPLICABILITY.json').read_text())['pins'].items():pin(name,h)
for extra in [D/'checks/ordinary-app-v1',D/'checks/ordinary-health-v1']:
 for f in extra.rglob('*'):
  if f.is_file():paths.add(str(f))
paths.add(str(Path(__file__)));paths.add('/tmp/verify21-readers-ordinary-family.py');rows=[]
for name in sorted(paths):
 f=Path(name);raw=f.read_bytes();h=sha(raw);row={'actualPath':name,'actualRealpath':str(f.resolve()),'mode':oct(f.lstat().st_mode&0o7777),'symlinkTarget':str(f.readlink()) if f.is_symlink() else None,'bytes':len(raw),'sha256':h}
 if raw.startswith(b'\x7fELF') and name in toolOnly:row['hashOnly']='Installed tool/shared library identity only; not redistributed'
 else:
  obj=L/'objects'/(h+'.gz')
  if not obj.exists():obj.write_bytes(gzip.compress(raw,mtime=0))
  assert gzip.decompress(obj.read_bytes())==raw;row.update(object=os.path.relpath(obj,L),objectSHA256=sha(obj.read_bytes()))
 rows.append(row)
record={'sourceCommit':'00d3813d5','motionSourceCommit':'f44a2fc509be0908e290aba7cb1a8415b3c27f5c','freezeCommit':'4b1a08a734d06efc611ec9c7a1891c1cbe3b84d9','scope':'Readers ordinary App both genuine schemas,64/256/1024,JS/Native full independent correctness. Current source preserves affine registrations, separate fast/slow cursors, both barriers, domain work and original observation construction. Single fresh namespace1 world/no warmup/twoLF. No comparative timing or full#21 acceptance. Historical Native emitter30 timeout retained; successor emitter60. Reused affine controls narrowly qualify unchanged63-source observer semantics, not current App or full old admission set; nonoperative wrapper policy drift explicit in applicability.','current':current,'history':history,'reusedSemanticControls':reused,'members':rows,'objects':len(list((L/'objects').iterdir())),'objectDependencies':[],'referencedObjects':0}
(L/'RETENTION.json').write_text(json.dumps(record,indent=2)+'\n');shutil.copyfile(__file__,L/'retain.py.source');shutil.copyfile('/tmp/verify21-readers-ordinary-family.py',L/'verify.py');print(len(current),len(history),len(rows),record['objects'])
