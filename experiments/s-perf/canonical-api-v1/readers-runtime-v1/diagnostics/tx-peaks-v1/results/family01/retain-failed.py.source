from pathlib import Path
import json,gzip,hashlib,shutil,os
D=Path('/tmp/bendvy-readers-tx-peaks/experiments/s-perf/canonical-api-v1/readers-runtime-v1/diagnostics/tx-peaks-v1');L=D/'results/family01';assert not L.exists();(L/'objects').mkdir(parents=True);sha=lambda b:hashlib.sha256(b).hexdigest();versions={};tools=set();cases=[]
def pin(name,h):
 p=Path(name);raw=p.read_bytes()
 assert sha(raw)==h,(name,h)
 versions[(name,h)]=raw
selected=[(schema,n,role,'normal',Path(f'/tmp/bendvy21-readers-tx-peaks-{schema}{n}-actual01/normal')/role) for schema in ['motion','health'] for n in [64,256,1024] for role in ['js','native']]
selected += [('motion',64,role,'counter',Path('/tmp/bendvy21-readers-tx-peaks-counter-mutant-actual01')/role)for role in ['js','native']]
for schema,count,role,kind,directory in selected:
 q=directory;p=json.loads((q/'plan.json').read_text());r=json.loads((q/'receipt.json').read_text());assert r['planSHA256']==sha((q/'plan.json').read_bytes());cases.append({'directory':str(q),'schema':schema,'count':count,'role':role,'kind':kind,'planSHA256':r['planSHA256'],'receiptSHA256':sha((q/'receipt.json').read_bytes())})
 for name,h in p['pins'].items():pin(name,h)
 for root,files in p['resourceRoots'].items():
  for name,h in files.items():path=str(Path(root)/name);pin(path,h);tools.add(path)
 tools.update(p['tools'].values())
 for g in r['guards']:
  pin(g['path'],g['sha256']);guard=json.loads(Path(g['path']).read_text());assert guard['unchanged']
  for name,h in guard['actualPins'].items():pin(name,h)
 for c in r['commands']:
  for key in ['stdout','stderr']:v=c[key];pin(v['path'],v['sha256']);assert Path(v['path']).stat().st_size==v['bytes']
 for f in q.iterdir():
  if f.is_file():pin(str(f),sha(f.read_bytes()))
for f in D.iterdir():
 if f.is_file():pin(str(f),sha(f.read_bytes()))
for f in (D/'checks').iterdir():
 if f.is_file():pin(str(f),sha(f.read_bytes()))
for f in [Path(__file__),Path('/tmp/verify21-readers-tx-family.py')]:pin(str(f),sha(f.read_bytes()))
rows=[]
for (name,h),raw in sorted(versions.items()):
 p=Path(name);row={'actualPath':name,'actualRealpath':str(p.resolve()),'bytes':len(raw),'sha256':h}
 if raw.startswith(b'\x7fELF') and name in tools:row['hashOnly']='Installed tool/shared library identity only; not redistributed'
 else:
  obj=L/'objects'/(h+'.gz')
  if not obj.exists():obj.write_bytes(gzip.compress(raw,mtime=0))
  row.update(object=os.path.relpath(obj,L),objectSHA256=sha(obj.read_bytes()))
 rows.append(row)
record={'scope':'Readers bothschemas/threesizes actual193domain+84reader callback terminal Tx counts;12 complete canonical+sealed metric PASS and2 compiling reporter-only controls with unchangedcanonical/normalmetricREJECT/independentcounterexactMATCH. Finite monotone append applicability only; no aftereveryappend recording, universalpeak, allocation/RSS/timing/full#21 claim.','cases':cases,'members':rows,'objects':len(list((L/'objects').iterdir()))};(L/'RETENTION.json').write_text(json.dumps(record,indent=2)+'\n');shutil.copyfile(__file__,L/'retain.py.source');shutil.copyfile('/tmp/verify21-readers-tx-family.py',L/'verify.py');print(len(rows),record['objects'])
