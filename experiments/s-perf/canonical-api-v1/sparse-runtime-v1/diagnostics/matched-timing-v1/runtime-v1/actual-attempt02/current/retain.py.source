from pathlib import Path
import json,gzip,hashlib,shutil,os
WT=Path('/tmp/bendvy-sparse-matched-method');D=WT/'experiments/s-perf/canonical-api-v1/sparse-runtime-v1/diagnostics/matched-timing-v1';L=D/'runtime-v1/actual-attempt02/current';OUT=Path('/tmp/bendvy21-sparse-motion-b1-method-pilot-actual02');assert not L.exists();(L/'objects').mkdir(parents=True)
sha=lambda b:hashlib.sha256(b).hexdigest();paths=set();toolOnly=set();current=[]
def pin(path,h):
 p=Path(path);assert sha(p.read_bytes())==h,path;paths.add(str(p))
index=json.loads((OUT/'PLAN-INDEX.json').read_text());validation=json.loads((OUT/'VALIDATION.json').read_text());assert validation['status']=='B1_METHOD_COMPLETE_FULL_RECORDS_PASS'
for selected,checked in zip(index['plans'],validation['roles']):
 d=Path(selected['path']).parent;p=json.loads((d/'plan.json').read_text());r=json.loads((d/'receipt.json').read_text());assert sha((d/'plan.json').read_bytes())==selected['sha256']==r['planSHA256']==checked['planSHA256'];assert r['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS'
 for name,h in p['pins'].items():pin(name,h)
 for root,files in p['resourceRoots'].items():
  for name,h in files.items():q=str(Path(root)/name);pin(q,h);toolOnly.add(q)
 toolOnly.update(p['tools'].values())
 for g in r['guards']:
  pin(g['path'],g['sha256']);guard=json.loads(Path(g['path']).read_text());assert guard['unchanged']
  for name,h in guard['actualPins'].items():pin(name,h)
 assert len(r['commands'])==len(p['commands'])
 for c,e in zip(r['commands'],p['commands']):
  for k in ['label','argv','capSeconds']:assert c[k]==e[k]
  assert c['exit']==0 and c['failure'] is None and c['stderr']['bytes']==0
  for k in ['stdout','stderr']:
   v=c[k];pin(v['path'],v['sha256']);assert Path(v['path']).stat().st_size==v['bytes']
 raw=(d/'consumer.stdout').read_bytes();assert raw==gzip.decompress(Path(p['oracle']).read_bytes())
 for clock in checked['clocks']:pin(clock['path'],clock['sha256']);assert Path(clock['path']).read_text()==clock['raw']
 current.append({'role':selected['role'],'actualDirectory':str(d),'planSHA256':selected['sha256'],'receiptSHA256':sha((d/'receipt.json').read_bytes()),'bytes':len(raw),'sha256':sha(raw),'clocks':checked['clocks']})
 for f in d.rglob('*'):
  if f.is_file():paths.add(str(f))
for f in OUT.iterdir():
 if f.is_file():paths.add(str(f))
paths.update([str(Path(__file__)),'/tmp/verify21-sparse-b1-current02.py'])
rows=[]
for name in sorted(paths):
 f=Path(name);raw=f.read_bytes();h=sha(raw);row={'actualPath':name,'actualRealpath':str(f.resolve()),'mode':oct(f.lstat().st_mode&0o7777),'symlinkTarget':str(f.readlink()) if f.is_symlink() else None,'bytes':len(raw),'sha256':h}
 if raw.startswith(b'\x7fELF') and name in toolOnly:row['hashOnly']='Installed tool/shared library identity only; not redistributed'
 else:
  obj=L/'objects'/(h+'.gz')
  if not obj.exists():obj.write_bytes(gzip.compress(raw,mtime=0))
  assert gzip.decompress(obj.read_bytes())==raw;row.update(object=os.path.relpath(obj,L),objectSHA256=sha(obj.read_bytes()))
 rows.append(row)
record={'sourceCommit':'251ae420e865c2f8d76907ba6067336d9e885735','sourceCheckCommit':'251ae420e865c2f8d76907ba6067336d9e885735','freezeCommit':'fa91c8c7614915648ab767328dece4286a995b97','scope':'B1 SparseMotion64 ordinaryApp method/correctness feasibility only: complete actual commonforcing insideclock, allfullrecords afterclock,6fulltuples match. Raw millisecond clocks under external contention may be resolutionlimited. No speed ranking/ratios/RSS/precision or full#21 qualification. Existing collector unchanged; no newrunner/stdoutnormalization.','current':current,'members':rows,'objects':len(list((L/'objects').iterdir())),'objectDependencies':[],'referencedObjects':0}
(L/'RETENTION.json').write_text(json.dumps(record,indent=2)+'\n');shutil.copyfile(__file__,L/'retain.py.source');shutil.copyfile('/tmp/verify21-sparse-b1-current02.py',L/'verify.py');print(len(current),len(rows),record['objects'])
