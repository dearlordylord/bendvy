from pathlib import Path
import json,gzip,hashlib,shutil,subprocess,os
W=Path('/tmp/bendvy-sparse-matched-method');L=W/'experiments/s-perf/canonical-api-v1/sparse-runtime-v1/diagnostics/matched-timing-v1/runtime-v1/actual-attempt02/history';assert not L.exists();(L/'objects').mkdir(parents=True)
sha=lambda x:hashlib.sha256(x).hexdigest();blobs={};toolOnly=set();provenance={}
oldCodec=W/'experiments/s-perf/canonical-api-v1/sparse-runtime-v1/diagnostics/matched-timing-v1/codec.bend';oldObject='c9534316076ba6eaa725bc59a1aa75ee9c7286d8:'+str(oldCodec.relative_to(W))
oldBytes=subprocess.check_output(['git','show',oldObject],cwd=W)
def pin(name,h):
 if name in blobs:assert sha(blobs[name])==h;return
 p=Path(name);raw=p.read_bytes()
 if sha(raw)!=h:
  assert p==oldCodec and sha(oldBytes)==h,name
  raw=oldBytes;provenance[name]={'historicalGitObject':oldObject,'scope':'Historical source bytes, not current filesystem equality'}
 assert sha(raw)==h,name
 blobs[name]=raw
cases=[]
for role in ['native','ts']:assert not (Path('/tmp/bendvy21-sparse-motion-b1-method-pilot-actual01')/role/'receipt.json').exists()
for directory,status in [('/tmp/bendvy21-sparse-motion-b1-method-pilot-actual01/js','INCOMPLETE'),('/tmp/bendvy21-sparse-motion-b1-stack-diagnostic-actual01','COMPLETE_SOURCE_CONTROL_PASS')]:
 q=Path(directory);p=json.loads((q/'plan.json').read_text());r=json.loads((q/'receipt.json').read_text());assert r['status']==status and r['planSHA256']==sha((q/'plan.json').read_bytes())
 for n,h in p['pins'].items():pin(n,h)
 for root,files in p['resourceRoots'].items():
  for n,h in files.items():name=str(Path(root)/n);pin(name,h);toolOnly.add(name)
 toolOnly.update(p['tools'].values())
 for g in r['guards']:
  pin(g['path'],g['sha256']);v=json.loads(Path(g['path']).read_text());assert v['unchanged']
  for n,h in v['actualPins'].items():pin(n,h)
 assert len(r['commands'])==len(p['commands'])
 for c in r['commands']:
  for k in ['stdout','stderr']:pin(c[k]['path'],c[k]['sha256']);assert len(blobs[c[k]['path']])==c[k]['bytes']
 for f in q.rglob('*'):
  if f.is_file():pin(str(f),sha(f.read_bytes()))
 cases.append({'directory':directory,'status':status,'planSHA256':sha((q/'plan.json').read_bytes()),'receiptSHA256':sha((q/'receipt.json').read_bytes())})
# Preserve unexecuted old Native/TS drafts and the first prelaunch environment truthfully.
for f in Path('/tmp/bendvy21-sparse-motion-b1-method-pilot-actual01').rglob('*'):
 if f.is_file():pin(str(f),sha(f.read_bytes()))
for name in [__file__,'/tmp/verify21-sparse-b1-history02.py']:pin(name,sha(Path(name).read_bytes()))
rows=[]
for name,raw in sorted(blobs.items()):
 p=Path(name);h=sha(raw);row={'actualPath':name,'actualRealpath':str(p.resolve()),'sha256':h,'bytes':len(raw),**provenance.get(name,{})}
 if raw.startswith(b'\x7fELF')and name in toolOnly:row['hashOnly']='Installed tool/shared library identity only; not redistributed'
 else:
  obj=L/'objects'/(h+'.gz')
  if not obj.exists():obj.write_bytes(gzip.compress(raw,mtime=0))
  assert gzip.decompress(obj.read_bytes())==raw;row.update(object=str(obj.relative_to(L)),objectSHA256=sha(obj.read_bytes()))
 rows.append(row)
record={'scope':'Historical first failed JS and single expected-failure catch-stack diagnostic; no success/fulloracle claim, no oldcurrentpath equality','sourceCommit':'c9534316076ba6eaa725bc59a1aa75ee9c7286d8','cases':cases,'members':rows,'objects':len(list((L/'objects').iterdir())),'objectDependencies':[],'referencedObjects':0}
(L/'RETENTION.json').write_text(json.dumps(record,indent=2)+'\n');shutil.copyfile(__file__,L/'retain.py.source');shutil.copyfile('/tmp/verify21-sparse-b1-history02.py',L/'verify.py');print(len(rows),record['objects'])
