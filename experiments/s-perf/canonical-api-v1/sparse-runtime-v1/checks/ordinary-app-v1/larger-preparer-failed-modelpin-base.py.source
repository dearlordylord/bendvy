from pathlib import Path
import copy,gzip,hashlib,importlib.util,json,sys
ROOT=Path('/workspace/formal-proofs/bendvy');WT=Path('/tmp/bendvy-sparse-ordinary-app');D=WT/'experiments/s-perf/canonical-api-v1/sparse-runtime-v1'
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
collector=ROOT/'experiments/public-inspect/ordinary-declaration-v1/canonical-full-consumer-v1/development-v2.py';spec=importlib.util.spec_from_file_location('collector',collector);module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
def same_output(actual,oracle):
 with Path(actual).open('rb') as a,gzip.open(oracle,'rb') as b:
  while True:
   part=a.read(1048576);assert part==b.read(len(part))
   if not part:assert b.read(1)==b'';break
producers={};common={}
for role in ['js','native']:
 directory=Path('/tmp/bendvy21-canonical-sparse-ordinary-app-motion64-actual01/normal')/role;pp=directory/'plan.json';rp=directory/'receipt.json';p=json.loads(pp.read_text());r=json.loads(rp.read_text())
 assert r['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS' and r['planSHA256']==sha(pp) and not r.get('guardFailures',[])
 assert len(p['commands'])==len(r['commands'])
 for c,e in zip(r['commands'],p['commands']):
  for key in ['label','argv','capSeconds']:assert c[key]==e[key]
  assert c['exit']==0 and c['failure'] is None
  for key in ['stdout','stderr']:
   value=c[key];assert sha(value['path'])==value['sha256'] and Path(value['path']).stat().st_size==value['bytes']
 assert (directory/'consumer.stderr').read_bytes()==b'';same_output(directory/'consumer.stdout',p['oracle'])
 for path,h in p['pins'].items():assert sha(path)==h,path;common[path]=h
 for base,files in p['resourceRoots'].items():
  for path,h in files.items():assert sha(Path(base)/path)==h
 for path,h in p['sourceInventory'].items():
  assert sha(path)==h,path
 for guard_record in r['guards']:
  assert sha(guard_record['path'])==guard_record['sha256'];guard=json.loads(Path(guard_record['path']).read_text());assert guard['unchanged']
  for path,h in guard['actualPins'].items():assert sha(path)==h,path;common[path]=h
 assert module.validate_imports(p['stage'],p['sourceInventory'],p['sourceEntries'])==p['importClosure']
 assert set(Path(q).name for q in p['foreignConsumption']['sidecars'])=={'world-namespace.c','world-namespace.js'}
 for path in directory.iterdir():
  if path.is_file():common[str(path)]=sha(path)
 producers[role]=(directory,p)
common[str(Path(__file__))]=sha(__file__)
bases={256:ROOT/'experiments/s-perf/canonical-api-oracle-v1/sparse-runtime-v1/size256/motion',1024:ROOT/'experiments/s-perf/canonical-api-oracle-v1/sparse-runtime-v1/size1024/motion'}
expected={256:(1642138,'b770f6028e2fca3f7ebdec84a1f37d44d14283044e28311f9bf75f2969c788bc'),1024:(6595523,'4ec399768f5eedd5a7ea911b7f3830b97d721e364a0a4a79b4aebb40a6e906ef')}
prepared=[]
for count,base in bases.items():
 out=Path(f'/tmp/bendvy21-canonical-sparse-ordinary-app-motion{count}-actual01');assert not out.exists();oracle=base/'expected.stdout.gz';digest=hashlib.sha256();n=0;last=b''
 with gzip.open(oracle,'rb') as stream:
  while chunk:=stream.read(1048576):digest.update(chunk);n+=len(chunk);last=chunk[-1:]
 assert (n,digest.hexdigest())==expected[count] and last==b'\n'
 pins=dict(common)
 for path in [*base.iterdir(),*base.parent.iterdir()]:
  if path.is_file():pins[str(path)]=sha(path)
 basis=json.loads((base/'SOURCE-BASIS.json').read_text());assert basis['runtimeArguments']==[str(count),'64']
 for path,h in basis['modelPins'].items():q=base.parent.parent/path;assert sha(q)==h;pins[str(q)]=h
 prepared.append((count,out,oracle,n,digest.hexdigest(),pins))
freeze=D/'checks/ordinary-app-v1/LARGER-SOURCE-FREEZE01.json';assert not freeze.exists();freeze.write_text(json.dumps({'sourceCommit':'88c6e66605d843cf57b7043b75bedbd4719d65fd','integrationState':'Motion candidate; first64 pair complete, final integration pending','sourceInventory':producers['js'][1]['sourceInventory'],'foreignSidecars':producers['js'][1]['foreignConsumption']['sidecars'],'producers':{r:{'plan':str(q/'plan.json'),'planSHA256':sha(q/'plan.json'),'receipt':str(q/'receipt.json'),'receiptSHA256':sha(q/'receipt.json')} for r,(q,p) in producers.items()},'runtimeArguments':[['256','64'],['1024','64']],'consumerCapSeconds':180,'scope':'Ordinary App Motion runtime-size correctness successors only. Identical actual Motion64 artifacts, tools and sources; all selected consumer commands use180seconds; no IO optimization candidate, re-emission, build or performance comparison.'},indent=2)+'\n')
for count,out,oracle,n,h,pins in prepared:
 pins[str(freeze)]=sha(freeze)
 for path,value in pins.items():assert sha(path)==value,path
 for role,(producer,old) in producers.items():
  q=out/'normal'/role;q.mkdir(parents=True);plan=copy.deepcopy(old);prefix=[old['tools']['taskset'],'-c','11'];args=[str(count),'64'];argv=prefix+([old['tools']['node'],old['generated'],*args] if role=='js' else [old['native'],*args,'--threads','1','--gpu','off'])
  artifact=old['generated'] if role=='js' else old['native'];assert str(artifact) in pins
  plan.update(scope=f'Sparse ordinary App Motion{count} {role} full independent wire correctness only, no timing qualification',runtimeArguments=args,pins=dict(pins),commands=[{'label':'consumer','argv':argv,'capSeconds':180}],oracle=str(oracle),oracleBytes=n,oracleSHA256=h,normalOracle=str(oracle),normalOracleBytes=n,normalOracleSHA256=h,producer={'scope':'Exact full-PASS ordinary Runtime64 artifact reused unchanged; no new emission or Native build','plan':str(producer/'plan.json'),'planSHA256':sha(producer/'plan.json'),'receipt':str(producer/'receipt.json'),'receiptSHA256':sha(producer/'receipt.json'),'generated':old['generated'],'generatedSHA256':sha(old['generated']),'native':old['native'],'nativeSHA256':sha(old['native']) if role=='native' else None},largerSourceFreeze={'path':str(freeze),'sha256':sha(freeze)},postConsumer='All actual bytes must equal full preserved independent larger-runtime oracle; original fresh world creation, observer, affine owners and seven phases unchanged. No speed claim.')
  assert plan['oracleBytes']==plan['normalOracleBytes']==expected[count][0]
  assert plan['oracleSHA256']==plan['normalOracleSHA256']==expected[count][1]
  path=q/'plan.json';path.write_text(json.dumps(plan,indent=2)+'\n');print(count,role,path,sha(path),len(pins),flush=True)
print('freeze',sha(freeze),'helper',sha(__file__),flush=True)
