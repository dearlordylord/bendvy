def read(p):return historicalBytes if str(p)==historicalPath else Path(p).read_bytes()

def pin(path,h):
 p=Path(path);assert sha(read(p))==h,path;paths.add(str(p))
index=json.loads((OUT/'PLAN-INDEX.json').read_text())
for selected in index['plans']:
 checked=json.loads((Path(selected['path']).parent/'source-profile-validate.stdout').read_text());assert checked['status']=='PROFILE_FULL_SEMANTICS_PASS'
 d=Path(selected['path']).parent;p=json.loads((d/'plan.json').read_text());r=json.loads((d/'receipt.json').read_text());assert sha((d/'plan.json').read_bytes())==selected['sha256']==r['planSHA256'];assert r['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS'
 for name,h in p['pins'].items():pin(name,h)
 for root,files in p['resourceRoots'].items():
  for name,h in files.items():q=str(Path(root)/name);pin(q,h);toolOnly.add(q)
 toolOnly.update(p['tools'].values())
 for g in r['guards']:
  pin(g['path'],g['sha256']);guard=json.loads(Path(g['path']).read_text());assert guard['unchanged']
  for name,h in guard['actualPins'].items():pin(name,h)
 assert len(r['commands'])==len(p['commands'])
 for c,e in zip(r['commands'],p['commands']):
  for k in ['label','argv','capSeconds']:assert c[k]==e[k]
  assert c['exit']==0 and c['failure'] is None and c['stderr']['bytes']==0
  for k in ['stdout','stderr']:
   v=c[k];pin(v['path'],v['sha256']);assert Path(v['path']).stat().st_size==v['bytes']
 raw=(d/'consumer.stdout').read_bytes();assert raw==gzip.decompress(Path(p['oracle']).read_bytes())
 pin(checked['profilePath'],checked['profileSHA256'])
 for clock in checked['clocks']:pin(clock['path'],clock['sha256']);assert Path(clock['path']).read_text()==clock['raw']
 current.append({'role':selected['kind'],'actualDirectory':str(d),'planSHA256':selected['sha256'],'receiptSHA256':sha((d/'receipt.json').read_bytes()),'bytes':len(raw),'sha256':sha(raw),'clocks':checked['clocks'],'profileCheck':checked})
 for f in d.rglob('*'):
  if f.is_file():paths.add(str(f))
for parent,roles in [(Path('/tmp/bendvy21-dense-plan-once-pilot-actual01'),['js','native']),(Path('/tmp/bendvy21-plan-once-authority-actual02'),['normal-js','normal-native','type-js','type-native'])]:
 for role in roles:
  plan=json.loads((parent/role/'plan.json').read_text());receipt=json.loads((parent/role/'receipt.json').read_text())
  for name,h in plan['pins'].items():pin(name,h)
  for root,files in plan['resourceRoots'].items():
   for name,h in files.items():q=str(Path(root)/name);pin(q,h);toolOnly.add(q)
  toolOnly.update(plan['tools'].values())
  for g in receipt['guards']:
   pin(g['path'],g['sha256'])
   for name,h in json.loads(Path(g['path']).read_text())['actualPins'].items():pin(name,h)
for parent in [Path('/tmp/bendvy21-dense-plan-once-pilot-actual01'),Path('/tmp/bendvy21-plan-once-authority-actual02')]:
 for f in parent.rglob('*'):
  if f.is_file():paths.add(str(f))
for leaf in ['first-pair','profiles','generated-cost','authority','source-checks']:
 for f in (D/leaf).rglob('*'):
  if f.is_file():paths.add(str(f))
for f in [Path('/tmp/bendvy21-dense-matched-profiles-actual01/ANALYSIS.json'),Path('/tmp/analyze21-dense-plan-once-profiles01.py'),Path('/tmp/prepare21-plan-once-authority01.py'),Path('/tmp/prepare21-plan-once-authority02.py')]:paths.add(str(f))
for f in OUT.iterdir():
 if f.is_file():paths.add(str(f))
paths.add('/tmp/bendvy21-plan-once-8f-ordinary-system.bend')
paths.update([str(Path(__file__)),'/tmp/verify21-dense-plan-once-evidence01.py'])
for f in D.iterdir():
 if f.is_file():paths.add(str(f))
rows=[]
for name in sorted(paths):
 f=Path(name);raw=read(f);h=sha(raw);row={'actualPath':name,'actualRealpath':str(f.resolve()),'historicalResolution':('git8f7c658e5 exact source bytes; current path is f190 successor' if name==historicalPath else None),'mode':oct(f.lstat().st_mode&0o7777),'symlinkTarget':str(f.readlink()) if f.is_symlink() else None,'bytes':len(raw),'sha256':h}
 if raw.startswith(b'\x7fELF') and name in toolOnly:row['hashOnly']='Installed tool/shared library identity only; not redistributed'
 else:
  obj=L/'objects'/(h+'.gz')
  if not obj.exists():obj.write_bytes(gzip.compress(raw,mtime=0))
  assert gzip.decompress(obj.read_bytes())==raw;row.update(object=os.path.relpath(obj,L),objectSHA256=sha(obj.read_bytes()))
 rows.append(row)
