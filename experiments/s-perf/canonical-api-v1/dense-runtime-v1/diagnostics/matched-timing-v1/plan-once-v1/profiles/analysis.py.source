"""Bounded offline reading of the two qualified raw profiles, no execution."""
from pathlib import Path
import collections,hashlib,json,re
D=Path('/tmp/bendvy21-dense-plan-once-profiles-actual01');OUT=D/'ANALYSIS.json'
def decoded(n):return re.sub(r'\$(\d{3})',lambda m:chr(int(m[1])),n).strip('$')
def key(f):return (f.get('functionName',''),f.get('url',''),f.get('lineNumber',-1),f.get('columnNumber',-1))
def phase(frames):
 names=[decoded(f.get('functionName',''))for f in frames]
 if any(n=='(garbage collector)'for n in names):return 'GC_phase_unattributed'
 if any('motion-driver:step' in n or 'motion-driver:loops' in n or 'motion:body' in n for n in names):return 'authored_step_reached_ancestor'
 if any('common:capture' in n or 'codec:encode' in n or 'codec:fold' in n for n in names):return 'common_observer_forcing_reached_ancestor'
 if any('motion-main:final' in n for n in names):return 'final_canonical_outside_clock_reached_ancestor'
 if any(n in ['prepare','created','seeded','pending','applied','defined','registered']or 'motion:seed' in n or 'motion:payload' in n for n in names):return 'preparation_outside_clock_reached_ancestor'
 if any(n in ['(program)','(idle)','(root)']for n in names[:1]):return 'unattributed_phase_pseudo_leaf'
 if frames and str(frames[0].get('url','')).startswith('node:'):return 'node_runtime_phase_ambiguous'
 return 'shared_or_other_phase_ambiguous'
def rows(values,inclusive):
 out=[]
 for k,v in sorted(values.items(),key=lambda x:-x[1]):
  out.append(dict(function=decoded(k[0]),rawFunction=k[0],url=k[1],lineOneBased=k[2]+1,columnOneBased=k[3]+1,self=v,inclusive=inclusive[k]))
 return out
p=json.loads((D/'cpu/JS.cpuprofile').read_text());nodes={n['id']:n for n in p['nodes']};parent={c:n['id']for n in p['nodes']for c in n.get('children',[])}
self=collections.Counter();inc=collections.Counter();phaseCounts=collections.Counter();phaseWeight=collections.Counter();gc=0;unknown=0
for ident,delta in zip(p['samples'],p['timeDeltas']):
 frames=[];n=ident
 while True:
  frames.append(nodes[n]['callFrame'])
  if n not in parent:break
  n=parent[n]
 self[key(frames[0])]+=1
 for f in set(key(f)for f in frames):inc[f]+=1
 label=phase(frames);phaseCounts[label]+=1;phaseWeight[label]+=delta
 if frames[0].get('functionName')=='(garbage collector)':gc+=1
 if frames[0].get('functionName') in ['(program)','(idle)','(root)','']:unknown+=1
cpu={'rawSHA256':hashlib.sha256((D/'cpu/JS.cpuprofile').read_bytes()).hexdigest(),'samples':len(p['samples']),'nodes':len(nodes),'GCLeafSamples':gc,'pseudoOrUnnamedLeafSamples':unknown,'phaseCounts':dict(phaseCounts),'phaseTimeDeltaMicrosecondsDescriptiveOnly':dict(phaseWeight),'functions':rows(self,inc),'inclusiveConvention':'Distinct source-frame membership per sampled stack; recursive identical source locations counted once. Includes descendants, overlaps other functions.','scope':'Whole Node process. Reached unique ancestor categories are stack observations, not exact timed shares; GC/omitted/shared frames cannot be assigned to an interval.'}
p=json.loads((D/'allocation/allocation-profile.json').read_text());head=p['profile']['head'];self=collections.Counter();inc=collections.Counter();phaseBytes=collections.Counter();nodeRows=[];stack=[(head,[])];total=0
while stack:
 n,anc=stack.pop();frames=[n['callFrame'],*anc];size=n['selfSize'];total+=size;self[key(n['callFrame'])]+=size
 for f in set(key(f)for f in frames):inc[f]+=size
 phaseBytes[phase(frames)]+=size
 nodeRows.append(dict(id=n['id'],self=size,frame=key(n['callFrame']),phase=phase(frames)))
 stack.extend((child,frames)for child in n.get('children',[]))
allocation={'rawSHA256':hashlib.sha256((D/'allocation/allocation-profile.json').read_bytes()).hexdigest(),'parameters':p['parameters'],'sampleCount':len(p['profile']['samples']),'nodes':len(nodeRows),'sampledEstimatedSelfBytes':total,'phaseEstimatedSelfBytes':dict(phaseBytes),'functions':rows(self,inc),'inclusiveConvention':cpu['inclusiveConvention'],'scope':'Collected-inclusive V8 sampling estimate over preload sampling lifetime (before artifact require through exit hook); not exact allocated bytes, live heap, RSS or timed-only allocation. Setup/final rendering remain included; instrumentation itself may contribute.'}
result={'artifactSHA256':'d0697f5c23f8cfc99b7b6846a1ba78e3caa7dc044bde6b92bc741a002d08e1c6','cpu':cpu,'allocation':allocation,'noTimingQualification':True};OUT.write_text(json.dumps(result,indent=2)+'\n');print('CPU',cpu['phaseCounts']);print('ALLOC',allocation['phaseEstimatedSelfBytes']);print('CPUFUNCTIONS',[(r['function'],r['self'],r['inclusive'])for r in cpu['functions'][:10]]);print('ALLOCFUNCTIONS',[(r['function'],r['self'],r['inclusive'])for r in allocation['functions'][:10]])
