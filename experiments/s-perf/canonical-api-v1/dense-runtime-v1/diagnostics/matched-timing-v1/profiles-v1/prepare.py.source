from pathlib import Path
import copy,gzip,hashlib,json,subprocess
ROOT=Path('/workspace/formal-proofs/bendvy');W=Path('/tmp/bendvy-dense-matched-profiles');D=W/'experiments/s-perf/canonical-api-v1/dense-runtime-v1/diagnostics/matched-timing-v1';OUT=Path('/tmp/bendvy21-dense-matched-profiles-actual01');assert not OUT.exists();OUT.mkdir()
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest();producer=Path('/tmp/bendvy21-dense-matched-timing-pilot-actual01/js');base=json.loads((producer/'plan.json').read_text());receipt=json.loads((producer/'receipt.json').read_text());assert receipt['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS';assert all(c['exit']==0 and c['failure'] is None and c['stderr']['bytes']==0 for c in receipt['commands']);assert sha(producer/'plan.json')==receipt['planSHA256'];artifact=Path(base['generated']);artifactSHA='860cb672eb5aad86b4677068ef1eae9b87f03b5c031cfc0df820d6739c21d6f4';assert sha(artifact)==artifactSHA==receipt['emitArtifactSHA256'];assert (producer/'consumer.stdout').read_bytes()==gzip.decompress(Path(base['oracle']).read_bytes());assert base['oracleBytes']==226988 and base['oracleSHA256']=='0375eec332d8509226d2eafd8b5d48ac592f38caf6f89c30f449b9599d1a2ebf'
preload=Path('/tmp/bendvy-failedtxn-concat-identity/experiments/s-perf/canonical-api-v1/failedtxn-runtime-v1/diagnostics/allocation-sampling-v1/preload.cjs');assert sha(preload)=='13867d5b927e0a904b1191243b81d8f82209ab63a1e92ab9dfa66aca3d79d303'
controls=[]
for role,status in [('exit','COMPLETE_SOURCE_CONTROL_PASS'),('throw','COMPLETE_SOURCE_CONTROL_PASS'),('timeout','INCOMPLETE')]:
 directory=preload.parent/role;p=json.loads((directory/'plan.json').read_text());r=json.loads((directory/'receipt.json').read_text());assert sha(directory/'plan.json')==r['planSHA256'] and r['status']==status;assert p['tools']['node']==base['tools']['node'] and p['pins'][str(preload)]==sha(preload) and p['pins'][p['tools']['node']]==sha(base['tools']['node']);controls.append({'role':role,'plan':str(directory/'plan.json'),'planSHA256':sha(directory/'plan.json'),'receipt':str(directory/'receipt.json'),'receiptSHA256':sha(directory/'receipt.json'),'status':status,'scope':'Existing sameNode/preload exit-hook semantics only, no current full old admission-pin claim; timeout remains incomplete.'})
validate=r'''import gzip,hashlib,json,math,pathlib,sys
kind,profile,actual,oracle,fixture,warm,sample=sys.argv[1:]
P=pathlib.Path(profile);assert P.is_file() and not P.is_symlink();raw=P.read_bytes();d=json.loads(raw);h=hashlib.sha256(raw).hexdigest()
actual=pathlib.Path(actual).read_bytes();assert actual==gzip.decompress(pathlib.Path(oracle).read_bytes());expected=json.loads(pathlib.Path(fixture).read_text())["tuple"];tuples=[json.loads(x[6:])for x in actual.decode().splitlines()if x.startswith("TUPLE:")];assert len(tuples)==2 and all(t==expected for t in tuples)
clocks=[]
for name in [warm,sample]:
 p=pathlib.Path(name);assert p.is_file() and not p.is_symlink();b=p.read_bytes();assert 0<len(b)<128 and b.endswith(b"\n");v=float(b);assert math.isfinite(v) and v>=0;clocks.append({"path":name,"sha256":hashlib.sha256(b).hexdigest(),"raw":b.decode()})
if kind=="cpu":
 nodes=d["nodes"];ids=[n["id"]for n in nodes];assert nodes and len(ids)==len(set(ids));known=set(ids);children={n["id"]:n.get("children",[])for n in nodes};assert all(c in known for v in children.values()for c in v);visited=set();stack=[nodes[0]["id"]]
 while stack:
  n=stack.pop();assert n not in visited;visited.add(n);stack.extend(children[n])
 assert visited==known and len(d["samples"])==len(d["timeDeltas"])>0 and all(s in known for s in d["samples"]);assert all(isinstance(x,(int,float)) and math.isfinite(x) and x>=0 for x in d["timeDeltas"]);assert d["endTime"]>=d["startTime"];samples=len(d["samples"])
else:
 assert d["status"]=="COMPLETE" and d["synchronousStop"] is True and d["exitCode"]==0;assert d["parameters"]=={"samplingInterval":65536,"includeObjectsCollectedByMajorGC":True,"includeObjectsCollectedByMinorGC":True};stack=[d["profile"]["head"]];known=set()
 while stack:
  n=stack.pop();assert n["id"]not in known;known.add(n["id"]);assert n["selfSize"]>=0;stack.extend(n.get("children",[]))
 assert isinstance(d["profile"]["samples"],list) and all(s["nodeId"]in known and s["size"]>=0 for s in d["profile"]["samples"]);samples=len(d["profile"]["samples"])
print(json.dumps({"status":"PROFILE_FULL_SEMANTICS_PASS","kind":kind,"profilePath":profile,"profileSHA256":h,"profileBytes":len(raw),"nodes":len(known),"samples":samples,"fullStdoutSHA256":hashlib.sha256(actual).hexdigest(),"completeTuples":len(tuples),"clocks":clocks,"scope":"Whole-process instrumented diagnosis only; no timing/retained-heap/RSS/product qualification"},sort_keys=True))'''
plans=[]
for kind in ['cpu','allocation']:
 out=OUT/kind;out.mkdir();p=copy.deepcopy(base);warm=out/'warmup.clock';sample=out/'sample.clock';profile=out/('JS.cpuprofile' if kind=='cpu' else 'allocation-profile.json');assert not any(x.exists() or x.is_symlink()for x in [warm,sample,profile]);args=['64','64',str(warm),str(sample)];prefix=[p['tools']['taskset'],'-c','11'];flags=['--cpu-prof','--cpu-prof-interval=100','--cpu-prof-dir='+str(out),'--cpu-prof-name=JS.cpuprofile'] if kind=='cpu' else ['--require',str(preload)]
 p.update(scope='Same-qualified-JS-artifact '+kind+' whole-process diagnostic, firstB1 only; full unchanged semantic oracle/tuple/clock validation; no speed claim or new workload/source',runtimeArguments=args,native=str(out/'unused.native'),commands=[{'label':'consumer','argv':prefix+[p['tools']['node'],*flags,str(artifact),*args],'capSeconds':15},{'label':'source-profile-validate','argv':prefix+[p['tools']['python'],'-c',validate,kind,str(profile),str(out/'consumer.stdout'),p['oracle'],str(Path(base['stage'])/'model/expected-common.json'),str(warm),str(sample)],'capSeconds':30,'expectedExit':0}],clockSidecars=[{'path':str(q),'phase':phase,'freshBeforeConsumer':True,'encoding':'one raw nonnegative millisecond number and LF'}for q,phase in [(warm,'warmup'),(sample,'sample')]],profile={'kind':kind,'path':str(profile),'freshBeforeConsumer':True,'sameArtifactSHA256':artifactSHA,'validation':'Frozen source-command nodegraph/path/hash +fulltuple/oracle +rawclocks'},producer={'plan':str(producer/'plan.json'),'planSHA256':sha(producer/'plan.json'),'receipt':str(producer/'receipt.json'),'receiptSHA256':sha(producer/'receipt.json')})
 if kind=='allocation':p['environment']['BENDVY_ALLOCATION_PROFILE']=str(profile);p['preloadControls']=controls
 for q in [artifact,producer/'plan.json',producer/'receipt.json',producer/'consumer.stdout',producer/'consumer.stderr',Path(__file__),preload]:p['pins'][str(q)]=sha(q)
 if kind=='allocation':
  for control in controls:
   for a,hkey in [('plan','planSHA256'),('receipt','receiptSHA256')]:p['pins'][control[a]]=control[hkey]
 for path,h in p['pins'].items():assert sha(path)==h,path
 assert p['oracleBytes']==226988 and p['oracleSHA256']=='0375eec332d8509226d2eafd8b5d48ac592f38caf6f89c30f449b9599d1a2ebf'
 path=out/'plan.json';path.write_text(json.dumps(p,indent=2)+'\n');plans.append({'kind':kind,'path':str(path),'sha256':sha(path),'profile':str(profile)})
(OUT/'PLAN-INDEX.json').write_text(json.dumps({'sameArtifact':str(artifact),'sameArtifactSHA256':artifactSHA,'helperSHA256':sha(__file__),'plans':plans},indent=2)+'\n');print(json.dumps(plans,indent=2))
