from pathlib import Path
import json,gzip,hashlib,shutil,os
D=Path('/tmp/bendvy-dense-tx-peaks/experiments/s-perf/canonical-api-v1/dense-runtime-v1/diagnostics/tx-peaks-v1');L=D/'results/ordinary01';assert not L.exists();(L/'objects').mkdir(parents=True);sha=lambda b:hashlib.sha256(b).hexdigest();versions={};tools=set();cases=[]
def pin(name,h):
 p=Path(name);raw=p.read_bytes()
 assert sha(raw)==h,(name,h)
 versions[(name,h)]=raw
for kind in ['normal','mutant']:
 for role in ['js','native']:
  q=(Path('/tmp/bendvy21-dense-tx-peaks-motion64-actual01/normal')/role if kind=='normal' else Path('/tmp/bendvy21-dense-tx-peaks-counter-mutant-actual01')/role);p=json.loads((q/'plan.json').read_text());r=json.loads((q/'receipt.json').read_text());assert r['planSHA256']==sha((q/'plan.json').read_bytes());cases.append({'directory':str(q),'kind':kind,'role':role,'planSHA256':r['planSHA256'],'receiptSHA256':sha((q/'receipt.json').read_bytes())})
  for name,h in p['pins'].items():pin(name,h)
  for root,files in p['resourceRoots'].items():
   for name,h in files.items():path=str(Path(root)/name);pin(path,h);tools.add(path)
  tools.update(p['tools'].values())
  for g in r['guards']:
   pin(g['path'],g['sha256']);guard=json.loads(Path(g['path']).read_text());assert guard['unchanged']
   for name,h in guard['actualPins'].items():pin(name,h)
  for c in r['commands']:
   for key in ['stdout','stderr']:v=c[key];pin(v['path'],v['sha256']);assert Path(v['path']).stat().st_size==v['bytes']
  for f in q.iterdir():
   if f.is_file():pin(str(f),sha(f.read_bytes()))
for f in [Path(__file__),Path('/tmp/verify21-dense-tx-peaks.py')]:pin(str(f),sha(f.read_bytes()))
rows=[]
for (name,h),raw in sorted(versions.items()):
 p=Path(name);row={'actualPath':name,'actualRealpath':str(p.resolve()),'bytes':len(raw),'sha256':h}
 if raw.startswith(b'\x7fELF') and name in tools:row['hashOnly']='Installed tool/shared library identity only; not redistributed'
 else:
  obj=L/'objects'/(h+'.gz')
  if not obj.exists():obj.write_bytes(gzip.compress(raw,mtime=0))
  row.update(object=os.path.relpath(obj,L),objectSHA256=sha(obj.read_bytes()))
 rows.append(row)
record={'scope':'Private Dense Motion64 actual terminal logical Tx snapshots: two normal full-wire+metric PASS and two compiling reporter-only counter defects preserving full wire while exact metrics REJECT. No allocation/RSS/timing or lifecycle stamp measurement; canonical Tx has no marks field. Other workloads remain outside this packet.','cases':cases,'members':rows,'objects':len(list((L/'objects').iterdir()))};(L/'RETENTION.json').write_text(json.dumps(record,indent=2)+'\n');shutil.copyfile(__file__,L/'retain.py.source');shutil.copyfile('/tmp/verify21-dense-tx-peaks.py',L/'verify.py');print(len(rows),record['objects'])
