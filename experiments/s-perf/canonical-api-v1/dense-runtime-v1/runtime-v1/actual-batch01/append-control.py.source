from pathlib import Path
import json,gzip,hashlib,shutil
L=Path('/tmp/bendvy-dense-runtime-tail/experiments/s-perf/canonical-api-v1/dense-runtime-v1/runtime-v1/actual-batch01');p=L/'RETENTION.json';record=json.loads(p.read_text());assert len(record['current'])==12
sha=lambda b:hashlib.sha256(b).hexdigest();paths=set();toolOnly=set()
def pin(n,h):assert sha(Path(n).read_bytes())==h,n;paths.add(n)
for role in ['js','native']:
 d=Path('/tmp/bendvy21-raw-loop-actual01/normal')/role;plan=json.loads((d/'plan.json').read_text());r=json.loads((d/'receipt.json').read_text());assert r['planSHA256']==sha((d/'plan.json').read_bytes());assert r['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS';assert len(r['commands'])==len(plan['commands'])
 for n,h in plan['pins'].items():pin(n,h)
 for root,files in plan['resourceRoots'].items():
  for n,h in files.items():q=str(Path(root)/n);pin(q,h);toolOnly.add(q)
 toolOnly.update(plan['tools'].values())
 for g in r['guards']:
  pin(g['path'],g['sha256']);v=json.loads(Path(g['path']).read_text());assert v['unchanged']
  for n,h in v['actualPins'].items():pin(n,h)
 for c,e in zip(r['commands'],plan['commands']):
  for k in ['label','argv','capSeconds']:assert c[k]==e[k]
  assert c['exit']==0 and c['failure'] is None
  for k in ['stdout','stderr']:v=c[k];pin(v['path'],v['sha256']);assert Path(v['path']).stat().st_size==v['bytes']
 raw=(d/'consumer.stdout').read_bytes();assert raw==gzip.decompress(Path(plan['oracle']).read_bytes());assert (d/'consumer.stderr').read_bytes()==b''
 paths.update(str(q) for q in d.iterdir() if q.is_file());record['current'].append({'scope':'focused raw loop and finished rollback control','actualDirectory':str(d),'planSHA256':sha((d/'plan.json').read_bytes()),'receiptSHA256':sha((d/'receipt.json').read_bytes()),'status':r['status'],'bytes':len(raw),'sha256':sha(raw),'commands':[{k:c[k] for k in ['label','exit','failure']} for c in r['commands']]})
paths.add(str(Path(__file__)));rows={r['actualPath']:r for r in record['members']}
for n in sorted(paths):
 f=Path(n);raw=f.read_bytes();h=sha(raw)
 if n in rows:assert rows[n]['sha256']==h;continue
 row={'actualPath':n,'actualRealpath':str(f.resolve()),'mode':oct(f.lstat().st_mode&0o7777),'symlinkTarget':str(f.readlink()) if f.is_symlink() else None,'bytes':len(raw),'sha256':h}
 if raw.startswith(b'\x7fELF') and n in toolOnly:row['hashOnly']='Installed tool/shared library identity only; not redistributed'
 else:
  obj=L/'objects'/(h+'.gz')
  if not obj.exists():obj.write_bytes(gzip.compress(raw,mtime=0))
  assert gzip.decompress(obj.read_bytes())==raw;row.update(object='objects/'+obj.name,objectSHA256=sha(obj.read_bytes()))
 rows[n]=row
record['members']=[rows[n] for n in sorted(rows)];record['objects']=len(list((L/'objects').iterdir()));record['scope']='Runtime Dense correctness twelve PASS roles plus two focused raw-loop/rollback PASS roles; historical attempts separate. Required combined default28 remains pending; no numeric/full21 qualification.'
p.write_text(json.dumps(record,indent=2)+'\n');shutil.copyfile(__file__,L/'append-control.py.source');print(len(rows),record['objects'],sha(p.read_bytes()))
