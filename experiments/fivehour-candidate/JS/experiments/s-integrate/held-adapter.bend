def motion_return(result:H.Held<S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode>,CC.Cache<T.Position,T.PositionView>,CC.Cache<T.MotionLedger,T.LedgerView>,S.Handle<T.MotionSchema>,S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>> & U32) -> X.Tx<S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>> & U32:
  match result:
    case (H.Held{S.World{ns,next,S.Rows{columns,aux,meta,cap,depth,high},pending,_,mode},main,ledger,S.Handle{+space,+id},undo,commands,pings,marks},total):
      (X.Tx{S.World{ns,next,S.Rows{Array.set(Maybe<CC.Cache<T.Position,T.PositionView>>,columns,U32.sub(id,1),Some{main}),aux,meta,cap,depth,high},pending,Some{ledger},mode},S.Handle{space,id},undo,commands,pings,marks},total)
def motion_taken(~client:@-Owner:Type -> (Owner -> T.PositionToken -> Owner & T.Access<T.PositionView>) -> (Owner -> T.PositionToken -> U32 -> Owner) -> (Owner -> T.MotionLedgerToken -> Owner & Maybe<&2,T.LedgerView>) -> (Owner -> T.MotionLedgerToken -> U32 -> Owner) -> Owner -> Owner & U32,ns:U32,next:U32,pending:List<S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>>,ledger:CC.Cache<T.MotionLedger,T.LedgerView>,mode:T.MotionMode,+handle:S.Handle<T.MotionSchema>,undo:List<&2,X.Inverse<S.Handle<T.MotionSchema>>>,commands:List<S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>>,pings:List<&2,U32>,marks:List<&2,S.Handle<T.MotionSchema>>,pair:S.Rows<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected> & S.Taken<CC.Cache<T.Position,T.PositionView>>) -> X.Tx<S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>> & U32:
  match pair:
    case (rows,S.Taken{main}): motion_return(motion_invoke(~client,H.Held{S.World{ns,next,rows,pending,None{},mode},main,ledger,handle,undo,commands,pings,marks}))
    case (rows,_): client(X.Tx<S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>>,A.motion_read_main,A.motion_set_main0,A.motion_read_ledger,A.motion_set_ledger0,X.Tx{S.World{ns,next,rows,pending,Some{ledger},mode},handle,undo,commands,pings,marks})
def motion_checked(~client:@-Owner:Type -> (Owner -> T.PositionToken -> Owner & T.Access<T.PositionView>) -> (Owner -> T.PositionToken -> U32 -> Owner) -> (Owner -> T.MotionLedgerToken -> Owner & Maybe<&2,T.LedgerView>) -> (Owner -> T.MotionLedgerToken -> U32 -> Owner) -> Owner -> Owner & U32,valid:Bool,owner:X.Tx<S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>>) -> X.Tx<S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>> & U32:
  match valid owner:
    case True{} X.Tx{S.World{ns,next,rows,pending,Some{ledger},mode},S.Handle{+space,+id},undo,commands,pings,marks}: motion_taken(~client,ns,next,pending,ledger,mode,S.Handle{space,id},undo,commands,pings,marks,S.take_rows(CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,rows,id))
    case _ owner: client(X.Tx<S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>>,A.motion_read_main,A.motion_set_main0,A.motion_read_ledger,A.motion_set_ledger0,owner)
def motion_row(~client:@-Owner:Type -> (Owner -> T.PositionToken -> Owner & T.Access<T.PositionView>) -> (Owner -> T.PositionToken -> U32 -> Owner) -> (Owner -> T.MotionLedgerToken -> Owner & Maybe<&2,T.LedgerView>) -> (Owner -> T.MotionLedgerToken -> U32 -> Owner) -> Owner -> Owner & U32,owner:X.Tx<S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>>) -> X.Tx<S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>> & U32:
  match owner:
    case X.Tx{S.World{+ns,next,rows,pending,ledger,mode},S.Handle{+space,id},undo,commands,pings,marks}: motion_checked(~client,U32.is_eq(ns,space),X.Tx{S.World{ns,next,rows,pending,ledger,mode},S.Handle{space,id},undo,commands,pings,marks})
