"""Source-only two-owned-App foreign/missing/dead request model."""
def physical(ns,resources,dead=False):
    owners=''.join((f'{i},{i},{10*i},' if i<=4 else 'absent')+';' for i in range(1,9))
    live=''.join('1,' if 1<=i<=4 and not(dead and i==1) else '0,' for i in range(16))
    return owners+f'|stamps=|events=|meta={ns},5,4,8,3,{resources[0]},,1,0|registrations=|pending=0|edges=graph-edges=|graph-inverses=|live='+live+'|resource-all='+''.join(str(x)+',' for x in resources)
def snapshot(label,ns,resources,owners,dead=False):
    lines=[physical(ns,resources,dead),'Relation{key=1|name=Parent|inverse=Children|kind=Hierarchy}']
    lines += [f'{ns}:{i}:[Parent:Outgoing:Missing, Children:Incoming:Missing]' for i in range(1,5) if not(dead and i==1)]
    return label+'|owners='+''.join(str(x)+',' for x in owners)+'\n'+'\n'.join(lines)+'\n'
def rejected(ns,id):return f'entity={ns}:{id}|root=absent|ancestors=MissingEntity|depth=MissingEntity|breadth=MissingEntity'
def scene():
    return snapshot('LOCAL_BEFORE',1,[17,18],[901,902])+'\n'+snapshot('PEER_BEFORE',2,[27,28],[1901,1902])+'\nFOREIGN_READ:'+rejected(2,1)+'\nMISSING_READ:'+rejected(1,99)+'\nDEACTIVATE:Accepted\nDEAD_READ:'+rejected(1,1)+'\n'+snapshot('LOCAL_AFTER',1,[17,18],[901,902],True)+'\n'+snapshot('PEER_AFTER',2,[27,28],[1901,1902])
def expected():return ('AppForeignAlpha\n'+scene()+'\nAppForeignBeta\n'+scene()+'\n').encode()
if __name__=='__main__':
    import sys
    sys.stdout.buffer.write(expected())
