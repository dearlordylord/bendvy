"""Freeze corrected namespace-aware foreign App source-only model."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def regenerate():
    freeze=HERE.parents[1]/'FREEZE-v2.json';pins=json.loads(freeze.read_text())['sourceInventory'].copy()
    for path,digest in pins.items():assert sha(path)==digest,path
    m=runpy.run_path(str(HERE/'model.py.source'));raw=m['expected']();text=raw.decode()
    assert text.count('entity=')==6 and text.count('MissingEntity')==18
    assert text.count('|meta=')==8 and text.count('|resource-all=')==8 and text.count('DEACTIVATE:Accepted')==2
    assert m['physical'](1,[17,18]).split('|live=')[0]==m['physical'](1,[17,18],True).split('|live=')[0]
    assert m['physical'](2,[27,28]).split('|live=')[1].startswith('0,1,1,1,1,')
    assert '1:1:[Parent:' not in m['snapshot']('LOCAL_AFTER',1,[17,18],[901,902],True)
    for path in [freeze,HERE/'model.py.source',HERE/'regenerate.py.source',Path('/home/node/.bend/bend2/base.bend'),Path('/home/node/.bend/bend2/effs/print.js'),Path('/home/node/.bend/bend2/effs/print.c')]:pins[str(path)]=sha(path)
    (HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    basis={'producerCommit':'0d69e5082','sourcePins':pins,'entry':str(HERE.parents[1]/'foreign.bend'),'derivation':'One actual Factory produces two Worlds namespace1/2 with four actual payloads each. App install retainslocalR17/18 Owners901/902 andpeerR27/28 Owners1901/1902. Corrected View.prior obtains actualWorldnamespace and projects physical live flags through namespace-awareacceptedobserver; fullresourcecells appended. Each snapshot enablesdebug, foldsownerunchanged and emits physical then same-declarationoptionalParent/Children descriptor+ascendinglive rows. Foreign2:1,missing1:99 anddead1:1 each fourinstalledAppmethods rejectbeforetraversal; publicdeactivate changesonlylocalLive1, retainingpayload/resource/owners/peer. Afterlocalrecipe omitsdeadrow1. Stringformatter carriesexacttext LF andIO.print terminalLF. Old401f peerhardcodednamespace observation withdrawn, old5099 arityfailurepreserved. No runtimeoutputs used.','limits':'Two nominalschemas,24requests/8completeWorld+recipe snapshots. No cleanup/disposal, queuedforeignwrite, TS/performance/universalproof.'}
    b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
    oracle={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
    (HERE/'ORACLES.json').write_text(json.dumps({'normal':oracle,'foreign':oracle},indent=2)+'\n')
    result={'sourcePins':len(pins),'requests':24,'snapshots':8,**oracle};(HERE/'SELFTEST.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
if __name__=='__main__':regenerate()
