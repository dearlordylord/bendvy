"""Unbound source-only all-query/liveness draft. No generated oracle yet."""
import runpy
from pathlib import Path
DEPENDENCY=Path(__file__).resolve().parents[3]/'independent-oracle-v1'/'model.py.source'
BASE=runpy.run_path(str(DEPENDENCY))
class World(BASE['World']):
    def __init__(self):
        super().__init__();self.applied=True;self.live={1,2,3,4}
    def physical(self):
        prefix=super().physical().split('|live=',1)[0]
        return prefix+'|live='+''.join('1,' if i in self.live else '0,' for i in range(16))+'|resource-all=17,18,'
    def snapshot(self,label):
        rows=BASE['recipe']([(2,1),(3,1),(4,2)],[(1,[2,3]),(2,[4])])
        rows=[rows[0]]+[row for i,row in enumerate(rows[1:],1) if i in self.live]
        return label+'|owners=901,902,\n'+'\n'.join([self.physical()]+rows)+'\n'
    def visit_all(self,label,breadth=False):
        raw=[2,3,4] if breadth else [2,4,3]
        selected=[i for i in raw if i in self.live]
        return label+'|path='+''.join('1:'+str(i)+',' for i in raw)+'|Success|values=['+', '.join(str(i) for i in selected)+']'
def scene():
    w=World();rows=[w.snapshot('APPLIED'),w.visit_all('LIVE_DEPTH'),w.visit_all('LIVE_BREADTH'),'DEACTIVATE:Accepted']
    w.live.remove(4)
    rows.extend([w.snapshot('DEACTIVATED'),w.visit_all('DEAD_DEPTH'),w.visit_all('DEAD_BREADTH'),w.snapshot('FINAL')])
    return '\n'.join(rows)
def expected():return ('AllQueryAlpha'+scene()+'\nAllQueryBeta'+scene()+'\n').encode()
if __name__=='__main__':
    import sys
    sys.stdout.buffer.write(expected())
