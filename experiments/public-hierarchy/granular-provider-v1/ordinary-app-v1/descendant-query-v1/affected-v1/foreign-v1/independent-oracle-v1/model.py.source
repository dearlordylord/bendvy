"""Unbound source-only foreign descendant visitor draft; no generated packet."""
class World:
    def __init__(self,namespace):
        self.namespace=namespace;self.live={1,2,3,4};self.resource=[17,18] if namespace==1 else [27,28];self.owners=[901,902] if namespace==1 else [1901,1902]
    def physical(self):
        columns='absent;2,20,;absent;4,40,;absent;absent;absent;absent;'
        next_id,high=(6,5) if self.namespace==1 else (5,4)
        resource=''.join(str(i)+',' for i in self.resource)
        meta=f'{self.namespace},{next_id},{high},8,3,'+resource+',1,0'
        live=''.join('1,' if i in self.live else '0,' for i in range(16))
        return columns+'|stamps=|events=|meta='+meta+'|registrations=|pending=0|edges=graph-edges=|graph-inverses=|live='+live+'|resource-all='+resource
    def snapshot(self,label):
        lines=[self.physical(),'Relation{key=1|name=Parent|inverse=Children|kind=Hierarchy}']
        lines.extend(f'{self.namespace}:{i}:[Parent:Outgoing:Missing, Children:Incoming:Missing]' for i in sorted(self.live))
        return label+'|owners='+''.join(str(i)+',' for i in self.owners)+'\n'+'\n'.join(lines)+'\n'
def read():return 'DEPTH|path=MissingEntity|NOT_EXECUTED\nBREADTH|path=MissingEntity|NOT_EXECUTED'
def scene():
    local,peer=World(1),World(2)
    rows=[local.snapshot('LOCAL_BEFORE'),peer.snapshot('PEER_BEFORE'),'FOREIGN_READ:'+read(),'MISSING_READ:'+read(),'DEACTIVATE:Accepted','DEAD_READ:'+read()]
    local.live.remove(1);rows.extend([local.snapshot('LOCAL_AFTER'),peer.snapshot('PEER_AFTER')])
    return '\n'.join(rows)
def expected():return ('DescendantForeignAlpha\n'+scene()+'\nDescendantForeignBeta\n'+scene()+'\n').encode()
if __name__=='__main__':
    import sys
    sys.stdout.buffer.write(expected())
