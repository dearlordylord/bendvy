"""Finite foreign visitor model, current-source checks and complete serialization."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def regenerate():
    freeze=HERE.parent/'FREEZE.json';assert sha(freeze)=='ed1cb67a16275c8ac899543b1bd1f0717846046f755932b127b5f622a81cf551'
    capture=json.loads(freeze.read_text());pins=capture['sourceInventory'].copy();assert len(pins)==78
    for p,h in pins.items():assert sha(p)==h,p
    m=runpy.run_path(str(HERE/'model.py.source'));local,peer=m['World'](1),m['World'](2)
    assert '|meta=1,6,5,8,3,17,18,,1,0|' in local.physical()
    assert '|meta=2,5,4,8,3,27,28,,1,0|' in peer.physical()
    assert '|live=0,1,1,1,1,0,' in peer.physical()
    before=local.physical();peer_before=peer.physical();local.live.remove(1)
    assert before.split('|live=',1)[0]==local.physical().split('|live=',1)[0] and peer.physical()==peer_before
    assert '1:1:[Parent:' not in local.snapshot('AFTER') and '2:1:[Parent:' in peer.snapshot('AFTER')
    raw=m['expected']();text=raw.decode()
    assert text.count('|meta=')==8 and text.count('|path=MissingEntity|NOT_EXECUTED')==12
    assert text.count('DEACTIVATE:Accepted')==2 and text.count('|pending=0')==8
    assert text.count('|owners=901,902,')==4 and text.count('|owners=1901,1902,')==4
    assert text.count('|resource-all=17,18,')==4 and text.count('|resource-all=27,28,')==4
    assert text.count('absent;2,20,;absent;4,40,;absent;absent;absent;absent;')==8
    assert text.count('|stamps=|events=')==8
    for p in [freeze,HERE/'model.py.source',HERE/'regenerate.py.source',Path('/home/node/.bend/bend2/base.bend'),Path('/home/node/.bend/bend2/effs/print.js'),Path('/home/node/.bend/bend2/effs/print.c')]:pins[str(p)]=sha(p)
    basis={'producerCommit':'e5543f431','sourcePins':pins,'entry':str(HERE.parent/'consumer.bend'),'sourcePositive':capture['sourcePositive'],'derivation':'Immutable corrected source04 only. ONE Factory threads actual first creation namespace1 into second creation namespace2. Seed.spawn reserves/activates four handles and prepends each; nested Con destructure retains actual h1 from tail for localRoot/peerRoot. Additional actual local reservation returns inactive missing h5; metadata localnext6/high5 vspeernext5/high4. Actual peerRoot forwarded to foreign visit, missing h5 to missing visit, localRoot to publicdeactivate and deadvisit; no manufactured target constructors. Library lookup returns None for foreign/inactive/dead targets; adapter preserves MissingEntity raw path and None execution, no callback or transaction. Both Depth/Breadth requests each for three target conditions, twelve visits total. Four physical/recipe snapshots per schema retain components only2/4, both full resource cells17/18 vs27/28 and owners901/902 vs1901/1902. Namespace-aware physical observer obtains actual W.namespace and validates sixteen handles; deactivation changes local live1 only, component owners and graph remain unchanged. Empty graph preserves Parent/Children descriptors, currentlive recipe rows ascending namespace/id; local row1 omitted afterdeactivate, peer rows1..4 retained. Worldclock0/stamps/events/registrations/pending unchanged. Snapshot terminal LF and helper separators preserved; main labels endLF; IO.print adds finalLF. Source-only standalone Python, no runtime output inputs.','history':'Original source66111/predecessorFREEZE035045 used literal peer/local handles and is not current applicability; later source failures retained by author. Only source04 current returned handle flow is bound.','limits':['Finite two schemas/eight full physical states/twelve nonexecuted visits; no proof.','No callback/rollback/liveness-order mutation occurs in this foreign fixture.','Deactivation is not cleanup/disposal; component2/4 retained.','Factory continuity is source-derived, but final Factory object is not printed and no extra output is invented.','No TS/performance/full44/general ownership policy credit.']}
    b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
    (HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    oracle={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
    (HERE/'ORACLES.json').write_text(json.dumps({'normal':oracle},indent=2)+'\n')
    result={'sourcePins':len(pins),'physicalSnapshots':8,'visitResults':12,**oracle};(HERE/'SELFTEST.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
if __name__=='__main__':regenerate()
