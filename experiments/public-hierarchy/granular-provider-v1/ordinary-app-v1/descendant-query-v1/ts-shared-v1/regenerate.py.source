"""Independent finite TS transcript: validate source pins before serializing."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def regenerate():
    freeze=HERE/'FREEZE.json';capture=json.loads(freeze.read_text());pins=capture['sourceInventory'].copy();assert len(pins)==35
    assert sha(HERE/'reference.mjs')=='f76b8345b68b1f027ae88d93667afef02c96475495346b363d0dbefcb413dbea'
    for p,h in pins.items():assert sha(p)==h,p
    m=runpy.run_path(str(HERE/'model.py.source'));query=m['scenario']('descendant-query');root=m['scenario']('root-repeat')
    assert [(r['physical']['frame'],r['physical']['tick']) for r in query['records']]==[(2,3),(4,5),(7,8),(9,10),(11,12),(13,14)]
    q=query['records'];assert q[2]['logical']['rows']==q[3]['logical']['rows']==[{'id':2,'cells':[2,20]},{'id':4,'cells':[4,40]}]
    assert q[4]['logical']['rows']==q[5]['logical']['rows']==[{'id':2,'cells':[102,202]},{'id':4,'cells':[104,204]}]
    a=query['attempts'];assert len(a)==8 and a[2]['rows']==[{'id':2,'before':[2,20]},{'id':4,'before':[4,40]}]
    assert a[2]['path']=={'ok':True,'value':[{'kind':'EntityId','value':i} for i in (2,4,3)]}
    assert a[3]['outcome']=={'ok':False,'error':{'kind':'SystemFailure','system':'Visit','error':4}}
    assert [r['label'] for r in root['records']]==['INITIAL','ABORTED','PENDING','APPLIED','ROOT_PENDING','DUPLICATE_PENDING','ROOT_APPLIED','DEAD_REPEAT_PENDING','DEAD_REPEAT_APPLIED']
    assert [(r['physical']['frame'],r['physical']['tick']) for r in root['records']]==[(3,5),(6,8),(8,10),(10,12),(12,14),(14,16),(16,18),(18,20),(20,22)]
    r=root['records'];assert r[0]['logical']['rows']==r[1]['logical']['rows']
    assert r[3]['logical']['removed']==r[3]['logical']['despawned']==[4,2]
    assert r[6]['logical']['removed']==r[6]['logical']['despawned']==[3,1]
    assert r[6]['physical']['entities']==r[7]['physical']['entities']==r[8]['physical']['entities']==[]
    assert r[5]['physical']['pendingCommands']==[{'tag':'despawn','system':'Cleanup'}]*2
    assert r[7]['physical']['pendingCommands']==[{'tag':'despawn','system':'Cleanup'}] and r[8]['physical']['pendingCommands']==[]
    assert all(record['streams']==[] for scene in (query,root) for record in scene['records'])
    raw=m['expected']();parsed=json.loads(raw);assert len(parsed)==2 and parsed[0]['scenarios']==parsed[1]['scenarios']
    assert list(parsed[0])==['schema','scenarios'] and list(q[0])==['logical','label','physical','streams']
    assert list(q[0]['physical'])==['version','frame','tick','entityCount','entities','resources','machines','pendingCommands']
    for p in [freeze,HERE/'model.py.source',HERE/'regenerate.py.source']:pins[str(p)]=sha(p)
    basis={'producerCommit':'bbb92f0b8','sourcePins':pins,'entry':str(HERE/'reference.mjs'),'referenceHeads':capture['referenceHeads'],'derivation':'Pinned public source only. World ids allocate1..4. Every runtime.tick advances frame; every system advances tick, each explicit deferred flush advances tick. Debug.dump literal key order version/frame/tick/entityCount/entities/resources/machines/pendingCommands; sorted live entity rows retain components/relations object insertion order. Observer writes only external records, reads full query selection Cells, traversal for original ids, removed/despawned logs since prior successful Observe tick. Streams reports event/transition/relationFailure keys, no lifecycle logs; this scene has no such stream keys. DescendantMatches filters absent Cells3: Depth2,4; Breadth2,4 although raw paths differ. One Visit System transaction journals both cell replacements; Fx.fail4 rolls both back, retains advanced tick and external attempted rows, drops commands, leaves successful reader cursor unchanged. Retry and Breadth commit replacements. Raw attempt.path retains EntityId{kind,value} objects after JSON clone drops undefined schema/root; observer traversal explicitly converts handles to numeric values. Root despawn recursively follows linked Parent children postorder4,2 then3,1, ordinarily unrelates Link sources. Removed/despawned observations each deliver corresponding ids once by actual reader cursor. Aborted cleanup drops its queued command. Duplicate live queued commands both survive until flush, second application sees absent root and no-ops. Later dead-target commands.despawn still queues a command and succeeds; world.destroyEntity no-ops only during flush. Runtime resources retain literal Owned/Owners arrays; no affine ownership claim. Main JSON.stringify object construction order plus console.log terminal LF reproduced independently. No actual output inputs.','logicalJoinScope':'Only shared scenario observations: component presence/value arrays, retained resource/owner values, hierarchy paths and selected rows, failed-system rollback, postorder removal and pending barrier visibility. TS ticks/frame/ids/readercursors/result/queue-deadtarget/public dump differ from Bend; no whole-wire equality with8537/13855 or ownership equivalence.','limits':['Finite public JSON model, not proof/law or full hierarchy qualification.','No raw lifecycle log/internal cursor exposed or manufactured.','No services/describe call in this fixture; omitted services config never accessed by empty service specs or dump.','External attempted rows are diagnostics outside ECS transaction.','No Node feature execution by model author, no timing or IO Drop claim.']}
    b=HERE/'INDEPENDENT-SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
    (HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    oracle={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
    (HERE/'ORACLES.json').write_text(json.dumps({'normal':oracle},indent=2)+'\n')
    result={'sourcePins':len(pins),'schemas':2,'physicalSnapshots':30,**oracle};(HERE/'SELFTEST.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
if __name__=='__main__':regenerate()
