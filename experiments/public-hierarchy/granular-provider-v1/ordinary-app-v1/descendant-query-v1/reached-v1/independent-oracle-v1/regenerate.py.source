"""Prepared-only independent reverse-invocation counteroracle."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def regenerate():
    context=HERE.parent/'PREPARED.json';c=json.loads(context.read_text());target=Path(c['target']);prepared=Path(c['preparedPath'])
    assert c['status']=='PREPARED_NOT_APPLIED' and sha(target)==c['beforeSHA256'] and sha(prepared)==c['afterSHA256']
    assert prepared.read_text().count(c['inverse']['after'])==1
    assert prepared.read_text().replace(c['inverse']['after'],c['inverse']['before'])==target.read_text()
    m=runpy.run_path(str(HERE/'model.py.source'));w=m['World']();w.applied=True
    assert w.visit(fail=True)==([2,4,3],'UserError:4',[]) and w.clock==1
    assert w.payloads=={2:[2,20],4:[4,40]} and w.stamps==[(4,(0,0))]
    assert w.visit()==([2,4,3],'Success',['4:before=4,40,','2:before=2,20,']) and w.clock==3
    assert w.stamps==[(2,(0,3)),(4,(0,2))]
    assert w.visit(True)==([2,3,4],'Success',['4:before=104,204,','2:before=102,202,']) and w.clock==5
    assert w.stamps==[(2,(0,5)),(4,(0,4))]
    raw=m['expected']();normal=m['NORMAL']['expected']();allraw=m['expected_all']();allnormal=m['ALL']['expected']()
    assert len(normal)==8537 and hashlib.sha256(normal).hexdigest()=='1700f00cce53a5b604b71ab0df4c8e4103f895b840d71eb449742106d0fbd4c4'
    assert len(allnormal)==4589 and hashlib.sha256(allnormal).hexdigest()=='a1d649839f02164c049bf6f88d8928d6298773622437d2cc8a7b2fcfd3555326'
    old,new=normal.decode().splitlines(),raw.decode().splitlines();assert len(old)==len(new)
    differences=[i for i,(a,b) in enumerate(zip(old,new)) if a!=b]
    assert len(differences)==10
    for a,b in zip(old,new):
        if '|path=' in a:assert a.split('|Success|',1)[0].split('|UserError:',1)[0]==b.split('|Success|',1)[0].split('|UserError:',1)[0]
        if '|meta=' in a:
            assert a.split('|resource-all=',1)[1]==b.split('|resource-all=',1)[1]
    ao,an=allnormal.decode().splitlines(),allraw.decode().splitlines()
    assert len(ao)==len(an) and sum(a!=b for a,b in zip(ao,an))==8
    assert all(a==b for a,b in zip(ao,an) if '|path=' not in a)
    referenceBasis=m['ROOT']/'independent-oracle-v1/SOURCE-BASIS.json';normalpins=json.loads(referenceBasis.read_text())['sourcePins']
    for p,h in normalpins.items():assert sha(p)==h,p
    pins={p:h for p,h in normalpins.items() if p!=str(target)}
    for p in [context,prepared,referenceBasis,m['NORMAL_DEPENDENCY'],m['ALL_DEPENDENCY'],HERE/'model.py.source',HERE/'regenerate.py.source']:pins[str(p)]=sha(p)
    basis={'status':'PREPARED_NOT_APPLIED','sourcePins':pins,'normalReferencePins':normalpins,'normalRootPrecondition':{'path':str(target),'sha256':c['beforeSHA256']},'preparedRoot':{'path':str(prepared),'sha256':c['afterSHA256']},'runtimeBindingRequirement':'No applied/current mutant claim. Before source/JSNative execution root must actually apply75bf and owner independently capture imported mutable target+complete actual caller closure; execution guards must pin target75bf, never historical normalec312. sourcePins intentionally omits mutable normal target and retains prepared bytes, model and all other unchanged dependencies.','derivation':'Source-only literal single-arm inverse. live_handles validates head then recursively computes tail before live_prepend. Tail append instead of cons reverses only selected live invocation handles; raw Path preserved. Required Cells selection subsequently skips absent3. FailedDepth raw2,4,3 invokes3skip then4fail before2: one write tick1, rollback restores4 with explicitzero stamp, values empty. Retry4then2 ticks2/3; Breadth4then2 ticks4/5. Physical clock/stamp changes follow fewer failed callbacks, all other owners/resource/graph/rawPaths/recipe preserved. All-query liveDepth3,4,2 and Breadth4,3,2; afterdead4 both3,2; full physical snapshots identical. Baselines generated by immutable source algorithms, never observed outputs.','normalModelCommit':'660545f30','allModelCommit':'630e3d43d','limits':['Prepared source countercontrol only, no applied source/type/runtime qualification.','No new rollback/order/liveness contract, proof or law.','Whole first-consumer baseline rejection required; optional all-query transcript is already drafted source-context evidence, not added runtime matrix.']}
    b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
    def write(name,value,baseline):
        out=HERE/(name+'.stdout.gz');out.write_bytes(gzip.compress(value,mtime=0));(HERE/(name+'.stdout')).write_bytes(value)
        base=HERE/(name+'.normal-baseline.stdout.gz');base.write_bytes(gzip.compress(baseline,mtime=0))
        return {'stdout':str(out),'bytes':len(value),'sha256':hashlib.sha256(value).hexdigest(),'normalBaseline':str(base),'normalBaselineBytes':len(baseline),'normalBaselineSHA256':hashlib.sha256(baseline).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b),'status':'PREPARED_NOT_APPLIED'}
    oracles={'mutant':write('expected',raw,normal),'all-query':write('all-query',allraw,allnormal)}
    (HERE/'ORACLES.json').write_text(json.dumps(oracles,indent=2)+'\n')
    result={'sourcePins':len(pins),'firstChangedLines':differences,'allChangedLines':8,'oracles':oracles};(HERE/'SELFTEST.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
if __name__=='__main__':regenerate()
