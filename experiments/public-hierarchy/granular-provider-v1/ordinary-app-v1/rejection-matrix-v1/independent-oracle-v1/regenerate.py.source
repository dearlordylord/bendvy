"""Current-source pinning and full finite rejection-owner checks."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def regenerate():
    freeze=HERE.parent/'FREEZE.json';assert sha(freeze)=='7b487d997541124ec7c0e6d4a00951ec7b9e661d8fa4865b456b0c0d8f2646a5'
    capture=json.loads(freeze.read_text());pins=capture['sourceInventory'].copy();assert len(pins)==74
    for p,h in pins.items():assert sha(p)==h,p
    m=runpy.run_path(str(HERE/'model.py.source'));w=m['World']();w.edges=[(2,1),(3,1),(4,2)];w.inverses=[(1,[2,3]),(2,[4])]
    errors=[]
    for label,op,source,target in m['ACTIONS']:
        before=(list(w.edges),[(p,list(xs)) for p,xs in w.inverses],set(w.live));w.pending=1;w.apply_rejection(op,source,target)
        assert (w.edges,w.inverses,w.live)==before and w.pending==0
        errors.append(w.events[-1])
    assert errors==['Failure:1:Parent:Children:hierarchy:relate:1:1:SelfRelationNotAllowed:1:Parent','Failure:1:Parent:Children:hierarchy:relate:1:4:HierarchyCycle:1:4:Parent','Failure:1:Parent:Children:hierarchy:reorderChildren:1:5:MissingChildEntity:1:5:Parent','Failure:1:Parent:Children:hierarchy:reorderChildren:1:3:DuplicateChild:1:3:Parent','Failure:1:Parent:Children:hierarchy:reorderChildren:1:4:ChildNotRelatedToParent:1:4:Parent','Failure:1:Parent:Children:hierarchy:reorderChildren:1:1:ChildSetMismatch:1:Parent']
    raw=m['expected']();text=raw.decode();assert text.count('|meta=')==44 and text.count('|owners=901,902,')==44
    assert text.count('|resource-all=17,18,')==44 and text.count('|meta=1,6,5,8,3,17,,1,0')==44
    assert text.count('.QUEUE:Queued:Success')==12 and text.count('|pending=1')==12 and text.count('|pending=3')==2
    assert text.count('|stamps=|events=')==44 and text.count('|registrations=')==44
    assert text.count('graph-edges=1:Parent:Children:hierarchy:2:1;1:Parent:Children:hierarchy:3:1;1:Parent:Children:hierarchy:4:2;')==40
    for p in [freeze,HERE/'model.py.source',HERE/'regenerate.py.source',Path('/home/node/.bend/bend2/base.bend'),Path('/home/node/.bend/bend2/effs/print.js'),Path('/home/node/.bend/bend2/effs/print.c')]:pins[str(p)]=sha(p)
    basis={'producerCommit':'a0714fb87','sourcePins':pins,'entry':str(HERE.parent/'consumer.bend'),'derivation':'Actual frozen ordinary App callsites, source-only. Seed.spawn returns h4,h3,h2,h1; actual additional reserve returns inactiveh5. Rootfc123 reorder_app delegates existing Reorder.invoke body through ordinary Relation.queued/transactionfinish. All six actions have same namespace, so queue checks return Queued:Success and one deferred callback; semantic errors arise at barrier, not queue. Self1to1 andcycle1to4 use existing relate validation. Reorder parent1 children [5,3,2] firstfails inactive5; [3,3,2] firstfails duplicate3; [4,3,2] firstfails unrelated4; [3] childrenvalid but set differs from inverse[2,3]. CoreResult rejection returns exact graph/inverses. Error target maps child errors to5/3/4, setmismatch toparent1. Event_publish appends full RelationFailed descriptor/operation/source/target/error in authored order without clockadvance. Twenty-two snapshots per schema: three initial; six before/queued/applied triples; final. Current metadata1,6,5/cap8/depth3, all4live plus inactive5, affinepayload[tagid,Arrayid10id]1..4, resource17/18 andowners901/902, emptystamps/registrations/clock0 retained. Recipe returns Parent descriptor and four outgoing/incoming rows with sources[2,3] and[4]. Manual String notice formatting uses full six error payloads reached here, separators/source newline concatenation and IO.print terminalLF preserved. Standalone stdlib model, no observed runtime inputs.','limits':['Finite two schemas/44 snapshots/six exact rejection cases each; not proof/law/full44.','No valid reordered-child success, foreign or missing-parent case in this scene.','No physical disposal/cleanup/registered runner/general finalizer/TS/performance claim.','QueueSuccess differs from deferredsemanticRelationFailed; model preserves both boundaries.']}
    b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
    (HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    oracle={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
    (HERE/'ORACLES.json').write_text(json.dumps({'normal':oracle},indent=2)+'\n')
    result={'sourcePins':len(pins),'physicalSnapshots':44,'failureKinds':6,**oracle};(HERE/'SELFTEST.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
if __name__=='__main__':regenerate()
