"""Prepared-only full ordinary reorder omission counteroracle."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def regenerate():
    context=HERE.parent/'PREPARED.json';c=json.loads(context.read_text());target=Path(c['target']);prepared=HERE.parent/'prepared-targets/ordinary-app-hierarchy.bend'
    assert c['status']=='PREPARED_NOT_APPLIED' and sha(target)==c['normalSHA256'] and sha(prepared)==c['preparedSHA256']
    old,new=c['oldExpression'],c['newExpression'];assert target.read_text().count(old)==1 and prepared.read_text().count(new)==1
    assert prepared.read_text().replace(new,old)==target.read_text()
    m=runpy.run_path(str(HERE/'model.py.source'));raw=m['expected']();normal=m['NORMAL']['expected']()
    assert len(normal)==41133 and hashlib.sha256(normal).hexdigest()=='41820a452c5b720b4e36436936e4dbeae8699f5fc584aa98701600261730ccfa'
    text=raw.decode();assert text.count('|meta=')==44 and text.count('.QUEUE:Queued:Success')==12
    assert text.count('|pending=1')==4 and text.count('|pending=3')==2
    assert 'MissingChildEntity:' not in text and 'DuplicateChild:' not in text and 'ChildNotRelatedToParent:' not in text and 'ChildSetMismatch:' not in text
    a,b=normal.decode().splitlines(),text.splitlines();assert len(a)==len(b)
    differences=[i for i,(x,y) in enumerate(zip(a,b)) if x!=y]
    assert len(differences)==24
    assert all('|meta=' in a[i] and '|meta=' in b[i] for i in differences)
    def without_effects(line):
        prefix,tail=line.split('|events=',1);_,tail=tail.split('|meta=',1);head,pending=tail.split('|pending=',1);_,rest=pending.split('|edges=',1)
        return prefix+'|meta='+head+'|edges='+rest
    assert all(without_effects(a[i])==without_effects(b[i]) for i in differences)
    normalBasis=m['DEPENDENCY'].parent/'SOURCE-BASIS.json';reference=json.loads(normalBasis.read_text())['sourcePins']
    for p,h in reference.items():assert sha(p)==h,p
    pins={p:h for p,h in reference.items() if p!=str(target)}
    for p in [context,prepared,normalBasis,m['DEPENDENCY'],HERE/'model.py.source',HERE/'regenerate.py.source']:pins[str(p)]=sha(p)
    basis={'producerCommit':'a27f653f5','preparationHistory':'Initial finite selfcheck guessed28 changedlines and refused before any output files were produced. Independent normal/counter source-algorithm comparison established24: twelve per schema. Only count assertion corrected; no source/model expected values changed, no actual runtime inputs.','status':'PREPARED_NOT_APPLIED','sourcePins':pins,'normalReferencePins':reference,'normalRootPrecondition':{'path':str(target),'sha256':c['normalSHA256']},'preparedRoot':{'path':str(prepared),'sha256':c['preparedSHA256']},'runtimeBindingRequirement':'Actual root-applied dbdb public module and complete actual caller closure must be captured and pinned before source/JSNative. Mutable normal rootfc123 is excluded from sourcePins; normalReferencePins/precondition are historical/source derivation only, not mutant execution guards.','normalModelCommit':'6b30b11e2','derivation':'Exact one-expression inverse: reorder_app replaces Reorder.invoke with empty Tx.begin and Queued; ordinary Relation.queued finishing remains. Fourreorders therefore return Queued:Success but stage no callback, queuedpending0 and appliedbarriers addnoRelationFailed. Existing relate_app self/cycle untouched: eachpending1 then fullSelfRelationNotAllowed/HierarchyCycle notice. Subsequent eventsretainonlythosetwo; full44physical/recipe snapshots source-derived using immutable normalmodelalgorithm. Allgraph/inverses/live/payload/stamps/resource17/18/owners901/902/registrations/clock0 unchanged. Raw errors absent due unreachableReorder.invoke, not formatter weakening. Complete41133baseline regenerated from source, never observedoutput.','limits':['Prepared conditional counter only; no current imported mutant/source or runtime credit.','No contracts/laws/proofs/TS/performance/full44 claim.','Twenty-four changed physical lines contain only notice/pending differences; all other complete lines preserved.']}
    basisPath=HERE/'SOURCE-BASIS.json';basisPath.write_text(json.dumps(basis,indent=2)+'\n')
    out=HERE/'expected.stdout.gz';out.write_bytes(gzip.compress(raw,mtime=0));(HERE/'expected.stdout').write_bytes(raw)
    base=HERE/'normal-baseline.stdout.gz';base.write_bytes(gzip.compress(normal,mtime=0))
    oracle={'stdout':str(out),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'normalBaseline':str(base),'normalBaselineBytes':len(normal),'normalBaselineSHA256':hashlib.sha256(normal).hexdigest(),'sourceBasisPath':str(basisPath),'sourceBasisSHA256':sha(basisPath),'status':'PREPARED_NOT_APPLIED'}
    (HERE/'ORACLES.json').write_text(json.dumps({'mutant':oracle},indent=2)+'\n')
    result={'sourcePins':len(pins),'physicalSnapshots':44,'changedLines':differences,**oracle};(HERE/'SELFTEST.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
if __name__=='__main__':regenerate()
