"""Unbound prepared-only public reorder omission countermodel."""
import runpy
from pathlib import Path
DEPENDENCY=Path(__file__).resolve().parents[2]/'independent-oracle-v1/model.py.source'
NORMAL=runpy.run_path(str(DEPENDENCY))
def scene():
    w=NORMAL['World']();rows=[w.snapshot('INITIAL_BEFORE')];w.pending=3;rows.append(w.snapshot('INITIAL_PENDING'))
    w.pending=0;w.edges=[(2,1),(3,1),(4,2)];w.inverses=[(1,[2,3]),(2,[4])];rows.append(w.snapshot('INITIAL_APPLIED'))
    for label,operation,source,target in NORMAL['ACTIONS']:
        rows.append(w.snapshot(label+'.BEFORE'));rows.append(label+'.QUEUE:Queued:Success')
        # Only unchanged relate stages a callback. Prepared reorder begins an empty Tx.
        w.pending=1 if operation=='relate' else 0
        rows.append(w.snapshot(label+'.QUEUED'))
        if operation=='relate':w.apply_rejection(operation,source,target)
        rows.append(w.snapshot(label+'.APPLIED'))
    rows.append(w.snapshot('FINAL'));return '\n'.join(rows)
def expected():return ('RejectionsAlpha\n'+scene()+'\nRejectionsBeta\n'+scene()+'\n').encode()
