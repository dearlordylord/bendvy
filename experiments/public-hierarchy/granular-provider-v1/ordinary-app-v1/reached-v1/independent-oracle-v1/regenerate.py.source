"""Prepared-only order countermodel; current root must remain normal."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def regenerate():
    context=HERE.parent/'PREPARED-MUTATION.json';delta=json.loads(context.read_text())
    target=Path(delta['target']);prepared=Path(delta['preparedPath'])
    assert sha(target)==delta['beforeSHA256']
    assert sha(prepared)==delta['afterSHA256']
    assert target.read_text().count(delta['before'])==1
    assert target.read_text().replace(delta['before'],delta['after'])==prepared.read_text()
    normaldir=HERE.parents[1]/'independent-oracle-v1'
    normal=runpy.run_path(str(normaldir/'model.py.source'))['expected']()
    raw=runpy.run_path(str(HERE/'model.py.source'))['expected']()
    rows=normal.decode().splitlines();changed=raw.decode().splitlines()
    diffs=[i for i,(a,b) in enumerate(zip(rows,changed)) if a!=b]
    assert len(rows)==len(changed) and len(diffs)==4
    for i in diffs:
        left,right=rows[i].split('|depth=');other,after=changed[i].split('|depth=')
        assert left==other
        assert right.split('|breadth=')[1]==after.split('|breadth=')[1]
        assert after.split('|breadth=')[0]==after.split('|breadth=')[1]
    assert [r for r in rows if '|meta=' in r]==[r for r in changed if '|meta=' in r]
    pins=json.loads((normaldir/'SOURCE-BASIS.json').read_text())['sourcePins'].copy()
    for path,digest in pins.items():assert sha(path)==digest,path
    for path in [context,prepared,normaldir/'model.py.source',normaldir/'SOURCE-BASIS.json',HERE/'model.py.source',HERE/'regenerate.py.source']:pins[str(path)]=sha(path)
    (HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    b=HERE/'SOURCE-BASIS.json';basis={'sourceCommit':'401f7127f','status':'PREPARED_NOT_APPLIED','sourcePins':pins,'normalRootPrecondition':delta['beforeSHA256'],'runtimeBindingRequirement':{'target':str(target),'requiredAppliedSHA256':delta['afterSHA256'],'preparedSourcePinsAreNotRuntimePins':True},'preparedMutation':delta['afterSHA256'],'derivation':'Only ordinary-App descendants dispatch discards actual requested order and chooses Breadth; underlying granular provider unchanged. Finite graph interpreter therefore uses breadth queue for Depth and Breadth. Four Depth lines change; allroot,ancestors,breadth,targetentity andphysicalowners identical.32positions/128requests/10physicalstates unchanged. No runtime output inputs. Actual source applicability requires later rootapplied receipt and fresh stock source capture.','limits':'Conditional finite source countermodel only; no mutation applied/current runtime/backend/proof/performance credit.'};b.write_text(json.dumps(basis,indent=2)+'\n')
    oracle={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b),'normalBaseline':str(normaldir/'expected.stdout.gz'),'normalBaselineBytes':len(normal),'normalBaselineSHA256':hashlib.sha256(normal).hexdigest()}
    (HERE/'ORACLES.json').write_text(json.dumps({'mutant':oracle},indent=2)+'\n')
    result={'sourcePins':len(pins),'changedDepthLines':diffs,**oracle};(HERE/'SELFTEST.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
if __name__=='__main__':regenerate()
