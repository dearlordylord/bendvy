"""Independent granular request transcript; no runtime outputs or aggregate Frame lookup."""
from collections import deque
DESCRIPTOR='1:Parent:Children:hierarchy'
def ids(values):return ''.join(str(x)+',' for x in values)
def handles(values):return ''.join('1:'+str(x)+',' for x in values)
def frames(edges,inverses):
    parents=dict(edges);children=dict(inverses);out=[]
    for entity in range(1,5):
        ancestors=[];p=parents.get(entity)
        while p is not None:
            ancestors.append(p);p=parents.get(p)
        walks=[]
        for breadth in (False,True):
            pending=list(children.get(entity,[]));seen=[]
            while pending:
                current=pending.pop(0);seen.append(current)
                following=children.get(current,[])
                pending=pending+following if breadth else following+pending
            walks.append(seen)
        root=ancestors[-1] if ancestors else entity
        out.append('entity=1:'+str(entity)+'|root=1:'+str(root)+'|ancestors='+handles(ancestors)+'|depth='+handles(walks[0])+'|breadth='+handles(walks[1]))
    return out

def physical(edges,inverses,pending):
    owners=''.join((ids([i,i,10*i]) if i<=4 else 'absent')+';' for i in range(1,9))
    graph='graph-edges='+''.join(DESCRIPTOR+':'+str(a)+':'+str(b)+';' for a,b in edges)
    graph+='|graph-inverses='+''.join(DESCRIPTOR+':'+str(p)+':['+ids(xs)+'];' for p,xs in inverses)
    live=''.join('1,' if 1<=i<=4 else '0,' for i in range(16))
    return owners+'|stamps=|events=|meta=1,5,4,8,3,17,,1,0|registrations=|pending='+str(pending)+'|edges='+graph+'|live='+live

def recipe(edges,inverses):
    parents=dict(edges);children=dict(inverses)
    lines=['Relation{key=1|name=Parent|inverse=Children|kind=Hierarchy}']
    for i in range(1,5):
        outgoing='Missing' if i not in parents else 'Target:1:'+str(parents[i])
        incoming='Missing' if not children.get(i) else 'Sources:['+', '.join('1:'+str(c) for c in children[i])+']'
        lines.append(f'1:{i}:[Parent:Outgoing:{outgoing}, Children:Incoming:{incoming}]')
    return lines
def snapshot(label,edges,inverses,pending):
    return label+'|owners=901,902,\n'+'\n'.join([physical(edges,inverses,pending)]+recipe(edges,inverses))+'\n'
def readings(label,edges,inverses):return label+'\n'+'\n'.join(frames(edges,inverses))
def scene():
    initial=[(2,1),(3,1),(4,2)];before=[(1,[2,3]),(2,[4])]
    changed=[(2,1),(3,1),(4,3)];after=[(1,[2,3]),(3,[4])]
    chunks=[snapshot('BEFORE',[],[],0),readings('QUEUED_READS',[],[]),snapshot('INITIAL_PENDING',[],[],3),snapshot('INITIAL_APPLIED',initial,before,0),readings('INITIAL_READS',initial,before),readings('REPARENT_QUEUED_READS',initial,before),snapshot('REPARENT_PENDING',initial,before,1),snapshot('REPARENT_APPLIED',changed,after,0),readings('FINAL_READS',changed,after)]
    return '\n'.join(chunks)
def expected():return ('AppHierarchyAlpha\n'+scene()+'\nAppHierarchyBeta\n'+scene()+'\n').encode()
if __name__=='__main__':
    import sys
    sys.stdout.buffer.write(expected())
