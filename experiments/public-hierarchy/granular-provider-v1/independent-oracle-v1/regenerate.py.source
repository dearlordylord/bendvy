"""Source-only finite granular traversal oracle; no backend outputs."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def regenerate():
    freeze=HERE.parent/'FREEZE.json'
    pins=json.loads(freeze.read_text())['sourceInventory'].copy()
    for path,digest in pins.items():assert sha(path)==digest,path
    model=runpy.run_path(str(HERE/'model.py.source'))
    raw=model['expected']();text=raw.decode()
    assert text.count('entity=')==40 and text.count('|meta=')==10
    assert all(text.count('|'+field+'=')==40 for field in ('root','ancestors','depth','breadth'))
    assert '|parent=' not in text and '|children=' not in text
    assert text.count('|pending=1')==4 and text.count('|pending=0')==6
    old=Path('/workspace/formal-proofs/bendvy-worktrees/hierarchy44-public-traversal-v1/experiments/public-hierarchy/public-delivery-v1/full-frame-v2/independent-oracle-v1/model.py.source')
    baseline=runpy.run_path(str(old))['expected']().decode()
    assert [x for x in text.splitlines() if '|meta=' in x]==[x for x in baseline.splitlines() if '|meta=' in x]
    assert model['frames']([(2,1),(3,1),(4,2)],[(1,[2,3]),(2,[4])])[0]=='entity=1:1|root=1:1|ancestors=|depth=1:2,1:4,1:3,|breadth=1:2,1:3,1:4,'
    assert model['frames']([(2,1),(3,1),(4,3)],[(1,[3,2]),(3,[4])])[0]=='entity=1:1|root=1:1|ancestors=|depth=1:3,1:4,1:2,|breadth=1:3,1:2,1:4,'
    for path in [freeze,HERE/'model.py.source',HERE/'regenerate.py.source',old,Path('/home/node/.bend/bend2/effs/print.js'),Path('/home/node/.bend/bend2/effs/print.c')]:pins[str(path)]=sha(path)
    (HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    basis={'producerCommit':'da673b57c','sourcePins':pins,'entry':str(HERE.parent/'entry.bend'),'derivation':'Four separate rank-two grants per target, each retaining the actual World. Root consumes existing ancestors/root operation; ancestors and descendants call only their selected traversal after World.valid. Finite graph interpreter preserves stable edge replacement/inverse child ordering and FIFO barriers. Depth prepends children; Breadth appends. Same raw column payload tags/cells, empty stamps/events/registrations, clock0/resource17 and pending before/after barriers as original independent scene. Formatter prints target entity plus four actual returned requests, not aggregate Frame parent/children. Pinned IO.print adds one final LF. No observed runtime outputs used.','limits':'Two nominal schemas, five physical stages each,40 target positions and160 independent requests. Valid acyclic scene only; no registered system, cleanup, foreign authority, incomplete path, composition, performance or proof credit.'}
    b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
    oracle={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
    (HERE/'ORACLES.json').write_text(json.dumps({'normal':oracle},indent=2)+'\n')
    result={'sourcePins':len(pins),'targetPositions':40,'requests':160,'physicalStates':10,**oracle}
    (HERE/'SELFTEST.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
if __name__=='__main__':regenerate()
