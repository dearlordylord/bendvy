"""Independent source-only direct automatic cleanup foreign transcript."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def regenerate():
    complete=HERE.parents[1]/'SOURCE-COMPLETE.json'
    pins=json.loads(complete.read_text())['sourcePins'].copy()
    for path,digest in pins.items():assert sha(path)==digest,path
    m=runpy.run_path(str(HERE/'model.py.source'));raw=m['expected']();text=raw.decode()
    assert text.count('cleanup=Complete')==2 and text.count('|meta=')==8
    assert text.count('factoryNext=3')==2 and text.count('|pending=0')==8
    rows=[x for x in text.splitlines() if '|meta=' in x]
    assert rows[0]==rows[2] and rows[1]==rows[3] and rows[:4]==rows[4:]
    for path in [complete,HERE/'model.py.source',HERE/'regenerate.py.source',Path('/home/node/.bend/bend2/base.bend'),Path('/home/node/.bend/bend2/effs/print.js'),Path('/home/node/.bend/bend2/effs/print.c')]:pins[str(path)]=sha(path)
    (HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    basis={'producerCommit':'376b7556b','sourcePins':pins,'entry':str(HERE.parents[1]/'foreign.bend'),'derivation':'One actual Factory creates local namespace1/resource17 then peer namespace2/resource18/FactoryNext3. Reverse spawnhandle list selects id1 in each actual World. Direct public Cleanup.automatic enters through World.valid for foreign2:1 against namespace1, False produces no cleanup frames; run_loop returns Complete with original local World. Correct CleanupResult wrapper returns full Complete World; Incomplete frame serializer exists but branch unreached. Both physical World observations remain exact before/after: live4,payloadtag+two cells each, graphempty/stamps/events/registrations/pendingempty/clock0. Same behavior two nominal schemas. IO.print final LF. Source6469 wrong tuple-wrapper failure preserved and withdrawn. No runtime output inputs.','limits':'Finite direct concrete World foreign cleanup boundary only,8completeWorld observations. No opaque gameplay grant, queued foreign refusal, effectful finalizer, incomplete frame, disposal, performance/proof qualification.'}
    b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
    oracle={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
    (HERE/'ORACLES.json').write_text(json.dumps({'normal':oracle,'foreign':oracle},indent=2)+'\n')
    result={'sourcePins':len(pins),'physicalWorldObservations':8,**oracle};(HERE/'SELFTEST.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
if __name__=='__main__':regenerate()
