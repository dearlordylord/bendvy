"""Same finite cleanup semantics under the source-equivalent owned fold."""
from pathlib import Path
import runpy
DEPENDENCY=Path(__file__).resolve().parents[2]/'independent-oracle-v1/model.py.source'
SOURCE=runpy.run_path(str(DEPENDENCY))
World=SOURCE['World']
def expected():return SOURCE['expected']()
if __name__=='__main__':
    import sys
    sys.stdout.buffer.write(expected())
