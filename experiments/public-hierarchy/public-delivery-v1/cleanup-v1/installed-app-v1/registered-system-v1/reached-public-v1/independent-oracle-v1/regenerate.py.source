from pathlib import Path
import hashlib,json,gzip,runpy
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
b=json.loads((HERE/'SOURCE-BASIS.json').read_text())
for p,h in b['inputs'].items():assert sha(p)==h,p
raw=runpy.run_path(str(HERE/'model.py.source'))['expected']()
assert raw.count(b'|cursor=0')==b['snapshots']
assert raw.count(b'|registrations=1:LinkedCleanup:')==b['snapshots']
if b['kind']=='foreign':
 assert raw.count(b'ASSOCIATION=RegistrationRejected')==2
 assert raw.count(b'FOREIGN=MissingEntity:Success')==2 and raw.count(b'MISSING=MissingEntity:Success')==2
 assert b'|pending=1|' not in raw and b'meta=2,5,4,8,3,27,28' in raw
elif b['kind']=='product':
 assert raw.count(b'Original:4202;Original:4302;Original:1002;Original:4201;Original:4301;Original:1001;')==2
 assert raw.count(b'|pending=1|')==2 and b'meta=1,3,2,4,2' in raw
else:
 states=json.loads(Path(b['states']).read_text());normal=Path(states['target']).read_text()
 assert sha(states['target'])==states['normal']['sha256']
 before,after=states['replacement']['before'],states['replacement']['after']
 assert normal.count(before)==1
 assert hashlib.sha256(normal.replace(before,after).encode()).hexdigest()==states['mutant']['sha256']
 assert b'Removed:' not in raw and b'|pending=1|' not in raw
 baseline=gzip.decompress(Path(b['baseline']).read_bytes());assert len(baseline)==9103 and baseline!=raw
(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
key='prepared-mutant' if b['kind']=='prepared-counter' else 'normal'
o={key:{'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(HERE/'SOURCE-BASIS.json'),'sourceBasisSHA256':sha(HERE/'SOURCE-BASIS.json')}}
if b['kind']=='prepared-counter':o['normalBaseline']={'stdout':b['baseline'],'bytes':len(baseline),'sha256':hashlib.sha256(baseline).hexdigest()}
(HERE/'ORACLES.json').write_text(json.dumps(o,indent=2)+'\n')
(HERE/'CHECKS.json').write_text(json.dumps({'status':'SOURCE_DERIVED_COMPLETE_ORACLE_PASS','kind':b['kind'],'closurePins':86,'basisPins':len(b['inputs']),'snapshots':b['snapshots'],'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'limits':['No runtime outputs read','Prepared counter not applied or runtime qualified','Finite pure Array ownership observations; no IO destructor claim']},indent=2)+'\n')
print(b['kind'],len(raw),hashlib.sha256(raw).hexdigest())
