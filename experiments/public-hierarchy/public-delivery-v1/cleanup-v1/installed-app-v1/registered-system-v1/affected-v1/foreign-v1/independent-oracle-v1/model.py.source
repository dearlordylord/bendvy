"""Source-only registered linked-cleanup finite full transcript; no runtime inputs.
System.run_tracked reads World.clock after success; this callback only stages
cleanup. Neither registration, staging, barrier cleanup nor snapshots advance
World.clock, so registry cursor remains zero on failure and success.
"""
class World:
    def __init__(self):
        self.edges=[(1,2,1),(1,3,1),(1,4,2),(2,3,2)]
        self.inverses=[(1,1,[2,3]),(1,2,[4]),(2,2,[3])]
        self.live={1,2,3,4};self.payloads={1,2,3,4};self.events=[];self.pending=0
    def unrelate(self,key,source):
        previous=next((target for k,s,target in self.edges if k==key and s==source),None)
        self.edges=[e for e in self.edges if not(e[0]==key and e[1]==source)]
        updated=[]
        for k,target,children in self.inverses:
            if k==key and target==previous:children=[c for c in children if c!=source]
            if children:updated.append((k,target,children))
        self.inverses=updated
    def cleanup(self,target):
        if target not in self.live:return
        for key in (1,2):
            children=next((list(cs) for k,t,cs in self.inverses if k==key and t==target),[])
            for child in children:
                if key==1:self.cleanup(child)
                else:self.unrelate(key,child)
            self.unrelate(key,target)
        if target in self.payloads:
            self.payloads.remove(target);self.events.append('Removed:'+str(target))
        self.live.discard(target);self.events.append('Original:'+str(1000+target))
    def physical(self):
        owners=''.join((f'{i},{i},{10*i},' if i in self.payloads else 'absent')+';' for i in range(1,9))
        descriptors={1:'1:Parent:Children:hierarchy',2:'2:Link:Incoming:ordinary'}
        graph='graph-edges='+''.join(descriptors[k]+f':{s}:{t};' for k,s,t in self.edges)
        graph+='|graph-inverses='+''.join(descriptors[k]+':'+str(t)+':['+''.join(str(c)+',' for c in cs)+'];' for k,t,cs in self.inverses)
        live=''.join('1,' if i in self.live else '0,' for i in range(16))
        events=''.join(e+';' for e in self.events)
        return owners+'|stamps=|events='+events+'|meta=1,5,4,8,3,17,18,,2,0|registrations=1:LinkedCleanup:[Payload:write,Parent:write,Link:write,];|pending='+str(self.pending)+'|edges='+graph+'|live='+live
    def relation(self,key,name,inverse,kind):
        edges={s:t for k,s,t in self.edges if k==key};inverses={t:cs for k,t,cs in self.inverses if k==key}
        rows=[f'Relation{{key={key}|name={name}|inverse={inverse}|kind={kind}}}']
        for i in sorted(self.live):
            outgoing='Missing' if i not in edges else 'Target:1:'+str(edges[i])
            incoming='Missing' if not inverses.get(i) else 'Sources:['+', '.join('1:'+str(c) for c in inverses[i])+']'
            rows.append(f'1:{i}:[{name}:Outgoing:{outgoing}, {inverse}:Incoming:{incoming}]')
        return rows
    def snapshot(self):
        rows=[self.physical()]+self.relation(1,'Parent','Children','Hierarchy')+self.relation(2,'Link','Incoming','Ordinary')
        return 'system=1:1:LinkedCleanup|access=Payload:write,Parent:write,Link:write,|cursor=0\nowners=19,|recipe=Recipe{}\ndebug=True\n'+'\n'.join(rows)+'\n'

# Current source-derived model; no runtime observation inputs.
class ForeignWorld(World):
    def __init__(self,ns):
        super().__init__();self.ns=ns;self.edges=[];self.inverses=[]
    def physical(self):
        text=super().physical()
        resources='17,18' if self.ns==1 else '27,28'
        nextid,high=(6,5) if self.ns==1 else (5,4)
        return text.replace('meta=1,5,4,8,3,17,18',f'meta={self.ns},{nextid},{high},8,3,{resources}')
    def relation(self,key,name,inverse,kind):
        return [line.replace('1:',str(self.ns)+':',1) if line.startswith('1:') else line for line in super().relation(key,name,inverse,kind)]
    def snapshot(self):
        return super().snapshot().replace('system=1:1:',f'system={self.ns}:1:')
def scene():
    local,peer=ForeignWorld(1),ForeignWorld(2)
    # Registration rejection precedes callback. Foreign/missing checks enqueue
    # nothing; successful Registry cursor reads unchanged clock zero.
    out='factoryNext=3|foreign=2:1|missing=1:5'
    for suffix,status in [('BEFORE',None),('AFTER_REGISTRATION_REJECTION','ASSOCIATION=RegistrationRejected'),('AFTER_FOREIGN','FOREIGN=MissingEntity:Success'),('AFTER_MISSING','MISSING=MissingEntity:Success')]:
        if status:out+='\n'+status
        out+='\nLOCAL_'+suffix+'\n'+local.snapshot()+'\nPEER_'+suffix+'\n'+peer.snapshot()
    return out
def expected():
    return ('ForeignAlpha\n'+scene()+'\nForeignBeta\n'+scene()+'\n').encode()
