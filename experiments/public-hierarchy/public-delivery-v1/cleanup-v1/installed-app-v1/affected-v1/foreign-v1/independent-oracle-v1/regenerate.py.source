"""Bind independent namespace-correct installed cleanup foreign model."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def regenerate():
    complete=HERE.parents[1]/'FOREIGN-NAMESPACE-SOURCE.json';pins=json.loads(complete.read_text())['sourceInventory'].copy()
    for path,digest in pins.items():assert sha(path)==digest,path
    m=runpy.run_path(str(HERE/'model.py.source'));raw=m['expected']();text=raw.decode()
    assert text.count('|meta=')==12 and text.count('Relation{')==24 and text.count('owners=19,|recipe=Recipe{}')==12
    assert text.count('MissingEntity:Success')==4 and text.count('factoryNext=3|foreign=2:1|missing=1:5')==2
    assert text.count('|meta=1,6,5,8,3,17,18,,1,0')==6 and text.count('|meta=2,5,4,8,3,27,28,,1,0')==6
    assert m['physical'](2,False,[27,28]).endswith('|live=0,1,1,1,1,'+'0,'*11)
    rows=[r for r in text.splitlines() if '|meta=' in r];assert rows[::2]==[rows[0]]*6 and rows[1::2]==[rows[1]]*6
    for path in [complete,HERE/'model.py.source',HERE/'regenerate.py.source',Path('/home/node/.bend/bend2/base.bend'),Path('/home/node/.bend/bend2/effs/print.js'),Path('/home/node/.bend/bend2/effs/print.c')]:pins[str(path)]=sha(path)
    (HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    basis={'producerCommit':'ffea1f310','sourcePins':pins,'entry':str(HERE.parents[1]/'foreign.bend'),'derivation':'ActualFactory createslocalns1/peer2, spawn4both thenreservelocal5withoutactivation: localnext6high5,livelocal1..4 only,payloads1..4; peer next5high4/live1..4. Explicitnamespace observer repairsoldhardcodedpeer flags withoutchangingoperations; bothresources17/18 and27/28 andOwner19 retained. InstalledParentthenLinkrecipe emitsbothdescriptorviews ascendinglive1..4 only. Publiccleanup validatesforeign2:1 andreservedinactive1:5 False, returnsMissingEntity andTx.finishSuccess schedulesnothing; barriers preservebothWorlds. Allthreebefore/afterforeign/aftermissing pairs observed,12physicalApp snapshots. ManualString exact newline/text_lines/IO.printLF. Old366bforeignpeerphysicalscopewithdrawn; negativecontrols unchanged. No runtimeoutputs used.','limits':'Finite two nominalschemas actualforeign andinactive-reserved requirements,12App snapshots. No opaqueauthority/newcleanup/disposal/effectfulfinalizer/Typeevent/TS/performance/proof claim.'}
    b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
    oracle={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
    (HERE/'ORACLES.json').write_text(json.dumps({'normal':oracle,'foreign':oracle},indent=2)+'\n')
    result={'sourcePins':len(pins),'snapshots':12,**oracle};(HERE/'SELFTEST.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
if __name__=='__main__':regenerate()
