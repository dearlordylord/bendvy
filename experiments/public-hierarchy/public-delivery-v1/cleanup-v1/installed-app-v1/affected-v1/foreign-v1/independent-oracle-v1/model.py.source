"""Independent source-only installed cleanup foreign/missing complete snapshots."""
def physical(ns,reserved,resources):
    owners=''.join((f'{i},{i},{10*i},' if i<=4 else 'absent')+';' for i in range(1,9))
    live=''.join('1,' if 1<=i<=4 else '0,' for i in range(16))
    return owners+f'|stamps=|events=|meta={ns},{6 if reserved else 5},{5 if reserved else 4},8,3,{resources[0]},{resources[1]},,1,0|registrations=|pending=0|edges=graph-edges=|graph-inverses=|live='+live
def snapshot(ns,reserved,resources):
    rows=[physical(ns,reserved,resources)]
    for key,name,inverse,kind in [(1,'Parent','Children','Hierarchy'),(2,'Link','Incoming','Ordinary')]:
        rows.append(f'Relation{{key={key}|name={name}|inverse={inverse}|kind={kind}}}')
        rows += [f'{ns}:{i}:[{name}:Outgoing:Missing, {inverse}:Incoming:Missing]' for i in range(1,5)]
    return 'owners=19,|recipe=Recipe{}\ndebug=True\n'+'\n'.join(rows)+'\n'
def scene():
    local=snapshot(1,True,[17,18]);peer=snapshot(2,False,[27,28])
    return 'factoryNext=3|foreign=2:1|missing=1:5\nLOCAL_BEFORE\n'+local+'\nPEER_BEFORE\n'+peer+'\nFOREIGN=MissingEntity:Success\nLOCAL_AFTER_FOREIGN\n'+local+'\nPEER_AFTER_FOREIGN\n'+peer+'\nMISSING=MissingEntity:Success\nLOCAL_AFTER_MISSING\n'+local+'\nPEER_AFTER_MISSING\n'+peer
def expected():return ('ForeignAlpha\n'+scene()+'\nForeignBeta\n'+scene()+'\n').encode()
if __name__=='__main__':
    import sys
    sys.stdout.buffer.write(expected())
