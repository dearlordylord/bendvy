"""Finite source-only installed root/duplicate/dead cleanup transcript."""
import runpy
from pathlib import Path
DEPENDENCY=Path(__file__).resolve().parents[2]/'independent-oracle-v1'/'model.py.source'
BASE=runpy.run_path(str(DEPENDENCY))
World=BASE['World']
def scene():
    # The complete original four snapshots and aborted/success statuses precede additions.
    head=BASE['scene']()
    world=World();world.cleanup(2)
    world.pending=1;head+='\nROOT_QUEUE=Queued:Success\nROOT_PENDING\n'+world.snapshot()
    world.pending=2;head+='\nDUPLICATE_QUEUE=Queued:Success\nDUPLICATE_PENDING\n'+world.snapshot()
    world.pending=0;world.cleanup(1);world.cleanup(1)
    head+='\nROOT_APPLIED\n'+world.snapshot()
    head+='\nDEAD_REPEAT_QUEUE=MissingEntity:Success\nDEAD_REPEAT_PENDING\n'+world.snapshot()
    head+='\nDEAD_REPEAT_APPLIED\n'+world.snapshot()
    return head
def expected():return ('HierarchyAlpha\n'+scene()+'\nHierarchyBeta\n'+scene()+'\n').encode()
if __name__=='__main__':
    import sys
    sys.stdout.buffer.write(expected())
