"""Prepared installed wrapper declaration-tail omission, no applied claim."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def regenerate():
    context=HERE.parent/'SOURCE-STATES.json';state=json.loads(context.read_text())
    target=Path(state['target']);old=HERE.parent/'normal.source';new=HERE.parent/'mutant.source'
    assert sha(target)==sha(old)==state['normal']['sha256']
    assert sha(new)==state['mutant']['sha256']
    assert old.read_text().count(state['delta']['before'])==1
    assert old.read_text().replace(state['delta']['before'],state['delta']['after'])==new.read_text()
    normaldir=HERE.parents[1]/'independent-oracle-v1';normal=runpy.run_path(str(normaldir/'model.py.source'))['expected']()
    m=runpy.run_path(str(HERE/'model.py.source'));w=m['World']();w.cleanup(2)
    assert w.live=={1,3} and w.payloads=={1,3}
    assert w.edges==[(1,3,1),(2,3,2)] and w.inverses==[(1,1,[3]),(2,2,[3])]
    assert w.events==['Removed:4','Original:1004','Removed:2','Original:1002']
    raw=m['expected']();a=normal.decode().splitlines();b=raw.decode().splitlines()
    differences=[i for i,(x,y) in enumerate(zip(a,b)) if x!=y]
    assert len(a)==len(b) and len(differences)==4
    assert all('|meta=' in a[i] or '1:3:[Link:' in a[i] for i in differences)
    assert raw.decode().count('Relation{')==16 and raw.decode().count('|meta=')==8
    pins=json.loads((normaldir/'SOURCE-BASIS.json').read_text())['sourcePins'].copy()
    for path,digest in pins.items():assert sha(path)==digest,path
    for path in [context,old,new,normaldir/'model.py.source',normaldir/'SOURCE-BASIS.json',HERE/'model.py.source',HERE/'regenerate.py.source']:pins[str(path)]=sha(path)
    (HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    basis={'producerCommit':'366b10836','status':'PREPARED_NOT_APPLIED','sourcePins':pins,'normalRootPrecondition':state['normal']['sha256'],'runtimeBindingRequirement':{'target':str(target),'requiredAppliedSHA256':state['mutant']['sha256'],'preparedSourcePinsAreNotRuntimePins':True},'derivation':'Only operational descriptors firstcons stops atParent; declaration-installed observation Recipe still emits bothParent/Link views. ActualParentcleanup recursion removes4then2, clearsPayloads, deactivates,publishesRemoved/Original asnormal. Link3to2 andinverse2[3] remain becauseLink notvisited; finalphysicalgraphlineand actualLinkrow3 outgoingTarget1:2 change eachschema. Nootherfields/statuses/owners/resources/parentviews change. Normalfull7987baseline retained. No runtimeoutputs used.','limits':'Conditional finite prepared wrapperinventoryomission only; currentnormalrootrequired, no appliedruntime,cleanupfinalizerpolicy,Typeevents,TS/performance/proof qualification.'}
    basispath=HERE/'SOURCE-BASIS.json';basispath.write_text(json.dumps(basis,indent=2)+'\n')
    oracle={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(basispath),'sourceBasisSHA256':sha(basispath),'normalBaseline':str(normaldir/'expected.stdout.gz'),'normalBaselineBytes':len(normal),'normalBaselineSHA256':hashlib.sha256(normal).hexdigest()}
    (HERE/'ORACLES.json').write_text(json.dumps({'mutant':oracle},indent=2)+'\n')
    result={'sourcePins':len(pins),'changedLines':differences,**oracle};(HERE/'SELFTEST.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
if __name__=='__main__':regenerate()
