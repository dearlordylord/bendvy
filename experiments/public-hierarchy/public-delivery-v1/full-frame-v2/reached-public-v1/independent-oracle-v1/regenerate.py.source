"""Freeze prepared Depth countermodel before root application; no runtime inputs."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent;P=HERE.parent;NORMAL=HERE.parents[1]/'independent-oracle-v1'
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def regenerate():
    states=json.loads((P/'SOURCE-STATES.json').read_text())
    target=Path(states['target']);assert sha(target)==states['normalSHA256']
    before=(P/'normal.bend.source').read_bytes();after=(P/'mutant.bend.source').read_bytes()
    assert hashlib.sha256(before).hexdigest()==states['normalSHA256']
    assert hashlib.sha256(after).hexdigest()==states['mutantSHA256']
    old=states['delta']['before'].encode();new=states['delta']['after'].encode()
    assert before.count(old)==1 and before.replace(old,new)==after
    normalmod=runpy.run_path(str(NORMAL/'model.py.source'))
    mutantmod=runpy.run_path(str(HERE/'model.py.source'))
    normal=normalmod['expected']();raw=mutantmod['expected']()
    assert len(normal)==states['normalOracleBytes'] and hashlib.sha256(normal).hexdigest()==states['normalOracleSHA256']
    assert raw!=normal
    n=normal.decode().split('\n');m=raw.decode().split('\n');changes=[]
    for index,(a,b) in enumerate(zip(n,m)):
        if a==b:continue
        assert '|depth=' in a and '|depth=' in b
        assert a.split('|depth=')[0]==b.split('|depth=')[0]
        assert a.split('|breadth=')[1]==b.split('|breadth=')[1]
        assert b.split('|depth=')[1].split('|breadth=')[0]==b.split('|breadth=')[1]
        changes.append(index)
    assert len(n)==len(m) and len(changes)==6
    normalbasis=json.loads((NORMAL/'SOURCE-BASIS.json').read_text());pins=normalbasis['sourcePins'].copy()
    for path,digest in pins.items():assert sha(path)==digest,path
    for path in [P/'SOURCE-STATES.json',P/'normal.bend.source',P/'mutant.bend.source',HERE/'model.py.source',HERE/'regenerate.py.source',NORMAL/'model.py.source',NORMAL/'SOURCE-BASIS.json']:pins[str(path)]=sha(path)
    (HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    basis={'sourcePins':pins,'sourceState':'PREPARED_NOT_APPLIED','normalRootPrecondition':{'path':str(target),'sha256':states['normalSHA256']},'preparedCountermodel':{'path':str(P/'mutant.bend.source'),'sha256':states['mutantSHA256']},'derivation':'Sole Depth workqueue changes children-before-rest to rest-before-children. Independent traversal algorithm consequently uses breadth workqueue for both orders. Exactly6depth strings across 10snapshot/40lookup transcript change; every graph/inverse/payload/stamp/live/resource/event/pending/metadata string and parent/child/ancestor/root/breadth result remains identical. No actual public application or runtime output input.','limits':'Prepared source countermodel only; actual root-applied receipt/current source check and runtime qualification remain separately required.'}
    b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
    oracle={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b),'normalBaseline':str(NORMAL/'expected.stdout.gz'),'normalBaselineBytes':len(normal),'normalBaselineSHA256':hashlib.sha256(normal).hexdigest()}
    (HERE/'ORACLES.json').write_text(json.dumps({'mutant':oracle},indent=2)+'\n')
    result={'sourcePins':len(pins),'changedDepthLines':changes,'preparedNotApplied':True,**oracle};(HERE/'SELFTEST.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
if __name__=='__main__':regenerate()
