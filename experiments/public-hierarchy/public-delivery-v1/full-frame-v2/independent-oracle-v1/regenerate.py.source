"""Bind the finite hierarchy transcript to the checked public closure."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def regenerate():
    complete=json.loads((HERE.parent/'SOURCE-COMPLETE.json').read_text())
    pins=complete['sourcePins'].copy()
    for path,digest in pins.items():assert sha(path)==digest,path
    module=runpy.run_path(str(HERE/'model.py.source'))
    raw=module['expected']();text=raw.decode()
    assert text.count('parent=')==40 and text.count('|meta=')==10
    assert text.count('|pending=1')==4 and text.count('|pending=0')==6
    assert text.count('|stamps=|events=')==10
    assert module['frames']([(2,1),(3,1),(4,2)],[(1,[2,3]),(2,[4])])[0]=='entity=1:1|parent=absent|children=1:2,1:3,|ancestors=|root=1:1|depth=1:2,1:4,1:3,|breadth=1:2,1:3,1:4,'
    assert module['frames']([(2,1),(3,1),(4,3)],[(1,[3,2]),(3,[4])])[0]=='entity=1:1|parent=absent|children=1:3,1:2,|ancestors=|root=1:1|depth=1:3,1:4,1:2,|breadth=1:3,1:2,1:4,'
    oldmod=runpy.run_path(str(HERE.parents[1]/'independent-oracle-v1/model.py.source'))
    import re
    assert re.sub(r'entity=1:[1-4]\|','',text).encode()==oldmod['expected']()
    for path in [HERE.parents[1]/'independent-oracle-v1/model.py.source',HERE/'model.py.source',HERE/'regenerate.py.source',HERE.parent/'SOURCE-COMPLETE.json',Path('/home/node/.bend/bend2/effs/print.js'),Path('/home/node/.bend/bend2/effs/print.c')]:pins[str(path)]=sha(path)
    (HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
    basis={'producerCommit':'136f77cb4','sourcePins':pins,'entry':str(HERE.parent/'entry.bend'),'derivation':'Graph updates append replaced edge after stable removal; inverse addition appends child and removes empty prior inverse. Reorder changes inverse child order only. Frame.entity is actual passed Handle reconstructed by provider snapshot; traversal excludes starting entity; ancestors nearest-first, root last ancestor, depth front-enqueues children, breadth back-enqueues. Transactions queue callbacks FIFO; prebarrier snapshots retain old graph and pending1. Raw Column.swap preserves empty stamps; World reserve/activate and relation barriers never advance clock. Four payloads retain tags and two cells; resource17, registrations empty, events empty. Source08 each_fold retains forward lookup ordering. IO.print adds one terminal LF in pinned JS/C effects. No runtime outputs used.','limits':'Finite valid acyclic hierarchy; two nominal schemas, five snapshots each,40actual public lookups. No registered System, cleanup,foreignhandle,Factoryretention,cycle failure or performance qualification.'}
    b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
    oracle={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
    (HERE/'ORACLES.json').write_text(json.dumps({'normal':oracle},indent=2)+'\n')
    result={'sourcePins':len(pins),'snapshots':10,'publicLookups':40,**oracle}
    (HERE/'SELFTEST.json').write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result))
if __name__=='__main__':regenerate()
