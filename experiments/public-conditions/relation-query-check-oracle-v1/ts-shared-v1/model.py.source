"""Independent finite model of the frozen public TS relation/query Check consumer.

No subject imports or runtime observations: model state and JSON projection follow
Command.ts, Runtime.ts, internal/{world,queries,cells}.ts and reference.mjs.
"""
import copy
import json


def pair(value):
    return [value, value + 1]


def entity_id(value):
    return {'kind': 'EntityId', 'value': value}


def population(schema):
    entities = []
    for ident in range(1, 6):
        components = {}
        if ident != 4:
            components[schema + '/Primary'] = pair(ident * 10)
        if ident not in (2, 5):
            components[schema + '/Bonus'] = pair(ident * 100)
        if ident != 5:
            components[schema + '/Active'] = {}
        if ident == 3:
            components[schema + '/Hidden'] = {}
        entities.append({'id': ident, 'components': components, 'relations': {}})
    return entities


def session(schema):
    resources = {schema + '/Counter': pair(10), schema + '/Threshold': pair(5),
                 schema + '/Sentinel': pair(900)}
    live, pending, trace = [], [], []
    frame = tick = 0
    prefix = schema + '/'

    def point(label):
        return copy.deepcopy({'label': label, 'world': {
            'version': 1, 'frame': frame, 'tick': tick, 'entityCount': len(live),
            'entities': live, 'resources': resources, 'machines': {},
            'pendingCommands': [{'tag': tag, 'system': origin} for tag, origin in pending]},
            'streams': [], 'trace': trace})

    def joined_rows():
        result = []
        for entity in live:
            components = entity['components']
            if not all(prefix + name in components for name in ('Primary', 'Active')):
                continue
            if prefix + 'Hidden' in components or prefix + 'Link' not in entity['relations']:
                continue
            bonus = {'present': False}
            if prefix + 'Bonus' in components:
                bonus = {'present': True, 'value': copy.deepcopy(components[prefix + 'Bonus'])}
            result.append({'id': entity_id(entity['id']),
                           'primary': copy.deepcopy(components[prefix + 'Primary']),
                           'bonus': bonus,
                           'targetAlias': entity_id(entity['relations'][prefix + 'Link'])})
        return result

    rows = [point('empty')]

    def execute(label, operation, value=None):
        nonlocal frame, tick, live, pending
        frame += 1  # tryTick passes all declared requirements before advancing.
        if operation == 'guard':
            presence = [{'id': entity_id(e['id']), 'value': 'Unit'} for e in live
                        if prefix + 'Active' in e['components']]
            trace.append({'check': 'presence', 'rows': presence})
            if presence:  # Condition.and uses Array.every: lazy left to right.
                joined = joined_rows()
                threshold = copy.deepcopy(resources[prefix + 'Threshold'])
                trace.append({'check': 'joined', 'rows': joined, 'threshold': threshold})
                if joined and threshold[0] < joined[0]['primary'][0]:
                    tick += 1
                    before = resources[prefix + 'Counter'][0]
                    resources[prefix + 'Counter'] = pair(before + 1)
                    trace.append({'system': 'increment', 'before': before})
        elif operation == 'populate':
            tick += 1
            pending.extend([('spawn', 'populate-five')] * 5)
            trace.append({'system': 'populate-five'})
        elif operation in ('link', 'unlink'):
            tick += 1
            pending.append(('relate' if operation == 'link' else 'unrelate',
                            'link-one-two' if operation == 'link' else 'unlink-one'))
            event = {'system': operation, 'source': entity_id(1)}
            if operation == 'link':
                event['target'] = entity_id(2)
            trace.append(event)
        elif operation == 'apply':
            tick += 1  # Barrier advances even if the queue is empty.
            for tag, _origin in pending:
                if tag == 'spawn':
                    if not live:
                        live = population(schema)
                elif tag == 'relate':
                    live[0]['relations'][prefix + 'Link'] = 2
                elif tag == 'unrelate':
                    del live[0]['relations'][prefix + 'Link']
                else:
                    raise AssertionError(tag)
            pending = []
        elif operation == 'threshold':
            tick += 1
            before = copy.deepcopy(resources[prefix + 'Threshold'])
            resources[prefix + 'Threshold'] = pair(value)
            trace.append({'system': 'threshold', 'before': before, 'value': pair(value)})
        else:
            raise AssertionError(operation)
        rows.append({**point(label), 'result': {'ok': True}})

    for label, operation, value in [
        ('empty-guarded', 'guard', None), ('populate-pending', 'populate', None),
        ('populate-visible', 'apply', None), ('no-edge-false', 'guard', None),
        ('link-pending', 'link', None), ('link-still-false', 'guard', None),
        ('link-visible', 'apply', None), ('linked-true', 'guard', None),
        ('linked-true-repeat', 'guard', None), ('threshold-high', 'threshold', 50),
        ('threshold-false', 'guard', None), ('threshold-five', 'threshold', 5),
        ('threshold-true', 'guard', None), ('unlink-pending', 'unlink', None),
        ('unlink-still-true', 'guard', None), ('unlink-visible', 'apply', None),
        ('unlinked-false', 'guard', None)]:
        execute(label, operation, value)
    return {'schema': schema, 'rows': rows}


def values():
    return [session(schema) for schema in ('Workshop', 'Garden')]


def render():
    return (json.dumps(values(), separators=(',', ':'), ensure_ascii=False) + '\n').encode()


def selftest():
    for case in values():
        schema, rows = case['schema'], case['rows']
        assert len(rows) == 18
        assert [row['world']['frame'] for row in rows] == list(range(18))
        assert [row['world']['tick'] for row in rows] == [
            0, 0, 1, 2, 2, 3, 3, 4, 5, 6, 7, 7, 8, 9, 10, 11, 12, 12]
        assert rows[1]['trace'] == [{'check': 'presence', 'rows': []}]
        assert rows[2]['world']['entities'] == []
        assert len(rows[2]['world']['pendingCommands']) == 5
        for index in (4, 6, 17):
            assert rows[index]['trace'][-1]['rows'] == []
        assert rows[5]['world']['entities'][0]['relations'] == {}
        assert rows[7]['world']['entities'][0]['relations'] == {schema + '/Link': 2}
        assert rows[14]['world']['entities'][0]['relations'] == {schema + '/Link': 2}
        assert rows[16]['world']['entities'][0]['relations'] == {}
        assert rows[5]['world']['pendingCommands'] == [{'tag': 'relate', 'system': 'link-one-two'}]
        assert rows[14]['world']['pendingCommands'] == [{'tag': 'unrelate', 'system': 'unlink-one'}]
        checks = [entry for entry in rows[-1]['trace'] if entry.get('check') == 'joined']
        assert len(checks) == 8
        assert [len(entry['rows']) for entry in checks] == [0, 0, 1, 1, 1, 1, 1, 0]
        for entry in checks:
            if entry['rows']:
                assert entry['rows'] == [{'id': entity_id(1), 'primary': pair(10),
                                         'bonus': {'present': True, 'value': pair(100)},
                                         'targetAlias': entity_id(2)}]
        increments = [entry['before'] for entry in rows[-1]['trace'] if entry.get('system') == 'increment']
        assert increments == [10, 11, 12, 13]
        assert rows[-1]['world']['resources'] == {
            schema + '/Counter': pair(14), schema + '/Threshold': pair(5), schema + '/Sentinel': pair(900)}
        assert all(row['streams'] == [] and row['world']['machines'] == {} for row in rows)
        assert rows[-1]['world']['entities'][1]['components'] == {
            schema + '/Primary': pair(20), schema + '/Active': {}}
        assert rows[-1]['world']['pendingCommands'] == []


if __name__ == '__main__':
    import sys
    selftest()
    if '--self-test' not in sys.argv and '--selftest' not in sys.argv:
        sys.stdout.buffer.write(render())
