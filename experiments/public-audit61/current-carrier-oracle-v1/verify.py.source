from pathlib import Path
import hashlib,json,gzip,subprocess,sys,tempfile,shutil
BASE=Path('/tmp/bendvy61-current-carrier-oracle/experiments/public-audit61/current-carrier-oracle-v1');sha=lambda b:hashlib.sha256(b).hexdigest();results={}
for app in ['app-a','app-b']:
 out=BASE/app;basis=json.loads((out/'SOURCE-BASIS.json').read_text())
 for section in ['sourceInventory','sourcePins','priorModelPins','modelPins']:
  for p,h in basis[section].items():assert sha(Path(p).read_bytes())==h,p
 expected=(out/'expected.stdout').read_bytes();assert gzip.decompress((out/'expected.stdout.gz').read_bytes())==expected;assert sha(expected)==basis['expectedSHA256']
 with tempfile.TemporaryDirectory()as tmp:
  dest=Path(tmp)
  for p in out.iterdir():
   if p.is_file()and(p.suffix=='.py'or p.name.endswith('.source')):shutil.copyfile(p,dest/p.name)
  subprocess.run([sys.executable,str(dest/'model.py'),'--self-test'],capture_output=True,check=True)
  actual=subprocess.run([sys.executable,str(dest/'model.py')],capture_output=True,check=True);assert not actual.stderr;assert actual.stdout==expected
  if app=='app-a':
   oldBase=(out/'prior-base_model.py.source').read_text();newBase=(out/'base_model.py').read_text();needle='|pending={2 if self.reserved and not self.seeded else 0}|registrations=';expanded='|pending={2 if self.reserved and not self.seeded else 0}|pendingKinds={"Raw;" * (2 if self.reserved and not self.seeded else 0)}end|registrations=';assert oldBase.replace(needle,expanded)==newBase
   (dest/'base_model.py').write_text(oldBase)
  prior=subprocess.run([sys.executable,str(dest/'prior-model.py.source')],capture_output=True,check=True).stdout
  priorHash='b8367b3ffab7f8d72ee6ea45e05ba4078d41a29f16ccc878386d380768b0bfab'if app=='app-a'else'223263ef3b54aa14c344629073e41285bc4dcfee5138aa815e541de008840b9c'
  assert sha(prior)==priorHash
  # This compares independently generated model projections only, never consumer output.
  import re
  logical=re.sub(rb'\|pendingKinds=(?:Raw;|Observed;)*end',b'',expected);assert logical==prior
 results[app]=dict(bytes=len(expected),sha256=sha(expected),priorBytes=len(prior),priorSHA256=sha(prior),allPriorLogicalObservationsRetained=True,isolatedModelReproduction=True,pinnedSources=len(basis['sourceInventory']),sourceCommit=basis['sourceCommit'],subjectOutputRead=False)
print(json.dumps(results,indent=2))
