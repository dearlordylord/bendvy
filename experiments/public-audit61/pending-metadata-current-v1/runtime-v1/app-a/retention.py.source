from pathlib import Path
import gzip,hashlib,json,runpy,shutil,tempfile,sys
ROOT=Path('/workspace/formal-proofs/bendvy');WT=Path('/tmp/bendvy-constructed-field');HERE=WT/'experiments/public-audit61/pending-metadata-current-v1/runtime-v1/app-a';OUT=HERE/'actual-attempt01';OUT.mkdir(parents=True,exist_ok=True);(OUT/'objects').mkdir(exist_ok=True)
ORACLE=Path('/tmp/bendvy-constructed-field/experiments/public-audit61/pending-metadata-current-v1/app-a')
sha=lambda b:hashlib.sha256(b).hexdigest()
files={};external=set();roles=[]
def add(path,expected=None,tool=False):
 p=Path(path);b=p.read_bytes();h=sha(b)
 if expected:assert h==expected,str(p)
 files[str(p)]=(b,h)
 if tool and b.startswith(b'\x7fELF'):external.add(str(p))
for role in ['js','native']:
 d=Path('/tmp/bendvy38-pending-app-a-actual01/normal')/role;p=d/'plan.json';plan=json.loads(p.read_text());r=json.loads((d/'receipt.json').read_text());assert r['planSHA256']==sha(p.read_bytes());assert r['status']=='COMPLETE_CONSUMER_DEVELOPMENT_PASS'
 for path,h in plan['pins'].items():add(path,h,True)
 for root,entries in plan['resourceRoots'].items():
  for path,h in entries.items():add(Path(root)/path,h,True)
 for f in d.iterdir():
  if f.is_file():add(f)
 for command in r['commands']:
  assert command['exit']==0 and command['failure'] is None
  for stream in ['stdout','stderr']:
   x=command[stream];add(x['path'],x['sha256']);assert len(files[x['path']][0])==x['bytes']
  if command['label']=='consumer':assert files[command['stdout']['path']][0]==(ORACLE/'expected.stdout').read_bytes()
 for g in r['guards']:
  add(g['path'],g['sha256']);v=json.loads(files[g['path']][0]);assert v['unchanged'];assert all(v['actualPins'][k]==h for k,h in plan['pins'].items())
 roles.append({'role':role,'plan':str(p),'planSHA256':sha(p.read_bytes()),'receipt':str(d/'receipt.json'),'receiptSHA256':sha((d/'receipt.json').read_bytes()),'commands':len(r['commands']),'guards':len(r['guards'])})
add('/tmp/bendvy61-prepare-ordinary.py')
add('/tmp/bendvy38-pending-working-core.json')
add(WT/'experiments/public-audit61/pending-metadata-current-v1/WORKING-CORE.json')
add(WT/'experiments/public-audit61/pending-metadata-current-v1/runtime-v1/SOURCE-ADOPTION.md')
# Preserve the independently captured source-check tool/model bindings too.
basis=json.loads((ORACLE/'SOURCE-BASIS.json').read_text())
for group in ['sourcePins','toolPins','modelPins']:
 for path,h in basis[group].items():add(path,h,True)
# Oracle model/source inputs are already pinned by the executed plans. Do not rerun it.
actual=(ORACLE/'expected.stdout').read_bytes();assert actual==gzip.decompress((ORACLE/'expected.stdout.gz').read_bytes())

rows=[]
for path,(b,h) in sorted(files.items()):
 row={'path':path,'bytes':len(b),'sha256':h}
 if path in external:row['retention']='external installed ELF identity only'
 else:
  packed=gzip.compress(b,mtime=0);obj='objects/'+h+'.gz';(OUT/obj).write_bytes(packed);row.update(object=obj,compressedSHA256=sha(packed))
 rows.append(row)
manifest={'scope':'Existing independent app-a complete operation/state/owner observations under actual pending-metadata core7eb6c90e5. Whole source-derived physical planes and entry-root QNames retained; no normalization or new scenario.','sourceCommit':'root working four-core manifest from7eb6c90e5; unchanged application bodies','oracleCommit':'f604f2571','roles':roles,'members':rows,'verification':{'completeBytes':len(actual),'completeSHA256':sha(actual),'independentOracleReusedWithoutRerun':True,'successfulCommands':sum(r['commands'] for r in roles),'unchangedGuards':sum(r['guards'] for r in roles)}}
(OUT/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\n')
for row in rows:
 if 'object' in row:
  b=(OUT/row['object']).read_bytes();assert sha(b)==row['compressedSHA256'];raw=gzip.decompress(b);assert sha(raw)==row['sha256'] and len(raw)==row['bytes']
print(len(rows),'bindings',len(set(r['object'] for r in rows if 'object' in r)),'objects',len(external),'externalELFs',manifest['verification'])
