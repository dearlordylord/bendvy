  "mutant": {
    "path": "/workspace/formal-proofs/bendvy-worktrees/public-audit61-app-b/experiments/public-audit61/app-b-controls-v1/reparent-omission/main.bend",
    "sha256": "7ad41e4f5c6189976add17f72795522670c3650320795038ca7bbc7c34afe3d4",
    "bytes": 10785,
    "helperInsertion": "# Reached experiment mutant: discard exactly the callback just accepted by queue_relate.\n# World, inverse journal, prior commands, events and public QueueStatus remain owned.\ndef remove_accepted(status:A.QueueStatus,tx:T.Tx<B.World(R.Resources()),A.Notice<B.Scene,U32>>) -> T.Tx<B.World(R.Resources()),A.Notice<B.Scene,U32>> & A.QueueStatus:\n  match status tx:\n    case A.Queued{} T.Tx{world,undo,head <> tail,events}: (T.Tx{world,undo,tail,events},A.Queued{})\n    case A.Queued{} T.Tx{world,undo,[],events}: (T.Tx{world,undo,[],events},A.Queued{})\n    case A.MissingEntity{} tx: (tx,A.MissingEntity{})\ndef without_reparent(result:T.Tx<B.World(R.Resources()),A.Notice<B.Scene,U32>> & A.QueueStatus) -> T.Tx<B.World(R.Resources()),A.Notice<B.Scene,U32>> & A.QueueStatus:\n  match result:\n    case (tx,status):remove_accepted(status,tx)\n",
    "callsiteOriginal": "A.queue_relate(~B.Scene,~B.Components,~R.Resources(),~U32,T.begin(~B.World(R.Resources()),~A.Notice<B.Scene,U32>,world),Inspect.parent(),child,other)",
    "callsiteMutated": "without_reparent(A.queue_relate(~B.Scene,~B.Components,~R.Resources(),~U32,T.begin(~B.World(R.Resources()),~A.Notice<B.Scene,U32>,world),Inspect.parent(),child,other))",
    "inverseVerified": true
  }
