"""Source-derived changed-stamp-omission counter transitions for newly observed #63 metadata.
No candidate output or expected text is read. Explicit fixed inputs mirror the
unchanged public operation list; field rendering is separate.
"""
import copy

ACCESS = {
  'ReaderA': ['event:read'], 'ReaderB': ['event:read'],
  'Spawn': ['command:spawn'],
  'Move': ['write:Simulation/Position','read:Simulation/Velocity','write:Simulation/Step'],
  'Damage': ['read:Simulation/Position','write:Simulation/Health','write:Simulation/Hit','write:Simulation/Death','command:despawn'],
}

def metadata(namespace):
    clock=0; allocated=0; live=[]; values={}; stamps={}; pending=[]
    registrations=[(2,'ReaderB'),(1,'ReaderA')]; cursors={'ReaderA':0,'ReaderB':0}; next_system=3
    result=[]
    def observe(label):
        result.append(copy.deepcopy(dict(label=label,namespace=namespace,capacity=1 if not allocated else 4,depth=0 if not allocated else 2,
            live=[i in live for i in range(1 if not allocated else 4)],registrations=registrations,nextSystem=next_system,
            registries={name:dict(id=i,cursor=cursors[name],access=ACCESS[name]) for i,name in registrations},
            stamps={i:stamps.get(i,[(0,0)]*3) for i in range(1,allocated+1)},clock=clock)))
    observe('register-readers')
    commands=[('queue-spawn','spawn'),('spawn-barrier','barrier'),('step-1-damage','game'),('step-1-readers','read'),('step-1-barrier','barrier'),('step-2-damage','game'),('step-2-reader-failure','read'),('step-2-reader-retry','read'),('step-2-barrier','barrier'),('step-3-damage','game'),('step-3-readers','read'),('step-3-barrier','barrier'),('empty-readers','read')]
    for label,op in commands:
        if op=='spawn':
            registrations.insert(0,(3,'Spawn'));cursors['Spawn']=clock;next_system=4
            allocated=3;pending=[('spawn',i) for i in (1,2,3)]
        elif op=='barrier':
            for action,i in pending:
                if action=='spawn':
                    values[i]=[0,[1,2,1][i-1],[2,1,1][i-1]];live.append(i);stamps[i]=[]
                    for k in range(3):clock+=1;stamps[i].append((clock,clock))
                else:live.remove(i);del values[i];stamps[i]=[(0,0)]*3
            pending=[]
        elif op=='game':
            if 'Move' not in cursors:
                registrations[0:0]=[(5,'Damage'),(4,'Move')];cursors.update(Move=0,Damage=0);next_system=6
            for i in live:
                values[i][0]+=values[i][1];clock+=1;stamps[i][0]=stamps[i][0]
            cursors['Move']=clock
            for i in live:
                if values[i][0]<2:continue
                values[i][2]-=1;clock+=1;stamps[i][2]=stamps[i][2]
                if values[i][2]==0:pending.append(('despawn',i))
            cursors['Damage']=clock
        observe(label)
    assert len(result)==14
    assert [(r['registries'].get('Move',{}).get('cursor'),r['registries'].get('Damage',{}).get('cursor')) for r in result if r['label'].endswith('damage')]==[(12,13),(15,17),(18,19)]
    assert result[-1]['stamps']=={i:[(0,0)]*3 for i in (1,2,3)}
    return result
