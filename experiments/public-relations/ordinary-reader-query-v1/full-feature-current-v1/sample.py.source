"""Qualified direct-driver protocol; complete observations, no process execution."""
import json,re
REGION='whole-feature-setup-operations-full-trace'
def same(actual,expected):
    if type(actual) is not type(expected):return False
    if isinstance(expected,dict):return actual.keys()==expected.keys() and all(same(actual[k],v) for k,v in expected.items())
    if isinstance(expected,list):return len(actual)==len(expected) and all(same(a,b) for a,b in zip(actual,expected))
    return actual==expected

def invalid_constant(value):raise ValueError('non-JSON numeric constant: '+value)

def validate(stdout,stderr,expected,walk):
    actual=json.loads(stdout,parse_constant=invalid_constant)
    if not same(actual,expected):raise ValueError('complete typed independent trace mismatch')
    markers=[json.loads(line) for line in stderr.splitlines()]
    if len(markers)!=2 or markers[0]!={'boundary':'begin'}:raise ValueError('exact Begin then Complete required')
    end=markers[1]
    if set(end)!={'boundary','nodes','characters','sum','region','elapsedNs'} or end['boundary']!='complete-trace-forced' or end['region']!=REGION:raise ValueError('exact complete region required')
    if any(type(end[k]) is not int or end[k]!=walk[k] for k in ('nodes','characters','sum')):raise ValueError('complete forcing walk mismatch')
    if not isinstance(end['elapsedNs'],str) or not re.fullmatch(r'[0-9]+',end['elapsedNs']):raise ValueError('decimal elapsedNs required')
    return {'elapsedNs':end['elapsedNs'],'region':REGION,'nodes':end['nodes'],'characters':end['characters'],'sum':end['sum']}
