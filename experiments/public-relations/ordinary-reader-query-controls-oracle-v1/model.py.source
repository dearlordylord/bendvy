"""Independent finite source model for frozen ordinary reader/query declaration-key controls.
No compiler/runtime outputs are inputs. Generic Data spelling follows installed show_val.
"""
import copy, json, os
from pathlib import Path
ROOT = Path('/workspace/formal-proofs/bendvy')
ENTRY = Path('/workspace/formal-proofs/bendvy-worktrees/relations42-reader-query-v1/experiments/public-relations/ordinary-reader-query-v1/controls-v1/namespace-normal')
def ctor(module, name, *fields):
    ns = module if module in ('consumer','fixture') else os.path.relpath(ROOT/'src/ecs'/module, ENTRY)
    return ns+'.'+name+'{'+', '.join(fields)+'}'
def ls(values): return '['+', '.join(values)+']'
def st(value): return json.dumps(value, ensure_ascii=False)
def nat(value): return str(value)+'n'
def desc(): return ctor('relation-types','Descriptor','2',st('Parent'),st('Children'),ctor('relation-types','Hierarchy'))
def failure(source,target,kind,*args):
    return ctor('relation-commands','RelationFailed',ctor('relation-types','Failure',desc(),ctor('relation-types','Relate'),str(source),str(target),ctor('relation-types',kind,*[st(x) if isinstance(x,str) else str(x) for x in args])))
ORIGINAL=ctor('relation-commands','Original','99')
CYCLE=failure(1,2,'HierarchyCycle',1,2,'Parent')
SELF=failure(3,3,'SelfRelationNotAllowed',3,'Parent')
MISSING=failure(2,99,'MissingTargetEntity',2,99,'Parent')
def reg(i,name,access,cursor): return ctor('consumer','RegistryView','1',str(i),st(name),ls([st(access)]),str(cursor))
def world(clock,pending,edge):
    slots='N(N(L(absent),L(P(L(1),N(L(11),L(21))))),N(L(P(L(2),N(L(12),L(22)))),L(P(L(3),N(L(13),L(23))))))'
    graph='[2:Parent:Children:hierarchy:2>1]/[2:Parent:Children:hierarchy:1:[2]]' if edge else '[]/[]'
    return 'world=1,4,3,N(N(L(False),L(True)),N(L(True),L(True))),4,2/'+slots+'/removed=/graph='+graph+'/resource=N(L(77),L(88))/events=[original:99]/pending='+str(pending)+'/regs=[4:ParentFailures:[Parent:read], 3:ParentInverse:[Parent:read], 2:ParentWriter:[Parent:write], 1:Existing:[Link, Parent]]/nextSystem=5/clock='+str(clock)
def domain(batches,active):
    key=ctor('internal/relation-failures/domains','DeclaredKey','2')
    back=[ctor('internal/relation-failures/queue','Batch','22n','1n',ls([x])) for x in batches]
    queue=ctor('internal/relation-failures/queue','Queue','[]',ls(back),nat(len(back)),'0n')
    return ctor('internal/relation-failures/domains','Domain',key,queue,'[4]' if active else '[]')
def reading(values, key=2):
    return ctor('internal/relation-failures/readings','KeyReading',ctor('internal/relation-failures/domains','DeclaredKey',str(key)),ls(values),'False{}')
def derive(wrong_key=False):
    # with_world advances clock before tracked execution; first barrier's seeded tick
    # advances once more after its stamped barrier tick. No frame/trim is invoked.
    states=[(13,1,False,0,0,0,False),(14,2,False,14,0,0,False),(15,2,False,14,15,0,False),(17,0,True,14,15,0,False),(18,0,True,14,18,0,False),(19,1,True,19,18,0,False),(20,2,True,20,18,0,False),(21,3,True,21,18,0,False),(22,0,True,21,18,0,False),(23,0,True,21,18,23,True),(24,0,True,21,18,24,True)]
    snapshots=[]
    for index,(clock,pending,edge,wc,ic,fc,active) in enumerate(states):
        domains=ls([domain([MISSING,SELF,CYCLE],active and not wrong_key)]) if index>=8 else '[]'
        if active and wrong_key:
            empty=ctor('internal/relation-failures/queue','Queue','[]','[]','0n','0n')
            link=ctor('internal/relation-failures/domains','Domain',ctor('internal/relation-failures/domains','DeclaredKey','1'),empty,'[4]')
            domains=ls([domain([MISSING,SELF,CYCLE],False),link])
        positions=ls([ctor('event-runtime','Position','4',nat(fc),'22n')]) if active else '[]'
        # Runtime tick remains first barrier stamp16 despite command advancing World17.
        tick=16 if index==3 else clock
        snapshots.append(ctor('consumer','Snapshot',st(world(clock,pending,edge).replace('4:ParentFailures:[Parent:read]','4:ParentFailures:[Link:read]') if wrong_key else world(clock,pending,edge)),ls([ORIGINAL]),domains,positions,nat(tick),'0n','0n','65536n',reg(2,'ParentWriter','Parent:write',wc),reg(3,'ParentInverse','Parent:read',ic),reg(4,'ParentFailures','Link:read' if wrong_key else 'Parent:read',fc),'[101, 102]'))
    report=ctor('consumer','Report',ls(snapshots),ls([ctor('relation-commands','Queued')]*4),ls(['Some{[]}','Some{'+ls([ctor('world','Handle','1','2')])+'}']),ls([ls([reading([] if wrong_key else [CYCLE,SELF,MISSING],1 if wrong_key else 2)]),ls([reading([],1 if wrong_key else 2)])]))
    return ('Some{'+report+'}\n').encode()
if __name__=='__main__':
    import sys
    sys.stdout.buffer.write(derive(len(sys.argv)>1 and sys.argv[1]=='wrong-key'))
