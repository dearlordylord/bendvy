"""Independent finite source model for frozen ordinary reader/query fixture.
No compiler/runtime outputs are inputs. Generic Data spelling follows installed show_val.
"""
import copy, json, os
from pathlib import Path
ROOT = Path('/workspace/formal-proofs/bendvy')
ENTRY = Path('/workspace/formal-proofs/bendvy-worktrees/relations42-reader-query-v1/experiments/public-relations/ordinary-reader-query-v1/foreign-composition-v1')
def ctor(module, name, *fields):
    ns = '../mutation-composition-v1/'+module if module in ('consumer','fixture') else 'consumer' if module=='outer' else os.path.relpath(ROOT/'src/ecs'/module, ENTRY)
    return ns+'.'+name+'{'+', '.join(fields)+'}'
def ls(values): return '['+', '.join(values)+']'
def st(value): return json.dumps(value, ensure_ascii=False)
def nat(value): return str(value)+'n'
def desc(): return ctor('relation-types','Descriptor','2',st('Parent'),st('Children'),ctor('relation-types','Hierarchy'))
def failure(source,target,kind,*args):
    return ctor('relation-commands','RelationFailed',ctor('relation-types','Failure',desc(),ctor('relation-types','Relate'),str(source),str(target),ctor('relation-types',kind,*[st(x) if isinstance(x,str) else str(x) for x in args])))
ORIGINAL=ctor('relation-commands','Original','99')
CYCLE=failure(1,2,'HierarchyCycle',1,2,'Parent')
SELF=failure(3,3,'SelfRelationNotAllowed',3,'Parent')
MISSING=failure(2,99,'MissingTargetEntity',2,99,'Parent')
def reg(i,name,access,cursor): return ctor('consumer','RegistryView','1',str(i),st(name),ls([st(access)]),str(cursor))
def world(clock,pending,peer=False):
    slots='N(N(L(absent),L(P(L(1),N(L(11),L(21))))),N(L(P(L(2),N(L(12),L(22)))),L(P(L(3),N(L(13),L(23))))))'
    regs='[]' if peer else '[3:ParentFailures:[Parent:read], 2:ParentInverse:[Parent:read], 1:ForeignParentWriter:[Parent:write]]'
    resource='N(L(177),L(188))' if peer else 'N(L(77),L(88))'
    return 'world='+str(2 if peer else 1)+',4,3,N(N(L(False),L(True)),N(L(True),L(True))),4,2/'+slots+'/removed=/graph=[]/[]/resource='+resource+'/events=[]/pending='+str(pending)+'/regs='+regs+'/nextSystem='+str(1 if peer else 4)+'/clock='+str(clock)
def reading():
    return ctor('internal/relation-failures/readings','KeyReading',ctor('internal/relation-failures/domains','DeclaredKey','2'),'[]','False{}')
def derive():
    # Receiver begins clock0; four foreign namespace requests preserve seeded
    # pending tick and return MissingEntity without staging or publishing.
    states=[(0,1,0,False),(1,1,1,False),(2,1,2,False),(3,1,3,False),(4,1,4,False),(6,0,4,False),(7,0,4,True)]
    snapshots=[]
    for i,(clock,pending,wc,active) in enumerate(states):
        domains=ls([ctor('internal/relation-failures/domains','Domain',ctor('internal/relation-failures/domains','DeclaredKey','2'),ctor('internal/relation-failures/queue','Queue','[]','[]','0n','0n'),'[3]')]) if active else '[]'
        positions=ls([ctor('event-runtime','Position','3','7n','5n')]) if active else '[]'
        tick=5 if i==5 else clock
        snapshots.append(ctor('consumer','Snapshot',st(world(clock,pending)),'[]',domains,positions,nat(tick),'0n','0n','65536n',reg(1,'ForeignParentWriter','Parent:write',wc),reg(2,'ParentInverse','Parent:read',0),reg(3,'ParentFailures','Parent:read',7 if active else 0),'[101, 102]'))
    inner=ctor('consumer','Report',ls(snapshots),ls([ctor('relation-commands','MissingEntity')]*4),'[]',ls([ls([reading()])]))
    local=ctor('world','Handle','1','1');alien=ctor('world','Handle','2','1')
    statuses=ls([ctor('world','Accepted')]*3)
    outer=ctor('outer','Report',inner,ls([st(world(0,0,True))]*7),'3',local,alien,'Some{[]}',statuses,statuses)
    return ('Some{'+outer+'}\n').encode()
if __name__=='__main__':
    import sys
    sys.stdout.buffer.write(derive())
