"""Independent finite source model for frozen ordinary reader/query fixture.
No compiler/runtime outputs are inputs. Generic Data spelling follows installed show_val.
"""
import copy, json, os
from pathlib import Path
ROOT = Path('/workspace/formal-proofs/bendvy')
ENTRY = Path('/workspace/formal-proofs/bendvy-worktrees/relations42-reader-query-v1/experiments/public-relations/ordinary-reader-query-v1/mutation-composition-v1/controls-v1/namespace-normal')
def ctor(module, name, *fields):
    ns = module if module in ('consumer','fixture') else os.path.relpath(ROOT/'src/ecs'/module, ENTRY)
    return ns+'.'+name+'{'+', '.join(fields)+'}'
def ls(values): return '['+', '.join(values)+']'
def st(value): return json.dumps(value, ensure_ascii=False)
def nat(value): return str(value)+'n'
def desc(): return ctor('relation-types','Descriptor','2',st('Parent'),st('Children'),ctor('relation-types','Hierarchy'))
def failure(source,target,kind,*args):
    return ctor('relation-commands','RelationFailed',ctor('relation-types','Failure',desc(),ctor('relation-types','Relate'),str(source),str(target),ctor('relation-types',kind,*[st(x) if isinstance(x,str) else str(x) for x in args])))
ORIGINAL=ctor('relation-commands','Original','99')
CYCLE=failure(1,2,'HierarchyCycle',1,2,'Parent')
SELF=failure(3,3,'SelfRelationNotAllowed',3,'Parent')
MISSING=failure(2,99,'MissingTargetEntity',2,99,'Parent')
def reg(i,name,access,cursor): return ctor('consumer','RegistryView','1',str(i),st(name),ls([st(access)]),str(cursor))
def world(clock,pending,edge):
    slots='N(N(L(absent),L(P(L(1),N(L(11),L(21))))),N(L(P(L(2),N(L(12),L(22)))),L(P(L(3),N(L(13),L(23))))))'
    graph='[2:Parent:Children:hierarchy:2>'+str(edge)+']/[2:Parent:Children:hierarchy:'+str(edge)+':[2]]' if edge else '[]/[]'
    return 'world=1,4,3,N(N(L(False),L(True)),N(L(True),L(True))),4,2/'+slots+'/removed=/graph='+graph+'/resource=N(L(77),L(88))/events=[original:99]/pending='+str(pending)+'/regs=[4:ParentFailures:[Parent:read], 3:ParentInverse:[Parent:read], 2:ParentWriter:[Parent:write], 1:Existing:[Link, Parent]]/nextSystem=5/clock='+str(clock)
def domain(batches,active):
    key=ctor('internal/relation-failures/domains','DeclaredKey','2')
    back=[ctor('internal/relation-failures/queue','Batch','22n','1n',ls([x])) for x in batches]
    queue=ctor('internal/relation-failures/queue','Queue','[]',ls(back),nat(len(back)),'0n')
    return ctor('internal/relation-failures/domains','Domain',key,queue,'[4]' if active else '[]')
def reading(values):
    return ctor('internal/relation-failures/readings','KeyReading',ctor('internal/relation-failures/domains','DeclaredKey','2'),ls(values),'False{}')
def derive(omitted=False):
    # Actual with_world/reader requests advance clock once. Deferred first barrier
    # additionally executes the fixture's seeded tick command before relation delivery.
    # No mutation emits failure events: duplicate relation is idempotent, replacement
    # removes old inverse, and absent repeated clear leaves the graph unchanged.
    # clock,pending,parentTarget,writerCursor,inverseCursor,failureCursor,readerActive
    states=[(13,1,0,0,0,0,False),
            (14,2,0,14,0,0,False),
            (16,0,1,14,0,0,False),
            (17,1,1,17,0,0,False),
            (18,2,1,18,0,0,False),
            (19,2,1,18,19,0,False),
            (20,0,3,18,19,0,False),
            (21,0,3,18,21,0,False),
            (22,0,3,18,22,0,False),
            (23,1,3,23,22,0,False),
            (24,1,3,23,24,0,False),
            (25,0,0,23,24,0,False),
            (26,0,0,23,26,0,False),
            (27,1,0,27,26,0,False),
            (28,0,0,27,26,0,False),
            (29,0,0,27,26,29,True),
            (30,0,0,27,26,30,True)]
    if omitted:
        # Request callback never executes: no staged clear command, no graph mutation.
        states=[(c,0 if i in (9,10,13) else p,3 if i>=9 else e,w,q,f,a) for i,(c,p,e,w,q,f,a) in enumerate(states)]
    snapshots=[]
    for index,(clock,pending,edge,wc,ic,fc,active) in enumerate(states):
        domains=ls([domain([],True)]) if active else '[]'
        positions=ls([ctor('event-runtime','Position','4',nat(fc),'28n')]) if active else '[]'
        # BarrierState.tick samples its initial advance; seeded tick makes World16.
        tick=15 if index==2 else clock
        snapshots.append(ctor('consumer','Snapshot',st(world(clock,pending,edge)),ls([ORIGINAL]),domains,positions,nat(tick),'0n','0n','65536n',reg(2,'ParentWriter','Parent:write',wc),reg(3,'ParentInverse','Parent:read',ic),reg(4,'ParentFailures','Parent:read',fc),'[101, 102]'))
    child=ctor('world','Handle','1','2')
    queries=['Some{'+ls([child])+'}','Some{[]}','Some{'+ls([child])+'}','Some{'+ls([child])+'}',('Some{'+ls([child])+'}' if omitted else 'Some{[]}')]
    report=ctor('consumer','Report',ls(snapshots),ls([ctor('relation-commands','Queued')]*5),ls(queries),ls([ls([reading([])]),ls([reading([])])]))
    return ('Some{'+report+'}\n').encode()
if __name__=='__main__':
    import sys
    sys.stdout.buffer.write(derive())
