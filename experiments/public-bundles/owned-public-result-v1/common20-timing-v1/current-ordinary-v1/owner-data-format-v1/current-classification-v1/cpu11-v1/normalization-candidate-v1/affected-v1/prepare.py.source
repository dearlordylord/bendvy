"""Preparation only; unchanged reviewed complete-output collector."""
import sys,json,gzip,hashlib,types
from pathlib import Path
HERE=Path(__file__).resolve().parent
ROOT=Path('/workspace/formal-proofs/bendvy')
COLLECTOR=ROOT/'experiments/public-inspect/ordinary-declaration-v1/canonical-adoption-v1/detached-v2/development.py'
def sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()
cat=Path(sys.argv[1]).resolve();catalogue=json.loads(cat.read_text());rows=[]
m=types.ModuleType('collector');m.__file__=str(COLLECTOR);exec(compile(COLLECTOR.read_bytes(),str(COLLECTOR),'exec'),m.__dict__)
for subject in ['normal','key-omitted']:
 selected=catalogue[subject];oracle=Path(selected.get('gzip') or selected['stdout']);raw=gzip.decompress(oracle.read_bytes())
 assert len(raw)==selected['bytes'] and hashlib.sha256(raw).hexdigest()==selected['sha256']
 source=HERE/subject;capture=source/'source01';receipt=json.loads((capture/'result.json').read_text());assert receipt['exit']==0 and not receipt.get('failure') and json.loads((capture/'post.json').read_text())['unchanged']
 inventory={k:v for k,v in json.loads((capture/'SOURCE.json').read_text())['pins'].items() if k.endswith('.bend')};assert all(sha(k)==v for k,v in inventory.items())
 closure=m.validate_imports(str(source/'main.bend'),inventory)
 baseline=Path(catalogue['normal'].get('gzip') or catalogue['normal']['stdout']);baselineSelection=catalogue['normal']
 for role in ['js','native']:
  template=HERE.parent/'runtime01'/role/'plan.json';plan=json.loads(template.read_text());stage=HERE/'runtime01'/subject/role;stage.mkdir(parents=True,exist_ok=False)
  entry=str(source/'main.bend');generated=str(stage/('scenario.js' if role=='js' else 'scenario.c'));native=str(stage/'scenario.native');mapping={plan['entrypoint']:entry,plan['generated']:generated}
  if plan.get('native'):mapping[plan['native']]=native
  for c in plan['commands']:c['argv']=[mapping.get(x,x) for x in c['argv']]
  plan.update(scope='Private four-call normalization candidate finite50 complete observations and affine owners; actual key-omission countermodel versus matched baseline; no approved law proof or performance credit',subject='mutant' if subject=='key-omitted' else 'normal',stage=str(stage),entrypoint=entry,sourceInventory=inventory,importClosure=closure,generated=generated,native=native,oracle=str(oracle),oracleSHA256=selected['sha256'],oracleBytes=selected['bytes'],normalOracle=str(baseline),normalOracleSHA256=baselineSelection['sha256'],normalOracleBytes=baselineSelection['bytes'])
  plan['pins']=dict(inventory)
  extras=[Path(__file__),COLLECTOR,template,HERE/'FREEZE.json',HERE/'CASES.json',cat]+[x for x in cat.parent.rglob('*') if x.is_file()]+[x for x in capture.rglob('*') if x.is_file()]+[Path(x) for x in json.loads(template.read_text())['pins'] if not x.endswith('.bend')]
  for x in extras:
   if x.is_file():plan['pins'][str(x.resolve())]=sha(x)
  target=stage/'plan.json';target.write_text(json.dumps(plan,indent=2)+'\n');rows.append({'subject':subject,'role':role,'path':str(target),'sha256':sha(target),'execute':[plan['tools']['python'],str(COLLECTOR),'run',str(target),sha(target)]})
(HERE/'runtime01/SEQUENCE.json').write_text(json.dumps(rows,indent=2)+'\n');print(json.dumps(rows))
