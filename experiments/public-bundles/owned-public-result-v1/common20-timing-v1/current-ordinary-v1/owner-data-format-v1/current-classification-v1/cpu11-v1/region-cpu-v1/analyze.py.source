from pathlib import Path
import json,hashlib,collections,re
HERE=Path(__file__).resolve().parent
plan=json.loads((HERE/'actual01/plan.json').read_text());profilepath=HERE/'actual01/region.cpuprofile';profile=json.loads(profilepath.read_text());artifact=Path(plan['commands'][0]['argv'][-1]);url=artifact.resolve().as_uri();text=artifact.read_text().splitlines();nodes={n['id']:n for n in profile['nodes']};parents={}
for n in profile['nodes']:
 for child in n.get('children',[]):
  if child in parents:raise ValueError('Multiple sample parents')
  parents[child]=n['id']
assert len(profile['samples'])==len(profile['timeDeltas']) and len(nodes)==len(profile['nodes'])
def decoded(s):return re.sub(r'\$+(\d{3})',lambda m:chr(int(m[1])),s).strip('$')
def normalized(s):return re.sub('~[0-9]+$','',decoded(s))
def module(s):return s.rsplit(':',1)[0] if ':' in s else s
selfcounts=collections.Counter(profile['samples']);inclusive=collections.Counter();functionleaf=collections.Counter();functioninclusive=collections.Counter();moduleleaf=collections.Counter();moduleinclusive=collections.Counter();artifactLeaf=0
for leaf in profile['samples']:
 assert leaf in nodes
 frame=nodes[leaf]['callFrame'];artifactLeaf+=frame['url']==url;name=normalized(frame['functionName']);functionleaf[name]+=1;moduleleaf[module(name)]+=1
 seen=set();functions=set();modules=set();n=leaf
 while n is not None:
  if n in seen:raise ValueError('Cycle')
  seen.add(n);name=normalized(nodes[n]['callFrame']['functionName']);functions.add(name);modules.add(module(name));n=parents.get(n)
 inclusive.update(seen);functioninclusive.update(functions);moduleinclusive.update(modules)
root=Path('/workspace/formal-proofs/bendvy');sourcebase=Path('/workspace/formal-proofs/bendvy-worktrees/bundle41-authority-refresh-v1/experiments/public-bundles/owned-public-result-v1/common20-timing-v1/current-ordinary-v1/owner-data-format-v1/current-classification-v1/source')
def mapped(frame):
 name=normalized(frame['functionName']);result={}
 if frame['url']==url:
  line=frame['lineNumber']+1;assert 1<=line<=len(text);result={'artifact':str(artifact),'artifactLine':line,'exactGeneratedLine':text[line-1]}
  file=None;definition=None
  if ':' in name:
   mod,definition=name.rsplit(':',1)
   if '/bendvy/src/ecs/' in mod:file=root/'src/ecs'/(mod.split('/bendvy/src/ecs/',1)[1]+'.bend')
   elif '/source-v1/' in mod:file=sourcebase/'source-v1'/(mod.split('/source-v1/',1)[1]+'.bend')
   elif mod in ['main','lifecycle-a','lifecycle-b']:file=sourcebase/'owner-data-format-v1'/(mod+'.bend')
  elif name.startswith('a_') or name.startswith('b_') or name=='capture_snapshot':file=sourcebase/'owner-data-format-v1/main.bend';definition=name
  if file and file.is_file():
   lines=file.read_text().splitlines();matches=[i+1 for i,s in enumerate(lines) if re.match(r'^def '+re.escape(definition)+r'\s*\(',s)]
   if len(matches)==1:result.update(source=str(file),sourceLine=matches[0],sourceSHA256=hashlib.sha256(file.read_bytes()).hexdigest(),definition=definition)
 return result
rows=[]
for n in profile['nodes']:
 frame=n['callFrame'];rows.append({'nodeId':n['id'],'selfSamples':selfcounts[n['id']],'inclusiveSamples':inclusive[n['id']],'frame':frame,'decoded':decoded(frame['functionName']),'mapping':mapped(frame)})
result={'scope':'Unweighted sampled leaf and inclusive call counts, not time percentages, allocation/RSS or causal speedup. Inclusive groups overlap; normalized function/module ancestry deduplicated per sample. Module startup may remain in ancestors but leaf collection begins at explicit region profiler start.','profileSHA256':hashlib.sha256(profilepath.read_bytes()).hexdigest(),'artifactSHA256':hashlib.sha256(artifact.read_bytes()).hexdigest(),'artifactURL':url,'samples':len(profile['samples']),'nodes':len(nodes),'generatedArtifactLeafSamples':artifactLeaf,'otherLeafSamples':len(profile['samples'])-artifactLeaf,'startTime':profile['startTime'],'endTime':profile['endTime'],'profileDurationUs':profile['endTime']-profile['startTime'],'selfTop30':sorted(rows,key=lambda r:r['selfSamples'],reverse=True)[:30],'inclusiveTop30':sorted(rows,key=lambda r:r['inclusiveSamples'],reverse=True)[:30],'functionLeaf':functionleaf.most_common(),'functionInclusive':functioninclusive.most_common(),'moduleLeaf':moduleleaf.most_common(),'moduleInclusive':moduleinclusive.most_common(),'allNodeMappings':rows}
(HERE/'PROFILE-ANALYSIS.json').write_text(json.dumps(result,indent=2)+'\n');print(result['samples'],result['generatedArtifactLeafSamples'],result['otherLeafSamples'])
