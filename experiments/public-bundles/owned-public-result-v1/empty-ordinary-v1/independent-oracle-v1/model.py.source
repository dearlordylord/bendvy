"""Source-derived finite empty-bundle lifecycle; no producer output inputs."""
import json
from copy import deepcopy

def array(value):
    if isinstance(value, tuple):
        return 'node(' + array(value[0]) + ',' + array(value[1]) + ')'
    return ('True' if value else 'False') if isinstance(value, bool) else 'leaf:' + str(value)

def create(namespace):
    return dict(namespace=namespace, next=1, high=0, live=False, capacity=1,
                depth=0, store=((11, 12), (21, 22)), resources=((31, 32), (41, 42)),
                events=[], pending=[], registrations=[(1, 'empty-bundle', ['bundle:write'])],
                nextSystem=2, clock=0, registry=(namespace, 1, 'empty-bundle', ['bundle:write'], 0),
                context=(51, 52))

def request(world, operation):
    # Ordinary.terminal has no metadata; CS.terminal retains context/Unit/identity undo.
    # BT.finish stages commands, it does not execute the delivery callbacks.
    before = deepcopy(world)
    if operation == 'spawn':
        target = (world['namespace'], world['next'])
        assert world['next'] == 1
        world.update(next=2, high=1, live=(False, False), capacity=2, depth=1)
        world['pending'] += [('activate', target), ('deliver-empty', target)]
        result = ('Accepted', target, True)
    else:
        target = (world['namespace'], 1) if operation == 'insert' else (0, 0)
        valid = target[0] == world['namespace'] and target[1] == 1 and isinstance(world['live'], tuple) and world['live'][1]
        if valid:
            world['pending'] += [('deliver-empty', target)]
            result = ('Accepted', target, False)
        else:
            assert before == world
            result = ('Refused', 'Unit', 'MissingEntity')
    # Sys.run_tracked succeeds even when the request's value is Refused.
    ns, id_, name, access, _ = world['registry']
    world['registry'] = (ns, id_, name, access, world['clock'])
    assert world['store'] == before['store'] and world['resources'] == before['resources']
    assert world['context'] == before['context'] and world['events'] == before['events']
    return result

def barrier(world):
    commands = world['pending']
    world['pending'] = []
    for action, target in commands:
        assert target == (world['namespace'], 1)
        if action == 'activate':
            world['live'] = (world['live'][0], True)
        else:
            assert action == 'deliver-empty' and world['live'][1]
            # Consumer attempt consumes Packet{Unit,undo} and returns the same World.

def unquoted_list(values):
    return '[' + ', '.join(values) + ']'

def observe(w):
    meta = unquoted_list(str(i) + ':' + name + ':' + unquoted_list(access) for i, name, access in w['registrations'])
    ns, id_, name, access, cursor = w['registry']
    return ('World{ns=' + str(w['namespace']) + ',next=' + str(w['next']) + ',high=' + str(w['high'])
            + ',live=' + array(w['live']) + ',capacity=' + str(w['capacity']) + ',depth=' + str(w['depth'])
            + ',store=' + array(w['store'][0]) + '/' + array(w['store'][1])
            + ',resources=' + array(w['resources'][0]) + '/' + array(w['resources'][1])
            + ',events=' + unquoted_list(map(str, w['events'])) + ',pending=' + str(len(w['pending']))
            + ',registrations=' + meta + ',nextSystem=' + str(w['nextSystem']) + ',clock=' + str(w['clock'])
            + '}|Registry{' + str(ns) + ':' + str(id_) + ':' + name + ':' + unquoted_list(access) + ':' + str(cursor)
            + '}|context=' + array(w['context']))

def schema(namespace):
    w = create(namespace)
    rows = ['before|' + observe(w)]
    assert request(w, 'spawn') == ('Accepted', (namespace, 1), True)
    assert w['live'] == (False, False) and len(w['pending']) == 2
    rows.append('spawn-queued|' + observe(w))
    barrier(w)
    assert w['live'] == (False, True) and not w['pending']
    rows.append('spawn-barrier|' + observe(w))
    prior = deepcopy(w)
    barrier(w)
    assert w == prior
    rows.append('spawn-empty-barrier|' + observe(w))
    assert request(w, 'insert') == ('Accepted', (namespace, 1), False)
    assert len(w['pending']) == 1
    rows.append('insert-queued|' + observe(w))
    barrier(w)
    rows.append('insert-barrier|' + observe(w))
    barrier(w)
    assert w == prior
    rows.append('insert-empty-barrier|' + observe(w))
    assert request(w, 'missing') == ('Refused', 'Unit', 'MissingEntity')
    assert w == prior
    rows.append('missing=MissingEntity,raw=Unit|' + observe(w))
    return rows

def expected():
    # main threads W.Factory from First to Second; no process-local reset.
    rows = schema(1) + schema(2) + ['Factory=3']
    assert len(rows) == 17
    return (json.dumps(rows, ensure_ascii=False) + '\n').encode()

if __name__ == '__main__':
    import hashlib
    raw = expected()
    print(json.dumps({'status': 'PASS_FINITE_SELFTEST', 'items': 17, 'bytes': len(raw), 'sha256': hashlib.sha256(raw).hexdigest()}))
