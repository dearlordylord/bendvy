  health_spawn_main_finish(main,Some{T.Tracked{8}},X.tx_reserve(S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>,health_world_reserve,t))
