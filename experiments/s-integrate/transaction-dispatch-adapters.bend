  motion_spawn_main_finish(main,Some{T.Selected{8}},X.tx_reserve(S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>,motion_world_reserve,t))

def health_insert_flag(t:X.Tx<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>>,flag:T.Tracked) -> X.Tx<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>>:
  match t:
    case X.Tx{world,S.Handle{+namespace,+id},undo,commands,pings,marks}: X.tx_stage_command(S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>,X.Tx{world,S.Handle{namespace,id},undo,commands,pings,marks},S.InsertFlag{id,flag})
def health_spawn_main_finish(main:T.Vitals,flag:Maybe<&2,T.Tracked>,result:X.Tx<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>> & Maybe<&2,S.Handle<T.HealthSchema>>) -> T.Reservation<X.Tx<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>>,S.Handle<T.HealthSchema>,T.Vitals>:
  match result:
    case (t,None{}): T.ReserveRejected{t,main}
    case (t,Some{S.Handle{+namespace,+id}}): T.Reserved{X.tx_stage_command(S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>,t,S.Spawn{id,S.Bundle{Some{main},None{},flag}}),S.Handle{namespace,id}}
def health_spawn_main(t:X.Tx<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>>,main:T.Vitals) -> T.Reservation<X.Tx<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>>,S.Handle<T.HealthSchema>,T.Vitals>:
