"""Complete source-derived selector delivery/trace sensitivity countermodels."""
import argparse
from pathlib import Path
import runpy
import sys

NORMAL = runpy.run_path(str(Path(__file__).resolve().parent.parent / 'selector-handlers-v1/model.py.source'))
VARIANTS = ('relocated-control', 'missing-failure', 'delivery-order', 'reset-owner')


class ReversedCollector(NORMAL['Collector']):
    def deliver(self, events):
        # The actual copied delivery helper reverses EACH Ready batch only.
        super().deliver(list(reversed(events)))


class State(NORMAL['State']):
    def __init__(self, variant):
        if variant not in VARIANTS:
            raise ValueError(variant)
        super().__init__(1)
        self.variant = variant
        self.collector = self.make_collector(100, 200)

    def make_collector(self, first, second):
        factory = ReversedCollector if self.variant == 'delivery-order' else NORMAL['Collector']
        return factory(first, second)

    def run_handlers(self):
        status, events = super().run_handlers()
        if self.variant == 'missing-failure' and status.startswith('HandlerFailed') and events:
            # Private TraceRun.named changes only HandlerFailed's completion tag;
            # actual handler status/recovery and every prior fact remain real.
            assert events[-1] == 'ScheduleEnded{outcome=EndFailed{error=expected-transition-failure}}'
            events[-1] = 'ScheduleEnded{outcome=EndOk}'
        return status, events

    def reset(self):
        incoming = self.make_collector(300, 400)
        if self.variant == 'reset-owner':
            # Actual mutant returns incoming and keeps the old subscriber owner.
            self.returned.append(incoming)
        else:
            self.returned.append(self.collector)
            self.collector = incoming
        self.checkpoint('reset')

    def run(self):
        self.checkpoint('initial')
        self.perform('missing-disabled')
        self.debug = True
        self.checkpoint('enabled')
        self.perform('missing-enabled')
        self.clock += 1
        self.current = 0
        self.changed = True
        self.revision += 1
        self.back.insert(0, (self.clock, 'Initial{0}'))
        self.queue('queued-one', 1)
        self.perform('transition-one')
        self.queue('queued-two', 2)
        self.perform('transition-two-fails')
        self.perform('retry-same-two')
        self.queue('queued-zero', 0)
        self.perform('transition-zero')
        self.debug = False
        self.checkpoint('disabled-again')
        self.queue('queued-one-disabled', 1)
        self.perform('transition-one-disabled')
        self.reset()
        self.debug = True
        self.checkpoint('re-enabled')
        self.perform('idle-enabled')
        self.output.append('terminalApp=' + self.app() + ';terminalStatuses=' + NORMAL['nested'](self.statuses)
                           + ';terminalQueues=' + NORMAL['nested'](self.queues) + '\n')
        self.output.append('unsubscribedOwners=' + NORMAL['nested']([x.show() for x in self.returned + [self.collector]]) + '\n')
        return ''.join(self.output)


def render(variant):
    return ('Workshop\n' + State(variant).run() + '\n').encode()


def self_test():
    assert render('relocated-control') == NORMAL['render']('Workshop')
    control = State('relocated-control')
    control.run()
    for variant in VARIANTS[1:]:
        state = State(variant)
        state.run()
        assert list(state.checkpoints) == list(control.checkpoints) and len(state.checkpoints) == 25
        for label in control.checkpoints:
            assert state.checkpoints[label][:10] == control.checkpoints[label][:10]
            assert state.checkpoints[label][12:] == control.checkpoints[label][12:]
        assert state.world() == control.world() and state.snapshot() == control.snapshot()
        assert render(variant) != render('relocated-control')
        assert render(variant).endswith(b'\n\n')
        assert state.statuses == control.statuses and len(state.statuses) == 8
        if variant == 'missing-failure':
            failures = [events for _, _, events in state.batches if any('Refused{expected-transition-failure}' in x for x in events)]
            assert len(failures) == 2
            assert all(events[-1] == 'ScheduleEnded{outcome=EndOk}' for events in failures)
            assert sum('HandlerFailed' in x for x in state.statuses) == 2
        elif variant == 'delivery-order':
            assert state.returned[0].events == [event for _, _, events in state.batches[:-1] for event in reversed(events)]
            assert state.collector.events == list(reversed(state.batches[-1][2]))
            assert len(state.returned[0].events) == 53 and len(state.collector.events) == 7
            assert state.batches == control.batches
        else:
            assert not state.returned[0].events and state.returned[0].first == 300
            assert state.returned[0].second == 400 and len(state.collector.events) == 60
            assert state.collector.first == 160 and state.collector.second == 200
            assert state.batches == control.batches


if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('--variant', choices=VARIANTS)
    parser.add_argument('--self-test', action='store_true')
    parser.add_argument('--render-stdout', action='store_true')
    options = parser.parse_args()
    if options.self_test:
        self_test()
        print('independent full trace sensitivity countermodels: PASS', file=sys.stderr)
    if options.render_stdout:
        if options.variant is None:
            parser.error('--render-stdout requires --variant')
        sys.stdout.buffer.write(render(options.variant))
