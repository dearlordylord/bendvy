"""Independent selector-handler ordinary-consumer state model; no runtime input."""
import argparse
import copy
from dataclasses import dataclass, field
import sys


def ls(values):
    return '[' + ', '.join(map(str, values)) + ']'


def nested(values):
    out = '[]'
    for value in reversed(values):
        out = '[' + value + ';' + out + ']'
    return out


def pair(a, b):
    return f'node(leaf:{a},leaf:{b})'


NAMES = ['exit-zero', 'zero-one', 'enter-one', 'exit-one', 'one-two-fails', 'enter-two']
SELECTORS = ['ExitFrom{0}', 'TransitionPair{from=0;to=1}', 'EnterTo{1}',
             'ExitFrom{1}', 'TransitionPair{from=1;to=2}', 'EnterTo{2}']
STEPS = ['Barrier'] + [item for i, phase in enumerate(['apply', 'exit', 'transition', 'enter'], 1)
                       for item in ['Phase{' + phase + '}', f'System{{{i};condition=0}}']]
ERROR = 'expected-transition-failure'


@dataclass
class Collector:
    first: int
    second: int
    events: list = field(default_factory=list)

    def deliver(self, events):
        self.events.extend(events)
        self.first += len(events)

    def show(self):
        return f'collector{{calls={len(self.events)};events=' + ls(self.events) + ';owned=' + pair(self.first, self.second) + '}'


class State:
    def __init__(self, namespace):
        self.ns = namespace
        self.debug = False
        self.clock = 0
        self.pending = True
        self.counter = [10, 11]
        self.current = None
        self.target = None
        self.previous = None
        self.changed = False
        self.revision = 0
        self.back = []
        self.cursors = [0] * 6
        self.collector = Collector(100, 200)
        self.returned = []
        self.statuses, self.queues = [], []
        self.output, self.checkpoints, self.batches = [], {}, []

    def handler(self, ordinal):
        return (f'handler{{ordinal={ordinal};registry{{namespace={self.ns};id={ordinal};name='
                + NAMES[ordinal - 1] + ';access=[Counter];cursor=' + str(self.cursors[ordinal - 1]) + '}}')

    def bundle(self):
        entries = ''.join('scheduled{selector=' + SELECTORS[i] + ';requirements=[ModeRequired];'
                          + self.handler(i + 1) + '};' for i in range(6)) + '[]'
        return f'bundle{{namespace={self.ns};entries=' + entries + '}'

    def machine(self):
        if self.current is None:
            slot = 'Missing'
        else:
            pending = 'NoPending' if self.target is None else f'Queued{{value={self.target};skipSame=False}}'
            previous = 'None' if self.previous is None else f'Some{{{self.previous}}}'
            slot = f'Present{{current={self.current};pending={pending};previous={previous};changed={self.changed}}}'
        batches = [f'Batch{{tick={tick};count=1;values=[' + event + ']}' for tick, event in self.back]
        stream = ('Stream{Queue{front=[];back=' + ls(batches) + f';size={len(batches)};dropped=0;batchCount={len(batches)}'
                  + '};positions=[];frameStart=0}')
        return 'State{slot=' + slot + ';stream=' + stream + f';revision={self.revision}' + '}'

    def world(self):
        registrations = ls([f'{i}:{NAMES[i - 1]}:[Counter]' for i in range(6, 0, -1)])
        return (f'world{{namespace={self.ns};allocator{{next=1;high=0;capacity=1;depth=0;slots=leaf:0:Consumed;free=[];order=[]}}'
                + ';store=Unit;resources{Counter=' + pair(*self.counter) + ';Mode=' + self.machine()
                + '};events=[];pending=' + ('Raw(opaque),end' if self.pending else 'end')
                + ';registrations=' + registrations + f';nextSystemId=7;clock={self.clock}' + '}')

    def app(self):
        return ('app{declaration=selector-phases;debug=' + str(self.debug) + ';' + self.world()
                + ';' + self.bundle() + ';extra=' + pair(600, 601) + '}')

    def snapshot(self):
        if not self.debug:
            return 'None'
        entries = []
        for i in range(6):
            entries.append('entryView{selector=' + SELECTORS[i] + ';requirements=[ModeRequired];namespace='
                           + str(self.ns) + f';ordinal={i + 1};id={i + 1};name=' + NAMES[i]
                           + ';access=[Counter];cursor=' + str(self.cursors[i]) + '}')
        return f'Some{{namespace={self.ns};name=selector-phases;steps=' + ls(STEPS) + ';entries=' + ls(entries) + '}'

    def checkpoint(self, label):
        app, snapshot = self.app(), self.snapshot()
        text = ('checkpoint=' + label + '\nappBeforeSnapshot=' + app + '\nsnapshot=' + snapshot
                + '\nappAfterSnapshot=' + app + '\nsnapshotRepeated=' + snapshot
                + '\nappAfterRepeatedSnapshot=' + app + '\nsubscriber=subscriber{' + self.collector.show()
                + '}\nreturned=' + nested([x.show() for x in self.returned])
                + ';statuses=' + nested(self.statuses) + ';queues=' + nested(self.queues) + '\n')
        self.output.append(text)
        self.checkpoints[label] = copy.deepcopy((self.clock, self.pending, self.counter, self.current,
                                                self.target, self.previous, self.changed, self.revision,
                                                self.back, self.cursors, self.collector, self.returned,
                                                self.statuses, self.queues, self.debug))

    def identity(self, ordinal):
        return f'identity{{namespace={self.ns};id={ordinal};name=Some{{' + NAMES[ordinal - 1] + '}}'

    def handler_fact(self, ordinal, phase, result):
        return (f'HandlerFact{{namespace={self.ns};id={ordinal};name=' + NAMES[ordinal - 1]
                + f';ordinal={ordinal};phase={phase}Phase;from=OpaqueValue;to=OpaqueValue;result=' + result + '}')

    def invoke(self, ordinal, phase, target, events):
        before = self.counter[0]
        failed = target == 2 and ordinal == 5
        after = before + ordinal
        result = 'RolledBack' if failed else 'Applied'
        # T.finish_observed settles the initial HandlerFact and write together.
        events.append('ExecutionOperationObserved{fact=' + self.handler_fact(ordinal, phase, result) + '}')
        fact = ('Fact{category=ResourceValue;key=Counter;operation=WriteOperation;subject=None;before=DisplayedValue{'
                + str(before) + '};after=DisplayedValue{' + str(after) + '};result=' + result + '}')
        events.append('OperationObserved{' + self.identity(ordinal) + ';fact=' + fact + '}')
        terminal = 'Refused{' + ERROR + '}' if failed else 'Applied'
        events.append('ExecutionOperationObserved{fact=' + self.handler_fact(ordinal, phase, terminal) + '}')
        if not failed:
            self.counter = [after, ordinal]
            self.cursors[ordinal - 1] = self.clock
        return failed

    def run_handlers(self):
        if self.current is None:
            return 'MissingRequirements{[ModeRequired]}', ([] if not self.debug else [
                f'ScheduleAdmissionRefused{{namespace={self.ns};name=selector-phases;outcome=EndMissing}}'])
        if self.pending:
            self.pending = False
            self.clock += 1
        events = [f'ScheduleStarted{{namespace={self.ns};name=selector-phases}}', 'DeferredApplied']
        target, current = self.target, self.current
        self.target = None
        self.changed = False
        if target is not None:
            self.previous = current
        failed = False
        phase = None
        for phase in ['apply', 'exit', 'transition', 'enter']:
            events.append('PhaseEntered{name=' + phase + '}')
            if target is None or phase == 'apply':
                continue
            selected = []
            if phase == 'exit':
                selected = [1] if current == 0 else ([4] if current == 1 else [])
            elif phase == 'transition':
                selected = [2] if (current, target) == (0, 1) else ([5] if (current, target) == (1, 2) else [])
            elif phase == 'enter':
                selected = [3] if target == 1 else ([6] if target == 2 else [])
            for ordinal in selected:
                failed = self.invoke(ordinal, phase.capitalize(), target, events)
                if failed:
                    break
            if failed:
                self.target = target
                break
            if phase == 'transition':
                self.current = target
                self.changed = True
                if current != target:
                    self.revision += 1
                self.clock += 1
                self.back.insert(0, (self.clock, f'Transition{{from={current};to={target}}}'))
                fact = 'TransitionFact{key=Mode;from=OpaqueValue;to=OpaqueValue;result=Applied}'
                if selected:
                    events.append('OperationObserved{' + self.identity(selected[-1]) + ';fact=' + fact + '}')
                else:
                    events.append('ExecutionOperationObserved{fact=' + fact + '}')
        status = 'HandlerFailed{phase=' + phase.capitalize() + ';error=' + ERROR + '}' if failed else 'Completed'
        completion = 'EndFailed{error=' + ERROR + '}' if failed else 'EndOk'
        events.append('ScheduleEnded{outcome=' + completion + '}')
        return status, events if self.debug else []

    def perform(self, label):
        status, events = self.run_handlers()
        self.statuses.append(status)
        self.checkpoint(label + ':after-execution')
        batch = 'Ready{events=' + ls(events) + '}' if self.debug else 'Disabled'
        self.output.append('batch=' + batch + '\n')
        self.batches.append((label, self.debug, events))
        self.collector.deliver(events)
        self.checkpoint(label + ':after-delivery')

    def queue(self, label, target):
        self.target = target
        self.queues.append('Success')
        self.checkpoint(label)

    def run(self):
        self.checkpoint('initial')
        self.perform('missing-disabled')
        self.debug = True
        self.checkpoint('enabled')
        self.perform('missing-enabled')
        self.clock += 1
        self.current = 0
        self.changed = True
        self.revision += 1
        self.back.insert(0, (self.clock, 'Initial{0}'))
        self.queue('queued-one', 1)
        self.perform('transition-one')
        self.queue('queued-two', 2)
        self.perform('transition-two-fails')
        self.perform('retry-same-two')
        self.queue('queued-zero', 0)
        self.perform('transition-zero')
        self.debug = False
        self.checkpoint('disabled-again')
        self.queue('queued-one-disabled', 1)
        self.perform('transition-one-disabled')
        self.returned.append(self.collector)
        self.collector = Collector(300, 400)
        self.checkpoint('reset')
        self.debug = True
        self.checkpoint('re-enabled')
        self.perform('idle-enabled')
        self.output.append('terminalApp=' + self.app() + ';terminalStatuses=' + nested(self.statuses)
                           + ';terminalQueues=' + nested(self.queues) + '\n')
        self.output.append('unsubscribedOwners=' + nested([x.show() for x in self.returned + [self.collector]]) + '\n')
        return ''.join(self.output)


def render(schema):
    if schema not in ('Workshop', 'Garden'):
        raise ValueError(schema)
    # Each frozen entry creates one actual World in its own fresh IO process.
    return (schema + '\n' + State(1).run() + '\n').encode()


def self_test():
    state = State(1)
    state.run()
    s = state.checkpoints
    assert len(s) == 25 and len(state.batches) == 8
    assert s['initial'][0:2] == (0, True)
    assert s['missing-disabled:after-delivery'][0:10] == s['initial'][0:10]
    assert s['missing-enabled:after-delivery'][0:10] == s['initial'][0:10]
    assert s['queued-one'][0:2] == (1, True)
    one = s['transition-one:after-execution']
    assert one[0:8] == (3, False, [16, 3], 1, None, 0, True, 2)
    assert one[9] == [2, 2, 3, 0, 0, 0]
    failed, retry = s['transition-two-fails:after-execution'], s['retry-same-two:after-execution']
    assert failed[0:8] == (3, False, [20, 4], 1, 2, 1, False, 2)
    assert retry[0:8] == (3, False, [24, 4], 1, 2, 1, False, 2)
    assert failed[9] == retry[9] == [2, 2, 3, 3, 0, 0]
    assert failed[8] == retry[8] == one[8]
    zero = s['transition-zero:after-execution']
    assert zero[0:8] == (4, False, [28, 4], 0, None, 1, True, 3)
    disabled = s['transition-one-disabled:after-execution']
    assert disabled[0:8] == (5, False, [34, 3], 1, None, 0, True, 4)
    assert disabled[9] == [4, 4, 5, 3, 0, 0]
    assert s['transition-one-disabled:after-delivery'][10].events == disabled[10].events
    assert state.counter == [34, 3] and state.clock == 5 and state.revision == 4
    assert state.cursors == [4, 4, 5, 3, 0, 0]
    assert not state.changed and state.target is None and state.previous == 0
    assert len(state.back) == 4 and [t for t, _ in state.back] == [5, 4, 3, 1]
    assert state.collector.first == 307 and len(state.collector.events) == 7
    assert state.returned[0].first == 153 and len(state.returned[0].events) == 53
    assert [len(events) for _, _, events in state.batches] == [0, 1, 17, 12, 12, 11, 0, 7]
    assert len(state.statuses) == 8 and len(state.queues) == 4
    assert state.statuses[3:5] == ['HandlerFailed{phase=Transition;error=' + ERROR + '}'] * 2
    failed_events = state.batches[3][2]
    assert sum('result=RolledBack' in e for e in failed_events) == 2
    assert 'name=enter}' not in ''.join(failed_events)
    assert any('OperationObserved{identity{namespace=1;id=2;' in e and 'TransitionFact' in e
               for e in state.batches[2][2])
    assert any(e.startswith('ExecutionOperationObserved{fact=TransitionFact')
               for e in state.batches[5][2])
    for _, enabled, events in state.batches:
        assert enabled or events == []
    assert render('Workshop')[len(b'Workshop\n'):] == render('Garden')[len(b'Garden\n'):]
    assert render('Garden').endswith(b'\n\n') and not render('Garden').endswith(b'\n\n\n')


if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('--schema', choices=['Workshop', 'Garden'])
    parser.add_argument('--self-test', action='store_true')
    parser.add_argument('--render-stdout', action='store_true')
    options = parser.parse_args()
    if options.self_test:
        self_test()
        print('complete independent selector-handler model: PASS', file=sys.stderr)
    if options.render_stdout:
        if options.schema is None:
            parser.error('--render-stdout requires --schema')
        sys.stdout.buffer.write(render(options.schema))
