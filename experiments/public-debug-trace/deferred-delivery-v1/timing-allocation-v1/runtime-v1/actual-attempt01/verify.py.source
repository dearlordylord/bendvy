 for mode,raw in fullExpected.items():
  info=measurementPlan['expected'][mode];assert len(raw)==info['bytes'] and sha(raw)==info['sha256'] and fnv(raw)==info['fnv1a32']
 measurementJoins=0
 for path,h in measurementReceipt['guards'].items():
  assert sha(data[path])==h;g=json.loads(data[path]);assert g['unchanged']
  assert g['actualPins']=={m['measurementPlan']:sha(data[m['measurementPlan']]),**measurementPlan['pins'],**measurementPlan['resourceRoots']}
  for p,h in g['actualPins'].items():
   if isinstance(h,dict):
    for entry,digest in h.items():assert sha(data[str(Path(p)/entry)])==digest;measurementJoins+=1
   else:assert sha(data[p])==h;measurementJoins+=1
  for p,h in g['artifacts'].items():assert sha(data[p])==h;measurementJoins+=1
  for p,h in g['rawLogs'].items():assert sha(data[str(measurement/p)])==h;measurementJoins+=1
 assert len(measurementReceipt['guards'])==197 and len(measurementReceipt['rawLogs'])==196
 observations=[];profileCount=0;artifactCount=0
 for command,actual in zip(measurementPlan['commands'],measurementReceipt['commands']):
  assert all(actual[k]==v for k,v in command.items());assert actual['exit']==0 and actual['failure'] is None and actual['status']=='COMPLETE_FULL_OUTPUT_VALIDATED'
  label=command['label'];stdout=data[str(measurement/(label+'.stdout'))];stderr=data[str(measurement/(label+'.stderr'))]
  assert sha(stdout)==measurementReceipt['rawLogs'][label+'.stdout'] and sha(stderr)==measurementReceipt['rawLogs'][label+'.stderr']
  before=json.loads(data[str(measurement/(label+'-pre.guard.json'))]);after=json.loads(data[str(measurement/(label+'-post.guard.json'))])
  if command['kind']=='artifact':
   artifactCount+=1;assert not stdout and not stderr;assert command['artifact'] not in before['artifacts'];assert after['artifacts'][command['artifact']]==sha(data[command['artifact']])
   if command['label'].endswith('-build'):assert str(measurement/(command['label'].split('-')[0]+'.c')) in before['artifacts']
  else:
   assert stdout==fullExpected[command['mode']]
   if command['kind']=='timing':
    t=timing_protocol(stderr,measurementPlan['expected'][command['mode']]);observations.append(dict(label=label,mode=command['mode'],backend=command['backend'],warmup=command['warmup'],pair=command.get('pair'),**t))
    artifact=str(measurement/(command['mode']+('.js' if command['backend']=='js' else '.native')));assert before['artifacts'][artifact]==sha(data[artifact])
   else:
    assert not stderr;profile_protocol(data[command['profile']],command['profileKind']);profileCount+=1;assert after['artifacts'][command['profile']]==sha(data[command['profile']])
 assert observations==measurementReceipt['observations'] and len(observations)==88 and profileCount==4 and artifactCount==6
 import statistics
 summary=[]
 for backend in ['js','native']:
  for mode in ['enabled','disabled']:
   values=[int(v['elapsedNs']) for v in observations if v['backend']==backend and v['mode']==mode and not v['warmup']];assert len(values)==20
   summary.append(dict(backend=backend,mode=mode,count=20,medianNs=statistics.median(values),minimumNs=min(values),maximumNs=max(values)))
 assert summary==measurementReceipt['summary']
 for mode in ['enabled','disabled']:
  artifact=str(measurement/(mode+'.native'));assert artifact in data and artifact not in external
