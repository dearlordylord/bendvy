 oldBinding='git:dea69eb62:experiments/public-debug-trace/deferred-delivery-v1/timing-allocation-v1/measurement-v1/binding.py';assert sha(data[oldBinding])==next(h for p,h in oldPlan['pins'].items() if p.endswith('/measurement-v1/binding.py'))
 # Concrete selected binding risks: protocol digest, full-byte count and missing CPU/heap payloads.
 info=measurementPlan['expected']['enabled'];valid={'elapsedNs':'1','bytes':info['bytes'],'digest':info['fnv1a32']};negativeControls=0
 for change in [{'bytes':info['bytes']+1},{'digest':info['fnv1a32']^1}]:
