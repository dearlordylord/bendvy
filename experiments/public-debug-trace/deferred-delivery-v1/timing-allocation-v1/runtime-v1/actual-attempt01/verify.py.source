   output=next(c['stdout']['path'] for c in receipt['commands'] if c['label']=='consumer');assert data[output]!=gzip.decompress(data[plan['normalOracle']]);counterRejected.append(role['role'])
 measurementPlan=json.loads(data[m['measurementPlan']]);measurementReceipt=json.loads(data[m['measurementReceipt']]);measurement=Path(m['measurementPlan']).parent
 assert measurementReceipt['planSHA256']==sha(data[m['measurementPlan']]);assert measurementReceipt['status']=='COMPLETE_FINITE_TIMING_AND_SAMPLED_PROFILES_NO_PERFORMANCE_VERDICT'
 assert len(measurementPlan['commands'])==len(measurementReceipt['commands'])==98
 def fnv(raw):
  value=2166136261
  for byte in raw:value=((value^byte)*16777619)&0xffffffff
  return value
 def timing_protocol(stderr,info):
  t=json.loads(stderr)
  assert list(t)==['elapsedNs','bytes','digest'] and stderr==(json.dumps(t,separators=(',',':'))+'\n').encode()
  assert isinstance(t['elapsedNs'],str) and t['elapsedNs'].isascii() and t['elapsedNs'].isdecimal()
  assert type(t['bytes']) is int and type(t['digest']) is int and t['bytes']==info['bytes'] and t['digest']==info['fnv1a32']
  return t
 def profile_protocol(raw,kind):
  p=json.loads(raw);assert p['mode']==kind and p['zeroExits']==1
  if kind=='cpu':assert p['profile'].get('nodes')
  else:assert p['profile'].get('head') and p['profile'].get('samples')
  return p
