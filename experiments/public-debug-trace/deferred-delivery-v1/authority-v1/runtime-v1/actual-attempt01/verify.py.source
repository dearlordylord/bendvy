from pathlib import Path
import json,gzip,hashlib,tempfile,shutil,subprocess,re
sha=lambda b:hashlib.sha256(b).hexdigest()
OUT=Path('/tmp/bendvy57-integrated-query-evidence/experiments/public-debug-trace/deferred-delivery-v1/authority-v1/runtime-v1/actual-attempt01')
m=json.loads((OUT/'manifest.json').read_text());rows=m['members'];roles=m['roles'];external={r['path'] for r in rows if 'object' not in r};histories=[Path(p).parent for p in m['historyReceipts']];base=Path('/tmp/bendvy-restore59-oracle/experiments/public-debug-trace/deferred-delivery-oracle-v1')
with tempfile.TemporaryDirectory() as tmp:
 q=Path(tmp)/'packet';shutil.copytree(OUT,q);data={}
 for row in rows:
  p=row['path']
