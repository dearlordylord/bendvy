  "sourceRules": {
    "main.bend/world-io.bend/world-namespace.{bend,c,js}": "Receiver then sender created through WorldIO. In fresh JS realm/Native process the sequential namespace results are 1 then 2. Foreign handle is the actual sender spawn result, retained with its complete sender World.",
    "entity-key.bend/entity-allocator.bend": "Full (index,generation) equality. Physical power-of-two Slot tree includes index0 and unused Consumed slots. Released slots increment generation modulo U32, enter LIFO free list, leave creation order. Reservation pops free first; fresh reservation grows once, advances next/high. Abandon consumes the pending key and removes order without freeing or restoring the reservation.",
    "world.bend": "World metadata preserves store, resource, events, registrations, nextSystem and clock; command admission accepts live or actual pending; ordinary validity accepts live only. Namespace mismatch is MissingEntity. World.barrier drains reverse storage in FIFO order. Only explicit ordinary clear releases a slot; plain deactivate retains payload and slot.",
    "commands.bend/transaction.bend": "Successful Tx commit queues commands and publishes events; despawn Tx observes world before commit with undo0, commands1 or0, events[]. Batch spawn tracks one clear_pending inverse; failure discards commands, consumes reservation via inverse and keeps all other world fields.",
    "bundle-batch.bend/bundle-delivery.bend": "Batch.spawn retains actual tx_spawn reservation receipt and original affine payload. Success stages activation before population; failure returns original payload and skips delivery. Later commands preserve authored FIFO position.",
    "ordinary-component-binding.bend/ordinary-declaration.bend/component.bend": "payload declaration yields exact typed family lens. C.replace validates full live identity before column access or clock increment; accepted population grows column, swaps actual owner and prepends lifecycle stamp. Stale replace returns incoming900 array; fixture retains it.",
    "column.bend/lifecycle.bend": "Ordinary Column starts leaf:none and doubles balanced values tree by logical index-1. Metadata-neutral raw swaps; accepted component writes prepend/rewrite added/changed stamps. Clear returns payload and removes stamp without shrinking physical tree.",
    "ordinary-component-despawn.bend/fixture.bend": "Schema clear retains actual payload, appends clear trace, emits Removed and Cleared with old handle, then releases slot. populate appends its actual handle trace. Deferred E activation+population precedes its queued cleanup.",
    "observe.bend/owner-observer.bend/scenario.bend": "All19 checkpoint strings include receiver/sender physical states, full returned arrays, logical handles/query order and opaque closure counts. Arrays print leaf/node topology; returned lists use semicolon terminator []; ordinary lists use Base.List.show comma-space syntax. Each logged line ends LF.",
    "Base/effs/print.{js,c}": "Base.List.show renders comma+space between values. IO.print adds one LF after the already LF-terminated scenario log, yielding final blank line.",
    "indexed-lifecycle.bend/owner-handoff.bend/string-equality.bend": "Pinned transitive closure; no indexed/prepared/handoff or registration-equality operation is reached by this plain-column consumer."
  },
  "provenance": {
    "subjectExecuted": false,
    "runtimeOutputConsulted": false,
    "method": "Independent finite Python allocator/world/column/command/transaction state model plus exact source-defined text observer. Handles derive only from model WorldIO creation and reserve returns, following actual consumer call order.",
    "opaqueCallbacks": "Counted in complete world and Tx observations; model represents only the command effect semantics reached by this consumer.",
    "limits": [
      "First finite ordinary consumer only; no full#38migration claim.",
      "No U32generation-wrap boundary is reached by this consumer; model release arithmetic follows source modulo2^32.",
      "No authority matrix, dependent relation/scope/snapshot/decode migration or#28regression qualification.",
      "Fresh process/JSrealm namespace precondition; no arbitrary preexisting namespace registry state.",
      "Only ordinary plain Column is reached; observer supports other forms but consumer does not create them."
    ]
  }
