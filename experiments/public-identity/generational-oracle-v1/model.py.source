"""Independent finite source model for frozen first #38 ordinary consumer.

This file does not import or execute the subject. Balanced physical arrays,
allocator phases, FIFO commands, payload ownership, stamps and exact observers
are modeled from the pinned source closure. Opaque closures are counted only.
"""
import copy
from dataclasses import dataclass, field


U32_MASK = (1 << 32) - 1


def listing(values, show=str):
    return '[' + ', '.join(show(value) for value in values) + ']'


def tree(values, show=str):
    assert values and len(values) & (len(values) - 1) == 0
    if len(values) == 1:
        return 'leaf:' + show(values[0])
    half = len(values) // 2
    return 'node(' + tree(values[:half], show) + ',' + tree(values[half:], show) + ')'


def payload(value):
    return [value, (value + 1) & U32_MASK]


def optional(value):
    return 'none' if value is None else 'some(' + tree(value) + ')'


def arrays(values):
    # observe.arrays uses semicolons and retains the terminal [] marker.
    return ''.join(tree(value) + ';' for value in values) + '[]'


def key_text(key):
    return str(key[0]) + ':' + str(key[1])


def handle_text(handle):
    return str(handle[0]) + '/' + key_text(handle[1:])


@dataclass
class Allocator:
    next: int = 1
    high: int = 0
    slots: list = field(default_factory=lambda: [(0, 'Consumed')])
    free: list = field(default_factory=list)
    order: list = field(default_factory=list)

    def reserve(self):
        if self.free:
            index = self.free.pop(0)
            generation = self.slots[index][0]
        else:
            assert self.next < 131073
            index, generation = self.next, 0
            self.next += 1
            self.high = index
            if index >= len(self.slots):
                self.slots.extend([(0, 'Consumed')] * len(self.slots))
        key = (index, generation)
        self.slots[index] = (generation, 'Consumed')
        self.order.append(key)
        return key

    def valid(self, key, mode):
        index, generation = key
        if not (0 < index < self.next and index < len(self.slots)):
            return False
        stored_generation, phase = self.slots[index]
        return generation == stored_generation and (
            phase != 'Free' if mode == 'metadata' else phase == mode)

    def phase(self, key, phase):
        assert self.valid(key, 'metadata')
        self.slots[key[0]] = (key[1], phase)

    def release(self, key):
        assert self.valid(key, 'metadata')
        index, generation = key
        self.slots[index] = ((generation + 1) & U32_MASK, 'Free')
        self.free.insert(0, index)
        self.order = [entry for entry in self.order if entry != key]

    def abandon(self, key):
        assert self.valid(key, 'Pending')
        self.phase(key, 'Consumed')
        self.order = [entry for entry in self.order if entry != key]

    def visible(self):
        return [key for key in self.order if self.valid(key, 'Live')]

    def text(self):
        return ('next=' + str(self.next) + ';high=' + str(self.high) +
                ';capacity=' + str(len(self.slots)) + ';depth=' + str(len(self.slots).bit_length() - 1) +
                ';slots=' + tree(self.slots, lambda slot: str(slot[0]) + ':' + slot[1]) +
                ';free=' + listing(self.free) + ';order=' + listing(self.order, key_text))


@dataclass
class World:
    namespace: int
    resource: list
    allocator: Allocator = field(default_factory=Allocator)
    values: list = field(default_factory=lambda: [None])
    stamps: list = field(default_factory=list)
    returned: list = field(default_factory=list)
    trace: list = field(default_factory=list)
    events: list = field(default_factory=list)
    pending: list = field(default_factory=list)
    clock: int = 0

    def valid(self, handle, mode='Live'):
        return handle[0] == self.namespace and self.allocator.valid(handle[1:], mode)

    def spawn(self, value, abort=False):
        key = self.allocator.reserve()
        handle = (self.namespace, *key)
        self.allocator.phase(key, 'Pending')
        owner = payload(value)
        if abort:
            # The reservation is consumed on failure; its original payload is
            # returned by Batch.originals and retained by the scenario.
            self.allocator.abandon(key)
            self.returned.append(owner)
        else:
            # Batch.stage preserves reservation activation before population.
            self.pending.extend([('activate', handle, None), ('populate', handle, owner)])
        return handle

    def replace(self, handle, owner):
        if not self.valid(handle):
            return False, owner
        index = handle[1]
        self.clock += 1
        while index > len(self.values):
            self.values.extend([None] * len(self.values))
        previous = self.values[index - 1]
        stamp = next((stamp for ident, stamp in self.stamps if ident == index), (0, 0))
        self.values[index - 1] = owner
        new_stamp = (stamp[0] if previous is not None else self.clock, self.clock)
        self.stamps = [(index, new_stamp)] + [(ident, value) for ident, value in self.stamps if ident != index]
        return True, previous

    def barrier(self):
        commands, self.pending = self.pending, []
        for operation, handle, owner in commands:
            key = handle[1:]
            if operation == 'activate':
                if self.valid(handle, 'metadata'):
                    self.allocator.phase(key, 'Live')
            elif operation == 'populate':
                if self.valid(handle):
                    accepted, previous = self.replace(handle, owner)
                    assert accepted
                    if previous is not None:
                        self.returned.append(previous)
                    self.trace.append('populate:' + handle_text(handle))
                else:
                    self.returned.append(owner)
                    self.trace.append('delivery-refused')
            elif operation == 'despawn':
                if self.valid(handle):
                    self.allocator.phase(key, 'DeadRetained')
                    index = handle[1]
                    assert index <= len(self.values)
                    previous = self.values[index - 1]
                    self.values[index - 1] = None
                    self.stamps = [(ident, stamp) for ident, stamp in self.stamps if ident != index]
                    if previous is not None:
                        self.returned.append(previous)
                    self.trace.append('clear:' + handle_text(handle))
                    self.events.extend(['Removed(' + handle_text(handle) + ')',
                                        'Cleared(' + handle_text(handle) + ')'])
                    self.allocator.release(key)
            else:
                raise AssertionError(operation)

    def query_order(self):
        return [(self.namespace, *key) for key in self.allocator.visible()]

    def text(self):
        stamps = listing(self.stamps, lambda entry: str(entry[0]) + ':' + key_text(entry[1]))
        store = ('column=Column{values=' + tree(self.values, optional) + ';stamps=' + stamps +
                 '};returned=' + arrays(self.returned) + ';trace=' + listing(self.trace))
        return ('ns=' + str(self.namespace) + ';allocator={' + self.allocator.text() + '};store={' +
                store + '};resource=' + tree(self.resource) + ';events=' + listing(self.events) +
                ';pending=' + str(len(self.pending)) + ';registrations=[];nextSystem=1;clock=' +
                str(self.clock) + ';queryOrder=' + listing(self.query_order(), handle_text))


class Session:
    def __init__(self):
        # main binds receiver creation first, then sender creation. Both pinned
        # host namespace implementations start at 1 in a fresh process/realm.
        self.world = World(1, [61, 62])
        self.foreign = World(2, [71, 72])
        self.foreign_handle = self.foreign.spawn(700)
        self.foreign.barrier()
        self.handles = []
        self.log = []
        self.checkpoints = {}
        self.transactions = []

    def checkpoint(self, label):
        self.checkpoints[label] = copy.deepcopy((self.world, self.foreign, self.handles))
        self.log.append(label + ':{world={' + self.world.text() + '};foreign={' +
                        self.foreign.text() + '};foreignHandle=' + handle_text(self.foreign_handle) +
                        ';handles=' + listing(self.handles, handle_text) + '}')

    def spawn(self, value):
        handle = self.world.spawn(value)
        self.handles.append(handle)
        self.log.append('spawn:' + handle_text(handle))

    def despawn(self, handle):
        accepted = self.world.valid(handle) or self.world.valid(handle, 'Pending')
        status = 'Accepted' if accepted else 'Rejected(MissingEntity)'
        # O.tx observes before Cmd.tx_finish commits the one deferred command.
        text = ('world={' + self.world.text() + '};undo=0;commands=' + str(int(accepted)) + ';events=[]')
        self.transactions.append((copy.deepcopy(self.world), status, int(accepted)))
        self.log.append('despawn:' + status + ';tx={' + text + '}')
        if accepted:
            self.world.pending.append(('despawn', handle, None))

    def run(self):
        self.checkpoint('initial')
        self.spawn(100)
        self.spawn(200)
        self.checkpoint('pending-ab')
        self.world.barrier()
        self.checkpoint('live-ab')
        self.despawn(self.handles[0])
        self.checkpoint('queued-clear-a-before-c')
        self.spawn(300)
        self.checkpoint('pending-c-before-release-a')
        self.world.barrier()
        self.checkpoint('live-bc-a-free')
        self.spawn(400)
        self.checkpoint('pending-d-reuses-a')
        self.world.barrier()
        self.checkpoint('live-bcd')
        assert not self.world.valid(self.handles[0])
        self.log.append('read:MissingEntity')
        self.checkpoint('stale-read')
        accepted, incoming = self.world.replace(self.handles[0], payload(900))
        assert not accepted
        self.log.append('write:MissingEntity;returned=' + optional(incoming))
        self.world.returned.append(incoming)
        self.checkpoint('stale-write-returned')
        self.despawn(self.handles[0])
        self.checkpoint('stale-despawn')
        self.despawn(self.foreign_handle)
        self.checkpoint('foreign-despawn')
        self.spawn(500)
        self.checkpoint('pending-e')
        self.despawn(self.handles[4])
        self.checkpoint('queued-cancel-e')
        self.world.barrier()
        self.checkpoint('cancel-e-fifo')
        handle = self.world.spawn(800, abort=True)
        self.handles.append(handle)
        self.log.append('abort-reservation:' + handle_text(handle))
        self.log.append('abort:Failure;returned=' + arrays([payload(800)]))
        self.checkpoint('aborted-recycled-reservation')
        handle = self.handles[3]
        assert self.world.valid(handle, 'metadata')
        self.world.allocator.phase(handle[1:], 'DeadRetained')
        self.log.append('plain-deactivate:Accepted')
        self.checkpoint('dead-retained-d')
        self.spawn(600)
        self.checkpoint('pending-g-no-consumed-or-retained-reuse')
        self.world.barrier()
        self.checkpoint('final')
        return self


def values():
    return Session().run()


def render():
    # scenario checkpoint lines end in LF; actual IO.print appends another LF.
    return ('\n'.join(values().log) + '\n\n').encode()


def selftest():
    session = values()
    points = session.checkpoints
    assert len(points) == 19
    world, foreign, handles = points['final']
    assert handles == [(1, 1, 0), (1, 2, 0), (1, 3, 0), (1, 1, 1),
                       (1, 4, 0), (1, 4, 1), (1, 5, 0)]
    assert session.foreign_handle == (2, 1, 0)
    assert world.query_order() == [(1, 2, 0), (1, 3, 0), (1, 5, 0)]
    assert world.allocator.order == [(2, 0), (3, 0), (1, 1), (5, 0)]
    assert world.allocator.slots == [(0, 'Consumed'), (1, 'DeadRetained'), (0, 'Live'),
                                     (0, 'Live'), (1, 'Consumed'), (0, 'Live'),
                                     (0, 'Consumed'), (0, 'Consumed')]
    assert (world.allocator.next, world.allocator.high, world.allocator.free) == (6, 5, [])
    assert world.values == [payload(400), payload(200), payload(300), None,
                            payload(600), None, None, None]
    assert world.stamps == [(5, (6, 6)), (1, (4, 4)), (3, (3, 3)), (2, (2, 2))]
    assert world.returned == [payload(100), payload(900), payload(500), payload(800)]
    assert world.clock == 6 and world.resource == [61, 62]
    assert world.events == ['Removed(1/1:0)', 'Cleared(1/1:0)', 'Removed(1/4:0)', 'Cleared(1/4:0)']
    assert world.trace == ['populate:1/1:0', 'populate:1/2:0', 'clear:1/1:0',
                           'populate:1/3:0', 'populate:1/1:1', 'populate:1/4:0',
                           'clear:1/4:0', 'populate:1/5:0']
    assert [len(points[label][0].pending) for label in points] == [
        0, 4, 0, 1, 3, 0, 2, 0, 0, 0, 0, 0, 2, 3, 0, 0, 0, 2, 0]
    assert [row[1:] for row in session.transactions] == [
        ('Accepted', 1), ('Rejected(MissingEntity)', 0),
        ('Rejected(MissingEntity)', 0), ('Accepted', 1)]
    assert points['live-bcd'][0] == points['stale-read'][0]
    assert points['stale-write-returned'][0] == points['stale-despawn'][0]
    assert points['stale-despawn'][0] == points['foreign-despawn'][0]
    before, after = points['pending-e'][0], points['queued-cancel-e'][0]
    assert before.allocator == after.allocator and before.values == after.values
    assert points['cancel-e-fifo'][0].allocator.free == [4]
    assert points['aborted-recycled-reservation'][0].allocator.free == []
    assert points['aborted-recycled-reservation'][0].values == points['cancel-e-fifo'][0].values
    assert foreign.clock == 1 and foreign.resource == [71, 72]
    assert foreign.values == [payload(700)] and foreign.stamps == [(1, (1, 1))]
    assert foreign.returned == foreign.pending == foreign.events == []
    assert all(point[1] == foreign for point in points.values())
    assert tree([0, 1, 2, 3]) == 'node(node(leaf:0,leaf:1),node(leaf:2,leaf:3))'
    assert arrays([payload(1), payload(3)]) == 'node(leaf:1,leaf:2);node(leaf:3,leaf:4);[]'
    assert render().endswith(b'\n\n')


if __name__ == '__main__':
    import sys
    selftest()
    if '--self-test' not in sys.argv and '--selftest' not in sys.argv:
        sys.stdout.buffer.write(render())
