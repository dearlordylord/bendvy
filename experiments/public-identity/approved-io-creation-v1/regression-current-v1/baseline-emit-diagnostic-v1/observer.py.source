"""Read-only actual emitter observations; no child launch, attach or signals."""
import pathlib,json,hashlib,os,time,datetime,sys
plan_path=pathlib.Path(sys.argv[1]);expected=sys.argv[2];output=pathlib.Path(sys.argv[3])
raw=plan_path.read_bytes()
if hashlib.sha256(raw).hexdigest()!=expected:raise ValueError('plan drift')
if hashlib.sha256(pathlib.Path(__file__).read_bytes()).hexdigest()!=sys.argv[4]:raise ValueError('observer source drift')
p=json.loads(raw);argv=p['commands'][0]['argv'][3:];binary=pathlib.Path(argv[0]).resolve(strict=True)
hz=os.sysconf('SC_CLK_TCK');boot=lambda:time.clock_gettime(time.CLOCK_BOOTTIME)
def state(pid):
 d=pathlib.Path('/proc')/str(pid);s=(d/'stat').read_text();fields=s[s.rfind(')')+2:].split()
 return {'pid':pid,'startTicks':int(fields[19]),'userTicks':int(fields[11]),'systemTicks':int(fields[12]),'state':fields[0]}
def match(pid):
 d=pathlib.Path('/proc')/str(pid)
 return (d/'exe').resolve(strict=True)==binary and (d/'cmdline').read_bytes().split(b'\0')[:-1]==[v.encode()for v in argv]
with output.open('x') as f:
 def write(row):
  row.update(utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),monotonicSeconds=time.monotonic(),bootSeconds=boot(),clockTicksPerSecond=hz)
  f.write(json.dumps(row)+'\n');f.flush()
 write({'kind':'recipe','planSHA256':expected,'exactArgv':argv,'binary':str(binary),'observerSourceSHA256':hashlib.sha256(pathlib.Path(__file__).read_bytes()).hexdigest(),'observerAffinity':sorted(os.sched_getaffinity(0))})
 end=time.monotonic()+40;selected=None
 while time.monotonic()<end:
  found=[]
  for d in pathlib.Path('/proc').iterdir():
   if not d.name.isdigit():continue
   try:
    if match(int(d.name)):found.append(state(int(d.name)))
   except (OSError,ValueError,IndexError):pass
  if len(found)>1:write({'kind':'ambiguous','matches':found});break
  if found:selected=found[0];write({'kind':'bound',**selected});break
  if (plan_path.parent/'receipt.json').exists():write({'kind':'terminal-before-discovery'});break
  time.sleep(.2)
 if selected is None:write({'kind':'no-bound-process','scope':'Missing observation is inconclusive, never idle CPU evidence.'})
 else:
  for target in [5,15,25]:
   while boot()-selected['startTicks']/hz<target:time.sleep(.05)
   try:
    current=state(selected['pid'])
    if current['startTicks']!=selected['startTicks'] or not match(selected['pid']):
     write({'kind':'identity-changed','targetElapsedSeconds':target,'expected':selected,'actual':current});break
    elapsed=boot()-current['startTicks']/hz
    write({'kind':'sample','targetElapsedSeconds':target,'elapsedSeconds':elapsed,'userSeconds':current['userTicks']/hz,'systemSeconds':current['systemTicks']/hz,'cpuSeconds':(current['userTicks']+current['systemTicks'])/hz,**current})
   except (OSError,ValueError,IndexError) as e:
    write({'kind':'missing','targetElapsedSeconds':target,'expectedPID':selected['pid'],'expectedStartTicks':selected['startTicks'],'reason':type(e).__name__});break
