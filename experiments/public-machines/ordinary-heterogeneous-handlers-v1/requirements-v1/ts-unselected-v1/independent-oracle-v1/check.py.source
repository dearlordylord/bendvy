from pathlib import Path
import json,hashlib,gzip,runpy
here=Path(__file__).resolve().parent
basis=json.loads((here/'SOURCE-BASIS.json').read_text())
for group in ('sourcePins','inputs'):
 for path,digest in basis[group].items():assert hashlib.sha256(Path(path).read_bytes()).hexdigest()==digest,path
m=runpy.run_path(str(here/'model.py.source'));value=m['expected_value']();raw=m['expected']();v=json.loads((here/'ORACLES.json').read_text())['ts']
assert raw==gzip.decompress(Path(v['stdout']).read_bytes())
assert len(raw)==v['bytes'] and hashlib.sha256(raw).hexdigest()==v['sha256']
a,b=value['records'][1:]
for key in ('world','streams','callbacks','seedReads','traces'):assert a[key]==b[key],key
assert b['result']['error']['requirements']==[{'kind':'stateMachine','name':'Second'}]
