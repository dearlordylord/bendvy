"""Source-only finite regeneration; metadata hashes follow final basis writes."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent
ROOT=Path('/workspace/formal-proofs/bendvy')
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
model=runpy.run_path(str(HERE/'model.py.source'))
cat={}
for phase in ('exit','enter'):
    p=HERE.parent/phase
    pins=json.loads((p/'source01/SOURCE.json').read_text())['pins']
    for name,digest in pins.items(): assert sha(name)==digest,name
    for name in ('types','lenses','application','observe','main'):
        assert (p/(name+'.bend')).read_bytes()==(HERE.parent.parent/(name+'.bend')).read_bytes(),name
    before=(HERE.parent.parent/'systems.bend').read_text()
    after=(p/'systems.bend').read_text()
    assert after==before.replace('case H.Transition{} True{}:Tx.Failure{"transition-first-attempt"}',f'case H.{phase.title()}{{}} True{{}}:Tx.Failure{{"{phase}-first-attempt"}}')
    for extra in (Path('/home/node/.bend/bend2/base.bend'),ROOT/'.references/sources.json',Path('/workspace/formal-proofs/bendvy-worktrees/native54-matching-tree-v1/experiments/public-inspect/ordinary-declaration-v1/native54-matching-tree-v1/native-blocker-source-research-v1/ownership-preseed-v1/compiler/installed-cli-unmodified.mjs')):pins[str(extra)]=sha(extra)
    assert 'def main() -> List<&2,String>' in (p/'main.bend').read_text()
    assert 'List.show(&2,String,x=>x' in (p/'observe.bend').read_text()
    phasecore=(ROOT/'src/ecs/machine-handler-phases.bend').read_text()
    assert 'Sys.Failed{requeued(' in phasecore
    assert 'case H.Failed{enter,world,error}:(Owners{H.Owners{exit,transition,enter},intent},Sys.Failed{world,error})' in phasecore
    assert 'Returned{rollback(~W, undo, world), Failure{error}}' in (ROOT/'src/ecs/transaction.bend').read_text()
    raw=model['expected'](phase)
    (HERE/(phase+'.stdout')).write_bytes(raw)
    (HERE/(phase+'.stdout.gz')).write_bytes(gzip.compress(raw,mtime=0))
    basis={'producerCommit':'482c6631d','case':phase,'sourcePins':pins,'modelPins':{str(HERE/'model.py.source'):sha(HERE/'model.py.source')},'entry':str(p/'main.bend'),'sourceCapture':str(p/'source01/SOURCE.json'),'derivation':'Same explicit String serializer; only source phase selector and diagnostic differ. Complete state evolves under actual successful-prefix Tx commit, failed callback inverse, Local outside Tx, existing handler phase requeue/commit and explicit marker order. No runtime output inputs.','limits':'Finite present-state callbacks only; no initialization/expiry/new policy or universal/full49 claim.'}
    b=HERE/(phase+'-SOURCE-BASIS.json');b.write_text(json.dumps(basis,indent=2)+'\n')
    cat[phase]={'stdout':str(HERE/(phase+'.stdout.gz')),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
(HERE/'ORACLES.json').write_text(json.dumps(cat,indent=2)+'\n')
print(json.dumps({'cases':cat,'observationsPerCase':11,'sourcePinsPerCase':35},indent=2))
