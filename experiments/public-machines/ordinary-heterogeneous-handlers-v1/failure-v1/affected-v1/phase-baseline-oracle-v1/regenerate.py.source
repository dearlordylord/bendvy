"""Bind the independent whole failure oracle to exact identity-rewind source."""
import gzip,hashlib,json,runpy
from pathlib import Path
HERE=Path(__file__).resolve().parent
P=HERE.parent/'phase-baseline'; ORIGINAL=HERE.parent.parent
ROOT=Path('/workspace/formal-proofs/bendvy/src/ecs')
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
pins=json.loads((P/'source01/SOURCE.json').read_text())['pins']
for path,digest in pins.items():assert sha(path)==digest,path
joins=[]
for target,source in [('phase.bend','machine-handler-phases.bend'),('operation.bend','ordinary-machine-handler-bundle.bend')]:
    text=(P/target).read_text()
    inverse=text.replace(',~rewind:W.World<S,C,R,E> -> W.World<S,C,R,E>','').replace(',~rewind','').replace('take(rewind(world))','take(world)')
    for file in ROOT.glob('*.bend'):inverse=inverse.replace('import '+str(file)+' as','import ./'+file.name+' as')
    inverse=inverse.replace('import phase.bend as Phase','import ./machine-handler-phases.bend as Phase')
    assert inverse==(ROOT/source).read_text(),target
    pins[str(ROOT/source)]=sha(ROOT/source)
    joins.append({'private':str(P/target),'public':str(ROOT/source),'literalInverse':True,'rewindCalls':text.count('rewind(world)')})
for name in ('main','types','lenses','systems','observe'):
    assert (P/(name+'.bend')).read_bytes()==(ORIGINAL/(name+'.bend')).read_bytes(),name
assert 'def rewind(~S:Data,world:W.World<S,T.Store<S>,T.Resources<S>,T.Pulse>) -> W.World<S,T.Store<S>,T.Resources<S>,T.Pulse>:world' in (P/'application.bend').read_text()
app=(P/'application.bend').read_text().replace('import operation.bend as Operation','import /workspace/formal-proofs/bendvy/src/ecs/ordinary-machine-handler-bundle.bend as Operation')
app='\n'.join(line for line in app.split('\n') if not line.startswith('def rewind(')).replace(',~rewind(~S)','')
assert app==(ORIGINAL/'application.bend').read_text()
for extra in (Path('/home/node/.bend/bend2/base.bend'),Path('/workspace/formal-proofs/bendvy/.references/sources.json'),Path('/workspace/formal-proofs/bendvy-worktrees/native54-matching-tree-v1/experiments/public-inspect/ordinary-declaration-v1/native54-matching-tree-v1/native-blocker-source-research-v1/ownership-preseed-v1/compiler/installed-cli-unmodified.mjs')):pins[str(extra)]=sha(extra)
model=runpy.run_path(str(HERE/'model.py.source'));raw=model['expected']()
assert len(raw)==23694 and hashlib.sha256(raw).hexdigest()=='3659487db2e5f8345dea4be2a73cdeec4970e81a3fde41ff28358bdca664e07c'
(HERE/'expected.stdout').write_bytes(raw);(HERE/'expected.stdout.gz').write_bytes(gzip.compress(raw,mtime=0))
basis={'producerCommit':'e9e95cc53','sourcePins':pins,'modelPins':{str(HERE/'model.py.source'):sha(HERE/'model.py.source')},'entry':str(P/'main.bend'),'joins':joins,'applicability':'Only two precommit catches call identity rewind(world); exact parameter/import inverse yields current public bodies. Five other fixture bodies exact, application inverse exact. Same complete String grammar and whole source-derived failure model, no runtime inputs.','limits':'Private test seam; not production API adoption, new rollback contract, initialization or universal proof.'}
b=HERE/'SOURCE-BASIS.json';b.write_text(json.dumps(basis,indent=2)+'\n')
entry={'stdout':str(HERE/'expected.stdout.gz'),'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'sourceBasisPath':str(b),'sourceBasisSHA256':sha(b)}
(HERE/'ORACLES.json').write_text(json.dumps({'normal':entry},indent=2)+'\n')
print(json.dumps({'pins':len(pins),'observations':11,**entry},indent=2))
