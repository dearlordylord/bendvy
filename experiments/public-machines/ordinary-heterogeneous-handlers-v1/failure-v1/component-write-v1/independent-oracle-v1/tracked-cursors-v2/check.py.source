from pathlib import Path
import json,hashlib,gzip,runpy,re
here=Path(__file__).resolve().parent;b=json.loads((here/'SOURCE-BASIS.json').read_text())
for group in ('sourcePins','inputs'):
 for path,h in b[group].items():assert hashlib.sha256(Path(path).read_bytes()).hexdigest()==h,path
m=runpy.run_path(str(here/'model.py.source'));raw=m['expected']();v=json.loads((here/'ORACLES.json').read_text())['normal']
assert raw==gzip.decompress(Path(v['stdout']).read_bytes()) and len(raw)==v['bytes']
assert hashlib.sha256(raw).hexdigest()==v['sha256']
expected=json.loads((here/'CHECKS.json').read_text())['cursorStates']
for row,cursors in zip(m['observations']()[:-1],expected):
 observed=[int(x) for x in re.findall(r':cursor=(\d+)',row)]
 assert observed==cursors,(observed,cursors)
assert 'positions=[1:2:1]' in m['observations']()[6]
print('PASS:all tracked Registry cursors/sourcepins/fullbytes; Stream.Reader sequence unchanged')
