"""Finite source-derived execution/serializer; no Bend runtime output input."""
import json

def ls(xs): return '[' + ', '.join(map(str,xs)) + ']'
def arr(a,b): return f'node(leaf:{a},leaf:{b})'
def slot(current,pending='None',previous='None',changed=False):
    return f'{current}:pending={pending}:previous={previous}:changed={str(changed)}'
class Model:
    def __init__(self):
        self.owned=11; self.locals=[0]*6; self.pending=1; self.applied=0
        self.first=slot('Cold'); self.second=slot('Idle')
        self.ticks=[0,0]; self.batches=[[],[]]; self.positions=[[],[]]
        self.delivered=[[],[]]; self.trace=[]; self.statuses=[]; self.cells=31; self.clock=0; self.cursors=[0]*8; self.commands=[0]
    def barrier(self):
        for value in self.commands: self.cells=value; self.clock+=1; self.applied+=1
        self.commands=[]; self.pending=0
    def callback(self,machine,code):
        self.owned+=machine*10+code; self.locals[(machine-1)*3+code-1]+=1
        self.trace.append(f'{machine}:{code}'); self.commands.append(machine*10+code); self.pending+=1; self.cursors[(machine-1)*3+code-1]=self.clock
    def marker(self,machine,first=False):
        self.barrier(); i=machine-1; self.ticks[i]+=1
        if first:
            for code in (1,2,3): self.callback(machine,code)
            if machine==1:
                self.first=slot('Warm','Settled:False','Cold',True); change='Cold>Warm'
            else:
                self.second=slot('Active:7','None','Idle',True); change='Idle>Active:7'
            self.batches[i].append(f'{self.ticks[i]}:'+ls([change]))
        elif machine==1:
            self.first=slot('Settled','None','Warm',True)
            self.batches[0].append(str(self.ticks[0])+':'+ls(['Warm>Settled']))
        else: self.second=slot('Active:7','None','Idle',False)
        self.statuses.append(('first' if machine==1 else 'second')+':Completed')
    def read(self,machine):
        i=machine-1; self.positions[i]=[f'1:{self.ticks[i]}:{self.ticks[i]}']
        self.delivered[i]=['Cold>Warm' if machine==1 else 'Idle>Active:7']
        self.statuses.append(('first' if machine==1 else 'second')+'-reader:Completed')
    def stream(self,i):
        return 'batches='+ls(self.batches[i])+':positions='+ls(self.positions[i])+':dropped=0:frameStart=0'
    def bundle(self,m):
        kinds=['exit:Cold','transition:Cold>Warm','enter:Warm'] if m==1 else ['exit:Idle','transition:Idle>Active:7','enter:Active:7']
        prefix='first' if m==1 else 'second'; entries=[]
        for code,kind in enumerate(kinds,1):
            ordinal=(m-1)*3+code; name=prefix+'-'+['exit','transition','enter'][code-1]
            entries.append(f'{kind}:needs=[1, 2, 1]:entry={ordinal}:registry=1:{ordinal}:{name}:[owned:write, Local:write, deferred:write]:cursor={self.cursors[ordinal-1]}')
        return '1:'+ls(entries)
    def snapshot(self,label):
        resources='owned='+arr(self.owned,12)+'|sibling='+arr(21,22)+'|first={'+self.first+'}|second={'+self.second+'}|firstStream={'+self.stream(0)+'}|secondStream={'+self.stream(1)+'}|firstReader=1:1|secondReader=1:1|locals='+ls([f'1:{i+1}:'+arr(n,i+1) for i,n in enumerate(self.locals)])+'|firstTick='+str(self.ticks[0])+'|secondTick='+str(self.ticks[1])+'|trace='+ls(self.trace)+'|firstDelivered='+ls(self.delivered[0])+'|secondDelivered='+ls(self.delivered[1])+'|applied='+str(self.applied)
        names=['first-exit','first-transition','first-enter','second-exit','second-transition','second-enter','first-reader','second-reader']
        registrations=ls([f'{i}:{names[i-1]}:'+('[owned:write, Local:write, deferred:write]' if i<7 else ('[first-stream:read]' if i==7 else '[second-stream:read]')) for i in range(8,0,-1)])
        store='first=Column{values=leaf:some('+arr(self.cells,32)+');stamps='+ls([f'1:0:{self.clock}'] if self.clock else [])+'}|sibling=Column{values=leaf:some('+arr(41,42)+');stamps=[]}'
        world='ns=1|next=2|high=1|live=node(leaf:False,leaf:True)|capacity=2|depth=1|store={'+store+'}|resources={'+resources+'}|events='+ls(self.trace)+'|pending='+str(self.pending)+'|registrations='+registrations+'|nextSystem=9|clock='+str(self.clock)
        return label+':world={'+world+'}|firstBundle='+self.bundle(1)+'|secondBundle='+self.bundle(2)+'|firstReaderRegistry=1:7:first-reader:[first-stream:read]:cursor='+str(self.cursors[6])+'|secondReaderRegistry=1:8:second-reader:[second-stream:read]:cursor='+str(self.cursors[7])+'|statuses='+ls(self.statuses)
class FailureModel(Model):
    def __init__(self):
        super().__init__(); self.registered=[None,None]
    def failed_marker(self):
        self.barrier(); self.ticks[0]+=1
        self.callback(1,1)
        # Local touch occurs before Tx.begin; failed Tx undo owns only head/trace.
        self.locals[1]+=1
        old_head,old_trace=self.owned,self.trace[:]
        self.owned+=12; self.trace.append('1:2')
        self.owned,self.trace=old_head,old_trace
        self.first=slot('Cold','Warm:False','Cold',False)
        self.statuses.append('first:Failed:transition:transition-first-attempt')
    def read(self,machine):
        i=machine-1
        if self.registered[i] is None: self.registered[i]=self.ticks[i]
        prior=int(self.positions[i][0].split(':')[1]) if self.positions[i] else 0
        for batch in self.batches[i]:
            tick,text=batch.split(':',1)
            if int(tick)>prior: self.delivered[i].extend(text[1:-1].split(', ') if text!='[]' else [])
        self.positions[i]=[f'1:{self.ticks[i]}:{self.registered[i]}']
        self.cursors[6+i]=self.clock
        self.statuses.append(('first' if machine==1 else 'second')+'-reader:Completed')
    def round(self,fail=False,initial=False):
        if fail: self.failed_marker(); return
        self.marker(1,initial); self.marker(2,initial)
    def ledger(self):
        return {'component':[self.cells,32],'siblingComponent':[41,42],'owned':[self.owned,12],'siblingOwner':[21,22],'locals':self.locals[:],'committedCallbacks':self.trace[:],'appliedReplacements':self.applied,'firstDelivered':self.delivered[0][:],'secondDelivered':self.delivered[1][:],'pulse':[dict(machine=int(v[0]),phase=int(v[2])) for v in self.trace],'pendingCommands':self.pending}
    def ledger_text(self):
        return 'ledger:component={first=Column{values=leaf:some('+arr(self.cells,32)+');stamps='+ls([f'1:0:{self.clock}'])+'}|sibling=Column{values=leaf:some('+arr(41,42)+');stamps=[]}}|owned='+arr(self.owned,12)+'|siblingOwner='+arr(21,22)+'|locals='+ls(self.locals)+'|committedCallbacks='+ls(self.trace)+'|appliedReplacements='+str(self.applied)+'|firstDelivered='+ls(self.delivered[0])+'|secondDelivered='+ls(self.delivered[1])+'|pulse='+ls(self.trace)+'|pendingCommands='+str(self.pending)
def observations():
    m=FailureModel();out=[m.snapshot('before')]
    m.first=slot('Cold','Warm:False');m.second=slot('Idle','Active:7:False');out.append(m.snapshot('queued'))
    m.round(fail=True);out.append(m.snapshot('round-failure'))
    m.read(1);out.append(m.snapshot('first-reader-before-retry'))
    m.round(initial=True);out.append(m.snapshot('round-retry'))
    m.read(2);out.append(m.snapshot('second-reader'))
    m.read(1);out.append(m.snapshot('first-reader'))
    m.round();out.append(m.snapshot('later-round'))
    m.read(1);out.append(m.snapshot('final-first-reader'))
    m.read(2);out.append(m.snapshot('final-second-reader'))
    m.barrier();out.append(m.snapshot('final-barrier'))
    out.extend([m.ledger_text(),'Factory:2']);return out,m.ledger()
def expected(): return (json.dumps(observations()[0],ensure_ascii=False)+'\n').encode()
