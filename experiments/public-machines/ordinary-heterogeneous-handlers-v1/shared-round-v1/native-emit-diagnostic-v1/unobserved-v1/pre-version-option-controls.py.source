import ast,json,hashlib,os,subprocess
from pathlib import Path
HERE=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
p=json.loads((HERE/"plan.json").read_text());parent=HERE.parent
assert all(sha(k)==v for k,v in p["pins"].items())
assert not Path(p["stage"]).exists()
s=(parent/"compiler/observed-cli.mjs").read_text()
for r in reversed(json.loads((parent/"PATCHES.json").read_text())["patches"]):
 assert s.count(r["replacement"])==1;s=s.replace(r["replacement"],r["original"])
source=(HERE/"compiler/installed-cli-unmodified.mjs").read_bytes()
assert s.encode()==source==(parent/"compiler/installed-cli-unmodified.mjs").read_bytes()
assert b"BVY_EMIT_MARK" not in source and b"boundary-helper" not in source
assert Path(p["argv"][3]).read_bytes().find(source)==82378778
stock=json.loads((HERE.parent.parent/"runtime01/native/plan.json").read_text())
assert p["cwd"]==stock["cwd"] and Path(p["cwd"]).is_dir()
assert p["environment"]==stock["environment"]|{"BUN_BE_BUN":"1"}
assert p["argv"][:4]==stock["commands"][0]["argv"][:4]
assert p["argv"][5]==stock["entrypoint"] and p["argv"][6]=="-o" and p["capSeconds"]==30
for path,b in p["symlinkBindings"].items():assert os.readlink(path)==b["readlink"] and str(Path(path).resolve(strict=True))==b["resolved"]
ast.parse((HERE/"launch.py.source").read_text())
argv=p["argv"][:5]+["--version"]
r=subprocess.run(argv,env=p["environment"],cwd=p["cwd"],capture_output=True,timeout=5)
(HERE/"control-version.stdout").write_bytes(r.stdout);(HERE/"control-version.stderr").write_bytes(r.stderr)
assert r.returncode==0 and r.stdout==b"bend 2.0.35\n" and r.stderr==b"",(r.returncode,r.stdout,r.stderr)
checks={"exit":0,"planSHA256":sha(HERE/"plan.json"),"argv":argv,"capSeconds":5,"cwd":p["cwd"],"environment":p["environment"],"stdoutSHA256":sha(HERE/"control-version.stdout"),"stderrSHA256":sha(HERE/"control-version.stderr"),"checks":["seven patch inverse/exact payload membership","no observed helper/import/marks","stock argv prefix/cwd/entry/env plus explicit embeddedBun selector","current pins/links/Python AST","actual copied CLI version only"],"noCompilerWorkload":True}
(HERE/"CONTROLS.json").write_text(json.dumps(checks,indent=2)+"\n")
print("PASS: exact unobserved payload/currentpins/stockcwd/argv/env/version; no compiler workload")
