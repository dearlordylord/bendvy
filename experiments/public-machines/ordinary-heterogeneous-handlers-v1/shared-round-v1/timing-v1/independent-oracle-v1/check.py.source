from pathlib import Path
import runpy,json,gzip,hashlib
here=Path(__file__).resolve().parent
m=runpy.run_path(str(here/'model.py.source'))
basis=json.loads((here/'SOURCE-BASIS.json').read_text())
for group in ('sourcePins','inputs'):
 for path,digest in basis[group].items():
  assert hashlib.sha256(Path(path).read_bytes()).hexdigest()==digest,path
for key,v in json.loads((here/'ORACLES.json').read_text()).items():
 raw=m['expected'](key[:-1],int(key[-1]))
 assert raw==Path(v['rawStdout']).read_bytes()==gzip.decompress(Path(v['stdout']).read_bytes())
 assert raw.decode()==json.loads(Path(v['expectedJSON']).read_text())
 assert len(raw)==v['bytes'] and hashlib.sha256(raw).hexdigest()==v['sha256']
 assert m['digest'](raw)==v['digest']==json.loads(Path(v['metrics']).read_text())['digest']
print('PASS: 83 source pins; six complete stdout/JSON/gzip/digest oracles')
