from pathlib import Path
import json,hashlib
HERE=Path(__file__).resolve().parent
p=HERE/'paired-v1/cohort02/plan.json';plan=json.loads(p.read_text())
def sha(f):return hashlib.sha256(Path(f).read_bytes()).hexdigest()
assert len(plan['roles'])==9 and len(plan['commands'])==258
for scale in [1,2,4]:
 for role,title in [('js','JS'),('native','Native'),('ts','TS')]:
  directory=HERE/('scale'+str(scale)+'-ordinary01')/role
  q=json.loads((directory/'plan.json').read_text());r=json.loads((directory/'receipt.json').read_text());selected=plan['roles']['scale'+str(scale)+'-'+title]
  assert r['status']=='DEVELOPMENT_PASS' and r['planSHA256']==sha(directory/'plan.json')
  assert selected['command']==q['commands'][-1]['argv']==r['commands'][-1]['argv']
  argv=selected['command'];assert argv[:3]==['/usr/bin/taskset','-c','11']
  if role=='native':
   assert argv[3]==q['native'] and argv[4:]==['--threads','1','--gpu','off']
   assert sha(argv[3])==r['buildArtifactSHA256']
  elif role=='js':
   assert argv[4]==q['generated'] and len(argv)==5
   assert sha(argv[4])==r['generatedSHA256']
  else:assert argv[4]==q['entrypoint'] and len(argv)==5
  assert selected['oracle']==q['oracle'] and selected['expectedSHA256']==sha(q['oracle'])
for c in plan['commands']:
 assert c['argv']==plan['roles'][c['roleKey']]['command'] and c['capSeconds']==5
assert all(sha(f)==h for f,h in plan['pins'].items())
assert plan['targets']=={'JS':'JS <= TS','Native':'Native <= 0.5 * TS'}
print('All nine qualified artifact identities, 258 executable/options/oracle joins and current pins PASS')
