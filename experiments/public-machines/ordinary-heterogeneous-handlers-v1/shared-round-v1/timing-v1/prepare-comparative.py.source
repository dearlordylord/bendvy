"""Bind already-qualified whole observer-inclusive artifacts to unchanged paired CPU11 executor."""
from pathlib import Path
import json,hashlib,sys
HERE=Path(__file__).resolve().parent
ROOT=Path('/workspace/formal-proofs/bendvy')
OLD=ROOT/'experiments/public-bundles/owned-public-result-v1/common20-timing-v1/current-ordinary-v1/owner-data-format-v1/current-classification-v1/cpu11-v1/cohort01/plan.json'
def sha(p):return hashlib.sha256(Path(p).read_bytes()).hexdigest()
parent=json.loads(OLD.read_text());plan=dict(parent);roles={};pins={};resources=None
for scale in [1,2,4]:
 for role in ['js','native','ts']:
  path=HERE/('scale'+str(scale)+'-ordinary01')/role/'plan.json';p=json.loads(path.read_text());receipt=path.parent/'receipt.json';r=json.loads(receipt.read_text())
  assert r['status']=='DEVELOPMENT_PASS' and r['planSHA256']==sha(path)
  for name,h in p['pins'].items():
   assert sha(name)==h,name
   if name in pins:assert pins[name]==h,name
   pins[name]=h
  for f in [path,receipt,Path(p['constructorInventory']),Path(p['oracle']),Path(p['generated'])]+([Path(p['native'])] if p.get('native') else []):pins[str(f)]=sha(f)
  for c in r['commands']:
   for field in ['stdout','stderr']:
    f=Path(c[field]['path']);pins[str(f)]=sha(f)
  title={'js':'JS','native':'Native','ts':'TS'}[role]
  transport=Path(p['collector']).parent/'transport.py' if role=='ts' else ROOT/'experiments/public-bundles/owned-public-result-v1/common20-timing-v1/timed-io-v1/transport-v1/transport.py'
  roles['scale'+str(scale)+'-'+title]={'command':p['commands'][-1]['argv'],'environment':p['environment'],'cwd':p['cwd'],'entrypoint':p['entrypoint'],'transport':str(transport),'inventory':p['constructorInventory'],'oracle':p['oracle'],'expectedSHA256':p['expectedSHA256']}
  if role=='native':resources={k:p[k] for k in ['resourceRoots','resourceInventory']}
commands=[]
for c in parent['commands']:
 row=dict(c);row['argv']=roles[row['roleKey']]['command'];commands.append(row)
for f in [OLD,Path(parent['samplingHelper']),Path(__file__),HERE/'COSTSCOPE.json',HERE/'FREEZE.json',ROOT/'benchmarks/contract.json']:
 pins[str(f)]=sha(f)
# Exact accepted driver and its pinned execution dependencies; no runner edit.
for name,h in parent['pins'].items():
 if name.endswith('.py') or name in parent['tools'].values():
  assert sha(name)==h,name
  if name in pins:assert pins[name]==h,name
  pins[name]=h
plan.update(scope='Complete observer-inclusive shared heterogeneous handler IO envelopes, fresh worlds scales1/2/4; descriptive paired evidence only, not pure-handler/full49 performance closure',roles=roles,pins=pins,commands=commands,cpu=11,observationOverhead='Full Bend13String observations and TS11physical records+ledger+trace objects/JSON differ and are retained in-region. UTF8/FNV capture in-region, flush outside. No subtraction/equal-byte/pureECS claim.',**resources)
assert len(commands)==258 and plan['samplingRows']==parent['samplingRows'];assert all(c['argv'][2]=='11' for c in commands)
assert plan['targets']=={'JS':'JS <= TS','Native':'Native <= 0.5 * TS'}
out=HERE/'paired-v1/cohort01';out.mkdir(parents=True,exist_ok=False);target=out/'plan.json';target.write_text(json.dumps(plan,indent=2)+'\n');print(sha(target))
