from pathlib import Path
import json,hashlib,runpy,gzip
p=Path(__file__).resolve().parent;b=json.loads((p/'SOURCE-BASIS.json').read_text())
for group in ('sourcePins','inputs','modelPins'):
 for path,digest in b[group].items():assert hashlib.sha256(Path(path).read_bytes()).hexdigest()==digest,path
source=Path('/workspace/formal-proofs/bendvy/src/ecs/schedule-checked.bend').read_text()
mut='    case (world,Fail{_}): Sch.conditioned_skip(~S,~C,~R,~E,~H,~Error,~skip,~dispatch,next,False{},owners,world,namespace,name,all,observations,id)'
normal='    case (world,Fail{error}): Sch.Failed{Sch.Schedule{namespace,name,all,owners},world,error,observations}'
assert source.count(mut)==1
assert hashlib.sha256(source.replace(mut,normal).encode()).hexdigest()=='e6c38354be34c3763e2c79d8c078065d5b62e1a628230f222a3158031dccbfb4'
rel=json.loads(Path(b['relocationPath']).read_text());consumer=Path(rel['target']).read_text()
for x in rel['importRebindings']:consumer=consumer.replace('import '+x['to']+' as ','import '+x['from']+' as ')
assert consumer==Path(rel['source']).read_text()
assert 'CheckedSch.run_with_skip(' in consumer
m=runpy.run_path(str(p/'model.py.source'));v=json.loads((p/'ORACLES.json').read_text())
for key,fun in [('mutant','mutant'),('normalBaseline','normal')]:
 raw=m[fun]();item=v[key];assert raw==gzip.decompress(Path(item['stdout']).read_bytes());assert len(raw)==item['bytes'] and hashlib.sha256(raw).hexdigest()==item['sha256']
assert m['mutant']()!=m['normal']()
print('PASS: actualpublicuniqueFail→falseinverse/currentclosure/full3740counter+3733baseline; no runtimeinputs')
