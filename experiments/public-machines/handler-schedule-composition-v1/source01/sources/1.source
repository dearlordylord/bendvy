import Base
import /workspace/formal-proofs/bendvy/experiments/public-handlers/remaining-core-v1/types.bend as T
import ./application.bend as App
import ./bridge.bend as Bridge
import ./full-observe.bend as Observe
import /workspace/formal-proofs/bendvy/src/ecs/world.bend as W
import /workspace/formal-proofs/bendvy/src/ecs/schedule.bend as Sch
import /workspace/formal-proofs/bendvy/src/ecs/system.bend as Sys
import /workspace/formal-proofs/bendvy/src/ecs/machine-handlers.bend as H
import ./systems.bend as Systems

def step(value:Sch.Step) -> String:
  match value:
    case Sch.Barrier{}:"Barrier"
    case Sch.Phase{name}:"Phase:" ++ name
    case Sch.System{id,condition}:"System:" ++ U32.show(id) ++ ":condition=" ++ U32.show(condition)
def observation(value:Sch.Observation) -> String:
  match value:
    case Sch.Applied{}:"Applied"
    case Sch.Entered{name}:"Entered:" ++ name
    case Sch.Ran{id}:"Ran:" ++ U32.show(id)
    case Sch.Skipped{id}:"Skipped:" ++ U32.show(id)
def shown(~S:Data,label:String,pair:App.Application<S> & String) -> App.Application<S> & String:
  match pair:
    case (app,text):(app,label ++ "|" ++ text)
def snapshot(~S:Data,app:App.Application<S>) -> App.Application<S> & String:
  shown(~S,"snapshot",Observe.observe(~S,app))
def returned(~S:Data,readerRegistry:Maybe<&1,Sys.Registry<S,T.Store<S>,T.Resources<S>,Unit,Unit,String,Unit,Systems.reader_runner(~S)>>,result:Bridge.Result<S>) -> App.Application<S> & String:
  match result:
    case Bridge.Result{world,owners,steps,observations,status}:shown(~S,"schedule=" ++ status ++ "|steps=" ++ List.show(&2,Sch.Step,step,steps) ++ "|observations=" ++ List.show(&2,Sch.Observation,observation,observations),Observe.observe(~S,App.Application{world,owners,readerRegistry}))
def marker(~S:Data,app:App.Application<S>) -> App.Application<S> & String:
  match app:
    case App.Application{world,owners,readerRegistry}:returned(~S,readerRegistry,Bridge.run(~S,owners,world))
def read(~S:Data,app:App.Application<S>) -> App.Application<S> & String:
  shown(~S,"read",Observe.observe(~S,App.read(~S,app)))
def retry(~S:Data,id:U32,app:App.Application<S>) -> App.Application<S> & String:
  match id:
    case 3:marker(~S,App.queue_play(~S,app))
    case _:marker(~S,app)
def continued(~A:Type,next:A -> String -> String,result:A & String) -> String:
  match result:
    case (app,text):next(app,text)
def sequence(~A:Type,actions:List<(A -> A & String)>,prior:String,app:A) -> String:
  match actions:
    case []:prior
    case action <> rest:continued(~A,app=>text=>sequence(~A,rest,prior ++ text ++ "\n",app),action(app))
def seeded(~S:Data,id:U32,app:App.Application<S>) -> App.Application<S>:
  match app:
    case App.Application{W.World{ns,next,high,live,capacity,depth,store,T.Resources{owned,slot,stream,reader,locals,tick,prefix,delivered,applied},events,pending,registrations,nextSystem,clock},owners,readerRegistry}:App.Application{W.World{ns,next,high,live,capacity,depth,store,T.Resources{Array.set(U32,owned,1,id),slot,stream,reader,locals,tick,prefix,delivered,applied},events,pending,registrations,nextSystem,clock},owners,readerRegistry}
def created(~S:Data,id:U32,result:App.Construction<S>) -> String:
  match result:
    case App.ConstructionRefused{_}:"construction-refused"
    case App.Constructed{_,app}:sequence(~App.Application<S>,[snapshot(~S),marker(~S),read(~S),retry(~S,id),read(~S),snapshot(~S)],"",App.queue_play(~S,App.install_reader(~S,seeded(~S,id,app))))
def scenario(~S:Data,id:U32) -> String:
  created(~S,id,App.create(~S,W.factory()))
type Report is Data:
  Report{exit:String,transition:String,enter:String}
def report(~S:Data) -> Report:
  Report{scenario(~S,1),scenario(~S,2),scenario(~S,3)}
