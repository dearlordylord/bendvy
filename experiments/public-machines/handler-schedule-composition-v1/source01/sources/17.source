import Base
import /workspace/formal-proofs/bendvy/experiments/public-handlers/remaining-core-v1/types.bend as T
import /workspace/formal-proofs/bendvy/experiments/public-handlers/remaining-core-v1/world.bend as Lens
import ./systems.bend as Systems
import /workspace/formal-proofs/bendvy/src/ecs/world.bend as W
import /workspace/formal-proofs/bendvy/src/ecs/system.bend as Sys
import /workspace/formal-proofs/bendvy/src/ecs/machine.bend as M
import /workspace/formal-proofs/bendvy/src/ecs/machine-handlers.bend as H
import /workspace/formal-proofs/bendvy/src/ecs/machine-stream.bend as Stream
import /workspace/formal-proofs/bendvy/src/ecs/schedule.bend as Sch
import /workspace/formal-proofs/bendvy/src/ecs/ordinary-machine-schedule.bend as Ordinary

type Intent is Data:
  Idle{}
  Ready{from:T.State,to:T.State,skipSame:Bool}
type Owners<S:Data> is Type:
  Owners{handlers:H.Owners<S,T.Store<S>,T.Resources<S>,Unit,T.State,Systems.runner(~S)>,intent:Intent}
type Result<S:Data> is Type:
  Result{world:W.World<S,T.Store<S>,T.Resources<S>,Unit>,owners:H.Owners<S,T.Store<S>,T.Resources<S>,Unit,T.State,Systems.runner(~S)>,steps:List<&2,Sch.Step>,observations:List<&2,Sch.Observation>,status:String}
def tick(~S:Data,world:W.World<S,T.Store<S>,T.Resources<S>,Unit>) -> W.World<S,T.Store<S>,T.Resources<S>,Unit>:
  match world:
    case W.World{ns,next,high,live,capacity,depth,store,T.Resources{owned,slot,stream,reader,locals,tick,prefix,delivered,applied},events,pending,registrations,nextSystem,clock}:W.World{ns,next,high,live,capacity,depth,store,T.Resources{owned,slot,stream,reader,locals,1n+tick,prefix,delivered,applied},events,pending,registrations,nextSystem,clock}
def published(~S:Data,world:W.World<S,T.Store<S>,T.Resources<S>,Unit>,event:M.Transition<T.State>) -> W.World<S,T.Store<S>,T.Resources<S>,Unit>:
  match world:
    case W.World{ns,next,high,live,capacity,depth,store,T.Resources{owned,slot,stream,reader,locals,+tick,prefix,delivered,applied},events,pending,registrations,nextSystem,clock}:W.World{ns,next,high,live,capacity,depth,store,T.Resources{owned,slot,Stream.publish(~T.State,stream,tick,event),reader,locals,tick,prefix,delivered,applied},events,pending,registrations,nextSystem,clock}
def requeued(~S:Data,to:T.State,skipSame:Bool,pair:W.World<S,T.Store<S>,T.Resources<S>,Unit> & M.Slot<S,T.MachineKey,T.State>) -> W.World<S,T.Store<S>,T.Resources<S>,Unit>:
  (world,slot)=pair
  Lens.put(~S,world,M.queue(~S,~T.MachineKey,~T.State,slot,to,skipSame))
def committed(~S:Data,from:T.State,to:T.State,pair:W.World<S,T.Store<S>,T.Resources<S>,Unit> & M.Slot<S,T.MachineKey,T.State>) -> W.World<S,T.Store<S>,T.Resources<S>,Unit>:
  (world,slot)=pair
  published(~S,Lens.put(~S,world,H.committed(~S,~T.MachineKey,~T.State,slot,from,to)),M.Transition{from,to})
def prepared(~S:Data,handlers:H.Owners<S,T.Store<S>,T.Resources<S>,Unit,T.State,Systems.runner(~S)>,world:W.World<S,T.Store<S>,T.Resources<S>,Unit>,value:H.Prepared<S,T.MachineKey,T.State>) -> Owners<S> & Sys.Outcome<W.World<S,T.Store<S>,T.Resources<S>,Unit>,String,Unit>:
  match value:
    case H.Idle{slot}:(Owners{handlers,Idle{}},Sys.Succeeded{Lens.put(~S,world,slot),Unit{}})
    case H.Ready{slot,M.Transition{from,to},skipSame}:(Owners{handlers,Ready{from,to,skipSame}},Sys.Succeeded{Lens.put(~S,world,slot),Unit{}})
def captured(~S:Data,handlers:H.Owners<S,T.Store<S>,T.Resources<S>,Unit,T.State,Systems.runner(~S)>,pair:W.World<S,T.Store<S>,T.Resources<S>,Unit> & M.Slot<S,T.MachineKey,T.State>) -> Owners<S> & Sys.Outcome<W.World<S,T.Store<S>,T.Resources<S>,Unit>,String,Unit>:
  (world,+slot)=pair
  prepared(~S,handlers,world,H.prepare(~S,~T.MachineKey,~T.State,~T.same,slot,M.snapshot(~S,~T.MachineKey,~T.State,slot)))
def apply(~S:Data,owners:Owners<S>,world:W.World<S,T.Store<S>,T.Resources<S>,Unit>) -> Owners<S> & Sys.Outcome<W.World<S,T.Store<S>,T.Resources<S>,Unit>,String,Unit>:
  match owners:
    case Owners{handlers,_}:captured(~S,handlers,Lens.take(~S,tick(~S,world)))
def exited(~S:Data,transition:List<&1,H.Entry<S,T.Store<S>,T.Resources<S>,Unit,T.State,Systems.runner(~S)>>,enter:List<&1,H.Entry<S,T.Store<S>,T.Resources<S>,Unit,T.State,Systems.runner(~S)>>,+from:T.State,+to:T.State,+skipSame:Bool,result:H.PhaseResult<S,T.Store<S>,T.Resources<S>,Unit,T.State,Systems.runner(~S)>) -> Owners<S> & Sys.Outcome<W.World<S,T.Store<S>,T.Resources<S>,Unit>,String,Unit>:
  match result:
    case H.Complete{exit,world}:(Owners{H.Owners{exit,transition,enter},Ready{from,to,skipSame}},Sys.Succeeded{world,Unit{}})
    case H.Failed{exit,world,error}:(Owners{H.Owners{exit,transition,enter},Ready{from,to,skipSame}},Sys.Failed{requeued(~S,to,skipSame,Lens.take(~S,world)),error})
def exit(~S:Data,owners:Owners<S>,world:W.World<S,T.Store<S>,T.Resources<S>,Unit>) -> Owners<S> & Sys.Outcome<W.World<S,T.Store<S>,T.Resources<S>,Unit>,String,Unit>:
  match owners:
    case Owners{handlers,Idle{}}:(Owners{handlers,Idle{}},Sys.Succeeded{world,Unit{}})
    case Owners{H.Owners{exit,transition,enter},Ready{+from,+to,+skipSame}}:exited(~S,transition,enter,from,to,skipSame,H.run_phase(~S,~T.Store<S>,~T.Resources<S>,~Unit,~T.State,~Systems.runner(~S),exit,world,H.Exit{},from,to,None{}))
def transitioned(~S:Data,exit:List<&1,H.Entry<S,T.Store<S>,T.Resources<S>,Unit,T.State,Systems.runner(~S)>>,enter:List<&1,H.Entry<S,T.Store<S>,T.Resources<S>,Unit,T.State,Systems.runner(~S)>>,+from:T.State,+to:T.State,+skipSame:Bool,result:H.PhaseResult<S,T.Store<S>,T.Resources<S>,Unit,T.State,Systems.runner(~S)>) -> Owners<S> & Sys.Outcome<W.World<S,T.Store<S>,T.Resources<S>,Unit>,String,Unit>:
  match result:
    case H.Complete{transition,world}:(Owners{H.Owners{exit,transition,enter},Ready{from,to,skipSame}},Sys.Succeeded{committed(~S,from,to,Lens.take(~S,world)),Unit{}})
    case H.Failed{transition,world,error}:(Owners{H.Owners{exit,transition,enter},Ready{from,to,skipSame}},Sys.Failed{requeued(~S,to,skipSame,Lens.take(~S,world)),error})
def transition(~S:Data,owners:Owners<S>,world:W.World<S,T.Store<S>,T.Resources<S>,Unit>) -> Owners<S> & Sys.Outcome<W.World<S,T.Store<S>,T.Resources<S>,Unit>,String,Unit>:
  match owners:
    case Owners{handlers,Idle{}}:(Owners{handlers,Idle{}},Sys.Succeeded{world,Unit{}})
    case Owners{H.Owners{exit,transition,enter},Ready{+from,+to,+skipSame}}:transitioned(~S,exit,enter,from,to,skipSame,H.run_phase(~S,~T.Store<S>,~T.Resources<S>,~Unit,~T.State,~Systems.runner(~S),transition,world,H.Transition{},from,to,None{}))
def entered(~S:Data,exit:List<&1,H.Entry<S,T.Store<S>,T.Resources<S>,Unit,T.State,Systems.runner(~S)>>,transition:List<&1,H.Entry<S,T.Store<S>,T.Resources<S>,Unit,T.State,Systems.runner(~S)>>,intent:Intent,result:H.PhaseResult<S,T.Store<S>,T.Resources<S>,Unit,T.State,Systems.runner(~S)>) -> Owners<S> & Sys.Outcome<W.World<S,T.Store<S>,T.Resources<S>,Unit>,String,Unit>:
  match result:
    case H.Complete{enter,world}:(Owners{H.Owners{exit,transition,enter},intent},Sys.Succeeded{world,Unit{}})
    case H.Failed{enter,world,error}:(Owners{H.Owners{exit,transition,enter},intent},Sys.Failed{world,error})
def enter(~S:Data,owners:Owners<S>,world:W.World<S,T.Store<S>,T.Resources<S>,Unit>) -> Owners<S> & Sys.Outcome<W.World<S,T.Store<S>,T.Resources<S>,Unit>,String,Unit>:
  match owners:
    case Owners{handlers,Idle{}}:(Owners{handlers,Idle{}},Sys.Succeeded{world,Unit{}})
    case Owners{H.Owners{exit,transition,enter},Ready{+from,+to,+skipSame}}:entered(~S,exit,transition,Ready{from,to,skipSame},H.run_phase(~S,~T.Store<S>,~T.Resources<S>,~Unit,~T.State,~Systems.runner(~S),enter,world,H.Enter{},from,to,None{}))
def returned(~S:Data,result:Sch.RunResult<S,T.Store<S>,T.Resources<S>,Unit,Owners<S>,String>) -> Result<S>:
  match result:
    case Sch.Finished{Sch.Schedule{_,_,steps,Owners{handlers,_}},world,observations}:Result{world,handlers,steps,observations,"finished"}
    case Sch.Failed{Sch.Schedule{_,_,steps,Owners{handlers,_}},world,error,observations}:Result{world,handlers,steps,observations,"failed:" ++ error}
    case Sch.Rejected{Sch.Schedule{_,_,steps,Owners{handlers,_}},world}:Result{world,handlers,steps,[],"rejected"}
def installed(~S:Data,world:W.World<S,T.Store<S>,T.Resources<S>,Unit>,built:Sch.Build<S,T.Store<S>,T.Resources<S>,Unit,Owners<S>>) -> Result<S>:
  match built:
    case Sch.Invalid{Owners{handlers,_}}:Result{world,handlers,[],[],"invalid"}
    case Sch.Built{schedule}:returned(~S,Ordinary.run(~S,~T.Store<S>,~T.Resources<S>,~Unit,~Owners<S>,~String,~apply(~S),~exit(~S),~transition(~S),~enter(~S),schedule,world))
def named(~S:Data,owners:H.Owners<S,T.Store<S>,T.Resources<S>,Unit,T.State,Systems.runner(~S)>,pair:W.World<S,T.Store<S>,T.Resources<S>,Unit> & U32) -> Result<S>:
  (world,namespace)=pair
  installed(~S,world,Ordinary.install(~S,~T.Store<S>,~T.Resources<S>,~Unit,~Owners<S>,~String,Ordinary.declare(~S,"handler-global-marker"),namespace,Owners{owners,Idle{}}))
# Existing fixture requirement is machine availability. Physical C/R are typed
# construction requirements; Bundle-wide declaration requirements are not faked.
def available(~S:Data,owners:H.Owners<S,T.Store<S>,T.Resources<S>,Unit,T.State,Systems.runner(~S)>,pair:W.World<S,T.Store<S>,T.Resources<S>,Unit> & M.Slot<S,T.MachineKey,T.State>) -> Result<S>:
  match pair:
    case (world,M.Missing{}):Result{Lens.put(~S,world,M.Missing{}),owners,[],[],"machine-unavailable"}
    case (world,slot):named(~S,owners,W.namespace(~S,~T.Store<S>,~T.Resources<S>,~Unit,Lens.put(~S,world,slot)))
def run(~S:Data,owners:H.Owners<S,T.Store<S>,T.Resources<S>,Unit,T.State,Systems.runner(~S)>,world:W.World<S,T.Store<S>,T.Resources<S>,Unit>) -> Result<S>:
  available(~S,owners,Lens.take(~S,world))
