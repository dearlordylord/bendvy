def publish(~S:Data,~J:Type,~caps:EventOps(~S,J),stage:J,+value:U32,+delta:U32) -> J:
  stage=Pub.emit(~S,~Array<U32>,~Families.a_domain(~S),~J,~a_cap(~S,~J,~caps),stage,ANode{ALeaf{value},ALeaf{delta}})
  stage=Pub.emit(~S,~Array<U32>,~Families.b_domain(~S),~J,~b_cap(~S,~J,~caps),stage,ANode{ALeaf{(value + 100 : U32)},ALeaf{delta}})
  stage=Pub.emit(~S,~Array<U32>,~Families.a_domain(~S),~J,~a_cap(~S,~J,~caps),stage,ANode{ALeaf{(value + 1 : U32)},ALeaf{delta}})
  Pub.emit(~S,~Array<Array<U32>>,~Families.c_domain(~S),~J,~c_cap(~S,~J,~caps),stage,ANode{ALeaf{ANode{ALeaf{value},ALeaf{delta}}},ALeaf{ANode{ALeaf{(value + 2 : U32)},ALeaf{delta}}}})
def decision(fail:Bool,value:U32) -> T.Outcome<Error>:
  match fail:
    case True{}:T.Failure{FailedAt{value}}
    case False{}:T.Success{}
def counted(~S:Data,~H:Type,~caps:Ops(H),~J:Type,~emit:EventOps(~S,J),+value:U32,args:Args,stage:J,result:H & U32) -> H & (J & (T.Outcome<Error> & U32)):
  match args result:
    case Args{+delta,+failValue}, (owner,+n):
      (Cap.value_set(~H,~Array<U32>,~U32,~Pair.snd(Cap.Write<H,U32,U32>,Cap.ValueWrite<H,Array<U32>,U32>,caps),Cap.set(~H,~U32,~U32,~Pair.fst(Cap.Write<H,U32,U32>,Cap.ValueWrite<H,Array<U32>,U32>,caps),owner,(value + delta : U32)),ANode{ALeaf{(n + 1 : U32)},ALeaf{(n + 2 : U32)}}),(publish(~S,~J,~emit,stage,value,delta),(decision(U32.is_eq(value,failValue),value),value)))
def got(~S:Data,~H:Type,~caps:Ops(H),~J:Type,~emit:EventOps(~S,J),args:Args,stage:J,result:H & C.Access<U32>) -> H & (J & (T.Outcome<Error> & U32)):
  match result:
    case (owner,C.Found{value}):counted(~S,~H,~caps,~J,~emit,value,args,stage,Cap.value_get(~H,~Array<U32>,~U32,~Pair.snd(Cap.Write<H,U32,U32>,Cap.ValueWrite<H,Array<U32>,U32>,caps),owner))
    case (owner,_):(owner,(stage,(T.Failure{Missing{}},0)))
