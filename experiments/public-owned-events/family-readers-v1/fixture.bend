def nested_leaf(result:Array<U32> & Payload.Projection) -> Array<Array<U32>> & Payload.Projection:
  match result:
    case (owner,value):(ALeaf{owner},value)
def nested_node(right:Array<Array<U32>>,result:Array<Array<U32>> & Payload.Projection) -> Array<Array<U32>> & Payload.Projection:
  match result:
    case (left,value):(ANode{left,right},value)
# Request.index addresses a cell in the first crate; all other crates stay owned.
def nested_at(owner:Array<Array<U32>>,request:Payload.Request) -> Array<Array<U32>> & Payload.Projection:
  match owner:
    case ALeaf{value}:nested_leaf(Payload.at(value,request))
    case ANode{left,right}:nested_node(right,nested_at(left,request))
