  S.World{7,999,S.Rows{ALeaf{Some{Owned{ALeaf{1000},1}}},ALeaf{Some{Owned{ALeaf{101000},101}}},S.MetadataColumns{ALeaf{True{}},ALeaf{Some{Unit{}}},ALeaf{100},ALeaf{200}},1,0n,1},[],Some{Owned{ALeaf{999000},999}},123}
