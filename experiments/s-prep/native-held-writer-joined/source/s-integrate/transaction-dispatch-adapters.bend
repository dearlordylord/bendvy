def motion_world_reserve(world:S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode>) -> S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode> & Maybe<&2,S.Handle<T.MotionSchema>>:
  I.reserve_id(T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode,world)
def motion_spawn_finish(bundle:S.Bundle<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>,result:X.Tx<S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>> & Maybe<&2,S.Handle<T.MotionSchema>>) -> T.Reservation<X.Tx<S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>>,S.Handle<T.MotionSchema>,S.Bundle<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>>:
  match result:
    case (t,None{}): T.ReserveRejected{t,bundle}
    case (t,Some{S.Handle{+namespace,+id}}): T.Reserved{X.tx_stage_command(S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>,t,S.Spawn{id,bundle}),S.Handle{namespace,id}}
