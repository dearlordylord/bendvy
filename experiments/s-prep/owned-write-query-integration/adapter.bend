# Checked live binding is retained unchanged by the closed opaque callback.
# Only Main/Ledger providers are supplied; they never modify the remaining World.
def health_restore(world:S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,handle:S.Handle<T.HealthSchema>,main:T.Vitals,ledger:Maybe<T.HealthLedger>) -> S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>:
  match world handle:
    case S.World{namespace,next,S.Rows{m,a,f,capacity,depth,high},pending,_,mode} S.Handle{_,id}:
      S.World{namespace,next,S.Rows{Array.set(Maybe<T.Vitals>,m,U32.sub(id,1),Some{main}),a,f,capacity,depth,high},pending,ledger,mode}
def health_joined(result:J.Held<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,T.Vitals,T.HealthLedger,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>> & U32) -> X.Tx<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>> & U32:
  match result:
    case (J.Held{world,main,ledger,+selected,undo,commands,pings,marks},value): (X.Tx{health_restore(world,selected,main,Some{ledger}),selected,undo,commands,pings,marks},value)
def health_context_world(context:HealthContext,rows:S.Rows<T.Vitals,T.Armor,T.Tracked>) -> X.Tx<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>>:
