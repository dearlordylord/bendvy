import Base
import ./types.bend as T
import ./storage.bend as S
import ./payload.bend as P
import ./transaction.bend as X
import ./held.bend as J

type MotionContext is Type:
  MotionContext{namespace:U32,next:U32,pending:List<S.Command<T.Position,T.Velocity,T.Selected>>,ledger:Maybe<T.MotionLedger>,mode:T.MotionMode,selected:S.Handle<T.MotionSchema>,undo:List<&2,X.Inverse<S.Handle<T.MotionSchema>>>,commands:List<S.Command<T.Position,T.Velocity,T.Selected>>,pings:List<&2,U32>,marks:List<&2,S.Handle<T.MotionSchema>>}
def motion_read_main(owner:J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>>,token:T.PositionToken) -> J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & T.Access<T.PositionView>:
  match token:
    case T.PositionToken{}: J.main_read(S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>,T.PositionView,P.position_get,owner)
def motion_set_main0(owner:J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>>,token:T.PositionToken,value:U32) -> J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>>:
  match token:
    case T.PositionToken{}: J.main_write(S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>,P.position_swap,owner,value)
def motion_read_ledger(owner:J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>>,token:T.MotionLedgerToken) -> J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & Maybe<&2,T.LedgerView>:
  match token:
    case T.MotionLedgerToken{}: J.ledger_read(S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>,T.LedgerView,P.motion_ledger_get,owner)
def motion_set_ledger0(owner:J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>>,token:T.MotionLedgerToken,value:U32) -> J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>>:
  match token:
    case T.MotionLedgerToken{}: J.ledger_write(S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>,P.motion_ledger_swap,owner,value)
# Checked live binding is retained unchanged by the closed opaque callback.
# Only Main/Ledger providers are supplied; they never modify the remaining World.
def motion_restore(world:S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,handle:S.Handle<T.MotionSchema>,main:T.Position,ledger:Maybe<T.MotionLedger>) -> S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>:
  match world handle:
    case S.World{namespace,next,S.Rows{m,a,f,capacity,depth,high},pending,_,mode} S.Handle{_,id}:
      S.World{namespace,next,S.Rows{Array.set(Maybe<T.Position>,m,U32.sub(id,1),Some{main}),a,f,capacity,depth,high},pending,ledger,mode}
def motion_joined(result:J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32) -> X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32:
  match result:
    case (J.Held{world,main,ledger,+selected,undo,commands,pings,marks},value): (X.Tx{motion_restore(world,selected,main,Some{ledger}),selected,undo,commands,pings,marks},value)
def motion_context_world(context:MotionContext,rows:S.Rows<T.Position,T.Velocity,T.Selected>) -> X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>>:
  match context:
    case MotionContext{namespace,next,pending,ledger,mode,selected,undo,commands,pings,marks}:
      X.Tx{S.World{namespace,next,rows,pending,ledger,mode},selected,undo,commands,pings,marks}
def motion_required(~use:J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> -> J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32,~fallback:X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> -> X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32,context:MotionContext,rows:S.Rows<T.Position,T.Velocity,T.Selected>,main:T.Position) -> X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32:
  match context:
    case MotionContext{namespace,next,pending,Some{ledger},mode,selected,undo,commands,pings,marks}:
      motion_joined(use(J.Held{S.World{namespace,next,rows,pending,None{},mode},main,ledger,selected,undo,commands,pings,marks}))
    case MotionContext{namespace,next,pending,None{},mode,+selected,undo,commands,pings,marks}:
      fallback(X.Tx{motion_restore(S.World{namespace,next,rows,pending,None{},mode},selected,main,None{}),selected,undo,commands,pings,marks})
def motion_taken(~use:J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> -> J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32,~fallback:X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> -> X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32,context:MotionContext,result:S.Rows<T.Position,T.Velocity,T.Selected> & S.Taken<T.Position>) -> X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32:
  match result:
    case (rows,S.Taken{main}): motion_required(~use,~fallback,context,rows,main)
    case (rows,_): fallback(motion_context_world(context,rows))
def motion_valid(~use:J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> -> J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32,~fallback:X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> -> X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32,valid:Bool,owner:X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>>) -> X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32:
  match valid owner:
    case False{} owner: fallback(owner)
    case True{} X.Tx{S.World{namespace,next,rows,pending,ledger,mode},S.Handle{+foreign,+id},undo,commands,pings,marks}:
      motion_taken(~use,~fallback,MotionContext{namespace,next,pending,ledger,mode,S.Handle{foreign,id},undo,commands,pings,marks},S.take_rows(T.Position,T.Velocity,T.Selected,rows,id))
def motion_selected(~use:J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> -> J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32,~fallback:X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> -> X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32,namespace:U32,selected:S.Handle<T.MotionSchema>,owner:X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>>) -> X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32:
  match selected:
    case S.Handle{foreign,_}: motion_valid(~use,~fallback,U32.is_eq(namespace,foreign),owner)
def motion_run(~use:J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> -> J.Held<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,T.Position,T.MotionLedger,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32,~fallback:X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> -> X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32,owner:X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>>) -> X.Tx<S.World<T.MotionSchema,T.Position,T.Velocity,T.Selected,T.MotionLedger,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<T.Position,T.Velocity,T.Selected>> & U32:
  match owner:
    case X.Tx{S.World{+namespace,next,rows,pending,ledger,mode},+selected,undo,commands,pings,marks}:
      motion_selected(~use,~fallback,namespace,selected,X.Tx{S.World{namespace,next,rows,pending,ledger,mode},selected,undo,commands,pings,marks})

