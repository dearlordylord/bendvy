def health_required(~use:J.Held<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,T.Vitals,T.HealthLedger,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>> -> J.Held<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,T.Vitals,T.HealthLedger,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>> & U32,~fallback:X.Tx<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>> -> X.Tx<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>> & U32,context:HealthContext,rows:S.Rows<T.Vitals,T.Armor,T.Tracked>,main:T.Vitals) -> X.Tx<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>> & U32:
  match context:
    case HealthContext{namespace,next,pending,Some{ledger},mode,selected,undo,commands,pings,marks}:
      health_joined(use(J.Held{S.World{namespace,next,rows,pending,None{},mode},main,ledger,selected,undo,commands,pings,marks}))
    case HealthContext{namespace,next,pending,None{},mode,+selected,undo,commands,pings,marks}:
      fallback(X.Tx{health_restore(S.World{namespace,next,rows,pending,None{},mode},selected,main,None{}),selected,undo,commands,pings,marks})
def health_taken(~use:J.Held<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,T.Vitals,T.HealthLedger,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>> -> J.Held<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,T.Vitals,T.HealthLedger,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>> & U32,~fallback:X.Tx<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>> -> X.Tx<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>> & U32,context:HealthContext,result:S.Rows<T.Vitals,T.Armor,T.Tracked> & S.Taken<T.Vitals>) -> X.Tx<S.World<T.HealthSchema,T.Vitals,T.Armor,T.Tracked,T.HealthLedger,T.HealthMode>,S.Handle<T.HealthSchema>,S.Command<T.Vitals,T.Armor,T.Tracked>> & U32:
  match result:
    case (rows,S.Taken{main}): health_required(~use,~fallback,context,rows,main)
