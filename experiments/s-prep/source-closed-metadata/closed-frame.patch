+# Closed frame trim frontier; all public generic bodies retained.
+def prototype_closed_frame_trim_decision(~V: Data,drop: Bool,+head: Batch<V>,tail: List<&2,Batch<V>>,+size: U32,+dropped: U32,
+  ih: U32 -> U32 -> Cut<V>) -> Cut<V>:
+  match drop head:
+    case False{} kept: Cut{kept <> tail,size,dropped}
+    case True{} Batch{tick,n,_}: ih(U32.sub(size,n),maximum(dropped,tick))
+
+def prototype_closed_frame_trim_front(~V: Data,front: List<&2,Batch<V>>,+capacity: U32,+window: U32,+size: U32,+dropped: U32) -> Cut<V>:
+  match front:
+    case Nil{}: Cut{[],size,dropped}
+    case Con{Batch{+tick,+n,+values},+tail}:
+      prototype_closed_frame_trim_decision(~V,Bool.or(U32.is_le(tick,window),U32.is_gt(size,capacity)),Batch{tick,n,values},tail,size,dropped,
+        remaining => lost => prototype_closed_frame_trim_front(~V,tail,capacity,window,remaining,lost))
+
+def prototype_closed_frame_finish_cut(~V: Data,capacity: U32,cut: Cut<V>) -> Buffer<V>:
+  match cut:
+    case Cut{front,size,dropped}: Buffer{capacity,size,dropped,front,[]}
+
+def prototype_closed_frame_trim_second(~V: Data,+capacity: U32,+window: U32,rear: List<&2,Batch<V>>,cut: Cut<V>) -> Buffer<V>:
+  match cut:
+    case Cut{Nil{},size,dropped}: prototype_closed_frame_finish_cut(~V,capacity,prototype_closed_frame_trim_front(~V,List.reverse(&2,Batch<V>,rear),capacity,window,size,dropped))
+    case Cut{Con{head,tail},size,dropped}: Buffer{capacity,size,dropped,head <> tail,rear}
+
+def prototype_closed_frame_trim_buffer(~V: Data,buffer: Buffer<V>,window: U32,holders: List<&2,U32>) -> Buffer<V>:
+  match buffer:
+    case Buffer{+capacity,size,dropped,front,rear}:
+      +oldest = boundary(holders,window)
+      prototype_closed_frame_trim_second(~V,capacity,oldest,rear,prototype_closed_frame_trim_front(~V,front,capacity,oldest,size,dropped))
+
+def prototype_closed_frame_trim(~P: Data,log: PingLog<P>,window: U32,holders: List<&2,U32>) -> PingLog<P>:
+  match log:
+    case PingLog{buffer}: PingLog{prototype_closed_frame_trim_buffer(~P,buffer,window,holders)}
+
+def prototype_closed_frame_trim_lifecycle(~H: Data,log: LifeLog<H>,window: U32,holders: List<&2,U32>) -> LifeLog<H>:
