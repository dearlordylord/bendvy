 def read(-Schema: Data,-P: Data,logs: Logs<Schema,P>,run: R.Run) -> Read<Schema,P>:
   read_info(Schema,P,logs,R.project(run))
+
+# Closed lifecycle append route; public generic functions retained.
+def prototype_closed_stream_append_change(~Schema: Data,~P: Data,logs: Logs<Schema,P>,tick: U32,change: W.Change<Schema>) -> Logs<Schema,P>:
+  match logs change:
+    case Logs{ping,removed,despawned} W.MainRemoved{handle}: Logs{ping,S.prototype_closed_stream_append_lifecycle(W.Handle<Schema>,removed,tick,[handle]),despawned}
+    case Logs{ping,removed,despawned} W.Despawned{handle}: Logs{ping,removed,S.prototype_closed_stream_append_lifecycle(W.Handle<Schema>,despawned,tick,[handle])}
+    case saved _: saved
+
+def prototype_closed_stream_append_all(~Schema: Data,~P: Data,changes: List<&2,W.Change<Schema>>,+tick: U32,logs: Logs<Schema,P>) -> Logs<Schema,P>:
+  match changes:
+    case Nil{}: logs
+    case Con{head,tail}: prototype_closed_stream_append_all(~Schema,~P,tail,tick,prototype_closed_stream_append_change(~Schema,~P,logs,tick,head))
+
+def prototype_closed_stream_append_changes(~Schema: Data,~P: Data,logs: Logs<Schema,P>,tick: U32,changes: List<&2,W.Change<Schema>>) -> Logs<Schema,P>:
+  prototype_closed_stream_append_all(~Schema,~P,changes,tick,logs)
--- a/experiments/s-integrate/streams.bend
