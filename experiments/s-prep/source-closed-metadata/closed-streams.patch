@@ -131,2 +131,24 @@
     case Buffer{+capacity,+size,+dropped,+front,+rear}:
       (Buffer{capacity,size,dropped,front,rear},Inspection{capacity,size,dropped,List.append(&2,Batch<V>,front,List.reverse(&2,Batch<V>,rear))})
+
+# Closed lifecycle append route; public generic functions retained.
+def prototype_closed_stream_count(~V: Data,values: List<&2,V>,acc: U32) -> U32:
+  match values:
+    case Nil{}: acc
+    case Con{_,tail}: prototype_closed_stream_count(~V,tail,U32.add(acc,1))
+
+def prototype_closed_stream_append_buffer(~V: Data,buffer: Buffer<V>,tick: U32,values: List<&2,V>) -> Buffer<V>:
+  match buffer values:
+    case Buffer{capacity,size,dropped,front,rear} Nil{}: Buffer{capacity,size,dropped,front,rear}
+    case Buffer{capacity,size,dropped,front,rear} Con{+v,+vs}:
+      +n = prototype_closed_stream_count(~V,v <> vs,0)
+      Buffer{capacity,U32.add(size,n),dropped,front,Batch{tick,n,v <> vs} <> rear}
+
+def prototype_closed_stream_append_units(~H: Data,values: List<&2,H>,+tick: U32,buffer: Buffer<H>) -> Buffer<H>:
+  match values:
+    case Nil{}: buffer
+    case Con{value,tail}: prototype_closed_stream_append_units(~H,tail,tick,append_buffer(H,buffer,tick,[value]))
+
+def prototype_closed_stream_append_lifecycle(~H: Data,log: LifeLog<H>,tick: U32,handles: List<&2,H>) -> LifeLog<H>:
+  match log:
+    case LifeLog{buffer}: LifeLog{prototype_closed_stream_append_units(~H,handles,tick,buffer)}
