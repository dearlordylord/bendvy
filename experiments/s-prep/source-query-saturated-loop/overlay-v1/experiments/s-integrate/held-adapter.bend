# Private tagged recursive affine box: every finite value contains exactly one World.
type PrototypeWorldBox<-W: Type> is Type:
  PrototypeWorldRoot{world: W}
  PrototypeWorldNested{inner: PrototypeWorldBox<W>}
def prototype_world_unbox(-W: Type,box: PrototypeWorldBox<W>) -> W:
  match box:
    case PrototypeWorldRoot{world}: world
    case PrototypeWorldNested{inner}: prototype_world_unbox(W,inner)

type PrototypeFlatHeld<-W:Type,-Raw:Type,-View:Data,-L:Type,-LV:Data,-H:Data,-C:Type> is Type:
  PrototypeFlatHeld{world:W,main_raw:Raw,main_cached:View,ledger_raw:L,ledger_cached:LV,handle:H,undo:List<&2,X.Inverse<H>>,commands:List<C>,pings:List<&2,U32>,marks:List<&2,H>}

type PrototypeRowOwner<-Raw:Type,-View:Data,-L:Type,-LV:Data,-H:Data> is Type:
  PrototypeRowOwner{main_raw:Raw,main_cached:View,ledger_raw:L,ledger_cached:LV,handle:H,undo:List<&2,X.Inverse<H>>,marks:List<&2,H>}
def prototype_rowsplit_motion_get(owner:PrototypeRowOwner<T.Position,T.PositionView,T.MotionLedger,T.LedgerView,S.Handle<T.MotionSchema>>,token:T.PositionToken) -> PrototypeRowOwner<T.Position,T.PositionView,T.MotionLedger,T.LedgerView,S.Handle<T.MotionSchema>> & T.Access<T.PositionView>:
  match owner token:
    case PrototypeRowOwner{raw,+cached,ledger_raw,ledger_cached,handle,undo,marks} T.PositionToken{}:
      (PrototypeRowOwner{raw,cached,ledger_raw,ledger_cached,handle,undo,marks},T.Found{cached})


def prototype_rowsplit_motion_ledger(owner:PrototypeRowOwner<T.Position,T.PositionView,T.MotionLedger,T.LedgerView,S.Handle<T.MotionSchema>>,token:T.MotionLedgerToken) -> PrototypeRowOwner<T.Position,T.PositionView,T.MotionLedger,T.LedgerView,S.Handle<T.MotionSchema>> & Maybe<&2,T.LedgerView>:
  match owner token:
    case PrototypeRowOwner{main_raw,main_cached,raw,+cached,handle,undo,marks} T.MotionLedgerToken{}:
      (PrototypeRowOwner{main_raw,main_cached,raw,cached,handle,undo,marks},Some{cached})


def prototype_rowsplit_motion_set_fused_done(ledger_raw:T.MotionLedger,ledger_cached:T.LedgerView,+handle:S.Handle<T.MotionSchema>,undo:List<&2,X.Inverse<S.Handle<T.MotionSchema>>>,marks:List<&2,S.Handle<T.MotionSchema>>,cached:T.PositionView,value:U32,result:T.Position & U32) -> PrototypeRowOwner<T.Position,T.PositionView,T.MotionLedger,T.LedgerView,S.Handle<T.MotionSchema>>:
  match result:
    case (raw,old): PrototypeRowOwner{raw,P.position_patch(cached,value),ledger_raw,ledger_cached,handle,X.MainInverse{handle,old} <> undo,handle <> marks}


def prototype_rowsplit_motion_set(owner:PrototypeRowOwner<T.Position,T.PositionView,T.MotionLedger,T.LedgerView,S.Handle<T.MotionSchema>>,token:T.PositionToken,value:U32) -> PrototypeRowOwner<T.Position,T.PositionView,T.MotionLedger,T.LedgerView,S.Handle<T.MotionSchema>>:
  match owner token:
    case PrototypeRowOwner{raw,cached,ledger_raw,ledger_cached,+handle,undo,marks} T.PositionToken{}:
      +value = value
      prototype_rowsplit_motion_set_fused_done(ledger_raw,ledger_cached,handle,undo,marks,cached,value,P.prototype_position_raw_swap(raw,value))


def prototype_rowsplit_motion_setledger_fused_done(main_raw:T.Position,main_cached:T.PositionView,+handle:S.Handle<T.MotionSchema>,undo:List<&2,X.Inverse<S.Handle<T.MotionSchema>>>,marks:List<&2,S.Handle<T.MotionSchema>>,cached:T.LedgerView,value:U32,result:T.MotionLedger & U32) -> PrototypeRowOwner<T.Position,T.PositionView,T.MotionLedger,T.LedgerView,S.Handle<T.MotionSchema>>:
  match result:
    case (raw,old): PrototypeRowOwner{main_raw,main_cached,raw,P.motion_ledger_patch(cached,value),handle,X.LedgerInverse{old} <> undo,marks}


def prototype_rowsplit_motion_setledger(owner:PrototypeRowOwner<T.Position,T.PositionView,T.MotionLedger,T.LedgerView,S.Handle<T.MotionSchema>>,token:T.MotionLedgerToken,value:U32) -> PrototypeRowOwner<T.Position,T.PositionView,T.MotionLedger,T.LedgerView,S.Handle<T.MotionSchema>>:
  match owner token:
    case PrototypeRowOwner{main_raw,main_cached,raw,cached,handle,undo,marks} T.MotionLedgerToken{}:
      +value = value
      prototype_rowsplit_motion_setledger_fused_done(main_raw,main_cached,handle,undo,marks,cached,value,P.prototype_motion_ledger_raw_swap(raw,value))


def prototype_rowsplit_motion_invoke(~client:@-Owner:Type -> @-get:(Owner -> T.PositionToken -> Owner & T.Access<T.PositionView>) -> @-set:(Owner -> T.PositionToken -> U32 -> Owner) -> @-ledger:(Owner -> T.MotionLedgerToken -> Owner & Maybe<&2,T.LedgerView>) -> @-setledger:(Owner -> T.MotionLedgerToken -> U32 -> Owner) -> Owner -> Owner & U32,owner:PrototypeRowOwner<T.Position,T.PositionView,T.MotionLedger,T.LedgerView,S.Handle<T.MotionSchema>>) -> PrototypeRowOwner<T.Position,T.PositionView,T.MotionLedger,T.LedgerView,S.Handle<T.MotionSchema>> & U32:
  client(PrototypeRowOwner<T.Position,T.PositionView,T.MotionLedger,T.LedgerView,S.Handle<T.MotionSchema>>,prototype_rowsplit_motion_get,prototype_rowsplit_motion_set,prototype_rowsplit_motion_ledger,prototype_rowsplit_motion_setledger,owner)


def prototype_rowsplit_motion_return(result:PrototypeRowOwner<T.Position,T.PositionView,T.MotionLedger,T.LedgerView,S.Handle<T.MotionSchema>> & U32,ns:U32,next:U32,rows:S.Rows<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>,pending:List<S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>>,mode:T.MotionMode,commands:List<S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>>,pings:List<&2,U32>) -> X.Tx<S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>> & U32:
  match result rows:
    case (PrototypeRowOwner{main_raw,main_cached,ledger_raw,ledger_cached,S.Handle{+space,+id},undo,marks},total) S.Rows{columns,aux,meta,cap,depth,high}:
      (X.Tx{S.World{ns,next,S.Rows{Array.set(Maybe<CC.Cache<T.Position,T.PositionView>>,columns,U32.sub(id,1),Some{CC.Cache{main_raw,main_cached}}),aux,meta,cap,depth,high},pending,Some{CC.Cache{ledger_raw,ledger_cached}},mode},S.Handle{space,id},undo,commands,pings,marks},total)

def prototype_rowsplit_motion_taken(~client:@-Owner:Type -> @-get:(Owner -> T.PositionToken -> Owner & T.Access<T.PositionView>) -> @-set:(Owner -> T.PositionToken -> U32 -> Owner) -> @-ledger:(Owner -> T.MotionLedgerToken -> Owner & Maybe<&2,T.LedgerView>) -> @-setledger:(Owner -> T.MotionLedgerToken -> U32 -> Owner) -> Owner -> Owner & U32,ns:U32,next:U32,pending:List<S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>>,pair:S.Rows<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected> & S.Taken<CC.Cache<T.Position,T.PositionView>>,ledger:CC.Cache<T.MotionLedger,T.LedgerView>,mode:T.MotionMode,+handle:S.Handle<T.MotionSchema>,undo:List<&2,X.Inverse<S.Handle<T.MotionSchema>>>,commands:List<S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>>,pings:List<&2,U32>,marks:List<&2,S.Handle<T.MotionSchema>>) -> X.Tx<S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>> & U32:
  match pair ledger:
    case (rows,S.Taken{CC.Cache{main_raw,main_cached}}) CC.Cache{ledger_raw,ledger_cached}: prototype_rowsplit_motion_return(prototype_rowsplit_motion_invoke(~client,PrototypeRowOwner{main_raw,main_cached,ledger_raw,ledger_cached,handle,undo,marks}),ns,next,rows,pending,mode,commands,pings)
    case (rows,_) ledger: client(X.Tx<S.World<T.MotionSchema,CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected,CC.Cache<T.MotionLedger,T.LedgerView>,T.MotionMode>,S.Handle<T.MotionSchema>,S.Command<CC.Cache<T.Position,T.PositionView>,T.Velocity,T.Selected>>,A.motion_read_main,A.motion_set_main0,A.motion_read_ledger,A.motion_set_ledger0,X.Tx{S.World{ns,next,rows,pending,Some{ledger},mode},handle,undo,commands,pings,marks})


