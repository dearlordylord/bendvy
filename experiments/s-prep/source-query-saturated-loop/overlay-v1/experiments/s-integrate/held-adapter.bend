  PrototypeWriteFold{namespace:U32,next:U32,columns:Array<Maybe<M>>,aux:Array<Maybe<A>>,metadata:S.MetadataColumns<F>,capacity:U32,depth:Nat,high:U32,pending:List<S.Command<M,A,F>>,ledger:Maybe<L>,mode:Mode,selected:S.Handle<Schema>,undo:List<&2,X.Inverse<S.Handle<Schema>>>,commands:List<S.Command<M,A,F>>,pings:List<&2,U32>,marks:List<&2,S.Handle<Schema>>,total:U32}
