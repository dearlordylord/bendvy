#!/usr/bin/env python3
import argparse,json,pathlib,re,hashlib,shutil
H=pathlib.Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
def prepare(base,out,write_fusion=False):
 m=json.loads((base/'overlay.json').read_text());assert m['cacheSpecialization']['runtimeClosureSHA256']=='c9fd2616bad748f794b6e6822e166fcff09d3d26601533b56d77e52f92b55ecb';assert all(sha(base/n)==v for n,v in m['sources'].items());shutil.copytree(base,out);core=out/'experiments/s-integrate';p=core/'held-adapter.bend';original=p.read_text();text=original
 for prefix,rawstem,view,token,ledgerToken in [('motion','position','PositionView','PositionToken','MotionLedgerToken'),('health','vitals','VitalsView','VitalsToken','HealthLedgerToken')]:
  for op in ['get','ledger','set','setledger']:
   if op in ['set','setledger'] and not write_fusion:continue
   name=prefix+'_'+op;match=re.search(r'^def '+name+r'\([\s\S]*?(?=^def |\Z)',text,re.M);chunk=match[0];header=chunk.split('\n',1)[0];ismain=op in ['get','set'];iswrite=op in ['set','setledger'];cached='CC.Cache{raw,'+('cached' if iswrite else '+cached')+'}';main=cached if ismain else 'main';ledger='ledger' if ismain else cached;fields='world,'+main+','+ledger+','+('+handle' if ismain and iswrite else 'handle')+',undo,commands,pings,marks';new=header+'\n  match owner token:\n    case H.Held{'+fields+'} T.'+(token if ismain else ledgerToken)+'{}:\n'
   if iswrite:
    stem=rawstem if ismain else prefix+'_ledger'
    ownerType=header.split('owner:',1)[1].split(',token:',1)[0];args=[];depth=0;begin=0;inner=ownerType[len('H.Held<'):-1]
    for j,ch in enumerate(inner):
     if ch=='<':depth+=1
     elif ch=='>':depth-=1
     elif ch==',' and depth==0:args.append(inner[begin:j]);begin=j+1
    args.append(inner[begin:]);worldType,mainType,ledgerType,handleType,commandType=args;rawType={'position':'T.Position','vitals':'T.Vitals','motion_ledger':'T.MotionLedger','health_ledger':'T.HealthLedger'}[stem];viewType='T.'+view if ismain else 'T.LedgerView';otherType=ledgerType if ismain else mainType;otherName='ledger' if ismain else 'main';done=prefix+'_'+op+'_fused_done'
    body='H.Held{world,'+('CC.Cache{raw,P.'+stem+'_patch(cached,value)},ledger' if ismain else 'main,CC.Cache{raw,P.'+stem+'_patch(cached,value)}')+',handle,'+('X.MainInverse{handle,old} <> undo' if ismain else 'X.LedgerInverse{old} <> undo')+',commands,pings,'+('handle <> marks' if ismain else 'marks')+'}'
    helper='def '+done+'(world:'+worldType+','+otherName+':'+otherType+',+handle:'+handleType+',undo:List<&2,X.Inverse<'+handleType+'>>,commands:List<'+commandType+'>,pings:List<&2,U32>,marks:List<&2,'+handleType+'>,cached:'+viewType+',value:U32,result:'+rawType+' & U32) -> '+ownerType+':\n  match result:\n    case (raw,old): '+body+'\n\n'
    new+='      +value = value\n      '+done+'(world,'+otherName+',handle,undo,commands,pings,marks,cached,value,P.prototype_'+stem+'_raw_swap(raw,value))\n\n';new=helper+new
   else:new+='      (H.Held{world,'+('CC.Cache{raw,cached},ledger' if ismain else 'main,CC.Cache{raw,cached}')+',handle,undo,commands,pings,marks},'+('T.Found{cached}' if ismain else 'Some{cached}')+')\n\n'
   text=text[:match.start()]+new+text[match.end():]
 p.write_text(text)
 if write_fusion:
  cp=core/'cached-payload.bend';cptext=cp.read_text()
  for stem,raw in [('position','Position'),('vitals','Vitals'),('motion_ledger','MotionLedger'),('health_ledger','HealthLedger')]:
   cptext+='\ndef prototype_'+stem+'_raw_swap(owner:T.'+raw+',value:U32) -> T.'+raw+' & U32:\n  P.'+stem+'_swap(owner,value)\n'
  cp.write_text(cptext)
 assert all(line in text.splitlines() for line in original.splitlines() if line.startswith('def '));pins={str(p.relative_to(out)):sha(p) for p in out.rglob('*.bend')};c=m['cacheSpecialization'];c['baselineRuntimeClosureSHA256']=c['runtimeClosureSHA256'];c['runtimeClosure']={n:pins[n] for n in c['runtimeClosure']};c['runtimeClosureSHA256']=hashlib.sha256(json.dumps(c['runtimeClosure'],sort_keys=True,separators=(',',':')).encode()).hexdigest();c['derivedPrivateVariant']='js-held-cache-fusion-v1';c['specializedClosure']['experiments/s-integrate/held-adapter.bend']=sha(p);m['sources']=pins;(out/'overlay.json').write_text(json.dumps(m,indent=2)+'\n');(out/'cache-specialization.json').write_text(json.dumps(c,indent=2)+'\n');print(c['runtimeClosureSHA256'])
if __name__=='__main__':
 p=argparse.ArgumentParser();p.add_argument('--write-fusion',action='store_true');p.add_argument('--base',required=True,type=pathlib.Path);p.add_argument('--output',required=True,type=pathlib.Path);a=p.parse_args();prepare(a.base,a.output,a.write_fusion)
