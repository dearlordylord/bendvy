+def prototype_identity_array_presence(-M:Type,value:Maybe<M>) -> Maybe<M> & Bool:
+  match value:
+    case None{}: (None{},False{})
+    case Some{owner}: (Some{owner},True{})
+def prototype_identity_array_leaf(-M:Type,result:Maybe<M> & Bool) -> Array<Maybe<M>> & Bool:
+  match result:
+    case Tuple{value,+present}: (ALeaf{value},present)
+def prototype_identity_array_lo(-M:Type,right:Array<Maybe<M>>,result:Array<Maybe<M>> & Bool) -> Array<Maybe<M>> & Bool:
+  match result:
+    case Tuple{left,+present}: (ANode{left,right},present)
+def prototype_identity_array_hi(-M:Type,left:Array<Maybe<M>>,result:Array<Maybe<M>> & Bool) -> Array<Maybe<M>> & Bool:
+  match result:
+    case Tuple{right,+present}: (ANode{left,right},present)
+def prototype_identity_array_go(-M:Type,array:Array<Maybe<M>>,+size:U32,+index:U32,lower:Bool) -> Array<Maybe<M>> & Bool:
+  match array lower:
+    case ALeaf{value} _: prototype_identity_array_leaf(M,prototype_identity_array_presence(M,value))
+    case ANode{left,right} True{}:
+      +half = U32.shr(size)
+      prototype_identity_array_lo(M,right,prototype_identity_array_go(M,left,half,index,U32.is_lt(index,U32.shr(half))))
+    case ANode{left,right} False{}:
+      +half = U32.shr(size)
+      +next = U32.sub(index,half)
+      prototype_identity_array_hi(M,left,prototype_identity_array_go(M,right,half,next,U32.is_lt(next,U32.shr(half))))
+def prototype_identity_array_at(-M:Type,+index:U32,result:Array<Maybe<M>> & U32) -> Array<Maybe<M>> & Bool:
+  match result:
+    case Tuple{array,+size}:
+      +actual = U32.and(index,U32.sub(size,1))
+      prototype_identity_array_go(M,array,size,actual,U32.is_lt(actual,U32.shr(size)))
+def prototype_identity_array_inspect(-M:Type,array:Array<Maybe<M>>,index:U32) -> Array<Maybe<M>> & Bool:
+  prototype_identity_array_at(M,index,Array.size(Maybe<M>,array))
+
