+    case True{}: prototype_identity_struct_idx_main(~Schema,~M,~A,~F,id,namespace,aux,live,flags,added,changed,values,flag,prototype_identity_array_inspect(M,main,U32.sub(id,1)))
+
+def prototype_identity_struct_idx_metadata(~Schema: Data,~M: Type,~A: Type,~F: Data,id: U32,namespace: U32,selection: Selection,main: Array<Maybe<M>>,aux: Array<Maybe<A>>,values: List<&2,S.Handle<Schema>>,live: Array<Bool>,added: Array<U32>,changed: Array<U32>,value: Bool,result: Array<Maybe<&2,F>> & Maybe<&2,F>) -> StructColsState<M,A,F,S.Handle<Schema>>:
+  match value result:
+    case False{} Tuple{flags,_}: StructColsState{main,aux,live,flags,added,changed,values}
+    case True{} Tuple{flags,+flag}: prototype_identity_struct_idx_selected(~Schema,~M,~A,~F,selected(F,selection,flag),id,namespace,main,aux,live,flags,added,changed,values,flag)
+
+def prototype_identity_struct_cols_live(~Schema: Data,~M: Type,~A: Type,~F: Data,+id: U32,namespace: U32,selection: Selection,main: Array<Maybe<M>>,aux: Array<Maybe<A>>,values: List<&2,S.Handle<Schema>>,flags: Array<Maybe<&2,F>>,added: Array<U32>,changed: Array<U32>,result: Array<Bool> & Bool) -> StructColsState<M,A,F,S.Handle<Schema>>:
+  match result:
