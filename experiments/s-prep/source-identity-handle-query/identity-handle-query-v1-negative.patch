+def prototype_identity_each(~Schema: Data,~M: Type,~A: Type,~F: Data,~L:Type,~Mode:Data,selection: Selection,world: S.World<Schema,M,A,F,L,Mode>) -> S.World<Schema,M,A,F,L,Mode> & List<&2,S.Handle<Schema>>:
