  match owner:
    case System.Owner{Sys.Registry{+ns,+id,+name,+access,+cursor},capture}:(System.Owner{Sys.Registry{ns,id,name,access,cursor},capture},[Fields.Fields{ns,id,name,access,cursor,name,[],Fields.MixedKind{described(D.description(~S,~Product.Owner<W.World<S,C,R,E>,Capture>,~Recovery,~Ops,~builder,declaration))}}])
