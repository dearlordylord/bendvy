def use(target:Use.Target) -> List<&2,Fields.DeclaredUse>:
  match target:
    case Use.Component{key}:[Fields.DeclaredUse{Fields.ComponentUse{},Fields.QuerySource{},key,Query.Write{}}]
    case Use.Resource{key}:[Fields.DeclaredUse{Fields.ResourceUse{},Fields.QuerySource{},key,Query.Write{}}]
    case Use.Capture{}:[]
def uses(values:List<&2,Use.Use>) -> List<&2,Fields.DeclaredUse>:
  match values:
    case []:[]
    case Use.Use{target,Use.Write{}} <> rest:List.append(&2,Fields.DeclaredUse,use(target),uses(rest))
def described(value:Use.Description) -> List<&2,Fields.DeclaredUse>:
  match value:
    case Use.Description{values,_}:uses(values)
