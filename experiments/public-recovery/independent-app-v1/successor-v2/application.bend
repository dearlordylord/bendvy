def first_cap(~S:Data,~H:Type,~caps:Ops(~S)(H)) -> FirstOps(~S)(H):Cap.first(~FirstOps(~S)(H),~TailOps(~S)(H),caps)
def tail_cap(~S:Data,~H:Type,~caps:Ops(~S)(H)) -> TailOps(~S)(H):Cap.second(~FirstOps(~S)(H),~TailOps(~S)(H),caps)
def second_cap(~S:Data,~H:Type,~caps:Ops(~S)(H)) -> SecondOps(~S)(H):Cap.first(~SecondOps(~S)(H),~FinalOps(~S)(H),tail_cap(~S,~H,~caps))
def final_cap(~S:Data,~H:Type,~caps:Ops(~S)(H)) -> FinalOps(~S)(H):Cap.second(~SecondOps(~S)(H),~FinalOps(~S)(H),tail_cap(~S,~H,~caps))
def capture_cap(~S:Data,~H:Type,~caps:Ops(~S)(H)) -> CaptureOps()(H):Cap.first(~CaptureOps()(H),~ResourceOps(~S)(H),final_cap(~S,~H,~caps))
def resource_cap(~S:Data,~H:Type,~caps:Ops(~S)(H)) -> ResourceOps(~S)(H):Cap.second(~CaptureOps()(H),~ResourceOps(~S)(H),final_cap(~S,~H,~caps))
type Args<S:Data> is Type:Args{target:W.Handle<S>,resource:Array<Array<U32>>,capture:Array<Array<U32>>,abort:Bool}
type Error is Data:
  PolicyDeclined{}
  MissingTarget{}
type Output is Type:Output{removed:Bool,refused:Maybe<Array<Array<U32>>>}
def verdict(abort:Bool) -> T.Outcome<Error>:
  match abort:
    case True{}:T.Failure{PolicyDeclined{}}
    case False{}:T.Success{}
def after_removal(~S:Data,~H:Type,~caps:Ops(~S)(H),resource:Array<Array<U32>>,capture:Array<Array<U32>>,abort:Bool,result:Existing.ComponentAttempt<H,Array<Array<U32>>>) -> H & (T.Outcome<Error> & Output):
  match result:
    case Existing.ComponentApplied{owner}:
      owner = ArrayEntry.replace(~S,~Array<U32>,~resource_identity(~S),~H,~resource_cap(~S,~H,~caps),owner,resource)
      owner = Existing.capture_replace(~Array<U32>,~H,~capture_cap(~S,~H,~caps),owner,capture)
      (owner,(verdict(abort),Output{True{},None{}}))
    case Existing.ComponentRefused{owner,incoming,_}:
      (owner,(T.Failure{MissingTarget{}},Output{False{},incoming}))
def body(~S:Data,~H:Type,~caps:Ops(~S)(H),args:Args<S>,owner:H) -> H & (T.Outcome<Error> & Output):
  match args:
    case Args{target,resource,capture,abort}:
      after_removal(~S,~H,~caps,resource,capture,abort,Existing.component_replace(~S,~Array<Array<U32>>,~Schema.first_identity(~S),~H,~first_cap(~S,~H,~caps),owner,target,None{}))
