"""Source-derived oracle for the deferred-after-v1 public-scopes consumer.

The model follows deferred-after-v1/main.bend, the frontend fixture renderer,
and the current transaction/allocator sources.  It is deliberately source
only: no development stdout/stderr or backend result is consulted here.
"""

from __future__ import annotations

import json
from dataclasses import dataclass, field
from pathlib import Path
from typing import Iterable


ORACLE_ROOT = Path(__file__).resolve().parent
SOURCE_ROOT = ORACLE_ROOT.parent
OPERATIONS_PATH = SOURCE_ROOT / "operations.json"


QUERY_ACCESS = ["Payload"]


def list_show(values: Iterable[str]) -> str:
    """Translate Base.List.show's source renderer."""

    return "[" + ", ".join(values) + "]"


def array_tree(values: Iterable[object], render) -> str:
    """Translate the binary Array tree renderer used by frontend-v1/fixture."""

    items = list(values)
    assert items and (len(items) & (len(items) - 1)) == 0
    if len(items) == 1:
        return f"L({render(items[0])})"
    midpoint = len(items) // 2
    return f"N({array_tree(items[:midpoint], render)},{array_tree(items[midpoint:], render)})"


def payload_text(payload: int) -> str:
    """Translate ordinary-v1/fixture Payload and show_payload."""

    first = array_tree([payload], str)
    second = array_tree([payload + 10, payload + 20], str)
    return f"P({first},{second})"


def operations() -> dict:
    """Load and pin the deferred operation contract."""

    spec = json.loads(OPERATIONS_PATH.read_text(encoding="utf-8"))
    assert spec["schema"] == "Scene"
    assert spec["creation"] == "Actual canonical WorldIO through current scoped provision"
    assert spec["sequence"] == [
        "spawn unscoped Payload2 as id1; commit/barrier; observe baseline",
        "reserve scoped Payload99 as id2, then finish transaction Failure; observe aborted world with no active membership/pending payload",
        "in same new transaction reserve scoped Payload3 as id3 THEN stage scope cleanup; commit; observe after-pending",
        "barrier executes scoped activation/population before cleanup; cleanup resolves membership at actual queue position and removes id3; observe after-cleaned",
        "canonical query reads unscoped survivor id1 Payload2 and full returned query World/registry",
    ]
    assert spec["oracle"] == "Complete current frontend fixture/Front.query_defined renderer and exact transaction allocator/cancel semantics, not assumed reset of nextId"
    assert spec["limits"] == [
        "Abort uses existing command/transaction ownership disposition, not payload recovery/finalizer claim",
        "No ID reuse/generation adoption; aborted exposed reservation remains historical allocator behavior",
        "No performance/universal proof claim",
    ]
    return spec


@dataclass
class World:
    """The World fields rendered by frontend-v1/fixture.observe."""

    namespace: int = 1
    next_id: int = 1
    high_water: int = 0
    # World.live includes the allocator's sentinel at index zero.
    live: list[bool] = field(default_factory=lambda: [False])
    capacity: int = 1
    depth: int = 0
    # Component columns are one-based by entity ID, without a live sentinel.
    values: list[int | None] = field(default_factory=lambda: [None])
    stamps: list[tuple[int, int, int]] = field(default_factory=list)
    scopes: list[int] = field(default_factory=list)
    events: list[str] = field(default_factory=list)
    pending: int = 0
    registrations: list[tuple[int, str, list[str]]] = field(default_factory=list)
    next_system: int = 1
    clock: int = 0

    def reserve_id(self) -> int:
        """Translate W.reserve_id, including persistent failed reservations."""

        if self.next_id >= self.capacity:
            self.live.extend([False] * self.capacity)
            self.capacity *= 2
            self.depth += 1
        entity_id = self.next_id
        self.high_water = entity_id
        self.next_id += 1
        return entity_id

    def register(self, name: str, access: list[str]) -> int:
        """Translate the single ordinary query registration."""

        system_id = self.next_system
        self.registrations.insert(0, (system_id, name, list(access)))
        self.next_system += 1
        return system_id

    def ensure_column(self, entity_id: int) -> None:
        """Translate Col.ensure's power-of-two growth for a one-based ID."""

        while entity_id > len(self.values):
            self.values.extend([None] * len(self.values))

    def populate(self, entity_id: int, payload: int) -> None:
        """Translate deferred spawn activation followed by Cmp.replace."""

        self.ensure_column(entity_id)
        assert 0 < entity_id < len(self.live)
        assert entity_id <= len(self.values)
        self.live[entity_id] = True
        self.values[entity_id - 1] = payload
        self.clock += 1
        self.stamps = [row for row in self.stamps if row[0] != entity_id]
        self.stamps.insert(0, (entity_id, self.clock, self.clock))

    def assign_scope(self, entity_id: int) -> None:
        """Translate Sc.assigned for the scene scope."""

        self.scopes = [value for value in self.scopes if value != entity_id]
        self.scopes.append(entity_id)

    def cleanup_entity(self, entity_id: int) -> None:
        """Translate Clear.leaf and the published cleanup notices."""

        assert self.live[entity_id]
        self.live[entity_id] = False
        self.values[entity_id - 1] = None
        self.stamps = [row for row in self.stamps if row[0] != entity_id]
        self.scopes = [value for value in self.scopes if value != entity_id]
        self.events.extend([f"removed:{entity_id}", f"original:{entity_id}"])


def bool_text(value: object) -> str:
    return "True" if bool(value) else "False"


def slot_text(value: int | None) -> str:
    return "absent" if value is None else payload_text(value)


def column_text(world: World) -> str:
    return (
        array_tree(world.values, slot_text)
        + "/stamps="
        + list_show(f"{entity}:{added}:{changed}" for entity, added, changed in world.stamps)
    )


def store_text(world: World) -> str:
    return (
        column_text(world)
        + "/graph=[]/[]"
        + "/scopes="
        + list_show(f"scene:{entity}" for entity in world.scopes)
    )


def registration_text(registration: tuple[int, str, list[str]]) -> str:
    system_id, name, access = registration
    return f"{system_id}:{name}:{list_show(access)}"


def world_text(world: World) -> str:
    live = array_tree(world.live, bool_text)
    registrations = list_show(registration_text(row) for row in world.registrations)
    events = list_show(world.events)
    return (
        f"world={world.namespace},{world.next_id},{world.high_water},{live},"
        f"{world.capacity},{world.depth}/{store_text(world)}/resource=Unit"
        f"/events={events}/pending={world.pending}/regs={registrations}"
        f"/nextSystem={world.next_system}/clock={world.clock}"
    )


def observed(label: str, world: World) -> dict[str, str]:
    """Translate deferred-after-v1/main.bend's pre-query observation."""

    return {"label": label, "world": world_text(world)}


def observed_with_owner(label: str, owner: str, world: World) -> dict[str, str]:
    """Translate frontend-v1/main.bend's final query observation."""

    return {"label": label, "world": world_text(world), "owner": owner}


def query_owner_text(namespace: int, system_id: int, cursor: int) -> str:
    return f"{namespace}:{system_id}:survivors:{list_show(QUERY_ACCESS)}:{cursor}"


def expected_document() -> dict:
    """Derive deferred-after-v1/main.bend's single printed JSON document."""

    operations()
    world = World()

    # Sc.scope only reads the fresh namespace.  The first direct transaction
    # reserves ID 1, enqueues one spawn, and the barrier applies it.
    scope_namespace = world.namespace
    assert scope_namespace == 1
    plain_id = world.reserve_id()
    assert plain_id == 1
    world.pending = 1
    world.pending = 0
    world.populate(plain_id, 2)
    snapshots = [observed("baseline", world)]
    assert (world.next_id, world.high_water, world.capacity, world.depth) == (2, 1, 2, 1)
    assert world.clock == 1

    # Spawn.tx_spawn_in reserves ID 2 before the failing finish.  Tx.finish
    # discards the command list, while the allocator mutation has no undo.
    failed_id = world.reserve_id()
    assert failed_id == 2
    snapshots.append(observed("aborted", world))
    assert (world.next_id, world.high_water, world.capacity, world.depth) == (3, 2, 4, 2)
    assert world.pending == 0

    # The next transaction reserves ID 3, then stages cleanup.  Tx.stage
    # prepends cleanup, commit reverses the command list, and W.enqueue stores
    # a reverse pending list; barrier therefore applies spawn before cleanup.
    scoped_id = world.reserve_id()
    assert scoped_id == 3
    world.pending = 2
    snapshots.append(observed("after-pending", world))
    assert (world.next_id, world.high_water) == (4, 3)
    assert world.clock == 1

    world.pending = 0
    world.populate(scoped_id, 3)
    world.assign_scope(scoped_id)
    world.cleanup_entity(scoped_id)
    snapshots.append(observed("after-cleaned", world))
    assert world.events == ["removed:3", "original:3"]
    assert world.clock == 2

    # Front.query_defined registers one system, reads the surviving Payload2,
    # and returns the complete post-query World/registry observation.
    query_id = world.register("survivors", QUERY_ACCESS)
    assert query_id == 1
    query_values = [payload_text(2)]
    query_owner = query_owner_text(world.namespace, query_id, world.clock)
    after_query = observed_with_owner("after-query", query_owner, world)
    return {"snapshots": snapshots, "query": query_values, "after-query": after_query}


def expected_bytes() -> bytes:
    """Exact bytes produced by the one IO.print call in main.bend."""

    return (json.dumps(expected_document(), ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")


if __name__ == "__main__":
    import sys

    sys.stdout.buffer.write(expected_bytes())
