"""Read-only deterministic self-test for the authority-order-v1 oracle."""

from __future__ import annotations

import gzip
import io
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parent
model_path = ROOT / "model.py.source"
namespace: dict[str, object] = {"__file__": str(model_path)}
source = model_path.read_text(encoding="utf-8")
exec(compile(source, str(model_path), "exec"), namespace)

document = namespace["expected_document"]()
payload = namespace["expected_bytes"]()
assert [row["label"] for row in document["snapshots"]] == [
    "first-world",
    "foreign-refused:P(L(99),N(L(109),L(119)))",
    "order-pending",
    "order-spawned",
    "order-cleaned",
]
assert len(document["snapshots"]) == 5
assert set(document) == {"snapshots", "query", "after-query"}
assert document["query"] == ["P(L(2),N(L(12),L(22)))"]
assert document["snapshots"][0]["world"].startswith("world=1,1,0,L(False),1,0/")
assert document["snapshots"][1]["world"].startswith("world=2,1,0,L(False),1,0/")
assert "/pending=3/regs=[]/nextSystem=1/clock=0" in document["snapshots"][2]["world"]
assert "/stamps=[2:2:2, 1:1:1]/graph=[]/[]/scopes=[scene:1]" in document["snapshots"][3]["world"]
assert "/events=[removed:1, original:1]/" in document["snapshots"][4]["world"]
assert "/regs=[]/nextSystem=1/clock=2" in document["snapshots"][4]["world"]
assert document["after-query"]["owner"] == "3:1:survivors:[Payload]:2"
assert "/regs=[1:survivors:[Payload]]/nextSystem=2/clock=2" in document["after-query"]["world"]
assert "Payload:read" not in payload.decode("utf-8")
assert json.loads(payload) == document
assert payload.endswith(b"\n")
assert (ROOT / "expected.json").read_bytes() == payload
assert (ROOT / "expected.stdout").read_bytes() == payload
assert gzip.decompress((ROOT / "expected.stdout.gz").read_bytes()) == payload

compressed = io.BytesIO()
with gzip.GzipFile(fileobj=compressed, mode="wb", filename="", mtime=0) as stream:
    stream.write(payload)
assert compressed.getvalue() == (ROOT / "expected.stdout.gz").read_bytes()

print(json.dumps({"status": "PASS", "snapshots": 5, "bytes": len(payload), "runtimeOutputConsulted": False}, separators=(",", ":")))
