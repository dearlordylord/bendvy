  "sourceAudit": {
    "namespaceOrder": "world-io.create uses the host fresh namespace allocator; three sequential creations therefore produce Scene world1 namespace 1, Scene world2 namespace 2, and Garden namespace 3 in one fresh process.",
    "firstScene": "first_scoped obtains scope(scene) from Scene namespace 1 and observes the untouched World: nextId=1, highWater=0, capacity=1, depth=0, empty store/resource/events/pending/registrations, nextSystem=1, clock=0.",
    "foreignScene": "second_created reuses the namespace-1 scope against Scene namespace 2. lifetime-scope-world-spawn rejects Payload99 with W.MissingEntity and returns the original payload; lifetime-scope cleanup rejects the same foreign scope with A.MissingEntity. Cmd.tx_finish(Success) publishes no command or event, so namespace-2 remains unchanged.",
    "gardenOrder": "Garden namespace 3 stages cleanup before scoped P1 and unscoped P2. Transaction command accumulation plus Cmd.tx_finish reversal and World.enqueue/drain_fifo cause the initial cleanup to execute first, then P1, then P2. P1 alone receives scene membership; Cmp.replace advances clock/stamps to 1 and 2.",
    "gardenCleanup": "The second cleanup sees scene:1, clears Payload ID 1, deactivates it, removes the scope member, and publishes removed:1 then original:1. ID 2 remains live with its payload and stamp; clock remains 2.",
    "query": "Front.query_defined registers the canonical survivor query on Garden as system 1 with bare [Payload] access from ordinary-system.access, reads ID 2, advances its registry cursor to world clock 2, and leaves the physical World unchanged.",
    "renderer": "authority-order-v1 uses its record/observed wrappers around the complete frontend fixture world renderer. The final document contains first-world, foreign-refused, order-pending, order-spawned, and order-cleaned snapshot objects, the survivor query value, and Front.query_defined after-query owner/world; main.bend emits one IO.print terminal LF."
  },
  "derivation": {
    "allocators": "Each World starts with a sentinel live leaf and empty Payload column. Garden reservations grow live capacity 1->2->4 and depth 0->1->2; Payload column renders two leaves indexed by entity IDs 1 and 2.",
    "commandOrder": "The staged command accumulator is [P2,P1,cleanup] before tx_finish; reversal and enqueue produce pending [P2,P1,cleanup], while drain_fifo applies cleanup, P1, P2.",
    "access": "Spawn/cleanup operations are not registered systems in this scenario. The final query registration is [Payload] because ordinary-query-declaration.read creates Clause{Identity.key(...),Read{}} and ordinary-system.access maps Clause{name,_} to name without a mode suffix.",
    "transport": "The expected stdout is compact JSON from authority-order-v1/main.bend's one IO.print call plus one terminal LF; gzip is deterministic with mtime=0."
  },
