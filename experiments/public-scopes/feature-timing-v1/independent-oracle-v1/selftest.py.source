"""Deterministic source-only self-test for the feature oracle."""

from __future__ import annotations

import gzip
import hashlib
import io
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parent
model_path = ROOT / "model.py.source"
namespace: dict[str, object] = {"__file__": str(model_path)}
source = model_path.read_text(encoding="utf-8")
exec(compile(source, str(model_path), "exec"), namespace)
namespace["verify_source_pins"]()
namespace["verify_external_source_pins"]()
namespace["verify_source_shape"]()

keys = namespace["RECORD_KEYS"]
scales = namespace["SCALES"]
schemas = namespace["SCHEMAS"]
records = namespace["records"]
expected_bytes = namespace["expected_bytes"]

expected_labels = {
    "linked-failure": [
        "pending-spawn",
        "failed-cleanup",
        "spawned",
        "pending-cleanup",
        "cleaned",
        "repeated-cleanup",
    ],
    "cleanup-before-spawn": ["pending", "spawned", "cleaned"],
    "abort-and-cleanup-after": ["seeded", "aborted", "pending", "cleaned"],
}

for scale in scales:
    output = records(scale)
    assert len(output) == 26 * scale
    assert all(list(item) == keys for item in output)
    assert output[0]["schema"] == schemas[0]
    assert output[13]["schema"] == schemas[1]
    for start in range(0, len(output), 26):
        block = output[start : start + 26]
        assert [item["schema"] for item in block[:13]] == [schemas[0]] * 13
        assert [item["schema"] for item in block[13:]] == [schemas[1]] * 13
        for schema_block in (block[:13], block[13:]):
            for case in expected_labels:
                selected = [item for item in schema_block if item["case"] == case]
                assert [item["phase"] for item in selected] == expected_labels[case]
            linked = schema_block[:6]
            assert linked[1]["status"] == "Rejected"
            assert linked[2]["rows"] == [
                {"id": entity, "payload": [entity, entity + 10, entity + 20]}
                for entity in range(1, 7)
            ]
            assert linked[2]["parent"] == [[2, 1], [4, 2]]
            assert linked[2]["children"] == [[1, 2], [2, 4]]
            assert linked[2]["link"] == [[3, 1]]
            assert linked[2]["incoming"] == [[1, 3]]
            assert linked[4]["rows"] == [
                {"id": 3, "payload": [3, 13, 23]},
                {"id": 6, "payload": [6, 16, 26]},
            ]
            assert linked[4]["removed"] == [1, 2, 4, 5]
            assert linked[4]["despawned"] == [1, 2, 4, 5]
            assert linked[5]["removed"] == []
            before = schema_block[6:9]
            assert before[0]["rows"] == []
            assert before[1]["rows"] == [
                {"id": 1, "payload": [1, 11, 21]},
                {"id": 2, "payload": [2, 12, 22]},
            ]
            assert before[2]["rows"] == [{"id": 2, "payload": [2, 12, 22]}]
            assert before[2]["removed"] == [1]
            after = schema_block[9:13]
            assert after[0]["rows"] == [{"id": 1, "payload": [2, 12, 22]}]
            assert after[1]["status"] == "Rejected"
            assert after[2]["rows"] == after[0]["rows"]
            assert after[3]["rows"] == after[0]["rows"]
            assert after[3]["removed"] == [3]

for scale in scales:
    payload = expected_bytes(scale)
    assert json.loads(payload) == records(scale)
    assert payload.endswith(b"\n")
    path = ROOT / f"expected-scale-{scale}.stdout"
    assert path.read_bytes() == payload
    assert (ROOT / f"expected-scale-{scale}.json").read_bytes() == payload
    compressed = io.BytesIO()
    with gzip.GzipFile(fileobj=compressed, mode="wb", filename="", mtime=0) as stream:
        stream.write(payload)
    assert compressed.getvalue() == (ROOT / f"expected-scale-{scale}.stdout.gz").read_bytes()

assert (ROOT / "expected.json").read_bytes() == expected_bytes(1)
assert (ROOT / "expected.stdout").read_bytes() == expected_bytes(1)
assert gzip.decompress((ROOT / "expected.stdout.gz").read_bytes()) == expected_bytes(1)

hashes = json.loads((ROOT / "GENERATED-HASHES.json").read_text(encoding="utf-8"))
for name, expected in hashes.items():
    assert hashlib.sha256((ROOT / name).read_bytes()).hexdigest() == expected, name

print(
    json.dumps(
        {
            "status": "PASS",
            "scales": scales,
            "records": {str(scale): 26 * scale for scale in scales},
            "runtimeOutputConsulted": False,
        },
        separators=(",", ":"),
    )
)
