"""Deterministically regenerate all scale-specific feature oracle artifacts."""

from __future__ import annotations

import gzip
import hashlib
import io
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parent
model_path = ROOT / "model.py.source"
namespace: dict[str, object] = {"__file__": str(model_path)}
source = model_path.read_text(encoding="utf-8")
exec(compile(source, str(model_path), "exec"), namespace)
namespace["verify_source_pins"]()
namespace["verify_external_source_pins"]()
namespace["verify_source_shape"]()

scales = namespace["SCALES"]
all_records = namespace["all_records"]()
document = namespace["expected_document"]()


def write_gzip(path: Path, payload: bytes) -> None:
    compressed = io.BytesIO()
    with gzip.GzipFile(fileobj=compressed, mode="wb", filename="", mtime=0) as stream:
        stream.write(payload)
    path.write_bytes(compressed.getvalue())


for scale in scales:
    payload = (
        json.dumps(all_records[str(scale)], ensure_ascii=False, separators=(",", ":")) + "\n"
    ).encode("utf-8")
    (ROOT / f"expected-scale-{scale}.json").write_bytes(payload)
    (ROOT / f"expected-scale-{scale}.stdout").write_bytes(payload)
    write_gzip(ROOT / f"expected-scale-{scale}.stdout.gz", payload)

# Keep the conventional expected.* names bound to the smallest complete run;
# scale-specific plans use the explicit expected-scale-N files above.
default = (ROOT / "expected-scale-1.stdout").read_bytes()
(ROOT / "expected.json").write_bytes(default)
(ROOT / "expected.stdout").write_bytes(default)
write_gzip(ROOT / "expected.stdout.gz", default)
(ROOT / "expected-scales.json").write_text(
    json.dumps(document, ensure_ascii=False, separators=(",", ":")) + "\n",
    encoding="utf-8",
)

artifact_hashes: dict[str, str] = {}
for path in sorted(ROOT.iterdir()):
    if path.is_file() and path.name not in {
        "SOURCE-BASIS.json",
        "SELFTEST.json",
        "GENERATED-HASHES.json",
    }:
        artifact_hashes[path.name] = hashlib.sha256(path.read_bytes()).hexdigest()
(ROOT / "GENERATED-HASHES.json").write_text(
    json.dumps(artifact_hashes, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
)
