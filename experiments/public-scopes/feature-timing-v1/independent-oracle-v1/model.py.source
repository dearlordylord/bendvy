"""Independent source-derived oracle for the #45 feature timing consumer.

This model follows the frozen Bend renderer and the pinned TypeScript
reference.  It never reads a backend output.  The transport is the normalized
JSON observation contract: records retain the source key order and are
encoded compactly with one terminal newline.
"""

from __future__ import annotations

import json
from pathlib import Path
from typing import Any


ORACLE_ROOT = Path(__file__).resolve().parent
SOURCE_ROOT = ORACLE_ROOT.parent
WT_ROOT = SOURCE_ROOT.parents[2]
BASIS_PATH = ORACLE_ROOT / "SOURCE-BASIS.json"
OPERATIONS_PATH = SOURCE_ROOT / "OPERATIONS.json"

RECORD_KEYS = [
    "repeat",
    "schema",
    "case",
    "phase",
    "status",
    "rows",
    "parent",
    "children",
    "link",
    "incoming",
    "removed",
    "despawned",
]
SCHEMAS = ["ScopeTimingAlpha", "ScopeTimingBeta"]
SCALES = [1, 2, 4]


def operations() -> dict[str, Any]:
    """Load and constrain the source-frozen operation contract."""

    spec = json.loads(OPERATIONS_PATH.read_text(encoding="utf-8"))
    assert spec["status"] == "SOURCE_ADAPTER_IN_PROGRESS_NOT_EXECUTED"
    assert spec["scales"] == SCALES
    assert spec["schemas"] == SCHEMAS
    entities = spec["entities"]
    assert entities["scoped"] == [1, 5]
    assert entities["unscoped"] == [2, 3, 4, 6]
    assert entities["payload"] == "[id,id+10,id+20]"
    assert entities["parent"] == [[2, 1], [4, 2]]
    assert entities["link"] == [[3, 1]]
    assert spec["phases"] == [
        "pending-spawn",
        "failed-cleanup",
        "spawned",
        "pending-cleanup",
        "cleaned",
        "repeated-cleanup",
    ]
    assert spec["sharedOutput"]["recordKeys"] == RECORD_KEYS
    return spec


def source_pins() -> dict[str, str]:
    basis = json.loads(BASIS_PATH.read_text(encoding="utf-8"))
    return {
        **basis["sourcePins"]["entrypoints"],
        **basis["sourcePins"]["bendClosure"],
    }


def verify_source_pins() -> None:
    """Ensure regeneration still targets the frozen source closure."""

    for relative, expected in source_pins().items():
        actual_path = WT_ROOT / relative
        assert actual_path.is_file(), actual_path
        import hashlib

        actual = hashlib.sha256(actual_path.read_bytes()).hexdigest()
        assert actual == expected, (relative, expected, actual)


def verify_external_source_pins() -> None:
    """Verify the pinned Base and Bevy-TS files used by the source oracle."""

    basis = json.loads(BASIS_PATH.read_text(encoding="utf-8"))
    import hashlib

    for path_text, expected in basis["sourcePins"]["externalClosure"].items():
        path = Path(path_text)
        assert path.is_file(), path
        actual = hashlib.sha256(path.read_bytes()).hexdigest()
        assert actual == expected, (path_text, expected, actual)


def verify_source_shape() -> None:
    """Check source facts that affect the normalized trace."""

    main = (SOURCE_ROOT / "main.bend").read_text(encoding="utf-8")
    observer = (SOURCE_ROOT / "observer.bend").read_text(encoding="utf-8")
    reference = (SOURCE_ROOT / "reference.mjs").read_text(encoding="utf-8")
    assert main.count("Sc.scope(~S") >= 2  # repaired dual-token setup
    assert "ScopeTokens{first:Sc.Scope<S>,same:Sc.Scope<S>}" in main
    assert "linked1(~S,same,scoped(~S,begin(~S,world),scope,1))" in main
    assert "case (tx,h4):linked5(~S,h1,h2,h3,h4,scoped(~S,tx,scope,5))" in main
    assert "Cleanup{failed:Bool}" in main
    assert '\\"rows\\":' in observer and '\\"removed\\":' in observer
    assert '\\"despawned\\":' in observer
    # The current renderer has explicit compact list joins at the source
    # boundary; the oracle follows that source operation rather than
    # normalizing a spaced Base.List.show result.
    assert "def compact_tail(" in observer
    assert "def compact(" in observer
    assert '"," ++ show(item)' in observer
    assert "O.compact(~String,~text => text,texts)" in main
    assert "return JSON.stringify(output);" in reference
    assert "commands.spawnIn(scene" in reference
    assert "commands.spawnIn(same" in reference


def payload(entity: int) -> list[int]:
    return [entity, entity + 10, entity + 20]


def rows(ids: list[int]) -> list[dict[str, Any]]:
    return [{"id": entity, "payload": payload(entity)} for entity in sorted(ids)]


def graph(
    parent: list[list[int]] | None = None,
    children: list[list[int]] | None = None,
    link: list[list[int]] | None = None,
    incoming: list[list[int]] | None = None,
) -> dict[str, list[list[int]]]:
    """Return the source observer's complete, lexicographically sorted graph."""

    def ordered(value: list[list[int]] | None) -> list[list[int]]:
        return sorted(value or [])

    return {
        "parent": ordered(parent),
        "children": ordered(children),
        "link": ordered(link),
        "incoming": ordered(incoming),
    }


def record(
    repeat: int,
    schema: str,
    case: str,
    phase: str,
    status: str,
    live: list[int],
    *,
    edges: dict[str, list[list[int]]] | None = None,
    payloads: dict[int, list[int]] | None = None,
    removed: list[int] | None = None,
    despawned: list[int] | None = None,
) -> dict[str, Any]:
    edge = edges or graph()
    row_values = payloads or {}
    # Dict insertion order is the accepted common observation order.
    return {
        "repeat": repeat,
        "schema": schema,
        "case": case,
        "phase": phase,
        "status": status,
        "rows": [
            {"id": entity, "payload": list(row_values.get(entity, payload(entity)))}
            for entity in sorted(live)
        ],
        "parent": edge["parent"],
        "children": edge["children"],
        "link": edge["link"],
        "incoming": edge["incoming"],
        "removed": sorted(removed or []),
        "despawned": sorted(despawned or []),
    }


def linked_records(repeat: int, schema: str) -> list[dict[str, Any]]:
    linked_graph = graph(
        parent=[[2, 1], [4, 2]],
        children=[[1, 2], [2, 4]],
        link=[[3, 1]],
        incoming=[[1, 3]],
    )
    return [
        record(repeat, schema, "linked-failure", "pending-spawn", "ok", []),
        record(repeat, schema, "linked-failure", "failed-cleanup", "Rejected", []),
        record(
            repeat,
            schema,
            "linked-failure",
            "spawned",
            "ok",
            [1, 2, 3, 4, 5, 6],
            edges=linked_graph,
        ),
        record(
            repeat,
            schema,
            "linked-failure",
            "pending-cleanup",
            "ok",
            [1, 2, 3, 4, 5, 6],
            edges=linked_graph,
        ),
        record(
            repeat,
            schema,
            "linked-failure",
            "cleaned",
            "ok",
            [3, 6],
            removed=[1, 2, 4, 5],
            despawned=[1, 2, 4, 5],
        ),
        record(
            repeat,
            schema,
            "linked-failure",
            "repeated-cleanup",
            "ok",
            [3, 6],
        ),
    ]


def before_records(repeat: int, schema: str) -> list[dict[str, Any]]:
    return [
        record(repeat, schema, "cleanup-before-spawn", "pending", "ok", []),
        record(repeat, schema, "cleanup-before-spawn", "spawned", "ok", [1, 2]),
        record(
            repeat,
            schema,
            "cleanup-before-spawn",
            "cleaned",
            "ok",
            [2],
            removed=[1],
            despawned=[1],
        ),
    ]


def after_records(repeat: int, schema: str) -> list[dict[str, Any]]:
    seeded_payload = {1: payload(2)}
    return [
        record(
            repeat,
            schema,
            "abort-and-cleanup-after",
            "seeded",
            "ok",
            [1],
            payloads=seeded_payload,
        ),
        record(
            repeat,
            schema,
            "abort-and-cleanup-after",
            "aborted",
            "Rejected",
            [1],
            payloads=seeded_payload,
        ),
        record(
            repeat,
            schema,
            "abort-and-cleanup-after",
            "pending",
            "ok",
            [1],
            payloads=seeded_payload,
        ),
        record(
            repeat,
            schema,
            "abort-and-cleanup-after",
            "cleaned",
            "ok",
            [1],
            payloads=seeded_payload,
            removed=[3],
            despawned=[3],
        ),
    ]


def records(scale: int) -> list[dict[str, Any]]:
    assert scale in SCALES
    output: list[dict[str, Any]] = []
    for repeat in range(scale):
        for schema in SCHEMAS:
            output.extend(linked_records(repeat, schema))
            output.extend(before_records(repeat, schema))
            output.extend(after_records(repeat, schema))
    assert len(output) == 26 * scale
    return output


def all_records() -> dict[str, list[dict[str, Any]]]:
    return {str(scale): records(scale) for scale in SCALES}


def expected_bytes(scale: int = 1) -> bytes:
    """Compact canonical JSON and the single IO.print terminal newline."""

    return (
        json.dumps(records(scale), ensure_ascii=False, separators=(",", ":")) + "\n"
    ).encode("utf-8")


def expected_document() -> dict[str, Any]:
    """The scale-indexed oracle document used by the multi-scale plan."""

    return {
        "recordKeys": RECORD_KEYS,
        "scales": all_records(),
    }


if __name__ == "__main__":
    verify_source_pins()
    verify_external_source_pins()
    verify_source_shape()
    import sys

    scale = int(sys.argv[1]) if len(sys.argv) > 1 else 1
    sys.stdout.buffer.write(expected_bytes(scale))
