"""Read-only deterministic self-test for the source-matched oracle."""

from __future__ import annotations

import gzip
import json
import io
from pathlib import Path


ROOT = Path(__file__).resolve().parent
model_path = ROOT / "model.py.source"
namespace: dict[str, object] = {"__file__": str(model_path)}
source = model_path.read_text(encoding="utf-8")
exec(compile(source, str(model_path), "exec"), namespace)

rows = namespace["expected_rows"]()
payload = namespace["expected_bytes"]()
assert [row["label"] for row in rows] == [
    "pending-spawn",
    "spawned",
    "pending-clean",
    "cleaned",
    "repeated-clean",
]
assert len(rows) == 5
assert all(set(row) == {"label", "world"} for row in rows)
assert rows[0]["world"].startswith("world=1,7,6,N(")
assert "/removed=/graph=[]/[]/scopes=[]/resource=N(L(77),L(88))" in rows[0]["world"]
assert "/pending=9/regs=[]/nextSystem=1/clock=0" in rows[0]["world"]
assert "/scopes=[scene:1, scene:5]" in rows[1]["world"]
assert "/pending=1/" in rows[2]["world"]
assert "P(L(5),N(L(15),L(25)));P(L(1),N(L(11),L(21)));P(L(2),N(L(12),L(22)));P(L(4),N(L(14),L(24)));" in rows[3]["world"]
assert "events=[removed:4, original:4, removed:2, original:2, removed:1, original:1, removed:5, original:5]" in rows[3]["world"]
assert rows[3]["world"] == rows[4]["world"]

assert json.loads(payload) == rows
assert payload.endswith(b"\n")
assert (ROOT / "expected.json").read_bytes() == payload
assert (ROOT / "expected.stdout").read_bytes() == payload
assert gzip.decompress((ROOT / "expected.stdout.gz").read_bytes()) == payload

compressed = io.BytesIO()
with gzip.GzipFile(fileobj=compressed, mode="wb", filename="", mtime=0) as stream:
    stream.write(payload)
assert compressed.getvalue() == (ROOT / "expected.stdout.gz").read_bytes()

print(json.dumps({"status": "PASS", "rows": len(rows), "bytes": len(payload), "runtimeOutputConsulted": False}, separators=(",", ":")))
