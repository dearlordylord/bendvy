"""Read-only deterministic self-test for the reached survivor counter oracle."""

from __future__ import annotations

import gzip
import io
import json
from pathlib import Path


ROOT = Path(__file__).resolve().parent
model_path = ROOT / "model.py.source"
namespace: dict[str, object] = {"__file__": str(model_path)}
source = model_path.read_text(encoding="utf-8")
exec(compile(source, str(model_path), "exec"), namespace)

document = namespace["expected_document"]()
payload = namespace["expected_bytes"]()
assert [row["label"] for row in document["snapshots"]] == [
    "pending-spawn",
    "spawned",
    "failed-cleanup",
    "pending-cleanup",
    "cleaned",
]
assert len(document["snapshots"]) == 5
assert set(document) == {"snapshots", "query", "after-query"}
assert document["query"] == []
assert document["snapshots"][0]["world"].startswith("world=1,3,2,N(")
assert "/pending=2/regs=[1:spawn:[Payload:write, LifetimeScope:write]]/nextSystem=2/clock=0" in document["snapshots"][0]["world"]
assert "/scopes=[scene:1]" in document["snapshots"][1]["world"]
assert "/stamps=[2:2:2, 1:1:1]" in document["snapshots"][1]["world"]
assert ":cleanup:[Payload:write, LifetimeScope:write]:0" in document["snapshots"][2]["owner"]
assert "/pending=1/" in document["snapshots"][3]["world"]
assert document["snapshots"][3]["owner"].endswith(":2")
assert "/events=[removed:1, original:1, removed:2, original:2]/" in document["snapshots"][4]["world"]
assert "/stamps=[]/" in document["snapshots"][4]["world"]
assert "/scopes=[]/resource=Unit" in document["snapshots"][4]["world"]
assert document["after-query"]["owner"] == "1:3:survivors:[Payload]:2"
assert "/regs=[3:survivors:[Payload], 2:cleanup:[Payload:write, LifetimeScope:write], 1:spawn:[Payload:write, LifetimeScope:write]]/" in document["after-query"]["world"]
assert json.loads(payload) == document
assert payload.endswith(b"\n")
assert (ROOT / "expected.json").read_bytes() == payload
assert (ROOT / "expected.stdout").read_bytes() == payload
assert gzip.decompress((ROOT / "expected.stdout.gz").read_bytes()) == payload

compressed = io.BytesIO()
with gzip.GzipFile(fileobj=compressed, mode="wb", filename="", mtime=0) as stream:
    stream.write(payload)
assert compressed.getvalue() == (ROOT / "expected.stdout.gz").read_bytes()

print(json.dumps({"status": "PASS", "snapshots": 5, "bytes": len(payload), "runtimeOutputConsulted": False}, separators=(",", ":")))
