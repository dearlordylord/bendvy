from pathlib import Path
import gzip,hashlib,json
B=Path(__file__).resolve().parent
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
O=B/'js01';p=json.loads((O/'plan.json').read_text());r=json.loads((O/'receipt.json').read_text());ph=sha(O/'plan.json')
assert r['planSHA256']==ph and r['status']=='INCOMPLETE'
assert [c['label'] for c in p['commands']]==[c['label'] for c in r['commands']]==['emit','consumer']
assert [c['capSeconds'] for c in p['commands']]==[30,5]
assert p['generated']==str(O/'scope.js') and p['entrypoint'] in p['commands'][0]['argv']
assert p['commands'][0]['argv'][-2:]==['-o',p['generated']]
assert p['commands'][1]['argv']==[p['tools']['taskset'],'-c','3',p['tools']['node'],p['generated']]
for name,h in p['pins'].items():assert sha(Path(name))==h,name
assert sorted(p['sourceInventory'])==p['importClosure']
for name,h in p['sourceInventory'].items():assert p['pins'][name]==h==sha(Path(name))
states=dict(p['pins']);states[str(O/'plan.json')]=ph;guards=[]
for c,w in zip(r['commands'],p['commands']):
 assert c['argv']==w['argv'] and c['capSeconds']==w['capSeconds'] and c['exit']==0 and c['failure'] is None
 for phase in ('pre','acquired'):guards.append((c['label']+'-'+phase,dict(states)))
 for stream in ('stdout','stderr'):
  path=O/(c['label']+'.'+stream);m=c[stream]
  assert m['path']==str(path) and m['published'] is True and m['sha256']==sha(path) and m['bytes']==path.stat().st_size
  states[str(path)]=sha(path)
 assert (O/(c['label']+'.stderr')).read_bytes()==b''
 if c['label']=='emit':states[p['generated']]=sha(Path(p['generated']));assert states[p['generated']]==r['emitArtifactSHA256']
 guards.append((c['label']+'-post',dict(states)))
guards.append(('final',states));assert len(r['guards'])==len(guards)==7
for g,(label,state) in zip(r['guards'],guards):
 path=O/(label+'.guard.json');assert g['path']==str(path) and g['sha256']==sha(path)
 raw=json.loads(path.read_text());assert raw['label']==label and raw['unchanged'] is True and raw['actualPins']==state
basis=json.loads((B/'oracle-v2/SOURCE-BASIS.json').read_text());W=B.parents[2]
for rel,h in basis['sourceClosure']['sha256ByPath'].items():assert sha(W/rel)==h
expected=gzip.decompress((B/'oracle-v2/expected.stdout.gz').read_bytes())
assert expected==(B/'oracle-v2/expected.stdout').read_bytes()==(O/'consumer.stdout').read_bytes()
print(json.dumps({'status':'PASS_RETAINED_FRONTEND_JS_NOT_FRESH_RUN','originalReceiptStatus':r['status'],'originalReceiptSHA256':sha(O/'receipt.json'),'originalPlanSHA256':ph,'oracleSHA256':hashlib.sha256(expected).hexdigest(),'bytes':len(expected),'guards':7,'sourceFiles':len(p['sourceInventory']),'freshRun':False}))
