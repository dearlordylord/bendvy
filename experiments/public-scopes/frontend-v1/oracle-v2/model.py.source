"""Source-derived oracle-v2 for the current public-scopes frontend consumer.

This model translates the frozen frontend source and the reached ECS
operations.  It does not read frontend development output or execute a Bend
backend.  The frontend-v1/oracle predecessor is preserved separately;
this model follows frontend-v1/main.bend and frontend-v1/fixture.bend exactly.
"""

from __future__ import annotations

import json
from dataclasses import dataclass, field
from pathlib import Path
from typing import Iterable


ORACLE_ROOT = Path(__file__).resolve().parent
SOURCE_ROOT = ORACLE_ROOT.parent
OPERATIONS_PATH = SOURCE_ROOT / "operations.json"


PAYLOAD_ACCESS = ["Payload:write", "LifetimeScope:write"]
QUERY_ACCESS = ["Payload"]


def list_show(values: Iterable[str]) -> str:
    """Translate Base.List.show's source renderer."""

    return "[" + ", ".join(values) + "]"


def array_tree(values: Iterable[object], render) -> str:
    """Translate the fixture's binary Array tree renderer."""

    items = list(values)
    assert items and (len(items) & (len(items) - 1)) == 0
    if len(items) == 1:
        return f"L({render(items[0])})"
    midpoint = len(items) // 2
    return f"N({array_tree(items[:midpoint], render)},{array_tree(items[midpoint:], render)})"


def payload_text(entity_id: int) -> str:
    """Translate Values.payload and Values.show_payload for one entity."""

    first = array_tree([entity_id], str)
    second = array_tree([entity_id + 10, entity_id + 20], str)
    return f"P({first},{second})"


def operations() -> dict:
    """Load and check the source operation contract."""

    spec = json.loads(OPERATIONS_PATH.read_text(encoding="utf-8"))
    assert spec["schema"] == "Scene"
    assert spec["worldCreation"] == "canonical WorldIO via adapted canonical schema provision"
    assert spec["sequence"] == [
        "register scoped spawn P1; commit",
        "enqueue unscoped P2 using canonical World-facing Cmp.replace population; commit",
        "observe pending-spawn",
        "barrier; observe spawned",
        "register cleanup; execute failure; observe actual failed World and retained registry cursor",
        "barrier; retry same cleanup registry success; observe pending-cleanup",
        "barrier; observe cleaned",
        "register canonical component survivor query; execute; observe values plus full returned World and registry",
    ]
    assert spec["boundaries"] == [
        "spawn registry owner not retained; no disposal/unregister claim",
        "cleanup failure output is Data QueueStatus; no failed arbitrary-Out recovery claim",
        "canonical Clear disposition not IO/RustDrop",
        "one schema/one actual IO-created world; second schema/foreign/order/mutant/type gates remain",
    ]
    return spec


@dataclass
class World:
    """Only the source-visible World fields used by fixture.observe."""

    namespace: int = 1
    next_id: int = 1
    high_water: int = 0
    live: list[bool] = field(default_factory=lambda: [False])
    capacity: int = 1
    depth: int = 0
    values: list[int | None] = field(default_factory=lambda: [None])
    stamps: list[tuple[int, int, int]] = field(default_factory=list)
    scopes: list[int] = field(default_factory=list)
    events: list[str] = field(default_factory=list)
    pending: int = 0
    registrations: list[tuple[int, str, list[str]]] = field(default_factory=list)
    next_system: int = 1
    clock: int = 0

    def reserve_id(self) -> int:
        """Translate World.reserve_id/grow_live, retaining the sentinel leaf."""

        if self.next_id >= self.capacity:
            self.live.extend([False] * self.capacity)
            self.capacity *= 2
            self.depth += 1
        entity_id = self.next_id
        self.high_water = entity_id
        self.next_id += 1
        return entity_id

    def register(self, name: str, access: list[str]) -> int:
        """Translate World.register and System.register's prepended metadata."""

        system_id = self.next_system
        self.registrations.insert(0, (system_id, name, list(access)))
        self.next_system += 1
        return system_id

    def ensure_column(self, entity_id: int) -> None:
        if entity_id > len(self.values):
            self.values.extend([None] * (len(self.values)))

    def populate(self, entity_id: int, payload: int) -> None:
        """Translate Cmp.replace used by both deferred spawn commands.

        Cmp.replace advances World.clock and stamps a newly-present value at
        the resulting tick; reservation and activation themselves do not.
        """

        self.ensure_column(entity_id)
        assert entity_id <= len(self.values)
        self.live[entity_id] = True
        self.values[entity_id - 1] = payload
        self.clock += 1
        self.stamps = [
            row for row in self.stamps if row[0] != entity_id
        ]
        self.stamps.insert(0, (entity_id, self.clock, self.clock))

    def assign_scope(self, entity_id: int) -> None:
        self.scopes = [value for value in self.scopes if value != entity_id]
        self.scopes.append(entity_id)

    def cleanup_entity(self, entity_id: int) -> None:
        """Translate Clear.leaf plus relation-cleanup finalization."""

        assert self.live[entity_id]
        self.live[entity_id] = False
        self.values[entity_id - 1] = None
        self.stamps = [row for row in self.stamps if row[0] != entity_id]
        self.scopes = [value for value in self.scopes if value != entity_id]
        self.events.extend([f"removed:{entity_id}", f"original:{entity_id}"])


def bool_text(value: object) -> str:
    return "True" if bool(value) else "False"


def slot_text(value: int | None) -> str:
    return "absent" if value is None else payload_text(value)


def column_text(world: World) -> str:
    return (
        array_tree(world.values, slot_text)
        + "/stamps="
        + list_show(f"{entity}:{added}:{changed}" for entity, added, changed in world.stamps)
    )


def store_text(world: World) -> str:
    return (
        column_text(world)
        + "/graph=[]/[]"
        + "/scopes="
        + list_show(f"scene:{entity}" for entity in world.scopes)
    )


def registration_text(registration: tuple[int, str, list[str]]) -> str:
    system_id, name, access = registration
    return f"{system_id}:{name}:{list_show(access)}"


def world_text(world: World) -> str:
    live = array_tree(world.live, bool_text)
    registrations = list_show(registration_text(row) for row in world.registrations)
    events = list_show(world.events)
    return (
        f"world={world.namespace},{world.next_id},{world.high_water},{live},"
        f"{world.capacity},{world.depth}/{store_text(world)}/resource=Unit"
        f"/events={events}/pending={world.pending}/regs={registrations}"
        f"/nextSystem={world.next_system}/clock={world.clock}"
    )


def observed(label: str, owner: str, world: World) -> dict[str, str]:
    """Translate frontend-v1/main.bend's observed JSON object."""

    return {"label": label, "world": world_text(world), "owner": owner}


def owner_text(namespace: int, system_id: int, name: str, cursor: int) -> str:
    return f"{namespace}:{system_id}:{name}:{list_show(PAYLOAD_ACCESS)}:{cursor}"


def query_owner_text(namespace: int, system_id: int, cursor: int) -> str:
    return f"{namespace}:{system_id}:survivors:{list_show(QUERY_ACCESS)}:{cursor}"


def expected_document() -> dict:
    """Derive the one IO.print document through the source operation order."""

    operations()
    world = World()

    # WorldIO.fresh returns namespace 1 for the first fresh process. The first
    # registration reserves no entity and does not advance the clock.
    spawn_id = world.register("spawn", PAYLOAD_ACCESS)
    assert spawn_id == 1
    scope_entity = world.reserve_id()
    world.pending += 1  # registered scoped P1: commit enqueues one command
    plain_entity = world.reserve_id()
    world.pending += 1  # direct World-facing P2: commit enqueues one command

    snapshots = [
        observed("pending-spawn", "spawn-owner-not-retained", world)
    ]
    assert (world.next_id, world.high_water, world.capacity, world.depth) == (3, 2, 4, 2)
    assert world.clock == 0

    # W.barrier drains the two commits FIFO. Each F.populate_world call uses
    # Cmp.replace: payload1 ticks 1, payload2 ticks 2.
    world.pending = 0
    world.populate(scope_entity, 1)
    world.assign_scope(scope_entity)
    world.populate(plain_entity, 2)
    snapshots.append(observed("spawned", "spawn-owner-not-retained", world))
    assert world.stamps == [(2, 2, 2), (1, 1, 1)]

    cleanup_id = world.register("cleanup", PAYLOAD_ACCESS)
    assert cleanup_id == 2
    cleanup_owner_failed = owner_text(world.namespace, cleanup_id, "cleanup", 0)

    # The first cleanup body queues a command and then returns Failure. Tx.finish
    # discards the queued command, so this snapshot is unchanged except for the
    # cleanup registration; the failed Registry cursor remains zero.
    snapshots.append(observed("failed-cleanup", cleanup_owner_failed, world))

    # The retry runs successfully at clock 2. Its Registry cursor therefore
    # advances to 2, while the cleanup command remains deferred until barrier.
    world.pending = 1
    cleanup_owner = owner_text(world.namespace, cleanup_id, "cleanup", world.clock)
    snapshots.append(observed("pending-cleanup", cleanup_owner, world))

    world.pending = 0
    world.cleanup_entity(scope_entity)
    snapshots.append(observed("cleaned", cleanup_owner, world))
    assert world.events == ["removed:1", "original:1"]

    query_id = world.register("survivors", QUERY_ACCESS)
    assert query_id == 3
    query_values = [payload_text(plain_entity)]
    query_owner = query_owner_text(world.namespace, query_id, world.clock)
    after_query = observed("after-query", query_owner, world)

    return {
        "snapshots": snapshots,
        "query": query_values,
        "after-query": after_query,
    }


def expected_bytes() -> bytes:
    """Exact bytes produced by frontend-v1/main.bend's one IO.print call."""

    return (json.dumps(expected_document(), ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")


if __name__ == "__main__":
    import sys

    sys.stdout.buffer.write(expected_bytes())
