"""Independent current-32 source countermodel for exact late-invalid fallback.

This derives public rows from the pinned source model and current complete
formatter. It never reads JS/Native execution stdout. The sole semantic change
models decode-construction.checked building from [] for exactly the pinned
$[127]/integer/late-invalid rejection; every other refusal follows source.
"""
from pathlib import Path
import copy, gzip, hashlib, json, runpy, struct

REPO = Path('/workspace/formal-proofs/bendvy')
WT = Path('/workspace/formal-proofs/bendvy-worktrees/decode46-native-resume-v1')
ALIGNED = REPO / 'experiments/public-decode/public-seam-v1/construction-v1/qualification-v1/application32-v1/timing-alignment-v1'
SUBJECT = WT / 'experiments/public-decode/public-seam-v1/construction-v1/qualification-v1/application32-v1/timing-alignment-v1/native-resume-v1'
CHILD = SUBJECT / 'reached-late-invalid-fallback-v1'
SOURCE = CHILD / 'source'
PLAN_PATH = SUBJECT / 'current-source-plan-v1/plan.json'
FULL_MODEL_PATH = Path('/workspace/formal-proofs/bendvy-worktrees/ordinary-schedule-debug-v1/experiments/public-decode/public-seam-v1/construction-v1/qualification-v1/application32-v1/timing-alignment-v1/native-resume-v1/independent-oracle-v1/full-format-v2/model.py.source')
NORMAL_ARCHIVE = Path('/workspace/formal-proofs/bendvy-worktrees/ordinary-schedule-debug-v1/experiments/public-decode/public-seam-v1/construction-v1/qualification-v1/application32-v1/timing-alignment-v1/native-resume-v1/independent-oracle-v1/full-format-v2/normal.stdout.gz')
TIMING_MODEL = ALIGNED / 'oracle-v1/expected.py'


def sha(data):
    return hashlib.sha256(data).hexdigest()

def digest(path):
    return sha(Path(path).read_bytes())
def canonical_bytes(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False) + '\n').encode()
def gzip_bytes(value):
    return gzip.compress(value, mtime=0)

# Pin the normal source closure before deriving any bytes.
plan_bytes = PLAN_PATH.read_bytes()
plan = json.loads(plan_bytes)
source_checks = {p: digest(p) for p in sorted(plan['sourceInventory'])}
assert source_checks == plan['sourceInventory'], 'current 50-source inventory drift'
assert digest(TIMING_MODEL) == '292135ac8679d121dd17451c08381135d383691f85b44a1f6c56c1e3c9d039df'
assert digest(FULL_MODEL_PATH) == '3761db7da2688f9e4e84fa075cd0623a71cfe743bbce1db6627fbd1526fa0b35'

# Verify every copied Bend file against current source after only the declared
# import rebindings and one checked-branch mutation.
CORE = REPO / 'src/ecs'
def rebind_core_imports(body, modules):
    for module in modules:
        body = body.replace(f'import {module}.bend as ', f'import {CORE}/{module}.bend as ')
    return body

orig_core = (CORE / 'decode-construction.bend').read_text()
expected_core = rebind_core_imports(orig_core, ['ordinary-declaration', 'persistence-declaration', 'decode-data', 'decode', 'bundle-construction', 'capabilities'])
old_branch = '''    case D.Receipt{owner,D.Rejected{error}}:Build.Invalid{owner,error}
    case D.Receipt{owner,D.Accepted{canonical}}:build(owner,canonical)'''
new_branch = '''    case D.Receipt{owner,D.Rejected{D.Invalid{"$[127]","integer",D.Text{"late-invalid"}}}}:build(owner,D.Array{[]})
    case D.Receipt{owner,D.Rejected{error}}:Build.Invalid{owner,error}
    case D.Receipt{owner,D.Accepted{canonical}}:build(owner,canonical)'''
assert expected_core.count(old_branch) == 1
expected_core = expected_core.replace(old_branch, new_branch, 1)
assert (SOURCE / 'decode-construction-mutant.bend').read_text() == expected_core

orig_constructed = (CORE / 'decode-constructed-requests.bend').read_text()
expected_constructed = rebind_core_imports(orig_constructed, ['decode-construction', 'ordinary-declaration', 'decode-data', 'bundle-construction', 'decode-requests', 'bundle-requests', 'world', 'capabilities'])
expected_constructed = expected_constructed.replace(f'import {CORE}/decode-construction.bend as Constructor', 'import ./decode-construction-mutant.bend as Constructor')
assert (SOURCE / 'decode-constructed-requests-mutant.bend').read_text() == expected_constructed

orig_resource_wrapper = (CORE / 'decode-constructed-resource.bend').read_text()
expected_resource_wrapper = rebind_core_imports(orig_resource_wrapper, ['decode-construction', 'decode-validated-resource', 'ordinary-declaration', 'decode-data', 'bundle-construction', 'capabilities'])
expected_resource_wrapper = expected_resource_wrapper.replace(f'import {CORE}/decode-construction.bend as Constructor', 'import ./decode-construction-mutant.bend as Constructor')
assert (SOURCE / 'decode-constructed-resource-mutant.bend').read_text() == expected_resource_wrapper

orig_app = (ALIGNED / 'application.bend').read_text()
expected_app = orig_app.replace('import ./owner.bend as Input', f'import {ALIGNED}/owner.bend as Input')
expected_app = expected_app.replace(f'import {CORE}/decode-construction.bend as Constructor', 'import ./decode-construction-mutant.bend as Constructor')
expected_app = expected_app.replace(f'import {CORE}/decode-constructed-requests.bend as Constructed', 'import ./decode-constructed-requests-mutant.bend as Constructed')
expected_app = expected_app.replace(f'import {CORE}/decode-constructed-resource.bend as ResourceConstruction', 'import ./decode-constructed-resource-mutant.bend as ResourceConstruction')
assert (SOURCE / 'application.bend').read_text() == expected_app

orig_main = (ALIGNED / 'main.bend').read_text()
expected_main = orig_main.replace('import ./owner.bend as Owner', f'import {ALIGNED}/owner.bend as Owner').replace('import ./cases.bend as Cases', f'import {ALIGNED}/cases.bend as Cases')
assert (SOURCE / 'main.bend').read_text() == expected_main

orig_observation = (ALIGNED / 'observation-main.bend').read_text()
expected_observation = orig_observation
for module in ('public', 'full-format', 'serialize'):
    expected_observation = expected_observation.replace(f'import {ALIGNED}/{module}.bend as ', f'import ./{module}.bend as ')
expected_observation = expected_observation.replace('import ./owner.bend as Owner', f'import {ALIGNED}/owner.bend as Owner')
assert (SOURCE / 'observation-main.bend').read_text() == expected_observation

# The current consumer's copied application is a nominal module. Rebind its
# public view and both formatters as one closure so every Report/Whole type is
# the same private application type observed by main.bend.
orig_public = (ALIGNED / 'public.bend').read_text()
expected_public = orig_public.replace('import ./owner.bend as Owner', f'import {ALIGNED}/owner.bend as Owner')
assert (SOURCE / 'public.bend').read_text() == expected_public

orig_serialize = (ALIGNED / 'serialize.bend').read_text()
expected_serialize = orig_serialize.replace('import ./owner.bend as Owner', f'import {ALIGNED}/owner.bend as Owner')
assert (SOURCE / 'serialize.bend').read_text() == expected_serialize

orig_format = (ALIGNED / 'full-format.bend').read_text()
expected_format = orig_format
for module in ('application', 'public', 'serialize'):
    expected_format = expected_format.replace(f'import {ALIGNED}/{module}.bend as ', f'import ./{module}.bend as ')
assert (SOURCE / 'full-format.bend').read_text() == expected_format

# The normal complete model and archived gzip are independent source-derived
# bytes. Verify that baseline before deriving the mutant.
full = runpy.run_path(str(FULL_MODEL_PATH))
normal = full['expected']()
normal_archive = gzip.decompress(NORMAL_ARCHIVE.read_bytes())
assert normal == normal_archive, 'independent normal baseline no longer matches archive'
assert len(normal) == 1323096
assert sha(normal) == '4f81597227d0f5341a4653fde10a108ab224f685ebbc93b34ce9f8d3ddc87b97'

# Current timing model wraps the prior complete lifecycle/world derivation.
timing = runpy.run_path(str(TIMING_MODEL))
prior = timing['namespace']
old_report = prior['report']
c = prior['c']
raw = prior['raw']


def mutant_report(name, operation):
    if name != 'lateInvalid':
        return old_report(name, operation)
    value, seed, _ = prior['inputs']()[name]
    # The private mutant ignores this exact validation refusal and passes a
    # valid empty Array to the same declared owner builder.
    canonical = []
    output = (c('ResourceOutputView', value=c('ResourceReplaced', canonical=raw(canonical), undoAvailable=True))
              if operation == 'resource'
              else c('ComponentView', value=c('Accepted',
                    target=c('Handle', namespace=1, id=2 if operation == 'spawn' else 1),
                    spawned=operation == 'spawn', canonical=raw(canonical), undoAvailable=True)))
    return c('Report', original=prior['input_view'](value),
             before=prior['snapshot'](seed, value, canonical, operation, True),
             committed=prior['snapshot'](seed, value, canonical, operation, True, committed=True),
             barrier=prior['snapshot'](seed, value, canonical, operation, True, barrier=True),
             instance=c('InstanceView', namespace=1, id=1, name='application32',
                        access=prior['ACCESS'], recoveries=[], pending=[]),
             result=c('Completed', output=output))

prior['report'] = mutant_report


def mutant_native_report(name, operation):
    value, _, canonical = prior['inputs']()[name]
    if name == 'lateInvalid':
        canonical = []
    report = mutant_report(name, operation)
    # Native report additions are the source-current registration and physical
    # queue fields; only lateInvalid changes the constructor result.
    valid = name != 'nestedMissing'
    for phase in ('before', 'committed', 'barrier'):
        snapshot = report[phase]
        snapshot['meta']['registrations'] = [
            c('RegistrationMeta', id=3, name='application32', access=['Value', 'Resource', 'Marker']),
            c('RegistrationMeta', id=2, name='queue', access=['Marker']),
            c('RegistrationMeta', id=1, name='seed', access=['Value'])]
        snapshot['meta']['nextSystemId'] = 4
        receipts = [] if phase == 'barrier' else [timing['marker_receipt']()]
        if phase == 'committed' and valid and operation == 'spawn':
            receipts.append(timing['spawn_receipt'](value, canonical))
        snapshot['store']['receipts'] = receipts
    report['instance']['id'] = 3
    return report

# Recreate the unchanged current ordered 32-row stream from the source-derived
# operation/case model. Current plan pins an exact ordered tuple comparison.
rows = []
for root, operation in (('Workshop', 'insert'), ('Workshop', 'spawn'),
                        ('Workshop', 'resource'), ('Garden', 'insert')):
    for name in prior['CASES']:
        report = mutant_native_report(name, operation)
        view = timing['public_view'](report)
        rows.append(c('' + root, operation=operation, name=name,
                      value=c('Whole', public=view, native=report)))

# Current complete wire formatter uses the pinned schema inventory and quoted
# String printer, including the final LF. Substitute only the source-derived
# native report rows above; do not consume runtime output.
full['formatted'].__globals__['source_models'] = lambda: {'native': rows}
counter = full['expected']()

# Decode the outer String and its inner complete JSON for semantic checks.
def inner_rows(wire):
    outer = json.loads(wire.decode('utf-8'))
    assert isinstance(outer, str)
    return json.loads(outer)
normal_rows = inner_rows(normal)
counter_rows = inner_rows(counter)
assert len(normal_rows) == len(counter_rows) == 32
changed = [i for i, (a, b) in enumerate(zip(normal_rows, counter_rows)) if a != b]
assert changed == [3, 11, 19, 27], changed
assert [(counter_rows[i]['$'], counter_rows[i]['operation'], counter_rows[i]['name']) for i in changed] == [
    ('Workshop', 'insert', 'lateInvalid'), ('Workshop', 'spawn', 'lateInvalid'),
    ('Workshop', 'resource', 'lateInvalid'), ('Garden', 'insert', 'lateInvalid')]
for i, (a, b) in enumerate(zip(normal_rows, counter_rows)):
    if i not in changed:
        assert a == b, f'unexpected changed row {i}'
    else:
        assert b['value']['public']['original'] == a['value']['public']['original']
        assert b['value']['public']['checked']['$'] == 'Accepted'
        assert b['value']['public']['checked']['canonical'] == {'$': 'Array', 'items': []}
        assert a['value']['public']['checked']['$'] == 'Refused'
        assert a['value']['public']['checked']['error']['error']['path'] == '$[127]'
        assert a['value']['public']['checked']['error']['error']['actual'] == {'$': 'Text', 'value': 'late-invalid'}

# Ensure the exact source mutation/copy set has only the approved checked branch
# difference after accounting for explicit import rebinding.
mutant_path = SOURCE / 'decode-construction-mutant.bend'
mutant_body = mutant_path.read_text()
normal_body = (REPO / 'src/ecs/decode-construction.bend').read_text()
assert mutant_body.count('D.Rejected{D.Invalid{"$[127]","integer",D.Text{"late-invalid"}}}') == 1
assert mutant_body.count('build(owner,D.Array{[]})') == 1
assert 'case D.Receipt{owner,D.Rejected{error}}:Build.Invalid{owner,error}' in mutant_body

counter_gz = gzip_bytes(counter)
(CHILD / 'counter.stdout').write_bytes(counter)
(CHILD / 'counter.stdout.gz').write_bytes(counter_gz)
(CHILD / 'counter.semantic.json.gz').write_bytes(gzip_bytes((json.dumps(counter_rows, separators=(',', ':'), ensure_ascii=False) + '\n').encode()))
checks = {
    'status': 'PASS_SOURCE_DERIVED_COUNTERMODEL',
    'sourceInventoryFilesVerified': len(source_checks),
    'privateClosureCopiesVerified': ['application.bend', 'main.bend', 'observation-main.bend', 'public.bend', 'serialize.bend', 'full-format.bend', 'decode-construction-mutant.bend', 'decode-constructed-requests-mutant.bend', 'decode-constructed-resource-mutant.bend'],
    'privateNominalTypesUnified': 'The private main/application/public/serialize/full-format imports share one application module path; Owner remains the exact original aligned owner module.',
    'semanticSourceChangeCount': 1,
    'normalBaseline': {'bytes': len(normal), 'sha256': sha(normal), 'archiveSha256': digest(NORMAL_ARCHIVE), 'exactArchiveMatch': True},
    'counter': {'bytes': len(counter), 'sha256': sha(counter), 'gzipBytes': len(counter_gz), 'gzipSha256': sha(counter_gz)},
    'rows': 32,
    'changedRowIndicesZeroBased': changed,
    'firstDifference': {'index': changed[0], 'row': counter_rows[changed[0]]['$'], 'operation': counter_rows[changed[0]]['operation'], 'name': counter_rows[changed[0]]['name']},
    'onlyChangedCase': 'lateInvalid exact Invalid{"$[127]","integer",Text{"late-invalid"}} is replaced by a source-builder call with valid empty Array; all other 28 rows byte-semantically equal to baseline.',
    'refusalRowsPreserved': [i for i in range(32) if i not in changed and normal_rows[i]['value']['public']['checked']['$'] == 'Refused'],
    'normalInputPreservedOnChangedRows': True,
    'runtimeOutputsUsed': False,
}
checks['currentSourcePlanSHA256'] = digest(PLAN_PATH)
checks['sourceBasisSHA256'] = digest(CHILD / 'SOURCE-BASIS.json')
checks['privateSourceChecks'] = []
for label, receipt_path in (
    ('pre-closure nominal-type mismatch', CHILD / 'source-check/receipt.json'),
    ('post-closure five-second cap', CHILD / 'source-check-02/receipt.json'),
):
    receipt = json.loads(receipt_path.read_text())
    checks['privateSourceChecks'].append({
        'label': label,
        'receipt': str(receipt_path),
        'receiptSHA256': digest(receipt_path),
        'status': receipt['status'],
        'exitCode': receipt['exitCode'],
        'outerTimeout': receipt['outerTimeout'],
        'elapsedSeconds': receipt['elapsedSeconds'],
        'stdout': receipt['stdout'],
        'stderr': receipt['stderr'],
    })
checks['privateSourceCheckPassObserved'] = any(
    item['status'] == 'PASS_SOURCE_CHECK' for item in checks['privateSourceChecks'])
(CHILD / 'CHECKS.json').write_text(json.dumps(checks, indent=2) + '\n')
print(json.dumps(checks, indent=2))
