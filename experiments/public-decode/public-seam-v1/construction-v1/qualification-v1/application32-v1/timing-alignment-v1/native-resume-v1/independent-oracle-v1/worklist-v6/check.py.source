from pathlib import Path
import runpy,json,hashlib,gzip,re
p=Path(__file__).resolve().parent;b=json.loads((p/'SOURCE-BASIS.json').read_text())
for group in ('sourcePins','inputs','modelPins'):
 for path,digest in b[group].items():assert hashlib.sha256(Path(path).read_bytes()).hexdigest()==digest,path
m=runpy.run_path(str(p/'model.py.source'));prior=m['prior']();source=m['ENTRY'].read_text();specs=m['specs']();assert len(specs)==32
branches=dict(re.findall(r'case (\w+)\{\}:Gameplay.run\(~S,~Cases.codec\(Cases.(\w+)\(\)\),mode,input,seed\)',source));assert len(branches)==8
expanded=[]
for schema,tag,operation,name,mode,rawcase,seedcase in specs:
 assert branches[tag]==rawcase==seedcase
 assert {'insert':'Insert','spawn':'Spawn','resource':'ResourceWrite'}[operation]==mode
 owner={'Workshop':'First','Garden':'Second'}[schema]
 expanded.append(f'Gameplay.run(~Owner.{owner},~Cases.codec(Cases.{branches[tag]}()),Gameplay.{mode}{{}},Cases.input(Cases.{rawcase}()),Cases.resource(Cases.{seedcase}()))')
old=(prior['ALIGNED']/'main.bend').read_text();calls={}
for line in old.splitlines():
 step=re.match(r'def step_(\d+)\(',line)
 if not step:continue
 start=line.index('Gameplay.run(');depth=0
 for i in range(start+len('Gameplay.run'),len(line)):
  if line[i]=='(':depth+=1
  elif line[i]==')':
   depth-=1
   if depth==0:calls[int(step.group(1))]=line[start:i+1];break
assert expanded==[calls[i] for i in range(32)]
expected_keys=[(v['$'],v['operation'],v['name']) for v in prior['formatted']()]
assert [(a,c,d) for a,tag,c,d,mode,rawcase,seedcase in specs]==expected_keys
assert 'case value <> rest:collect(rest,execute(value) <> previous)' in source
assert 'collected_item' not in source
assert source.count('List.reverse(&2,Item,previous)')==1
helpers='def workshop_item(operation:String,name:String,value:Gameplay.Report<Owner.First>) -> Item:Workshop{operation,name,value}\ndef garden_item(operation:String,name:String,value:Gameplay.Report<Owner.Second>) -> Item:Garden{operation,name,value}\n'
assert source.count(helpers)==1 and source.index(helpers)<source.index('def execute(')
inverse=source.replace(helpers,'').replace('workshop_item(operation,name,run_case(~Owner.First,caseTag,mode,input,seed))','Workshop{operation,name,run_case(~Owner.First,caseTag,mode,input,seed)}').replace('garden_item(operation,name,run_case(~Owner.Second,caseTag,mode,input,seed))','Garden{operation,name,run_case(~Owner.Second,caseTag,mode,input,seed)}')
assert inverse==Path(b['predecessorEntry']).read_text()
assert 'case value <> rest:separator ++ item(value) ++ work(rest,",")' in source
raw=m['expected']();assert raw==prior['expected']() and m['formatted']()==prior['formatted']()
v=json.loads((p/'ORACLES.json').read_text())['normal'];assert raw==gzip.decompress(Path(v['stdout']).read_bytes())
assert len(raw)==v['bytes'] and hashlib.sha256(raw).hexdigest()==v['sha256']
print('PASS:60pins/32actual sourceSpecs→originalcalls/schema-mode-codec-raw-seed-name-order/fullfield+wire equality; source01 deadline not PASS')
