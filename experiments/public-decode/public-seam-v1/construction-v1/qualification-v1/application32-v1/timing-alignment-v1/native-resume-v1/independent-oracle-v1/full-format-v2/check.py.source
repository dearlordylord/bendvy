from pathlib import Path
import runpy,json,hashlib,gzip,re,copy
p=Path(__file__).resolve().parent;b=json.loads((p/'SOURCE-BASIS.json').read_text())
for group in ('sourcePins','inputs','modelPins'):
 for path,digest in b[group].items():assert hashlib.sha256(Path(path).read_bytes()).hexdigest()==digest,path
m=runpy.run_path(str(p/'model.py.source'));models=m['source_models']();types=m['inventory']();value=m['formatted']();raw=m['expected']();semantic=m['semantic_json']().encode();catalogue=json.loads((p/'ORACLES.json').read_text())
for key,data,field in [('normal',raw,'stdout'),('semantic',semantic,'json')]:
 v=catalogue[key];assert gzip.decompress(Path(v[field]).read_bytes())==data
 assert len(data)==v['bytes'] and hashlib.sha256(data).hexdigest()==v['sha256']
assert json.loads(raw)==semantic.decode() and json.loads(semantic)==value and len(value)==32
# Type-directed exact inverse: no field omission or replacement of native by public.
def original(value,typ):
 if typ=='Nat':assert set(value)=={'$','decimal'} and value['$']=='Nat';return int(value['decimal'])
 if typ in ('U32','String','Bool','F32'):return value
 if isinstance(typ,list):return [original(x,typ[0]) for x in value]
 module,variants=typ if isinstance(typ,tuple) else types[typ]
 tag=value['$'];fields=variants[tag];assert list(value)==['$',*[k for k,t in fields]]
 return {'$':tag,**{k:original(value[k],t) for k,t in fields}}
assert original(value,types['Report'])==models['native']
s=m['ENTRY'].parent;main=m['ENTRY'].read_text();old=(m['ALIGNED']/'main.bend').read_text();fmt=(s/'format.bend').read_text()
def calls(source):
 out={}
 for line in source.splitlines():
  step=re.match(r'def step_(\d+)\(',line)
  if not step:continue
  start=line.index('Gameplay.run(');at=start+len('Gameplay.run');depth=0
  for i in range(at,len(line)):
   if line[i]=='(':depth+=1
   elif line[i]==')':
    depth-=1
    if depth==0:out[int(step.group(1))]=line[start:i+1];break
 return out
assert calls(main)==calls(old) and set(calls(main))==set(range(32))
assert 'Public.view(~S,value)' in fmt and 'report(~S,value)' in fmt
assert 'J.Field{"depth",nat(depth)}' in fmt and 'J.Field{"bits",J.Number{F32.bits(value)}}' in fmt
assert 'Public.Unsupported{value}:record("Unsupported",[J.Field{"snapshot",snapshot(value)}])' in fmt
assert 'App.UnsupportedMarker{}:record("UnsupportedMarker",[])' in fmt
assert all('case D.'+tag+'{' in fmt for tag in types['Raw'][1])
assert 'Encode.encode(Format.record("Workshop"' in main and 'Encode.encode(Format.record("Garden"' in main
# All text selected by this closed trace is literal ASCII safe for current J.tokens.
def texts(v):
 if isinstance(v,str):assert all(32<=ord(c)<127 and c not in '\"\\' for c in v)
 elif isinstance(v,list):
  for x in v:texts(x)
 elif isinstance(v,dict):
  for k,x in v.items():texts(k);texts(x)
texts(value)
assert raw.startswith(b'"[') and raw.endswith(b']"\n')
# A physical sibling/owner deletion cannot pass the complete model equality.
x=copy.deepcopy(value);x[-1]['value']['native']['barrier']['resource']['words'].pop();assert x!=value
print('PASS:57pins/exact32calls/whole JSON wire/full field inverse/Nat transparency/allRaw+Unsupported source arms/ASCII grammar/full1323096bytes; main source deadline retained')
