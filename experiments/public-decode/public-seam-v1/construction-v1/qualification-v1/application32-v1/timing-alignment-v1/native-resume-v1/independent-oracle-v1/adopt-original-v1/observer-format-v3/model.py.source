from pathlib import Path
import runpy,json
ROOT=Path(__file__).resolve().parent.parent.parent
FORMATMODEL=ROOT/'full-format-v2/model.py.source'
COMMONMODEL=ROOT/'adopt-original-v1/model.py.source'
def formatmodel():return runpy.run_path(str(FORMATMODEL))
def commonmodel():return runpy.run_path(str(COMMONMODEL))
def formatted():return formatmodel()['formatted']()
def whole():return formatmodel()['expected']()
def semantic():return formatmodel()['semantic_json']().encode()
def common():return commonmodel()['common']()
