"""Source-only recursive Item-seam complete32 model; no runtime output inputs."""
from pathlib import Path
import runpy,json
PRIOR=Path(__file__).resolve().parent.parent/'full-format-v2/model.py.source'
def prior():return runpy.run_path(str(PRIOR))
def formatted():return prior()['formatted']()
def semantic_json():
    # collected() reverses32 accumulated Items exactly once; work folds in order,
    # emitting the initial empty separator and comma for every subsequent Item.
    values=formatted()
    return '['+','.join(json.dumps(x,separators=(',',':'),ensure_ascii=False) for x in values)+']'
def expected():return (json.dumps(semantic_json(),ensure_ascii=False)+'\n').encode()
