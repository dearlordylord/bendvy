#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
python3 scripts/check-python-source.py --staged
if [ -n "$(git diff --cached --name-only -- docs/parity/README.md)" ]; then
  git show :docs/parity/README.md | python3 scripts/check-coordination.py /dev/stdin
fi
if [ -n "${BENDVY_OWNED_PATHS:-}" ]; then
  python3 scripts/owned_stage.py "$BENDVY_OWNED_PATHS"
fi
if [ -n "${BENDVY_DELIVERY_PLANS:-}" ]; then
  python3 scripts/delivery_preflight.py --manifest "$BENDVY_DELIVERY_PLANS"
fi
python3 scripts/run-admission-controls.py
# Full infrastructure suites run in CI; local admission controls select affected callers.
# Raw evidence retains compiler whitespace and complete output terminators.
git diff --cached --check -- '*.bend' '*.py' '*.md' '*.c' '*.js' '*.json' '.githooks/*'
