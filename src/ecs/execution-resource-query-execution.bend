  match physical:
    case FullScope{scope}:Returned{State.reassemble(~S,~L.columns(~S,components),~L.resources(~S,resources),~E,admin,scope),owners,status,displaced}
    case CutInventory{inventory}:CutInventoryRefused{admin,inventory,owners,status,displaced}
    case JoinInventory{inventory}:JoinInventoryRefused{admin,inventory,owners,status,displaced}
