type Projected<Args:Type,Observation:Type,U:Data> is Type:
  Ready{args:Args,observation:Observation}
  ProjectionFailed{args:Args,error:U}
type Error<U:Data> is Data:
  MissingPayload{}
  ProjectError{error:U}
  QueryError{error:Q.Error<U>}
type Reply<Args:Type,Observation:Type,U:Data,Out:Data> is Type:
  Reply{outcome:T.Outcome<Error<U>>,args:Args,observations:List<Observation>,values:List<&2,Out>,lagged:Bool}
def row_returned(~H:Type,~Args:Type,~Observation:Type,~U:Data,~Out:Data,result:H & (Observation & (Args & (T.Outcome<U> & Out)))) -> H & ((Observation & Args) & (T.Outcome<U> & Out)):
  match result:
    case (owner,(observation,(args,status))):(owner,((observation,args),status))
# Projection runs with only the scoped payload request. Its owner is restored
# before query grants execute; all event/row writes share one transaction.
def row(~S:Data,~C:Type,~R:Type,~E:Data,~Args:Type,~Observation:Type,~U:Data,~Out:Data,~Ops:Type -> Type,~body:@-H:Type -> @-caps:Ops(H) -> Observation -> Args -> H -> H & (Observation & (Args & (T.Outcome<U> & Out))),~H:Type,~caps:Ops(H),capture:Observation & Args,ignored:Unit,owner:H) -> H & ((Observation & Args) & (T.Outcome<U> & Out)):
  match capture:
    case (observation,args):row_returned(~H,~Args,~Observation,~U,~Out,body(H,caps,observation,args,owner))
def prepend(~S:Data,~C:Type,~R:Type,~E:Data,~Args:Type,~Observation:Type,~U:Data,~Out:Data,observation:Observation,values:List<&2,Out>,result:Args & (List<Observation> & (T.Tx<W.World<S,C,R,E>,E> & (T.Outcome<Error<U>> & List<&2,Out>)))) -> Args & (List<Observation> & (T.Tx<W.World<S,C,R,E>,E> & (T.Outcome<Error<U>> & List<&2,Out>))):
  match result:
    case (args,(observations,(tx,(status,later)))):(args,(observation <> observations,(tx,(status,List.append(&2,Out,values,later)))))
def queried(~S:Data,~C:Type,~R:Type,~P:Type,~Rest:Type,~E:Data,~path:Product.Lens<R,Log.Log<P>,Rest>,~Request:Type,~Projection:Data,~Args:Type,~Observation:Type,~U:Data,~Out:Data,~Ops:Type -> Type,~at:P -> Request -> P & Projection,~project:@-H:Type -> @-read:Cap.Request<H,Request,Projection> -> H -> Args -> H & Projected<Args,Observation,U>,~query:Decl.Declaration<S,Q.Frame<S,C,R,E>,Ops(Q.Frame<S,C,R,E>)>,~body:@-H:Type -> @-caps:Ops(H) -> Observation -> Args -> H -> H & (Observation & (Args & (T.Outcome<U> & Out))),next:Args -> T.Tx<W.World<S,C,R,E>,E> -> Args & (List<Observation> & (T.Tx<W.World<S,C,R,E>,E> & (T.Outcome<Error<U>> & List<&2,Out>))),result:(Observation & Args) & (T.Tx<W.World<S,C,R,E>,E> & (T.Outcome<Q.Error<U>> & List<&2,Out>))) -> Args & (List<Observation> & (T.Tx<W.World<S,C,R,E>,E> & (T.Outcome<Error<U>> & List<&2,Out>))):
  match result:
    case ((observation,args),(tx,(T.Failure{error},_))):(args,([observation],(tx,(T.Failure{QueryError{error}},[]))))
    case ((observation,args),(tx,(T.Success{},values))):prepend(~S,~C,~R,~E,~Args,~Observation,~U,~Out,observation,values,next(args,tx))
