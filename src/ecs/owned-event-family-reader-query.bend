def accepted(~Args:Type,~Observation:Type,~U:Data,~Out:Data,value:Reply<Args,Observation,U,Out>) -> Reply<Args,Observation,U,Out> & Bool:
  match value:
    case Reply{T.Success{},args,observations,values,lagged}:(Reply{T.Success{},args,observations,values,lagged},True{})
    case Reply{T.Failure{error},args,observations,values,lagged}:(Reply{T.Failure{error},args,observations,values,lagged},False{})

