    case T.Returned{world,T.Success{}}:Sys.Succeeded{world,Reply{T.Success{},args,observations,values,lagged}}
    case T.Returned{world,T.Failure{error}}:Sys.Succeeded{world,Reply{T.Failure{error},args,observations,[],lagged}}
