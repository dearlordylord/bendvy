import Base
import ./execution-command-buffer.bend as Buffer
import ./execution-command-permission.bend as Permission
import ./execution-relation-command.bend as Commands
import ./execution-relation-context.bend as Context
import ./execution-relation-resource-dispatch.bend as Dispatch
import ./execution-relation-world-publication.bend as Publication
import ./execution-relation-operation.bend as Operation
import ./execution-composer-layout.bend as Layout
import ./change-tick.bend as Tick
import ./world.bend as W
import ./entity-allocator.bend as Allocator

def commands(~S:Data,~P:Type,~D:Type,~route:Layout.Route) -> Commands.HierarchyCommands<Buffer.Buffer<S,P,D>,S>:
  Commands.hierarchy(~S,~Buffer.Buffer<S,P,D>,~route,~Buffer.relation(~S,~P,~D))
def receipt(~S:Data,~P:Type,~D:Type,route:Layout.Route,result:Dispatch.Outcome<S>) -> Buffer.Receipt<S,P,D>:
  match result:
    case Dispatch.Published{receipt}:Buffer.RelationPublished{route,receipt}
    case Dispatch.Undeclared{operation}:Buffer.RelationUndeclared{route,operation}
def restored(~S:Data,~C:Type,~WR:Type,~E:Data,~P:Type,~D:Type,~resources:Layout.Layout,~same:{WR == Layout.resources(~S,resources) : Type},route:Layout.Route,frame:Publication.Frame<S,C,WR,E>,result:Allocator.Allocator & (Layout.resources(~S,resources) & Dispatch.Outcome<S>)) -> W.World<S,C,WR,E> & Buffer.Receipt<S,P,D>:
  match frame result:
    case Publication.Frame{namespace,columns,events,pending,registrations,nextSystem,clock,lifecycle}, (allocator,(owners,outcome)):(W.World{namespace,allocator,columns,Layout.checked_owner(Layout.resources(~S,resources),WR,Equal.sym(Type,WR,Layout.resources(~S,resources),same),owners),events,pending,registrations,nextSystem,clock,lifecycle},receipt(~S,~P,~D,route,outcome))
# The only callable program is generated by the same closed declaration's grant
# factory. It consumes canonical resources, never a user-supplied World callback.
def run(~S:Data,~C:Type,~WR:Type,~E:Data,~P:Type,~D:Type,~resources:Layout.Layout,~same:{WR == Layout.resources(~S,resources) : Type},~program:Dispatch.Program(~S,~resources),context:Context.Context<S,WR,resources,same>,+route:Layout.Route,operation:Operation.Operation<S>,world:W.World<S,C,WR,E>,tick:Tick.Tick) -> W.World<S,C,WR,E> & Buffer.Receipt<S,P,D>:
  match context world:
    case Context.Context{expected} W.World{+namespace,allocator,columns,owners,events,pending,registrations,nextSystem,clock,lifecycle}:restored(~S,~C,~WR,~E,~P,~D,~resources,~same,route,Publication.Frame{namespace,columns,events,pending,registrations,nextSystem,clock,lifecycle},program(expected,namespace,allocator,Layout.checked_owner(WR,Layout.resources(~S,resources),same,owners),route,operation,tick))
def apply(~S:Data,~C:Type,~WR:Type,~E:Data,~P:Type,~D:Type,~resources:Layout.Layout,~same:{WR == Layout.resources(~S,resources) : Type},~selection:Permission.Selection<S,resources>,context:Context.Context<S,WR,resources,same>,route:Layout.Route,operation:Operation.Operation<S>,world:W.World<S,C,WR,E>,tick:Tick.Tick) -> W.World<S,C,WR,E> & Buffer.Receipt<S,P,D>:
  run(~S,~C,~WR,~E,~P,~D,~resources,~same,~Permission.selection_field(~S,~resources,selection),context,route,operation,world,tick)
