def run_retained_with_policy(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Error:Data,~Out:Data,-Left:Type,-Right:Type,policy:Task.Policy,+ids:List<&2,U32>,world:W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,left:Leaf.Leaf<S,components,resources,E,Left,Error,Out>,right:Leaf.Leaf<S,components,resources,E,Right,Error,Out>) -> IO(Execution.RunResult<S,components,resources,E,Product.Owner<Left,Right>,Error,Out>):
  match left:
    case Leaf.Leaf{LH,restore,inspect,prepare,invoke,permits,held}:left_inspected(~S,~components,~resources,~E,~Error,~Out,LH,Left,Right,policy,ids,Before{restore,prepare,invoke,permits},right,inspect(ids,world,held))
def run_retained(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Error:Data,~Out:Data,-Left:Type,-Right:Type,+ids:List<&2,U32>,world:W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,left:Leaf.Leaf<S,components,resources,E,Left,Error,Out>,right:Leaf.Leaf<S,components,resources,E,Right,Error,Out>) -> IO(Execution.RunResult<S,components,resources,E,Product.Owner<Left,Right>,Error,Out>):
  run_retained_with_policy(~S,~components,~resources,~E,~Error,~Out,Left,Right,Task.Parallel{},ids,world,left,right)
def run_retained_serial(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Error:Data,~Out:Data,-Left:Type,-Right:Type,+ids:List<&2,U32>,world:W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,left:Leaf.Leaf<S,components,resources,E,Left,Error,Out>,right:Leaf.Leaf<S,components,resources,E,Right,Error,Out>) -> IO(Execution.RunResult<S,components,resources,E,Product.Owner<Left,Right>,Error,Out>):
  run_retained_with_policy(~S,~components,~resources,~E,~Error,~Out,Left,Right,Task.Serial{},ids,world,left,right)
# One-shot compatibility uses exactly the same interpreter. Persistent callers
# supply Leaf.from_retained so this return contains actual Nodes, then invoke
# restore_retained only at their final public-owner boundary.
def run(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Error:Data,~Out:Data,-Left:Type,-Right:Type,ids:List<&2,U32>,world:W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,left:Leaf.Leaf<S,components,resources,E,Left,Error,Out>,right:Leaf.Leaf<S,components,resources,E,Right,Error,Out>) -> IO(Execution.RunResult<S,components,resources,E,Product.Owner<Left,Right>,Error,Out>):
  run_retained(~S,~components,~resources,~E,~Error,~Out,Left,Right,ids,world,left,right)
def restore_retained(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Error:Data,~Out:Data,-LNode:Type,-RNode:Type,-Left:Type,-Right:Type,leftRestore:LNode -> Left,rightRestore:RNode -> Right,result:Execution.RunResult<S,components,resources,E,Product.Owner<LNode,RNode>,Error,Out>) -> Execution.RunResult<S,components,resources,E,Product.Owner<Left,Right>,Error,Out>:
  match result:
    case Execution.Returned{world,Product.Owner{left,right},status,displaced}:Execution.Returned{world,Product.Owner{leftRestore(left),rightRestore(right)},status,displaced}
    case Execution.AdmissionRefused{world,Product.Owner{left,right},status}:Execution.AdmissionRefused{world,Product.Owner{leftRestore(left),rightRestore(right)},status}
    case Execution.CutInventoryRefused{admin,inventory,Product.Owner{left,right},status,displaced}:Execution.CutInventoryRefused{admin,inventory,Product.Owner{leftRestore(left),rightRestore(right)},status,displaced}
    case Execution.JoinInventoryRefused{admin,inventory,Product.Owner{left,right},status,displaced}:Execution.JoinInventoryRefused{admin,inventory,Product.Owner{leftRestore(left),rightRestore(right)},status,displaced}
    case Execution.NestedInventoryRefused{Inventory,admin,inventory,Product.Owner{left,right},status,displaced}:Execution.NestedInventoryRefused{Inventory,admin,inventory,Product.Owner{leftRestore(left),rightRestore(right)},status,displaced}
