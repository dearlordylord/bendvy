def clocked(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Error:Data,~Out:Data,-LH:Type,-RH:Type,-Left:Type,-Right:Type,policy:Task.Policy,ids:List<&2,U32>,mode:PairAdmission.Mode,leftFootprint:Footprint.Footprint<S,components,resources>,rightFootprint:Footprint.Footprint<S,components,resources>,leftOps:Active<S,State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,LH,Left,Prep.Permit<S,L.columns(~S,components)>,List<&2,Ready.Completed<Error,Out>>>,rightOps:Active<S,State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,RH,Right,Prep.Permit<S,L.columns(~S,components)>,List<&2,Ready.Completed<Error,Out>>>,left:LH,right:RH,result:W.World<S,L.columns(~S,components),L.resources(~S,resources),E> & Tick.Tick) -> IO(Execution.RunResult<S,components,resources,E,Product.Owner<Left,Right>,Error,Out>):
