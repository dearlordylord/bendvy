  match left right:
    case (left,+lp), (right,+rp):IO.bind(State.Administration<S,L.columns(~S,components),L.resources(~S,resources),E> & Phase.GroupResult<S,components,resources,LH,RH,List<&2,Ready.Completed<Error,Out>>>,Execution.RunResult<S,components,resources,E,Product.Owner<Left,Right>,Error,Out>,Driver.run_with_policy(~S,~L.columns(~S,components),~L.resources(~S,resources),~E,Phase.GroupResult<S,components,resources,LH,RH,List<&2,Ready.Completed<Error,Out>>>,policy,Execution.authorized(~S,~components,List.append(&2,Prep.Permit<S,L.columns(~S,components)>,lp,rp)),admin,Phase.run(~S,~components,~resources,LH,RH,List<&2,Ready.Completed<Error,Out>>,mode,(left => right => List.append(&2,Ready.Completed<Error,Out>,left,right)),(scope => Footprint.split(~S,~components,~resources,scope,leftFootprint,rightFootprint)),(scope => Footprint.split_single(~S,~components,~resources,scope,leftFootprint)),(scope => Footprint.split_single(~S,~components,~resources,scope,rightFootprint)),leftInvoke,rightInvoke,scope,left,right,[])),result => IO.pure(Execution.RunResult<S,components,resources,E,Product.Owner<Left,Right>,Error,Out>,finished(~S,~components,~resources,~E,~Error,~Out,LH,RH,Left,Right,leftRestore,rightRestore,ids,List.append(&2,Prep.Permit<S,L.columns(~S,components)>,lp,rp),result)))
def separated(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Error:Data,~Out:Data,-LH:Type,-RH:Type,-Left:Type,-Right:Type,policy:Task.Policy,ids:List<&2,U32>,mode:PairAdmission.Mode,leftFootprint:Footprint.Footprint<S,components,resources>,rightFootprint:Footprint.Footprint<S,components,resources>,leftOps:Active<S,State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,LH,Left,Prep.Permit<S,L.columns(~S,components)>,List<&2,Ready.Completed<Error,Out>>>,rightOps:Active<S,State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,RH,Right,Prep.Permit<S,L.columns(~S,components)>,List<&2,Ready.Completed<Error,Out>>>,left:LH,right:RH,result:State.Administration<S,L.columns(~S,components),L.resources(~S,resources),E> & State.Scope<S,L.columns(~S,components),L.resources(~S,resources)>) -> IO(Execution.RunResult<S,components,resources,E,Product.Owner<Left,Right>,Error,Out>):
