# Internal execution stages contain fixed methods and actual hidden owners.
# Metadata footprints come only from Leaf.inspect of the same retained artifact.
type Before<-S:Data,-World:Type,-H:Type,-Held:Type,-Owner:Type,-P:Data,-Status:Data> is Type:
  Before{restore:Held -> Owner,prepare:List<&2,U32> -> World -> Held -> World & Held,invoke:H -> Held -> Task.Task<S,Authority.Permit,Phase.LeafResult<H,Held,Status>>,permits:Held -> Held & List<&2,P>}
type Active<-S:Data,-H:Type,-Held:Type,-Owner:Type,-P:Data,-Status:Data> is Type:
  Active{restore:Held -> Owner,invoke:H -> Held -> Task.Task<S,Authority.Permit,Phase.LeafResult<H,Held,Status>>,permits:Held -> Held & List<&2,P>}
def finished(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Error:Data,~Out:Data,-LH:Type,-RH:Type,-Left:Type,-Right:Type,leftRestore:LH -> Left,rightRestore:RH -> Right,+ids:List<&2,U32>,permits:List<&2,Prep.Permit<S,L.columns(~S,components)>>,result:State.Administration<S,L.columns(~S,components),L.resources(~S,resources),E> & Phase.GroupResult<S,components,resources,LH,RH,List<&2,Ready.Completed<Error,Out>>>) -> Execution.RunResult<S,components,resources,E,Product.Owner<Left,Right>,Error,Out>:
  match result:
    case (admin,Phase.Returned{scope,left,right,status,displaced}):Execution.Returned{State.reassemble(~S,~L.columns(~S,components),~L.resources(~S,resources),~E,Execution.leave_admin(~S,~components,~resources,~E,~Error,~Out,admin,permits),scope),Product.Owner{leftRestore(left),rightRestore(right)},Execution.completed_statuses(Error,Out,status,ids),displaced}
    case (admin,Phase.CutRefused{inventory,left,right,status,displaced}):Execution.CutInventoryRefused{Execution.leave_admin(~S,~components,~resources,~E,~Error,~Out,admin,permits),inventory,Product.Owner{leftRestore(left),rightRestore(right)},Execution.completed_statuses(Error,Out,status,ids),displaced}
    case (admin,Phase.JoinRefused{inventory,left,right,status,displaced}):Execution.JoinInventoryRefused{Execution.leave_admin(~S,~components,~resources,~E,~Error,~Out,admin,permits),inventory,Product.Owner{leftRestore(left),rightRestore(right)},Execution.completed_statuses(Error,Out,status,ids),displaced}
    case (admin,Phase.NestedRefused{Inventory,inventory,left,right,status,displaced}):Execution.NestedInventoryRefused{Inventory,Execution.leave_admin(~S,~components,~resources,~E,~Error,~Out,admin,permits),inventory,Product.Owner{leftRestore(left),rightRestore(right)},Execution.completed_statuses(Error,Out,status,ids),displaced}
