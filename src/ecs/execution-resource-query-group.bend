def mode(~S:Data,~components:L.Layout,~resources:L.Layout,left:Footprint.Footprint<S,components,resources>,right:Footprint.Footprint<S,components,resources>) -> PairAdmission.Mode:
  match left right:
    case Footprint.Footprint{_,_,_,_,_,Schema.Book{left},lr} Footprint.Footprint{_,_,_,_,_,Schema.Book{right},rr}:PairAdmission.classify(~resources,left,right,lr,rr)
def validated(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Error:Data,~Out:Data,-LH:Type,-RH:Type,-Left:Type,-Right:Type,policy:Task.Policy,+ids:List<&2,U32>,world:W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,leftOps:Before<S,W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,LH,Left,Prep.Permit<S,L.columns(~S,components)>,List<&2,Ready.Completed<Error,Out>>>,rightOps:Before<S,W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,RH,Right,Prep.Permit<S,L.columns(~S,components)>,List<&2,Ready.Completed<Error,Out>>>,left:LH,right:RH,leftFootprint:Maybe<&2,Footprint.Footprint<S,components,resources>>,rightFootprint:Maybe<&2,Footprint.Footprint<S,components,resources>>) -> IO(Execution.RunResult<S,components,resources,E,Product.Owner<Left,Right>,Error,Out>):
  match leftOps rightOps leftFootprint rightFootprint:
    case Before{restore,prepare,invoke,permits} rightOps Some{+lf} Some{+rf}:left_prepared(~S,~components,~resources,~E,~Error,~Out,LH,RH,Left,Right,policy,ids,mode(~S,~components,~resources,lf,rf),lf,rf,Active{restore,invoke,permits},rightOps,right,prepare(ids,world,left))
    case Before{lr,_,_,_} Before{rr,_,_,_} _ _:IO.pure(Execution.RunResult<S,components,resources,E,Product.Owner<Left,Right>,Error,Out>,Execution.AdmissionRefused{world,Product.Owner{lr(left),rr(right)},Execution.completed_statuses(Error,Out,[],ids)})
