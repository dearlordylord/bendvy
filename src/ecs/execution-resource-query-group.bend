def left_inspected(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Error:Data,~Out:Data,-LH:Type,-Left:Type,-Right:Type,policy:Task.Policy,+ids:List<&2,U32>,leftOps:Before<S,W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,LH,Left,Prep.Permit<S,L.columns(~S,components)>,List<&2,Ready.Completed<Error,Out>>>,right:Leaf.Leaf<S,components,resources,E,Right,Error,Out>,result:W.World<S,L.columns(~S,components),L.resources(~S,resources),E> & (LH & Maybe<&2,Footprint.Footprint<S,components,resources>>)) -> IO(Execution.RunResult<S,components,resources,E,Product.Owner<Left,Right>,Error,Out>):
