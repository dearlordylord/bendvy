def mixed_envelope_result(~S:Data,~C:Type,~R:Type,~E:Data,~Meta:Type,~Context:Type,~Reader:Type,~Parameter:Type,~Declaration:Type,~Args:Type,~Failure:Data,~Output:Type,
  ~runFn:W.World<S,C,R,E> -> Invocation<Meta,Reader,Parameter,Declaration,Args> -> Sys.Outcome<W.World<S,C,R,E>,Empty,Envelope<Meta,Reader,Parameter,Declaration,Failure,Output>>,
  ~join:W.World<S,C,R,E> -> Meta -> Context,
  registry:Sys.Registry<S,C,R,E,Invocation<Meta,Reader,Parameter,Declaration,Args>,Empty,Envelope<Meta,Reader,Parameter,Declaration,Failure,Output>,runFn>,world:W.World<S,C,R,E>,envelope:Envelope<Meta,Reader,Parameter,Declaration,Failure,Output>) -> RunResult<Context,Provider<Sys.Registry<S,C,R,E,Invocation<Meta,Reader,Parameter,Declaration,Args>,Empty,Envelope<Meta,Reader,Parameter,Declaration,Failure,Output>,runFn>,Reader,Parameter,Declaration>,Args,Failure,Output>:
  match envelope:
    case Envelope{meta,reader,parameter,declaration,completion}:
      match completion:
        case CallbackCompleted{output}:RunCompleted{join(world,meta),Provider{registry,reader,parameter,declaration},output}
        case CallbackFailed{error,output}:RunFailed{join(world,meta),Provider{registry,reader,parameter,declaration},error,output}
        case CallbackInvalidReader{}:RunInvalidReader{join(world,meta),Provider{registry,reader,parameter,declaration}}

def mixed_outcome_result(~S:Data,~C:Type,~R:Type,~E:Data,~Meta:Type,~Context:Type,~Reader:Type,~Parameter:Type,~Declaration:Type,~Args:Type,~Failure:Data,~Output:Type,
  ~runFn:W.World<S,C,R,E> -> Invocation<Meta,Reader,Parameter,Declaration,Args> -> Sys.Outcome<W.World<S,C,R,E>,Empty,Envelope<Meta,Reader,Parameter,Declaration,Failure,Output>>,
