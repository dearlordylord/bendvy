type ProviderDisposal<Context:Type,Provider:Type,Declaration:Type> is Type:
  ProviderDisposed{context:Context,declaration:Declaration}
  ProviderDisposalRejected{context:Context,provider:Provider}

def provider_disposal_result(~S:Data,~C:Type,~R:Type,~E:Data,~Context:Type,~Meta:Type,~Reader:Type,~View:Data,~Delta:Type,~Args:Type,~Declaration:Type,~Failure:Data,~Output:Type,
  ~validateFn:Context -> Reader -> Context & (Reader & Bool),
  ~prepareFn:Context -> @+cursor:Maybe<&2,Tick.Tick> -> Reader -> Context & (Reader & (View & Delta)),
  ~commitFn:Context -> Reader -> Delta -> @+cursor:Tick.Tick -> Context & Reader,
  ~releaseFn:Context -> Reader -> Context,
  ~join:W.World<S,C,R,E> -> Meta -> Context,
  ~runFn:W.World<S,C,R,E> -> Invocation<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Args> -> Sys.Outcome<W.World<S,C,R,E>,Empty,Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>>,
  reader:Reader,+parameter:RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,declaration:Declaration,meta:Meta,
  disposed:Sys.Disposal<S,C,R,E,Invocation<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Args>,Empty,Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>,runFn>) -> ProviderDisposal<Context,Provider<Sys.Registry<S,C,R,E,Invocation<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Args>,Empty,Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>,runFn>,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration>,Declaration>:
  match disposed:
    case Sys.Disposed{world}:ProviderDisposed{RP.release(~Context,~Reader,~View,~Delta,~validateFn,~prepareFn,~commitFn,~releaseFn,parameter,join(world,meta),reader),declaration}
    case Sys.DisposalRejected{world,registry}:ProviderDisposalRejected{join(world,meta),Provider{registry,reader,parameter,declaration}}

def provider_dispose_parts(~S:Data,~C:Type,~R:Type,~E:Data,~Context:Type,~Meta:Type,~Reader:Type,~View:Data,~Delta:Type,~Args:Type,~Declaration:Type,~Failure:Data,~Output:Type,
