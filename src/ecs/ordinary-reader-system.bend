import Base
import ./change-tick.bend as Tick
import ./world.bend as W
import ./system.bend as Sys
import ./transaction.bend as Tx
import ./commands.bend as Cmd
import ./capabilities.bend as Cap
import ./reader-parameter.bend as RP
import ./event-notice-runtime.bend as Mixed
import ./event-family-routing.bend as Route
import ./relation-commands.bend as Notice
import ./internal/relation-failures/domains.bend as D

# A registered ordinary callback receives one detached product view while the
# shared runtime context remains outside the callback transaction.
type Invocation<Meta:Type,Reader:Type,Parameter:Type,Declaration:Type,Args:Type> is Type:
  Invocation{meta:Meta,reader:Reader,parameter:Parameter,declaration:Declaration,args:Args,queryCursor:Maybe<&2,Tick.Tick>}

type Completion<Failure:Data,Output:Type> is Type:
  CallbackCompleted{output:Output}
  CallbackFailed{error:Failure,output:Output}
  CallbackInvalidReader{}

type Envelope<Meta:Type,Reader:Type,Parameter:Type,Declaration:Type,Failure:Data,Output:Type> is Type:
  Envelope{meta:Meta,reader:Reader,parameter:Parameter,declaration:Declaration,completion:Completion<Failure,Output>}

type Provider<Registry:Type,Reader:Type,Parameter:Type,Declaration:Type> is Type:
  Provider{registry:Registry,reader:Reader,parameter:Parameter,declaration:Declaration}

type Definition<Context:Type,Provider:Type,Parameter:Type,Declaration:Type> is Type:
  DefinitionRegistered{context:Context,provider:Provider}
  DefinitionRejected{context:Context,parameter:Parameter,declaration:Declaration}
  DefinitionDisposalRejected{context:Context,provider:Provider,parameter:Parameter}

type RunResult<Context:Type,Provider:Type,Args:Type,Failure:Data,Output:Type> is Type:
  RunCompleted{context:Context,provider:Provider,output:Output}
  RunFailed{context:Context,provider:Provider,error:Failure,output:Output}
  RunInvalidReader{context:Context,provider:Provider}
  RunRegistrationRejected{context:Context,provider:Provider,args:Args}
  RunSkipped{context:Context,provider:Provider}

def outer_succeeded(~S:Data,~C:Type,~R:Type,~E:Data,~Context:Type,~Meta:Type,~Reader:Type,~View:Data,~Delta:Type,~validateFn:Context -> Reader -> Context & (Reader & Bool),~prepareFn:Context -> @+cursor:Maybe<&2,Tick.Tick> -> Reader -> Context & (Reader & (View & Delta)),~commitFn:Context -> Reader -> Delta -> @+cursor:Tick.Tick -> Context & Reader,~releaseFn:Context -> Reader -> Context,~Declaration:Type,~Failure:Data,~Output:Type,
  observed:W.World<S,C,R,E> & Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>) -> Sys.Outcome<W.World<S,C,R,E>,Empty,Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>>:
  match observed:
    case (world,envelope):Sys.Succeeded{world,envelope}

def invalid_parts(~S:Data,~C:Type,~R:Type,~E:Data,~Context:Type,~Meta:Type,~Reader:Type,~View:Data,~Delta:Type,~validateFn:Context -> Reader -> Context & (Reader & Bool),~prepareFn:Context -> @+cursor:Maybe<&2,Tick.Tick> -> Reader -> Context & (Reader & (View & Delta)),~commitFn:Context -> Reader -> Delta -> @+cursor:Tick.Tick -> Context & Reader,~releaseFn:Context -> Reader -> Context,~Declaration:Type,~Failure:Data,~Output:Type,
  declaration:Declaration,parameter:RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,reader:Reader,parts:W.World<S,C,R,E> & Meta) -> Sys.Outcome<W.World<S,C,R,E>,Empty,Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>>:
  match parts:
    case (world,meta):Sys.Succeeded{world,Envelope{meta,reader,parameter,declaration,CallbackInvalidReader{}}}

def invalid_reader(~S:Data,~C:Type,~R:Type,~E:Data,~Context:Type,~Meta:Type,~Reader:Type,~View:Data,~Delta:Type,~validateFn:Context -> Reader -> Context & (Reader & Bool),~prepareFn:Context -> @+cursor:Maybe<&2,Tick.Tick> -> Reader -> Context & (Reader & (View & Delta)),~commitFn:Context -> Reader -> Delta -> @+cursor:Tick.Tick -> Context & Reader,~releaseFn:Context -> Reader -> Context,~Declaration:Type,~Failure:Data,~Output:Type,~split:Context -> W.World<S,C,R,E> & Meta,
  declaration:Declaration,parameter:RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,context:Context,reader:Reader) -> Sys.Outcome<W.World<S,C,R,E>,Empty,Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>>:
  invalid_parts(~S,~C,~R,~E,~Context,~Meta,~Reader,~View,~Delta,~validateFn,~prepareFn,~commitFn,~releaseFn,~Declaration,~Failure,~Output,declaration,parameter,reader,split(context))

def success_succeeded(~S:Data,~C:Type,~R:Type,~E:Data,~Context:Type,~Meta:Type,~Reader:Type,~View:Data,~Delta:Type,~validateFn:Context -> Reader -> Context & (Reader & Bool),~prepareFn:Context -> @+cursor:Maybe<&2,Tick.Tick> -> Reader -> Context & (Reader & (View & Delta)),~commitFn:Context -> Reader -> Delta -> @+cursor:Tick.Tick -> Context & Reader,~releaseFn:Context -> Reader -> Context,~Declaration:Type,~Failure:Data,~Output:Type,~split:Context -> W.World<S,C,R,E> & Meta,
  reader:Reader,parameter:RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,declaration:Declaration,output:Output,parts:W.World<S,C,R,E> & Meta) -> Sys.Outcome<W.World<S,C,R,E>,Empty,Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>>:
  match parts:
    case (world,meta):Sys.Succeeded{world,Envelope{meta,reader,parameter,declaration,CallbackCompleted{output}}}

def success_context(~S:Data,~C:Type,~R:Type,~E:Data,~Context:Type,~Meta:Type,~Reader:Type,~View:Data,~Delta:Type,~validateFn:Context -> Reader -> Context & (Reader & Bool),~prepareFn:Context -> @+cursor:Maybe<&2,Tick.Tick> -> Reader -> Context & (Reader & (View & Delta)),~commitFn:Context -> Reader -> Delta -> @+cursor:Tick.Tick -> Context & Reader,~releaseFn:Context -> Reader -> Context,~Declaration:Type,~Failure:Data,~Output:Type,~split:Context -> W.World<S,C,R,E> & Meta,~after:Context -> Context,
  parameter:RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,declaration:Declaration,output:Output,committed:Context & Reader) -> Sys.Outcome<W.World<S,C,R,E>,Empty,Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>>:
  match committed:
    case (context,reader):success_succeeded(~S,~C,~R,~E,~Context,~Meta,~Reader,~View,~Delta,~validateFn,~prepareFn,~commitFn,~releaseFn,~Declaration,~Failure,~Output,~split,reader,parameter,declaration,output,split(after(context)))

def commit_success(~S:Data,~C:Type,~R:Type,~E:Data,~Context:Type,~Meta:Type,~Reader:Type,~View:Data,~Delta:Type,~validateFn:Context -> Reader -> Context & (Reader & Bool),~prepareFn:Context -> @+cursor:Maybe<&2,Tick.Tick> -> Reader -> Context & (Reader & (View & Delta)),~commitFn:Context -> Reader -> Delta -> @+cursor:Tick.Tick -> Context & Reader,~releaseFn:Context -> Reader -> Context,~Declaration:Type,~Failure:Data,~Output:Type,~split:Context -> W.World<S,C,R,E> & Meta,~join:W.World<S,C,R,E> -> Meta -> Context,~after:Context -> Context,
  reader:Reader,+parameter:RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,declaration:Declaration,delta:Delta,cursor:Tick.Tick,output:Output,world:W.World<S,C,R,E>,meta:Meta) -> Sys.Outcome<W.World<S,C,R,E>,Empty,Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>>:
  success_context(~S,~C,~R,~E,~Context,~Meta,~Reader,~View,~Delta,~validateFn,~prepareFn,~commitFn,~releaseFn,~Declaration,~Failure,~Output,~split,~after,parameter,declaration,output,RP.commit(~Context,~Reader,~View,~Delta,~validateFn,~prepareFn,~commitFn,~releaseFn,parameter,join(world,meta),reader,delta,cursor))

def callback_failure(~S:Data,~C:Type,~R:Type,~E:Data,~Context:Type,~Meta:Type,~Reader:Type,~View:Data,~Delta:Type,~validateFn:Context -> Reader -> Context & (Reader & Bool),~prepareFn:Context -> @+cursor:Maybe<&2,Tick.Tick> -> Reader -> Context & (Reader & (View & Delta)),~commitFn:Context -> Reader -> Delta -> @+cursor:Tick.Tick -> Context & Reader,~releaseFn:Context -> Reader -> Context,~Declaration:Type,~Failure:Data,~Output:Type,~split:Context -> W.World<S,C,R,E> & Meta,
  reader:Reader,parameter:RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,declaration:Declaration,error:Failure,output:Output,world:W.World<S,C,R,E>,meta:Meta) -> Sys.Outcome<W.World<S,C,R,E>,Empty,Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>>:
  Sys.Succeeded{world,Envelope{meta,reader,parameter,declaration,CallbackFailed{error,output}}}

def inner_outcome(~S:Data,~C:Type,~R:Type,~E:Data,~Context:Type,~Meta:Type,~Reader:Type,~View:Data,~Delta:Type,~validateFn:Context -> Reader -> Context & (Reader & Bool),~prepareFn:Context -> @+cursor:Maybe<&2,Tick.Tick> -> Reader -> Context & (Reader & (View & Delta)),~commitFn:Context -> Reader -> Delta -> @+cursor:Tick.Tick -> Context & Reader,~releaseFn:Context -> Reader -> Context,~Declaration:Type,~Failure:Data,~Output:Type,~split:Context -> W.World<S,C,R,E> & Meta,~join:W.World<S,C,R,E> -> Meta -> Context,~after:Context -> Context,
  reader:Reader,parameter:RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,declaration:Declaration,delta:Delta,cursor:Tick.Tick,meta:Meta,output:Output,outcome:Tx.Outcome<Failure>,world:W.World<S,C,R,E>) -> Sys.Outcome<W.World<S,C,R,E>,Empty,Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>>:
  match outcome:
    case Tx.Success{}:commit_success(~S,~C,~R,~E,~Context,~Meta,~Reader,~View,~Delta,~validateFn,~prepareFn,~commitFn,~releaseFn,~Declaration,~Failure,~Output,~split,~join,~after,reader,parameter,declaration,delta,cursor,output,world,meta)
    case Tx.Failure{error}:callback_failure(~S,~C,~R,~E,~Context,~Meta,~Reader,~View,~Delta,~validateFn,~prepareFn,~commitFn,~releaseFn,~Declaration,~Failure,~Output,~split,reader,parameter,declaration,error,output,world,meta)

def transaction_returned(~S:Data,~C:Type,~R:Type,~E:Data,~Context:Type,~Meta:Type,~Reader:Type,~View:Data,~Delta:Type,~validateFn:Context -> Reader -> Context & (Reader & Bool),~prepareFn:Context -> @+cursor:Maybe<&2,Tick.Tick> -> Reader -> Context & (Reader & (View & Delta)),~commitFn:Context -> Reader -> Delta -> @+cursor:Tick.Tick -> Context & Reader,~releaseFn:Context -> Reader -> Context,~Declaration:Type,~Failure:Data,~Output:Type,~split:Context -> W.World<S,C,R,E> & Meta,~join:W.World<S,C,R,E> -> Meta -> Context,~after:Context -> Context,
  reader:Reader,parameter:RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,declaration:Declaration,delta:Delta,cursor:Tick.Tick,meta:Meta,output:Output,finished:Tx.Returned<W.World<S,C,R,E>,Failure>) -> Sys.Outcome<W.World<S,C,R,E>,Empty,Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>>:
  match finished:
    case Tx.Returned{world,outcome}:inner_outcome(~S,~C,~R,~E,~Context,~Meta,~Reader,~View,~Delta,~validateFn,~prepareFn,~commitFn,~releaseFn,~Declaration,~Failure,~Output,~split,~join,~after,reader,parameter,declaration,delta,cursor,meta,output,outcome,world)

def callback_returned(~S:Data,~C:Type,~R:Type,~E:Data,~Context:Type,~Meta:Type,~Reader:Type,~View:Data,~Delta:Type,~Args:Type,~validateFn:Context -> Reader -> Context & (Reader & Bool),~prepareFn:Context -> @+cursor:Maybe<&2,Tick.Tick> -> Reader -> Context & (Reader & (View & Delta)),~commitFn:Context -> Reader -> Delta -> @+cursor:Tick.Tick -> Context & Reader,~releaseFn:Context -> Reader -> Context,~Declaration:Type,~Failure:Data,~Output:Type,~split:Context -> W.World<S,C,R,E> & Meta,~join:W.World<S,C,R,E> -> Meta -> Context,~after:Context -> Context,~Ops:Type -> Type,~body:@-H:Type -> @-caps:Ops(H) -> (View & Args) -> H -> H & (Tx.Outcome<Failure> & Output),~grant:Ops(Tx.Tx<W.World<S,C,R,E>,E>),
  reader:Reader,parameter:RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,declaration:Declaration,delta:Delta,cursor:Tick.Tick,meta:Meta,observed:Tx.Tx<W.World<S,C,R,E>,E> & (Tx.Outcome<Failure> & Output)) -> Sys.Outcome<W.World<S,C,R,E>,Empty,Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>>:
  match observed:
    case (tx,(outcome,output)):transaction_returned(~S,~C,~R,~E,~Context,~Meta,~Reader,~View,~Delta,~validateFn,~prepareFn,~commitFn,~releaseFn,~Declaration,~Failure,~Output,~split,~join,~after,reader,parameter,declaration,delta,cursor,meta,output,Cmd.tx_finish(~S,~C,~R,~E,~Failure,tx,outcome))

def invoke_body(~S:Data,~C:Type,~R:Type,~E:Data,~Context:Type,~Meta:Type,~Reader:Type,~View:Data,~Delta:Type,~Args:Type,~validateFn:Context -> Reader -> Context & (Reader & Bool),~prepareFn:Context -> @+cursor:Maybe<&2,Tick.Tick> -> Reader -> Context & (Reader & (View & Delta)),~commitFn:Context -> Reader -> Delta -> @+cursor:Tick.Tick -> Context & Reader,~releaseFn:Context -> Reader -> Context,~Declaration:Type,~Failure:Data,~Output:Type,~split:Context -> W.World<S,C,R,E> & Meta,~join:W.World<S,C,R,E> -> Meta -> Context,~after:Context -> Context,~Ops:Type -> Type,~body:@-H:Type -> @-caps:Ops(H) -> (View & Args) -> H -> H & (Tx.Outcome<Failure> & Output),~grant:Ops(Tx.Tx<W.World<S,C,R,E>,E>),
  reader:Reader,parameter:RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,declaration:Declaration,delta:Delta,cursor:Tick.Tick,meta:Meta,args:Args,world:W.World<S,C,R,E>,view:View) -> Sys.Outcome<W.World<S,C,R,E>,Empty,Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>>:
  callback_returned(~S,~C,~R,~E,~Context,~Meta,~Reader,~View,~Delta,~Args,~validateFn,~prepareFn,~commitFn,~releaseFn,~Declaration,~Failure,~Output,~split,~join,~after,~Ops,~body,~grant,reader,parameter,declaration,delta,cursor,meta,Cap.invoke_owned(~Ops,~(View & Args),~(Tx.Outcome<Failure> & Output),~body,~Tx.Tx<W.World<S,C,R,E>,E>,~grant,(view,args),Tx.begin(~W.World<S,C,R,E>,~E,world)))

def prepared_split(~S:Data,~C:Type,~R:Type,~E:Data,~Context:Type,~Meta:Type,~Reader:Type,~View:Data,~Delta:Type,~Args:Type,~validateFn:Context -> Reader -> Context & (Reader & Bool),~prepareFn:Context -> @+cursor:Maybe<&2,Tick.Tick> -> Reader -> Context & (Reader & (View & Delta)),~commitFn:Context -> Reader -> Delta -> @+cursor:Tick.Tick -> Context & Reader,~releaseFn:Context -> Reader -> Context,~Declaration:Type,~Failure:Data,~Output:Type,~split:Context -> W.World<S,C,R,E> & Meta,~join:W.World<S,C,R,E> -> Meta -> Context,~after:Context -> Context,~Ops:Type -> Type,~body:@-H:Type -> @-caps:Ops(H) -> (View & Args) -> H -> H & (Tx.Outcome<Failure> & Output),~grant:Ops(Tx.Tx<W.World<S,C,R,E>,E>),
  reader:Reader,parameter:RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,declaration:Declaration,delta:Delta,cursor:Tick.Tick,args:Args,view:View,parts:W.World<S,C,R,E> & Meta) -> Sys.Outcome<W.World<S,C,R,E>,Empty,Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>>:
  match parts:
    case (world,meta):invoke_body(~S,~C,~R,~E,~Context,~Meta,~Reader,~View,~Delta,~Args,~validateFn,~prepareFn,~commitFn,~releaseFn,~Declaration,~Failure,~Output,~split,~join,~after,~Ops,~body,~grant,reader,parameter,declaration,delta,cursor,meta,args,world,view)

def prepared(~S:Data,~C:Type,~R:Type,~E:Data,~Context:Type,~Meta:Type,~Reader:Type,~View:Data,~Delta:Type,~Args:Type,~validateFn:Context -> Reader -> Context & (Reader & Bool),~prepareFn:Context -> @+cursor:Maybe<&2,Tick.Tick> -> Reader -> Context & (Reader & (View & Delta)),~commitFn:Context -> Reader -> Delta -> @+cursor:Tick.Tick -> Context & Reader,~releaseFn:Context -> Reader -> Context,~Declaration:Type,~Failure:Data,~Output:Type,~split:Context -> W.World<S,C,R,E> & Meta,~join:W.World<S,C,R,E> -> Meta -> Context,~after:Context -> Context,~Ops:Type -> Type,~body:@-H:Type -> @-caps:Ops(H) -> (View & Args) -> H -> H & (Tx.Outcome<Failure> & Output),~grant:Ops(Tx.Tx<W.World<S,C,R,E>,E>),
  parameter:RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,declaration:Declaration,+cursor:Tick.Tick,args:Args,observed:Context & (Reader & (View & Delta))) -> Sys.Outcome<W.World<S,C,R,E>,Empty,Envelope<Meta,Reader,RP.Param<Context,Reader,View,Delta,validateFn,prepareFn,commitFn,releaseFn>,Declaration,Failure,Output>>:
  match observed:
    case (context,(reader,(view,delta))):prepared_split(~S,~C,~R,~E,~Context,~Meta,~Reader,~View,~Delta,~Args,~validateFn,~prepareFn,~commitFn,~releaseFn,~Declaration,~Failure,~Output,~split,~join,~after,~Ops,~body,~grant,reader,parameter,declaration,delta,cursor,args,view,split(context))

