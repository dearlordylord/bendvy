def chosen(~S:Data,~components:L.Layout,~resources:L.Layout,-Left:Type,-Right:Type,-Status:Data,combine:Status -> Status -> Status,leftInvoke:State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>> -> Left -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Left,Status>>,rightInvoke:State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>> -> Right -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Right,Status>>,scope:State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,left:Left,right:Right,+leftFootprint:Footprint.Footprint<S,components,resources>,+rightFootprint:Footprint.Footprint<S,components,resources>,parent:Maybe<&2,Footprint.Footprint<S,components,resources>>,empty:Status,compatible:Bool) -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Product.Owner<Left,Right>,Status>>:
  match parent compatible:
    case Some{parent} True{}:parallel(~S,~components,~resources,Left,Right,Status,combine,leftInvoke,rightInvoke,left,right,empty,Cut.cut(~S,~components,~resources,scope,leftFootprint,rightFootprint))
    case Some{+parent} False{}:serial_cut(~S,~components,~resources,Left,Right,Status,combine,leftInvoke,rightInvoke,left,right,parent,rightFootprint,empty,Cut.cut_remainder(~S,~components,~resources,scope,leftFootprint,Footprint.remainder(~S,~components,~resources,parent,leftFootprint)))
    case None{} _:Task.TDone{Phase.LeafInventoryRefused{State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,scope,Product.Owner{left,right},empty}}
def run(~S:Data,~components:L.Layout,~resources:L.Layout,-Left:Type,-Right:Type,-Status:Data,combine:Status -> Status -> Status,leftInvoke:State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>> -> Left -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Left,Status>>,rightInvoke:State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>> -> Right -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Right,Status>>,scope:State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,left:Left,right:Right,+leftFootprint:Footprint.Footprint<S,components,resources>,+rightFootprint:Footprint.Footprint<S,components,resources>,empty:Status,compatible:Bool) -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Product.Owner<Left,Right>,Status>>:
  chosen(~S,~components,~resources,Left,Right,Status,combine,leftInvoke,rightInvoke,scope,left,right,leftFootprint,rightFootprint,Footprint.combined(~S,~components,~resources,leftFootprint,rightFootprint),empty,compatible)
