# Recursive composites return the same actual sparse parent or an actual typed
# owner inventory. The only Driver remains the enclosing ordinary Group.
def joined(~S:Data,~components:L.Layout,~resources:L.Layout,-Left:Type,-Right:Type,-Status:Data,left:Left,right:Right,status:Status,result:Cut.Joined<S,components,resources>) -> Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Product.Owner<Left,Right>,Status>:
  match result:
    case Cut.Joined{scope}:Phase.LeafResult{scope,Product.Owner{left,right},status}
    case inventory:Phase.LeafInventoryRefused{Cut.Joined<S,components,resources>,inventory,Product.Owner{left,right},status}
def parallel_returned(~S:Data,~components:L.Layout,~resources:L.Layout,-Left:Type,-Right:Type,-Status:Data,combine:Status -> Status -> Status,join:Cut.Join<S,components,resources>,left:Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Left,Status>,right:Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Right,Status>) -> Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Product.Owner<Left,Right>,Status>:
  match left right:
    case Phase.LeafResult{ls,left,lc} Phase.LeafResult{rs,right,rc}:joined(~S,~components,~resources,Left,Right,Status,left,right,combine(lc,rc),Cut.join(~S,~components,~resources,ls,rs,join))
    case Phase.LeafInventoryRefused{LI,inventory,left,lc} Phase.LeafResult{rs,right,rc}:Phase.LeafInventoryRefused{LI & (State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>> & Cut.Join<S,components,resources>),(inventory,(rs,join)),Product.Owner{left,right},combine(lc,rc)}
    case Phase.LeafResult{ls,left,lc} Phase.LeafInventoryRefused{RI,inventory,right,rc}:Phase.LeafInventoryRefused{State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>> & (RI & Cut.Join<S,components,resources>),(ls,(inventory,join)),Product.Owner{left,right},combine(lc,rc)}
    case Phase.LeafInventoryRefused{LI,li,left,lc} Phase.LeafInventoryRefused{RI,ri,right,rc}:Phase.LeafInventoryRefused{LI & (RI & Cut.Join<S,components,resources>),(li,(ri,join)),Product.Owner{left,right},combine(lc,rc)}
def parallel(~S:Data,~components:L.Layout,~resources:L.Layout,-Left:Type,-Right:Type,-Status:Data,combine:Status -> Status -> Status,leftInvoke:State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>> -> Left -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Left,Status>>,rightInvoke:State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>> -> Right -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Right,Status>>,left:Left,right:Right,empty:Status,result:Cut.Partition<S,components,resources>) -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Product.Owner<Left,Right>,Status>>:
  match result:
    case Cut.Split{ls,rs,join}:Task.TFork{Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Left,Status>,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Right,Status>,leftInvoke(ls,left),rightInvoke(rs,right),left => right => Task.TDone{parallel_returned(~S,~components,~resources,Left,Right,Status,combine,join,left,right)}}
    case inventory:Task.TDone{Phase.LeafInventoryRefused{Cut.Partition<S,components,resources>,inventory,Product.Owner{left,right},empty}}
def second_invoked(~S:Data,~components:L.Layout,~resources:L.Layout,-Left:Type,-Right:Type,-Status:Data,combine:Status -> Status -> Status,left:Left,leftStatus:Status,unused:State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,join:Cut.Join<S,components,resources>,result:Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Right,Status>) -> Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Product.Owner<Left,Right>,Status>:
  match result:
    case Phase.LeafResult{scope,right,rc}:joined(~S,~components,~resources,Left,Right,Status,left,right,combine(leftStatus,rc),Cut.join(~S,~components,~resources,scope,unused,join))
    case Phase.LeafInventoryRefused{I,inventory,right,rc}:Phase.LeafInventoryRefused{I & (State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>> & Cut.Join<S,components,resources>),(inventory,(unused,join)),Product.Owner{left,right},combine(leftStatus,rc)}
def second_cut(~S:Data,~components:L.Layout,~resources:L.Layout,-Left:Type,-Right:Type,-Status:Data,combine:Status -> Status -> Status,rightInvoke:State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>> -> Right -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Right,Status>>,left:Left,right:Right,leftStatus:Status,result:Cut.Partition<S,components,resources>) -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Product.Owner<Left,Right>,Status>>:
  match result:
    case Cut.Split{scope,unused,join}:Task.bind(S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Right,Status>,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Product.Owner<Left,Right>,Status>,rightInvoke(scope,right),result => Task.TDone{second_invoked(~S,~components,~resources,Left,Right,Status,combine,left,leftStatus,unused,join,result)})
    case inventory:Task.TDone{Phase.LeafInventoryRefused{Cut.Partition<S,components,resources>,inventory,Product.Owner{left,right},leftStatus}}
def first_joined(~S:Data,~components:L.Layout,~resources:L.Layout,-Left:Type,-Right:Type,-Status:Data,combine:Status -> Status -> Status,rightInvoke:State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>> -> Right -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Right,Status>>,left:Left,right:Right,leftStatus:Status,parent:Footprint.Footprint<S,components,resources>,+rightFootprint:Footprint.Footprint<S,components,resources>,result:Cut.Joined<S,components,resources>) -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Product.Owner<Left,Right>,Status>>:
  match result:
    case Cut.Joined{scope}:second_cut(~S,~components,~resources,Left,Right,Status,combine,rightInvoke,left,right,leftStatus,Cut.cut_remainder(~S,~components,~resources,scope,rightFootprint,Footprint.remainder(~S,~components,~resources,parent,rightFootprint)))
    case inventory:Task.TDone{Phase.LeafInventoryRefused{Cut.Joined<S,components,resources>,inventory,Product.Owner{left,right},leftStatus}}
def first_invoked(~S:Data,~components:L.Layout,~resources:L.Layout,-Left:Type,-Right:Type,-Status:Data,combine:Status -> Status -> Status,rightInvoke:State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>> -> Right -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Right,Status>>,right:Right,parent:Footprint.Footprint<S,components,resources>,rightFootprint:Footprint.Footprint<S,components,resources>,unused:State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,join:Cut.Join<S,components,resources>,result:Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Left,Status>) -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Product.Owner<Left,Right>,Status>>:
  match result:
    case Phase.LeafResult{scope,left,lc}:first_joined(~S,~components,~resources,Left,Right,Status,combine,rightInvoke,left,right,lc,parent,rightFootprint,Cut.join(~S,~components,~resources,scope,unused,join))
    case Phase.LeafInventoryRefused{I,inventory,left,lc}:Task.TDone{Phase.LeafInventoryRefused{I & (State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>> & Cut.Join<S,components,resources>),(inventory,(unused,join)),Product.Owner{left,right},lc}}
def serial_cut(~S:Data,~components:L.Layout,~resources:L.Layout,-Left:Type,-Right:Type,-Status:Data,combine:Status -> Status -> Status,leftInvoke:State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>> -> Left -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Left,Status>>,rightInvoke:State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>> -> Right -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Right,Status>>,left:Left,right:Right,parent:Footprint.Footprint<S,components,resources>,rightFootprint:Footprint.Footprint<S,components,resources>,empty:Status,result:Cut.Partition<S,components,resources>) -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Product.Owner<Left,Right>,Status>>:
