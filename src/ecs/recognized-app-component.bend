  (result,Facts.Off{})
def observed(~S:Data,~C:Type,~R:Type,~E:Data,~Ops:Type -> Type,~Args:Data,~Error:Data,~Out:Data,~Value:Data,~query:O.Declaration<S,Q.Frame<S,C,R,E>,Ops(Q.Frame<S,C,R,E>),I.Frame<S,C,R,E>,Value>,~recognized:Recognized.Declaration<S,C,R,E,Ops>,~body:@-H:Type -> @-caps:Ops(H) -> Args -> H -> H & (T.Outcome<Error> & Out),trace:Facts.State,world:W.World<S,C,R,E>,args:Args & U32) -> Sys.Outcome<W.World<S,C,R,E>,Q.Error<Error>,List<&2,Out>> & Facts.State:
  match trace:
    case Facts.Off{}:observed_result(~S,~C,~R,~E,~Error,~Out,RecognizedSystem.runner(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~recognized,~body)(world,args))
    case Facts.On{entries}:System.observable_runner_observed(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~Value,~effective_query(~S,~C,~R,~E,~Ops,~Value,~query,~recognized),~body,Facts.On{entries},world,args)
