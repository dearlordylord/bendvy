# The supplied observable declaration contributes inspection only. Operational
# authority, selection and clauses always come from the recognized carrier.
def effective_query(~S:Data,~C:Type,~R:Type,~E:Data,~Ops:Type -> Type,~Value:Data,~query:O.Declaration<S,Q.Frame<S,C,R,E>,Ops(Q.Frame<S,C,R,E>),I.Frame<S,C,R,E>,Value>,~recognized:Recognized.Declaration<S,C,R,E,Ops>) -> O.Declaration<S,Q.Frame<S,C,R,E>,Ops(Q.Frame<S,C,R,E>),I.Frame<S,C,R,E>,Value>:
  O.PreparedDeclaration{_=>Recognized.ordinary(~S,~C,~R,~E,~Ops,recognized),_=>O.inspection(~S,~Q.Frame<S,C,R,E>,~Ops(Q.Frame<S,C,R,E>),~I.Frame<S,C,R,E>,~Value,query),frame=>IQ.each_composed(~I.Frame<S,C,R,E>,~S,~Value,~O.inspect_query(~S,~C,~R,~E,~Q.Frame<S,C,R,E>,~Ops(Q.Frame<S,C,R,E>),~Value,~query),frame)}
