# The public owner type is restored only after execution. Hidden node inventory
# stays affine; callback interpretation was fixed at the closed compile witness.
type Leaf<-S:Data,-components:L.Layout,-resources:L.Layout,-E:Data,-Owner:Type,-Error:Data,-Out:Data> is Type:
  Leaf{-Held:Type,restore:Held -> Owner,inspect:W.World<S,L.columns(~S,components),L.resources(~S,resources),E> -> Held -> W.World<S,L.columns(~S,components),L.resources(~S,resources),E> & (Held & Maybe<&2,Footprint.Footprint<S,components,resources>>),prepare:List<&2,U32> -> W.World<S,L.columns(~S,components),L.resources(~S,resources),E> -> Held -> W.World<S,L.columns(~S,components),L.resources(~S,resources),E> & Held,invoke:State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>> -> Held -> Task.Task<S,Authority.Permit,Phase.LeafResult<State.Scope<S,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>>,Held,List<&2,Ready.Completed<Error,Out>>>>,permits:Held -> Held & List<&2,Prep.Permit<S,L.columns(~S,components)>>,held:Held}
type Node<-Compilation:Type,-World:Type,-Owner:Type,-Evidence:Data,-P:Data> is Type:
  Uninspected{binding:Scope.CompiledBinding<Compilation,Owner>}
  Inspected{binding:Scope.CompiledBinding<Compilation,Owner>,evidence:Maybe<&2,Evidence>,id:U32,valid:Bool}
  Prepared{held:Execution.Held<Compilation,World,Owner,Maybe<&2,Evidence>,P>}
def restored_owner(-Owner:Type,-P:Data,result:Owner & List<&2,P>) -> Owner:
  match result:
    case (owner,_):owner
def restore_node(-Compilation:Type,-World:Type,-Owner:Type,-Evidence:Data,-P:Data,node:Node<Compilation,World,Owner,Evidence,P>) -> Owner:
  match node:
    case Uninspected{Scope.CompiledBinding{_,owner}}:owner
    case Inspected{Scope.CompiledBinding{_,owner},_,_,_}:owner
    case Prepared{held}:restored_owner(Owner,P,Execution.unpack(Compilation,World,Owner,Maybe<&2,Evidence>,P,held))
def observed_node(-Compilation:Type,-World:Type,-Owner:Type,-Evidence:Data,-P:Data,result:Execution.Held<Compilation,World,Owner,Maybe<&2,Evidence>,P> & List<&2,P>) -> Node<Compilation,World,Owner,Evidence,P> & List<&2,P>:
  match result:
    case (held,permits):(Prepared{held},permits)
def permits_node(-Compilation:Type,-World:Type,-Owner:Type,-Evidence:Data,-P:Data,node:Node<Compilation,World,Owner,Evidence,P>) -> Node<Compilation,World,Owner,Evidence,P> & List<&2,P>:
  match node:
    case Prepared{held}:observed_node(Compilation,World,Owner,Evidence,P,Execution.observed_permits(Compilation,World,Owner,Maybe<&2,Evidence>,P,held))
    case node:(node,[])
