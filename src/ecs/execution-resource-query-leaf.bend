# Reinspection returns the same actual Compilation and owner. Previous permits
# and admitted Data are consumed only after the preceding group left its clock.
def registered_binding(-Compilation:Type,-World:Type,-Owner:Type,-Evidence:Data,-P:Data,node:Node<Compilation,World,Owner,Evidence,P>) -> Scope.CompiledBinding<Compilation,Owner>:
  match node:
    case Uninspected{binding}:binding
    case Inspected{binding,_,_,_}:binding
    case Prepared{Execution.HeldReady{Binding.Binding{compilation,Prep.Prepared{_,owner,_,_},_}}}:Scope.CompiledBinding{compilation,owner}
    case Prepared{Execution.HeldInventory{compilation,Prep.Inventory{owner,_},_}}:Scope.CompiledBinding{compilation,owner}
