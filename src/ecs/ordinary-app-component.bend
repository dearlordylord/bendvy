# Failure of a registered component-query invocation: CallbackFailure wraps
# its query/body error; RegistrationRefused means the registration cannot execute.
# Execution returns the application owner separately; the error owns no world.
type ExecutionError<Error:Data> is Data:
  CallbackFailure{error:Q.Error<Error>}
  RegistrationRefused{}
def callback_failure(~Error:Data,error:Q.Error<Error>) -> ExecutionError<Error>:CallbackFailure{error}
