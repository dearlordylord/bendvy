    case Prep.PreparationReady{world,Prep.Prepared{namespace,system,permits,provenance}}:Prep.PreparationReady{world,Prep.Prepared{namespace,Cmd.Owner{system},permits,provenance}}
    case Prep.PreparationRefused{world,Prep.Inventory{system,provenance}}:Prep.PreparationRefused{world,Prep.Inventory{Cmd.Owner{system},provenance}}
