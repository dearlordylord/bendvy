def refuse_permits(permits:List<&2,Scope.RawPermit>) -> List<&2,Scope.RawPermit>:
  match permits:
    case []:[]
    case Scope.RawPermit{id,_,tick} <> rest:Scope.RawPermit{id,False{},tick} <> refuse_permits(rest)
