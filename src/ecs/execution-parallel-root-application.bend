def bound_entries(entries:List<&2,Part.Entry>,+bindings:List<&2,DepApp.Binding>,+guards:List<&2,Plan.Node<String>>) -> List<&2,Part.Entry>:
  match entries:
    case []:[]
    case Part.Entry{+id,uses} <> rest:Part.Entry{id,PairApp.all_uses(id,uses,bindings,guards)} <> bound_entries(rest,bindings,guards)
