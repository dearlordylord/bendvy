# Framework callbacks are fixed before the state inventory is hidden. Both the
# Product and generalized roots use the same scheduling and completion path.
def retained_scheduled(-Actual:Type,-Error:Data,-Out:Data,plan:Plan.Build<String>,bindings:List<&2,DepApp.Binding>,rules:Part.Rules,deferred:Deferred,result:Exec.ExecutionResult<Actual,String,Error,Out>) -> Scheduled<Actual> & DepApp.Report<Error,Out>:
  match result:
    case Exec.Finished{state,events}:(Scheduled{state,plan,bindings,rules,deferred},DepApp.Finished{events})
    case Exec.Stopped{state,error,events}:(Scheduled{state,plan,bindings,rules,deferred},DepApp.Stopped{error,events})
    case Exec.Invalid{state,reason}:(Scheduled{state,plan,bindings,rules,deferred},DepApp.Invalid{reason})
def completed_scheduled(~Actual:Type,~Error:Data,~Out:Data,~completion:Exec.ExecutionResult<Actual,String,Error,Out> -> Exec.ExecutionResult<Actual,String,Error,Out>,rules:Part.Rules,systems:List<&2,U32>,settings:Settings.Settings,plan:Plan.Build<String>,bindings:List<&2,DepApp.Binding>,outcome:DeferredSchedule.Outcome<Actual,Error,Out>) -> Scheduled<Actual> & DepApp.Report<Error,Out>:
  match outcome:
    case DeferredSchedule.Outcome{result,unapplied}:retained_scheduled(Actual,Error,Out,plan,bindings,rules,Deferred{systems,settings,unapplied},completion(result))
