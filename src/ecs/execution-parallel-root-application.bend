  match result:
    case (guards,(world,Exec.Completed{output})):(DepApp.State{world,owners,guards,handler,bindings},DepApp.guard_condition(~Error,output))
    case (guards,(world,Exec.BodyError{error,_})):(DepApp.State{world,owners,guards,handler,bindings},Exec.ConditionError{error})
    case (guards,(world,Exec.AdmissionRefused{})):(DepApp.State{world,owners,guards,handler,bindings},Exec.ConditionRefused{})
