def deferred_ids(nodes:List<&2,Plan.Node<String>>) -> List<&2,U32>:
  match nodes:
    case []:[]
    case Plan.Node{id,_} <> rest:id <> deferred_ids(rest)
def deferred(-Nodes:Type,facts:Tree.GeneralizedFacts<Nodes>) -> Tree.GeneralizedFacts<Nodes>:
  match facts:
