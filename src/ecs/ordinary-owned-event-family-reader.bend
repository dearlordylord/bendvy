# Install onto an ordinary family App. done receives the extended actual owners;
# failed receives the prior App shape with returned runtime on admission refusal.
# Preserves prior observers/debug and adds metadata, not a new gameplay payload grant.
def install(~S:Data,~C:Type,~R:Type,~P:Type,~Rest:Type,~E:Data,~Domains:Data,~F:Type,~path:Product.Lens<R,Log.Log<P>,Rest>,~inject:Nat -> E,~select:List<&2,E> -> List<&2,Nat>,~identity:Pub.Domain<S,P>,~make:Domains -> Nat -> F,~sync:F -> Nat -> List<&2,E> -> F,~frame:F -> Nat -> F,~retain:F -> Nat -> List<&2,E> -> F & List<&2,E>,~inventory:F -> F & List<&2,String>,~take:F -> F & Stream.Stream<S,Nat>,~put:F -> Stream.Stream<S,Nat> -> F,~descriptor:Setup.Setup<S,R,P,Rest,E,Domains,F,path,inject,select,identity,make,sync,frame,retain,inventory,take,put>,~Owners:Type,~Request:Type,~Projection:Data,~Args:Type,~Error:Data,~at:P -> Request -> P & Projection,~body:@-H:Type -> @-read:Cap.Request<H,Request,Projection> -> H -> Args -> H & (T.Outcome<Error> & Args),~Previous:Type,~Rows:Data,~prior:W.World<S,C,R,E> -> W.World<S,C,R,E> & DTO.Observation<Rows>,~fold:Previous -> Previous & List<&2,Records.Fields<S>>,~Output:Type,done:AppReader.Application(~S,~C,~R,~E,~Nat,~FR.State<E,F,Owners>,~Args,~Unit,~Core.Reply<Error,Args>,~FR.take(~S,~Nat,~E,~F,~Owners,~take),~FR.put(~S,~Nat,~E,~F,~Owners,~put),~Core.runner(~S,~C,~R,~P,~Rest,~E,~path,~Request,~Projection,~Args,~Error,~at,~body),~Previous,~Rows,~prior,~fold) -> Output,failed:App.Application<S,C,R,E,FR.State<E,F,Owners>,Previous,Rows,prior,fold> -> Output,value:App.Application<S,C,R,E,FR.State<E,F,Owners>,Previous,Rows,prior,fold>,name:String) -> Output:
  match value:
    case App.Application{schema,runtime,previous,recipe,debug}:AppReader.installed(~S,~C,~R,~E,~Nat,~FR.State<E,F,Owners>,~Args,~Unit,~Core.Reply<Error,Args>,~FR.take(~S,~Nat,~E,~F,~Owners,~take),~FR.put(~S,~Nat,~E,~F,~Owners,~put),~Core.runner(~S,~C,~R,~P,~Rest,~E,~path,~Request,~Projection,~Args,~Error,~at,~body),~Previous,~Rows,~prior,~fold,~Output,done,failed,schema,previous,recipe,debug,register_app(~S,~C,~R,~P,~Rest,~E,~Domains,~F,~path,~inject,~select,~identity,~make,~sync,~frame,~retain,~inventory,~take,~put,~descriptor,~Owners,~Request,~Projection,~Args,~Error,~at,~body,runtime,name))
