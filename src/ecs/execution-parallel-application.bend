def ready_nodes(~Requirement:Data,pending:List<&2,Plan.Node<Requirement>>,edges:List<&2,Plan.Edge>) -> List<&2,Plan.Node<Requirement>>:
  Plan.ready(~Requirement,pending,edges)

type Scheduled<-Application:Type> is Type:
  Scheduled{application:Application,rules:Part.Rules}
def guard_selected(found:Bool,requirements:List<&2,String>,rest:List<&2,String>) -> List<&2,String>:
  match found:
    case True{}:requirements
    case False{}:rest
def guard_requirements(nodes:List<&2,Plan.Node<String>>,+id:U32) -> List<&2,String>:
  match nodes:
    case []:[]
    case Plan.Node{actual,requirements} <> rest:guard_selected(U32.is_eq(actual,id),requirements,guard_requirements(rest,id))
def selected_guard(selected:Maybe<&2,U32>,guards:List<&2,Plan.Node<String>>) -> List<&2,Part.Use>:
  match selected:
    case None{}:[]
    case Some{id}:Part.guard_uses(guard_requirements(guards,id))
def all_uses(system:U32,uses:List<&2,Part.Use>,bindings:List<&2,DepApp.Binding>,guards:List<&2,Plan.Node<String>>) -> List<&2,Part.Use>:
  List.append(&2,Part.Use,uses,selected_guard(DepApp.lookup(bindings,system),guards))

