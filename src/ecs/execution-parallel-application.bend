def ready_nodes(~Requirement:Data,pending:List<&2,Plan.Node<Requirement>>,edges:List<&2,Plan.Edge>) -> List<&2,Plan.Node<Requirement>>:
  Plan.ready(~Requirement,pending,edges)

type Scheduled<-State:Type> is Type:
  Scheduled{state:State,plan:Plan.Build<String>,bindings:List<&2,DepApp.Binding>,rules:Part.Rules}
def guard_selected(found:Bool,requirements:List<&2,String>,rest:List<&2,String>) -> List<&2,String>:
  match found:
    case True{}:requirements
    case False{}:rest
def guard_requirements(nodes:List<&2,Plan.Node<String>>,+id:U32) -> List<&2,String>:
  match nodes:
    case []:[]
    case Plan.Node{actual,requirements} <> rest:guard_selected(U32.is_eq(actual,id),requirements,guard_requirements(rest,id))
def selected_guard(selected:Maybe<&2,U32>,guards:List<&2,Plan.Node<String>>) -> List<&2,Part.Use>:
  match selected:
    case None{}:[]
    case Some{id}:Part.guard_uses(guard_requirements(guards,id))
def all_uses(system:U32,uses:List<&2,Part.Use>,bindings:List<&2,DepApp.Binding>,guards:List<&2,Plan.Node<String>>) -> List<&2,Part.Use>:
  List.append(&2,Part.Use,uses,selected_guard(DepApp.lookup(bindings,system),guards))

def mapped(-A:Type,-B:Type,action:IO(A),map:A -> B) -> IO(B):
  IO.bind(A,B,action,value => IO.pure(B,map(value)))
def guard_returned(~World:Type,~Owners:Type,~Guards:Type,~Handler:Type,~Error:Data,owners:Owners,handler:Handler,bindings:List<&2,DepApp.Binding>,result:Guards & (World & Exec.Invocation<Error,Bool>)) -> DepApp.State<World,Owners,Guards,Handler> & Exec.Condition<Error>:
  match result:
    case (guards,(world,Exec.Completed{output})):(DepApp.State{world,owners,guards,handler,bindings},DepApp.guard_condition(~Error,output))
    case (guards,(world,Exec.BodyError{error,_})):(DepApp.State{world,owners,guards,handler,bindings},Exec.ConditionError{error})
    case (guards,(world,Exec.AdmissionRefused{})):(DepApp.State{world,owners,guards,handler,bindings},Exec.ConditionRefused{})
def condition_selected(~World:Type,~Owners:Type,~Guards:Type,~Handler:Type,~Error:Data,~dispatch:Guards -> World -> U32 -> IO(Guards & (World & Exec.Invocation<Error,Bool>)),selected:Maybe<&2,U32>,state:DepApp.State<World,Owners,Guards,Handler>) -> IO(DepApp.State<World,Owners,Guards,Handler> & Exec.Condition<Error>):
  match selected state:
    case None{} state:IO.pure(DepApp.State<World,Owners,Guards,Handler> & Exec.Condition<Error>,(state,Exec.Allowed{}))
    case Some{id} DepApp.State{world,owners,guards,handler,bindings}:mapped(Guards & (World & Exec.Invocation<Error,Bool>),DepApp.State<World,Owners,Guards,Handler> & Exec.Condition<Error>,dispatch(guards,world,id),result => guard_returned(~World,~Owners,~Guards,~Handler,~Error,owners,handler,bindings,result))
