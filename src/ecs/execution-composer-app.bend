import Base
import ./dependency-composer.bend as Compose
import ./dependency-application.bend as DependencyApp
import ./dependency-registration.bend as Reg
import ./dependency-plan.bend as Plan
import ./dependency-executor.bend as Exec
import ./schema-fragments.bend as Fragment

type Composed<-S:Data,-World:Type,-Owners:Type,-Provisions:Type,-Guards:Type,-Handler:Type,-Error:Data,-Out:Data,-dispatch:Owners -> World -> U32 -> Owners & (World & Exec.Invocation<Error,Out>),-guardDispatch:Guards -> World -> U32 -> Guards & (World & Exec.Invocation<Error,Bool>),-handle:Handler -> Error -> Handler & Exec.Handling> is Type:
  Composed{application:DependencyApp.Application<World,Owners,Guards,Handler,Error,Out,dispatch,guardDispatch,handle>,fragment:Fragment.Fragment<S,Provisions>,invalid:Maybe<&2,Compose.Error>}
type CompositionReport<Error:Data,Out:Data> is Data:
  CompositionRan{report:DependencyApp.Report<Error,Out>}
  CompositionRejected{error:Compose.Error}

def guard_needs(~S:Data,~World:Type,~Guards:Type,~Error:Data,~guardDispatch:Guards -> World -> U32 -> Guards & (World & Exec.Invocation<Error,Bool>),guards:Reg.ConditionRegistry<World,Guards,Error,guardDispatch>,entries:List<&2,Fragment.Entry<S>>) -> Reg.ConditionRegistry<World,Guards,Error,guardDispatch> & Maybe<&2,Compose.Error>:
  match guards:
    case Reg.ConditionRegistry{Reg.Registry{owners,+nodes},+invalid}:(Reg.ConditionRegistry{Reg.Registry{owners,nodes},invalid},Compose.first_error(Compose.schedule_error(invalid),Compose.schedule_error(Compose.missing(~S,nodes,entries))))
def built_guards(~S:Data,~World:Type,~Owners:Type,~Provisions:Type,~Guards:Type,~Handler:Type,~Error:Data,~Out:Data,~dispatch:Owners -> World -> U32 -> Owners & (World & Exec.Invocation<Error,Out>),~guardDispatch:Guards -> World -> U32 -> Guards & (World & Exec.Invocation<Error,Bool>),~handle:Handler -> Error -> Handler & Exec.Handling,world:World,feature:Compose.Feature<S,World,Owners,Provisions,Error,Out,dispatch>,handler:Handler,bindings:List<&2,DependencyApp.Binding>,invalid:Maybe<&2,Compose.Error>,checked:Reg.ConditionRegistry<World,Guards,Error,guardDispatch> & Maybe<&2,Compose.Error>) -> Composed<S,World,Owners,Provisions,Guards,Handler,Error,Out,dispatch,guardDispatch,handle>:
  match feature checked:
    case Compose.Feature{registry,fragment,edges,_}, (guards,guardInvalid):Composed{DependencyApp.build(~World,~Owners,~Guards,~Handler,~Error,~Out,~dispatch,~guardDispatch,~handle,~Compose.available,world,registry,guards,handler,edges,bindings),fragment,Compose.first_error(invalid,guardInvalid)}
def build_checked(~S:Data,~World:Type,~Owners:Type,~Provisions:Type,~Guards:Type,~Handler:Type,~Error:Data,~Out:Data,~dispatch:Owners -> World -> U32 -> Owners & (World & Exec.Invocation<Error,Out>),~guardDispatch:Guards -> World -> U32 -> Guards & (World & Exec.Invocation<Error,Bool>),~handle:Handler -> Error -> Handler & Exec.Handling,world:World,handler:Handler,guards:Reg.ConditionRegistry<World,Guards,Error,guardDispatch>,bindings:List<&2,DependencyApp.Binding>,invalid:Maybe<&2,Compose.Error>,feature:Compose.Feature<S,World,Owners,Provisions,Error,Out,dispatch>) -> Composed<S,World,Owners,Provisions,Guards,Handler,Error,Out,dispatch,guardDispatch,handle>:
  match feature:
    case Compose.Feature{registry,Fragment.Fragment{+entries,provisions},edges,prior}:built_guards(~S,~World,~Owners,~Provisions,~Guards,~Handler,~Error,~Out,~dispatch,~guardDispatch,~handle,world,Compose.Feature{registry,Fragment.Fragment{entries,provisions},edges,prior},handler,bindings,invalid,guard_needs(~S,~World,~Guards,~Error,~guardDispatch,guards,entries))
def build_prepared(~S:Data,~World:Type,~Owners:Type,~Provisions:Type,~Guards:Type,~Handler:Type,~Error:Data,~Out:Data,~dispatch:Owners -> World -> U32 -> Owners & (World & Exec.Invocation<Error,Out>),~guardDispatch:Guards -> World -> U32 -> Guards & (World & Exec.Invocation<Error,Bool>),~handle:Handler -> Error -> Handler & Exec.Handling,world:World,handler:Handler,guards:Reg.ConditionRegistry<World,Guards,Error,guardDispatch>,bindings:List<&2,DependencyApp.Binding>,prepared:Compose.Prepared<S,World,Owners,Provisions,Error,Out,dispatch>) -> Composed<S,World,Owners,Provisions,Guards,Handler,Error,Out,dispatch,guardDispatch,handle>:
  match prepared:
    case Compose.CompositionReady{feature,_}:build_checked(~S,~World,~Owners,~Provisions,~Guards,~Handler,~Error,~Out,~dispatch,~guardDispatch,~handle,world,handler,guards,bindings,None{},feature)
    case Compose.CompositionRefused{feature,error}:build_checked(~S,~World,~Owners,~Provisions,~Guards,~Handler,~Error,~Out,~dispatch,~guardDispatch,~handle,world,handler,guards,bindings,Some{error},feature)
def build(~S:Data,~World:Type,~Owners:Type,~Provisions:Type,~Guards:Type,~Handler:Type,~Error:Data,~Out:Data,~dispatch:Owners -> World -> U32 -> Owners & (World & Exec.Invocation<Error,Out>),~guardDispatch:Guards -> World -> U32 -> Guards & (World & Exec.Invocation<Error,Bool>),~handle:Handler -> Error -> Handler & Exec.Handling,world:World,feature:Compose.Feature<S,World,Owners,Provisions,Error,Out,dispatch>,guards:Reg.ConditionRegistry<World,Guards,Error,guardDispatch>,handler:Handler,bindings:List<&2,DependencyApp.Binding>) -> Composed<S,World,Owners,Provisions,Guards,Handler,Error,Out,dispatch,guardDispatch,handle>:
  build_prepared(~S,~World,~Owners,~Provisions,~Guards,~Handler,~Error,~Out,~dispatch,~guardDispatch,~handle,world,handler,guards,bindings,Compose.prepare(~S,~World,~Owners,~Provisions,~Error,~Out,~dispatch,feature))
def run_returned(~S:Data,~World:Type,~Owners:Type,~Provisions:Type,~Guards:Type,~Handler:Type,~Error:Data,~Out:Data,~dispatch:Owners -> World -> U32 -> Owners & (World & Exec.Invocation<Error,Out>),~guardDispatch:Guards -> World -> U32 -> Guards & (World & Exec.Invocation<Error,Bool>),~handle:Handler -> Error -> Handler & Exec.Handling,fragment:Fragment.Fragment<S,Provisions>,invalid:Maybe<&2,Compose.Error>,result:DependencyApp.Application<World,Owners,Guards,Handler,Error,Out,dispatch,guardDispatch,handle> & DependencyApp.Report<Error,Out>) -> Composed<S,World,Owners,Provisions,Guards,Handler,Error,Out,dispatch,guardDispatch,handle> & CompositionReport<Error,Out>:
  match result:
    case (application,report):(Composed{application,fragment,invalid},CompositionRan{report})
def run_checked(~S:Data,~World:Type,~Owners:Type,~Provisions:Type,~Guards:Type,~Handler:Type,~Error:Data,~Out:Data,~dispatch:Owners -> World -> U32 -> Owners & (World & Exec.Invocation<Error,Out>),~guardDispatch:Guards -> World -> U32 -> Guards & (World & Exec.Invocation<Error,Bool>),~handle:Handler -> Error -> Handler & Exec.Handling,invalid:Maybe<&2,Compose.Error>,application:DependencyApp.Application<World,Owners,Guards,Handler,Error,Out,dispatch,guardDispatch,handle>,fragment:Fragment.Fragment<S,Provisions>) -> Composed<S,World,Owners,Provisions,Guards,Handler,Error,Out,dispatch,guardDispatch,handle> & CompositionReport<Error,Out>:
  match invalid:
    case Some{+error}:(Composed{application,fragment,Some{error}},CompositionRejected{error})
    case None{}:run_returned(~S,~World,~Owners,~Provisions,~Guards,~Handler,~Error,~Out,~dispatch,~guardDispatch,~handle,fragment,None{},DependencyApp.run(~World,~Owners,~Guards,~Handler,~Error,~Out,~dispatch,~guardDispatch,~handle,application))
def run(~S:Data,~World:Type,~Owners:Type,~Provisions:Type,~Guards:Type,~Handler:Type,~Error:Data,~Out:Data,~dispatch:Owners -> World -> U32 -> Owners & (World & Exec.Invocation<Error,Out>),~guardDispatch:Guards -> World -> U32 -> Guards & (World & Exec.Invocation<Error,Bool>),~handle:Handler -> Error -> Handler & Exec.Handling,composed:Composed<S,World,Owners,Provisions,Guards,Handler,Error,Out,dispatch,guardDispatch,handle>) -> Composed<S,World,Owners,Provisions,Guards,Handler,Error,Out,dispatch,guardDispatch,handle> & CompositionReport<Error,Out>:
  match composed:
    case Composed{application,fragment,invalid}:run_checked(~S,~World,~Owners,~Provisions,~Guards,~Handler,~Error,~Out,~dispatch,~guardDispatch,~handle,invalid,application,fragment)
