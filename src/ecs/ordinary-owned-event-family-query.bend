# Transport is closed and always succeeds. Semantic failure must not advance the
# ordinary query cursor; the returned receipt remains outside Sys.Failed erasure.
def success_cursor(~S:Data,~C:Type,~R:Type,~E:Data,~Recovery:Type,~EventOps:Type -> Type,~builder:Events.Builder(~W.World<S,C,R,E>,~Recovery,~EventOps),~events:Events.Declaration<S,W.World<S,C,R,E>,Recovery,EventOps,builder>,~Ops:Type -> Type,~A:Data,~U:Data,~Out:Data,~query:Decl.Declaration<S,Q.Frame<S,C,R,E>,Ops(Q.Frame<S,C,R,E>)>,~body:@-H:Type -> @-caps:Ops(H) -> @-J:Type -> @-emit:EventOps(J) -> A -> H -> J -> H & (J & (T.Outcome<U> & Out)),registry:Sys.Registry<S,C,R,E,A & U32,Unit,Reply<Q.Error<U>,List<&2,Out>,Recovery>,runner(~S,~C,~R,~E,~Recovery,~EventOps,~builder,~events,~Ops,~A,~U,~Out,~query,~body)>,reply:Reply<Q.Error<U>,List<&2,Out>,Recovery>,observed:W.World<S,C,R,E> & U32) -> Sys.RunResult<S,C,R,E,A & U32,Unit,Reply<Q.Error<U>,List<&2,Out>,Recovery>,runner(~S,~C,~R,~E,~Recovery,~EventOps,~builder,~events,~Ops,~A,~U,~Out,~query,~body)>:
  match registry observed:
    case Sys.Registry{namespace,id,name,access,_}, (world,clock):Sys.Completed{Sys.Registry{namespace,id,name,access,clock},Sys.Succeeded{world,reply}}
def completed(~S:Data,~C:Type,~R:Type,~E:Data,~Recovery:Type,~EventOps:Type -> Type,~builder:Events.Builder(~W.World<S,C,R,E>,~Recovery,~EventOps),~events:Events.Declaration<S,W.World<S,C,R,E>,Recovery,EventOps,builder>,~Ops:Type -> Type,~A:Data,~U:Data,~Out:Data,~query:Decl.Declaration<S,Q.Frame<S,C,R,E>,Ops(Q.Frame<S,C,R,E>)>,~body:@-H:Type -> @-caps:Ops(H) -> @-J:Type -> @-emit:EventOps(J) -> A -> H -> J -> H & (J & (T.Outcome<U> & Out)),result:Sys.RunResult<S,C,R,E,A & U32,Unit,Reply<Q.Error<U>,List<&2,Out>,Recovery>,runner(~S,~C,~R,~E,~Recovery,~EventOps,~builder,~events,~Ops,~A,~U,~Out,~query,~body)>) -> Sys.RunResult<S,C,R,E,A & U32,Unit,Reply<Q.Error<U>,List<&2,Out>,Recovery>,runner(~S,~C,~R,~E,~Recovery,~EventOps,~builder,~events,~Ops,~A,~U,~Out,~query,~body)>:
  match result:
    case Sys.Completed{registry,Sys.Succeeded{world,Reply{T.Success{},values,recovered}}}:success_cursor(~S,~C,~R,~E,~Recovery,~EventOps,~builder,~events,~Ops,~A,~U,~Out,~query,~body,registry,Reply{T.Success{},values,recovered},W.clock(~S,~C,~R,~E,world))
    case result:result

def run_observed(~S:Data,~C:Type,~R:Type,~E:Data,~Recovery:Type,~EventOps:Type -> Type,~builder:Events.Builder(~W.World<S,C,R,E>,~Recovery,~EventOps),~events:Events.Declaration<S,W.World<S,C,R,E>,Recovery,EventOps,builder>,~Ops:Type -> Type,~A:Data,~U:Data,~Out:Data,~query:Decl.Declaration<S,Q.Frame<S,C,R,E>,Ops(Q.Frame<S,C,R,E>)>,~body:@-H:Type -> @-caps:Ops(H) -> @-J:Type -> @-emit:EventOps(J) -> A -> H -> J -> H & (J & (T.Outcome<U> & Out)),world:W.World<S,C,R,E>,args:A,observed:Sys.Registry<S,C,R,E,A & U32,Unit,Reply<Q.Error<U>,List<&2,Out>,Recovery>,runner(~S,~C,~R,~E,~Recovery,~EventOps,~builder,~events,~Ops,~A,~U,~Out,~query,~body)> & U32) -> Sys.RunResult<S,C,R,E,A & U32,Unit,Reply<Q.Error<U>,List<&2,Out>,Recovery>,runner(~S,~C,~R,~E,~Recovery,~EventOps,~builder,~events,~Ops,~A,~U,~Out,~query,~body)>:
  match observed:
