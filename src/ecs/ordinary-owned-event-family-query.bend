  body(H,caps,Journal.Stage<W.World<S,C,R,E>,Recovery>,Events.root_grant(~S,~W.World<S,C,R,E>,~Recovery,~EventOps,~builder),args,owner,stage)
type Reply<Error:Data,Out:Type,Recovery:Type> is Type:
  Reply{outcome:T.Outcome<Error>,output:Out,recovered:Recovery}
def finished(~S:Data,~C:Type,~R:Type,~E:Data,~Recovery:Type,~U:Data,~Out:Data,outcome:T.Outcome<Q.Error<U>>,values:List<&2,Out>,result:W.World<S,C,R,E> & Recovery) -> Sys.Outcome<W.World<S,C,R,E>,Unit,Reply<Q.Error<U>,List<&2,Out>,Recovery>>:
  match result:
    case (world,recovered):Sys.Succeeded{world,Reply{outcome,values,recovered}}
def executing(~S:Data,~C:Type,~R:Type,~E:Data,~Recovery:Type,~U:Data,~Out:Data,empty:Unit -> Recovery,result:Fold.Executed<W.World<S,C,R,E>,Journal.Stage<W.World<S,C,R,E>,Recovery>,Q.Error<U>,Out>) -> Sys.Outcome<W.World<S,C,R,E>,Unit,Reply<Q.Error<U>,List<&2,Out>,Recovery>>:
  match result:
    case Fold.Executed{world,stage,T.Success{},values}:finished(~S,~C,~R,~E,~Recovery,~U,~Out,T.Success{},values,Journal.finish(~W.World<S,C,R,E>,~Recovery,stage,True{},world,empty(Unit{})))
    case Fold.Executed{world,stage,T.Failure{error},_}:finished(~S,~C,~R,~E,~Recovery,~U,~Out,T.Failure{error},[],Journal.finish(~W.World<S,C,R,E>,~Recovery,stage,False{},world,empty(Unit{})))
def runner(~S:Data,~C:Type,~R:Type,~E:Data,~Recovery:Type,~EventOps:Type -> Type,~builder:Events.Builder(~W.World<S,C,R,E>,~Recovery,~EventOps),~events:Events.Declaration<S,W.World<S,C,R,E>,Recovery,EventOps,builder>,~Ops:Type -> Type,~A:Data,~U:Data,~Out:Data,~query:Decl.Declaration<S,Q.Frame<S,C,R,E>,Ops(Q.Frame<S,C,R,E>)>,~body:@-H:Type -> @-caps:Ops(H) -> @-J:Type -> @-emit:EventOps(J) -> A -> H -> J -> H & (J & (T.Outcome<U> & Out)),world:W.World<S,C,R,E>,input:A & U32) -> Sys.Outcome<W.World<S,C,R,E>,Unit,Reply<Q.Error<U>,List<&2,Out>,Recovery>>:
  match input:
    case (args,cursor):executing(~S,~C,~R,~E,~Recovery,~U,~Out,Events.empty(~S,~W.World<S,C,R,E>,~Recovery,~EventOps,~builder,events),Fold.each_since(~S,~C,~R,~E,~Journal.Stage<W.World<S,C,R,E>,Recovery>,~U,~Out,~Ops,~A,~plan(~S,~C,~R,~E,~Ops,~query),~row(~S,~C,~R,~E,~Recovery,~EventOps,~builder,~Ops,~A,~U,~Out,~body),args,cursor,Journal.empty(~W.World<S,C,R,E>,~Recovery),world))
def Registry(~S:Data,~C:Type,~R:Type,~E:Data,~Recovery:Type,~EventOps:Type -> Type,~builder:Events.Builder(~W.World<S,C,R,E>,~Recovery,~EventOps),~events:Events.Declaration<S,W.World<S,C,R,E>,Recovery,EventOps,builder>,~Ops:Type -> Type,~A:Data,~U:Data,~Out:Data,~query:Decl.Declaration<S,Q.Frame<S,C,R,E>,Ops(Q.Frame<S,C,R,E>)>,~body:@-H:Type -> @-caps:Ops(H) -> @-J:Type -> @-emit:EventOps(J) -> A -> H -> J -> H & (J & (T.Outcome<U> & Out))) -> Type:Sys.Registry<S,C,R,E,A & U32,Unit,Reply<Q.Error<U>,List<&2,Out>,Recovery>,runner(~S,~C,~R,~E,~Recovery,~EventOps,~builder,~events,~Ops,~A,~U,~Out,~query,~body)>
def define(~S:Data,~C:Type,~R:Type,~E:Data,~Recovery:Type,~EventOps:Type -> Type,~builder:Events.Builder(~W.World<S,C,R,E>,~Recovery,~EventOps),~events:Events.Declaration<S,W.World<S,C,R,E>,Recovery,EventOps,builder>,~Ops:Type -> Type,~A:Data,~U:Data,~Out:Data,~query:Decl.Declaration<S,Q.Frame<S,C,R,E>,Ops(Q.Frame<S,C,R,E>)>,~body:@-H:Type -> @-caps:Ops(H) -> @-J:Type -> @-emit:EventOps(J) -> A -> H -> J -> H & (J & (T.Outcome<U> & Out)),world:W.World<S,C,R,E>,name:String) -> Sys.RegistrationResult<S,C,R,E,A & U32,Unit,Reply<Q.Error<U>,List<&2,Out>,Recovery>,runner(~S,~C,~R,~E,~Recovery,~EventOps,~builder,~events,~Ops,~A,~U,~Out,~query,~body)>:
