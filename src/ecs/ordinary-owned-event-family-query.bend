def run(~S:Data,~C:Type,~R:Type,~E:Data,~Recovery:Type,~EventOps:Type -> Type,~builder:Events.Builder(~W.World<S,C,R,E>,~Recovery,~EventOps),~events:Events.Declaration<S,W.World<S,C,R,E>,Recovery,EventOps,builder>,~Ops:Type -> Type,~A:Data,~U:Data,~Out:Data,~query:Decl.Declaration<S,Q.Frame<S,C,R,E>,Ops(Q.Frame<S,C,R,E>)>,~body:@-H:Type -> @-caps:Ops(H) -> @-J:Type -> @-emit:EventOps(J) -> A -> H -> J -> H & (J & (T.Outcome<U> & Out)),registry:Sys.Registry<S,C,R,E,A & U32,Unit,Reply<Q.Error<U>,List<&2,Out>,Recovery>,runner(~S,~C,~R,~E,~Recovery,~EventOps,~builder,~events,~Ops,~A,~U,~Out,~query,~body)>,world:W.World<S,C,R,E>,args:A) -> Sys.RunResult<S,C,R,E,A & U32,Unit,Reply<Q.Error<U>,List<&2,Out>,Recovery>,runner(~S,~C,~R,~E,~Recovery,~EventOps,~builder,~events,~Ops,~A,~U,~Out,~query,~body)>:
  run_observed(~S,~C,~R,~E,~Recovery,~EventOps,~builder,~events,~Ops,~A,~U,~Out,~query,~body,world,args,Sys.cursor(~S,~C,~R,~E,~(A & U32),~Unit,~Reply<Q.Error<U>,List<&2,Out>,Recovery>,~runner(~S,~C,~R,~E,~Recovery,~EventOps,~builder,~events,~Ops,~A,~U,~Out,~query,~body),registry))
