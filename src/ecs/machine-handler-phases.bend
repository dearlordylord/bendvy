import Base
import ./world.bend as W
import ./system.bend as Sys
import ./machine.bend as M
import ./machine-handlers.bend as H
import ./machine-handler-engine.bend as Engine

# Generic existing handler prepare/commit/retry sequencing; C and R remain affine Type.
type Intent<V:Data> is Data:
  Idle{}
  BendvyReady{from:V,to:V,skipSame:Bool}
  InitialReady{to:V}
type Owners<S:Data,K:Data,V:Data,C:Type,R:Type,E:Data,-runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>> is Type:
  Owners{handlers:H.Owners<S,C,R,E,V,runner>,intent:Intent<V>}
def published_with(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~State:Type,~invoke:H.Entry<S,C,R,E,V,runner> -> State -> H.Phase -> V -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~initial:H.Entry<S,C,R,E,V,runner> -> State -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~take:State -> State & M.Slot<S,K,V>,~put:State -> M.Slot<S,K,V> -> State,~publish:State -> M.Transition<V> -> State,~same:V -> V -> Bool,~frame:State -> State,world:State,event:M.Transition<V>) -> State:publish(world,event)

def requeued_with(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~State:Type,~invoke:H.Entry<S,C,R,E,V,runner> -> State -> H.Phase -> V -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~initial:H.Entry<S,C,R,E,V,runner> -> State -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~take:State -> State & M.Slot<S,K,V>,~put:State -> M.Slot<S,K,V> -> State,~publish:State -> M.Transition<V> -> State,~same:V -> V -> Bool,~frame:State -> State,to:V,skipSame:Bool,pair:State & M.Slot<S,K,V>) -> State:
  (world,slot)=pair
  put(world,M.queue(~S,~K,~V,slot,to,skipSame))

def committed_with(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~State:Type,~invoke:H.Entry<S,C,R,E,V,runner> -> State -> H.Phase -> V -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~initial:H.Entry<S,C,R,E,V,runner> -> State -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~take:State -> State & M.Slot<S,K,V>,~put:State -> M.Slot<S,K,V> -> State,~publish:State -> M.Transition<V> -> State,~same:V -> V -> Bool,~frame:State -> State,+from:V,+to:V,pair:State & M.Slot<S,K,V>) -> State:
  (world,slot)=pair
  published_with(~S,~K,~V,~C,~R,~E,~runner,~State,~invoke,~initial,~take,~put,~publish,~same,~frame,put(world,H.committed(~S,~K,~V,slot,from,to)),M.Transition{from,to})

def prepared_with(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~State:Type,~invoke:H.Entry<S,C,R,E,V,runner> -> State -> H.Phase -> V -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~initial:H.Entry<S,C,R,E,V,runner> -> State -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~take:State -> State & M.Slot<S,K,V>,~put:State -> M.Slot<S,K,V> -> State,~publish:State -> M.Transition<V> -> State,~same:V -> V -> Bool,~frame:State -> State,handlers:H.Owners<S,C,R,E,V,runner>,world:State,value:H.Prepared<S,K,V>) -> Owners<S,K,V,C,R,E,runner> & Sys.Outcome<State,String,Unit>:
  match value:
    case H.Idle{slot}:(Owners{handlers,Idle{}},Sys.Succeeded{put(world,slot),Unit{}})
    case H.BendvyReady{slot,M.Initial{to},_}:(Owners{handlers,InitialReady{to}},Sys.Succeeded{put(world,slot),Unit{}})
    case H.BendvyReady{slot,M.Transition{from,to},skipSame}:(Owners{handlers,BendvyReady{from,to,skipSame}},Sys.Succeeded{put(world,slot),Unit{}})

def captured_with(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~State:Type,~invoke:H.Entry<S,C,R,E,V,runner> -> State -> H.Phase -> V -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~initial:H.Entry<S,C,R,E,V,runner> -> State -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~take:State -> State & M.Slot<S,K,V>,~put:State -> M.Slot<S,K,V> -> State,~publish:State -> M.Transition<V> -> State,~same:V -> V -> Bool,~frame:State -> State,handlers:H.Owners<S,C,R,E,V,runner>,pair:State & M.Slot<S,K,V>) -> Owners<S,K,V,C,R,E,runner> & Sys.Outcome<State,String,Unit>:
  (world,+slot)=pair
  prepared_with(~S,~K,~V,~C,~R,~E,~runner,~State,~invoke,~initial,~take,~put,~publish,~same,~frame,handlers,world,H.prepare(~S,~K,~V,~same,slot,M.snapshot(~S,~K,~V,slot)))

def apply_with(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~State:Type,~invoke:H.Entry<S,C,R,E,V,runner> -> State -> H.Phase -> V -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~initial:H.Entry<S,C,R,E,V,runner> -> State -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~take:State -> State & M.Slot<S,K,V>,~put:State -> M.Slot<S,K,V> -> State,~publish:State -> M.Transition<V> -> State,~same:V -> V -> Bool,~frame:State -> State,owners:Owners<S,K,V,C,R,E,runner>,world:State) -> Owners<S,K,V,C,R,E,runner> & Sys.Outcome<State,String,Unit>:
  match owners:
    case Owners{handlers,_}:captured_with(~S,~K,~V,~C,~R,~E,~runner,~State,~invoke,~initial,~take,~put,~publish,~same,~frame,handlers,take(frame(world)))

def exited_with(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~State:Type,~invoke:H.Entry<S,C,R,E,V,runner> -> State -> H.Phase -> V -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~initial:H.Entry<S,C,R,E,V,runner> -> State -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~take:State -> State & M.Slot<S,K,V>,~put:State -> M.Slot<S,K,V> -> State,~publish:State -> M.Transition<V> -> State,~same:V -> V -> Bool,~frame:State -> State,transition:List<&1,H.Entry<S,C,R,E,V,runner>>,enter:List<&1,H.Entry<S,C,R,E,V,runner>>,+from:V,+to:V,+skipSame:Bool,result:Engine.PhaseResult<State,H.Entry<S,C,R,E,V,runner>>) -> Owners<S,K,V,C,R,E,runner> & Sys.Outcome<State,String,Unit>:
  match result:
    case Engine.Complete{exit,world}:(Owners{H.Owners{exit,transition,enter},BendvyReady{from,to,skipSame}},Sys.Succeeded{world,Unit{}})
    case Engine.Failed{exit,world,error}:(Owners{H.Owners{exit,transition,enter},BendvyReady{from,to,skipSame}},Sys.Failed{requeued_with(~S,~K,~V,~C,~R,~E,~runner,~State,~invoke,~initial,~take,~put,~publish,~same,~frame,to,skipSame,take(world)),error})

def exit_with(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~State:Type,~invoke:H.Entry<S,C,R,E,V,runner> -> State -> H.Phase -> V -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~initial:H.Entry<S,C,R,E,V,runner> -> State -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~take:State -> State & M.Slot<S,K,V>,~put:State -> M.Slot<S,K,V> -> State,~publish:State -> M.Transition<V> -> State,~same:V -> V -> Bool,~frame:State -> State,owners:Owners<S,K,V,C,R,E,runner>,world:State) -> Owners<S,K,V,C,R,E,runner> & Sys.Outcome<State,String,Unit>:
  match owners:
    case Owners{handlers,Idle{}}:(Owners{handlers,Idle{}},Sys.Succeeded{world,Unit{}})
    case Owners{handlers,InitialReady{to}}:(Owners{handlers,InitialReady{to}},Sys.Succeeded{world,Unit{}})
    case Owners{H.Owners{exit,transition,enter},BendvyReady{+from,+to,+skipSame}}:exited_with(~S,~K,~V,~C,~R,~E,~runner,~State,~invoke,~initial,~take,~put,~publish,~same,~frame,transition,enter,from,to,skipSame,Engine.run_phase(~S,~State,~H.Entry<S,C,R,E,V,runner>,~H.Phase,~V,~invoke,~initial,~H.BendvyExit{},~H.Transition{},~H.Enter{},exit,world,H.BendvyExit{},from,to,None{}))

def transitioned_with(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~State:Type,~invoke:H.Entry<S,C,R,E,V,runner> -> State -> H.Phase -> V -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~initial:H.Entry<S,C,R,E,V,runner> -> State -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~take:State -> State & M.Slot<S,K,V>,~put:State -> M.Slot<S,K,V> -> State,~publish:State -> M.Transition<V> -> State,~same:V -> V -> Bool,~frame:State -> State,exit:List<&1,H.Entry<S,C,R,E,V,runner>>,enter:List<&1,H.Entry<S,C,R,E,V,runner>>,+from:V,+to:V,+skipSame:Bool,result:Engine.PhaseResult<State,H.Entry<S,C,R,E,V,runner>>) -> Owners<S,K,V,C,R,E,runner> & Sys.Outcome<State,String,Unit>:
  match result:
    case Engine.Complete{transition,world}:(Owners{H.Owners{exit,transition,enter},BendvyReady{from,to,skipSame}},Sys.Succeeded{committed_with(~S,~K,~V,~C,~R,~E,~runner,~State,~invoke,~initial,~take,~put,~publish,~same,~frame,from,to,take(world)),Unit{}})
    case Engine.Failed{transition,world,error}:(Owners{H.Owners{exit,transition,enter},BendvyReady{from,to,skipSame}},Sys.Failed{requeued_with(~S,~K,~V,~C,~R,~E,~runner,~State,~invoke,~initial,~take,~put,~publish,~same,~frame,to,skipSame,take(world)),error})

def transition_with(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~State:Type,~invoke:H.Entry<S,C,R,E,V,runner> -> State -> H.Phase -> V -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~initial:H.Entry<S,C,R,E,V,runner> -> State -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~take:State -> State & M.Slot<S,K,V>,~put:State -> M.Slot<S,K,V> -> State,~publish:State -> M.Transition<V> -> State,~same:V -> V -> Bool,~frame:State -> State,owners:Owners<S,K,V,C,R,E,runner>,world:State) -> Owners<S,K,V,C,R,E,runner> & Sys.Outcome<State,String,Unit>:
  match owners:
    case Owners{handlers,Idle{}}:(Owners{handlers,Idle{}},Sys.Succeeded{world,Unit{}})
    case Owners{handlers,InitialReady{to}}:(Owners{handlers,InitialReady{to}},Sys.Succeeded{world,Unit{}})
    case Owners{H.Owners{exit,transition,enter},BendvyReady{+from,+to,+skipSame}}:transitioned_with(~S,~K,~V,~C,~R,~E,~runner,~State,~invoke,~initial,~take,~put,~publish,~same,~frame,exit,enter,from,to,skipSame,Engine.run_phase(~S,~State,~H.Entry<S,C,R,E,V,runner>,~H.Phase,~V,~invoke,~initial,~H.BendvyExit{},~H.Transition{},~H.Enter{},transition,world,H.Transition{},from,to,None{}))

def entered_with(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~State:Type,~invoke:H.Entry<S,C,R,E,V,runner> -> State -> H.Phase -> V -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~initial:H.Entry<S,C,R,E,V,runner> -> State -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~take:State -> State & M.Slot<S,K,V>,~put:State -> M.Slot<S,K,V> -> State,~publish:State -> M.Transition<V> -> State,~same:V -> V -> Bool,~frame:State -> State,exit:List<&1,H.Entry<S,C,R,E,V,runner>>,transition:List<&1,H.Entry<S,C,R,E,V,runner>>,intent:Intent<V>,result:Engine.PhaseResult<State,H.Entry<S,C,R,E,V,runner>>) -> Owners<S,K,V,C,R,E,runner> & Sys.Outcome<State,String,Unit>:
  match result:
    case Engine.Complete{enter,world}:(Owners{H.Owners{exit,transition,enter},intent},Sys.Succeeded{world,Unit{}})
    case Engine.Failed{enter,world,error}:(Owners{H.Owners{exit,transition,enter},intent},Sys.Failed{world,error})

def enter_with(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~State:Type,~invoke:H.Entry<S,C,R,E,V,runner> -> State -> H.Phase -> V -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~initial:H.Entry<S,C,R,E,V,runner> -> State -> V -> H.Entry<S,C,R,E,V,runner> & Sys.Outcome<State,String,Unit>,~take:State -> State & M.Slot<S,K,V>,~put:State -> M.Slot<S,K,V> -> State,~publish:State -> M.Transition<V> -> State,~same:V -> V -> Bool,~frame:State -> State,owners:Owners<S,K,V,C,R,E,runner>,world:State) -> Owners<S,K,V,C,R,E,runner> & Sys.Outcome<State,String,Unit>:
  match owners:
    case Owners{handlers,Idle{}}:(Owners{handlers,Idle{}},Sys.Succeeded{world,Unit{}})
    case Owners{H.Owners{exit,transition,enter},InitialReady{+to}}:entered_with(~S,~K,~V,~C,~R,~E,~runner,~State,~invoke,~initial,~take,~put,~publish,~same,~frame,exit,transition,InitialReady{to},Engine.run_initial(~S,~State,~H.Entry<S,C,R,E,V,runner>,~H.Phase,~V,~invoke,~initial,~H.BendvyExit{},~H.Transition{},~H.Enter{},enter,world,to,None{}))
    case Owners{H.Owners{exit,transition,enter},BendvyReady{+from,+to,+skipSame}}:entered_with(~S,~K,~V,~C,~R,~E,~runner,~State,~invoke,~initial,~take,~put,~publish,~same,~frame,exit,transition,BendvyReady{from,to,skipSame},Engine.run_phase(~S,~State,~H.Entry<S,C,R,E,V,runner>,~H.Phase,~V,~invoke,~initial,~H.BendvyExit{},~H.Transition{},~H.Enter{},enter,world,H.Enter{},from,to,None{}))

def engine_result(~S:Data,~C:Type,~R:Type,~E:Data,~V:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,value:H.PhaseResult<S,C,R,E,V,runner>) -> Engine.PhaseResult<W.World<S,C,R,E>,H.Entry<S,C,R,E,V,runner>>:
  match value:
    case H.Complete{entries,world}:Engine.Complete{entries,world}
    case H.Failed{entries,world,error}:Engine.Failed{entries,world,error}
def published(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~take:W.World<S,C,R,E> -> W.World<S,C,R,E> & M.Slot<S,K,V>,~put:W.World<S,C,R,E> -> M.Slot<S,K,V> -> W.World<S,C,R,E>,~publish:W.World<S,C,R,E> -> M.Transition<V> -> W.World<S,C,R,E>,~same:V -> V -> Bool,~frame:W.World<S,C,R,E> -> W.World<S,C,R,E>,world:W.World<S,C,R,E>,event:M.Transition<V>) -> W.World<S,C,R,E>:
  published_with(~S,~K,~V,~C,~R,~E,~runner,~W.World<S,C,R,E>,~H.invoke_phase(~S,~C,~R,~E,~V,~runner),~H.invoke_initial(~S,~C,~R,~E,~V,~runner),~take,~put,~publish,~same,~frame,world,event)

def requeued(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~take:W.World<S,C,R,E> -> W.World<S,C,R,E> & M.Slot<S,K,V>,~put:W.World<S,C,R,E> -> M.Slot<S,K,V> -> W.World<S,C,R,E>,~publish:W.World<S,C,R,E> -> M.Transition<V> -> W.World<S,C,R,E>,~same:V -> V -> Bool,~frame:W.World<S,C,R,E> -> W.World<S,C,R,E>,to:V,skipSame:Bool,pair:W.World<S,C,R,E> & M.Slot<S,K,V>) -> W.World<S,C,R,E>:
  requeued_with(~S,~K,~V,~C,~R,~E,~runner,~W.World<S,C,R,E>,~H.invoke_phase(~S,~C,~R,~E,~V,~runner),~H.invoke_initial(~S,~C,~R,~E,~V,~runner),~take,~put,~publish,~same,~frame,to,skipSame,pair)

def committed(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~take:W.World<S,C,R,E> -> W.World<S,C,R,E> & M.Slot<S,K,V>,~put:W.World<S,C,R,E> -> M.Slot<S,K,V> -> W.World<S,C,R,E>,~publish:W.World<S,C,R,E> -> M.Transition<V> -> W.World<S,C,R,E>,~same:V -> V -> Bool,~frame:W.World<S,C,R,E> -> W.World<S,C,R,E>,+from:V,+to:V,pair:W.World<S,C,R,E> & M.Slot<S,K,V>) -> W.World<S,C,R,E>:
  committed_with(~S,~K,~V,~C,~R,~E,~runner,~W.World<S,C,R,E>,~H.invoke_phase(~S,~C,~R,~E,~V,~runner),~H.invoke_initial(~S,~C,~R,~E,~V,~runner),~take,~put,~publish,~same,~frame,from,to,pair)

def prepared(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~take:W.World<S,C,R,E> -> W.World<S,C,R,E> & M.Slot<S,K,V>,~put:W.World<S,C,R,E> -> M.Slot<S,K,V> -> W.World<S,C,R,E>,~publish:W.World<S,C,R,E> -> M.Transition<V> -> W.World<S,C,R,E>,~same:V -> V -> Bool,~frame:W.World<S,C,R,E> -> W.World<S,C,R,E>,handlers:H.Owners<S,C,R,E,V,runner>,world:W.World<S,C,R,E>,value:H.Prepared<S,K,V>) -> Owners<S,K,V,C,R,E,runner> & Sys.Outcome<W.World<S,C,R,E>,String,Unit>:
  prepared_with(~S,~K,~V,~C,~R,~E,~runner,~W.World<S,C,R,E>,~H.invoke_phase(~S,~C,~R,~E,~V,~runner),~H.invoke_initial(~S,~C,~R,~E,~V,~runner),~take,~put,~publish,~same,~frame,handlers,world,value)

def captured(~S:Data,~K:Data,~V:Data,~C:Type,~R:Type,~E:Data,~runner:W.World<S,C,R,E> -> H.Invocation<V> -> Sys.Outcome<W.World<S,C,R,E>,String,Unit>,~take:W.World<S,C,R,E> -> W.World<S,C,R,E> & M.Slot<S,K,V>,~put:W.World<S,C,R,E> -> M.Slot<S,K,V> -> W.World<S,C,R,E>,~publish:W.World<S,C,R,E> -> M.Transition<V> -> W.World<S,C,R,E>,~same:V -> V -> Bool,~frame:W.World<S,C,R,E> -> W.World<S,C,R,E>,handlers:H.Owners<S,C,R,E,V,runner>,pair:W.World<S,C,R,E> & M.Slot<S,K,V>) -> Owners<S,K,V,C,R,E,runner> & Sys.Outcome<W.World<S,C,R,E>,String,Unit>:
  captured_with(~S,~K,~V,~C,~R,~E,~runner,~W.World<S,C,R,E>,~H.invoke_phase(~S,~C,~R,~E,~V,~runner),~H.invoke_initial(~S,~C,~R,~E,~V,~runner),~take,~put,~publish,~same,~frame,handlers,pair)

