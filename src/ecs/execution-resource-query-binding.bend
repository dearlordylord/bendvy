# Internal compiled adapter. The declared body models are sparse; the canonical
# World keeps full Layout products. The ordinary Program remains unchanged.
type CompiledPair<-S:Data,-components:L.Layout,-resources:L.Layout,-E:Data,-Error:Data,-Out:Data,-Owners:Type> is Type:
  CompiledPair{-LeftOps:Data -> Type -> Type,-RightOps:Data -> Type -> Type,-LeftLocal:Type,-RightLocal:Type,-leftProgram:Build.FrameworkProgram(~S,~L.columns(~S,components),~QueryStore.Storage<S,components>,~ResourceStore.Storage<S,resources>,~LeftOps),-rightProgram:Build.FrameworkProgram(~S,~L.columns(~S,components),~QueryStore.Storage<S,components>,~ResourceStore.Storage<S,resources>,~RightOps),-leftBody:Sys.Body(~S,~LeftOps,~LeftLocal,~Error,~Out),-rightBody:Sys.Body(~S,~RightOps,~RightLocal,~Error,~Out),-restore:Product.Owner<Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,LeftOps,LeftLocal,Error,Out,leftProgram,leftBody>,Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,RightOps,RightLocal,Error,Out,rightProgram,rightBody>> -> Owners,left:Scope.CompiledBinding<D.Compilation<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,LeftOps>,Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,LeftOps,LeftLocal,Error,Out,leftProgram,leftBody>>,right:Scope.CompiledBinding<D.Compilation<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,RightOps>,Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,RightOps,RightLocal,Error,Out,rightProgram,rightBody>>}
type CompiledPlan<-S:Data,-components:L.Layout,-resources:L.Layout,-E:Data,-Error:Data,-Out:Data,-Owners:Type> is Type:
  CompiledPlan{-LeftOps:Data -> Type -> Type,-RightOps:Data -> Type -> Type,-LeftLocal:Type,-RightLocal:Type,-leftProgram:Build.FrameworkProgram(~S,~L.columns(~S,components),~QueryStore.Storage<S,components>,~ResourceStore.Storage<S,resources>,~LeftOps),-rightProgram:Build.FrameworkProgram(~S,~L.columns(~S,components),~QueryStore.Storage<S,components>,~ResourceStore.Storage<S,resources>,~RightOps),-leftBody:Sys.Body(~S,~LeftOps,~LeftLocal,~Error,~Out),-rightBody:Sys.Body(~S,~RightOps,~RightLocal,~Error,~Out),-restore:Product.Owner<Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,LeftOps,LeftLocal,Error,Out,leftProgram,leftBody>,Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,RightOps,RightLocal,Error,Out,rightProgram,rightBody>> -> Owners,world:W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,left:Scope.CompiledBinding<D.Compilation<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,LeftOps>,Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,LeftOps,LeftLocal,Error,Out,leftProgram,leftBody>>,right:Scope.CompiledBinding<D.Compilation<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,RightOps>,Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,RightOps,RightLocal,Error,Out,rightProgram,rightBody>>,leftEvidence:Admission.Evidence<S,components,resources,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,LeftOps,leftProgram>,rightEvidence:Admission.Evidence<S,components,resources,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,RightOps,rightProgram>,mode:PairAdmission.Mode}
type Inspection<-S:Data,-components:L.Layout,-resources:L.Layout,-E:Data,-Error:Data,-Out:Data,-Owners:Type> is Type:
  Admitted{plan:CompiledPlan<S,components,resources,E,Error,Out,Owners>}
  Refused{world:W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,pair:CompiledPair<S,components,resources,E,Error,Out,Owners>}
def compile_pair(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Error:Data,~Out:Data,~LeftOps:Data -> Type -> Type,~RightOps:Data -> Type -> Type,~LeftLocal:Type,~RightLocal:Type,~leftProgram:Build.FrameworkProgram(~S,~L.columns(~S,components),~QueryStore.Storage<S,components>,~ResourceStore.Storage<S,resources>,~LeftOps),~rightProgram:Build.FrameworkProgram(~S,~L.columns(~S,components),~QueryStore.Storage<S,components>,~ResourceStore.Storage<S,resources>,~RightOps),~leftBody:Sys.Body(~S,~LeftOps,~LeftLocal,~Error,~Out),~rightBody:Sys.Body(~S,~RightOps,~RightLocal,~Error,~Out),left:Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,LeftOps,LeftLocal,Error,Out,leftProgram,leftBody>,right:Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,RightOps,RightLocal,Error,Out,rightProgram,rightBody>) -> CompiledPair<S,components,resources,E,Error,Out,Product.Owner<Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,LeftOps,LeftLocal,Error,Out,leftProgram,leftBody>,Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,RightOps,RightLocal,Error,Out,rightProgram,rightBody>>>:
  CompiledPair{LeftOps,RightOps,LeftLocal,RightLocal,leftProgram,rightProgram,leftBody,rightBody,(owners => owners),Scope.CompiledBinding{Program.compile_framework(~S,~L.columns(~S,components),~QueryStore.Storage<S,components>,~ResourceStore.Storage<S,resources>,~LeftOps,~leftProgram),left},Scope.CompiledBinding{Program.compile_framework(~S,~L.columns(~S,components),~QueryStore.Storage<S,components>,~ResourceStore.Storage<S,resources>,~RightOps,~rightProgram),right}}
def inspected(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Error:Data,~Out:Data,~Owners:Type,~LeftOps:Data -> Type -> Type,~RightOps:Data -> Type -> Type,~LeftLocal:Type,~RightLocal:Type,~leftProgram:Build.FrameworkProgram(~S,~L.columns(~S,components),~QueryStore.Storage<S,components>,~ResourceStore.Storage<S,resources>,~LeftOps),~rightProgram:Build.FrameworkProgram(~S,~L.columns(~S,components),~QueryStore.Storage<S,components>,~ResourceStore.Storage<S,resources>,~RightOps),~leftBody:Sys.Body(~S,~LeftOps,~LeftLocal,~Error,~Out),~rightBody:Sys.Body(~S,~RightOps,~RightLocal,~Error,~Out),~restore:Product.Owner<Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,LeftOps,LeftLocal,Error,Out,leftProgram,leftBody>,Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,RightOps,RightLocal,Error,Out,rightProgram,rightBody>> -> Owners,left:Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,LeftOps,LeftLocal,Error,Out,leftProgram,leftBody>,right:Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,RightOps,RightLocal,Error,Out,rightProgram,rightBody>,result:PairAdmission.Inspection<S,components,resources,QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,LeftOps,RightOps,leftProgram,rightProgram>) -> Inspection<S,components,resources,E,Error,Out,Owners>:
  match result:
    case PairAdmission.Refused{world,lc,rc}:Refused{world,CompiledPair{LeftOps,RightOps,LeftLocal,RightLocal,leftProgram,rightProgram,leftBody,rightBody,restore,Scope.CompiledBinding{lc,left},Scope.CompiledBinding{rc,right}}}
    case PairAdmission.Admitted{world,lc,rc,le,re,mode}:Admitted{CompiledPlan{LeftOps,RightOps,LeftLocal,RightLocal,leftProgram,rightProgram,leftBody,rightBody,restore,world,Scope.CompiledBinding{lc,left},Scope.CompiledBinding{rc,right},le,re,mode}}
def inspect(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Error:Data,~Out:Data,~Owners:Type,world:W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,pair:CompiledPair<S,components,resources,E,Error,Out,Owners>) -> Inspection<S,components,resources,E,Error,Out,Owners>:
  match pair:
    case CompiledPair{LeftOps,RightOps,LeftLocal,RightLocal,leftProgram,rightProgram,leftBody,rightBody,restore,Scope.CompiledBinding{lc,left},Scope.CompiledBinding{rc,right}}:inspected(~S,~components,~resources,~E,~Error,~Out,~Owners,~LeftOps,~RightOps,~LeftLocal,~RightLocal,~leftProgram,~rightProgram,~leftBody,~rightBody,~restore,left,right,PairAdmission.inspect_with_compilations(~S,~components,~resources,~QueryStore.Storage<S,components>,~ResourceStore.Storage<S,resources>,~E,~LeftOps,~RightOps,~leftProgram,~rightProgram,lc,rc,world))
def restored(~Actual:Type,~Owners:Type,~restore:Actual -> Owners,owners:Actual) -> Owners:
  restore(owners)
def restore_pair(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Error:Data,~Out:Data,~Owners:Type,pair:CompiledPair<S,components,resources,E,Error,Out,Owners>) -> Owners:
  match pair:
    case CompiledPair{LeftOps,RightOps,LeftLocal,RightLocal,leftProgram,rightProgram,leftBody,rightBody,restore,Scope.CompiledBinding{_,left},Scope.CompiledBinding{_,right}}:restored(~Product.Owner<Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,LeftOps,LeftLocal,Error,Out,leftProgram,leftBody>,Sys.Owner<S,L.columns(~S,components),QueryStore.Storage<S,components>,ResourceStore.Storage<S,resources>,E,RightOps,RightLocal,Error,Out,rightProgram,rightBody>>,~Owners,~restore,Product.Owner{left,right})
