def dispatch(state:Nat,id:U32) -> Nat & Exec.Invocation<U32,U32>:(Nat.add(state,100n),Exec.Completed{id})
def condition(state:Nat,id:U32) -> Nat & Exec.Condition<U32>:(Nat.add(state,100n),Exec.ConditionError{id})

