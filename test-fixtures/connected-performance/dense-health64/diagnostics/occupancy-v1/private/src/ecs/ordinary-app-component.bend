type ExecutionError<Error:Data> is Data:
  CallbackFailure{error:Q.Error<Error>}
  RegistrationRefused{}
def execution_returned(~S:Data,~C:Type,~R:Type,~E:Data,~Ops:Type -> Type,~Args:Data,~Error:Data,~Out:Data,~Value:Data,~query:O.Declaration<S,Q.Frame<S,C,R,E>,Ops(Q.Frame<S,C,R,E>),I.Frame<S,C,R,E>,Value>,~body:@-H:Type -> @-caps:Ops(H) -> Args -> H -> H & (T.Outcome<Error> & Out),+args:Args,result:Transport.TransportResult<S,Ctx.Context<W.World<S,C,R,E>>,Args & U32,Q.Error<Error>,List<&2,Out>,Records.Token<Sys.Registry<S,C,R,E,Args & U32,Q.Error<Error>,List<&2,Out>,System.observable_runner(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~Value,~query,~body)>>>) -> Exec.Invocation<S,Records.Token<Sys.Registry<S,C,R,E,Args & U32,Q.Error<Error>,List<&2,Out>,System.observable_runner(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~Value,~query,~body)>>,Args,Out> & Sys.Outcome<Ctx.Context<W.World<S,C,R,E>>,ExecutionError<Error>,Unit>:
  match result:
    case Transport.Completed{token,fields,Sys.Succeeded{world,outputs}}:(Exec.Invocation{Leaf.Record{token,fields},args,outputs},Sys.Succeeded{world,Unit{}})
    case Transport.Completed{token,fields,Sys.Failed{world,error}}:(Exec.Invocation{Leaf.Record{token,fields},args,[]},Sys.Failed{world,CallbackFailure{error}})
    case Transport.RegistrationRejected{token,fields,world,_}:(Exec.Invocation{Leaf.Record{token,fields},args,[]},Sys.Failed{world,RegistrationRefused{}})
def execution_allowed(~S:Data,~C:Type,~R:Type,~E:Data,~Ops:Type -> Type,~Args:Data,~Error:Data,~Out:Data,~Value:Data,~query:O.Declaration<S,Q.Frame<S,C,R,E>,Ops(Q.Frame<S,C,R,E>),I.Frame<S,C,R,E>,Value>,~body:@-H:Type -> @-caps:Ops(H) -> Args -> H -> H & (T.Outcome<Error> & Out),allowed:Bool,owner:Exec.Invocation<S,Records.Token<Sys.Registry<S,C,R,E,Args & U32,Q.Error<Error>,List<&2,Out>,System.observable_runner(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~Value,~query,~body)>>,Args,Out>,world:Ctx.Context<W.World<S,C,R,E>>,id:U32) -> Exec.Invocation<S,Records.Token<Sys.Registry<S,C,R,E,Args & U32,Q.Error<Error>,List<&2,Out>,System.observable_runner(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~Value,~query,~body)>>,Args,Out> & Sys.Outcome<Ctx.Context<W.World<S,C,R,E>>,ExecutionError<Error>,Unit>:
  match allowed owner:
    case False{} owner:(owner,Sys.Failed{world,RegistrationRefused{}})
    case True{} Exec.Invocation{Leaf.Record{token,fields},+args,_}:execution_returned(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~Value,~query,~body,args,ExecuteRun.component(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~Value,~query,~body,token,fields,world,args))
def execution_run(~S:Data,~C:Type,~R:Type,~E:Data,~Ops:Type -> Type,~Args:Data,~Error:Data,~Out:Data,~Value:Data,~query:O.Declaration<S,Q.Frame<S,C,R,E>,Ops(Q.Frame<S,C,R,E>),I.Frame<S,C,R,E>,Value>,~body:@-H:Type -> @-caps:Ops(H) -> Args -> H -> H & (T.Outcome<Error> & Out),owner:Exec.Invocation<S,Records.Token<Sys.Registry<S,C,R,E,Args & U32,Q.Error<Error>,List<&2,Out>,System.observable_runner(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~Value,~query,~body)>>,Args,Out>,world:Ctx.Context<W.World<S,C,R,E>>,id:U32) -> Exec.Invocation<S,Records.Token<Sys.Registry<S,C,R,E,Args & U32,Q.Error<Error>,List<&2,Out>,System.observable_runner(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~Value,~query,~body)>>,Args,Out> & Sys.Outcome<Ctx.Context<W.World<S,C,R,E>>,ExecutionError<Error>,Unit>:
  match owner:
    case Exec.Invocation{Leaf.Record{token,+fields},args,outputs}:
      +selected=id
      execution_allowed(~S,~C,~R,~E,~Ops,~Args,~Error,~Out,~Value,~query,~body,U32.is_eq(selected,Exec.registration_id(~S,fields)),Exec.Invocation{Leaf.Record{token,fields},args,outputs},world,selected)
