import Base
import ./core.bend as F
import ./model.bend as M
def validation_show(value:F.Validation) -> String:
  match value:
    case F.Valid{}: "[0,0,\"\",\"\"]"
    case F.Invalid{F.DuplicateKey{k,key}}: "[1," ++ U32.show(M.kind_code(k)) ++ ",\"" ++ key ++ "\",\"\"]"
    case F.Invalid{F.DuplicateName{k,name}}: "[2," ++ U32.show(M.kind_code(k)) ++ ",\"\",\"" ++ name ++ "\"]"
    case F.Invalid{F.UndeclaredDescriptor{k,key,name}}: "[3," ++ U32.show(M.kind_code(k)) ++ ",\"" ++ key ++ "\",\"" ++ name ++ "\"]"
def bool_show(value:Bool) -> String:
  U32.show(Bool.to_u32(value))
def main() -> IO(Unit):
  IO.print(List.show(&2,String,(x => x),["[" ++ bool_show(F.descriptor_present(~M.Schema,[F.Entry{F.Component{},"a","A"}],F.Entry{F.Component{},"a","A"})) ++ "," ++ bool_show(M.member([F.Entry{F.Component{},"a","A"}],F.Entry{F.Component{},"a","A"})) ++ "]","[" ++ bool_show(F.descriptor_present(~M.Schema,[F.Entry{F.Component{},"a","A"}],F.Entry{F.Component{},"a","B"})) ++ "," ++ bool_show(M.member([F.Entry{F.Component{},"a","A"}],F.Entry{F.Component{},"a","B"})) ++ "]","[" ++ bool_show(F.descriptor_present(~M.Schema,[F.Entry{F.Component{},"a","A"}],F.Entry{F.Component{},"b","A"})) ++ "," ++ bool_show(M.member([F.Entry{F.Component{},"a","A"}],F.Entry{F.Component{},"b","A"})) ++ "]","[" ++ bool_show(F.descriptor_present(~M.Schema,[F.Entry{F.Component{},"a","A"}],F.Entry{F.Component{},"b","B"})) ++ "," ++ bool_show(M.member([F.Entry{F.Component{},"a","A"}],F.Entry{F.Component{},"b","B"})) ++ "]","[" ++ bool_show(F.descriptor_present(~M.Schema,[F.Entry{F.Component{},"a","A"}],F.Entry{F.Resource{},"a","A"})) ++ "," ++ bool_show(M.member([F.Entry{F.Component{},"a","A"}],F.Entry{F.Resource{},"a","A"})) ++ "]","[" ++ bool_show(F.descriptor_present(~M.Schema,[F.Entry{F.Component{},"a","A"}],F.Entry{F.Resource{},"a","B"})) ++ "," ++ bool_show(M.member([F.Entry{F.Component{},"a","A"}],F.Entry{F.Resource{},"a","B"})) ++ "]","[" ++ bool_show(F.descriptor_present(~M.Schema,[F.Entry{F.Component{},"a","A"}],F.Entry{F.Resource{},"b","A"})) ++ "," ++ bool_show(M.member([F.Entry{F.Component{},"a","A"}],F.Entry{F.Resource{},"b","A"})) ++ "]","[" ++ bool_show(F.descriptor_present(~M.Schema,[F.Entry{F.Component{},"a","A"}],F.Entry{F.Resource{},"b","B"})) ++ "," ++ bool_show(M.member([F.Entry{F.Component{},"a","A"}],F.Entry{F.Resource{},"b","B"})) ++ "]","[" ++ bool_show(F.descriptor_present(~M.Schema,[F.Entry{F.Component{},"a","A"}],F.Entry{F.Event{},"a","A"})) ++ "," ++ bool_show(M.member([F.Entry{F.Component{},"a","A"}],F.Entry{F.Event{},"a","A"})) ++ "]","[" ++ bool_show(F.descriptor_p