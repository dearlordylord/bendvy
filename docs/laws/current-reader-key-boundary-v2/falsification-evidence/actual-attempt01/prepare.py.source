from pathlib import Path
import gzip,hashlib,importlib.util,json
R=Path('/workspace/formal-proofs/bendvy');S=Path('/tmp/bendvy-laws62/docs/laws/current-reader-key-boundary-v2');O=Path('/tmp/bendvy-laws62-oracle/docs/laws/current-reader-key-boundary-v2/oracle-v1');D=Path('/tmp/bendvy62-falsification-first-actual01')
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
def load(n,p):
 s=importlib.util.spec_from_file_location(n,p);m=importlib.util.module_from_spec(s);s.loader.exec_module(m);return m
collector=R/'experiments/public-inspect/ordinary-declaration-v1/canonical-adoption-v1/detached-v2/development.py';gp=R/'experiments/public-inspect/development-plan-guard-v1/plan_guard.py';cp=R/'experiments/public-simulation/delivery-v1/installed-config.py';rp=R/'scripts/task_runner.py';cfg=load('cfg',cp);runner=load('runner',rp);guard=load('guard',gp);cv=load('collector',collector)
tools={'bend':cfg.TOOL_PATHS['bend'],'node':cfg.TOOL_PATHS['node'],'python':'/usr/bin/python3.11','taskset':cfg.TOOL_PATHS['taskset'],'clangWrapper':cfg.TOOL_PATHS['clangWrapper'],'clangBinary':cfg.TOOL_PATHS['clang']}
D.mkdir(exist_ok=False);pack=D/'oracle';pack.mkdir()
for p in O.glob('*.stdout'):
 q=pack/(p.name+'.gz');q.write_bytes(gzip.compress(p.read_bytes(),mtime=0));assert gzip.decompress(q.read_bytes())==p.read_bytes()
resources=runner.Inputs(directories=cfg.RESOURCE_ROOTS).expected
for name in ['normal','generation-omission','failed-reader-advance','dropped-metadata-loss','explicit-advance-zero']:
 fpath=S/'falsification'/name/'SOURCE-FREEZE.json';f=json.loads(fpath.read_text());assert all(sha(p)==h for k in ['sourceInventory','sourcePins'] for p,h in f[k].items());assert cv.validate_imports(f['entrypoint'],f['sourceInventory'])==sorted(f['sourceInventory'])
 pins=dict(f['sourcePins']);pins.update(f['sourceInventory'])
 for p in [collector,gp,cp,rp,R/'scripts/evidence_boundary.py',Path(__file__),fpath,*map(Path,tools.values()),*sorted(p for p in O.iterdir() if p.is_file()),*pack.iterdir(),*sorted((S/'source-checks').iterdir()),S/'falsification'/name/'SOURCE-BASIS.json']:pins[str(p)]=sha(p)
 raw=(O/(name+'.stdout')).read_bytes();base=(O/'normal.stdout').read_bytes();oracle=pack/(name+'.stdout.gz')
 for role in (['js','native'] if name=='normal' else ['js']):
  out=D/name/role;out.mkdir(parents=True);generated=out/('scenario.js' if role=='js' else 'scenario.c');native=out/'scenario.native';prefix=[tools['taskset'],'-c','11'];commands=[{'label':'emit','argv':prefix+[tools['bend'],f['entrypoint'],'-o',str(generated)],'capSeconds':30}]
  if role=='native':commands += [{'label':'build','argv':prefix+[tools['clangWrapper'],'-O3',str(generated),'-o',str(native),'-pthread','-lm'],'capSeconds':120},{'label':'consumer','argv':prefix+[str(native),'--threads','1','--gpu','off'],'capSeconds':5}]
  else:commands += [{'label':'consumer','argv':prefix+[tools['node'],str(generated)],'capSeconds':5}]
  plan={'scope':'#62 unapproved exact helper law literal falsification, not proof or new runtime contract','role':role,'subject':'normal' if name=='normal' else 'mutant','entrypoint':f['entrypoint'],'stage':str(Path(f['entrypoint']).parent),'cwd':str(Path(f['entrypoint']).parent),'sourceInventory':f['sourceInventory'],'importClosure':sorted(f['sourceInventory']),'pins':pins,'resourceRoots':resources,'environment':cfg.environment(),'tools':tools,'commands':commands,'oracle':str(oracle),'oracleBytes':len(raw),'oracleSHA256':hashlib.sha256(raw).hexdigest(),'normalOracle':str(pack/'normal.stdout.gz'),'normalOracleBytes':len(base),'normalOracleSHA256':hashlib.sha256(base).hexdigest(),'generated':str(generated),'native':str(native),'postConsumer':'Whole independent 18-row literal oracle equality; mutants additionally reject whole normal oracle. No normalization. No proof/approval claim.'}
  guard.validate(plan,output_dir=out);p=out/'plan.json';p.write_text(json.dumps(plan,indent=2)+'\n');print(name,role,sha(p),p)
